"use client";

import { useCallback, useEffect, useRef, useState } from "react";
import {
  Alert,
  Avatar,
  Box,
  Button,
  Card,
  CardContent,
  Chip,
  CircularProgress,
  Dialog,
  DialogActions,
  DialogContent,
  DialogTitle,
  Divider,
  IconButton,
  InputAdornment,
  Paper,
  Snackbar,
  Stack,
  Table,
  TableBody,
  TableCell,
  TableContainer,
  TableHead,
  TableRow,
  TextField,
  Typography,
  useTheme,
} from "@mui/material";
import AlertIcon from "@mui/icons-material/WarningAmberOutlined";
import BookIcon from "@mui/icons-material/MenuBookOutlined";
import CheckIcon from "@mui/icons-material/CheckCircleOutlined";
import CloseIcon from "@mui/icons-material/Close";
import DownloadIcon from "@mui/icons-material/DownloadOutlined";
import EyeIcon from "@mui/icons-material/VisibilityOutlined";
import FileIcon from "@mui/icons-material/InsertDriveFileOutlined";
import InventoryIcon from "@mui/icons-material/Inventory2Outlined";
import PrintIcon from "@mui/icons-material/PrintOutlined";
import QrCodeScannerIcon from "@mui/icons-material/QrCodeScannerOutlined";
import RefreshIcon from "@mui/icons-material/Refresh";
import SearchIcon from "@mui/icons-material/Search";
import UploadIcon from "@mui/icons-material/UploadFileOutlined";
import api, { getErrorMessage } from "@/lib/api-client";
import IsbnScannerDialog from "@/components/IsbnScannerDialog";
import type { BookImportPreviewRow, BookImportResultRow, BookWithStats } from "@/lib/types";

type Notice = { severity: "success" | "error" | "warning" | "info"; message: string } | null;

function statusColor(status: string): "success" | "info" | "warning" | "error" | "default" {
  if (["new", "imported"].includes(status)) return "success";
  if (["updated"].includes(status)) return "info";
  if (["exists", "skipped"].includes(status)) return "default";
  if (["warning"].includes(status)) return "warning";
  return "error";
}

function statusLabel(status: string) {
  const labels: Record<string, string> = {
    exists: "Đã có",
    new: "Mới",
    warning: "Cảnh báo",
    invalid: "Lỗi",
    imported: "Thành công",
    updated: "Cập nhật",
    skipped: "Bỏ qua",
    error: "Lỗi",
  };
  return labels[status] || status;
}

function MetricCard({ label, value, description, icon: Icon, color }: any) {
  return (
    <Card variant="outlined">
      <CardContent>
        <Stack direction="row" sx={{ alignItems: "center", justifyContent: "space-between" }}>
          <Box>
            <Typography variant="caption" color="text.secondary" sx={{ fontWeight: 900 }}>{label}</Typography>
            <Typography variant="h4" sx={{ fontWeight: 900 }}>{value}</Typography>
            <Typography variant="caption" color="text.secondary">{description}</Typography>
          </Box>
          <Avatar sx={{ bgcolor: color, color: "primary.contrastText" }}>
            <Icon />
          </Avatar>
        </Stack>
      </CardContent>
    </Card>
  );
}

export default function BooksPage() {
  const theme = useTheme();
  const fileInputRef = useRef<HTMLInputElement>(null);
  const [books, setBooks] = useState<BookWithStats[]>([]);
  const [total, setTotal] = useState(0);
  const [loading, setLoading] = useState(true);
  const [searchQuery, setSearchQuery] = useState("");
  const [searchResults, setSearchResults] = useState<BookWithStats[]>([]);
  const [searching, setSearching] = useState(false);
  const [previewFile, setPreviewFile] = useState<File | null>(null);
  const [previewData, setPreviewData] = useState<BookImportPreviewRow[] | null>(null);
  const [previewLoading, setPreviewLoading] = useState(false);
  const [importing, setImporting] = useState(false);
  const [importResults, setImportResults] = useState<BookImportResultRow[] | null>(null);
  const [showResults, setShowResults] = useState(false);
  const [recentlyPrinted, setRecentlyPrinted] = useState<string[]>([]);
  const [page, setPage] = useState(0);
  const limit = 30;
  const [selectedBook, setSelectedBook] = useState<BookWithStats | null>(null);
  const [editQuantity, setEditQuantity] = useState(0);
  const [savingQuantity, setSavingQuantity] = useState(false);
  const [quantityError, setQuantityError] = useState("");
  const [notice, setNotice] = useState<Notice>(null);
  const [isbnScannerOpen, setIsbnScannerOpen] = useState(false);

  const showNotice = (severity: NonNullable<Notice>["severity"], message: string) => setNotice({ severity, message });

  const loadBooks = useCallback(async () => {
    setLoading(true);
    try {
      const data = await api.listBooks({ skip: page * limit, limit });
      setBooks(data.items ?? []);
      setTotal(data.total ?? 0);
    } catch (err) {
      showNotice("error", getErrorMessage(err) || "Lỗi tải dữ liệu sách");
      setBooks([]);
      setTotal(0);
    } finally {
      setLoading(false);
    }
  }, [page]);

  useEffect(() => {
    loadBooks();
  }, [loadBooks]);

  useEffect(() => {
    if (!searchQuery.trim()) {
      setSearchResults([]);
      return;
    }
    const timer = setTimeout(async () => {
      setSearching(true);
      try {
        setSearchResults(await api.searchBooks(searchQuery));
      } catch {
        setSearchResults([]);
      } finally {
        setSearching(false);
      }
    }, 400);
    return () => clearTimeout(timer);
  }, [searchQuery]);

  const handleFileChange = async (event: React.ChangeEvent<HTMLInputElement>) => {
    const file = event.target.files?.[0];
    if (!file) return;
    setPreviewFile(file);
    setPreviewData(null);
    setShowResults(false);
    setPreviewLoading(true);
    try {
      const data = await api.getBarcodePreview(file);
      setPreviewData(data.rows);
      showNotice("info", `Đã đọc ${data.total_rows} dòng từ file Excel`);
    } catch (err) {
      showNotice("error", getErrorMessage(err) || "Lỗi đọc file");
    } finally {
      setPreviewLoading(false);
      if (fileInputRef.current) fileInputRef.current.value = "";
    }
  };

  const handleImport = async () => {
    if (!previewFile) return;
    setImporting(true);
    setShowResults(false);
    try {
      const result = await api.importBooks(previewFile);
      setImportResults(result.results);
      setShowResults(true);
      setPreviewData(null);
      setPreviewFile(null);
      setSearchQuery("");
      setPage(0);
      await loadBooks();
      showNotice(result.errors === 0 ? "success" : "warning", result.errors === 0
        ? `Đã nhập ${result.imported} đầu sách`
        : `${result.imported} nhập thành công, ${result.errors} lỗi`);
    } catch (err) {
      showNotice("error", getErrorMessage(err) || "Lỗi nhập kho");
    } finally {
      setImporting(false);
    }
  };

  const handleQuantitySave = async () => {
    if (!selectedBook) return;
    const borrowed = selectedBook.total_copies - selectedBook.available_copies;
    if (editQuantity < borrowed) {
      setQuantityError(`Tối thiểu ${borrowed} bản vì đang có ${borrowed} bản được mượn`);
      return;
    }
    if (editQuantity < 1) {
      setQuantityError("Số lượng phải lớn hơn 0");
      return;
    }
    setSavingQuantity(true);
    try {
      const updated = await api.updateBookQuantity(selectedBook.id, editQuantity);
      setBooks((prev) => prev.map((book) => book.id === updated.id ? updated : book));
      setSearchResults((prev) => prev.map((book) => book.id === updated.id ? updated : book));
      showNotice("success", `Đã cập nhật số lượng: ${updated.total_copies} bản`);
      setSelectedBook(null);
    } catch (err) {
      showNotice("error", getErrorMessage(err) || "Cập nhật thất bại");
    } finally {
      setSavingQuantity(false);
    }
  };

  const handlePrintBarcodes = async (bookId?: string) => {
    try {
      const barcodes = await api.getBarcodes(bookId);
      if (barcodes.length === 0) {
        showNotice("info", "Không tìm thấy mã vạch để in");
        return;
      }
      setRecentlyPrinted(barcodes.map((item) => item.barcode));
      showNotice("success", `${barcodes.length} mã vạch sẵn sàng in`);
    } catch (err) {
      showNotice("error", getErrorMessage(err) || "Không thể lấy mã vạch");
    }
  };

  const handleIsbnImportComplete = (results: BookImportResultRow[]) => {
    setIsbnScannerOpen(false);
    setSearchQuery("");
    setPage(0);
    loadBooks();
    const importedCount = results.filter((r) => r.status === "imported" || r.status === "updated").length;
    const errorCount = results.filter((r) => r.status === "error").length;
    if (errorCount === 0) {
      showNotice("success", `Đã nhập ${importedCount} đầu sách từ ISBN`);
    } else {
      showNotice("warning", `${importedCount} thành công, ${errorCount} lỗi`);
    }
  };

  const openQuantityDialog = (book: BookWithStats) => {
    setSelectedBook(book);
    setEditQuantity(book.total_copies);
    setQuantityError("");
  };

  const stats = {
    totalBooks: total,
    totalCopies: books.reduce((sum, book) => sum + book.total_copies, 0),
    availableCopies: books.reduce((sum, book) => sum + book.available_copies, 0),
    borrowedCopies: books.reduce((sum, book) => sum + (book.total_copies - book.available_copies), 0),
  };
  const displayBooks = searchQuery.trim() ? searchResults : books;

  return (
    <Stack spacing={3}>
      <Box sx={{ display: "grid", gridTemplateColumns: { xs: "1fr", sm: "repeat(2, 1fr)", lg: "repeat(4, 1fr)" }, gap: 2 }}>
        <MetricCard label="Tổng đầu sách" value={stats.totalBooks} icon={BookIcon} color={theme.palette.primary.main} description="Trong hệ thống" />
        <MetricCard label="Tổng bản sao" value={stats.totalCopies} icon={InventoryIcon} color={theme.palette.info.main} description="Tất cả các bản" />
        <MetricCard label="Sẵn sàng" value={stats.availableCopies} icon={CheckIcon} color={theme.palette.success.main} description="Có thể mượn" />
        <MetricCard label="Đang được mượn" value={stats.borrowedCopies} icon={AlertIcon} color={theme.palette.warning.main} description="Đang lưu hành" />
      </Box>

      <Paper variant="outlined" sx={{ p: 2 }}>
        <Stack direction={{ xs: "column", lg: "row" }} spacing={1.5} sx={{ alignItems: { lg: "center" } }}>
          <TextField
            value={searchQuery}
            onChange={(event) => setSearchQuery(event.target.value)}
            placeholder="Tìm kiếm sách theo ISBN, tên, tác giả..."
            size="small"
            fullWidth
            slotProps={{
              input: {
                startAdornment: <InputAdornment position="start"><SearchIcon fontSize="small" /></InputAdornment>,
                endAdornment: searchQuery ? (
                  <InputAdornment position="end">
                    <IconButton size="small" onClick={() => setSearchQuery("")}>{searching ? <CircularProgress size={16} /> : <CloseIcon fontSize="small" />}</IconButton>
                  </InputAdornment>
                ) : undefined,
              },
            }}
          />
          <Stack direction="row" spacing={1} sx={{ flexWrap: "wrap", gap: 1 }}>
            <input ref={fileInputRef} type="file" accept=".xlsx,.xls" hidden onChange={handleFileChange} />
            <Button variant="contained" startIcon={<UploadIcon />} onClick={() => fileInputRef.current?.click()}>Nhập Excel</Button>
            <Button variant="contained" color="secondary" startIcon={<QrCodeScannerIcon />} onClick={() => setIsbnScannerOpen(true)}>Quét ISBN</Button>
            <Button variant="outlined" startIcon={<RefreshIcon />} onClick={() => { setPage(0); setSearchQuery(""); loadBooks(); }}>Tải lại</Button>
            <Button variant="outlined" startIcon={<DownloadIcon />} onClick={() => api.downloadBookTemplate()}>Tải mẫu</Button>
            <Button variant="outlined" startIcon={<DownloadIcon />} onClick={() => api.exportBooks()}>Xuất Excel</Button>
          </Stack>
        </Stack>
      </Paper>

      {searchQuery.trim() ? (
        <Alert
          severity="info"
          action={searchResults.length > 0 ? <Button color="inherit" size="small" startIcon={<PrintIcon />} onClick={() => handlePrintBarcodes()}>In mã vạch</Button> : undefined}
        >
          Kết quả tìm kiếm: {searchResults.length} cuốn sách
        </Alert>
      ) : null}

      {previewFile ? (
        <Paper variant="outlined" sx={{ p: 2 }}>
          <Stack direction={{ xs: "column", sm: "row" }} sx={{ justifyContent: "space-between", gap: 1.5, mb: 2 }}>
            <Stack direction="row" spacing={1} sx={{ alignItems: "center" }}>
              <FileIcon color="primary" />
              <Box>
                <Typography variant="h6">Xem trước: {previewFile.name}</Typography>
                <Typography variant="body2" color="text.secondary">Kiểm tra dữ liệu trước khi nhập kho</Typography>
              </Box>
            </Stack>
            <Button variant="text" color="inherit" onClick={() => { setPreviewFile(null); setPreviewData(null); }}>Hủy</Button>
          </Stack>
          {previewLoading ? (
            <Box sx={{ py: 5, display: "grid", placeItems: "center" }}><CircularProgress /></Box>
          ) : previewData?.length ? (
            <Stack spacing={2}>
              <Stack direction="row" spacing={1} sx={{ flexWrap: "wrap" }}>
                <Chip color="success" label={`${previewData.filter((row) => row.status !== "invalid").length} hàng hợp lệ`} />
                <Chip color="error" label={`${previewData.filter((row) => row.status === "invalid").length} hàng lỗi`} />
              </Stack>
              <TableContainer component={Paper} variant="outlined" sx={{ maxHeight: 320 }}>
                <Table size="small" stickyHeader>
                  <TableHead>
                    <TableRow>
                      <TableCell>ISBN</TableCell>
                      <TableCell>Tên sách</TableCell>
                      <TableCell>Tác giả</TableCell>
                      <TableCell>Số lượng</TableCell>
                      <TableCell>Mã vạch mẫu</TableCell>
                      <TableCell>Trạng thái</TableCell>
                    </TableRow>
                  </TableHead>
                  <TableBody>
                    {previewData.slice(0, 50).map((row, index) => (
                      <TableRow key={`${row.isbn}-${index}`} selected={row.status === "invalid"}>
                        <TableCell sx={{ fontFamily: "monospace" }}>{row.isbn || "-"}</TableCell>
                        <TableCell>{row.title || "-"}</TableCell>
                        <TableCell>{row.author || "-"}</TableCell>
                        <TableCell>{row.quantity}</TableCell>
                        <TableCell sx={{ fontFamily: "monospace" }}>{row.barcodes[0] || "-"}</TableCell>
                        <TableCell><Chip size="small" color={statusColor(row.status)} label={statusLabel(row.status)} /></TableCell>
                      </TableRow>
                    ))}
                  </TableBody>
                </Table>
              </TableContainer>
              <Stack direction="row" spacing={1} sx={{ justifyContent: "flex-end" }}>
                <Button variant="outlined" onClick={() => { setPreviewFile(null); setPreviewData(null); }}>Hủy</Button>
                <Button variant="contained" startIcon={<CheckIcon />} onClick={handleImport} disabled={importing}>
                  {importing ? "Đang nhập..." : "Xác nhận nhập kho"}
                </Button>
              </Stack>
            </Stack>
          ) : null}
        </Paper>
      ) : null}

      {showResults && importResults ? (
        <Paper variant="outlined" sx={{ p: 2 }}>
          <Typography variant="h6">Kết quả nhập kho</Typography>
          <TableContainer component={Paper} variant="outlined" sx={{ mt: 2, maxHeight: 320 }}>
            <Table size="small" stickyHeader>
              <TableHead>
                <TableRow>
                  <TableCell>ISBN</TableCell>
                  <TableCell>Tên sách</TableCell>
                  <TableCell>Số lượng</TableCell>
                  <TableCell>Barcode mẫu</TableCell>
                  <TableCell>Trạng thái</TableCell>
                  <TableCell>Thông báo</TableCell>
                </TableRow>
              </TableHead>
              <TableBody>
                {importResults.map((row, index) => (
                  <TableRow key={`${row.isbn}-${index}`} selected={row.status === "error" || row.status === "warning"}>
                    <TableCell sx={{ fontFamily: "monospace" }}>{row.isbn || "-"}</TableCell>
                    <TableCell>{row.title || "-"}</TableCell>
                    <TableCell>{row.quantity}</TableCell>
                    <TableCell sx={{ fontFamily: "monospace" }}>{row.barcodes[0] || "-"}</TableCell>
                    <TableCell><Chip size="small" color={statusColor(row.status)} label={statusLabel(row.status)} /></TableCell>
                    <TableCell>{row.message || "-"}</TableCell>
                  </TableRow>
                ))}
              </TableBody>
            </Table>
          </TableContainer>
          {importResults.some((row) => row.status === "imported" || row.status === "warning") ? (
            <Button sx={{ mt: 2 }} variant="outlined" startIcon={<PrintIcon />} onClick={() => handlePrintBarcodes()}>
              In mã vạch vừa tạo
            </Button>
          ) : null}
        </Paper>
      ) : null}

      {recentlyPrinted.length > 0 ? (
        <Paper variant="outlined" sx={{ p: 2 }}>
          <Typography variant="h6">Mã vạch sẵn sàng in ({recentlyPrinted.length})</Typography>
          <Stack direction="row" spacing={1} sx={{ flexWrap: "wrap", mt: 2 }}>
            {recentlyPrinted.map((barcode) => <Chip key={barcode} label={barcode} sx={{ fontFamily: "monospace" }} />)}
          </Stack>
        </Paper>
      ) : null}

      <Paper variant="outlined">
        <TableContainer>
          <Table size="small">
            <TableHead>
              <TableRow>
                <TableCell>ISBN</TableCell>
                <TableCell>Tiêu đề</TableCell>
                <TableCell>Tác giả</TableCell>
                <TableCell align="center">Tổng</TableCell>
                <TableCell align="center">Sẵn sàng</TableCell>
                <TableCell align="center">Mượn</TableCell>
              </TableRow>
            </TableHead>
            <TableBody>
              {loading ? (
                <TableRow>
                  <TableCell colSpan={6} align="center" sx={{ py: 6 }}><CircularProgress /></TableCell>
                </TableRow>
              ) : displayBooks.length === 0 ? (
                <TableRow>
                  <TableCell colSpan={6} align="center" sx={{ py: 6 }}>
                    <Typography color="text.secondary">{searchQuery ? "Không tìm thấy sách phù hợp" : "Chưa có sách nào trong hệ thống"}</Typography>
                  </TableCell>
                </TableRow>
              ) : displayBooks.map((book) => (
                <TableRow key={book.id} hover sx={{ cursor: "pointer" }} onClick={() => openQuantityDialog(book)}>
                  <TableCell sx={{ fontFamily: "monospace", color: "primary.main" }}>{book.isbn}</TableCell>
                  <TableCell>
                    <Stack direction="row" spacing={1.25} sx={{ alignItems: "center" }}>
                      {book.cover_url ? (
                        <Box component="img" src={book.cover_url} alt={book.title} sx={{ width: 34, height: 44, objectFit: "cover", borderRadius: 1, border: 1, borderColor: "divider" }} />
                      ) : (
                        <Avatar variant="rounded" sx={{ width: 34, height: 44, bgcolor: "background.default" }}><BookIcon fontSize="small" /></Avatar>
                      )}
                      <Typography variant="body2" sx={{ fontWeight: 800 }}>{book.title}</Typography>
                    </Stack>
                  </TableCell>
                  <TableCell>{book.author || "-"}</TableCell>
                  <TableCell align="center">{book.total_copies}</TableCell>
                  <TableCell align="center"><Chip size="small" color={book.available_copies > 0 ? "success" : "error"} label={book.available_copies} /></TableCell>
                  <TableCell align="center">{book.total_copies - book.available_copies}</TableCell>
                </TableRow>
              ))}
            </TableBody>
          </Table>
        </TableContainer>
        {!searchQuery && total > limit ? (
          <>
            <Divider />
            <Stack direction="row" sx={{ alignItems: "center", justifyContent: "space-between", p: 2 }}>
              <Typography variant="caption" color="text.secondary">
                Hiển thị {page * limit + 1}-{Math.min((page + 1) * limit, total)} / {total} đầu sách
              </Typography>
              <Stack direction="row" spacing={1}>
                <Button size="small" variant="outlined" disabled={page === 0} onClick={() => setPage((value) => value - 1)}>Trước</Button>
                <Button size="small" variant="outlined" disabled={(page + 1) * limit >= total} onClick={() => setPage((value) => value + 1)}>Sau</Button>
              </Stack>
            </Stack>
          </>
        ) : null}
      </Paper>

      <Dialog open={!!selectedBook} onClose={() => setSelectedBook(null)} fullWidth maxWidth="sm">
        <DialogTitle>Sửa số lượng sách</DialogTitle>
        <DialogContent>
          {selectedBook ? (
            <Stack spacing={2} sx={{ mt: 1 }}>
              <Stack direction="row" spacing={1.5} sx={{ alignItems: "center" }}>
                {selectedBook.cover_url ? (
                  <Box component="img" src={selectedBook.cover_url} alt={selectedBook.title} sx={{ width: 48, height: 64, objectFit: "cover", borderRadius: 1 }} />
                ) : <Avatar variant="rounded"><BookIcon /></Avatar>}
                <Box sx={{ minWidth: 0 }}>
                  <Typography sx={{ fontWeight: 900 }} noWrap>{selectedBook.title}</Typography>
                  <Typography variant="caption" color="text.secondary" sx={{ fontFamily: "monospace" }}>ISBN: {selectedBook.isbn}</Typography>
                </Box>
              </Stack>
              <Box sx={{ display: "grid", gridTemplateColumns: "repeat(3, 1fr)", gap: 1 }}>
                <Alert severity="info">Tổng: {selectedBook.total_copies}</Alert>
                <Alert severity="success">Sẵn sàng: {selectedBook.available_copies}</Alert>
                <Alert severity="warning">Đang mượn: {selectedBook.total_copies - selectedBook.available_copies}</Alert>
              </Box>
              <TextField
                label="Số lượng mới"
                type="number"
                value={editQuantity}
                onChange={(event) => { setEditQuantity(Number(event.target.value) || 0); setQuantityError(""); }}
                error={!!quantityError}
                helperText={quantityError || "Số lượng không được nhỏ hơn số bản đang mượn"}
                fullWidth
                slotProps={{ htmlInput: { min: 1 } }}
              />
            </Stack>
          ) : null}
        </DialogContent>
        <DialogActions>
          <Button onClick={() => setSelectedBook(null)}>Hủy</Button>
          <Button variant="contained" onClick={handleQuantitySave} disabled={savingQuantity}>{savingQuantity ? "Đang lưu..." : "Lưu thay đổi"}</Button>
        </DialogActions>
      </Dialog>

      <Snackbar open={!!notice} autoHideDuration={3500} onClose={() => setNotice(null)}>
        {notice ? <Alert severity={notice.severity} onClose={() => setNotice(null)}>{notice.message}</Alert> : undefined}
      </Snackbar>

      <IsbnScannerDialog
        open={isbnScannerOpen}
        onClose={() => setIsbnScannerOpen(false)}
        onImportComplete={handleIsbnImportComplete}
      />
    </Stack>
  );
}
</file>

<file path="src/components/MultiAngleCapture.tsx">
"use client";

import { useCallback, useEffect, useMemo, useRef, useState } from "react";
import {
  Alert,
  Box,
  Button,
  Checkbox,
  Chip,
  CircularProgress,
  FormControlLabel,
  Grid,
  Paper,
  Stack,
  Typography,
  useTheme,
} from "@mui/material";
import AddAPhotoOutlinedIcon from "@mui/icons-material/AddAPhotoOutlined";
import CheckOutlinedIcon from "@mui/icons-material/CheckOutlined";
import PhotoCameraOutlinedIcon from "@mui/icons-material/PhotoCameraOutlined";
import RestartAltOutlinedIcon from "@mui/icons-material/RestartAltOutlined";

export type CaptureAngle = "frontal" | "right" | "left" | "down";
export type MultiAngleCaptureStatus = "pending" | "capturing" | "done";

export interface AngleConfig {
  angle: CaptureAngle;
  instruction: string;
  tip: string;
}

export interface CapturedAngle {
  angle: CaptureAngle;
  status: MultiAngleCaptureStatus;
  file: File | null;
  dataUrl: string | null;
}

export interface MultiAngleCaptureProps {
  angles?: AngleConfig[];
  consent: boolean;
  setConsent?: (v: boolean) => void;
  onFilesReady: (files: Record<CaptureAngle, File>) => Promise<void> | void;
  className?: string;
}

function captureFromVideo(video: HTMLVideoElement, cameraReady: boolean) {
  return new Promise<{ file: File; dataUrl: string }>((resolve, reject) => {
    if (!cameraReady) return reject(new Error("Camera chưa sẵn sàng"));
    if (video.videoWidth === 0 || video.videoHeight === 0) {
      return reject(new Error("Camera chưa khởi tạo"));
    }

    const canvas = document.createElement("canvas");
    canvas.width = video.videoWidth;
    canvas.height = video.videoHeight;

    const ctx = canvas.getContext("2d");
    if (!ctx) return reject(new Error("Không thể tạo canvas"));

    ctx.drawImage(video, 0, 0);
    const dataUrl = canvas.toDataURL("image/jpeg");
    canvas.toBlob(
      (blob) => {
        if (!blob) return reject(new Error("Không thể tạo ảnh"));
        resolve({ file: new File([blob], "face_capture.jpg", { type: "image/jpeg" }), dataUrl });
      },
      "image/jpeg",
      0.9
    );
  });
}

function getCameraErrorMessage(err: unknown) {
  const name = err instanceof DOMException ? err.name : "";
  if (name === "NotAllowedError" || name === "SecurityError") {
    return "Không có quyền truy cập camera. Hãy cấp quyền camera cho trình duyệt rồi thử lại.";
  }
  if (name === "NotFoundError" || name === "OverconstrainedError") {
    return "Không tìm thấy camera phù hợp. Hãy kiểm tra thiết bị camera rồi thử lại.";
  }
  if (name === "NotReadableError" || name === "AbortError") {
    return "Camera đang được ứng dụng khác sử dụng hoặc không mở được. Hãy đóng ứng dụng khác rồi thử lại.";
  }
  return "Không thể mở camera. Hãy kiểm tra quyền truy cập, thiết bị camera và thử lại.";
}

const ANGLE_LABELS: Record<CaptureAngle, string> = {
  frontal: "Nhìn thẳng",
  right: "Quay phải",
  left: "Quay trái",
  down: "Cúi xuống",
};

export default function MultiAngleCapture({
  angles,
  consent,
  setConsent,
  onFilesReady,
  className,
}: MultiAngleCaptureProps) {
  const theme = useTheme();
  const defaultAngles = useMemo<AngleConfig[]>(
    () =>
      angles ?? [
        { angle: "frontal", instruction: "Nhìn thẳng", tip: "Giữ mặt thẳng, mắt mở tự nhiên" },
        { angle: "right", instruction: "Quay phải", tip: "Xoay đầu sang phải khoảng 30 độ" },
        { angle: "left", instruction: "Quay trái", tip: "Xoay đầu sang trái khoảng 30 độ" },
        { angle: "down", instruction: "Cúi xuống", tip: "Cúi nhẹ cằm xuống ngực" },
      ],
    [angles]
  );

  const videoRef = useRef<HTMLVideoElement | null>(null);
  const streamRef = useRef<MediaStream | null>(null);

  const [cameraReady, setCameraReady] = useState(false);
  const [isCameraOn, setIsCameraOn] = useState(false);
  const [cameraError, setCameraError] = useState("");
  const [isSequenceRunning, setIsSequenceRunning] = useState(false);
  const [currentAngleIdx, setCurrentAngleIdx] = useState(-1);
  const [countdown, setCountdown] = useState<number | null>(null);
  const [captures, setCaptures] = useState<CapturedAngle[]>(
    defaultAngles.map((item) => ({ angle: item.angle, status: "pending", file: null, dataUrl: null }))
  );

  useEffect(() => {
    setCaptures(defaultAngles.map((item) => ({ angle: item.angle, status: "pending", file: null, dataUrl: null })));
  }, [defaultAngles]);

  const stopCamera = useCallback(() => {
    if (streamRef.current) {
      streamRef.current.getTracks().forEach((track) => track.stop());
      streamRef.current = null;
    }
    setIsCameraOn(false);
    setCameraReady(false);
  }, []);

  const startCamera = useCallback(async () => {
    try {
      setCameraError("");
      setCameraReady(false);
      setIsCameraOn(false);
      stopCamera();

      const stream = await navigator.mediaDevices.getUserMedia({
        video: {
          facingMode: "user",
          width: { ideal: 640, min: 320 },
          height: { ideal: 480, min: 240 },
        },
        audio: false,
      });

      streamRef.current = stream;
      setIsCameraOn(true);
      return true;
    } catch (err) {
      setIsCameraOn(false);
      setCameraReady(false);
      setCameraError(getCameraErrorMessage(err));
      return false;
    }
  }, [stopCamera]);

  useEffect(() => {
    if (!isCameraOn || !videoRef.current || !streamRef.current) return;

    const video = videoRef.current;
    const onReady = () => setCameraReady(true);
    const handleError = () => setCameraReady(false);

    video.onloadedmetadata = onReady;
    video.onplaying = onReady;
    video.onerror = handleError;
    video.srcObject = streamRef.current;

    if (video.readyState >= 2) onReady();
    const timer = setTimeout(() => setCameraReady(true), 3000);

    return () => {
      clearTimeout(timer);
      video.onloadedmetadata = null;
      video.onplaying = null;
      video.onerror = null;
      video.srcObject = null;
    };
  }, [isCameraOn]);

  useEffect(() => () => stopCamera(), [stopCamera]);

  const retakeAngle = useCallback(
    async (idx: number) => {
      setCaptures((prev) =>
        prev.map((item, index) => (index === idx ? { ...item, status: "pending", file: null, dataUrl: null } : item))
      );
      const opened = await startCamera();
      if (!opened) return;
      setIsSequenceRunning(true);
      setTimeout(() => setCurrentAngleIdx(idx), 500);
    },
    [startCamera]
  );

  const startSequence = useCallback(async () => {
    setCaptures(defaultAngles.map((item) => ({ angle: item.angle, status: "pending", file: null, dataUrl: null })));
    setCountdown(null);
    const opened = await startCamera();
    if (!opened) {
      setCurrentAngleIdx(-1);
      setIsSequenceRunning(false);
      return;
    }
    setCurrentAngleIdx(0);
    setIsSequenceRunning(true);
  }, [defaultAngles, startCamera]);

  useEffect(() => {
    if (currentAngleIdx < 0 || currentAngleIdx >= defaultAngles.length) return;
    if (!cameraReady || !isSequenceRunning) return;

    let cancelled = false;
    let currentCountdown = 5;

    setCountdown(currentCountdown);
    setCaptures((prev) => prev.map((item, index) => (index === currentAngleIdx ? { ...item, status: "capturing" } : item)));

    const timer = window.setInterval(async () => {
      currentCountdown--;
      if (cancelled) {
        clearInterval(timer);
        return;
      }

      if (currentCountdown <= 0) {
        clearInterval(timer);
        setCountdown(null);

        try {
          const video = videoRef.current;
          if (!video) throw new Error("Không tìm thấy video");

          const { file, dataUrl } = await captureFromVideo(video, cameraReady);
          if (cancelled) return;

          setCaptures((prev) =>
            prev.map((item, index) => (index === currentAngleIdx ? { ...item, status: "done", file, dataUrl } : item))
          );

          const nextIdx = currentAngleIdx + 1;
          if (nextIdx >= defaultAngles.length) {
            setIsSequenceRunning(false);
            setCurrentAngleIdx(-1);
            stopCamera();
          } else {
            setTimeout(() => {
              if (!cancelled) setCurrentAngleIdx(nextIdx);
            }, 800);
          }
        } catch (err) {
          if (cancelled) return;
          setCameraError(getCameraErrorMessage(err));
          setCaptures((prev) => prev.map((item, index) => (index === currentAngleIdx ? { ...item, status: "pending" } : item)));
          setIsSequenceRunning(false);
          setCurrentAngleIdx(-1);
          stopCamera();
        }
      } else {
        setCountdown(currentCountdown);
      }
    }, 1000);

    return () => {
      cancelled = true;
      clearInterval(timer);
    };
  }, [currentAngleIdx, cameraReady, isSequenceRunning, defaultAngles.length, stopCamera]);

  const allCaptured = captures.every((item) => item.status === "done" && Boolean(item.file));
  const doneCount = captures.filter((item) => item.status === "done").length;

  const capturedFiles = useMemo(() => {
    const result = {} as Record<CaptureAngle, File>;
    for (const item of captures) {
      if (item.status === "done" && item.file) {
        result[item.angle] = item.file;
      }
    }
    return result;
  }, [captures]);

  const submit = useCallback(async () => {
    if (!consent || !allCaptured) return;
    await onFilesReady(capturedFiles);
  }, [allCaptured, capturedFiles, consent, onFilesReady]);

  const currentConfig = currentAngleIdx >= 0 ? defaultAngles[currentAngleIdx] : null;

  return (
    <Box className={className}>
      {!allCaptured && !isSequenceRunning && currentAngleIdx < 0 && (
        <Paper variant="outlined" sx={{ p: 3, textAlign: "center" }}>
          <Stack spacing={2} sx={{ alignItems: "center" }}>
            <Box
              sx={{
                width: 64,
                height: 64,
                borderRadius: "50%",
                display: "grid",
                placeItems: "center",
                bgcolor: "primary.main",
                color: "primary.contrastText",
              }}
            >
              <PhotoCameraOutlinedIcon fontSize="large" />
            </Box>
            <Box>
              <Typography variant="h6" sx={{ fontWeight: 850 }}>
                Chụp khuôn mặt từ 4 góc
              </Typography>
              <Typography color="text.secondary">
                Nhận diện nhanh hơn, chính xác hơn tại cổng.
              </Typography>
            </Box>

            <Paper variant="outlined" sx={{ p: 2, width: "100%", bgcolor: "action.hover", textAlign: "left" }}>
              <Typography variant="subtitle2" color="primary" sx={{ fontWeight: 850, mb: 1 }}>
                Lưu ý khi chụp
              </Typography>
              <Stack spacing={0.5}>
                <Typography variant="body2" color="text.secondary">- Đủ ánh sáng, không ngược sáng.</Typography>
                <Typography variant="body2" color="text.secondary">- Giữ yên khi đếm ngược về 0.</Typography>
                <Typography variant="body2" color="text.secondary">- Mặt vừa đủ trong khung tròn.</Typography>
              </Stack>
            </Paper>

            {cameraError && <Alert severity="warning" sx={{ width: "100%" }}>{cameraError}</Alert>}

            <Button variant="contained" size="large" startIcon={<PhotoCameraOutlinedIcon />} onClick={startSequence}>
              Bắt đầu chụp
            </Button>
          </Stack>
        </Paper>
      )}

      {(isSequenceRunning || currentAngleIdx >= 0) && (
        <Paper
          variant="outlined"
          sx={{
            position: "relative",
            aspectRatio: "16 / 9",
            overflow: "hidden",
            bgcolor: "black",
          }}
        >
          <Box component="video" ref={videoRef} autoPlay playsInline muted sx={{ width: "100%", height: "100%", objectFit: "contain" }} />
          <Box
            sx={{
              position: "absolute",
              inset: 0,
              display: "flex",
              alignItems: "center",
              justifyContent: "center",
              pointerEvents: "none",
            }}
          >
            <Box sx={{ width: 150, height: 150, border: 2, borderColor: "primary.main", borderRadius: "50%", opacity: 0.75 }} />
          </Box>

          {!cameraReady && (
            <Stack
              spacing={1}
              sx={{
                position: "absolute",
                inset: 0,
                alignItems: "center",
                justifyContent: "center",
                bgcolor: "rgba(0,0,0,.65)",
                color: "common.white",
              }}
            >
              <CircularProgress color="inherit" size={30} />
              <Typography variant="body2">{cameraError || "Đang mở camera..."}</Typography>
            </Stack>
          )}

          {countdown !== null && currentConfig && (
            <Stack
              spacing={2}
              sx={{
                position: "absolute",
                inset: 0,
                alignItems: "center",
                justifyContent: "center",
                bgcolor: "rgba(0,0,0,.78)",
                color: "common.white",
                textAlign: "center",
                p: 2,
              }}
            >
              <Box>
                <Typography variant="h5" sx={{ fontWeight: 850 }}>{currentConfig.instruction}</Typography>
                <Typography variant="body2" sx={{ color: "grey.300", mt: 0.5 }}>{currentConfig.tip}</Typography>
              </Box>
              <Stack direction="row" spacing={1}>
                {defaultAngles.map((item, index) => (
                  <Box
                    key={item.angle}
                    sx={{
                      width: 12,
                      height: 12,
                      borderRadius: "50%",
                      bgcolor: index < doneCount ? "success.main" : index === currentAngleIdx ? "primary.main" : "grey.600",
                    }}
                  />
                ))}
              </Stack>
              {countdown === 1 && <Chip color="error" label="GIỮ YÊN!" />}
              <Typography sx={{ fontSize: 64, fontWeight: 900, lineHeight: 1 }}>{countdown}</Typography>
            </Stack>
          )}
        </Paper>
      )}

      {allCaptured && (
        <Stack spacing={2}>
          <Grid container spacing={1.5}>
            {captures.map((item, index) => (
              <Grid key={item.angle} size={{ xs: 6, sm: 3 }}>
                <Paper
                  variant="outlined"
                  sx={{
                    position: "relative",
                    aspectRatio: "1 / 1",
                    overflow: "hidden",
                    borderColor: item.status === "done" ? "success.main" : "divider",
                  }}
                >
                  {item.dataUrl ? (
                    <Box component="img" src={item.dataUrl} alt={item.angle} sx={{ width: "100%", height: "100%", objectFit: "cover" }} />
                  ) : (
                    <Stack sx={{ height: "100%", alignItems: "center", justifyContent: "center", bgcolor: "action.hover", color: "text.secondary" }}>
                      <PhotoCameraOutlinedIcon />
                    </Stack>
                  )}
                  <Chip
                    size="small"
                    label={ANGLE_LABELS[item.angle]}
                    sx={{ position: "absolute", left: 6, bottom: 6, bgcolor: "rgba(0,0,0,.72)", color: "common.white" }}
                  />
                  {item.status === "done" && (
                    <Box sx={{ position: "absolute", top: 6, right: 6, width: 24, height: 24, borderRadius: "50%", bgcolor: "success.main", color: "success.contrastText", display: "grid", placeItems: "center" }}>
                      <CheckOutlinedIcon sx={{ fontSize: 16 }} />
                    </Box>
                  )}
                </Paper>
              </Grid>
            ))}
          </Grid>

          <Stack direction={{ xs: "column", sm: "row" }} spacing={1}>
            {captures.map((item, index) => (
              <Button
                key={item.angle}
