            >
              <span>
                <Button
                  variant="outlined"
                  color="primary"
                  disabled={!canCreate}
                  startIcon={<FileUploadIcon />}
                  onClick={onImportExcel}
                  sx={{
                    borderRadius: 2,
                    fontWeight: 700,
                    px: 2,
                    py: 0.85,
                    fontSize: "0.85rem",
                    textTransform: "none",
                    whiteSpace: "nowrap",
                    borderWidth: 1.5,
                    "&:hover": {
                      borderWidth: 1.5,
                      bgcolor: "primary.lighter",
                    },
                  }}
                >
                  Import Excel
                </Button>
              </span>
            </Tooltip>
          )}
        </Stack>
      </Stack>

      <Divider sx={{ my: 0.25 }} />

      {/* Tầng 2: Bộ lọc trạng thái dạng Pills cuộn ngang chống đè/tràn */}
      <Stack direction="row" spacing={1} sx={{ alignItems: "center" }}>
        <Box
          sx={{
            display: "flex",
            alignItems: "center",
            gap: 0.5,
            color: "text.secondary",
            fontSize: "0.78rem",
            fontWeight: 600,
            flexShrink: 0,
            mr: 0.5,
          }}
        >
          <FilterListIcon sx={{ fontSize: 18 }} />
          Lọc:
        </Box>

        <Box
          sx={{
            flex: 1,
            overflowX: "auto",
            whiteSpace: "nowrap",
            py: 0.25,
            pb: 0.5,
            scrollbarWidth: "thin",
            "&::-webkit-scrollbar": { height: 4 },
            "&::-webkit-scrollbar-thumb": {
              bgcolor: "divider",
              borderRadius: 2,
            },
          }}
        >
          <ToggleButtonGroup
            value={filter}
            exclusive
            onChange={(_, v) => {
              if (v) onFilterChange(v);
            }}
            size="small"
            sx={{
              display: "inline-flex",
              flexWrap: "nowrap",
              gap: 0.75,
              "& .MuiToggleButton-root": {
                border: "1px solid",
                borderColor: "divider",
                borderRadius: "20px !important",
                px: 1.75,
                py: 0.45,
                fontSize: "0.75rem",
                fontWeight: 600,
                textTransform: "none",
                color: "text.secondary",
                whiteSpace: "nowrap",
                transition: "all 0.15s ease",
                "&:hover": {
                  bgcolor: "action.hover",
                  borderColor: "text.secondary",
                },
                "&.Mui-selected": {
                  bgcolor: "primary.main",
                  color: "#fff",
                  borderColor: "primary.main",
                  boxShadow: "0 2px 6px rgba(10, 37, 64, 0.2)",
                  "&:hover": { bgcolor: "primary.dark" },
                },
              },
            }}
          >
            {FILTERS.map((f) => (
              <ToggleButton key={f.value} value={f.value}>
                {f.label}
              </ToggleButton>
            ))}
          </ToggleButtonGroup>
        </Box>
      </Stack>
    </Box>
  );
}
