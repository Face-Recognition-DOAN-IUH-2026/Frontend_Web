<file path="src/components/library-3d/UserRobot.tsx">
"use client";

import { useRef, useEffect, useState } from "react";
import { useFrame } from "@react-three/fiber";
import { useGLTF, Html } from "@react-three/drei";
import type { GLTF } from "three-stdlib";
import * as THREE from "three";
import type { RemoteRobot } from "./types/multiplayer";

interface UserRobotProps {
  robot: RemoteRobot;
}

type AnimationState = "Idle" | "Walking" | "Sitting" | "Wave" | "Thinking" | "Talking";

export default function UserRobot({ robot }: UserRobotProps) {
  const { scene, animations } = useGLTF(
    "/models/gltf/RobotExpressive/RobotExpressive.glb"
  ) as GLTF;

  const group = useRef<THREE.Group>(null);
  const mixer = useRef<THREE.AnimationMixer | null>(null);
  const actions = useRef<Record<string, THREE.AnimationAction>>({});
  const currentAction = useRef<THREE.AnimationAction | null>(null);
  const [currentAnimState, setCurrentAnimState] = useState<AnimationState>("Idle");

  const targetPosition = useRef(new THREE.Vector3(...robot.position));
  const currentPosition = useRef(new THREE.Vector3(...robot.position));
  const prevChatState = useRef(robot.chatState);

  useEffect(() => {
    if (!scene) return;

    mixer.current = new THREE.AnimationMixer(scene);

    animations.forEach((clip) => {
      const action = mixer.current!.clipAction(clip);
      actions.current[clip.name] = action;

      if (["Idle", "Walking", "Running"].includes(clip.name)) {
        action.loop = THREE.LoopRepeat;
      } else {
        action.clampWhenFinished = true;
        action.loop = THREE.LoopOnce;
      }
    });

    const idleAction = actions.current["Idle"];
    if (idleAction) {
      idleAction.play();
      currentAction.current = idleAction;
    }

    return () => {
      mixer.current?.stopAllAction();
    };
  }, [scene, animations]);

  useEffect(() => {
    targetPosition.current.set(...robot.position);
  }, [robot.position]);

  useEffect(() => {
    if (robot.chatState !== prevChatState.current) {
      prevChatState.current = robot.chatState;

      let targetAnim: AnimationState = "Idle";
      if (robot.chatState === "thinking") {
        targetAnim = "Thinking";
      } else if (robot.chatState === "responding") {
        targetAnim = "Talking";
      }

      if (targetAnim !== currentAnimState) {
        fadeToAction(targetAnim, 0.5);
        setCurrentAnimState(targetAnim);
      }
    }
  }, [robot.chatState, currentAnimState]);

  useFrame((_, delta) => {
    if (!group.current) return;

    if (mixer.current) {
      mixer.current.update(delta);
    }

    const distance = currentPosition.current.distanceTo(targetPosition.current);
    if (distance > 0.01) {
      currentPosition.current.lerp(targetPosition.current, delta * 5);
      group.current.position.copy(currentPosition.current);

      const dir = targetPosition.current.clone().sub(currentPosition.current).normalize();
      if (dir.length() > 0.01) {
        const targetRotation = Math.atan2(dir.x, dir.z);
        group.current.rotation.y = THREE.MathUtils.lerp(
          group.current.rotation.y,
          targetRotation,
          delta * 8
        );
      }
    } else {
      group.current.position.copy(currentPosition.current);
      group.current.rotation.y = THREE.MathUtils.lerp(
        group.current.rotation.y,
        robot.rotation,
        delta * 8
      );
    }

    if (group.current && currentAnimState === "Idle") {
      group.current.position.y = robot.position[1] + Math.sin(Date.now() * 0.001) * 0.05;
    }
  });

  const fadeToAction = (name: AnimationState, duration: number) => {
    const previousAction = currentAction.current;
    const newAction = actions.current[name];

    if (!newAction || previousAction === newAction) return;

    if (previousAction) {
      previousAction.fadeOut(duration);
    }

    newAction
      .reset()
      .setEffectiveTimeScale(1)
      .setEffectiveWeight(1)
      .fadeIn(duration)
      .play();

    currentAction.current = newAction;
  };

  const getUserColor = (name: string) => {
    let hash = 0;
    for (let i = 0; i < name.length; i++) {
      hash = name.charCodeAt(i) + ((hash << 5) - hash);
    }
    const hue = Math.abs(hash % 360);
    return `hsl(${hue}, 70%, 50%)`;
  };

  return (
    <group ref={group}>
      <primitive object={scene} scale={0.8} />

      <Html position={[0, 2, 0]} center distanceFactor={12}>
        <div
          className="px-2 py-1 rounded-lg text-white text-xs font-medium whitespace-nowrap"
          style={{ backgroundColor: getUserColor(robot.userName) }}
        >
          {robot.userName}
        </div>
      </Html>

      {robot.chatState === "responding" && robot.message && (
        <Html position={[0, 2.5, 0]} center distanceFactor={10}>
          <div className="bg-white rounded-xl px-4 py-2 shadow-lg max-w-xs text-sm text-gray-800 relative">
            <div className="absolute -bottom-2 left-1/2 -translate-x-1/2 w-0 h-0 border-l-8 border-r-8 border-t-8 border-transparent border-t-white" />
            {robot.message}
          </div>
        </Html>
      )}

      {robot.chatState === "thinking" && (
        <Html position={[0, 2.5, 0]} center distanceFactor={10}>
          <div className="bg-blue-500 rounded-full px-3 py-1 flex gap-1">
            <span className="w-2 h-2 bg-white rounded-full animate-bounce" style={{ animationDelay: "0ms" }} />
            <span className="w-2 h-2 bg-white rounded-full animate-bounce" style={{ animationDelay: "150ms" }} />
            <span className="w-2 h-2 bg-white rounded-full animate-bounce" style={{ animationDelay: "300ms" }} />
          </div>
        </Html>
      )}
    </group>
  );
}

useGLTF.preload("/models/gltf/RobotExpressive/RobotExpressive.glb");
</file>

<file path="src/components/library-3d/utils/PathfindingGrid.ts">
import * as THREE from "three";

const CELL_SIZE = 0.25; // 0.25m resolution
const GRID_WIDTH = 120; // 30m / 0.25m
const GRID_HEIGHT = 80; // 20m / 0.25m

// Offset to center the grid at (0, 0)
const GRID_OFFSET_X = GRID_WIDTH / 2;
const GRID_OFFSET_Z = GRID_HEIGHT / 2;

interface GridCell {
  x: number;
  z: number;
  walkable: boolean;
}

interface PathNode {
  x: number;
  z: number;
  g: number; // cost from start
  h: number; // heuristic to end
  f: number; // g + h
  parent: PathNode | null;
}

export class PathfindingGrid {
  private grid: Uint8Array;
  private width: number;
  private height: number;

  constructor(shelves: Array<{ position: [number, number, number]; numTiers?: number }>) {
    this.width = GRID_WIDTH;
    this.height = GRID_HEIGHT;
    this.grid = new Uint8Array(this.width * this.height);

    // Initialize all cells as walkable
    this.grid.fill(0);

    // Mark obstacles from shelves
    this.markShelvesAsObstacles(shelves);
  }

  private markShelvesAsObstacles(shelves: Array<{ position: [number, number, number] }>) {
    for (const shelf of shelves) {
      const [worldX, , worldZ] = shelf.position;
      const gridX = this.worldToGridX(worldX);
      const gridZ = this.worldToGridZ(worldZ);

      // Mark shelf footprint as obstacle (shelf size ~ 2m x 1m)
      const shelfWidthCells = Math.ceil(2.0 / CELL_SIZE); // 8 cells
      const shelfDepthCells = Math.ceil(1.0 / CELL_SIZE); // 4 cells

      for (let dx = -1; dx <= shelfWidthCells; dx++) {
        for (let dz = -1; dz <= shelfDepthCells; dz++) {
          const x = gridX + dx;
          const z = gridZ + dz;
          if (x >= 0 && x < this.width && z >= 0 && z < this.height) {
            this.grid[z * this.width + x] = 1; // obstacle
          }
        }
      }
    }
  }

  worldToGridX(worldX: number): number {
    return Math.floor(worldX / CELL_SIZE + GRID_OFFSET_X);
  }

  worldToGridZ(worldZ: number): number {
    return Math.floor(worldZ / CELL_SIZE + GRID_OFFSET_Z);
  }

  gridToWorldX(gridX: number): number {
    return (gridX - GRID_OFFSET_X) * CELL_SIZE;
  }

  gridToWorldZ(gridZ: number): number {
    return (gridZ - GRID_OFFSET_Z) * CELL_SIZE;
  }

  isWalkable(x: number, z: number): boolean {
    if (x < 0 || x >= this.width || z < 0 || z >= this.height) {
      return false;
    }
    return this.grid[z * this.width + x] === 0;
  }

  setObstacle(x: number, z: number, walkable: boolean) {
    if (x >= 0 && x < this.width && z >= 0 && z < this.height) {
      this.grid[z * this.width + x] = walkable ? 0 : 1;
    }
  }

  findPath(startWorld: THREE.Vector3, endWorld: THREE.Vector3): THREE.Vector3[] {
    const startX = this.worldToGridX(startWorld.x);
    const startZ = this.worldToGridZ(startWorld.z);
    const endX = this.worldToGridX(endWorld.x);
    const endZ = this.worldToGridZ(endWorld.z);

    // Check if start/end are walkable
    if (!this.isWalkable(startX, startZ)) {
      // Find nearest walkable cell
      const nearest = this.findNearestWalkable(startX, startZ);
      if (!nearest) return [];
      return this.findPath(
        new THREE.Vector3(this.gridToWorldX(nearest.x), 0, this.gridToWorldZ(nearest.z)),
        endWorld
      );
    }

    if (!this.isWalkable(endX, endZ)) {
      const nearest = this.findNearestWalkable(endX, endZ);
      if (!nearest) return [];
      return this.findPath(
        startWorld,
        new THREE.Vector3(this.gridToWorldX(nearest.x), 0, this.gridToWorldZ(nearest.z))
      );
    }

    // A* algorithm
    const openSet: PathNode[] = [];
    const closedSet = new Set<string>();

    const startNode: PathNode = {
      x: startX,
      z: startZ,
      g: 0,
      h: this.heuristic(startX, startZ, endX, endZ),
      f: 0,
      parent: null,
    };
    startNode.f = startNode.g + startNode.h;
    openSet.push(startNode);

    const directions = [
      { dx: 0, dz: -1, cost: 1 }, // up
      { dx: 0, dz: 1, cost: 1 }, // down
      { dx: -1, dz: 0, cost: 1 }, // left
      { dx: 1, dz: 0, cost: 1 }, // right
      { dx: -1, dz: -1, cost: 1.414 }, // diagonal
      { dx: 1, dz: -1, cost: 1.414 },
      { dx: -1, dz: 1, cost: 1.414 },
      { dx: 1, dz: 1, cost: 1.414 },
    ];

    while (openSet.length > 0) {
      // Find node with lowest f
      let lowestIndex = 0;
      for (let i = 1; i < openSet.length; i++) {
        if (openSet[i].f < openSet[lowestIndex].f) {
          lowestIndex = i;
        }
      }
      const current = openSet[lowestIndex];

      // Found goal
      if (current.x === endX && current.z === endZ) {
        return this.reconstructPath(current);
      }

      // Move current from open to closed
      openSet.splice(lowestIndex, 1);
      closedSet.add(`${current.x},${current.z}`);

      // Check neighbors
      for (const dir of directions) {
        const neighborX = current.x + dir.dx;
        const neighborZ = current.z + dir.dz;
        const neighborKey = `${neighborX},${neighborZ}`;

        // Skip if out of bounds or not walkable
        if (!this.isWalkable(neighborX, neighborZ)) continue;
        if (closedSet.has(neighborKey)) continue;

        // For diagonal movement, check if adjacent cells are walkable
        if (dir.dx !== 0 && dir.dz !== 0) {
          if (
            !this.isWalkable(current.x + dir.dx, current.z) ||
            !this.isWalkable(current.x, current.z + dir.dz)
          ) {
            continue;
          }
        }

        const g = current.g + dir.cost;
        const h = this.heuristic(neighborX, neighborZ, endX, endZ);
        const f = g + h;

        // Check if this path to neighbor is better
        const existingIndex = openSet.findIndex(
          (n) => n.x === neighborX && n.z === neighborZ
        );
        if (existingIndex >= 0 && openSet[existingIndex].g <= g) {
          continue;
        }

        const neighborNode: PathNode = {
          x: neighborX,
          z: neighborZ,
          g,
          h,
          f,
          parent: current,
        };

        if (existingIndex >= 0) {
          openSet[existingIndex] = neighborNode;
        } else {
          openSet.push(neighborNode);
        }
      }
    }

    return []; // No path found
  }

  private heuristic(x1: number, z1: number, x2: number, z2: number): number {
    // Octile distance
    const dx = Math.abs(x1 - x2);
    const dz = Math.abs(z1 - z2);
    return Math.max(dx, dz) + (1.414 - 1) * Math.min(dx, dz);
  }

  private reconstructPath(node: PathNode): THREE.Vector3[] {
    const path: THREE.Vector3[] = [];
    let current: PathNode | null = node;

    while (current) {
      path.unshift(
        new THREE.Vector3(this.gridToWorldX(current.x), 0, this.gridToWorldZ(current.z))
      );
      current = current.parent;
    }

    return path;
  }

  private findNearestWalkable(x: number, z: number): { x: number; z: number } | null {
    const maxRadius = 20;
    for (let radius = 1; radius <= maxRadius; radius++) {
      for (let dx = -radius; dx <= radius; dx++) {
        for (let dz = -radius; dz <= radius; dz++) {
          if (Math.abs(dx) !== radius && Math.abs(dz) !== radius) continue;
          const nx = x + dx;
          const nz = z + dz;
          if (this.isWalkable(nx, nz)) {
            return { x: nx, z: nz };
          }
        }
      }
    }
    return null;
  }
}
</file>

<file path="src/components/PatronFaceVerify.tsx">
"use client";

import { useCallback, useRef, useState } from "react";
import {
  Avatar,
  Box,
  Button,
  CircularProgress,
  Dialog,
  DialogActions,
  DialogContent,
  DialogTitle,
  IconButton,
  Stack,
  TextField,
  Typography,
} from "@mui/material";
import CameraAltIcon from "@mui/icons-material/CameraAltOutlined";
import CloseIcon from "@mui/icons-material/Close";
import PersonIcon from "@mui/icons-material/PersonOutlined";
import api, { getErrorMessage } from "@/lib/api-client";
import type { PatronPublic } from "@/lib/types";

export interface PatronVerifyResult {
  patron_id: string;
  student_code: string;
  full_name: string;
  score: number;
}

interface Props {
  onVerified: (result: PatronVerifyResult) => void;
  onClose?: () => void;
}

export default function PatronFaceVerify({ onVerified, onClose }: Props) {
  const [open, setOpen] = useState(true);
  const [studentCode, setStudentCode] = useState("");
  const [capturing, setCapturing] = useState(false);
  const [verifying, setVerifying] = useState(false);
  const [error, setError] = useState("");
  const videoRef = useRef<HTMLVideoElement>(null);
  const streamRef = useRef<MediaStream | null>(null);
  const [cameraReady, setCameraReady] = useState(false);

  const stopCamera = useCallback(() => {
    if (streamRef.current) {
      streamRef.current.getTracks().forEach((t) => t.stop());
      streamRef.current = null;
    }
    setCameraReady(false);
  }, []);

  const handleOpen = useCallback(async () => {
    setError("");
    try {
      const stream = await navigator.mediaDevices.getUserMedia({
        video: { facingMode: "user", width: { ideal: 640 }, height: { ideal: 480 } },
        audio: false,
      });
      streamRef.current = stream;
      if (videoRef.current) {
        videoRef.current.srcObject = stream;
        videoRef.current.onloadedmetadata = () => setCameraReady(true);
      }
    } catch (err: any) {
      if (err.name === "NotAllowedError") {
        setError("Không có quyền truy cập camera. Hãy cấp quyền camera cho trình duyệt.");
      } else if (err.name === "NotFoundError") {
        setError("Không tìm thấy camera trên thiết bị.");
      } else {
        setError("Không thể khởi động camera.");
      }
    }
  }, []);

  const handleClose = useCallback(() => {
    stopCamera();
    setOpen(false);
    onClose?.();
  }, [stopCamera, onClose]);

  const captureAndVerify = useCallback(async () => {
    if (!videoRef.current || !studentCode.trim()) return;

    setCapturing(true);
    setError("");

    try {
      const canvas = document.createElement("canvas");
      canvas.width = videoRef.current.videoWidth;
      canvas.height = videoRef.current.videoHeight;
      const ctx = canvas.getContext("2d");
      if (!ctx) throw new Error("Canvas context error");
      ctx.drawImage(videoRef.current, 0, 0);

      const blob = await new Promise<Blob>((resolve, reject) => {
        canvas.toBlob((b) => {
          if (b) resolve(b);
          else reject(new Error("Canvas toBlob failed"));
        }, "image/jpeg", 0.85);
      });

      const file = new File([blob], "capture.jpg", { type: "image/jpeg" });

      setVerifying(true);
      const result = await api.kioskEnter(file, studentCode.trim());

      if (result.job_id) {
        let attempts = 0;
        const maxAttempts = 30;
        while (attempts < maxAttempts) {
          await new Promise((r) => setTimeout(r, 1000));
          const taskStatus = await api.getTaskStatus(result.job_id);
          if (taskStatus.status === "SUCCESS" && taskStatus.result) {
            const patronResult: PatronVerifyResult = {
              patron_id: taskStatus.result.patron_id || "",
              student_code: taskStatus.result.student_code || studentCode,
              full_name: taskStatus.result.full_name || "",
              score: taskStatus.result.score || 0,
            };
            stopCamera();
            setOpen(false);
            onVerified(patronResult);
            return;
          }
          if (taskStatus.status === "FAILURE" || taskStatus.status === "ERROR") {
            const errMsg = taskStatus.result?.error || taskStatus.result?.detail || "Xác minh khuôn mặt thất bại";
            setError(typeof errMsg === "string" ? errMsg : JSON.stringify(errMsg));
            setVerifying(false);
            return;
          }
          attempts++;
        }
        setError("Hết thời gian chờ xác minh. Vui lòng thử lại.");
      } else if (result.patron) {
        const patronResult: PatronVerifyResult = {
          patron_id: result.patron.id,
          student_code: result.patron.student_code || studentCode,
          full_name: result.patron.full_name || "",
          score: result.confidence || 0,
        };
        stopCamera();
        setOpen(false);
        onVerified(patronResult);
        return;
      } else {
        setError(result.message || "Không nhận diện được khuôn mặt");
      }
    } catch (err) {
      setError(getErrorMessage(err) || "Lỗi xác minh khuôn mặt");
    } finally {
      setCapturing(false);
      setVerifying(false);
    }
  }, [studentCode, stopCamera, onVerified]);

  return (
    <Dialog open={open} onClose={handleClose} maxWidth="sm" fullWidth>
      <DialogTitle>
        <Stack direction="row" spacing={1} sx={{ alignItems: "center", justifyContent: "space-between" }}>
          <Stack direction="row" spacing={1} sx={{ alignItems: "center" }}>
            <PersonIcon color="primary" />
            <Typography variant="h6" sx={{ fontWeight: 900 }}>Xác minh độc giả bằng khuôn mặt</Typography>
          </Stack>
          <IconButton size="small" onClick={handleClose}><CloseIcon /></IconButton>
        </Stack>
      </DialogTitle>
      <DialogContent dividers>
        <Stack spacing={3}>
          <Typography variant="body2" color="text.secondary">
            Nhập mã số sinh viên và đưa khuôn mặt vào camera để xác minh độc giả đang ở trong thư viện.
          </Typography>

          <TextField
            label="Mã số sinh viên"
            value={studentCode}
            onChange={(e) => setStudentCode(e.target.value)}
            placeholder="VD: B21DCCN001"
            fullWidth
            slotProps={{ htmlInput: { sx: { fontFamily: "monospace" } } }}
          />

          <Box
            sx={{
              position: "relative",
              aspectRatio: "4/3",
              bgcolor: "black",
              borderRadius: 1,
              overflow: "hidden",
              display: "flex",
              alignItems: "center",
              justifyContent: "center",
            }}
          >
            {!streamRef.current ? (
              <Stack spacing={2} sx={{ alignItems: "center", color: "grey.300", p: 3 }}>
                <CameraAltIcon sx={{ fontSize: 48 }} />
                <Button variant="outlined" onClick={handleOpen} startIcon={<CameraAltIcon />}>
                  Bật camera
                </Button>
              </Stack>
            ) : (
              <>
                <Box
                  component="video"
                  ref={videoRef}
                  autoPlay
                  playsInline
                  muted
                  sx={{ width: "100%", height: "100%", objectFit: "contain", transform: "scaleX(-1)" }}
                />
                {!cameraReady && (
                  <Stack sx={{ position: "absolute", inset: 0, bgcolor: "rgba(0,0,0,.55)", color: "common.white", alignItems: "center", justifyContent: "center" }} spacing={1}>
                    <CircularProgress size={26} color="inherit" />
                    <Typography variant="body2">Đang kết nối camera...</Typography>
                  </Stack>
                )}
              </>
            )}
          </Box>

          {error && (
            <Box sx={{ p: 1.5, bgcolor: "error.50", borderRadius: 1, border: 1, borderColor: "error.main" }}>
              <Typography color="error" variant="body2">{error}</Typography>
            </Box>
          )}
        </Stack>
      </DialogContent>
      <DialogActions>
        <Button onClick={handleClose} disabled={verifying}>Hủy</Button>
        <Button
          variant="contained"
          disabled={verifying || !studentCode.trim() || !streamRef.current}
          onClick={captureAndVerify}
          startIcon={verifying ? <CircularProgress size={16} color="inherit" /> : <CameraAltIcon />}
        >
          {verifying ? "Đang xác minh..." : "Chụp & Xác minh"}
        </Button>
      </DialogActions>
    </Dialog>
  );
}
</file>

