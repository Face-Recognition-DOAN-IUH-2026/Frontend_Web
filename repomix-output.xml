                  borderRadius: 1.5,
                  cursor: "pointer",
                  display: "flex",
                  alignItems: "center",
                  justifyContent: "space-between",
                  bgcolor: isSelected
                    ? alpha(primaryColor, isDark ? 0.15 : 0.08)
