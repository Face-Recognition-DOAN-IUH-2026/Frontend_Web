            left: isMobile ? 0 : "auto",
            zIndex: 99999,
            display: "flex",
            flexDirection: "column",
            alignItems: "flex-end",
          }}
        >
          <motion.div
            initial={{ x: panelWidth, opacity: 0 }}
            animate={{ x: 0, opacity: 1 }}
            exit={{ x: panelWidth, opacity: 0 }}
            transition={{
              type: "spring",
              stiffness: 300,
              damping: 30,
            }}
            style={{
              width: panelWidth,
              height: "100%",
              display: "flex",
              flexDirection: "column",
            }}
          >
