    --chat--input--font-size: 0.9375rem;
    --chat--input--line-height: 1.5;
    --chat--input--padding: 10px 14px;
    --chat--input--width: 100%;
    --chat--input--container--background: #ffffff;
    --chat--input--container--border: 1px solid #DEE2E6;
    --chat--input--container--border-radius: 12px;
    --chat--input--container--padding: 8px;
    --chat--textarea--height: 38px;
    --chat--textarea--max-height: 120px;

    /* Send button */
    --chat--input--send--button--background: #8B0000;
    --chat--input--send--button--background-hover: #700000;
    --chat--input--send--button--color: #ffffff;
    --chat--input--send--button--color-hover: #ffffff;

    /* File button */
    --chat--input--file--button--background: transparent;
    --chat--input--file--button--background-hover: rgba(139,0,0,0.08);
    --chat--input--file--button--color: #94A3B8;
    --chat--input--file--button--color-hover: #8B0000;

    /* Buttons */
    --chat--button--border-radius: 8px;
    --chat--button--border--radius: 8px;
    --chat--button--font-size: 0.875rem;
    --chat--button--line-height: 1.5;
    --chat--button--padding: 10px 20px;
    --chat--button--background--primary: #8B0000;
    --chat--button--background--primary--hover: #700000;
    --chat--button--background--primary--disabled: #DEE2E6;
    --chat--button--color--primary: #ffffff;
    --chat--button--color--primary--hover: #ffffff;
    --chat--button--color--primary--disabled: #94A3B8;
    --chat--button--border--primary: none;
    --chat--button--border--primary--hover: none;
    --chat--button--border--primary--disabled: none;
    --chat--button--background--secondary: transparent;
    --chat--button--background--secondary--hover: rgba(139,0,0,0.08);
    --chat--button--background--secondary--disabled: transparent;
    --chat--button--color--secondary: #8B0000;
    --chat--button--color--secondary--hover: #700000;
    --chat--button--color--secondary--disabled: #94A3B8;
    --chat--button--border--secondary: 1px solid #8B0000;
    --chat--button--border--secondary--hover: 1px solid #700000;
    --chat--button--border--secondary--disabled: 1px solid #DEE2E6;
    --chat--close--button--color-hover: #8B0000;
  }


  /* Dark mode — IUH Navy-based dark theme */
  .dark {
    --color-bg: 7 21 36;              /* #071524 - IUH Navy deep */
    --color-surface: 12 30 50;        /* #0C1E32 */
    --color-surface-2: 30 51 69;      /* #1E3347 */
    --color-surface-3: 51 65 81;      /* #334155 */
    --color-primary: 139 0 0;         /* #8B0000 - IUH Red */
    --color-primary-dark: 112 0 0;    /* #700000 */
    --color-primary-dim: 0 100% 27%;
    --color-secondary: 212 175 55;    /* #D4AF37 - IUH Gold */
    --color-secondary-dark: 179 142 34;
    --color-tertiary: 148 163 184;    /* #94A3B8 */
    --color-success: 5 150 105;       /* #059669 */
    --color-success-bg: 6 78 59;      /* #064E3B */
    --color-error: 163 29 29;         /* #A31D1D */
    --color-error-bg: 69 10 10;       /* #450A0A */
    --color-warning: 245 158 11;      /* #F59E0B */
    --color-warning-bg: 120 53 15;    /* #78350F */
    --color-info: 148 163 184;        /* #94A3B8 */
    --color-info-bg: 30 51 69;
