"use client";

import { useState, useRef, useEffect, useMemo } from "react";
import {
  Alert,
  Avatar,
  Box,
  Button,
  Chip,
  CircularProgress,
  Dialog,
  DialogActions,
  DialogContent,
  DialogTitle,
  IconButton,
  Paper,
  Stack,
  TextField,
  Tooltip,
  Typography,
  alpha,
} from "@mui/material";
import SendIcon from "@mui/icons-material/SendOutlined";
import CheckCircleIcon from "@mui/icons-material/CheckCircleOutlineOutlined";
import CancelIcon from "@mui/icons-material/CancelOutlined";
import AssistantIcon from "@mui/icons-material/SupportAgentOutlined";
import WarningIcon from "@mui/icons-material/WarningAmberOutlined";
import GroupsIcon from "@mui/icons-material/GroupsOutlined";
import AccessTimeIcon from "@mui/icons-material/AccessTimeOutlined";
import RuleIcon from "@mui/icons-material/GavelOutlined";
import ScheduleIcon from "@mui/icons-material/CalendarTodayOutlined";
import SearchIcon from "@mui/icons-material/SearchOutlined";
import SmartToyIcon from "@mui/icons-material/SmartToyOutlined";
import AutoAwesomeIcon from "@mui/icons-material/AutoAwesomeOutlined";

import Markdown from "react-markdown";
import PageHeader from "@/components/ui/PageHeader";
import DashboardCard from "@/components/ui/DashboardCard";
import EmptyState from "@/components/ui/EmptyState";
import LoadingOverlay from "@/components/ui/LoadingOverlay";
import NoticeSnackbar from "@/components/ui/NoticeSnackbar";
import { staggerSx } from "@/lib/useStaggeredAnimation";
import api, { getApiAccessToken } from "@/lib/api-client";
import BookCard, { parseBookCard } from "@/components/BookCard";
import { fadeInUp } from "@/lib/animations";

interface Message {
  id: string;
  role: "user" | "assistant" | "system";
  content: string;
  toolResults?: ToolResult[];
  requiresConfirmation?: boolean;
  pendingAction?: PendingAction;
  timestamp: Date;
}

interface ToolResult {
  name: string;
  result: { success: boolean; data?: any; error?: string };
}

interface PendingAction {
  action: string;
  description: string;
  params: Record<string, any>;
}

const STORAGE_KEY = "ai-assistant-session";

const SUGGESTIONS = [
  { label: "Tìm sách về AI", icon: <SearchIcon sx={{ fontSize: 16 }} />, color: "#6366f1" },
  { label: "Lịch trực hôm nay", icon: <ScheduleIcon sx={{ fontSize: 16 }} />, color: "#3b82f6" },
  { label: "Sách quá hạn", icon: <WarningIcon sx={{ fontSize: 16 }} />, color: "#ef4444" },
  { label: "Giờ mở cửa", icon: <AccessTimeIcon sx={{ fontSize: 16 }} />, color: "#10b981" },
  { label: "Quy định mượn trả", icon: <RuleIcon sx={{ fontSize: 16 }} />, color: "#f59e0b" },
  { label: "Độc giả trong thư viện", icon: <GroupsIcon sx={{ fontSize: 16 }} />, color: "#8b5cf6" },
];

function buildApiUrl(path: string) {
  const base = process.env.NEXT_PUBLIC_API_URL || "";
  return `${base}/api/ai${path}`;
}

function getAuthHeaders(): Record<string, string> {
  const token = getApiAccessToken();
  const headers: Record<string, string> = { "Content-Type": "application/json" };
  if (token) headers["Authorization"] = `Bearer ${token}`;
  return headers;
}

async function chat(message: string, sessionId?: string, patronId?: string) {
  const res = await fetch(buildApiUrl("/chat"), {
    method: "POST",
    headers: getAuthHeaders(),
    body: JSON.stringify({ message, sessionId, patronId }),
  });
  if (!res.ok) throw new Error(`HTTP ${res.status}`);
  return res.json();
}

async function confirmAction(sessionId: string, action: "approve" | "reject") {
  const res = await fetch(buildApiUrl("/confirm"), {
    method: "POST",
    headers: getAuthHeaders(),
    body: JSON.stringify({ sessionId, action }),
  });
  if (!res.ok) throw new Error(`HTTP ${res.status}`);
  return res.json();
}

function MessageContent({ content }: { content: string }) {
  const { before, bookData, after } = parseBookCard(content);
  return (
    <>
      {before ? <Markdown>{before}</Markdown> : null}
      {bookData ? <BookCard data={bookData} /> : null}
      {after ? <Markdown>{after}</Markdown> : null}
    </>
  );
}

export default function AiAssistantPage() {
  const [messages, setMessages] = useState<Message[]>([]);
  const [input, setInput] = useState("");
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState("");
  const [sessionId, setSessionId] = useState<string>("");
  const [confirmDialog, setConfirmDialog] = useState<{ open: boolean; pending?: PendingAction }>({
    open: false,
  });
  const [mounted, setMounted] = useState(false);
  const bottomRef = useRef<HTMLDivElement>(null);
  const inputRef = useRef<HTMLInputElement>(null);

  useEffect(() => {
    setMounted(true);
    const saved = localStorage.getItem(STORAGE_KEY);
    if (saved) {
      try {
        const parsed = JSON.parse(saved);
        if (parsed.sessionId) setSessionId(parsed.sessionId);
        if (Array.isArray(parsed.messages) && parsed.messages.length) {
          setMessages(
            parsed.messages.map((m: any) => ({ ...m, timestamp: new Date(m.timestamp) })),
          );
        }
      } catch {}
    } else {
      setMessages([
        {
          id: "1",
          role: "assistant",
          content:
            "Xin chào! Tôi là Trợ lý AI của Thư viện IUH. Tôi có thể hỗ trợ bạn:\n\n• Tìm kiếm sách và vị trí kệ\n• Trả lời câu hỏi về thư viện (giờ mở cửa, quy định mượn trả, chính sách phạt...)\n• Tra cứu thông tin độc giả và lịch sử mượn\n• Xem lịch trực nhân viên hôm nay\n• Đề xuất sách theo nhu cầu\n\nBạn cần tôi giúp gì?",
          timestamp: new Date(),
        },
      ]);
    }
  }, []);

  useEffect(() => {
    if (mounted) {
      localStorage.setItem(STORAGE_KEY, JSON.stringify({ sessionId, messages }));
    }
  }, [sessionId, messages, mounted]);

  useEffect(() => {
    bottomRef.current?.scrollIntoView({ behavior: "smooth" });
  }, [messages]);

  const sendMessage = async (text?: string) => {
    const textToSend = (text || input).trim();
    if (!textToSend || loading) return;

    const userMsg: Message = {
      id: Date.now().toString(),
      role: "user",
      content: textToSend,
      timestamp: new Date(),
    };
    setMessages((prev) => [...prev, userMsg]);
    setInput("");
    setLoading(true);
    setError("");

    try {
      const data = await chat(textToSend, sessionId || undefined);
      if (data.sessionId && !sessionId) setSessionId(data.sessionId);

      let responseText = data.response || "";
      if (!responseText.trim() && data.toolResults && data.toolResults.length > 0) {
        const toolNames = data.toolResults.map((t: any) => t.name).join(", ");
        responseText = `Đã truy vấn xong (${toolNames}).`;
      }
      if (!responseText.trim()) {
        responseText = "Tôi không có phản hồi.";
      }

      const assistantMsg: Message = {
        id: (Date.now() + 1).toString(),
        role: "assistant",
        content: responseText,
        toolResults: data.toolResults,
        requiresConfirmation: data.requiresConfirmation,
        pendingAction: data.pendingAction,
        timestamp: new Date(),
      };
      setMessages((prev) => [...prev, assistantMsg]);

      if (data.requiresConfirmation && data.pendingAction) {
        setConfirmDialog({ open: true, pending: data.pendingAction });
      }
    } catch {
      setError("Không thể kết nối AI. Vui lòng thử lại.");
      setMessages((prev) => prev.filter((m) => m.id !== userMsg.id));
    } finally {
      setLoading(false);
      inputRef.current?.focus();
    }
  };

  const handleConfirm = async (action: "approve" | "reject") => {
    if (!sessionId) return;
    setConfirmDialog({ open: false });
    setLoading(true);

    const confirmMsg: Message = {
      id: Date.now().toString(),
      role: "assistant",
      content:
        action === "approve"
          ? "Đang xử lý yêu cầu của bạn..."
          : "Đã hủy thao tác theo yêu cầu của bạn.",
      timestamp: new Date(),
    };
    setMessages((prev) => [...prev, confirmMsg]);

    try {
      const result = await confirmAction(sessionId, action);
      const resultMsg: Message = {
        id: (Date.now() + 1).toString(),
        role: "assistant",
        content:
          result.result || result.response || (action === "approve" ? "Thao tác đã được thực hiện thành công." : "Đã hủy."),
        timestamp: new Date(),
      };
      setMessages((prev) => [...prev.slice(0, -1), resultMsg]);
    } catch {
      const errMsg: Message = {
        id: (Date.now() + 1).toString(),
        role: "assistant",
        content: "Thao tác thất bại. Vui lòng thử lại.",
        timestamp: new Date(),
      };
      setMessages((prev) => [...prev.slice(0, -1), errMsg]);
    } finally {
      setLoading(false);
    }
  };

  const clearChat = () => {
    setMessages([
      {
        id: Date.now().toString(),
        role: "assistant",
        content: "Đã xóa cuộc trò chuyện. Tôi có thể giúp gì cho bạn?",
        timestamp: new Date(),
      },
    ]);
    setSessionId("");
    localStorage.removeItem(STORAGE_KEY);
  };

  const handleKeyDown = (e: React.KeyboardEvent) => {
    if (e.key === "Enter" && !e.shiftKey) {
      e.preventDefault();
      sendMessage();
    }
  };

  const toolCount = useMemo(() => {
    const names = new Set<string>();
    messages.forEach((m) => m.toolResults?.forEach((t) => names.add(t.name)));
    return names.size;
  }, [messages]);

  const stats = [
    { key: "msg", label: "Tin nhắn", value: messages.length, gradient: "linear-gradient(135deg, #6366f1 0%, #4338ca 100%)" },
    { key: "tool", label: "Công cụ", value: toolCount, gradient: "linear-gradient(135deg, #3b82f6 0%, #1d4ed8 100%)" },
    { key: "session", label: "Phiên", value: sessionId ? sessionId.slice(0, 6) : "Mới", gradient: "linear-gradient(135deg, #10b981 0%, #059669 100%)" },
    { key: "status", label: "Trạng thái", value: loading ? "Xử lý..." : "Sẵn sàng", gradient: "linear-gradient(135deg, #f59e0b 0%, #d97706 100%)" },
  ];

  const showEmpty = messages.length <= 1 && messages[0]?.role === "assistant";

  const statBadges = stats
    .map((s) => `${s.label}: ${typeof s.value === "number" ? s.value.toLocaleString("vi-VN") : s.value}`)
    .join(" • ");

  return (
    <Stack spacing={3} sx={{ height: "100%", overflow: "hidden" }}>
      <PageHeader
        title="AI Trợ lý"
        icon={SmartToyIcon}
        gradient="linear-gradient(135deg, #1e1b4b 0%, #312e81 50%, #1e1b4b 100%)"
        statBadges={statBadges}
        onRefresh={clearChat}
        actions={
          sessionId ? (
            <Chip
              label={`Phiên: ${sessionId.slice(0, 8)}...`}
              size="small"
              sx={{ color: "#a5b4fc", borderColor: "rgba(165,180,252,0.4)", fontWeight: 600, fontSize: "0.72rem" }}
              variant="outlined"
            />
          ) : null}
      />

      <Box sx={{ flex: 1, display: "flex", flexDirection: "column", overflow: "hidden", m: 0, borderRadius: 0 }}>
        <DashboardCard noPadding>
        <Box sx={{ flex: 1, overflowY: "auto", px: 3, py: 2 }}>
          <Stack spacing={2.5}>
            {showEmpty ? (
              <EmptyState
                icon={
                  <Avatar sx={{ width: 72, height: 72, bgcolor: "rgba(99,102,241,0.15)", border: "2px solid rgba(99,102,241,0.3)" }}>
                    <SmartToyIcon sx={{ fontSize: 36, color: "#6366f1" }} />
                  </Avatar>
                }
                title="Trợ lý AI Thư viện IUH"
                description="Hỏi tôi về sách, lịch trực, quy định thư viện..."
                action={
                  <Box sx={{ display: "flex", flexWrap: "wrap", gap: 1, justifyContent: "center", maxWidth: 600, mx: "auto" }}>
                    {SUGGESTIONS.map((s) => (
                      <Chip
                        key={s.label}
                        icon={s.icon}
                        label={s.label}
                        onClick={() => sendMessage(s.label)}
                        variant="outlined"
                        sx={{
                          fontWeight: 600,
                          fontSize: "0.78rem",
                          borderRadius: "20px!important",
                          borderColor: alpha(s.color, 0.4),
                          color: s.color,
                          "&:hover": { bgcolor: alpha(s.color, 0.08), borderColor: s.color },
                          transition: "all 0.2s",
                        }}
                      />
                    ))}
                  </Box>
                }
              />
            ) : (
              messages.map((msg) => <MessageBubble key={msg.id} msg={msg} />)
            )}

            <LoadingOverlay loading={loading} message="AI đang suy nghĩ..." />

            <div ref={bottomRef} />
          </Stack>
        </Box>

        <Box sx={{ px: 3, py: 2, borderTop: 1, borderColor: "divider", bgcolor: "background.paper" }}>
          <Paper
            variant="outlined"
            sx={{
              p: 1,
              borderRadius: 3,
              borderColor: "divider",
              transition: "border-color 0.2s, box-shadow 0.2s",
              "&:focus-within": { borderColor: "#6366f1", boxShadow: "0 0 0 2px rgba(99,102,241,0.1)" },
            }}
          >
            <Stack direction="row" spacing={1} sx={{ alignItems: "flex-end" }}>
              <TextField
                inputRef={inputRef}
                placeholder="Hỏi tôi về thư viện, sách, lịch trực..."
                value={input}
                onChange={(e) => setInput(e.target.value)}
                onKeyDown={handleKeyDown}
                multiline
                maxRows={4}
                fullWidth
                disabled={loading}
                size="small"
                variant="standard"
                slotProps={{ inputLabel: { shrink: true } }}
                sx={{
                  px: 1,
                  "& .MuiInput-root": { borderBottom: "none" },
                  "& .MuiInput-root:before": { borderBottom: "none" },
                  "& .MuiInput-root:after": { borderBottom: "none" },
                }}
              />
              <IconButton
                onClick={() => sendMessage()}
                disabled={loading || !input.trim()}
                sx={{
                  background: "linear-gradient(135deg, #6366f1 0%, #4338ca 100%)",
                  color: "white",
                  width: 40,
                  height: 40,
                  borderRadius: 2,
                  boxShadow: "0 4px 14px rgba(99,102,241,0.4)",
                  transition: "transform 0.2s, box-shadow 0.2s",
                  "&:hover": {
                    background: "linear-gradient(135deg, #4f46e5 0%, #3730a3 100%)",
                    transform: "scale(1.05)",
                    boxShadow: "0 6px 20px rgba(99,102,241,0.5)",
                  },
                  "&:disabled": {
                    background: "action.disabledBackground",
                    boxShadow: "none",
                    transform: "none",
                  },
                }}
              >
                {loading ? <CircularProgress size={20} color="inherit" /> : <SendIcon sx={{ fontSize: 20 }} />}
              </IconButton>
            </Stack>
          </Paper>
          <Typography variant="caption" color="text.secondary" sx={{ mt: 0.75, display: "block", textAlign: "center", fontSize: "0.7rem" }}>
            AI có thể sai. Luôn kiểm tra thông tin trước khi hành động.
          </Typography>
        </Box>
      </DashboardCard>
      </Box>

      <NoticeSnackbar open={!!error} message={error} severity="error" onClose={() => setError("")} />

      <Dialog open={confirmDialog.open} onClose={() => handleConfirm("reject")} maxWidth="sm" fullWidth>
        <Box sx={{ background: "linear-gradient(135deg, #6366f1 0%, #4338ca 100%)", p: 2.5, color: "white" }}>
          <Stack direction="row" sx={{ alignItems: "center", justifyContent: "space-between" }}>
            <Stack direction="row" spacing={1.5} sx={{ alignItems: "center" }}>
              <Avatar sx={{ bgcolor: "rgba(255,255,255,0.2)", width: 40, height: 40 }}>
                <AutoAwesomeIcon />
              </Avatar>
              <Typography variant="h6" sx={{ fontWeight: 800 }}>
                Xác nhận thao tác
              </Typography>
            </Stack>
            <IconButton onClick={() => handleConfirm("reject")} size="small" sx={{ color: "white", bgcolor: "rgba(255,255,255,0.15)", "&:hover": { bgcolor: "rgba(255,255,255,0.25)" } }}>
              <CancelIcon fontSize="small" />
            </IconButton>
          </Stack>
        </Box>
        <DialogContent sx={{ pt: 3 }}>
          {confirmDialog.pending ? (
            <Stack spacing={2}>
              <Alert severity="warning" sx={{ borderRadius: 2, fontWeight: 600 }}>
                Thao tác này sẽ ảnh hưởng đến dữ liệu. Vui lòng xác nhận.
              </Alert>
              <Paper variant="outlined" sx={{ p: 2, bgcolor: "background.default", borderRadius: 2 }}>
                <Typography variant="caption" color="text.secondary" sx={{ fontWeight: 700, textTransform: "uppercase", letterSpacing: 0.5 }}>
                  Mô tả thao tác
                </Typography>
                <Typography sx={{ mt: 0.5, whiteSpace: "pre-wrap", lineHeight: 1.6 }}>{confirmDialog.pending.description}</Typography>
              </Paper>
              <Box>
                <Typography variant="caption" color="text.secondary" sx={{ fontWeight: 700, textTransform: "uppercase", letterSpacing: 0.5 }}>
                  Hành động
                </Typography>
                <Typography variant="body2" sx={{ fontFamily: "monospace", mt: 0.5, bgcolor: "action.hover", p: 1, borderRadius: 1 }}>
                  {confirmDialog.pending.action}
                </Typography>
              </Box>
            </Stack>
          ) : null}
        </DialogContent>
        <DialogActions sx={{ px: 3, pb: 2.5, gap: 1 }}>
          <Button onClick={() => handleConfirm("reject")} variant="outlined" color="inherit" startIcon={<CancelIcon />} sx={{ borderRadius: 2 }}>
            Hủy bỏ
          </Button>
          <Button
            onClick={() => handleConfirm("approve")}
            variant="contained"
            startIcon={<CheckCircleIcon />}
            sx={{ borderRadius: 2, fontWeight: 700, background: "linear-gradient(135deg, #6366f1 0%, #4338ca 100%)", "&:hover": { background: "linear-gradient(135deg, #4f46e5 0%, #3730a3 100%)" } }}
          >
            Xác nhận
          </Button>
        </DialogActions>
      </Dialog>
    </Stack>
  );
}

function ToolResultCards({ tr }: { tr: ToolResult }) {
  const data = tr.result?.data ?? tr.result;
  const isError = !!tr.result?.error;

  if (isError) {
    return (
      <Paper variant="outlined" sx={{ p: 2, borderRadius: 2, borderColor: "error.main", overflow: "hidden" }}>
        <Box sx={{ display: "flex" }}>
          <Box sx={{ width: 4, bgcolor: "error.main", flexShrink: 0 }} />
          <Box sx={{ flex: 1, pl: 1.5 }}>
            <Stack direction="row" spacing={1.5} sx={{ alignItems: "center" }}>
              <Avatar sx={{ width: 32, height: 32, bgcolor: "error.main", fontSize: 14 }}>✕</Avatar>
              <Box>
                <Chip label={tr.name} size="small" color="error" sx={{ fontWeight: 800, fontSize: 10, height: 20 }} />
                <Typography variant="body2" color="error.main" sx={{ fontSize: 12, fontWeight: 500, mt: 0.25 }}>
                  {tr.result.error}
                </Typography>
              </Box>
            </Stack>
          </Box>
        </Box>
      </Paper>
    );
  }

  if (tr.name === "search_books" && Array.isArray(data)) {
    return (
      <Box>
        <Chip label={`📖 Tìm thấy ${data.length} cuốn sách`} size="small" color="primary" sx={{ fontWeight: 800, fontSize: 11, mb: 1, height: 24 }} />
        <Stack spacing={1}>
          {data.map((book: any, i: number) => (
            <Paper key={i} elevation={0} sx={{ borderRadius: 2, overflow: "hidden", border: "1px solid", borderColor: "divider" }}>
              <Box sx={{ display: "flex" }}>
                <Box sx={{ width: 4, bgcolor: book.is_available ? "#10b981" : "#f59e0b", flexShrink: 0 }} />
                <Box sx={{ flex: 1, p: 1.5 }}>
                  <Stack direction="row" spacing={1.5} sx={{ alignItems: "flex-start" }}>
                    <Avatar sx={{ width: 40, height: 40, background: "linear-gradient(135deg, #6366f1 0%, #4338ca 100%)", fontSize: 18, flexShrink: 0, boxShadow: "0 2px 8px rgba(0,0,0,0.15)" }}>📖</Avatar>
                    <Box sx={{ flex: 1, minWidth: 0 }}>
                      <Typography variant="body2" sx={{ fontWeight: 800, lineHeight: 1.3, fontSize: 13 }}>{book.title}</Typography>
                      <Typography variant="caption" color="text.secondary" sx={{ display: "block", lineHeight: 1.4 }}>{book.author}</Typography>
                      <Stack direction="row" spacing={0.5} sx={{ mt: 0.75, flexWrap: "wrap", gap: 0.5 }}>
                        <Chip label={book.categories || "Sách"} size="small" variant="outlined" sx={{ fontSize: 10, height: 20, fontWeight: 600, borderRadius: 1.5 }} />
                        <Chip label={book.isbn} size="small" variant="outlined" sx={{ fontSize: 10, height: 20, fontFamily: "monospace", borderRadius: 1.5 }} />
                        <Chip label={book.is_available ? "Có sẵn" : "Đang mượn"} size="small" color={book.is_available ? "success" : "warning"} sx={{ fontSize: 10, height: 20, fontWeight: 700, borderRadius: 1.5 }} />
                      </Stack>
                      {book.shelf_location ? (
                        <Chip label={`📍 ${book.shelf_location}`} size="small" color="primary" variant="outlined" sx={{ mt: 0.5, fontSize: 10, height: 20, fontWeight: 700, fontFamily: "monospace", borderRadius: 1.5 }} />
                      ) : null}
                    </Box>
                  </Stack>
                </Box>
              </Box>
            </Paper>
          ))}
        </Stack>
      </Box>
    );
  }

  if (tr.name === "get_overdue_borrows" && Array.isArray(data)) {
    if (data.length === 0) {
      return (
        <Paper elevation={0} sx={{ p: 2, borderRadius: 2, border: "1px solid", borderColor: "#10b981", bgcolor: alpha("#10b981", 0.04) }}>
          <Stack direction="row" spacing={1.5} sx={{ alignItems: "center" }}>
            <Avatar sx={{ width: 36, height: 36, background: "linear-gradient(135deg, #10b981 0%, #059669 100%)", fontSize: 18 }}>✓</Avatar>
            <Box>
              <Typography variant="body2" sx={{ fontWeight: 800, color: "#10b981" }}>Không có sách quá hạn</Typography>
              <Typography variant="caption" color="text.secondary">Tất cả sách đều trong hạn trả</Typography>
            </Box>
          </Stack>
        </Paper>
      );
    }
    return (
      <Box>
        <Chip label={`⚠️ ${data.length} sách quá hạn`} size="small" color="error" sx={{ fontWeight: 800, fontSize: 11, mb: 1, height: 24 }} />
        <Stack spacing={1}>
          {data.map((item: any, i: number) => (
            <Paper key={i} elevation={0} sx={{ borderRadius: 2, overflow: "hidden", border: "1px solid", borderColor: "error.main" }}>
              <Box sx={{ display: "flex" }}>
                <Box sx={{ width: 4, bgcolor: "#ef4444", flexShrink: 0 }} />
                <Box sx={{ flex: 1, p: 1.5, bgcolor: alpha("#ef4444", 0.04) }}>
                  <Stack direction="row" spacing={1.5} sx={{ alignItems: "flex-start" }}>
                    <Avatar sx={{ width: 36, height: 36, background: "linear-gradient(135deg, #ef4444 0%, #dc2626 100%)", fontSize: 16, flexShrink: 0 }}>⚠️</Avatar>
                    <Box sx={{ flex: 1 }}>
                      <Typography variant="body2" sx={{ fontWeight: 800, fontSize: 13 }}>{item.book?.title || "N/A"}</Typography>
                      <Typography variant="caption" color="text.secondary">Độc giả: {item.patron_id?.slice(0, 8)}...</Typography>
                      <Chip
                        label={`⏰ Quá hạn: ${item.due_at ? new Date(item.due_at).toLocaleDateString("vi-VN") : "N/A"}`}
                        size="small"
                        color="error"
                        sx={{ mt: 0.5, fontSize: 10, height: 20, fontWeight: 700, borderRadius: 1.5 }}
                      />
                    </Box>
                  </Stack>
                </Box>
              </Box>
            </Paper>
          ))}
        </Stack>
      </Box>
    );
  }

  if (tr.name === "get_patron_borrows" && Array.isArray(data)) {
    if (data.length === 0) {
      return (
        <Paper elevation={0} sx={{ p: 2, borderRadius: 2, border: "1px solid", borderColor: "#10b981", bgcolor: alpha("#10b981", 0.04) }}>
          <Stack direction="row" spacing={1.5} sx={{ alignItems: "center" }}>
            <Avatar sx={{ width: 36, height: 36, background: "linear-gradient(135deg, #10b981 0%, #059669 100%)", fontSize: 18 }}>✓</Avatar>
            <Box>
              <Typography variant="body2" sx={{ fontWeight: 800, color: "#10b981" }}>Không sách đang mượn</Typography>
              <Typography variant="caption" color="text.secondary">Độc giả chưa mượn cuốn nào</Typography>
            </Box>
          </Stack>
        </Paper>
      );
    }
    return (
      <Box>
        <Chip label={`📚 ${data.length} sách đang mượn`} size="small" color="info" sx={{ fontWeight: 800, fontSize: 11, mb: 1, height: 24 }} />
        <Stack spacing={1}>
          {data.map((item: any, i: number) => (
            <Paper key={i} elevation={0} sx={{ borderRadius: 2, overflow: "hidden", border: "1px solid", borderColor: "divider" }}>
              <Box sx={{ display: "flex" }}>
                <Box sx={{ width: 4, bgcolor: "#3b82f6", flexShrink: 0 }} />
                <Box sx={{ flex: 1, p: 1.5 }}>
                  <Stack direction="row" spacing={1.5} sx={{ alignItems: "flex-start" }}>
                    <Avatar sx={{ width: 36, height: 36, background: "linear-gradient(135deg, #3b82f6 0%, #1d4ed8 100%)", fontSize: 16, flexShrink: 0 }}>📚</Avatar>
                    <Box sx={{ flex: 1 }}>
                      <Typography variant="body2" sx={{ fontWeight: 800, fontSize: 13 }}>{item.book?.title || "N/A"}</Typography>
                      <Typography variant="caption" color="text.secondary">{item.book?.author}</Typography>
                      <Stack direction="row" spacing={0.5} sx={{ mt: 0.5, flexWrap: "wrap", gap: 0.5 }}>
                        <Chip label={item.status === "borrowed" ? "Đang mượn" : "Đã trả"} size="small" color={item.status === "borrowed" ? "warning" : "success"} sx={{ fontSize: 10, height: 20, fontWeight: 700, borderRadius: 1.5 }} />
                        {item.due_at ? (
                          <Chip label={`Hạn: ${new Date(item.due_at).toLocaleDateString("vi-VN")}`} size="small" variant="outlined" sx={{ fontSize: 10, height: 20, borderRadius: 1.5 }} />
                        ) : null}
                      </Stack>
                    </Box>
                  </Stack>
                </Box>
              </Box>
            </Paper>
          ))}
        </Stack>
      </Box>
    );
  }

  if (tr.name === "get_shelf_location" && typeof data === "object" && data !== null && !Array.isArray(data)) {
    return (
      <Box>
        <Chip label="📍 Vị trí sách trên kệ" size="small" color="primary" sx={{ fontWeight: 800, fontSize: 11, mb: 1, height: 24 }} />
        <Stack spacing={1}>
          {Object.entries(data).map(([shelf, books]: [string, any], i: number) => (
            <Paper key={i} elevation={0} sx={{ borderRadius: 2, overflow: "hidden", border: "1px solid", borderColor: "divider" }}>
              <Box sx={{ display: "flex" }}>
                <Box sx={{ width: 4, bgcolor: "#6366f1", flexShrink: 0 }} />
                <Box sx={{ flex: 1, p: 1.5 }}>
                  <Typography variant="body2" sx={{ fontWeight: 800, mb: 0.75, fontSize: 13 }}>📍 {shelf}</Typography>
                  <Stack spacing={0.5}>
                    {Array.isArray(books) ? books.map((book: any, j: number) => (
                      <Paper key={j} variant="outlined" sx={{ p: 1, borderRadius: 1 }}>
                        <Typography variant="body2" sx={{ fontWeight: 700, fontSize: 12 }}>{book.title}</Typography>
                        <Typography variant="caption" color="text.secondary">{book.author}</Typography>
                      </Paper>
                    )) : null}
                  </Stack>
                </Box>
              </Box>
            </Paper>
          ))}
        </Stack>
      </Box>
    );
  }

  if (tr.name === "get_schedule_today") {
    const scheduleItems = data?.items || (Array.isArray(data) ? data : []);
    if (scheduleItems.length === 0) {
      return (
        <Paper elevation={0} sx={{ p: 2, borderRadius: 2, border: "1px solid", borderColor: "#10b981", bgcolor: alpha("#10b981", 0.04) }}>
          <Stack direction="row" spacing={1.5} sx={{ alignItems: "center" }}>
            <Avatar sx={{ width: 36, height: 36, background: "linear-gradient(135deg, #10b981 0%, #059669 100%)", fontSize: 18 }}>✓</Avatar>
            <Box>
              <Typography variant="body2" sx={{ fontWeight: 800, color: "#10b981" }}>Hôm nay không có lịch trực</Typography>
              <Typography variant="caption" color="text.secondary">Chưa có nhân viên nào được xếp ca</Typography>
            </Box>
          </Stack>
        </Paper>
      );
    }

    const groupedByShift: Record<string, any[]> = {};
    scheduleItems.forEach((item: any) => {
      const shiftName = item.shift?.name || "Ca khác";
      if (!groupedByShift[shiftName]) groupedByShift[shiftName] = [];
      groupedByShift[shiftName].push(item);
    });

    const shiftMeta: Record<string, { icon: string; gradient: string }> = {
      "Ca sáng": { icon: "🌅", gradient: "linear-gradient(135deg, #f59e0b 0%, #d97706 100%)" },
      "Ca chiều": { icon: "🌤️", gradient: "linear-gradient(135deg, #3b82f6 0%, #1d4ed8 100%)" },
      "Ca tối": { icon: "🌙", gradient: "linear-gradient(135deg, #8b5cf6 0%, #6d28d9 100%)" },
      "Sáng": { icon: "🌅", gradient: "linear-gradient(135deg, #f59e0b 0%, #d97706 100%)" },
      "Chiều": { icon: "🌤️", gradient: "linear-gradient(135deg, #3b82f6 0%, #1d4ed8 100%)" },
      "Tối": { icon: "🌙", gradient: "linear-gradient(135deg, #8b5cf6 0%, #6d28d9 100%)" },
    };

    return (
      <Box>
        <Chip label={`📅 Lịch trực hôm nay: ${scheduleItems.length} ca`} size="small" color="primary" sx={{ fontWeight: 800, fontSize: 11, mb: 1, height: 24 }} />
        <Stack spacing={1.5}>
          {Object.entries(groupedByShift).map(([shiftName, items], i) => {
            const meta = shiftMeta[shiftName] || { icon: "📋", gradient: "linear-gradient(135deg, #6b7280 0%, #4b5563 100%)" };
            const shiftTime = items[0]?.shift ? `${items[0].shift.startTime?.slice(0, 5)} - ${items[0].shift.endTime?.slice(0, 5)}` : "";
            return (
              <Paper key={i} elevation={0} sx={{ borderRadius: 2, overflow: "hidden", border: "1px solid", borderColor: "divider" }}>
                <Box sx={{ display: "flex" }}>
                  <Box sx={{ width: 4, background: meta.gradient, flexShrink: 0 }} />
                  <Box sx={{ flex: 1, p: 1.5 }}>
                    <Stack direction="row" spacing={1} sx={{ alignItems: "center", mb: 1 }}>
                      <Avatar sx={{ width: 30, height: 30, background: meta.gradient, fontSize: 14 }}>{meta.icon}</Avatar>
                      <Box>
                        <Typography variant="body2" sx={{ fontWeight: 800, fontSize: 13 }}>{shiftName}</Typography>
                        {shiftTime ? <Typography variant="caption" color="text.secondary">{shiftTime}</Typography> : null}
                      </Box>
                    </Stack>
                    <Stack spacing={0.75}>
                      {items.map((item: any, j: number) => {
                        const staffName = item.staff?.fullName || item.staff?.email || item.staffId?.slice(0, 8) || "N/A";
                        const zoneName = item.zone?.zoneName || (item.zone?.floor ? `Tầng ${item.zone.floor}` : "");
                        const isCheckedIn = item.staff?.currentStatus === "inside" || !!item.attendance?.checkInAt;
                        return (
                          <Paper key={j} variant="outlined" sx={{ p: 1, borderRadius: 1.5, display: "flex", alignItems: "center", gap: 1, transition: "background 0.15s", "&:hover": { bgcolor: (t) => alpha(t.palette.primary.main, 0.04) } }}>
                            <Avatar sx={{ width: 26, height: 26, background: isCheckedIn ? "linear-gradient(135deg, #10b981 0%, #059669 100%)" : "grey.300", fontSize: 11 }}>{isCheckedIn ? "✓" : "👤"}</Avatar>
                            <Box sx={{ flex: 1, minWidth: 0 }}>
                              <Typography variant="caption" sx={{ fontWeight: 700, display: "block", lineHeight: 1.3 }}>{staffName}</Typography>
                              {zoneName ? (
                                <Typography variant="caption" color="text.secondary" sx={{ fontSize: 10 }}>📍 {zoneName}</Typography>
                              ) : null}
                            </Box>
                            <Chip
                              label={isCheckedIn ? "Đang trực" : item.status === "scheduled" ? "Đã xếp" : item.status}
                              size="small"
                              color={isCheckedIn ? "success" : "default"}
                              sx={{ fontSize: 9, height: 18, fontWeight: 600, borderRadius: 1.5 }}
                            />
                          </Paper>
                        );
                      })}
                    </Stack>
                  </Box>
                </Box>
              </Paper>
            );
          })}
        </Stack>
      </Box>
    );
  }

  return (
    <Paper variant="outlined" sx={{ p: 1.5, borderRadius: 2, border: "1px solid", borderColor: "divider" }}>
      <Chip label={tr.name} size="small" color="primary" variant="outlined" sx={{ fontWeight: 800, fontSize: 10, mb: 0.75, height: 20, borderRadius: 1.5 }} />
      <Typography variant="body2" color="text.secondary" sx={{ fontFamily: "monospace", fontSize: 11, whiteSpace: "pre-wrap", maxHeight: 120, overflow: "auto" }}>
        {typeof data === "string" ? data : JSON.stringify(data, null, 2)}
      </Typography>
    </Paper>
  );
}

function MessageBubble({ msg }: { msg: Message }) {
  const isUser = msg.role === "user";

  return (
    <Box sx={{ display: "flex", justifyContent: isUser ? "flex-end" : "flex-start", animation: `${fadeInUp} 0.3s ease-out` }}>
      <Box sx={{ display: "flex", gap: 1.5, maxWidth: "80%", flexDirection: isUser ? "row-reverse" : "row" }}>
        <Avatar
          sx={{
            width: 36,
            height: 36,
            background: isUser ? "linear-gradient(135deg, #8b5cf6 0%, #6d28d9 100%)" : "linear-gradient(135deg, #6366f1 0%, #4338ca 100%)",
            fontSize: 14,
            mt: 0.5,
            boxShadow: "0 2px 8px rgba(0,0,0,0.15)",
          }}
        >
          {isUser ? "👤" : <AssistantIcon sx={{ fontSize: 18 }} />}
        </Avatar>
        <Box sx={{ display: "flex", flexDirection: "column", gap: 0.5 }}>
          <Paper
            elevation={0}
            sx={{
              px: 2,
              py: 1.5,
              background: isUser ? "linear-gradient(135deg, #6366f1 0%, #4338ca 100%)" : "background.paper",
              color: isUser ? "white" : "text.primary",
              border: isUser ? "none" : "1px solid",
              borderColor: isUser ? "transparent" : "divider",
              borderRadius: isUser ? "16px 16px 4px 16px" : "16px 16px 16px 4px",
              maxWidth: "100%",
              overflow: "hidden",
              boxShadow: isUser ? "0 2px 12px rgba(99,102,241,0.3)" : "none",
              "& h1, & h2, & h3, & h4": { fontWeight: 800, mt: 1.5, mb: 0.75, lineHeight: 1.3 },
              "& h1": { fontSize: "1.25rem" },
              "& h2": { fontSize: "1.15rem" },
              "& h3": { fontSize: "1.05rem" },
              "& p": { mt: 0.5, mb: 0.5, lineHeight: 1.7 },
              "& ul, & ol": { pl: 2.5, mt: 0.5, mb: 0.5 },
              "& li": { mb: 0.25, lineHeight: 1.6 },
              "& strong": { fontWeight: 800 },
              "& em": { fontStyle: "italic" },
              "& code": { fontFamily: "monospace", bgcolor: isUser ? "rgba(255,255,255,0.15)" : "action.hover", px: 0.5, py: 0.25, borderRadius: 0.5, fontSize: "0.875em" },
              "& pre": { bgcolor: isUser ? "rgba(255,255,255,0.1)" : "action.hover", p: 1.5, borderRadius: 1, overflow: "auto", mt: 1, mb: 1 },
              "& pre code": { bgcolor: "transparent", p: 0 },
              "& table": { width: "100%", borderCollapse: "collapse", mt: 1, mb: 1, fontSize: "0.875rem" },
              "& th": { bgcolor: isUser ? "rgba(255,255,255,0.1)" : "action.hover", fontWeight: 800, textAlign: "left", px: 1.5, py: 1, border: "1px solid", borderColor: isUser ? "rgba(255,255,255,0.2)" : "divider" },
              "& td": { px: 1.5, py: 0.75, border: "1px solid", borderColor: isUser ? "rgba(255,255,255,0.2)" : "divider" },
              "& blockquote": { borderLeft: "3px solid", borderColor: isUser ? "rgba(255,255,255,0.5)" : "primary.main", pl: 1.5, ml: 0, mt: 1, mb: 1, color: isUser ? "rgba(255,255,255,0.8)" : "text.secondary" },
              "& hr": { border: "none", borderTop: `1px solid ${isUser ? "rgba(255,255,255,0.2)" : "divider"}`, my: 1.5 },
              "& a": { color: isUser ? "white" : "primary.main", textDecoration: "none", "&:hover": { textDecoration: "underline" } },
            }}
          >
            {isUser ? (
              <Typography sx={{ whiteSpace: "pre-wrap", lineHeight: 1.6 }}>{msg.content}</Typography>
            ) : (
              <MessageContent content={msg.content} />
            )}
          </Paper>

          {msg.toolResults && msg.toolResults.length > 0 ? (
            <Stack spacing={0.75} sx={{ maxWidth: "100%" }}>
              {msg.toolResults.map((tr, i) => (
                <ToolResultCards key={i} tr={tr} />
              ))}
            </Stack>
          ) : null}

          <Typography variant="caption" color="text.secondary" sx={{ px: 0.5, fontSize: 10 }}>
            {msg.timestamp.toLocaleTimeString("vi-VN", { hour: "2-digit", minute: "2-digit" })}
          </Typography>
        </Box>
      </Box>
    </Box>
  );
}
</file>

<file path="src/app/(dashboard)/dashboard/admin/[id]/page.tsx">
"use client";

import { useEffect, useState } from "react";
import { useParams, useRouter } from "next/navigation";
import {
  Alert,
  Avatar,
  Box,
  Button,
  Chip,
  CircularProgress,
  Dialog,
  DialogActions,
  DialogContent,
  DialogTitle,
  Divider,
  Grid,
  MenuItem,
  Stack,
  TextField,
  Typography,
} from "@mui/material";
import EditIcon from "@mui/icons-material/EditOutlined";
import MailIcon from "@mui/icons-material/MailOutlined";
import FaceIcon from "@mui/icons-material/FaceRetouchingNaturalOutlined";
import ShieldIcon from "@mui/icons-material/ShieldOutlined";
import FingerprintIcon from "@mui/icons-material/FingerprintOutlined";
import BadgeIcon from "@mui/icons-material/BadgeOutlined";
import ErrorIcon from "@mui/icons-material/ErrorOutlineOutlined";
import AdminPanelSettingsOutlinedIcon from "@mui/icons-material/AdminPanelSettingsOutlined";
import PageHeader from "@/components/ui/PageHeader";
import DashboardCard from "@/components/ui/DashboardCard";
import api from "@/lib/api-client";
import { useAuth } from "@/lib/auth-context";
import { initials, roleLabel, statusLabel, statusColor } from "@/lib/utils";
import type { UserPublic } from "@/lib/types";

const ROLE_OPTIONS = [
  { value: "patron", label: "Độc giả (Patron)" },
  { value: "staff", label: "Nhân viên (Staff)" },
  { value: "admin", label: "Quản trị (Admin)" },
];

const STATUS_OPTIONS = [
  { value: "active", label: "Hoạt động" },
  { value: "suspended", label: "Tạm khóa" },
  { value: "inactive", label: "Không hoạt động" },
];

export default function UserDetailPage() {
  const { id } = useParams() as { id: string };
  const router = useRouter();
  const { isAuthenticated, isLoading: authLoading } = useAuth();

  const [user, setUser] = useState<UserPublic | null>(null);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState("");
  const [saving, setSaving] = useState(false);

  const [editOpen, setEditOpen] = useState(false);
  const [editForm, setEditForm] = useState({
    full_name: "",
    phone: "",
    student_code: "",
    class_name: "",
    course: "",
    identity_number: "",
    permanent_address: "",
    card_number: "",
    issue_date: "",
    membership_expiry: "",
    role: "",
    status: "active",
  });
  const [editError, setEditError] = useState("");

  useEffect(() => {
    if (!authLoading && !isAuthenticated) router.push("/login");
  }, [authLoading, isAuthenticated, router]);

  useEffect(() => {
    if (!id) return;
    (async () => {
      try {
        setLoading(true);
        try {
          const userData = await api.getUser(id);
          setUser(userData);
        } catch {
          const list = await api.listUsers();
          const found = list.users.find((u) => u.id === id);
          if (found) {
            setUser(found);
          } else {
            setError("Không tìm thấy hồ sơ người dùng.");
          }
        }
      } catch {
        setError("Lỗi khi tải dữ liệu người dùng.");
      } finally {
        setLoading(false);
      }
    })();
  }, [id]);

  const openEdit = () => {
    if (!user) return;
    setEditForm({
      full_name: user.full_name || "",
      phone: user.phone || "",
      student_code: user.student_code || "",
      class_name: user.class_name || "",
      course: user.course || "",
      identity_number: user.identity_number || "",
      permanent_address: user.permanentAddress || "",
      card_number: user.card_number || "",
      issue_date: user.issue_date || "",
      membership_expiry: user.membership_expiry || "",
      role: user.role,
      status: user.status || "active",
    });
    setEditError("");
    setEditOpen(true);
  };

  const handleSave = async () => {
    setEditError("");
    setSaving(true);
    try {
      const data: Record<string, string> = {};
      if (editForm.full_name) data.full_name = editForm.full_name;
      if (editForm.phone) data.phone = editForm.phone;
      if (editForm.student_code) data.student_code = editForm.student_code;
      if (editForm.class_name) data.class_name = editForm.class_name;
      if (editForm.course) data.course = editForm.course;
      if (editForm.identity_number) data.identity_number = editForm.identity_number;
      if (editForm.permanent_address) data.permanent_address = editForm.permanent_address;
      if (editForm.card_number) data.card_number = editForm.card_number;
      if (editForm.issue_date) data.issue_date = editForm.issue_date;
      if (editForm.membership_expiry) data.membership_expiry = editForm.membership_expiry;
      data.role = editForm.role;
      data.status = editForm.status;

      const updated = await api.updateUser(id, data);
      setUser(updated);
      setEditOpen(false);
    } catch (err: any) {
      const status = err?.response?.status;
      const msg = err?.response?.data?.error || err?.message || "Lưu thất bại";
      setEditError(
        status === 409
          ? `${msg} — Số thẻ hoặc mã sinh viên đã tồn tại.`
          : msg
      );
    } finally {
      setSaving(false);
    }
  };

  if (authLoading || loading) {
    return (
      <Box sx={{ display: "flex", justifyContent: "center", alignItems: "center", minHeight: 384 }}>
        <CircularProgress />
      </Box>
    );
  }

  if (error && !user) {
    return (
      <Stack spacing={2} sx={{ p: 3 }}>
        <PageHeader
          title="Chi tiết người dùng"
          backHref="/dashboard/admin"
        />
        <Alert severity="error" sx={{ borderRadius: 2 }}>
          {error}
        </Alert>
      </Stack>
    );
  }

  if (!user) return null;

  const userInitials = initials(user.full_name || user.email);
  const avatarBg = user.status === "suspended" ? "warning.main" : user.role === "admin" ? "primary.main" : "secondary.main";
  const dateFmt = (v: string | null | undefined) => (v ? new Date(v).toLocaleDateString("vi-VN") : "—");
  const dtFmt = (v: string | null | undefined) => (v ? new Date(v).toLocaleString("vi-VN") : "—");

  return (
    <Stack spacing={3}>
      <PageHeader
        title={user.full_name || "Chưa cập nhật"}
        subtitle={`Email: ${user.email}`}
        backHref="/dashboard/admin"
        icon={AdminPanelSettingsOutlinedIcon}
        actions={
          <Button
            variant="outlined"
            startIcon={<EditIcon />}
            onClick={openEdit}
            sx={{ textTransform: "none", borderRadius: 2 }}
          >
            Sửa thông tin
          </Button>
        }
      />

      {error ? (
        <Alert severity="error" icon={<ErrorIcon />} sx={{ borderRadius: 2 }}>
          {error}
        </Alert>
      ) : null}

      <Grid container spacing={3}>
        <Grid size={{ xs: 12, lg: 4 }}>
          <Stack spacing={3}>
            <DashboardCard>
              <Box sx={{ textAlign: "center" }}>
                <Avatar
                  sx={{
                    width: 88,
                    height: 88,
                    bgcolor: avatarBg,
                    color: "primary.contrastText",
                    fontSize: 32,
                    fontWeight: 900,
                    mx: "auto",
                    mb: 1.5,
                  }}
                  src={user.avatar_url || undefined}
                >
                  {userInitials}
                </Avatar>
                <Typography variant="h5" sx={{ fontWeight: 700, wordBreak: "break-word" }}>
                  {user.full_name || "Chưa cập nhật"}
                </Typography>
                <Typography
                  variant="body2"
                  color="text.secondary"
                  sx={{ mt: 0.5, fontFamily: "monospace", fontSize: "0.8rem" }}
                >
                  {user.email}
                </Typography>
                <Stack direction="row" spacing={1} sx={{ justifyContent: "center", flexWrap: "wrap", mt: 1.5 }}>
                  <Chip
                    label={roleLabel(user.role)}
                    color={user.role === "admin" ? "warning" : user.role === "staff" ? "primary" : "default"}
                    size="small"
                    variant="outlined"
                  />
                  <Chip
                    label={statusLabel(user.status || "active")}
                    color={statusColor(user.status || "active")}
                    size="small"
                  />
                </Stack>
                {user.has_face ? (
                  <Chip
                    icon={<FaceIcon sx={{ fontSize: 16 }} />}
                    label="Face ID đã đăng ký"
                    color="success"
                    size="small"
                    variant="outlined"
                    sx={{ mt: 1.5 }}
                  />
                ) : null}
                {user.suspended_reason ? (
                  <Alert severity="warning" sx={{ mt: 2, textAlign: "left", borderRadius: 1.5 }}>
                    <Typography variant="caption" sx={{ fontWeight: 600 }}>
                      Lý do khóa: {user.suspended_reason}
                    </Typography>
                  </Alert>
                ) : null}
              </Box>
            </DashboardCard>

            <DashboardCard title="Định danh hệ thống">
              <Typography variant="body2" sx={{ fontFamily: "monospace", wordBreak: "break-all" }}>
                {user.id}
              </Typography>
            </DashboardCard>

            <DashboardCard>
              <Stack direction="row" spacing={1.5} sx={{ alignItems: "center" }}>
                <MailIcon fontSize="small" color="action" />
                <Box>
                  <Typography variant="caption" color="text.secondary">
                    Giới hạn tài khoản
                  </Typography>
                  <Typography variant="body2" sx={{ fontWeight: 700 }}>
                    {user.current_status || "—"}
                  </Typography>
                </Box>
              </Stack>
            </DashboardCard>
          </Stack>
        </Grid>

        <Grid size={{ xs: 12, lg: 8 }}>
          <Stack spacing={3}>
            <DashboardCard
              title="Thông tin liên hệ"
              actions={<BadgeIcon fontSize="small" color="primary" />}
            >
              <Grid container spacing={2}>
                {[
                  ["Số điện thoại", user.phone || "Chưa cập nhật"],
                  ["Địa chỉ thường trú", user.permanent_address || "Chưa cập nhật"],
                  ["Số CCCD/CMND", user.identity_number || "Chưa cập nhật"],
                  ["Lớp", user.class_name || "Chưa cập nhật"],
                ].map(([label, value]) => (
                  <Grid key={label} size={{ xs: 12, sm: 6 }}>
                    <Typography variant="caption" color="text.secondary" sx={{ fontWeight: 600 }}>
                      {label}
                    </Typography>
                    <Typography sx={{ mt: 0.25, fontWeight: 500, wordBreak: "break-word" }}>{value}</Typography>
                  </Grid>
                ))}
              </Grid>
            </DashboardCard>

            <DashboardCard
              title="Thư viện"
              actions={<ShieldIcon fontSize="small" color="action" />}
            >
              <Grid container spacing={2}>
                {[
                  ["Mã sinh viên", user.student_code || "Chưa cập nhật"],
                  ["Số thẻ thư viện", user.card_number || "Chưa cập nhật"],
                  ["Ngày cấp thẻ", dateFmt(user.issue_date)],
                  ["Hạn membership", dateFmt(user.membership_expiry)],
                ].map(([label, value]) => (
                  <Grid key={label} size={{ xs: 12, sm: 6 }}>
                    <Typography variant="caption" color="text.secondary" sx={{ fontWeight: 600 }}>
                      {label}
                    </Typography>
                    <Typography sx={{ mt: 0.25, fontWeight: 500 }}>{value}</Typography>
                  </Grid>
                ))}
              </Grid>
            </DashboardCard>

            <DashboardCard
              title="Hệ thống"
              actions={<FingerprintIcon fontSize="small" color="action" />}
            >
              <Grid container spacing={2}>
                {[
                  ["Ngày tạo", dtFmt(user.created_at)],
                  ["Lần vào gần nhất", dtFmt(user.last_entry_at)],
                  ["Cổng ghi nhận", user.last_entry_camera || "—"],
                  ["Vai trò", roleLabel(user.role)],
                ].map(([label, value]) => (
                  <Grid key={label} size={{ xs: 12, sm: 6 }}>
                    <Typography variant="caption" color="text.secondary" sx={{ fontWeight: 600 }}>
                      {label}
                    </Typography>
                    <Typography sx={{ mt: 0.25, fontWeight: 500 }}>{value}</Typography>
                  </Grid>
                ))}
              </Grid>
            </DashboardCard>
          </Stack>
        </Grid>
      </Grid>

      <Dialog open={editOpen} onClose={() => !saving && setEditOpen(false)} maxWidth="sm" fullWidth>
        <DialogTitle sx={{ fontWeight: 700 }}>Sửa thông tin người dùng</DialogTitle>
        <DialogContent dividers>
          <Stack spacing={2.5} sx={{ mt: 0.5 }}>
            {editError ? <Alert severity="error">{editError}</Alert> : null}

            <TextField
              label="Họ và tên"
              value={editForm.full_name}
              onChange={(e) => setEditForm({ ...editForm, full_name: e.target.value })}
              size="small"
              fullWidth
            />
            <Typography variant="caption" color="text.secondary">
              Email không thể chỉnh sửa từ đây (yêu cầu luồng OTP).
            </Typography>

            <TextField
              label="Số điện thoại"
              value={editForm.phone}
              onChange={(e) => setEditForm({ ...editForm, phone: e.target.value })}
              size="small"
              fullWidth
            />
            <TextField
              label="Mã sinh viên"
              value={editForm.student_code}
              onChange={(e) => setEditForm({ ...editForm, student_code: e.target.value })}
              size="small"
              fullWidth
              helperText="Phải là duy nhất nếu điền"
            />
            <TextField
              label="Lớp"
              value={editForm.class_name}
              onChange={(e) => setEditForm({ ...editForm, class_name: e.target.value })}
              size="small"
              fullWidth
            />
            <TextField
              label="Khóa học"
              value={editForm.course}
              onChange={(e) => setEditForm({ ...editForm, course: e.target.value })}
              size="small"
              fullWidth
            />
            <TextField
              label="Số CCCD/CMND"
              value={editForm.identity_number}
              onChange={(e) => setEditForm({ ...editForm, identity_number: e.target.value })}
              size="small"
              fullWidth
            />
            <TextField
              label="Địa chỉ thường trú"
              value={editForm.permanent_address}
              onChange={(e) => setEditForm({ ...editForm, permanent_address: e.target.value })}
              size="small"
              fullWidth
            />
            <TextField
              label="Số thẻ thư viện"
              value={editForm.card_number}
              onChange={(e) => setEditForm({ ...editForm, card_number: e.target.value })}
              size="small"
              fullWidth
              helperText="Phải là duy nhất nếu điền"
            />
            <TextField
              label="Ngày cấp thẻ"
              type="date"
              value={editForm.issue_date}
              onChange={(e) => setEditForm({ ...editForm, issue_date: e.target.value })}
              size="small"
              fullWidth
              slotProps={{ inputLabel: { shrink: true } }}
            />
            <TextField
              label="Hạn membership"
              type="date"
              value={editForm.membership_expiry}
              onChange={(e) => setEditForm({ ...editForm, membership_expiry: e.target.value })}
              size="small"
              fullWidth
              slotProps={{ inputLabel: { shrink: true } }}
              helperText={editForm.membership_expiry && new Date(editForm.membership_expiry) < new Date() ? "Đã hết hạn" : ""}
            />

            <TextField
              select
              label="Vai trò"
              value={editForm.role}
              onChange={(e) => setEditForm({ ...editForm, role: e.target.value })}
              size="small"
              fullWidth
            >
              {ROLE_OPTIONS.map((o) => (
                <MenuItem key={o.value} value={o.value}>
                  {o.label}
                </MenuItem>
              ))}
            </TextField>

            <TextField
              select
              label="Trạng thái"
              value={editForm.status}
              onChange={(e) => setEditForm({ ...editForm, status: e.target.value })}
              size="small"
              fullWidth
            >
              {STATUS_OPTIONS.map((o) => (
                <MenuItem key={o.value} value={o.value}>
                  {o.label}
                </MenuItem>
              ))}
            </TextField>
          </Stack>
        </DialogContent>
        <DialogActions sx={{ px: 3, py: 2 }}>
          <Button onClick={() => setEditOpen(false)} disabled={saving} sx={{ textTransform: "none" }}>
            Hủy
          </Button>
          <Button onClick={handleSave} variant="contained" disabled={saving} sx={{ textTransform: "none", borderRadius: 2 }}>
            {saving ? "Đang lưu..." : "Lưu thay đổi"}
          </Button>
        </DialogActions>
      </Dialog>
    </Stack>
  );
}
</file>

<file path="src/app/(dashboard)/dashboard/page.tsx">
"use client";

import { useEffect, useState } from "react";
import Link from "next/link";
import { useRouter } from "next/navigation";
import {
  Alert,
  Avatar,
  Box,
  Button,
  Chip,
  Stack,
  Table,
  TableBody,
  TableCell,
  TableContainer,
  TableHead,
  TableRow,
  Typography,
} from "@mui/material";
import ArrowForwardIcon from "@mui/icons-material/ArrowForward";
import LoginIcon from "@mui/icons-material/LoginOutlined";
import LogoutIcon from "@mui/icons-material/LogoutOutlined";
import UserCheckIcon from "@mui/icons-material/HowToRegOutlined";
import UsersIcon from "@mui/icons-material/GroupsOutlined";
import HistoryIcon from "@mui/icons-material/HistoryOutlined";
import { useAuth } from "@/lib/auth-context";
import { slideInRight, successPop } from "@/lib/animations";
import MuiStatCard from "@/components/ui/MuiStatCard";
import DashboardCard from "@/components/ui/DashboardCard";
import EmptyState from "@/components/ui/EmptyState";
import LoadingOverlay from "@/components/ui/LoadingOverlay";
import GreetingBar from "@/components/dashboard/GreetingBar";
import HourlyActivityChart from "@/components/dashboard/HourlyActivityChart";
import CameraStatusGrid from "@/components/dashboard/CameraStatusGrid";
import BorrowSummaryCard from "@/components/dashboard/BorrowSummaryCard";
import TodayScheduleCard from "@/components/dashboard/TodayScheduleCard";
import RecentNotificationsCard from "@/components/dashboard/RecentNotificationsCard";
import { useDashboardData } from "@/hooks/useDashboardData";
import type { AccessLogPublic } from "@/lib/types";

function formatTime(value?: string) {
  if (!value) return "--:--";
  return new Date(value).toLocaleTimeString("vi-VN", { hour: "2-digit", minute: "2-digit" });
}

function statusChip(status?: string) {
  if (status === "success" || status === "granted") return <Chip size="small" color="success" label="Thành công" sx={{ animation: `${successPop} 0.35s ease-out` }} />;
  if (status === "denied") return <Chip size="small" color="error" label="Từ chối" />;
  return <Chip size="small" color="warning" label={status || "Không rõ"} />;
}

function accessTypeChip(type?: string) {
  if (type === "entry") return <Chip size="small" color="success" label="Vào" />;
  if (type === "exit") return <Chip size="small" color="warning" label="Ra" />;
  return <Chip size="small" label={type || "-"} />;
}

export default function DashboardPage() {
  const { user, isLoading, isAuthenticated } = useAuth();
  const router = useRouter();
  const data = useDashboardData();

  useEffect(() => {
    if (!isLoading && !isAuthenticated) router.push("/login");
  }, [isLoading, isAuthenticated, router]);

  const stats = data.stats;

  if (isLoading || !isAuthenticated) {
    return <LoadingOverlay loading message="Đang tải..." />;
  }

  return (
    <Stack spacing={3}>
      {data.error ? <Alert severity="warning">{data.error}</Alert> : null}

      <GreetingBar
        userName={user?.full_name || user?.email || "Admin"}
        onRefresh={data.refresh}
        liveConnected={!!stats}
      />

      <Box sx={{ display: "grid", gridTemplateColumns: { xs: "1fr", sm: "repeat(2, 1fr)", lg: "repeat(4, 1fr)" }, gap: 2 }}>
        <MuiStatCard label="Tổng độc giả" value={stats?.total_patrons ?? "—"} icon={UsersIcon} gradient="linear-gradient(135deg, #6366f1 0%, #4338ca 100%)" pct={100} index={0} />
        <MuiStatCard label="Đang có mặt" value={stats?.active_patrons ?? "—"} icon={UserCheckIcon} gradient="linear-gradient(135deg, #10b981 0%, #059669 100%)" pct={stats?.total_patrons ? (stats.active_patrons / stats.total_patrons) * 100 : 0} index={1} />
        <MuiStatCard label="Lượt vào hôm nay" value={stats?.today_entries ?? "—"} icon={LoginIcon} gradient="linear-gradient(135deg, #3b82f6 0%, #1d4ed8 100%)" pct={100} index={2} />
        <MuiStatCard label="Lượt ra hôm nay" value={stats?.today_exits ?? "—"} icon={LogoutIcon} gradient="linear-gradient(135deg, #f59e0b 0%, #d97706 100%)" pct={100} index={3} />
      </Box>

      <Box sx={{ display: "grid", gridTemplateColumns: { xs: "1fr", lg: "1fr 1fr" }, gap: 3, alignItems: "start" }}>
        <HourlyActivityChart logs={data.hourlyLogs} loading={data.loading} />
        <CameraStatusGrid cameras={data.cameraStatuses} loading={data.loading} />
      </Box>

      <Box sx={{ display: "grid", gridTemplateColumns: { xs: "1fr", lg: "1fr 1fr" }, gap: 3, alignItems: "start" }}>
        <BorrowSummaryCard borrowStats={data.borrowStats} borrows={data.activeBorrows} loading={data.loading} />

        <DashboardCard
          title="Hoạt động gần đây"
          subtitle="Các lượt ra/vào mới nhất"
          actions={
            <Button component={Link} href="/history" endIcon={<ArrowForwardIcon />} size="small">
              Xem tất cả
            </Button>
          }
          noPadding
        >
          <LoadingOverlay loading={data.loading} message="Đang tải...">
            {data.recentLogs.length === 0 ? (
              <EmptyState title="Chưa có hoạt động nào" description="Các lượt ra/vào sẽ hiển thị ở đây" />
            ) : (
              <TableContainer sx={{ maxHeight: 320, overflowY: "auto" }}>
                <Table size="small">
                  <TableHead>
                    <TableRow>
                      <TableCell sx={{ fontWeight: 700 }}>Thời gian</TableCell>
                      <TableCell sx={{ fontWeight: 700 }}>Độc giả</TableCell>
                      <TableCell sx={{ fontWeight: 700 }}>Loại</TableCell>
                      <TableCell sx={{ fontWeight: 700 }}>Trạng thái</TableCell>
                    </TableRow>
                  </TableHead>
                  <TableBody>
                    {data.recentLogs.map((log, idx) => (
                      <TableRow
                        key={log.id}
                        hover
                        sx={{
                          animation: `${slideInRight} 0.3s ease-out`,
                          animationDelay: `${idx * 0.04}s`,
                          animationFillMode: "both",
                        }}
                      >
                        <TableCell sx={{ fontFamily: "monospace" }}>{formatTime(log.access_time)}</TableCell>
                        <TableCell>
                          <Typography variant="body2" sx={{ fontWeight: 800 }}>
                            {log.patron_name || "Không rõ tên"}
                          </Typography>
                          <Typography variant="caption" color="text.secondary" sx={{ fontFamily: "monospace" }}>
                            {log.student_code || log.patron_id || "---"}
                          </Typography>
                        </TableCell>
                        <TableCell>{accessTypeChip(log.access_type)}</TableCell>
                        <TableCell>{statusChip(log.status)}</TableCell>
                      </TableRow>
                    ))}
                  </TableBody>
                </Table>
              </TableContainer>
            )}
          </LoadingOverlay>
        </DashboardCard>
      </Box>

      <Box sx={{ display: "grid", gridTemplateColumns: { xs: "1fr", lg: "1fr 1fr" }, gap: 3, alignItems: "start" }}>
        <TodayScheduleCard assignments={data.todaySchedule} loading={data.loading} />
        <RecentNotificationsCard notifications={data.notifications} loading={data.loading} />
      </Box>
    </Stack>
  );
}
</file>

<file path="src/app/(dashboard)/history/page.tsx">
"use client";

import { useCallback, useEffect, useMemo, useRef, useState } from "react";
import {
  Alert,
  Box,
  Button,
  Chip,
  Grid,
  InputAdornment,
  LinearProgress,
  MenuItem,
  Stack,
  Switch,
  Table,
  TableBody,
  TableCell,
  TableContainer,
  TableHead,
  TableRow,
  TextField,
  Typography,
  useTheme,
} from "@mui/material";
import HistoryOutlinedIcon from "@mui/icons-material/HistoryOutlined";
import LoginOutlinedIcon from "@mui/icons-material/LoginOutlined";
import LogoutOutlinedIcon from "@mui/icons-material/LogoutOutlined";
import SearchOutlinedIcon from "@mui/icons-material/SearchOutlined";
import SensorsOutlinedIcon from "@mui/icons-material/SensorsOutlined";
import {
  Bar,
  BarChart,
  CartesianGrid,
  Legend,
  ResponsiveContainer,
  Tooltip,
  XAxis,
  YAxis,
} from "recharts";
import api from "@/lib/api-client";
import { successPop } from "@/lib/animations";
import { staggerSx } from "@/lib/useStaggeredAnimation";
import type { AccessFrequencyDay, AccessLogPublic, CameraEvent } from "@/lib/types";
import PageHeader from "@/components/ui/PageHeader";
import DashboardCard from "@/components/ui/DashboardCard";
import MuiStatCard from "@/components/ui/MuiStatCard";
import LoadingOverlay from "@/components/ui/LoadingOverlay";
import EmptyState from "@/components/ui/EmptyState";

const PAGE_SIZES = [20, 50, 100];

const CAMERA_LABELS: Record<string, string> = {
  entry_gate: "Cổng vào",
  exit_gate: "Cổng ra",
  kiosk: "Kiosk",
  web_login: "Đăng nhập web",
};

function getStatusLabel(status: string) {
  if (status === "success" || status === "granted") return "Thành công";
  if (status === "expired") return "Hết hạn";
  if (status === "spoof") return "Giả mạo";
  return "Thất bại";
}

function getStatusColor(status: string): "success" | "warning" | "error" {
  if (status === "success" || status === "granted") return "success";
  if (status === "expired") return "warning";
  return "error";
}

function mapEventStatus(status: CameraEvent["status"]) {
  return status === "granted" ? "success" : status;
}

export default function HistoryPage() {
  const theme = useTheme();
  const [logs, setLogs] = useState<AccessLogPublic[]>([]);
  const [total, setTotal] = useState(0);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState<string | null>(null);
  const [live, setLive] = useState(true);

  const [search, setSearch] = useState("");
  const [accessType, setAccessType] = useState("");
  const [status, setStatus] = useState("");
  const [dateFrom, setDateFrom] = useState("");
  const [dateTo, setDateTo] = useState("");

  const [skip, setSkip] = useState(0);
  const [limit, setLimit] = useState(50);
  const totalPages = Math.max(1, Math.ceil(total / limit));
  const currentPage = Math.floor(skip / limit) + 1;

  const [frequency, setFrequency] = useState<AccessFrequencyDay[]>([]);
  const [freqLoading, setFreqLoading] = useState(false);

  const load = useCallback(async () => {
    setLoading(true);
    try {
      setError(null);
      const data = await api.getAccessLogs({
        search: search || undefined,
        accessType: accessType || undefined,
        status: status || undefined,
        dateFrom: dateFrom || undefined,
        dateTo: dateTo || undefined,
        skip,
        limit,
      });
      setLogs(data.items);
      setTotal(data.total);
    } catch {
      setError("Không thể tải lịch sử ra/vào.");
    } finally {
      setLoading(false);
    }
  }, [search, accessType, status, dateFrom, dateTo, skip, limit]);

  useEffect(() => { load(); }, [load]);

  useEffect(() => {
    (async () => {
      setFreqLoading(true);
      try {
        const data = await api.getAccessFrequency({
          dateFrom: dateFrom || undefined,
          dateTo: dateTo || undefined,
        });
        setFrequency(Array.isArray(data.daily) ? data.daily : []);
      } finally {
        setFreqLoading(false);
      }
    })();
  }, [dateFrom, dateTo]);

  const liveCleanup = useRef<(() => void) | null>(null);
  useEffect(() => {
    if (!live || skip !== 0) {
      if (liveCleanup.current) {
        liveCleanup.current();
        liveCleanup.current = null;
      }
      return;
    }

    const cleanup = api.connectAccessSSE((event: CameraEvent) => {
      const mappedStatus = mapEventStatus(event.status);
      if (search) {
        const q = search.toLowerCase();
        if (!event.full_name?.toLowerCase().includes(q) && !event.student_code?.toLowerCase().includes(q)) return;
      }
      if (status && mappedStatus !== status) return;
      if (accessType && event.access_type !== accessType) return;

      const newLog: AccessLogPublic = {
        id: `sse-${Date.now()}`,
        patron_id: event.patron_id || null,
        patron_name: event.full_name || null,
        student_code: event.student_code || null,
        access_type: event.access_type || "entry",
        verify_method: "face",
        confidence: event.score || null,
        camera_id: event.camera_id,
        access_time: new Date().toISOString(),
        status: mappedStatus,
      };
      setLogs((prev) => [newLog, ...prev.filter((log) => !log.id.startsWith("sse-")).slice(0, limit - 1)]);
      setTotal((prev) => prev + 1);
    });
    liveCleanup.current = cleanup;
    return cleanup;
  }, [live, skip, search, status, accessType, limit]);

  const handleFilter = () => {
    if (skip === 0) {
      load();
    } else {
      setSkip(0);
    }
  };

  const goToPage = (page: number) => {
    setSkip((page - 1) * limit);
  };

  const entryTotal = useMemo(() => frequency.reduce((sum, day) => sum + day.entry, 0), [frequency]);
  const exitTotal = useMemo(() => frequency.reduce((sum, day) => sum + day.exit, 0), [frequency]);

  return (
    <Stack spacing={3}>
      <PageHeader
        title="Lịch sử mượn trả"
        icon={HistoryOutlinedIcon}
        gradient="linear-gradient(135deg, #1e1b4b 0%, #312e81 50%, #1e1b4b 100%)"
        statBadges={`${live ? "Live · " : ""}Tổng: ${total}`}
        onRefresh={load}
        actions={
          <Stack direction="row" spacing={1} sx={{ alignItems: "center" }}>
            <Chip icon={<SensorsOutlinedIcon />} label={live ? "Live đang bật" : "Live đang tắt"} sx={{ bgcolor: live ? "rgba(16,185,129,0.15)" : "rgba(255,255,255,0.08)", color: live ? "#6ee7b7" : "#a5b4fc", border: "1px solid", borderColor: live ? "rgba(16,185,129,0.3)" : "rgba(165,180,252,0.3)", fontWeight: 600 }} />
            <Chip label={`Tổng: ${total}`} sx={{ bgcolor: "rgba(255,255,255,0.08)", color: "#e0e7ff", border: "1px solid rgba(165,180,252,0.3)", fontWeight: 600 }} />
          </Stack>
        }
      />

      <DashboardCard title="Bộ lọc">
        <Grid container spacing={1.5} sx={{ alignItems: "center" }}>
          <Grid size={{ xs: 12, md: 3 }}>
            <TextField
              label="Tìm kiếm"
              placeholder="MSSV hoặc tên..."
              value={search}
              onChange={(event) => setSearch(event.target.value)}
              onKeyDown={(event) => event.key === "Enter" ? handleFilter() : undefined}
              fullWidth
              size="small"
              slotProps={{
                input: {
                  startAdornment: (
                    <InputAdornment position="start">
                      <SearchOutlinedIcon fontSize="small" />
                    </InputAdornment>
                  ),
                },
              }}
              sx={{ "& .MuiOutlinedInput-root": { borderRadius: 2, bgcolor: "background.paper", "&:hover": { "& fieldset": { borderColor: "primary.main" } } } }}
            />
          </Grid>
          <Grid size={{ xs: 12, sm: 6, md: 1.7 }}>
            <TextField select label="Loại" value={accessType} onChange={(event) => setAccessType(event.target.value)} fullWidth size="small">
              <MenuItem value="">Tất cả</MenuItem>
              <MenuItem value="entry">Vào</MenuItem>
              <MenuItem value="exit">Ra</MenuItem>
            </TextField>
          </Grid>
          <Grid size={{ xs: 12, sm: 6, md: 1.9 }}>
            <TextField select label="Kết quả" value={status} onChange={(event) => setStatus(event.target.value)} fullWidth size="small">
              <MenuItem value="">Tất cả</MenuItem>
              <MenuItem value="success">Thành công</MenuItem>
              <MenuItem value="failed">Thất bại</MenuItem>
              <MenuItem value="expired">Hết hạn</MenuItem>
              <MenuItem value="spoof">Giả mạo</MenuItem>
            </TextField>
          </Grid>
          <Grid size={{ xs: 12, sm: 6, md: 1.8 }}>
            <TextField
              label="Từ ngày"
              type="date"
              value={dateFrom}
              onChange={(event) => setDateFrom(event.target.value)}
              fullWidth
              size="small"
              slotProps={{ inputLabel: { shrink: true } }}
            />
          </Grid>
          <Grid size={{ xs: 12, sm: 6, md: 1.8 }}>
            <TextField
              label="Đến ngày"
              type="date"
              value={dateTo}
              onChange={(event) => setDateTo(event.target.value)}
              fullWidth
              size="small"
              slotProps={{ inputLabel: { shrink: true } }}
            />
          </Grid>
          <Grid size={{ xs: 12, md: 1.3 }}>
            <Button
              variant="contained"
              onClick={handleFilter}
              disabled={loading}
              fullWidth
              sx={{ borderRadius: 2, fontWeight: 700, textTransform: "none", background: "linear-gradient(135deg, #6366f1 0%, #4338ca 100%)", "&:hover": { background: "linear-gradient(135deg, #4f46e5 0%, #3730a3 100%)" } }}
            >
              Lọc
            </Button>
          </Grid>
          <Grid size={{ xs: 12, md: 1.5 }}>
            <Stack direction="row" spacing={0.5} sx={{ alignItems: "center", justifyContent: { xs: "flex-start", md: "flex-end" } }}>
              <Typography variant="body2" color="text.secondary">Live</Typography>
              <Switch checked={live} onChange={(event) => setLive(event.target.checked)} />
            </Stack>
          </Grid>
        </Grid>
      </DashboardCard>

      <Grid container spacing={2}>
        <Grid size={{ xs: 12, md: 8 }}>
          <DashboardCard title="Tần suất ra/vào theo ngày">
            <LoadingOverlay loading={freqLoading} message="Đang tải biểu đồ...">
              {frequency.length === 0 ? (
                <Alert severity="info">Chưa có dữ liệu tần suất trong khoảng thời gian đã chọn.</Alert>
              ) : (
                <Box sx={{ height: 270 }}>
                  <ResponsiveContainer width="100%" height="100%">
                    <BarChart data={frequency} margin={{ top: 8, right: 20, left: -10, bottom: 0 }}>
                      <CartesianGrid strokeDasharray="3 3" stroke={theme.palette.divider} />
                      <XAxis
                        dataKey="date"
                        fontSize={12}
                        tick={{ fill: theme.palette.text.secondary }}
                        tickFormatter={(value: string) => new Date(`${value}T00:00:00`).toLocaleDateString("vi-VN", { day: "2-digit", month: "2-digit" })}
                      />
                      <YAxis allowDecimals={false} fontSize={12} tick={{ fill: theme.palette.text.secondary }} />
                      <Tooltip
                        cursor={{ fill: theme.palette.action.hover }}
                        contentStyle={{
                          background: theme.palette.background.paper,
                          border: `1px solid ${theme.palette.divider}`,
                          borderRadius: 8,
                          color: theme.palette.text.primary,
                        }}
                        labelFormatter={(value) => new Date(`${value}T00:00:00`).toLocaleDateString("vi-VN", {
                          weekday: "long",
                          day: "2-digit",
                          month: "2-digit",
                          year: "numeric",
                        })}
                      />
                      <Legend />
                      <Bar dataKey="entry" fill={theme.palette.success.main} name="Vào" radius={[5, 5, 0, 0]} />
                      <Bar dataKey="exit" fill={theme.palette.warning.main} name="Ra" radius={[5, 5, 0, 0]} />
                    </BarChart>
                  </ResponsiveContainer>
                </Box>
              )}
            </LoadingOverlay>
          </DashboardCard>
        </Grid>

        <Grid size={{ xs: 12, md: 4 }}>
          <Stack spacing={2} sx={{ height: "100%" }}>
            <MuiStatCard
              label="Lượt vào trong biểu đồ"
              value={entryTotal}
              icon={LoginOutlinedIcon}
              gradient="linear-gradient(135deg, #10b981 0%, #059669 100%)"
              pct={100}
              index={0}
            />
            <MuiStatCard
              label="Lượt ra trong biểu đồ"
              value={exitTotal}
              icon={LogoutOutlinedIcon}
              gradient="linear-gradient(135deg, #f59e0b 0%, #d97706 100%)"
              pct={100}
              index={1}
            />
          </Stack>
        </Grid>
      </Grid>

      <DashboardCard
        title="Nhật ký truy cập"
        subtitle={`Trang ${currentPage} / ${totalPages}`}
        noPadding
      >
        {error ? <Alert severity="error" sx={{ mx: 2.5, mt: 2 }}>{error}</Alert> : null}

        <LoadingOverlay loading={loading && logs.length === 0} message="Đang tải lịch sử...">
          {logs.length === 0 && !loading ? (
            <EmptyState
              title="Không có dữ liệu lịch sử phù hợp"
            />
          ) : (
      <TableContainer sx={{ overflowX: "auto" }}>
      <Table size="small" sx={{ minWidth: 980 }}>
                <TableHead>
                  <TableRow>
                    <TableCell sx={{ fontWeight: 700 }}>Thời gian</TableCell>
                    <TableCell sx={{ fontWeight: 700 }}>Độc giả</TableCell>
                    <TableCell sx={{ fontWeight: 700 }}>MSSV</TableCell>
                    <TableCell sx={{ fontWeight: 700 }}>Loại</TableCell>
                    <TableCell sx={{ fontWeight: 700 }}>Phương thức</TableCell>
                    <TableCell sx={{ fontWeight: 700 }}>Cổng</TableCell>
                    <TableCell sx={{ fontWeight: 700 }}>Độ tin cậy</TableCell>
                    <TableCell sx={{ fontWeight: 700 }}>Kết quả</TableCell>
                  </TableRow>
                </TableHead>
                <TableBody>
                  {logs.map((log, idx) => {
                    const confidence = log.confidence == null ? null : Math.round(log.confidence * 100);
                    const statusColor = getStatusColor(log.status);
                    return (
                      <TableRow key={log.id} hover sx={staggerSx(idx, 0.03)}>
                        <TableCell sx={{ whiteSpace: "nowrap", fontFamily: "monospace", color: "text.secondary" }}>
                          {new Date(log.access_time).toLocaleString("vi-VN")}
                        </TableCell>
                        <TableCell sx={{ fontWeight: 700 }}>{log.patron_name || "-"}</TableCell>
                        <TableCell sx={{ fontFamily: "monospace", color: "text.secondary" }}>{log.student_code || "-"}</TableCell>
                        <TableCell>
                          <Chip
                            size="small"
                            color={log.access_type === "entry" ? "success" : "warning"}
                            label={log.access_type === "entry" ? "Vào" : "Ra"}
                          />
                        </TableCell>
                        <TableCell sx={{ color: "text.secondary" }}>{log.verify_method}</TableCell>
                        <TableCell sx={{ fontFamily: "monospace", color: "text.secondary" }}>
                          {CAMERA_LABELS[log.camera_id] || log.camera_id}
                        </TableCell>
                        <TableCell sx={{ minWidth: 150 }}>
                          {confidence == null ? (
                            <Typography color="text.secondary">-</Typography>
                          ) : (
                            <Stack direction="row" spacing={1} sx={{ alignItems: "center" }}>
                              <LinearProgress
                                variant="determinate"
                                value={confidence}
                                color={confidence >= 80 ? "success" : confidence >= 60 ? "warning" : "error"}
                                sx={{ width: 80, height: 7, borderRadius: 99 }}
                              />
                              <Typography variant="caption" color="text.secondary">{confidence}%</Typography>
                            </Stack>
                          )}
                        </TableCell>
                        <TableCell>
                          <Chip size="small" color={statusColor} label={getStatusLabel(log.status)} sx={log.status === "success" || log.status === "granted" ? { animation: `${successPop} 0.35s ease-out` } : {}} />
                        </TableCell>
                      </TableRow>
                    );
                  })}
                </TableBody>
              </Table>
            </TableContainer>
          )}
        </LoadingOverlay>

        <Stack
          direction={{ xs: "column", sm: "row" }}
          spacing={1.5}
          sx={{ px: 2.5, pb: 2, pt: 1.5, borderTop: `1px solid ${theme.palette.divider}`, alignItems: { sm: "center" }, justifyContent: "space-between" }}
        >
          <TextField
            select
            label="Số dòng"
            value={limit}
            onChange={(event) => { setLimit(Number(event.target.value)); setSkip(0); }}
            size="small"
            sx={{ width: 120 }}
          >
            {PAGE_SIZES.map((size) => (
              <MenuItem key={size} value={size}>{size}</MenuItem>
            ))}
          </TextField>

          <Stack direction="row" spacing={1} sx={{ alignItems: "center" }}>
            <Button variant="outlined" disabled={currentPage <= 1} onClick={() => goToPage(1)}>
              Đầu
            </Button>
            <Button variant="outlined" disabled={currentPage <= 1} onClick={() => goToPage(currentPage - 1)}>
              Trước
            </Button>
            <Typography color="text.secondary" sx={{ px: 1 }}>
              {currentPage} / {totalPages}
            </Typography>
            <Button variant="outlined" disabled={currentPage >= totalPages} onClick={() => goToPage(currentPage + 1)}>
              Sau
            </Button>
            <Button variant="outlined" disabled={currentPage >= totalPages} onClick={() => goToPage(totalPages)}>
              Cuối
            </Button>
          </Stack>
        </Stack>
      </DashboardCard>
    </Stack>
  );
}
</file>

<file path="src/app/(dashboard)/layout.tsx">
"use client";

import { useEffect, useMemo, useState } from "react";
import { useRouter } from "next/navigation";
import {
  AppBar,
  Avatar,
  Badge,
  Box,
  CircularProgress,
  IconButton,
  Stack,
  Toolbar,
  Tooltip,
  Typography,
  useTheme,
} from "@mui/material";
import BellIcon from "@mui/icons-material/NotificationsOutlined";
import Brightness6Icon from "@mui/icons-material/Brightness6Outlined";
import DarkModeIcon from "@mui/icons-material/DarkModeOutlined";
import LightModeIcon from "@mui/icons-material/LightModeOutlined";
import UserIcon from "@mui/icons-material/PersonOutlined";
import { useAuth } from "@/lib/auth-context";
import { useColorMode } from "@/lib/mui-theme";
import api from "@/lib/api-client";
import Sidebar from "@/components/sidebar";
import NotificationDropdown from "@/components/ui/NotificationDropdown";

function Topbar({ user }: { user: any }) {
  const theme = useTheme();
  const { mode, effectiveMode, preference, reducedMotion, toggleMode } = useColorMode();
  const [bellAnchorEl, setBellAnchorEl] = useState<HTMLElement | null>(null);
  const [unreadCount, setUnreadCount] = useState(0);
  const bellOpen = Boolean(bellAnchorEl);

  const modeIcon = useMemo(() => {
    if (preference === "auto") return <Brightness6Icon fontSize="small" />;
    return preference === "dark" ? <DarkModeIcon fontSize="small" /> : <LightModeIcon fontSize="small" />;
  }, [preference]);

  const modeTooltip = useMemo(() => {
    if (reducedMotion === "reduce") return "Chế độ hiển thị (Đã bật giảm chuyển động)";
    if (preference === "auto") return `Chế độ tự động (${effectiveMode === "dark" ? "Tối" : "Sáng"}) - Nhấn để thay đổi`;
    if (preference === "dark") return "Chế độ tối - Nhấn để chuyển";
    return "Chế độ sáng - Nhấn để chuyển";
  }, [preference, effectiveMode, reducedMotion]);

  useEffect(() => {
    let mounted = true;

    const fetchCount = async () => {
      try {
        const count = await api.getUnreadCount();
        if (mounted) setUnreadCount(count);
      } catch {
        // silently fail
      }
    };

    fetchCount();

    // Poll every 30 seconds as fallback
    const interval = setInterval(fetchCount, 30000);

    return () => {
      mounted = false;
      clearInterval(interval);
    };
  }, []);

  const handleBellClick = (event: React.MouseEvent<HTMLElement>) => {
    if (bellAnchorEl) {
      setBellAnchorEl(null);
    } else {
      setBellAnchorEl(event.currentTarget);
    }
  };

  const handleBellClose = () => {
    setBellAnchorEl(null);
    // Refresh count after closing
    api.getUnreadCount().then((count) => setUnreadCount(count)).catch(() => {});
  };

  return (
    <>
      <AppBar
        position="sticky"
        color="default"
        elevation={0}
        sx={{
          borderBottom: 1,
          borderColor: "divider",
          bgcolor: "background.paper",
        }}
      >
        <Toolbar sx={{ justifyContent: "flex-end", gap: 1.5, minHeight: 64 }}>
          <Box sx={{ position: "relative" }}>
            <Tooltip title="Thông báo">
              <IconButton color="inherit" onClick={handleBellClick}>
                <Badge badgeContent={unreadCount > 0 ? (unreadCount > 99 ? "99+" : unreadCount) : 0} color="error" invisible={unreadCount === 0}>
                  <BellIcon fontSize="small" />
                </Badge>
              </IconButton>
            </Tooltip>
            <NotificationDropdown anchorEl={bellAnchorEl} open={bellOpen} onClose={handleBellClose} />
          </Box>
          <Tooltip title={modeTooltip} arrow>
            <IconButton color="inherit" onClick={toggleMode}>
              {modeIcon}
            </IconButton>
          </Tooltip>
          <Stack direction="row" spacing={1.25} sx={{ alignItems: "center", pl: 1.5, borderLeft: `1px solid ${theme.palette.divider}` }}>
            <Avatar sx={{ width: 34, height: 34, flexShrink: 0, bgcolor: "primary.main", color: "primary.contrastText" }}>
              <UserIcon fontSize="small" />
            </Avatar>
            <Box sx={{ display: { xs: "none", sm: "block" }, minWidth: 0, maxWidth: 160 }}>
              <Typography variant="body2" sx={{ fontWeight: 700, overflow: "hidden", textOverflow: "ellipsis", whiteSpace: "nowrap" }}>
                {user?.full_name || "Admin"}
              </Typography>
              <Typography variant="caption" color="text.secondary" sx={{ textTransform: "capitalize", display: "block", overflow: "hidden", textOverflow: "ellipsis", whiteSpace: "nowrap" }}>
                {user?.role || "staff"}
              </Typography>
            </Box>
          </Stack>
        </Toolbar>
      </AppBar>
    </>
  );
}

export default function DashboardLayout({ children }: { children: React.ReactNode }) {
  const { isAuthenticated, isLoading, user } = useAuth();
  const router = useRouter();

  useEffect(() => {
    if (!isLoading && !isAuthenticated) {
      router.push("/login");
    }
  }, [isAuthenticated, isLoading, router]);

  if (isLoading) {
    return (
      <Box sx={{ minHeight: "100vh", bgcolor: "background.default", display: "grid", placeItems: "center" }}>
        <Stack spacing={2} sx={{ alignItems: "center" }}>
          <CircularProgress color="primary" />
          <Typography variant="body2" color="text.secondary">Đang tải...</Typography>
        </Stack>
      </Box>
    );
  }

  if (!isAuthenticated) return null;

  return (
    <Box sx={{ display: "flex", minHeight: "100vh", bgcolor: "background.default" }}>
      <Sidebar />
      <Box sx={{ flex: 1, minWidth: 0, display: "flex", flexDirection: "column" }}>
        <Topbar user={user} />
        <Box component="main" sx={{ flex: 1, display: "flex", flexDirection: "column", p: { xs: 2, md: 3 } }}>
          {children}
        </Box>
      </Box>
    </Box>
  );
}
