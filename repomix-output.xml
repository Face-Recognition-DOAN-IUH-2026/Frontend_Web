    );
  });

  test("WEB-14: Task polling transitions from PENDING to SUCCESS", async ({ page }) => {
    let callCount = 0;
    await page.route(
      /\/api\/tasks\/poll-task*/,
      async (route) => {
        callCount++;
        if (callCount === 1) {
          await route.fulfill({
            status: 200,
            contentType: "application/json",
            body: JSON.stringify({
              task_id: "poll-task-id",
              status: "PENDING",
              result: null,
            }),
          });
        } else {
          await route.fulfill({
            status: 200,
            contentType: "application/json",
            body: JSON.stringify({
              task_id: "poll-task-id",
              status: "SUCCESS",
              result: { is_live: true, score: 0.95 },
            }),
          });
        }
      }
    );

    await page.goto("/enroll");
    await page.waitForTimeout(5000);
  });

  test("WEB-15: JobPoll handles NULL confidence (edge case)", async ({ page }) => {
    await page.route(
      /\/api\/tasks\/null-confidence*/,
      async (route) => {
        await route.fulfill({
          status: 200,
          contentType: "application/json",
          body: JSON.stringify({
            task_id: "null-confidence-task",
            status: "SUCCESS",
            result: { is_live: null, score: 0 },
          }),
        });
      }
    );
  });
});
