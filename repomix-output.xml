<file path="src/app/(dashboard)/_components/dashboard/BorrowSummaryCard.tsx">
"use client";

import Link from "next/link";
import {
  Avatar,
  Box,
  Button,
  Chip,
  Stack,
  Table,
  TableBody,
  TableCell,
  TableContainer,
  TableHead,
  TableRow,
  Typography,
  useTheme,
} from "@mui/material";
import ArrowForwardIcon from "@mui/icons-material/ArrowForward";
import BookIcon from "@mui/icons-material/MenuBookOutlined";
import WarningAmberIcon from "@mui/icons-material/WarningAmberOutlined";
import CheckCircleOutlineIcon from "@mui/icons-material/CheckCircleOutlineOutlined";
import DashboardCard from "@/app/(dashboard)/_components/ui/DashboardCard";
import EmptyState from "@/app/(dashboard)/_components/ui/EmptyState";
import type { BorrowRecord } from "@/lib/types";

interface BorrowSummaryCardProps {
  borrowStats: { total: number; active: number; overdue: number } | null;
  borrows: BorrowRecord[];
  loading: boolean;
}

export default function BorrowSummaryCard({ borrowStats, borrows, loading }: BorrowSummaryCardProps) {
  const theme = useTheme();
  const recentBorrows = [...borrows]
    .sort((a, b) => new Date(b.borrow_at).getTime() - new Date(a.borrow_at).getTime())
    .slice(0, 5);

  return (
    <DashboardCard
      title="Hoạt động Mượn sách"
      subtitle={`${borrowStats?.active ?? 0} đang mượn · ${borrowStats?.overdue ?? 0} quá hạn`}
      actions={
        <Button component={Link} href="/books" endIcon={<ArrowForwardIcon />} size="small" sx={{ fontWeight: 700 }}>
          Chi tiết
        </Button>
      }
      noPadding
    >
      {borrowStats && (
        <Stack direction="row" spacing={1} sx={{ px: 2.5, pt: 2, pb: 1 }}>
          <Chip
            size="small"
            label={`${borrowStats.active} cuốn đang mượn`}
            color="primary"
            sx={{ fontWeight: 700, fontSize: "0.75rem" }}
          />
          {borrowStats.overdue > 0 ? (
            <Chip
              size="small"
              icon={<WarningAmberIcon sx={{ fontSize: "14px !important" }} />}
              label={`${borrowStats.overdue} quá hạn`}
              color="error"
              sx={{ fontWeight: 700, fontSize: "0.75rem" }}
            />
          ) : (
            <Chip
              size="small"
              icon={<CheckCircleOutlineIcon sx={{ fontSize: "14px !important" }} />}
              label="0 quá hạn"
              color="success"
              variant="outlined"
              sx={{ fontWeight: 600, fontSize: "0.75rem" }}
            />
          )}
        </Stack>
      )}

      {recentBorrows.length === 0 ? (
        <EmptyState
          icon={<BookIcon sx={{ fontSize: 40, color: "text.disabled" }} />}
          title="Không có sách nào đang mượn"
        />
      ) : (
        <TableContainer sx={{ mt: 0.5 }}>
          <Table size="small">
            <TableHead>
              <TableRow sx={{ bgcolor: theme.palette.mode === "dark" ? "rgba(30, 41, 59, 0.4)" : "rgba(248, 250, 252, 0.6)" }}>
                <TableCell sx={{ fontWeight: 700, fontSize: "0.75rem" }}>Sách</TableCell>
                <TableCell sx={{ fontWeight: 700, fontSize: "0.75rem" }}>Ngày mượn</TableCell>
                <TableCell sx={{ fontWeight: 700, fontSize: "0.75rem" }}>Hạn trả</TableCell>
                <TableCell sx={{ fontWeight: 700, fontSize: "0.75rem" }}>Trạng thái</TableCell>
              </TableRow>
            </TableHead>
            <TableBody>
              {recentBorrows.map((record) => {
                const overdue = new Date(record.due_at) < new Date();
                const bookTitle = record.book?.title || `Sách #${record.book_id.slice(0, 8)}`;
                const author = record.book?.author;

                return (
                  <TableRow
                    key={record.id}
                    hover
                    sx={{
                      transition: "background-color 0.15s ease",
                      bgcolor: overdue
                        ? theme.palette.mode === "dark"
                          ? "rgba(239, 68, 68, 0.08)"
                          : "rgba(254, 242, 242, 0.6)"
                        : "transparent",
                    }}
                  >
                    <TableCell sx={{ py: 1.25 }}>
                      <Stack direction="row" spacing={1.25} sx={{ alignItems: "center" }}>
                        <Avatar
                          sx={{
                            width: 32,
                            height: 32,
                            borderRadius: 1.5,
                            bgcolor: overdue ? "error.main" : "primary.main",
                            color: "#fff",
                            fontSize: "0.8rem",
                            fontWeight: 700,
                          }}
                        >
                          <BookIcon sx={{ fontSize: 18 }} />
                        </Avatar>
                        <Box sx={{ minWidth: 0, maxWidth: { xs: 120, sm: 180, md: 220 } }}>
                          <Typography variant="body2" sx={{ fontWeight: 700, fontSize: "0.82rem" }} noWrap title={bookTitle}>
                            {bookTitle}
                          </Typography>
                          {author && (
                            <Typography variant="caption" color="text.secondary" sx={{ fontSize: "0.7rem", display: "block" }} noWrap>
                              {author}
                            </Typography>
                          )}
                        </Box>
                      </Stack>
                    </TableCell>

                    <TableCell sx={{ fontSize: "0.78rem", color: "text.secondary" }}>
                      {new Date(record.borrow_at).toLocaleDateString("vi-VN")}
                    </TableCell>

                    <TableCell sx={{ fontSize: "0.78rem", fontWeight: overdue ? 700 : 500, color: overdue ? "error.main" : "text.primary" }}>
                      {new Date(record.due_at).toLocaleDateString("vi-VN")}
                    </TableCell>

                    <TableCell>
                      <Chip
                        size="small"
                        color={overdue ? "error" : "success"}
                        label={overdue ? "Quá hạn" : "Đang mượn"}
                        sx={{
                          fontWeight: 700,
                          fontSize: "0.68rem",
                          height: 22,
                          bgcolor: overdue ? "rgba(239, 68, 68, 0.12)" : "rgba(16, 185, 129, 0.12)",
                          color: overdue ? "#dc2626" : "#059669",
                          border: "1px solid",
                          borderColor: overdue ? "rgba(239, 68, 68, 0.25)" : "rgba(16, 185, 129, 0.25)",
                        }}
                      />
                    </TableCell>
                  </TableRow>
                );
              })}
            </TableBody>
          </Table>
        </TableContainer>
      )}
    </DashboardCard>
  );
}
</file>

<file path="src/app/(dashboard)/_components/dashboard/CameraStatusGrid.tsx">
"use client";

import { Avatar, Box, Chip, Paper, Stack, Typography, useTheme } from "@mui/material";
import CheckCircleIcon from "@mui/icons-material/CheckCircleOutlined";
import ErrorOutlineIcon from "@mui/icons-material/ErrorOutlineOutlined";
import CameraIcon from "@mui/icons-material/PhotoCameraOutlined";
import VideocamIcon from "@mui/icons-material/VideocamOutlined";
import DashboardCard from "@/app/(dashboard)/_components/ui/DashboardCard";
import EmptyState from "@/app/(dashboard)/_components/ui/EmptyState";
import type { CameraStatus } from "@/lib/types";

interface CameraStatusGridProps {
  cameras: CameraStatus[];
  loading: boolean;
}

function cameraLabel(id: string) {
  if (id === "entry_gate") return "Cổng vào chính";
  if (id === "exit_gate") return "Cổng ra chính";
  if (id === "kiosk") return "Kiosk Tự phục vụ";
  return id;
}

function cameraRoleDescription(id: string) {
  if (id === "entry_gate") return "Nhận diện khuôn mặt & Check-in";
  if (id === "exit_gate") return "Nhận diện khuôn mặt & Check-out";
  if (id === "kiosk") return "Xác thực mượn/trả tự động";
  return "Camera giám sát";
}

export default function CameraStatusGrid({ cameras, loading }: CameraStatusGridProps) {
  const theme = useTheme();
  const onlineCount = cameras.filter((c) => c.connected && c.running).length;

  return (
    <DashboardCard
      title="Hệ thống Camera"
      subtitle={`${onlineCount}/${cameras.length} thiết bị đang hoạt động`}
      actions={
        <Chip
          label={`${onlineCount}/${cameras.length} Online`}
          size="small"
          color={onlineCount === cameras.length && cameras.length > 0 ? "success" : "warning"}
          sx={{ fontWeight: 700, fontSize: "0.75rem" }}
        />
      }
    >
      {cameras.length === 0 ? (
        <EmptyState
          icon={<CameraIcon sx={{ fontSize: 40, color: "text.disabled" }} />}
          title="Không tìm thấy camera nào"
        />
      ) : (
        <Box sx={{ display: "grid", gridTemplateColumns: { xs: "1fr", sm: "repeat(2, 1fr)" }, gap: 2, pt: 0.5 }}>
          {cameras.map((cam) => {
            const isOnline = cam.connected && cam.running;
            return (
              <Paper
                key={cam.camera_id}
                variant="outlined"
                sx={{
                  p: 2,
                  borderRadius: 2.5,
                  position: "relative",
                  overflow: "hidden",
                  transition: "all 0.25s cubic-bezier(0.4, 0, 0.2, 1)",
                  bgcolor: theme.palette.mode === "dark" ? "rgba(30, 41, 59, 0.5)" : "rgba(248, 250, 252, 0.8)",
                  borderColor: isOnline
                    ? theme.palette.mode === "dark"
                      ? "rgba(16, 185, 129, 0.3)"
                      : "rgba(16, 185, 129, 0.4)"
                    : "rgba(239, 68, 68, 0.3)",
                  "&:hover": {
                    transform: "translateY(-2px)",
                    boxShadow: isOnline
                      ? "0 8px 20px -4px rgba(16, 185, 129, 0.15)"
                      : "0 8px 20px -4px rgba(239, 68, 68, 0.15)",
                  },
                }}
              >
                <Stack direction="row" spacing={1.5} sx={{ alignItems: "flex-start" }}>
                  <Box sx={{ position: "relative" }}>
                    <Avatar
                      sx={{
                        background: isOnline
                          ? "linear-gradient(135deg, #10b981 0%, #047857 100%)"
                          : "linear-gradient(135deg, #ef4444 0%, #b91c1c 100%)",
                        width: 42,
                        height: 42,
                        borderRadius: 2,
                        boxShadow: isOnline
                          ? "0 4px 12px rgba(16, 185, 129, 0.35)"
                          : "0 4px 12px rgba(239, 68, 68, 0.35)",
                      }}
                    >
                      <VideocamIcon sx={{ fontSize: 22, color: "#fff" }} />
                    </Avatar>
                    {isOnline && (
                      <Box
                        sx={{
                          position: "absolute",
                          bottom: -2,
                          right: -2,
                          width: 12,
                          height: 12,
                          borderRadius: "50%",
                          bgcolor: "#10b981",
                          border: "2px solid",
                          borderColor: "background.paper",
                          "&::after": {
                            content: '""',
                            position: "absolute",
                            top: -2,
                            left: -2,
                            width: "100%",
                            height: "100%",
                            borderRadius: "50%",
                            animation: "pulseRing 2s infinite ease-out",
                            border: "2px solid #10b981",
                          },
                          "@keyframes pulseRing": {
                            "0%": { transform: "scale(0.8)", opacity: 1 },
                            "100%": { transform: "scale(2.4)", opacity: 0 },
                          },
                        }}
                      />
                    )}
                  </Box>

                  <Box sx={{ minWidth: 0, flex: 1 }}>
                    <Stack direction="row" sx={{ justifyContent: "space-between", alignItems: "center" }}>
                      <Typography variant="body2" sx={{ fontWeight: 700, color: "text.primary" }} noWrap>
                        {cameraLabel(cam.camera_id)}
                      </Typography>
                      <Chip
                        size="small"
                        icon={isOnline ? <CheckCircleIcon sx={{ fontSize: "12px !important" }} /> : <ErrorOutlineIcon sx={{ fontSize: "12px !important" }} />}
                        label={isOnline ? "Trực tiếp" : "Mất kết nối"}
                        sx={{
                          height: 20,
                          fontSize: "0.68rem",
                          fontWeight: 700,
                          bgcolor: isOnline ? "rgba(16, 185, 129, 0.12)" : "rgba(239, 68, 68, 0.12)",
                          color: isOnline ? "#059669" : "#dc2626",
                          border: "1px solid",
                          borderColor: isOnline ? "rgba(16, 185, 129, 0.25)" : "rgba(239, 68, 68, 0.25)",
                        }}
                      />
                    </Stack>
                    <Typography variant="caption" color="text.secondary" sx={{ display: "block", mt: 0.5, fontSize: "0.72rem" }}>
                      {cameraRoleDescription(cam.camera_id)}
                    </Typography>
                  </Box>
                </Stack>
              </Paper>
            );
          })}
        </Box>
      )}
    </DashboardCard>
  );
}
</file>

<file path="src/app/(dashboard)/_components/dashboard/RecentNotificationsCard.tsx">
"use client";

import Link from "next/link";
import { Avatar, Box, Button, Stack, Typography } from "@mui/material";
import ArrowForwardIcon from "@mui/icons-material/ArrowForward";
import WarningIcon from "@mui/icons-material/WarningAmberOutlined";
import BookIcon from "@mui/icons-material/MenuBookOutlined";
import CalendarIcon from "@mui/icons-material/CalendarMonthOutlined";
import PersonIcon from "@mui/icons-material/PersonOutlineOutlined";
import NotificationsIcon from "@mui/icons-material/NotificationsNoneOutlined";
import DashboardCard from "@/app/(dashboard)/_components/ui/DashboardCard";
import EmptyState from "@/app/(dashboard)/_components/ui/EmptyState";
import type { Notification } from "@/lib/types";

interface RecentNotificationsCardProps {
  notifications: Notification[];
  loading: boolean;
}

const TYPE_CONFIG: Record<string, { icon: React.ReactNode; color: string }> = {
  borrow_overdue: { icon: <WarningIcon sx={{ fontSize: 18 }} />, color: "#DC2626" },
  book_available: { icon: <BookIcon sx={{ fontSize: 18 }} />, color: "#059669" },
  schedule_change: { icon: <CalendarIcon sx={{ fontSize: 18 }} />, color: "#D97706" },
  membership_expiry: { icon: <PersonIcon sx={{ fontSize: 18 }} />, color: "#8B0000" },
};

function relativeTime(dateStr: string) {
  const now = Date.now();
  const then = new Date(dateStr).getTime();
  const diff = Math.floor((now - then) / 1000);
  if (diff < 60) return "vừa xong";
  if (diff < 3600) return `${Math.floor(diff / 60)} phút trước`;
  if (diff < 86400) return `${Math.floor(diff / 3600)} giờ trước`;
  return `${Math.floor(diff / 86400)} ngày trước`;
}

export default function RecentNotificationsCard({ notifications, loading }: RecentNotificationsCardProps) {
  return (
    <DashboardCard
      title="Thông báo gần đây"
      actions={
        <Button component={Link} href="/notifications" endIcon={<ArrowForwardIcon />} size="small">
          Xem tất cả
        </Button>
      }
      noPadding
    >
      {notifications.length === 0 ? (
        <EmptyState
          icon={<NotificationsIcon sx={{ fontSize: 40, color: "text.disabled" }} />}
          title="Không có thông báo mới"
        />
      ) : (
        <Stack spacing={0.5} sx={{ p: 1.5 }}>
          {notifications.slice(0, 5).map((n) => {
            const config = TYPE_CONFIG[n.type] || { icon: <NotificationsIcon sx={{ fontSize: 18 }} />, color: "#6b7280" };
            return (
              <Stack
                key={n.id}
                direction="row"
                spacing={1.5}
                sx={{
                  alignItems: "flex-start",
                  p: 1.25,
                  borderRadius: 2,
                  transition: "background 0.15s",
                  "&:hover": { bgcolor: "action.hover" },
                }}
              >
                <Avatar sx={{ bgcolor: config.color, width: 32, height: 32 }}>
                  {config.icon}
                </Avatar>
                <Box sx={{ minWidth: 0, flex: 1 }}>
                  <Typography variant="body2" sx={{ fontWeight: n.isRead ? 600 : 800 }} noWrap>
                    {n.title}
                  </Typography>
                  <Typography variant="caption" color="text.secondary" noWrap sx={{ display: "block" }}>
                    {n.body}
                  </Typography>
                </Box>
                <Typography variant="caption" color="text.secondary" sx={{ whiteSpace: "nowrap", flexShrink: 0 }}>
                  {relativeTime(n.createdAt)}
                </Typography>
              </Stack>
            );
          })}
        </Stack>
      )}
    </DashboardCard>
  );
}
</file>

