}

function DragPreview({ staff, assignment }: { staff?: ScheduleStaff | null; assignment?: StaffScheduleAssignment | null }) {
  if (staff) {
    return (
      <Paper elevation={12} sx={{ width: 300, p: 1.75, border: 2, borderColor: "primary.main", bgcolor: "background.paper" }}>
