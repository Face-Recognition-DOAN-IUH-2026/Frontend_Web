            sx={{ borderRadius: "3px", textTransform: "none", fontSize: "0.8rem", fontWeight: 600 }}
          >
            Tải lại
          </Button>
        </Stack>

        {/* Compact Metric Bar */}
        <Paper
          elevation={0}
          sx={{
            borderRadius: "3px",
            border: "1px solid",
            borderColor: isDark ? "#334155" : "#E2E8F0",
            bgcolor: isDark ? "#1E293B" : "#FFFFFF",
            display: "grid",
            gridTemplateColumns: "repeat(4, 1fr)",
