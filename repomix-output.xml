<file path="src/app/(dashboard)/_components/staff-schedule/TemplateManagementPanel.tsx">
"use client";

import { useEffect, useState } from "react";
import {
  Box,
  Button,
  CircularProgress,
  Divider,
  Drawer,
  IconButton,
  MenuItem,
  Stack,
  TextField,
  ToggleButton,
  ToggleButtonGroup,
  Typography,
} from "@mui/material";
import Alert from "antd/es/alert";
import Modal from "antd/es/modal";
import CloseIcon from "@mui/icons-material/Close";
import DeleteIcon from "@mui/icons-material/Delete";
import AddIcon from "@mui/icons-material/Add";
import api from "@/lib/api-client";
import type { LibraryZone, StaffShift, ScheduleStaff } from "@/lib/types";

interface Props {
  open: boolean;
  onClose: () => void;
  zones: LibraryZone[];
  shifts: StaffShift[];
  staff: ScheduleStaff[];
  onUpdated: () => void;
}

function getApiError(err: any): string {
  const data = err?.response?.data;
  return data?.error || data?.message || err?.message || "Có lỗi xảy ra";
}

const DAYS = ["CN", "T2", "T3", "T4", "T5", "T6", "T7"];

export default function TemplateManagementPanel({ open, onClose, zones, shifts, staff, onUpdated }: Props) {
  const [templates, setTemplates] = useState<any[]>([]);
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState<string | null>(null);
  const [saving, setSaving] = useState(false);

  const [name, setName] = useState("");
  const [selectedDays, setSelectedDays] = useState<number[]>([1]);
  const [shiftId, setShiftId] = useState("");
  const [zoneId, setZoneId] = useState("");
  const [staffId, setStaffId] = useState("");
  const [validFrom, setValidFrom] = useState("");
  const [validTo, setValidTo] = useState("");

  const loadData = async () => {
    setLoading(true);
    try {
      const result = await api.getScheduleTemplates();
      setTemplates(result);
    } catch (err) {
      setError(getApiError(err));
    } finally {
      setLoading(false);
    }
  };

  useEffect(() => {
    if (open) loadData();
  }, [open]);

  const handleCreate = async () => {
    if (!name.trim() || !shiftId || !zoneId || !staffId || selectedDays.length === 0) {
      setError("Vui lòng điền tên mẫu, chọn ca trực, khu vực, nhân viên và ít nhất 1 ngày trong tuần");
      return;
    }
    const duplicate = selectedDays.some((day) =>
      templates.some((t) => t.shiftId === shiftId && t.zoneId === zoneId && t.dayOfWeek === day && t.staffId === staffId)
    );
    if (duplicate) {
      setError("Nhân viên này đã có ca trực trong khung giờ/khu vực này vào ngày đã chọn");
      return;
    }
    setSaving(true);
    setError(null);
    try {
      for (const day of selectedDays) {
        await api.createScheduleTemplate({
          name: name.trim(),
          dayOfWeek: day,
          shiftId,
          zoneId,
          staffId,
          validFrom: validFrom || undefined,
          validTo: validTo || undefined,
        });
      }
      setName(""); setShiftId(""); setZoneId(""); setStaffId(""); setValidFrom(""); setValidTo("");
      setSelectedDays([1]);
      await loadData();
      onUpdated();
    } catch (err) {
      setError(getApiError(err));
    } finally {
      setSaving(false);
    }
  };

  const openDeleteConfirm = (id: string) => {
    Modal.confirm({
      title: "Xác nhận xóa",
      content: "Xóa mẫu lịch này?",
      okText: "Xóa",
      cancelText: "Hủy",
      okButtonProps: { danger: true },
      onOk: async () => {
        try {
          await api.deleteScheduleTemplate(id);
          await loadData();
          onUpdated();
        } catch (err) {
          setError(getApiError(err));
        }
      },
    });
  };

  const getStaffName = (id: string) => {
    const s = staff.find((x) => x.id === id);
    return s?.fullName || s?.email || "Nhân viên";
  };
  const getShiftName = (id: string) => shifts.find((s) => s.id === id)?.name || "Ca";
  const getZoneName = (id: string) => zones.find((z) => z.id === id)?.zoneName || "Khu vực";

  return (
    <>
      <Drawer anchor="right" open={open} onClose={onClose} sx={{ zIndex: 1300 }}>
        <Box sx={{ width: { xs: "100%", sm: 420 }, height: "100%", display: "flex", flexDirection: "column" }}>
          <Box sx={{ display: "flex", alignItems: "center", justifyContent: "space-between", px: 2, py: 1.5, borderBottom: 1, borderColor: "divider" }}>
            <Typography variant="subtitle2" color="primary" sx={{ fontWeight: 700 }}>
              Mẫu lịch tự động
            </Typography>
            <IconButton onClick={onClose} size="small">
              <CloseIcon fontSize="small" />
            </IconButton>
          </Box>

          <Box sx={{ flex: 1, overflowY: "auto", p: 2, display: "flex", flexDirection: "column", gap: 2 }}>
            {error && <Alert title={error} type="error" showIcon closable onClose={() => setError(null)} />}

            <Stack spacing={1.5}>
              <TextField
                size="small"
                placeholder="Tên mẫu (vd: Ca sáng T2-T6)"
                value={name}
                onChange={(e) => setName(e.target.value)}
                fullWidth
              />

              <Box>
                <Typography variant="caption" color="text.secondary" sx={{ display: "block", mb: 0.5 }}>Ngày trong tuần</Typography>
                <ToggleButtonGroup
                  value={selectedDays}
                  onChange={(_, v) => setSelectedDays(v)}
                  size="small"
                  sx={{ flexWrap: "wrap", gap: 0.5, "& .MuiToggleButton-root": { px: 1, py: 0.25, fontSize: "0.7rem", textTransform: "none", borderRadius: 1 } }}
                >
                  {DAYS.map((d, i) => (
                    <ToggleButton key={i} value={i}>{d}</ToggleButton>
                  ))}
                </ToggleButtonGroup>
              </Box>

              <TextField
                select
                size="small"
                label="Ca trực"
                value={shiftId}
                onChange={(e) => setShiftId(e.target.value)}
                fullWidth
              >
                <MenuItem value="">Chọn ca trực</MenuItem>
                {shifts.filter((s) => s.isActive).map((s) => (
                  <MenuItem key={s.id} value={s.id}>{s.name} ({s.startTime?.slice(0, 5)}-{s.endTime?.slice(0, 5)})</MenuItem>
                ))}
              </TextField>

              <TextField
                select
                size="small"
                label="Khu vực"
                value={zoneId}
                onChange={(e) => setZoneId(e.target.value)}
                fullWidth
              >
                <MenuItem value="">Chọn khu vực</MenuItem>
                {zones.filter((z) => z.isActive).map((z) => (
                  <MenuItem key={z.id} value={z.id}>{z.zoneName} (Tầng {z.floor})</MenuItem>
                ))}
              </TextField>

              <TextField
                select
                size="small"
                label="Nhân viên"
                value={staffId}
                onChange={(e) => setStaffId(e.target.value)}
                fullWidth
              >
                <MenuItem value="">Chọn nhân viên</MenuItem>
                {staff.map((s) => (
                  <MenuItem key={s.id} value={s.id}>{s.fullName || s.email}</MenuItem>
                ))}
              </TextField>

              <Box>
                <Typography variant="caption" color="text.secondary" sx={{ display: "block", mb: 0.5 }}>Thời hạn áp dụng</Typography>
                <Stack direction="row" spacing={0.5} sx={{ mb: 1 }}>
                  <Button
                    size="small"
                    variant={!validFrom && !validTo ? "contained" : "outlined"}
                    onClick={() => { setValidFrom(""); setValidTo(""); }}
                    sx={{ fontSize: "0.65rem", textTransform: "none" }}
                  >
                    Vô thời hạn
                  </Button>
                  <Button
                    size="small"
                    variant={validFrom && validTo && validFrom.startsWith(`${new Date().getFullYear()}-${String(new Date().getMonth() + 1).padStart(2, '0')}`) ? "contained" : "outlined"}
                    onClick={() => {
                      const now = new Date();
                      const first = new Date(now.getFullYear(), now.getMonth(), 1);
                      const last = new Date(now.getFullYear(), now.getMonth() + 1, 0);
                      setValidFrom(first.toISOString().split("T")[0]);
                      setValidTo(last.toISOString().split("T")[0]);
                    }}
                    sx={{ fontSize: "0.65rem", textTransform: "none" }}
                  >
                    Tháng này
                  </Button>
                  <Button
                    size="small"
                    variant={validFrom && validTo && validFrom.startsWith(`${new Date().getFullYear()}-${String(new Date().getMonth() + 2).padStart(2, '0')}`) ? "contained" : "outlined"}
                    onClick={() => {
                      const now = new Date();
                      const first = new Date(now.getFullYear(), now.getMonth() + 1, 1);
                      const last = new Date(now.getFullYear(), now.getMonth() + 2, 0);
                      setValidFrom(first.toISOString().split("T")[0]);
                      setValidTo(last.toISOString().split("T")[0]);
                    }}
                    sx={{ fontSize: "0.65rem", textTransform: "none" }}
                  >
                    Tháng sau
                  </Button>
                </Stack>
                <Stack direction="row" spacing={1}>
                  <TextField
                    size="small"
                    type="date"
                    label="Từ ngày"
                    value={validFrom}
                    onChange={(e) => setValidFrom(e.target.value)}
                    sx={{ flex: 1 }}
                    slotProps={{ inputLabel: { shrink: true } }}
                  />
                  <TextField
                    size="small"
                    type="date"
                    label="Đến ngày"
                    value={validTo}
                    onChange={(e) => setValidTo(e.target.value)}
                    sx={{ flex: 1 }}
                    slotProps={{ inputLabel: { shrink: true } }}
                  />
                </Stack>
              </Box>

              <Button
                fullWidth
                variant="contained"
                size="small"
                onClick={handleCreate}
                disabled={saving}
                startIcon={saving ? <CircularProgress size={14} color="inherit" /> : <AddIcon />}
              >
                {saving ? "Đang tạo..." : "Thêm mẫu"}
              </Button>
            </Stack>

            <Divider />

            <Box>
              <Typography variant="caption" color="text.secondary" sx={{ fontWeight: 600, textTransform: "uppercase", letterSpacing: 0.5 }}>
                Đã tạo ({templates.length})
              </Typography>
              {loading && <Typography variant="body2" color="text.secondary" sx={{ fontStyle: "italic", mt: 0.5 }}>Đang tải...</Typography>}
              {!loading && templates.length === 0 && (
                <Typography variant="body2" color="text.secondary" sx={{ fontStyle: "italic", mt: 0.5 }}>Chưa có mẫu nào</Typography>
              )}
              <Stack spacing={0.5} sx={{ mt: 0.5 }}>
                {templates.map((t) => (
                  <Box key={t.id} sx={{ display: "flex", alignItems: "center", justifyContent: "space-between", px: 1.5, py: 1, borderRadius: 1, bgcolor: "background.paper", border: 1, borderColor: "divider" }}>
                    <Box>
                      <Typography variant="body2" sx={{ fontWeight: 500 }}>{t.name}</Typography>
                      <Typography variant="caption" color="text.secondary">
                        {DAYS[t.dayOfWeek]} · {getShiftName(t.shiftId)} · {getZoneName(t.zoneId)}
                      </Typography>
                      <Typography variant="caption" color="text.secondary" sx={{ display: "block" }}>
                        {getStaffName(t.staffId)}
                        {t.validFrom ? ` (${t.validFrom} → ${t.validTo || "..."})` : " (Vô thời hạn)"}
                      </Typography>
                    </Box>
                    <IconButton size="small" color="error" onClick={() => openDeleteConfirm(t.id)}>
                      <DeleteIcon fontSize="small" />
                    </IconButton>
                  </Box>
                ))}
              </Stack>
            </Box>
          </Box>
        </Box>
      </Drawer>

    </>
  );
}
</file>

<file path="src/app/(dashboard)/_components/staff-schedule/TimetableGrid.tsx">
"use client";

import { useMemo } from "react";
import { Box, useTheme } from "@mui/material";
import Table from "antd/es/table";
import Badge from "antd/es/badge";
import Tooltip from "antd/es/tooltip";
import type { ColumnsType } from "antd/es/table";
import type { StaffScheduleAssignment, StaffShift } from "@/lib/types";
import TimetableCell from "./TimetableCell";

interface TimetableGridProps {
  days: Date[];
  shifts: StaffShift[];
  assignments: StaffScheduleAssignment[];
  filter: string;
  isAdmin?: boolean;
  onCellClick?: (date: string, shiftId: string) => void;
  onDeleteAssignment?: (id: string) => void;
}

const DAY_LABELS = ["T2", "T3", "T4", "T5", "T6", "T7", "CN"];

function toDateInput(date: Date) {
  const y = date.getFullYear();
  const m = String(date.getMonth() + 1).padStart(2, "0");
  const d = String(date.getDate()).padStart(2, "0");
  return `${y}-${m}-${d}`;
}

function formatDate(d: Date) {
  return `${d.getDate()}/${d.getMonth() + 1}`;
}

function isToday(d: Date) {
  const now = new Date();
  return d.getFullYear() === now.getFullYear()
    && d.getMonth() === now.getMonth()
    && d.getDate() === now.getDate();
}

interface ShiftRow {
  key: string;
  shift: StaffShift;
  cells: Record<string, StaffScheduleAssignment[]>;
}

export default function TimetableGrid({
  days, shifts, assignments, filter, isAdmin, onCellClick, onDeleteAssignment,
}: TimetableGridProps) {
  const theme = useTheme();
  const isDark = theme.palette.mode === "dark";

  const cellMap = useMemo(() => {
    const map: Record<string, StaffScheduleAssignment[]> = {};
    for (const a of assignments) {
      if (a.status === "cancelled") continue;

      if (filter === "active") {
        const now = new Date();
        const today = toDateInput(now);
        if (a.workDate !== today) continue;
        const current = `${String(now.getHours()).padStart(2, "0")}:${String(now.getMinutes()).padStart(2, "0")}`;
        const start = (a.shift?.startTime || "").slice(0, 5);
        const end = (a.shift?.endTime || "").slice(0, 5);
        if (!(start && end && current >= start && current <= end)) continue;
      }
      if (filter === "future" && a.workDate <= toDateInput(new Date())) continue;
      if (filter === "past" && a.workDate >= toDateInput(new Date())) continue;

      const key = `${a.shiftId}:${a.workDate}`;
      if (!map[key]) map[key] = [];
      map[key].push(a);
    }
    return map;
  }, [assignments, filter]);

  const dayCounts = useMemo(() => {
    const counts: Record<string, number> = {};
    for (const a of assignments) {
      if (a.status === "cancelled") continue;
      counts[a.workDate] = (counts[a.workDate] || 0) + 1;
    }
    return counts;
  }, [assignments]);

  const dataSource: ShiftRow[] = useMemo(() =>
    shifts.map((shift) => ({
      key: shift.id,
      shift,
      cells: Object.fromEntries(
        days.map((d) => [toDateInput(d), cellMap[`${shift.id}:${toDateInput(d)}`] || []])
      ),
    })),
    [shifts, days, cellMap]
  );

  const columns: ColumnsType<ShiftRow> = useMemo(() => {
    const shiftCol: ColumnsType<ShiftRow>[number] = {
      title: "Ca / Ngày",
      dataIndex: "shift",
      key: "shift",
      fixed: "left",
      width: 160,
      render: (_: any, row: ShiftRow) => (
        <Tooltip title={`${row.shift.name}: ${row.shift.startTime?.slice(0, 5)} – ${row.shift.endTime?.slice(0, 5)}${row.shift.minStaff ? ` (tối thiểu ${row.shift.minStaff} nhân viên)` : ""}`} placement="right">
          <div>
            <div style={{ fontWeight: 700, fontSize: "0.78rem", color: theme.palette.primary.main }}>
              {row.shift.name}
            </div>
            <div style={{ fontSize: "0.68rem", color: theme.palette.text.secondary, marginTop: 2 }}>
              {row.shift.startTime?.slice(0, 5)} – {row.shift.endTime?.slice(0, 5)}
            </div>
          </div>
        </Tooltip>
      ),
    };

    const dayCols: ColumnsType<ShiftRow> = days.map((d, i) => {
      const dateStr = toDateInput(d);
      const count = dayCounts[dateStr] || 0;
      const today = isToday(d);
      return {
        title: (
          <div style={{ textAlign: "center" }}>
            <Badge count={count} size="small" offset={[0, 0]}>
              <span style={{ fontWeight: 700, fontSize: "0.75rem", color: today ? theme.palette.primary.main : theme.palette.text.primary }}>
                {DAY_LABELS[i]}
              </span>
            </Badge>
            <div style={{ fontSize: "0.65rem", marginTop: 2, color: today ? theme.palette.primary.light : theme.palette.text.secondary }}>
              {formatDate(d)}
            </div>
          </div>
        ),
        dataIndex: "cells",
        key: dateStr,
        width: 140,
        render: (_: any, row: ShiftRow) => {
          const cellAssignments = row.cells[dateStr] || [];
          return (
            <TimetableCell
              assignments={cellAssignments}
              date={dateStr}
              shiftId={row.shift.id}
              isAdmin={isAdmin}
              onCellClick={onCellClick}
              onDeleteAssignment={onDeleteAssignment}
              shift={row.shift}
            />
          );
        },
        onCell: () => ({
          style: {
            background: today
              ? isDark ? "rgba(99,102,241,0.06)" : "rgba(99,102,241,0.03)"
              : undefined,
          },
        }),
      };
    });

    return [shiftCol, ...dayCols];
  }, [days, dayCounts, isAdmin, onCellClick, onDeleteAssignment, theme, isDark]);

  return (
    <Box sx={{
      width: "100%",
      overflowX: "auto",
      border: `1px solid ${theme.palette.divider}`,
      borderRadius: 1,
      "& .ant-table": {
        background: theme.palette.background.paper,
      },
      "& .ant-table-thead > tr > th": {
        background: isDark ? "rgba(99,102,241,0.08)" : theme.palette.action.hover,
        fontWeight: 700,
        fontSize: "0.75rem",
        color: theme.palette.text.primary,
        borderBottom: `1px solid ${theme.palette.divider}`,
      },
      "& .ant-table-tbody > tr > td": {
        borderBottom: `1px solid ${theme.palette.divider}`,
        background: theme.palette.background.paper,
        color: theme.palette.text.primary,
      },
      "& .ant-table-tbody > tr:hover > td": {
        background: isDark ? "rgba(99,102,241,0.04)" : "rgba(99,102,241,0.02)",
      },
      "& .ant-table-cell": {
        padding: "8px",
      },
      "& .ant-table-fixed-left": {
        "& .ant-table-thead > tr > th": {
          background: isDark ? "rgba(99,102,241,0.12)" : "rgba(99,102,241,0.06)",
        },
        "& .ant-table-tbody > tr > td": {
