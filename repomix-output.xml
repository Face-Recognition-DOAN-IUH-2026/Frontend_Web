    --chat--color--primary: #8B0000;
    --chat--color--primary-shade-50: #700000;
    --chat--color--primary--shade-100: #550000;
    --chat--color--secondary: #D4AF37;
    --chat--color-secondary-shade-50: #B38E22;
    --chat--color-white: #ffffff;
    --chat--color-light: #F0F6FB;
    --chat--color-light-shade-50: #E8EEF5;
    --chat--color-light-shade-100: #DEE2E6;
    --chat--color-medium: #94A3B8;
    --chat--color-dark: #0A2540;
    --chat--color-disabled: #94A3B8;
    --chat--color-typing: #8B0000;

    /* Font */
    --chat--font-family: 'Source Sans 3', sans-serif;
    --chat--font-family--monospace: 'JetBrains Mono', monospace;

    /* Window */
    --chat--window--width: 400px;
