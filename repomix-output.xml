                >
                  {book.title}
                </Typography>
                {book.subtitle && (
                  <Typography variant="h6" color="text.secondary" sx={{ fontStyle: "italic", mb: 1.5 }}>
                    {book.subtitle}
                  </Typography>
                )}
                {book.author && (
                  <Stack direction="row" spacing={1} sx={{ alignItems: "center" }}>
                    <Typography variant="body1" color="text.secondary">
