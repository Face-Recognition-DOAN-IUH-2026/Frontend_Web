      .mockResolvedValueOnce({
        task_id: "error-task",
        status: "PENDING",
        result: null,
      })
      .mockResolvedValueOnce({
        task_id: "error-task",
        status: "FAILURE",
        result: { error: "LOW_QUALITY" },
      });

    render(<JobPoll jobId="error-task" onError={onError} />);

    await waitFor(() => {
      expect(onError).toHaveBeenCalledWith("LOW_QUALITY");
    });
  });

  it("handles NULL confidence edge case", async () => {
    mockApi.getTaskStatus
      .mockResolvedValueOnce({
        task_id: "null-task",
        status: "PENDING",
        result: null,
      })
      .mockResolvedValueOnce({
        task_id: "null-task",
        status: "SUCCESS",
        result: {
          status: "success",
          is_live: null,
          score: 0,
          confidence: 0,
        },
      });

    render(<JobPoll jobId="null-task" />);

    await waitFor(() => {
      expect(screen.getByText("Thành công")).toBeInTheDocument();
    });
  });

  it("handles empty result object", async () => {
    mockApi.getTaskStatus
      .mockResolvedValueOnce({
        task_id: "empty-task",
        status: "PENDING",
        result: null,
      })
      .mockResolvedValueOnce({
        task_id: "empty-task",
        status: "SUCCESS",
        result: {},
      });

    render(<JobPoll jobId="empty-task" />);

    await waitFor(() => {
      expect(screen.getByText("Thành công")).toBeInTheDocument();
    });
  });

  it("handles is_live false (spoof detected)", async () => {
    mockApi.getTaskStatus
      .mockResolvedValueOnce({
