<file path="src/app/login/_components/ForcePasswordChangeDialog.tsx">
"use client";

import React, { useState } from "react";
import {
  Dialog,
  DialogTitle,
  DialogContent,
  DialogActions,
  TextField,
  Button,
  Typography,
  Alert,
  Stack,
  Box,
  InputAdornment,
  IconButton,
  CircularProgress,
} from "@mui/material";
import LockResetIcon from "@mui/icons-material/LockReset";
import Visibility from "@mui/icons-material/Visibility";
import VisibilityOff from "@mui/icons-material/VisibilityOff";
import SecurityIcon from "@mui/icons-material/Security";
import api, { getErrorMessage } from "@/lib/api-client";

interface ForcePasswordChangeDialogProps {
  open: boolean;
  initialOldPassword?: string;
  onSuccess: () => void;
}

export default function ForcePasswordChangeDialog({
  open,
  initialOldPassword = "",
  onSuccess,
}: ForcePasswordChangeDialogProps) {
  const [oldPassword, setOldPassword] = useState(initialOldPassword);
  const [newPassword, setNewPassword] = useState("");
  const [confirmPassword, setConfirmPassword] = useState("");
  const [showOld, setShowOld] = useState(false);
  const [showNew, setShowNew] = useState(false);
  const [error, setError] = useState("");
  const [submitting, setSubmitting] = useState(false);

  // Sync if initialOldPassword changes
  React.useEffect(() => {
    if (initialOldPassword) {
      setOldPassword(initialOldPassword);
    }
  }, [initialOldPassword]);

  const handleSubmit = async (e: React.FormEvent) => {
    e.preventDefault();
    setError("");

    if (!oldPassword) {
      setError("Vui lòng nhập mật khẩu hiện tại");
      return;
    }
    if (newPassword.length < 8) {
      setError("Mật khẩu mới phải có ít nhất 8 ký tự");
      return;
    }
    if (newPassword === oldPassword) {
      setError("Mật khẩu mới không được trùng với mật khẩu cũ");
      return;
    }
    const hasLower = /[a-z]/.test(newPassword);
    const hasUpper = /[A-Z]/.test(newPassword);
    const hasDigit = /[0-9]/.test(newPassword);
    if (!hasLower || !hasUpper || !hasDigit) {
      setError("Mật khẩu phải chứa ít nhất 1 chữ hoa, 1 chữ thường và 1 chữ số");
      return;
    }
    if (newPassword !== confirmPassword) {
      setError("Xác nhận mật khẩu mới không khớp");
      return;
    }

    setSubmitting(true);
    try {
      await api.changePassword({
        old_password: oldPassword,
        new_password: newPassword,
      });
      onSuccess();
    } catch (err: any) {
      setError(getErrorMessage(err) || "Đổi mật khẩu thất bại. Vui lòng thử lại.");
    } finally {
      setSubmitting(false);
    }
  };

  return (
    <Dialog
      open={open}
      maxWidth="xs"
      fullWidth
      slotProps={{
        backdrop: {
          sx: { backdropFilter: "blur(4px)", backgroundColor: "rgba(10, 37, 64, 0.6)" },
        },
        paper: {
          sx: {
            borderRadius: 3,
            p: 1,
            boxShadow: "0 20px 40px rgba(0,0,0,0.25)",
          },
        },
      }}
    >
      <form onSubmit={handleSubmit}>
        <DialogTitle sx={{ pb: 1 }}>
          <Stack direction="row" spacing={1.5} sx={{ alignItems: "center" }}>
            <Box
              sx={{
                width: 44,
                height: 44,
                borderRadius: 2,
                bgcolor: "warning.lighter",
                color: "warning.main",
                display: "flex",
                alignItems: "center",
                justifyContent: "center",
              }}
            >
              <LockResetIcon sx={{ fontSize: 28 }} />
            </Box>
            <Box>
              <Typography variant="h6" sx={{ fontWeight: 700, lineHeight: 1.2 }}>
                Đổi mật khẩu lần đầu
              </Typography>
              <Typography variant="caption" color="text.secondary">
                Bắt buộc để kích hoạt và bảo mật tài khoản
              </Typography>
            </Box>
          </Stack>
        </DialogTitle>

        <DialogContent sx={{ pt: 1.5 }}>
          <Alert severity="warning" icon={<SecurityIcon />} sx={{ mb: 2.5, borderRadius: 2 }}>
            Tài khoản của bạn được khởi tạo với mật khẩu tự động mặc định. Vui lòng thiết lập mật khẩu mới trước khi tiếp tục.
          </Alert>

          {error && (
            <Alert severity="error" sx={{ mb: 2, borderRadius: 2 }}>
              {error}
            </Alert>
          )}

          <Stack spacing={2}>
            <TextField
              label="Mật khẩu hiện tại"
              type={showOld ? "text" : "password"}
              fullWidth
              size="small"
              value={oldPassword}
              onChange={(e) => setOldPassword(e.target.value)}
              required
              slotProps={{
                input: {
                  endAdornment: (
                    <InputAdornment position="end">
                      <IconButton size="small" onClick={() => setShowOld(!showOld)} edge="end">
                        {showOld ? <VisibilityOff fontSize="small" /> : <Visibility fontSize="small" />}
                      </IconButton>
                    </InputAdornment>
                  ),
                },
              }}
            />

            <TextField
              label="Mật khẩu mới"
              type={showNew ? "text" : "password"}
              fullWidth
              size="small"
              value={newPassword}
              onChange={(e) => setNewPassword(e.target.value)}
              helperText="Tối thiểu 8 ký tự, bao gồm chữ hoa, chữ thường và chữ số"
              required
              slotProps={{
                input: {
                  endAdornment: (
                    <InputAdornment position="end">
                      <IconButton size="small" onClick={() => setShowNew(!showNew)} edge="end">
                        {showNew ? <VisibilityOff fontSize="small" /> : <Visibility fontSize="small" />}
                      </IconButton>
                    </InputAdornment>
                  ),
                },
              }}
            />

            <TextField
              label="Xác nhận mật khẩu mới"
              type={showNew ? "text" : "password"}
              fullWidth
              size="small"
              value={confirmPassword}
              onChange={(e) => setConfirmPassword(e.target.value)}
              required
            />
          </Stack>
        </DialogContent>

        <DialogActions sx={{ px: 3, pb: 2.5, pt: 1 }}>
          <Button
            type="submit"
            variant="contained"
            fullWidth
            disabled={submitting}
            startIcon={submitting ? <CircularProgress size={18} color="inherit" /> : <LockResetIcon />}
            sx={{
              py: 1.2,
              fontWeight: 700,
              textTransform: "none",
              borderRadius: 2,
              background: "linear-gradient(135deg, #0B4378 0%, #0F3C5C 100%)",
            }}
          >
            {submitting ? "Đang cập nhật..." : "Cập nhật mật khẩu & Tiếp tục"}
          </Button>
        </DialogActions>
      </form>
    </Dialog>
  );
}
</file>

<file path="src/app/login/_components/ForgotPasswordDialog.tsx">
"use client";

import { useEffect, useState } from "react";
import {
  Box,
  Button,
  Dialog,
  DialogContent,
  IconButton,
  InputAdornment,
  Stack,
  TextField,
  Typography,
} from "@mui/material";
import CloseIcon from "@mui/icons-material/Close";
import CheckCircleOutlineOutlinedIcon from "@mui/icons-material/CheckCircleOutlineOutlined";
import EmailOutlinedIcon from "@mui/icons-material/EmailOutlined";
import ShieldOutlinedIcon from "@mui/icons-material/ShieldOutlined";
import LockOutlinedIcon from "@mui/icons-material/LockOutlined";
import ArrowBackIcon from "@mui/icons-material/ArrowBack";
import VisibilityIcon from "@mui/icons-material/Visibility";
import VisibilityOffIcon from "@mui/icons-material/VisibilityOff";
import api, { getErrorMessage } from "@/lib/api-client";

interface ForgotPasswordDialogProps {
  open: boolean;
  onClose: () => void;
}

export default function ForgotPasswordDialog({
  open,
  onClose,
}: ForgotPasswordDialogProps) {
  const [forgotStep, setForgotStep] = useState<1 | 2 | 3 | 4>(1);
  const [forgotEmail, setForgotEmail] = useState("");
  const [forgotCode, setForgotCode] = useState("");
  const [forgotPassword, setForgotPassword] = useState("");
  const [forgotConfirmPassword, setForgotConfirmPassword] = useState("");
  const [forgotLoading, setForgotLoading] = useState(false);
  const [forgotError, setForgotError] = useState("");
  const [showForgotPassword, setShowForgotPassword] = useState(false);
  const [resendCooldown, setResendCooldown] = useState(0);

  useEffect(() => {
    if (resendCooldown > 0) {
      const timer = setTimeout(() => setResendCooldown((prev) => prev - 1), 1000);
      return () => clearTimeout(timer);
    }
  }, [resendCooldown]);

  const handleClose = () => {
    onClose();
    setForgotStep(1);
    setForgotEmail("");
    setForgotCode("");
    setForgotPassword("");
    setForgotConfirmPassword("");
    setForgotError("");
    setShowForgotPassword(false);
  };

  const handleForgotSendCode = async () => {
    if (!forgotEmail) {
      setForgotError("Vui lòng nhập email");
      return;
    }
    setForgotLoading(true);
    setForgotError("");
    try {
      await api.forgotPassword(forgotEmail);
      setForgotStep(2);
      setResendCooldown(60);
    } catch (err: any) {
      setForgotError(getErrorMessage(err) || "Không thể gửi mã reset");
    } finally {
      setForgotLoading(false);
    }
  };

  const handleVerifyCode = async () => {
    if (!forgotCode || forgotCode.length !== 6) {
      setForgotError("Vui lòng nhập đầy đủ 6 chữ số mã xác minh");
      return;
    }
    setForgotLoading(true);
    setForgotError("");
    try {
      await api.verifyResetCode(forgotEmail, forgotCode);
      setForgotStep(3);
    } catch (err: any) {
      setForgotError(getErrorMessage(err) || "Mã xác minh không hợp lệ");
    } finally {
      setForgotLoading(false);
    }
  };

  const handleForgotReset = async () => {
    if (!forgotPassword || !forgotConfirmPassword) {
      setForgotError("Vui lòng nhập mật khẩu mới");
      return;
    }
    if (forgotPassword !== forgotConfirmPassword) {
      setForgotError("Mật khẩu mới không khớp");
      return;
    }
    if (forgotPassword.length < 6) {
      setForgotError("Mật khẩu phải ít nhất 6 ký tự");
      return;
    }
    setForgotLoading(true);
    setForgotError("");
    try {
      await api.resetPassword(forgotEmail, forgotCode, forgotPassword);
      setForgotStep(4);
      setTimeout(() => {
        handleClose();
      }, 2000);
    } catch (err: any) {
      setForgotError(getErrorMessage(err) || "Đặt lại mật khẩu thất bại");
    } finally {
      setForgotLoading(false);
    }
  };

  return (
    <Dialog
      open={open}
      onClose={handleClose}
      maxWidth="xs"
      fullWidth
      slotProps={{ paper: { sx: { borderRadius: 3.5, p: 0.5 } } }}
    >
      <DialogContent sx={{ p: 3, pt: "20px !important" }}>
        {/* Header */}
        <Box sx={{ display: "flex", justifyContent: "space-between", alignItems: "center", mb: 1 }}>
          <Typography variant="h6" sx={{ fontWeight: 800, fontFamily: "Space Grotesk, sans-serif" }}>
            {forgotStep === 4 ? "Thành công" : "Quên mật khẩu"}
          </Typography>
          <IconButton onClick={handleClose} size="small" sx={{ color: "text.secondary" }}>
            <CloseIcon />
          </IconButton>
        </Box>

        {/* Step Indicator - Dot style */}
        {forgotStep < 4 && (
          <Box sx={{ display: "flex", justifyContent: "center", alignItems: "center", mb: 3, mt: 1.5 }}>
            {[1, 2, 3].map((s) => (
              <Box key={s} sx={{ display: "flex", alignItems: "center" }}>
                <Box
                  sx={{
                    width: forgotStep === s ? 32 : 10,
                    height: 8,
                    borderRadius: 4,
                    bgcolor: forgotStep >= s ? "primary.main" : "action.hover",
                    transition: "all 0.3s ease",
                  }}
                />
                {s < 3 && (
                  <Box
                    sx={{
                      width: 24,
                      height: 2,
                      mx: 0.5,
                      bgcolor: forgotStep > s ? "primary.main" : "action.hover",
                      transition: "background-color 0.3s ease",
                    }}
                  />
                )}
              </Box>
            ))}
          </Box>
        )}

        {/* Error Message */}
        {forgotError && (
          <Box
            sx={{
              display: "flex",
              alignItems: "center",
              gap: 1,
              p: 1.5,
              borderRadius: 2,
              mb: 2,
              bgcolor: "error.light",
              color: "error.contrastText",
            }}
          >
            <CheckCircleOutlineOutlinedIcon sx={{ fontSize: 20, color: "error.main" }} />
            <Typography variant="body2" sx={{ fontWeight: 600 }}>{forgotError}</Typography>
          </Box>
        )}

        {forgotStep === 1 && (
          <Stack spacing={2.5}>
            <Box sx={{ textAlign: "center", mb: 0.5 }}>
              <Box
                sx={{
                  width: 64,
                  height: 64,
                  borderRadius: "50%",
                  mx: "auto",
                  mb: 2,
                  bgcolor: "action.hover",
                  display: "grid",
                  placeItems: "center",
                }}
              >
                <EmailOutlinedIcon sx={{ fontSize: 32, color: "primary.main" }} />
              </Box>
              <Typography variant="body2" color="text.secondary">
                Nhập email đã đăng ký để nhận mã xác minh.
              </Typography>
            </Box>
            <TextField
              label="Email"
              type="email"
              value={forgotEmail}
              onChange={(e) => setForgotEmail(e.target.value)}
              fullWidth
              autoFocus
              slotProps={{
                input: {
                  startAdornment: (
                    <InputAdornment position="start">
                      <EmailOutlinedIcon sx={{ fontSize: 20, color: "text.secondary" }} />
                    </InputAdornment>
                  ),
                  sx: { borderRadius: 2.5 },
                },
              }}
            />
            <Button
              variant="contained"
              onClick={handleForgotSendCode}
              disabled={forgotLoading || !forgotEmail}
              fullWidth
              size="large"
              sx={{
                py: 1.35,
                fontWeight: 700,
                borderRadius: 2.5,
                boxShadow: "0 4px 14px rgba(139, 0, 0, 0.25)",
              }}
            >
              {forgotLoading ? "Đang gửi..." : "Gửi mã xác minh"}
            </Button>
          </Stack>
        )}

        {forgotStep === 2 && (
          <Stack spacing={2}>
            <Box sx={{ textAlign: "center", mb: 1 }}>
              <Box
                sx={{
                  width: 64,
                  height: 64,
                  borderRadius: "50%",
                  mx: "auto",
                  mb: 2,
                  bgcolor: "action.hover",
                  display: "grid",
                  placeItems: "center",
                }}
              >
                <ShieldOutlinedIcon sx={{ fontSize: 32, color: "primary.main" }} />
              </Box>
              <Typography variant="body2" color="text.secondary">Nhập mã 6 chữ số đã gửi đến</Typography>
              <Typography variant="body2" sx={{ fontWeight: 700, mt: 0.5 }}>{forgotEmail}</Typography>
            </Box>
            <Box sx={{ display: "flex", gap: 1.5, justifyContent: "center" }}>
              {[0, 1, 2, 3, 4, 5].map((i) => (
                <TextField
                  key={i}
                  id={`code-${i}`}
                  value={forgotCode[i] || ""}
                  onChange={(e) => {
                    const val = e.target.value.replace(/\D/g, "");
                    if (val.length > 1) return;
                    const newCode = forgotCode.split("");
                    newCode[i] = val;
                    const code = newCode.join("").slice(0, 6);
                    setForgotCode(code);
                    if (val && i < 5) {
                      setTimeout(() => document.getElementById(`code-${i + 1}`)?.focus(), 10);
                    }
                  }}
                  onKeyDown={(e) => {
                    if (e.key === "Backspace" && !forgotCode[i] && i > 0) {
                      setTimeout(() => document.getElementById(`code-${i - 1}`)?.focus(), 10);
                    }
                  }}
                  slotProps={{
                    htmlInput: {
                      maxLength: 1,
                      style: { textAlign: "center", fontSize: "1.5rem", fontWeight: 700, width: 48, height: 48, padding: 0 },
                    },
                  }}
                  sx={{
                    "& fieldset": {
                      borderRadius: 2,
                      borderWidth: forgotCode[i] ? 2 : 1,
                      borderColor: forgotCode[i] ? "primary.main" : "divider",
                    },
                    transition: "all 0.2s ease",
                    bgcolor: forgotCode[i] ? "action.selected" : "transparent",
                  }}
                />
              ))}
            </Box>
            <Button
              variant="contained"
              onClick={handleVerifyCode}
              disabled={forgotLoading || forgotCode.length !== 6}
              fullWidth
              size="large"
              sx={{
                py: 1.35,
                fontWeight: 700,
                borderRadius: 2.5,
                boxShadow: "0 4px 14px rgba(139, 0, 0, 0.25)",
              }}
            >
              {forgotLoading ? "Đang xác minh..." : "Xác minh mã"}
            </Button>
            <Box sx={{ display: "flex", justifyContent: "space-between", alignItems: "center" }}>
              <Button
                variant="text"
                size="small"
                startIcon={<ArrowBackIcon />}
                onClick={() => { setForgotStep(1); setForgotCode(""); setForgotError(""); }}
                sx={{ textTransform: "none", fontWeight: 600, color: "text.secondary" }}
              >
                Quay lại
              </Button>
              <Button
                variant="text"
                size="small"
                onClick={handleForgotSendCode}
                disabled={forgotLoading || resendCooldown > 0}
                sx={{ textTransform: "none", fontWeight: 600 }}
              >
                {resendCooldown > 0 ? `Gửi lại (${resendCooldown}s)` : "Gửi lại mã"}
              </Button>
            </Box>
          </Stack>
        )}

        {forgotStep === 3 && (
          <Stack spacing={2.5}>
            <Box sx={{ textAlign: "center", mb: 0.5 }}>
              <Box
                sx={{
                  width: 64,
                  height: 64,
                  borderRadius: "50%",
                  mx: "auto",
                  mb: 2,
                  bgcolor: "action.hover",
                  display: "grid",
                  placeItems: "center",
                }}
              >
                <LockOutlinedIcon sx={{ fontSize: 32, color: "primary.main" }} />
              </Box>
              <Typography variant="body2" color="text.secondary">Tạo mật khẩu mới cho tài khoản của bạn.</Typography>
            </Box>
            <TextField
              label="Mật khẩu mới"
              type={showForgotPassword ? "text" : "password"}
              value={forgotPassword}
              onChange={(e) => setForgotPassword(e.target.value)}
              fullWidth
              autoFocus
              slotProps={{
                input: {
                  startAdornment: (
                    <InputAdornment position="start">
                      <LockOutlinedIcon sx={{ fontSize: 20, color: "text.secondary" }} />
                    </InputAdornment>
                  ),
                  endAdornment: (
                    <InputAdornment position="end">
                      <IconButton
                        onClick={() => setShowForgotPassword(!showForgotPassword)}
                        edge="end"
                        size="small"
                      >
                        {showForgotPassword ? <VisibilityOffIcon sx={{ fontSize: 20 }} /> : <VisibilityIcon sx={{ fontSize: 20 }} />}
                      </IconButton>
                    </InputAdornment>
                  ),
                  sx: { borderRadius: 2.5 },
                },
              }}
            />
            <TextField
              label="Xác nhận mật khẩu mới"
              type={showForgotPassword ? "text" : "password"}
              value={forgotConfirmPassword}
              onChange={(e) => setForgotConfirmPassword(e.target.value)}
              fullWidth
              error={forgotConfirmPassword.length > 0 && forgotPassword !== forgotConfirmPassword}
              helperText={forgotConfirmPassword.length > 0 && forgotPassword !== forgotConfirmPassword ? "Mật khẩu không khớp" : ""}
              slotProps={{
                input: {
                  startAdornment: (
                    <InputAdornment position="start">
                      <LockOutlinedIcon sx={{ fontSize: 20, color: "text.secondary" }} />
                    </InputAdornment>
                  ),
                  sx: { borderRadius: 2.5 },
                },
              }}
            />
            <Button
              variant="contained"
              onClick={handleForgotReset}
              disabled={forgotLoading || !forgotPassword || !forgotConfirmPassword}
              fullWidth
              size="large"
              sx={{
                py: 1.35,
                fontWeight: 700,
                borderRadius: 2.5,
                boxShadow: "0 4px 14px rgba(139, 0, 0, 0.25)",
              }}
            >
              {forgotLoading ? "Đang xử lý..." : "Đặt lại mật khẩu"}
            </Button>
            <Button
              variant="text"
              size="small"
              startIcon={<ArrowBackIcon />}
              onClick={() => { setForgotStep(2); setForgotError(""); setForgotPassword(""); setForgotConfirmPassword(""); }}
              sx={{ textTransform: "none", fontWeight: 600, color: "text.secondary" }}
            >
              Quay lại
            </Button>
          </Stack>
        )}

        {forgotStep === 4 && (
          <Stack spacing={2} sx={{ alignItems: "center", py: 3 }}>
            <Box
              sx={{
                width: 80,
                height: 80,
                borderRadius: "50%",
                bgcolor: "success.light",
                display: "grid",
                placeItems: "center",
                animation: "scaleIn 0.3s ease-out",
                "@keyframes scaleIn": {
                  "0%": { transform: "scale(0)", opacity: 0 },
                  "100%": { transform: "scale(1)", opacity: 1 },
                },
              }}
            >
              <CheckCircleOutlineOutlinedIcon sx={{ fontSize: 48, color: "success.main" }} />
            </Box>
            <Typography variant="h6" sx={{ fontWeight: 700 }}>Đặt lại mật khẩu thành công!</Typography>
            <Typography variant="body2" color="text.secondary" sx={{ textAlign: "center" }}>
              Bạn có thể đăng nhập bằng mật khẩu mới ngay bây giờ.
            </Typography>
            <Button
              variant="contained"
              onClick={handleClose}
              fullWidth
              size="large"
              sx={{ mt: 1, py: 1.5, fontWeight: 700 }}
            >
              Quay lại đăng nhập
            </Button>
          </Stack>
        )}
      </DialogContent>
    </Dialog>
  );
}
</file>

<file path="src/app/login/_components/LoginFormFace.tsx">
"use client";

import { useCallback, useEffect, useRef, useState } from "react";
import {
  Box,
  Button,
  CircularProgress,
  Paper,
  Stack,
  Typography,
  alpha,
  useTheme,
} from "@mui/material";
import FaceRetouchingNaturalOutlinedIcon from "@mui/icons-material/FaceRetouchingNaturalOutlined";
import PhotoCameraOutlinedIcon from "@mui/icons-material/PhotoCameraOutlined";
import VideocamOffOutlinedIcon from "@mui/icons-material/VideocamOffOutlined";
import RefreshOutlinedIcon from "@mui/icons-material/RefreshOutlined";
import VerifiedUserOutlinedIcon from "@mui/icons-material/VerifiedUserOutlined";
import WbIncandescentOutlinedIcon from "@mui/icons-material/WbIncandescentOutlined";
import CameraFallback from "@/app/_components/CameraFallback";

interface LoginFormFaceProps {
  onFaceLogin: (file: File) => Promise<void>;
  isLoading: boolean;
  onSwitchToPassword: (prefillEmail?: string) => void;
  setError: (err: string) => void;
}

export default function LoginFormFace({
  onFaceLogin,
  isLoading,
  onSwitchToPassword,
  setError,
}: LoginFormFaceProps) {
  const theme = useTheme();
  const [imagePreview, setImagePreview] = useState<string | null>(null);
  const [isCameraOn, setIsCameraOn] = useState(false);
  const [cameraReady, setCameraReady] = useState(false);
  const [showFaceFallback, setShowFaceFallback] = useState(false);
  const [countdownProgress, setCountdownProgress] = useState(100);

  const videoRef = useRef<HTMLVideoElement>(null);
  const streamRef = useRef<MediaStream | null>(null);
  const readyTimeoutRef = useRef<ReturnType<typeof setTimeout> | null>(null);
  const countdownIntervalRef = useRef<ReturnType<typeof setInterval> | null>(null);
  const frameCaptureRef = useRef<ReturnType<typeof setInterval> | null>(null);
  const lastFaceFrameRef = useRef<string | null>(null);
  const hasFaceCameraWorkedRef = useRef(false);

  const stopCamera = useCallback(() => {
    if (countdownIntervalRef.current) {
      clearInterval(countdownIntervalRef.current);
      countdownIntervalRef.current = null;
    }
    if (frameCaptureRef.current) {
      clearInterval(frameCaptureRef.current);
      frameCaptureRef.current = null;
    }
    if (streamRef.current) {
      streamRef.current.getTracks().forEach((track) => track.stop());
      streamRef.current = null;
    }
    setIsCameraOn(false);
    setCameraReady(false);
    setCountdownProgress(100);
  }, []);

  const resetFaceState = () => {
    setImagePreview(null);
    setShowFaceFallback(false);
    setCountdownProgress(100);
  };

  const startCamera = useCallback(async () => {
    try {
      setError("");
      setShowFaceFallback(false);
      setCameraReady(false);
      stopCamera();
      const stream = await navigator.mediaDevices.getUserMedia({
        video: {
          facingMode: "user",
          width: { ideal: 1280, min: 640 },
          height: { ideal: 720, min: 480 },
        },
        audio: false,
      });
      streamRef.current = stream;
      setIsCameraOn(true);
    } catch (err: any) {
      if (err.name === "NotAllowedError") {
        setError("Không có quyền truy cập camera. Vui lòng cấp quyền trong cài đặt trình duyệt.");
      } else if (err.name === "NotFoundError") {
        setError("Không tìm thấy camera trên thiết bị này.");
      } else {
        setError("Không thể khởi động camera.");
      }
      setIsCameraOn(false);
      setShowFaceFallback(true);
    }
  }, [stopCamera, setError]);

  // Video stream initialization
  useEffect(() => {
    if (!isCameraOn || !videoRef.current || !streamRef.current) return;
    const video = videoRef.current;
    const onReady = () => {
      setCameraReady(true);
      hasFaceCameraWorkedRef.current = true;
    };
    video.onloadedmetadata = onReady;
    video.onplaying = onReady;
    video.onerror = () => {
      setError("Camera gặp sự cố phát hình ảnh.");
      setShowFaceFallback(true);
    };
    video.srcObject = streamRef.current;
    if (video.readyState >= 2) {
      onReady();
      hasFaceCameraWorkedRef.current = true;
    }
    readyTimeoutRef.current = setTimeout(() => {
      setCameraReady(true);
      hasFaceCameraWorkedRef.current = true;
    }, 2500);

    return () => {
      if (readyTimeoutRef.current) clearTimeout(readyTimeoutRef.current);
      video.onloadedmetadata = null;
      video.onplaying = null;
      video.onerror = null;
      video.srcObject = null;
    };
  }, [isCameraOn, setError]);

  // Periodic frame capture for fallback preview
  useEffect(() => {
    if (!isCameraOn || !cameraReady || !videoRef.current) return;
    frameCaptureRef.current = setInterval(() => {
      const video = videoRef.current;
      if (!video || video.videoWidth === 0 || !streamRef.current) return;
      try {
        const canvas = document.createElement("canvas");
        canvas.width = video.videoWidth;
        canvas.height = video.videoHeight;
        const ctx = canvas.getContext("2d");
        if (!ctx) return;
        ctx.drawImage(video, 0, 0);
        lastFaceFrameRef.current = canvas.toDataURL("image/jpeg", 0.3);
      } catch {
        lastFaceFrameRef.current = null;
      }
    }, 2000);
    return () => {
      if (frameCaptureRef.current) clearInterval(frameCaptureRef.current);
    };
  }, [isCameraOn, cameraReady]);

  // Clean-up on unmount
  useEffect(() => () => stopCamera(), [stopCamera]);

  const capturePhoto = useCallback((callback?: (file: File) => void) => {
    const video = videoRef.current;
    if (!video || !cameraReady || video.videoWidth === 0 || video.videoHeight === 0) return;
    const canvas = document.createElement("canvas");
    canvas.width = video.videoWidth;
    canvas.height = video.videoHeight;
    const ctx = canvas.getContext("2d");
    if (!ctx) return;
    ctx.drawImage(video, 0, 0);
    canvas.toBlob((blob) => {
      if (!blob) return;
      const file = new File([blob], "face.jpg", { type: "image/jpeg" });
      setImagePreview(canvas.toDataURL("image/jpeg"));
      callback?.(file);
    }, "image/jpeg", 0.92);
  }, [cameraReady]);

  const executeFaceLogin = useCallback(() => {
    capturePhoto((file) => {
      stopCamera();
      onFaceLogin(file).catch(() => {
        resetFaceState();
      });
    });
  }, [capturePhoto, onFaceLogin, stopCamera]);

  // Auto-capture with smooth visual countdown (2.4s)
  useEffect(() => {
    if (cameraReady && !imagePreview && !isLoading) {
      const TOTAL_STEPS = 24;
      const STEP_TIME = 100; // 24 * 100ms = 2400ms
      let currentStep = TOTAL_STEPS;
      setCountdownProgress(100);

      countdownIntervalRef.current = setInterval(() => {
        currentStep -= 1;
        setCountdownProgress((currentStep / TOTAL_STEPS) * 100);
        if (currentStep <= 0) {
          if (countdownIntervalRef.current) clearInterval(countdownIntervalRef.current);
          countdownIntervalRef.current = null;
          executeFaceLogin();
        }
      }, STEP_TIME);
    }

    return () => {
      if (countdownIntervalRef.current) {
        clearInterval(countdownIntervalRef.current);
        countdownIntervalRef.current = null;
      }
    };
  }, [cameraReady, imagePreview, isLoading, executeFaceLogin]);

  return (
    <Stack spacing={2.5}>
      <Paper
        variant="outlined"
        sx={{
          aspectRatio: "4 / 3",
          overflow: "hidden",
          bgcolor: isCameraOn || imagePreview ? "#07111E" : (theme.palette.mode === "dark" ? "background.paper" : "#F8FAFC"),
          display: "grid",
          placeItems: "center",
          position: "relative",
          borderRadius: 3.5,
          borderColor: isCameraOn ? "transparent" : "divider",
          boxShadow: isCameraOn
            ? "0 12px 32px -4px rgba(7, 17, 30, 0.4), 0 0 0 1px rgba(255,255,255,0.06)"
            : "0 2px 10px rgba(0,0,0,0.03)",
          transition: "all 0.35s cubic-bezier(0.4, 0, 0.2, 1)",
        }}
      >
        {/* CSS Animations */}
        <Box
          component="style"
          dangerouslySetInnerHTML={{
            __html: `
              @keyframes scanLaser {
                0% { top: 14%; opacity: 0.3; }
                50% { opacity: 0.95; }
                100% { top: 84%; opacity: 0.3; }
              }
              @keyframes pulseHud {
                0%, 100% { transform: scale(1); opacity: 0.85; }
                50% { transform: scale(1.015); opacity: 1; }
              }
              @keyframes rippleRing {
                0% { transform: scale(0.96); opacity: 0.8; }
                100% { transform: scale(1.08); opacity: 0; }
              }
            `,
          }}
        />

        {/* ── STATE 1: Display Captured Image Preview + In-Frame Verification ── */}
        {imagePreview ? (
          <Box sx={{ width: "100%", height: "100%", position: "relative" }}>
            <Box
              component="img"
              src={imagePreview}
              alt="Ảnh khuôn mặt độc giả"
              sx={{ width: "100%", height: "100%", objectFit: "cover" }}
            />
            {/* In-Frame Verification Overlay (Prevents Layout Shift) */}
            {isLoading && (
              <Stack
                sx={{
                  position: "absolute",
                  inset: 0,
                  bgcolor: "rgba(7, 17, 30, 0.78)",
                  backdropFilter: "blur(6px)",
                  alignItems: "center",
                  justifyContent: "center",
                  color: "white",
                  p: 3,
                  textAlign: "center",
                  gap: 1.5,
                  zIndex: 10,
                }}
              >
                <Box sx={{ position: "relative", display: "grid", placeItems: "center" }}>
                  <CircularProgress
                    size={56}
                    thickness={3.5}
                    sx={{ color: "primary.main" }}
                  />
                  <Box
                    sx={{
                      position: "absolute",
                      width: 70,
                      height: 70,
                      borderRadius: "50%",
                      border: "1px solid rgba(255,255,255,0.2)",
                      animation: "rippleRing 1.5s infinite ease-out",
                    }}
                  />
                </Box>
                <Typography variant="subtitle2" sx={{ fontWeight: 700, letterSpacing: 0.5, mt: 0.5 }}>
                  Đang đối soát sinh trắc học...
                </Typography>
                <Typography variant="caption" sx={{ color: "rgba(255,255,255,0.7)" }}>
                  Hệ thống AI đang so khớp khuôn mặt với cơ sở dữ liệu thư viện
                </Typography>
              </Stack>
            )}
          </Box>
        ) : showFaceFallback ? (
          /* ── STATE 2: Camera Fallback ── */
          <CameraFallback
            lastFrameUrl={hasFaceCameraWorkedRef.current ? lastFaceFrameRef.current : null}
            onRetry={startCamera}
            showManualInput
            manualLabel="Email"
            manualPlaceholder="Nhập email để đăng nhập..."
            onManualSubmit={(value) => onSwitchToPassword(value)}
            showFileUpload={false}
          />
        ) : isCameraOn ? (
          /* ── STATE 3: Active Camera & Biometric Oval HUD ── */
          <>
            <Box
              component="video"
              ref={videoRef}
              autoPlay
              playsInline
              muted
              sx={{
                width: "100%",
                height: "100%",
                objectFit: "cover",
                transform: "scaleX(-1)", // Mirror effect for natural selfie alignment
              }}
            />

            {/* Connecting Camera Overlay */}
            {!cameraReady && (
              <Stack
                sx={{
                  position: "absolute",
                  inset: 0,
                  bgcolor: "rgba(7, 17, 30, 0.85)",
                  color: "white",
                  alignItems: "center",
                  justifyContent: "center",
                  zIndex: 4,
                }}
              >
                <CircularProgress color="inherit" size={32} thickness={4} />
                <Typography variant="body2" sx={{ mt: 1.5, fontWeight: 500, color: "rgba(255,255,255,0.9)" }}>
                  Đang kết nối camera...
                </Typography>
              </Stack>
            )}

            {/* Biometric Face ID Mask & HUD */}
            {cameraReady && (
              <>
                {/* Oval Biometric Reticle */}
                <Box
                  sx={{
                    position: "absolute",
                    width: "54%",
                    height: "72%",
                    borderRadius: "48%",
                    border: "2px solid",
                    borderColor: "primary.light",
                    boxShadow: "0 0 0 9999px rgba(7, 17, 30, 0.58)",
                    zIndex: 2,
                    animation: "pulseHud 3s infinite ease-in-out",
                    pointerEvents: "none",
                  }}
                />

                {/* Corner Target Marks (Biometric Framing) */}
                <Box
                  sx={{
                    position: "absolute",
                    width: "60%",
                    height: "78%",
                    zIndex: 2,
                    pointerEvents: "none",
                    "&::before, &::after": {
                      content: '""',
                      position: "absolute",
                      width: 18,
                      height: 18,
                      borderColor: "rgba(255, 255, 255, 0.65)",
