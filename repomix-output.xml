            <p className="text-slate-400">{patronInfo.faculty}</p>
          </div>
        )}

        {message && (
          <p className={`text-lg ${status === 'success' ? 'text-emerald-400' : status === 'error' ? 'text-red-400' : 'text-amber-400'}`}>
            {message}
          </p>
        )}
      </div>
    </div>
  );
}
