<file path="src/components/MultiAngleCapture.tsx">
"use client";

import { useCallback, useEffect, useMemo, useRef, useState } from "react";
import {
  Alert,
  Box,
  Button,
  Checkbox,
  Chip,
  CircularProgress,
  FormControlLabel,
  Grid,
  Paper,
  Stack,
  Typography,
  useTheme,
} from "@mui/material";
import AddAPhotoOutlinedIcon from "@mui/icons-material/AddAPhotoOutlined";
import CheckOutlinedIcon from "@mui/icons-material/CheckOutlined";
import PhotoCameraOutlinedIcon from "@mui/icons-material/PhotoCameraOutlined";
import RestartAltOutlinedIcon from "@mui/icons-material/RestartAltOutlined";

export type CaptureAngle = "frontal" | "right" | "left" | "down";
export type MultiAngleCaptureStatus = "pending" | "capturing" | "done";

export interface AngleConfig {
  angle: CaptureAngle;
  instruction: string;
  tip: string;
}

export interface CapturedAngle {
  angle: CaptureAngle;
  status: MultiAngleCaptureStatus;
  file: File | null;
  dataUrl: string | null;
}

export interface MultiAngleCaptureProps {
  angles?: AngleConfig[];
  consent: boolean;
  setConsent?: (v: boolean) => void;
  onFilesReady: (files: Record<CaptureAngle, File>) => Promise<void> | void;
  className?: string;
}

function captureFromVideo(video: HTMLVideoElement, cameraReady: boolean) {
  return new Promise<{ file: File; dataUrl: string }>((resolve, reject) => {
    if (!cameraReady) return reject(new Error("Camera chưa sẵn sàng"));
    if (video.videoWidth === 0 || video.videoHeight === 0) {
      return reject(new Error("Camera chưa khởi tạo"));
    }

    const canvas = document.createElement("canvas");
    canvas.width = video.videoWidth;
    canvas.height = video.videoHeight;

    const ctx = canvas.getContext("2d");
    if (!ctx) return reject(new Error("Không thể tạo canvas"));

    ctx.drawImage(video, 0, 0);
    const dataUrl = canvas.toDataURL("image/jpeg");
    canvas.toBlob(
      (blob) => {
        if (!blob) return reject(new Error("Không thể tạo ảnh"));
        resolve({ file: new File([blob], "face_capture.jpg", { type: "image/jpeg" }), dataUrl });
      },
      "image/jpeg",
      0.9
    );
  });
}

function getCameraErrorMessage(err: unknown) {
  const name = err instanceof DOMException ? err.name : "";
  if (name === "NotAllowedError" || name === "SecurityError") {
    return "Không có quyền truy cập camera. Hãy cấp quyền camera cho trình duyệt rồi thử lại.";
  }
  if (name === "NotFoundError" || name === "OverconstrainedError") {
    return "Không tìm thấy camera phù hợp. Hãy kiểm tra thiết bị camera rồi thử lại.";
  }
  if (name === "NotReadableError" || name === "AbortError") {
    return "Camera đang được ứng dụng khác sử dụng hoặc không mở được. Hãy đóng ứng dụng khác rồi thử lại.";
  }
  return "Không thể mở camera. Hãy kiểm tra quyền truy cập, thiết bị camera và thử lại.";
}

const ANGLE_LABELS: Record<CaptureAngle, string> = {
  frontal: "Nhìn thẳng",
  right: "Quay phải",
  left: "Quay trái",
  down: "Cúi xuống",
};

export default function MultiAngleCapture({
  angles,
  consent,
  setConsent,
  onFilesReady,
  className,
}: MultiAngleCaptureProps) {
  const theme = useTheme();
  const defaultAngles = useMemo<AngleConfig[]>(
    () =>
      angles ?? [
        { angle: "frontal", instruction: "Nhìn thẳng", tip: "Giữ mặt thẳng, mắt mở tự nhiên" },
        { angle: "right", instruction: "Quay phải", tip: "Xoay đầu sang phải khoảng 30 độ" },
        { angle: "left", instruction: "Quay trái", tip: "Xoay đầu sang trái khoảng 30 độ" },
        { angle: "down", instruction: "Cúi xuống", tip: "Cúi nhẹ cằm xuống ngực" },
      ],
    [angles]
  );

  const videoRef = useRef<HTMLVideoElement | null>(null);
  const streamRef = useRef<MediaStream | null>(null);

  const [cameraReady, setCameraReady] = useState(false);
  const [isCameraOn, setIsCameraOn] = useState(false);
  const [cameraError, setCameraError] = useState("");
  const [isSequenceRunning, setIsSequenceRunning] = useState(false);
  const [currentAngleIdx, setCurrentAngleIdx] = useState(-1);
  const [countdown, setCountdown] = useState<number | null>(null);
  const [captures, setCaptures] = useState<CapturedAngle[]>(
    defaultAngles.map((item) => ({ angle: item.angle, status: "pending", file: null, dataUrl: null }))
  );

  useEffect(() => {
    setCaptures(defaultAngles.map((item) => ({ angle: item.angle, status: "pending", file: null, dataUrl: null })));
  }, [defaultAngles]);

  const stopCamera = useCallback(() => {
    if (streamRef.current) {
      streamRef.current.getTracks().forEach((track) => track.stop());
      streamRef.current = null;
    }
    setIsCameraOn(false);
    setCameraReady(false);
  }, []);

  const startCamera = useCallback(async () => {
    try {
      setCameraError("");
      setCameraReady(false);
      setIsCameraOn(false);
      stopCamera();

      const stream = await navigator.mediaDevices.getUserMedia({
        video: {
          facingMode: "user",
          width: { ideal: 640, min: 320 },
          height: { ideal: 480, min: 240 },
        },
        audio: false,
      });

      streamRef.current = stream;
      setIsCameraOn(true);
      return true;
    } catch (err) {
      setIsCameraOn(false);
      setCameraReady(false);
      setCameraError(getCameraErrorMessage(err));
      return false;
    }
  }, [stopCamera]);

  useEffect(() => {
    if (!isCameraOn || !videoRef.current || !streamRef.current) return;

    const video = videoRef.current;
    const onReady = () => setCameraReady(true);
    const handleError = () => setCameraReady(false);

    video.onloadedmetadata = onReady;
    video.onplaying = onReady;
    video.onerror = handleError;
    video.srcObject = streamRef.current;

    if (video.readyState >= 2) onReady();
    const timer = setTimeout(() => setCameraReady(true), 3000);

    return () => {
      clearTimeout(timer);
      video.onloadedmetadata = null;
      video.onplaying = null;
      video.onerror = null;
      video.srcObject = null;
    };
  }, [isCameraOn]);

  useEffect(() => () => stopCamera(), [stopCamera]);

  const retakeAngle = useCallback(
    async (idx: number) => {
      setCaptures((prev) =>
        prev.map((item, index) => (index === idx ? { ...item, status: "pending", file: null, dataUrl: null } : item))
      );
      const opened = await startCamera();
      if (!opened) return;
      setIsSequenceRunning(true);
      setTimeout(() => setCurrentAngleIdx(idx), 500);
    },
    [startCamera]
  );

  const startSequence = useCallback(async () => {
    setCaptures(defaultAngles.map((item) => ({ angle: item.angle, status: "pending", file: null, dataUrl: null })));
    setCountdown(null);
    const opened = await startCamera();
    if (!opened) {
      setCurrentAngleIdx(-1);
      setIsSequenceRunning(false);
      return;
    }
    setCurrentAngleIdx(0);
    setIsSequenceRunning(true);
  }, [defaultAngles, startCamera]);

  useEffect(() => {
    if (currentAngleIdx < 0 || currentAngleIdx >= defaultAngles.length) return;
    if (!cameraReady || !isSequenceRunning) return;

    let cancelled = false;
    let currentCountdown = 5;

    setCountdown(currentCountdown);
    setCaptures((prev) => prev.map((item, index) => (index === currentAngleIdx ? { ...item, status: "capturing" } : item)));

    const timer = window.setInterval(async () => {
      currentCountdown--;
      if (cancelled) {
        clearInterval(timer);
        return;
      }

      if (currentCountdown <= 0) {
        clearInterval(timer);
        setCountdown(null);

        try {
          const video = videoRef.current;
          if (!video) throw new Error("Không tìm thấy video");

          const { file, dataUrl } = await captureFromVideo(video, cameraReady);
          if (cancelled) return;

          setCaptures((prev) =>
            prev.map((item, index) => (index === currentAngleIdx ? { ...item, status: "done", file, dataUrl } : item))
          );

          const nextIdx = currentAngleIdx + 1;
          if (nextIdx >= defaultAngles.length) {
            setIsSequenceRunning(false);
            setCurrentAngleIdx(-1);
            stopCamera();
          } else {
            setTimeout(() => {
              if (!cancelled) setCurrentAngleIdx(nextIdx);
            }, 800);
          }
        } catch (err) {
          if (cancelled) return;
          setCameraError(getCameraErrorMessage(err));
          setCaptures((prev) => prev.map((item, index) => (index === currentAngleIdx ? { ...item, status: "pending" } : item)));
          setIsSequenceRunning(false);
          setCurrentAngleIdx(-1);
          stopCamera();
        }
      } else {
        setCountdown(currentCountdown);
      }
    }, 1000);

    return () => {
      cancelled = true;
      clearInterval(timer);
    };
  }, [currentAngleIdx, cameraReady, isSequenceRunning, defaultAngles.length, stopCamera]);

  const allCaptured = captures.every((item) => item.status === "done" && Boolean(item.file));
  const doneCount = captures.filter((item) => item.status === "done").length;

  const capturedFiles = useMemo(() => {
    const result = {} as Record<CaptureAngle, File>;
    for (const item of captures) {
      if (item.status === "done" && item.file) {
        result[item.angle] = item.file;
      }
    }
    return result;
  }, [captures]);

  const submit = useCallback(async () => {
    if (!consent || !allCaptured) return;
    await onFilesReady(capturedFiles);
  }, [allCaptured, capturedFiles, consent, onFilesReady]);

  const currentConfig = currentAngleIdx >= 0 ? defaultAngles[currentAngleIdx] : null;

  return (
    <Box className={className}>
      {!allCaptured && !isSequenceRunning && currentAngleIdx < 0 && (
        <Paper variant="outlined" sx={{ p: 3, textAlign: "center" }}>
          <Stack spacing={2} sx={{ alignItems: "center" }}>
            <Box
              sx={{
                width: 64,
                height: 64,
                borderRadius: "50%",
                display: "grid",
                placeItems: "center",
                bgcolor: "primary.main",
                color: "primary.contrastText",
              }}
            >
              <PhotoCameraOutlinedIcon fontSize="large" />
            </Box>
            <Box>
              <Typography variant="h6" sx={{ fontWeight: 850 }}>
                Chụp khuôn mặt từ 4 góc
              </Typography>
              <Typography color="text.secondary">
                Nhận diện nhanh hơn, chính xác hơn tại cổng.
              </Typography>
            </Box>

            <Paper variant="outlined" sx={{ p: 2, width: "100%", bgcolor: "action.hover", textAlign: "left" }}>
              <Typography variant="subtitle2" color="primary" sx={{ fontWeight: 850, mb: 1 }}>
                Lưu ý khi chụp
              </Typography>
              <Stack spacing={0.5}>
                <Typography variant="body2" color="text.secondary">- Đủ ánh sáng, không ngược sáng.</Typography>
                <Typography variant="body2" color="text.secondary">- Giữ yên khi đếm ngược về 0.</Typography>
                <Typography variant="body2" color="text.secondary">- Mặt vừa đủ trong khung tròn.</Typography>
              </Stack>
            </Paper>

            {cameraError && <Alert severity="warning" sx={{ width: "100%" }}>{cameraError}</Alert>}

            <Button variant="contained" size="large" startIcon={<PhotoCameraOutlinedIcon />} onClick={startSequence}>
              Bắt đầu chụp
            </Button>
          </Stack>
        </Paper>
      )}

      {(isSequenceRunning || currentAngleIdx >= 0) && (
        <Paper
          variant="outlined"
          sx={{
            position: "relative",
            aspectRatio: "16 / 9",
            overflow: "hidden",
            bgcolor: "black",
          }}
        >
          <Box component="video" ref={videoRef} autoPlay playsInline muted sx={{ width: "100%", height: "100%", objectFit: "contain" }} />
          <Box
            sx={{
              position: "absolute",
              inset: 0,
              display: "flex",
              alignItems: "center",
              justifyContent: "center",
              pointerEvents: "none",
            }}
          >
            <Box sx={{ width: 150, height: 150, border: 2, borderColor: "primary.main", borderRadius: "50%", opacity: 0.75 }} />
          </Box>

          {!cameraReady && (
            <Stack
              spacing={1}
              sx={{
                position: "absolute",
                inset: 0,
                alignItems: "center",
                justifyContent: "center",
                bgcolor: "rgba(0,0,0,.65)",
                color: "common.white",
              }}
            >
              <CircularProgress color="inherit" size={30} />
              <Typography variant="body2">{cameraError || "Đang mở camera..."}</Typography>
            </Stack>
          )}

          {countdown !== null && currentConfig && (
            <Stack
              spacing={2}
              sx={{
                position: "absolute",
                inset: 0,
                alignItems: "center",
                justifyContent: "center",
                bgcolor: "rgba(0,0,0,.78)",
                color: "common.white",
                textAlign: "center",
                p: 2,
              }}
            >
              <Box>
                <Typography variant="h5" sx={{ fontWeight: 850 }}>{currentConfig.instruction}</Typography>
                <Typography variant="body2" sx={{ color: "grey.300", mt: 0.5 }}>{currentConfig.tip}</Typography>
              </Box>
              <Stack direction="row" spacing={1}>
                {defaultAngles.map((item, index) => (
                  <Box
                    key={item.angle}
                    sx={{
                      width: 12,
                      height: 12,
                      borderRadius: "50%",
                      bgcolor: index < doneCount ? "success.main" : index === currentAngleIdx ? "primary.main" : "grey.600",
                    }}
                  />
                ))}
              </Stack>
              {countdown === 1 && <Chip color="error" label="GIỮ YÊN!" />}
              <Typography sx={{ fontSize: 64, fontWeight: 900, lineHeight: 1 }}>{countdown}</Typography>
            </Stack>
          )}
        </Paper>
      )}

      {allCaptured && (
        <Stack spacing={2}>
          <Grid container spacing={1.5}>
            {captures.map((item, index) => (
              <Grid key={item.angle} size={{ xs: 6, sm: 3 }}>
                <Paper
                  variant="outlined"
                  sx={{
                    position: "relative",
                    aspectRatio: "1 / 1",
                    overflow: "hidden",
                    borderColor: item.status === "done" ? "success.main" : "divider",
                  }}
                >
                  {item.dataUrl ? (
                    <Box component="img" src={item.dataUrl} alt={item.angle} sx={{ width: "100%", height: "100%", objectFit: "cover" }} />
                  ) : (
                    <Stack sx={{ height: "100%", alignItems: "center", justifyContent: "center", bgcolor: "action.hover", color: "text.secondary" }}>
                      <PhotoCameraOutlinedIcon />
                    </Stack>
                  )}
                  <Chip
                    size="small"
                    label={ANGLE_LABELS[item.angle]}
                    sx={{ position: "absolute", left: 6, bottom: 6, bgcolor: "rgba(0,0,0,.72)", color: "common.white" }}
                  />
                  {item.status === "done" && (
                    <Box sx={{ position: "absolute", top: 6, right: 6, width: 24, height: 24, borderRadius: "50%", bgcolor: "success.main", color: "success.contrastText", display: "grid", placeItems: "center" }}>
                      <CheckOutlinedIcon sx={{ fontSize: 16 }} />
                    </Box>
                  )}
                </Paper>
              </Grid>
            ))}
          </Grid>

          <Stack direction={{ xs: "column", sm: "row" }} spacing={1}>
            {captures.map((item, index) => (
              <Button
                key={item.angle}
                variant="outlined"
                size="small"
                startIcon={<RestartAltOutlinedIcon />}
                onClick={() => retakeAngle(index)}
                sx={{ flex: 1 }}
              >
                {ANGLE_LABELS[item.angle]}
              </Button>
            ))}
          </Stack>

          <Paper variant="outlined" sx={{ p: 1.5, bgcolor: "action.hover" }}>
            <FormControlLabel
              control={<Checkbox checked={consent} onChange={(event) => setConsent?.(event.target.checked)} disabled={!setConsent} />}
              label="Tôi đồng ý cho hệ thống xử lý dữ liệu khuôn mặt để nhận diện tại cổng."
              sx={{ m: 0, color: "text.secondary" }}
            />
          </Paper>

          <Button
            variant="contained"
            color="success"
            size="large"
            startIcon={<AddAPhotoOutlinedIcon />}
            onClick={submit}
            disabled={!consent}
            fullWidth
          >
            Xác nhận {doneCount} góc ảnh
          </Button>
        </Stack>
      )}
    </Box>
  );
}
</file>

<file path="src/components/staff-schedule/AssignStaffDialog.tsx">
"use client";

import { useEffect, useMemo, useState } from "react";
import api from "@/lib/api-client";
import type { ScheduleStaff, StaffShift, LibraryZone, StaffScheduleAssignment } from "@/lib/types";

interface AssignStaffDialogProps {
  open: boolean;
  date: string;
  shiftId: string;
  shiftName: string;
  shifts: StaffShift[];
  zones: LibraryZone[];
  staff: ScheduleStaff[];
  existingAssignments: StaffScheduleAssignment[];
  dayAssignments: StaffScheduleAssignment[];
  onClose: () => void;
  onAssigned: () => void;
}

export default function AssignStaffDialog({
  open,
  date,
  shiftId,
  shiftName,
  shifts,
  zones,
  staff,
  existingAssignments,
  dayAssignments,
  onClose,
  onAssigned,
}: AssignStaffDialogProps) {
  const [zoneId, setZoneId] = useState("");
  const [staffId, setStaffId] = useState("");
  const [saving, setSaving] = useState(false);
  const [error, setError] = useState<string | null>(null);
  const [approvedLeaves, setApprovedLeaves] = useState<any[]>([]);

  useEffect(() => {
    if (open) {
      api.getScheduleAvailability({ status: "approved" })
        .then(setApprovedLeaves)
        .catch((err) => console.error("Failed to load approved leaves", err));
    }
  }, [open]);

  const shift = useMemo(() => shifts.find((s) => s.id === shiftId), [shifts, shiftId]);

  const existingStaffIds = useMemo(
    () => new Set(existingAssignments.map((a) => a.staffId)),
    [existingAssignments],
  );

  const availableStaff = useMemo(
    () => staff.filter((s) => !existingStaffIds.has(s.id)),
    [staff, existingStaffIds],
  );

  const reset = () => {
    setZoneId("");
    setStaffId("");
    setError(null);
  };

  const handleAssign = async () => {
    if (!zoneId || !staffId) {
      setError("Vui lòng chọn khu vực và nhân viên");
      return;
    }
    const selectedStaff = staff.find((s) => s.id === staffId);
    if (selectedStaff) {
      const isLeave = approvedLeaves.some(
        (l) => l.staffId === staffId && date >= l.dateFrom && date <= l.dateTo
      );
      if (isLeave) {
        setError(`${selectedStaff.fullName || selectedStaff.email} đang trong thời gian nghỉ phép`);
        return;
      }
      const existAsg = dayAssignments.find((a) => a.staffId === staffId);
      if (existAsg) {
        const existShift = shifts.find((sh) => sh.id === existAsg.shiftId);
        const newStart = shift?.startTime?.slice(0, 5);
        const newEnd = shift?.endTime?.slice(0, 5);
        const existStart = existShift?.startTime?.slice(0, 5);
        const existEnd = existShift?.endTime?.slice(0, 5);
        const isOverlap = newStart && newEnd && existStart && existEnd && (newStart < existEnd && newEnd > existStart);
        if (isOverlap) {
          setError(`${selectedStaff.fullName || selectedStaff.email} đã có ca ${existShift?.name || existAsg.shiftId} trùng giờ`);
          return;
        }
      }
    }
    setSaving(true);
    setError(null);
    try {
      await api.createScheduleAssignment({ staffId, shiftId, zoneId, workDate: date });
      reset();
      onAssigned();
    } catch (err: any) {
      const data = err?.response?.data;
      setError(data?.error || data?.message || data?.detail?.[0]?.message || err?.message || "Có lỗi xảy ra");
    } finally {
      setSaving(false);
    }
  };

  const getStaffLabel = (s: ScheduleStaff) => {
    const isLeave = approvedLeaves.some(
      (l) => l.staffId === s.id && date >= l.dateFrom && date <= l.dateTo
    );
    const existAsg = dayAssignments.find((a) => a.staffId === s.id);
    if (isLeave) {
      return `${s.fullName || s.email} (⚠️ Xin nghỉ phép)`;
    }
    if (existAsg) {
      const existShift = shifts.find((sh) => sh.id === existAsg.shiftId);
      const newStart = shift?.startTime?.slice(0, 5);
      const newEnd = shift?.endTime?.slice(0, 5);
      const existStart = existShift?.startTime?.slice(0, 5);
      const existEnd = existShift?.endTime?.slice(0, 5);
      const isOverlap = newStart && newEnd && existStart && existEnd && (newStart < existEnd && newEnd > existStart);
      
      if (isOverlap) {
        return `${s.fullName || s.email} (⚠️ Trùng ca: ${existShift?.name || existAsg.shiftId})`;
      }
      return `${s.fullName || s.email} (Đã có ca: ${existShift?.name || existAsg.shiftId})`;
    }
    return s.fullName || s.email;
  };

  if (!open) return null;

  return (
    <div className="fixed inset-0 z-50 flex items-center justify-center">
      <div className="absolute inset-0 bg-black/50" onClick={onClose} />
      <div className="relative bg-surface rounded-xl shadow-xl border border-border w-80 p-5 space-y-4 animate-fade-in">
        <div className="flex items-center justify-between">
          <h3 className="text-sm font-semibold text-text">Phân ca trực</h3>
          <button onClick={onClose} className="text-text-3 hover:text-text transition text-sm">&times;</button>
        </div>

        <div className="text-xs text-text-3 space-y-0.5">
          <div><span className="font-medium text-text-2">Ngày:</span> {date}</div>
          <div><span className="font-medium text-text-2">Ca:</span> <span className="text-primary">{shiftName}</span></div>
          {shift && (
            <div className="text-text-3">{shift.startTime?.slice(0, 5)} &ndash; {shift.endTime?.slice(0, 5)}</div>
          )}
        </div>

        <div className="space-y-3">
          <div>
            <label className="text-[11px] font-medium text-text-3 block mb-1">Khu vực</label>
            <select
              value={zoneId}
              onChange={(e) => { setZoneId(e.target.value); setError(null); }}
              className="w-full px-2.5 py-1.5 rounded-md bg-surface-2 border border-border text-xs text-text focus:outline-none focus:border-primary"
            >
              <option value="">Chọn khu vực</option>
              {zones.map((z) => (
                <option key={z.id} value={z.id}>{z.zoneName}</option>
              ))}
            </select>
          </div>

          <div>
            <label className="text-[11px] font-medium text-text-3 block mb-1">
              Nhân viên
              {availableStaff.length < staff.length && (
                <span className="text-text-3 font-normal ml-1">({staff.length - availableStaff.length} đã xếp)</span>
              )}
            </label>
            <select
              value={staffId}
              onChange={(e) => { setStaffId(e.target.value); setError(null); }}
              className="w-full px-2.5 py-1.5 rounded-md bg-surface-2 border border-border text-xs text-text focus:outline-none focus:border-primary"
            >
              <option value="">Chọn nhân viên</option>
              {availableStaff.map((s) => (
                <option key={s.id} value={s.id}>{getStaffLabel(s)}</option>
              ))}
              {availableStaff.length === 0 && (
                <option disabled>Tất cả nhân viên đã được xếp</option>
              )}
            </select>
          </div>
        </div>

        {error && (
          <div className="text-xs text-error bg-error/10 border border-error/20 rounded-md px-2.5 py-1.5">
            {error}
          </div>
        )}

        <div className="flex items-center gap-2 justify-end pt-1">
          <button
            onClick={onClose}
            className="px-3 py-1.5 rounded-md text-xs font-medium text-text-2 hover:bg-surface-2 transition border border-border"
          >
            Hủy
          </button>
          <button
            onClick={handleAssign}
            disabled={saving || availableStaff.length === 0}
            className="px-3 py-1.5 rounded-md text-xs font-medium text-bg bg-primary hover:bg-primary-dark transition disabled:opacity-50"
          >
            {saving ? "Đang xử lý..." : "Xếp ca"}
          </button>
        </div>
      </div>
    </div>
  );
}
</file>

<file path="src/components/staff-schedule/AutoScheduleDialog.tsx">
"use client";

import { useState } from "react";
import {
  Dialog,
  DialogTitle,
  DialogContent,
  DialogActions,
  Button,
  Stack,
  Typography,
} from "@mui/material";
import CalendarTodayIcon from "@mui/icons-material/CalendarToday";
import DateRangeIcon from "@mui/icons-material/DateRange";
import YearIcon from "@mui/icons-material/CalendarMonth";
import CheckCircleIcon from "@mui/icons-material/CheckCircle";
import AssignmentIndIcon from "@mui/icons-material/AssignmentInd";

function toDateInput(date: Date): string {
  const y = date.getFullYear();
  const m = String(date.getMonth() + 1).padStart(2, "0");
  const d = String(date.getDate()).padStart(2, "0");
  return `${y}-${m}-${d}`;
}

function formatDisplayDate(iso: string): string {
  const [y, m, d] = iso.split("-");
  return `${d}/${m}/${y}`;
}

function getMonday(d: Date): Date {
  const date = new Date(d);
  const day = date.getDay();
  const diff = date.getDate() - day + (day === 0 ? -6 : 1);
  date.setDate(diff);
  return date;
}

function getEndOfMonth(year: number, month: number): Date {
  return new Date(year, month + 1, 0);
}

interface QuickOption {
  label: string;
  sub: string;
  icon: React.ReactNode;
  from: string;
  to: string;
}

function getQuickOptions(): QuickOption[] {
  const now = new Date();
  const monday = getMonday(now);
  const sunday = new Date(monday);
  sunday.setDate(monday.getDate() + 6);

  const nextMonday = new Date(monday);
  nextMonday.setDate(monday.getDate() + 7);
  const nextSunday = new Date(nextMonday);
  nextSunday.setDate(nextMonday.getDate() + 6);

  const monthStart = new Date(now.getFullYear(), now.getMonth(), 1);
  const monthEnd = getEndOfMonth(now.getFullYear(), now.getMonth());

  const nextMonthStart = new Date(now.getFullYear(), now.getMonth() + 1, 1);
  const nextMonthEnd = getEndOfMonth(now.getFullYear(), now.getMonth() + 1);

  const yearStart = new Date(now.getFullYear(), 0, 1);
  const yearEnd = new Date(now.getFullYear(), 11, 31);

  return [
    {
      label: "Tuần này",
      sub: `${monday.getDate()}/${monday.getMonth() + 1} — ${sunday.getDate()}/${sunday.getMonth() + 1}`,
      icon: <CalendarTodayIcon sx={{ fontSize: 20 }} />,
      from: toDateInput(monday),
      to: toDateInput(sunday),
    },
    {
      label: "Tuần sau",
      sub: `${nextMonday.getDate()}/${nextMonday.getMonth() + 1} — ${nextSunday.getDate()}/${nextSunday.getMonth() + 1}`,
      icon: <CalendarTodayIcon sx={{ fontSize: 20 }} />,
      from: toDateInput(nextMonday),
      to: toDateInput(nextSunday),
    },
    {
      label: "Tháng này",
      sub: `Tháng ${now.getMonth() + 1}/${now.getFullYear()}`,
      icon: <DateRangeIcon sx={{ fontSize: 20 }} />,
      from: toDateInput(monthStart),
      to: toDateInput(monthEnd),
    },
    {
      label: "Tháng sau",
      sub: `Tháng ${now.getMonth() + 2 > 12 ? 1 : now.getMonth() + 2}/${now.getMonth() + 2 > 12 ? now.getFullYear() + 1 : now.getFullYear()}`,
      icon: <DateRangeIcon sx={{ fontSize: 20 }} />,
      from: toDateInput(nextMonthStart),
      to: toDateInput(nextMonthEnd),
    },
    {
      label: "Năm nay",
      sub: `${now.getFullYear()}`,
      icon: <YearIcon sx={{ fontSize: 20 }} />,
      from: toDateInput(yearStart),
      to: toDateInput(yearEnd),
    },
  ];
}

interface ProposedItem {
  staffId: string;
  shiftId: string;
  zoneId: string;
  workDate: string;
  note: string;
  staffName?: string;
  shiftName?: string;
  zoneName?: string;
}

interface Props {
  open: boolean;
  onClose: () => void;
  onConfirm: (from: string, to: string) => void;
  onConfirmFinal: () => void;
  loading?: boolean;
  step: "select" | "preview";
  proposals: ProposedItem[];
  skippedCount: number;
  actualRange?: { from: string; to: string } | null;
}

export default function AutoScheduleDialog({ open, onClose, onConfirm, onConfirmFinal, loading, step, proposals, skippedCount, actualRange }: Props) {
  const [selected, setSelected] = useState<number | null>(0);
  const [customFrom, setCustomFrom] = useState("");
  const [customTo, setCustomTo] = useState("");
  const [useCustom, setUseCustom] = useState(false);
  const options = getQuickOptions();

  const handleSelectConfirm = () => {
    if (useCustom) {
      if (!customFrom || !customTo) return;
      onConfirm(customFrom, customTo);
    } else if (selected !== null) {
      onConfirm(options[selected].from, options[selected].to);
    }
  };

  const dateRange = useCustom
    ? { from: customFrom, to: customTo }
    : selected !== null
    ? { from: options[selected].from, to: options[selected].to }
    : null;

  return (
    <Dialog open={open} onClose={onClose} maxWidth="sm" fullWidth>
      <DialogTitle sx={{ fontWeight: 700, display: "flex", alignItems: "center", gap: 1.5 }}>
        <div className="w-8 h-8 rounded-lg flex items-center justify-center" style={{ background: "rgba(245,158,11,0.15)" }}>
          {step === "select" ? <CalendarTodayIcon sx={{ fontSize: 18, color: "#f59e0b" }} /> : <CheckCircleIcon sx={{ fontSize: 18, color: "#10b981" }} />}
        </div>
        {step === "select" ? "Gợi ý lịch tự động" : `Xác nhận tạo ${proposals.length} ca`}
      </DialogTitle>
      <DialogContent>
        {step === "select" ? (
          <Stack spacing={2.5} sx={{ mt: 1 }}>
            <div>
              <Typography variant="caption" sx={{ fontWeight: 600, color: "text.secondary", mb: 1, display: "block" }}>
                Chọn nhanh:
              </Typography>
              <div className="grid grid-cols-3 gap-2">
                {options.map((opt, i) => (
                  <button
                    key={i}
                    onClick={() => { setSelected(i); setUseCustom(false); }}
                    className="flex flex-col items-center gap-1 p-3 rounded-xl border-2 transition-all text-center"
                    style={{
                      borderColor: !useCustom && selected === i ? "#f59e0b" : "rgba(255,255,255,0.08)",
                      background: !useCustom && selected === i ? "rgba(245,158,11,0.08)" : "rgba(255,255,255,0.02)",
                    }}
                  >
                    <span style={{ color: !useCustom && selected === i ? "#f59e0b" : "#9ca3af" }}>
                      {opt.icon}
                    </span>
                    <span className="text-xs font-semibold" style={{ color: !useCustom && selected === i ? "#f59e0b" : "#e5e7eb" }}>
                      {opt.label}
                    </span>
                    <span className="text-[10px]" style={{ color: "#9ca3af" }}>
                      {opt.sub}
                    </span>
                  </button>
                ))}
              </div>
            </div>

            <div>
              <Typography variant="caption" sx={{ fontWeight: 600, color: "text.secondary", mb: 1, display: "block" }}>
                Hoặc chọn khoảng ngày:
              </Typography>
              <div
                className="flex items-center gap-2 p-3 rounded-xl border-2 cursor-pointer transition-all"
                style={{
                  borderColor: useCustom ? "#f59e0b" : "rgba(255,255,255,0.08)",
                  background: useCustom ? "rgba(245,158,11,0.08)" : "rgba(255,255,255,0.02)",
                }}
                onClick={() => { setUseCustom(true); setSelected(null); }}
              >
                <input
                  type="date"
                  value={customFrom}
                  onChange={(e) => { setCustomFrom(e.target.value); setUseCustom(true); setSelected(null); }}
                  onClick={(e) => e.stopPropagation()}
                  className="flex-1 text-xs px-2 py-1.5 bg-transparent border border-white/10 rounded-lg text-white"
                />
                <span className="text-text-3 text-xs">—</span>
                <input
                  type="date"
                  value={customTo}
                  onChange={(e) => { setCustomTo(e.target.value); setUseCustom(true); setSelected(null); }}
                  onClick={(e) => e.stopPropagation()}
                  className="flex-1 text-xs px-2 py-1.5 bg-transparent border border-white/10 rounded-lg text-white"
                />
              </div>
            </div>
          </Stack>
        ) : (
          /* ── Preview Step ── */
          <Stack spacing={2} sx={{ mt: 1 }}>
            {proposals.length === 0 ? (
              <div className="text-center py-6 text-text-3">
                <AssignmentIndIcon sx={{ fontSize: 32, opacity: 0.3, mb: 1 }} />
                <p className="text-xs italic">Không có đề xuất lịch mới</p>
                <p className="text-[10px] text-text-3 mt-1">Tất cả ca đã đủ nhân viên</p>
              </div>
            ) : (
              <>
                {actualRange && (
                  <div className="text-[11px] text-text-3 text-center py-1 px-2 rounded bg-white/[0.03] border border-white/5">
                    Đề xuất từ <span className="text-emerald-400 font-medium">{formatDisplayDate(actualRange.from)}</span> — <span className="text-emerald-400 font-medium">{formatDisplayDate(actualRange.to)}</span>
                  </div>
                )}
                <div className="flex gap-3">
                  <div className="flex-1 text-center p-2 rounded-lg bg-emerald-500/10">
                    <div className="text-lg font-bold text-emerald-400">{proposals.length}</div>
                    <div className="text-[10px] text-text-3">Ca sẽ tạo</div>
                  </div>
                  {skippedCount > 0 && (
                    <div className="flex-1 text-center p-2 rounded-lg bg-amber-500/10">
                      <div className="text-lg font-bold text-amber-400">{skippedCount}</div>
                      <div className="text-[10px] text-text-3">Bỏ qua</div>
                    </div>
                  )}
                </div>

                <div className="max-h-60 overflow-y-auto space-y-1.5 pr-1">
                  {proposals.slice(0, 50).map((p, i) => (
                    <div key={i} className="flex items-center gap-2 px-3 py-2 rounded-lg bg-white/[0.03] border border-white/5">
                      <div className="w-6 h-6 rounded-full flex items-center justify-center text-[10px] font-bold" style={{ background: "rgba(16,185,129,0.15)", color: "#10b981" }}>
                        {i + 1}
                      </div>
                      <div className="flex-1 min-w-0">
                        <div className="text-[11px] font-medium text-text truncate">
                          {p.staffName || p.staffId.slice(0, 8)}
                        </div>
                        <div className="text-[10px] text-text-3">
                          {p.shiftName || "Ca"} — {p.zoneName || "Zone"} — {p.workDate}
                        </div>
                      </div>
                      <span className="text-[9px] px-1.5 py-0.5 rounded bg-emerald-500/10 text-emerald-400">
                        {p.note?.includes("template") ? "template" : p.note?.includes("preference") ? "sở thích" : "auto"}
                      </span>
                    </div>
                  ))}
                  {proposals.length > 50 && (
                    <div className="text-center text-[10px] text-text-3 py-1">
                      ... và {proposals.length - 50} ca nữa
                    </div>
                  )}
                </div>
              </>
            )}
          </Stack>
        )}
      </DialogContent>
      <DialogActions sx={{ px: 3, pb: 2.5 }}>
        <Button onClick={onClose} disabled={loading} sx={{ textTransform: "none" }}>
          {step === "preview" ? "Hủy" : "Đóng"}
        </Button>
        {step === "select" ? (
          <Button
            onClick={handleSelectConfirm}
            variant="contained"
            disabled={useCustom ? !customFrom || !customTo : selected === null}
            sx={{
              textTransform: "none", fontWeight: 600,
              bgcolor: "#f59e0b", "&:hover": { bgcolor: "#d97706" },
            }}
          >
            Xem đề xuất
          </Button>
        ) : (
          <Button
            onClick={onConfirmFinal}
            variant="contained"
            disabled={loading || proposals.length === 0}
            sx={{
              textTransform: "none", fontWeight: 600,
              bgcolor: "#10b981", "&:hover": { bgcolor: "#059669" },
            }}
          >
            {loading ? "Đang tạo..." : `Xác nhận tạo ${proposals.length} ca`}
          </Button>
        )}
      </DialogActions>
    </Dialog>
  );
}
</file>

<file path="src/components/staff-schedule/LeaveApprovalPanel.tsx">
"use client";

import { useEffect, useState } from "react";
import api from "@/lib/api-client";
import type { StaffAvailabilityRequest, ScheduleStaff } from "@/lib/types";

interface Props {
  open: boolean;
  onClose: () => void;
  onUpdated: () => void;
}

function getApiError(err: any): string {
  const data = err?.response?.data;
  return data?.error || data?.message || err?.message || "Có lỗi xảy ra";
}

const STATUS_LABELS: Record<string, { label: string; color: string }> = {
  pending: { label: "Chờ duyệt", color: "#f59e0b" },
  approved: { label: "Đã duyệt", color: "#10b981" },
  rejected: { label: "Từ chối", color: "#ef4444" },
};

export default function LeaveApprovalPanel({ open, onClose, onUpdated }: Props) {
  const [requests, setRequests] = useState<StaffAvailabilityRequest[]>([]);
  const [staff, setStaff] = useState<ScheduleStaff[]>([]);
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState<string | null>(null);
  const [filter, setFilter] = useState<string>("pending");

  const today = new Date().toISOString().slice(0, 10);

  const loadData = async () => {
    setLoading(true);
    setError(null);
    try {
      const [reqs, staffList] = await Promise.all([
        api.getScheduleAvailability({ status: filter === "all" ? undefined : filter }),
        api.getScheduleStaffOptions(),
      ]);
      setRequests(reqs);
      setStaff(staffList);
    } catch (err) {
      setError(getApiError(err));
    } finally {
      setLoading(false);
    }
  };

  useEffect(() => {
    if (open) loadData();
  }, [open, filter]);

  const handleApprove = async (id: string) => {
    if (!confirm("Duyệt đơn nghỉ phép này?")) return;
    try {
      await api.approveScheduleAvailability(id);
      await loadData();
      onUpdated();
    } catch (err) {
      setError(getApiError(err));
    }
  };

  const handleReject = async (id: string) => {
    if (!confirm("Từ chối đơn nghỉ phép này?")) return;
    try {
      await api.rejectScheduleAvailability(id);
      await loadData();
      onUpdated();
    } catch (err) {
      setError(getApiError(err));
    }
  };

  const getStaffName = (id: string) => {
    const s = staff.find((x) => x.id === id);
    return s?.fullName || s?.email || "Nhân viên";
  };

  const isStale = (req: StaffAvailabilityRequest) => {
    return req.dateTo < today;
  };

  const visibleRequests = filter === "pending"
    ? requests.filter((r) => !isStale(r))
    : requests;

  if (!open) return null;

  return (
    <div className="fixed inset-0 flex justify-end" style={{ zIndex: 1300 }}>
      <div className="absolute inset-0 bg-black/50" onClick={onClose} />
      <div className="relative bg-surface w-96 h-full shadow-xl border-l border-border flex flex-col animate-slide-in">
        <div className="flex items-center justify-between px-4 py-3 border-b border-border">
          <h2 className="font-serif text-sm font-semibold text-primary">Duyệt đơn nghỉ phép</h2>
          <button onClick={onClose} className="text-text-3 hover:text-text transition text-sm">&times;</button>
        </div>

        <div className="flex border-b border-border">
          {["pending", "approved", "rejected", "all"].map((f) => (
            <button
              key={f}
              onClick={() => setFilter(f)}
              className={`flex-1 py-2 text-xs font-medium transition border-b-2 ${
                filter === f
                  ? "border-primary text-primary"
                  : "border-transparent text-text-3 hover:text-text-2"
              }`}
            >
              {f === "pending" ? "Chờ duyệt" : f === "approved" ? "Đã duyệt" : f === "rejected" ? "Từ chối" : "Tất cả"}
            </button>
          ))}
        </div>

        <div className="flex-1 overflow-y-auto p-4 space-y-3">
          {error && (
            <div className="text-xs text-error bg-error/10 border border-error/20 rounded-md px-2.5 py-1.5">
              {error}
            </div>
          )}

          {loading && (
            <p className="text-xs text-text-3 italic text-center py-4">Đang tải...</p>
          )}

          {!loading && visibleRequests.length === 0 && (
            <p className="text-xs text-text-3 italic text-center py-4">Không có đơn nào</p>
          )}

          {visibleRequests.map((req) => {
            const status = STATUS_LABELS[req.status] || { label: req.status, color: "#6b7280" };
            const stale = isStale(req);
            return (
              <div key={req.id} className="rounded-lg border border-border bg-surface-2 p-3 space-y-2">
                <div className="flex items-center justify-between">
                  <span className="text-xs font-medium text-text">{getStaffName(req.staffId)}</span>
                  <span
                    className="text-[10px] font-semibold px-2 py-0.5 rounded-full"
                    style={{ backgroundColor: `${status.color}20`, color: status.color }}
                  >
                    {status.label}
                  </span>
                  {stale && (
                    <span className="text-[10px] font-semibold px-2 py-0.5 rounded-full bg-gray-200 text-gray-500">
                      Quá hạn
                    </span>
                  )}
                </div>
                <div className="text-[11px] text-text-2">
                  <span className="font-medium">Từ:</span> {req.dateFrom} &mdash; <span className="font-medium">Đến:</span> {req.dateTo}
                </div>
                {req.reason && (
                  <div className="text-[11px] text-text-3 italic">Lý do: {req.reason}</div>
                )}
                {req.status === "pending" && !stale && (
                  <div className="flex gap-2 pt-1">
                    <button
                      onClick={() => handleApprove(req.id)}
                      className="flex-1 py-1.5 rounded-md text-xs font-medium text-white bg-emerald-600 hover:bg-emerald-700 transition"
                    >
                      Duyệt
                    </button>
                    <button
                      onClick={() => handleReject(req.id)}
                      className="flex-1 py-1.5 rounded-md text-xs font-medium text-white bg-red-500 hover:bg-red-600 transition"
                    >
                      Từ chối
                    </button>
                  </div>
                )}
              </div>
            );
          })}
        </div>
      </div>
    </div>
  );
}
</file>

<file path="src/components/staff-schedule/ScheduleManagementPanel.tsx">
"use client";

import { useState } from "react";
import api from "@/lib/api-client";
import type { LibraryZone, StaffShift } from "@/lib/types";

interface ScheduleManagementPanelProps {
  open: boolean;
  onClose: () => void;
  zones: LibraryZone[];
  shifts: StaffShift[];
  onUpdate: () => void;
}

function getApiError(err: any): string {
  const data = err?.response?.data;
  return data?.error || data?.message || err?.message || "Có lỗi xảy ra";
}

export default function ScheduleManagementPanel({
  open, onClose, zones, shifts, onUpdate,
}: ScheduleManagementPanelProps) {
  const [tab, setTab] = useState<"zones" | "shifts">("zones");
  const [saving, setSaving] = useState(false);
  const [error, setError] = useState<string | null>(null);

  const [zoneFloor, setZoneFloor] = useState("1");
  const [zoneName, setZoneName] = useState("");

  const [shiftName, setShiftName] = useState("");
  const [startTime, setStartTime] = useState("07:30");
  const [endTime, setEndTime] = useState("11:30");
  const [minStaff, setMinStaff] = useState("1");

  const handleCreateZone = async () => {
    setSaving(true);
    setError(null);
    try {
      await api.createScheduleZone({ floor: Number(zoneFloor) || 1, zoneName: zoneName.trim() || `Tầng ${zoneFloor}` });
      setZoneName("");
      onUpdate();
    } catch (err: any) {
      setError(getApiError(err));
    } finally {
      setSaving(false);
    }
  };

  const handleDeleteZone = async (id: string) => {
    try {
      const assignments = await api.getScheduleAssignments({ zoneId: id });
      const active = assignments.items.filter((a: any) => a.status === "scheduled" || a.status === "confirmed");
      if (active.length > 0 && !confirm(`Có ${active.length} ca trực đang chờ xử lý sử dụng khu vực này. Vẫn xóa?`)) return;
    } catch {}
    if (!confirm("Xóa khu vực này?")) return;
    setSaving(true);
    try {
      await api.deleteScheduleZone(id);
      onUpdate();
    } catch (err: any) {
      setError(getApiError(err));
    } finally {
      setSaving(false);
    }
  };

  const handleCreateShift = async () => {
    if (!shiftName.trim()) { setError("Vui lòng nhập tên ca"); return; }
    setSaving(true);
    setError(null);
    try {
      await api.createScheduleShift({
        name: shiftName.trim(),
        startTime, endTime,
        minStaff: Math.max(1, Number(minStaff) || 1),
      });
      setShiftName("");
      onUpdate();
    } catch (err: any) {
      setError(getApiError(err));
    } finally {
      setSaving(false);
    }
  };

  const handleDeleteShift = async (id: string) => {
    try {
      const assignments = await api.getScheduleAssignments({ shiftId: id });
      const active = assignments.items.filter((a: any) => a.status === "scheduled" || a.status === "confirmed");
      if (active.length > 0 && !confirm(`Có ${active.length} ca trực đang chờ xử lý sử dụng ca này. Vẫn xóa?`)) return;
    } catch {}
    if (!confirm("Xóa ca trực này?")) return;
    setSaving(true);
    try {
      await api.deleteScheduleShift(id);
      onUpdate();
    } catch (err: any) {
      setError(getApiError(err));
    } finally {
      setSaving(false);
    }
  };

  const createDefaults = async () => {
    setSaving(true);
    setError(null);
    try {
      if (!zones.length) {
        await Promise.all([
          api.createScheduleZone({ floor: 1, zoneName: "Tầng 1" }),
          api.createScheduleZone({ floor: 2, zoneName: "Tầng 2" }),
        ]);
      }
      if (!shifts.length) {
        await Promise.all([
          api.createScheduleShift({ name: "Ca sáng", startTime: "07:30", endTime: "11:30", minStaff: 1 }),
          api.createScheduleShift({ name: "Ca chiều", startTime: "13:00", endTime: "17:00", minStaff: 1 }),
          api.createScheduleShift({ name: "Ca tối", startTime: "17:30", endTime: "20:30", minStaff: 1 }),
        ]);
      }
      onUpdate();
    } catch (err: any) {
      setError(getApiError(err));
    } finally {
      setSaving(false);
    }
  };

  if (!open) return null;

  return (
    <div className="fixed inset-0 flex justify-end" style={{ zIndex: 1300 }}>
      <div className="absolute inset-0 bg-black/50" onClick={onClose} />
      <div className="relative bg-surface w-80 h-full shadow-xl border-l border-border flex flex-col animate-slide-in">
        <div className="flex items-center justify-between px-4 py-3 border-b border-border">
          <h2 className="font-serif text-sm font-semibold text-primary">Quản lý lịch trực</h2>
          <button onClick={onClose} className="text-text-3 hover:text-text transition text-sm">&times;</button>
        </div>

        <div className="flex border-b border-border">
          <button
            onClick={() => setTab("zones")}
            className={`flex-1 py-2 text-xs font-medium transition border-b-2 ${
              tab === "zones"
                ? "border-primary text-primary"
                : "border-transparent text-text-3 hover:text-text-2"
            }`}
          >
            Khu vực
          </button>
          <button
            onClick={() => setTab("shifts")}
            className={`flex-1 py-2 text-xs font-medium transition border-b-2 ${
              tab === "shifts"
                ? "border-primary text-primary"
                : "border-transparent text-text-3 hover:text-text-2"
            }`}
          >
            Ca trực
          </button>
        </div>

        <div className="flex-1 overflow-y-auto p-4 space-y-4">
          {error && (
            <div className="text-xs text-error bg-error/10 border border-error/20 rounded-md px-2.5 py-1.5">
              {error}
            </div>
          )}

          {tab === "zones" && (
            <>
              <div className="space-y-2">
                {zones.length === 0 && (
                  <p className="text-xs text-text-3 italic">Chưa có khu vực nào</p>
                )}
                {zones.map((z) => (
                  <div key={z.id} className="flex items-center justify-between px-2.5 py-1.5 rounded-md bg-surface-2 border border-border">
                    <div>
                      <div className="text-xs font-medium text-text">{z.zoneName}</div>
                      <div className="text-[10px] text-text-3">Tầng {z.floor}</div>
                    </div>
                    <button
                      onClick={() => handleDeleteZone(z.id)}
                      className="text-error/60 hover:text-error transition text-xs"
                    >
                      &times;
                    </button>
                  </div>
                ))}
              </div>

              <div className="space-y-2 pt-2 border-t border-border">
                <div className="flex gap-1.5">
                  <input
                    type="number"
                    min={1}
                    value={zoneFloor}
                    onChange={(e) => setZoneFloor(e.target.value)}
                    className="w-16 px-2 py-1.5 rounded-md bg-surface-2 border border-border text-xs text-text focus:outline-none focus:border-primary"
                    placeholder="Tầng"
                  />
                  <input
                    value={zoneName}
                    onChange={(e) => setZoneName(e.target.value)}
                    className="flex-1 px-2 py-1.5 rounded-md bg-surface-2 border border-border text-xs text-text focus:outline-none focus:border-primary placeholder:text-text-3/50"
                    placeholder="Tên khu vực"
                  />
                  <button
                    onClick={handleCreateZone}
                    disabled={saving}
                    className="px-2.5 py-1.5 rounded-md text-xs font-medium text-bg bg-primary hover:bg-primary-dark transition disabled:opacity-50"
                  >
                    Thêm
                  </button>
                </div>
              </div>
            </>
          )}

          {tab === "shifts" && (
            <>
              <div className="space-y-2">
                {shifts.length === 0 && (
                  <p className="text-xs text-text-3 italic">Chưa có ca trực nào</p>
                )}
                {shifts.map((s) => (
                  <div key={s.id} className="flex items-center justify-between px-2.5 py-1.5 rounded-md bg-surface-2 border border-border">
                    <div>
                      <div className="text-xs font-medium text-text">{s.name}</div>
                      <div className="text-[10px] text-text-3">
                        {s.startTime?.slice(0, 5)}-{s.endTime?.slice(0, 5)} &middot; {s.minStaff} NV
                      </div>
                    </div>
                    <button
                      onClick={() => handleDeleteShift(s.id)}
                      className="text-error/60 hover:text-error transition text-xs"
                    >
                      &times;
                    </button>
                  </div>
                ))}
              </div>

              <div className="space-y-2 pt-2 border-t border-border">
                <input
                  value={shiftName}
                  onChange={(e) => setShiftName(e.target.value)}
                  className="w-full px-2 py-1.5 rounded-md bg-surface-2 border border-border text-xs text-text focus:outline-none focus:border-primary placeholder:text-text-3/50"
                  placeholder="Tên ca (vd: Ca sáng)"
                />
                <div className="flex gap-1.5">
                  <input
                    type="time"
                    value={startTime}
                    onChange={(e) => setStartTime(e.target.value)}
                    className="flex-1 px-2 py-1.5 rounded-md bg-surface-2 border border-border text-xs text-text focus:outline-none focus:border-primary"
                  />
                  <span className="text-xs text-text-3 self-center">&ndash;</span>
                  <input
                    type="time"
                    value={endTime}
                    onChange={(e) => setEndTime(e.target.value)}
                    className="flex-1 px-2 py-1.5 rounded-md bg-surface-2 border border-border text-xs text-text focus:outline-none focus:border-primary"
                  />
                </div>
                <div className="flex items-center gap-2">
                  <label className="text-[11px] text-text-3 whitespace-nowrap">Số NV tối thiểu:</label>
                  <input
                    type="number"
                    min={1}
                    value={minStaff}
                    onChange={(e) => setMinStaff(e.target.value)}
                    className="w-16 px-2 py-1.5 rounded-md bg-surface-2 border border-border text-xs text-text focus:outline-none focus:border-primary"
                  />
                  <button
                    onClick={handleCreateShift}
                    disabled={saving}
                    className="ml-auto px-2.5 py-1.5 rounded-md text-xs font-medium text-bg bg-primary hover:bg-primary-dark transition disabled:opacity-50"
                  >
                    Thêm
                  </button>
                </div>
              </div>
            </>
          )}
        </div>

        <div className="px-4 py-3 border-t border-border">
          <button
            onClick={createDefaults}
            disabled={saving}
            className="w-full py-2 rounded-md text-xs font-medium text-text-2 bg-surface-2 hover:bg-surface-3 transition disabled:opacity-50"
          >
            {saving ? "Đang xử lý..." : "Tạo mẫu (2 khu vực + 3 ca)"}
          </button>
        </div>
      </div>
    </div>
  );
}
</file>

<file path="src/components/staff-schedule/SwapsViewPanel.tsx">
"use client";

import { useEffect, useState } from "react";
import api from "@/lib/api-client";
import type { ShiftSwap, ScheduleStaff } from "@/lib/types";

interface Props {
  open: boolean;
  onClose: () => void;
}

function getApiError(err: any): string {
  const data = err?.response?.data;
  return data?.error || data?.message || err?.message || "Có lỗi xảy ra";
}

const STATUS_LABELS: Record<string, { label: string; color: string }> = {
  pending: { label: "Chờ xử lý", color: "#f59e0b" },
  accepted: { label: "Đã chấp nhận", color: "#10b981" },
  rejected: { label: "Đã từ chối", color: "#ef4444" },
  cancelled: { label: "Đã hủy", color: "#6b7280" },
  expired: { label: "Hết hạn", color: "#6b7280" },
};

export default function SwapsViewPanel({ open, onClose }: Props) {
  const [swaps, setSwaps] = useState<ShiftSwap[]>([]);
  const [staff, setStaff] = useState<ScheduleStaff[]>([]);
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState<string | null>(null);
  const [filter, setFilter] = useState<string>("pending");
  const [respondingId, setRespondingId] = useState<string | null>(null);

  const today = new Date().toISOString().slice(0, 10);

  const loadData = async () => {
    setLoading(true);
    setError(null);
    try {
      const [swapList, staffList] = await Promise.all([
        api.listAllSwaps({ status: filter === "all" ? undefined : filter }),
        api.getScheduleStaffOptions(),
      ]);
      setSwaps(swapList);
      setStaff(staffList);
    } catch (err) {
      setError(getApiError(err));
    } finally {
      setLoading(false);
    }
  };

  useEffect(() => {
    if (open) loadData();
  }, [open, filter]);

  const handleRespond = async (id: string, action: "accepted" | "rejected") => {
    if (!confirm(action === "accepted" ? "Chấp nhận yêu cầu đổi ca?" : "Từ chối yêu cầu đổi ca?")) return;
    setRespondingId(id);
    try {
      await api.respondSwap(id, { action });
      await loadData();
    } catch (err) {
      setError(getApiError(err));
    } finally {
      setRespondingId(null);
    }
  };

  const getStaffName = (id: string) => {
    const s = staff.find((x) => x.id === id);
    return s?.fullName || s?.email || "Nhân viên";
  };

  const isStale = (swap: ShiftSwap) => {
    const workDate = swap.requesterAssignment?.workDate;
    return workDate && workDate < today;
  };

  const visibleSwaps = filter === "pending"
    ? swaps.filter((s) => !isStale(s))
    : swaps;

  if (!open) return null;

  return (
    <div className="fixed inset-0 flex justify-end" style={{ zIndex: 1300 }}>
      <div className="absolute inset-0 bg-black/50" onClick={onClose} />
      <div className="relative bg-surface w-96 h-full shadow-xl border-l border-border flex flex-col animate-slide-in">
        <div className="flex items-center justify-between px-4 py-3 border-b border-border">
          <h2 className="font-serif text-sm font-semibold text-primary">Yêu cầu đổi ca</h2>
          <button onClick={onClose} className="text-text-3 hover:text-text transition text-sm">&times;</button>
        </div>

        <div className="flex border-b border-border">
          {["pending", "accepted", "rejected", "all"].map((f) => (
            <button
              key={f}
              onClick={() => setFilter(f)}
              className={`flex-1 py-2 text-xs font-medium transition border-b-2 ${
                filter === f
                  ? "border-primary text-primary"
                  : "border-transparent text-text-3 hover:text-text-2"
              }`}
            >
              {f === "pending" ? "Chờ xử lý" : f === "accepted" ? "Chấp nhận" : f === "rejected" ? "Từ chối" : "Tất cả"}
            </button>
          ))}
        </div>

        <div className="flex-1 overflow-y-auto p-4 space-y-3">
          {error && (
            <div className="text-xs text-error bg-error/10 border border-error/20 rounded-md px-2.5 py-1.5">
              {error}
            </div>
          )}

          {loading && (
            <p className="text-xs text-text-3 italic text-center py-4">Đang tải...</p>
          )}

          {!loading && visibleSwaps.length === 0 && (
            <p className="text-xs text-text-3 italic text-center py-4">Không có yêu cầu nào</p>
          )}

          {visibleSwaps.map((swap) => {
            const status = STATUS_LABELS[swap.status] || { label: swap.status, color: "#6b7280" };
            const stale = isStale(swap);
            return (
              <div key={swap.id} className="rounded-lg border border-border bg-surface-2 p-3 space-y-2">
                <div className="flex items-center justify-between">
                  <span className="text-xs font-medium text-text">
                    {getStaffName(swap.requesterStaffId)} → {getStaffName(swap.targetStaffId)}
                  </span>
                  <span
                    className="text-[10px] font-semibold px-2 py-0.5 rounded-full"
                    style={{ backgroundColor: `${status.color}20`, color: status.color }}
                  >
                    {status.label}
                  </span>
                  {stale && (
                    <span className="text-[10px] font-semibold px-2 py-0.5 rounded-full bg-gray-200 text-gray-500">
                      Quá hạn
                    </span>
                  )}
                </div>
                <div className="text-[11px] text-text-2 space-y-1">
                  <div>
                    <span className="font-medium">Yêu cầu:</span>{" "}
                    {swap.requesterAssignment?.shift?.name || "N/A"} — {swap.requesterAssignment?.workDate || ""}
                  </div>
                  {swap.targetAssignment && (
                    <div>
                      <span className="font-medium">Đối tượng:</span>{" "}
                      {swap.targetAssignment.shift?.name || "N/A"} — {swap.targetAssignment.workDate}
                    </div>
                  )}
                </div>
                {swap.reason && (
                  <div className="text-[11px] text-text-3 italic">Lý do: {swap.reason}</div>
                )}
                {swap.responseNote && (
                  <div className="text-[11px] text-text-3 italic">Phản hồi: {swap.responseNote}</div>
                )}
                {swap.status === "pending" && !stale && (
                  <div className="flex gap-2 pt-1">
                    <button
                      onClick={() => handleRespond(swap.id, "accepted")}
                      disabled={respondingId === swap.id}
                      className="flex-1 py-1.5 rounded-md text-xs font-medium text-white bg-emerald-600 hover:bg-emerald-700 transition disabled:opacity-50"
                    >
                      {respondingId === swap.id ? "..." : "Chấp nhận"}
                    </button>
                    <button
                      onClick={() => handleRespond(swap.id, "rejected")}
                      disabled={respondingId === swap.id}
                      className="flex-1 py-1.5 rounded-md text-xs font-medium text-white bg-red-500 hover:bg-red-600 transition disabled:opacity-50"
                    >
                      {respondingId === swap.id ? "..." : "Từ chối"}
                    </button>
                  </div>
                )}
              </div>
            );
          })}
        </div>
      </div>
    </div>
  );
}
</file>

