    }
  };

  const reset = () => {
    setImageFile(null);
    setJobId(null);
    setResult(null);
    setError("");
    setIsLoading(false);
  };

  return (
    <Stack spacing={3} sx={{ maxWidth: 920, mx: "auto" }}>
