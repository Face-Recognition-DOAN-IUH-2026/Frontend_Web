  const exitCamRef = useRef<HTMLImageElement>(null);
  const entryCanvasRef = useRef<HTMLCanvasElement>(null);
  const exitCanvasRef = useRef<HTMLCanvasElement>(null);
  const overlayTimeoutRef = useRef<ReturnType<typeof setTimeout>>(null);
  const [step, setStep] = useState<Step>("idle");
  const [mssv, setMssv] = useState("");
  const [lookup, setLookup] = useState<PatronLookupResult | null>(null);
  const [result, setResult] = useState<KioskResult | null>(null);
  const [loading, setLoading] = useState(false);
  const [captured, setCaptured] = useState<string | null>(null);
  const [entryTs] = useState(() => Date.now());
  const [exitTs] = useState(() => Date.now());
  const [toasts, setToasts] = useState<Toast[]>([]);
  const [recentLogs, setRecentLogs] = useState<AccessLogPublic[]>([]);
  const [historyDateFrom, setHistoryDateFrom] = useState("");
  const [historyDateTo, setHistoryDateTo] = useState("");
  const [frequency, setFrequency] = useState<AccessFrequencyDay[]>([]);
  const [freqLoading, setFreqLoading] = useState(false);

  const tomorrow = new Date();
  tomorrow.setDate(tomorrow.getDate() + 1);
  const defaultIssueDate = tomorrow.toISOString().split("T")[0];
  const defaultExpiry = new Date();
  defaultExpiry.setFullYear(defaultExpiry.getFullYear() + 1);
  const defaultExpiryStr = defaultExpiry.toISOString().split("T")[0];

  const [form, setForm] = useState({
    full_name: "",
    student_code: "",
    class_name: "",
  });

  const [cameraReady, setCameraReady] = useState(false);
  const [isCameraOn, setIsCameraOn] = useState(false);
  const [statusText, setStatusText] = useState("");

  const [isMultiCapturing, setIsMultiCapturing] = useState(false);
  const [captureAngles, setCaptureAngles] = useState<{ angle: string; label: string; file: File | null }[]>([]);
  const [currentCaptureIdx, setCurrentCaptureIdx] = useState(-1);
  const [captureCountdown, setCaptureCountdown] = useState<number | null>(null);
  const [camStatus, setCamStatus] = useState<"checking" | "available" | "unavailable" | "blocked">("checking");
  const [entryCamOk, setEntryCamOk] = useState<boolean | null>(null);
  const [exitCamOk, setExitCamOk] = useState<boolean | null>(null);
  const [cameraStatusList, setCameraStatusList] = useState<CameraStatus[]>([]);
  const [todayCounts, setTodayCounts] = useState({ entries: 0, exits: 0, no_match: 0, spoof: 0 });
  const [showCamDetail, setShowCamDetail] = useState(false);
  const [entryOverlay, setEntryOverlay] = useState<{ bbox?: [number, number, number, number]; landmarks?: [number, number][]; status?: string } | null>(null);
  const [exitOverlay, setExitOverlay] = useState<{ bbox?: [number, number, number, number]; landmarks?: [number, number][]; status?: string } | null>(null);

  const addToast = useCallback((t: Omit<Toast, "id">) => {
    const id = ++toastId;
    setToasts((prev) => [{ ...t, id }, ...prev.slice(0, 4)]);
    const timeout = setTimeout(() => {
      setToasts((prev) => prev.filter((x) => x.id !== id));
      toastTimeoutsRef.delete(id);
    }, 6000);
    toastTimeoutsRef.set(id, timeout);
  }, []);

  const stopCamera = useCallback(() => {
    if (readyTimeoutRef.current) clearTimeout(readyTimeoutRef.current);
    if (streamRef.current) {
      streamRef.current.getTracks().forEach((t) => t.stop());
      streamRef.current = null;
    }
    setIsCameraOn(false);
    setCameraReady(false);
  }, []);

  const OVERLAY_COLORS: Record<string, string> = {
    granted: "#22c55e",
    wrong_direction: "#eab308",
    expired: "#f97316",
    spoof: "#ef4444",
  };

  const drawFaceOverlay = useCallback((
    img: HTMLImageElement,
    canvas: HTMLCanvasElement,
    overlay: { bbox?: [number, number, number, number]; landmarks?: [number, number][] },
    status?: string,
  ) => {
    const rect = img.getBoundingClientRect();
    const scaleX = rect.width / (img.naturalWidth || 1);
    const scaleY = rect.height / (img.naturalHeight || 1);

    canvas.width = rect.width;
    canvas.height = rect.height;
    const ctx = canvas.getContext("2d");
    if (!ctx) return;

    ctx.clearRect(0, 0, canvas.width, canvas.height);

    if (overlay.bbox) {
      const [x1, y1, x2, y2] = overlay.bbox;
      ctx.strokeStyle = OVERLAY_COLORS[status || "granted"] || "#22c55e";
      ctx.lineWidth = 3;
      ctx.strokeRect(x1 * scaleX, y1 * scaleY, (x2 - x1) * scaleX, (y2 - y1) * scaleY);
    }

    if (overlay.landmarks) {
      overlay.landmarks.forEach(([x, y]) => {
        ctx.beginPath();
        ctx.arc(x * scaleX, y * scaleY, 4, 0, 2 * Math.PI);
        ctx.fillStyle = "#ef4444";
        ctx.fill();
      });
    }
  }, []);

  useEffect(() => {
    return () => stopCamera();
  }, [stopCamera]);

  const startCamera = useCallback(async () => {
    try {
      if (streamRef.current) {
        streamRef.current.getTracks().forEach((t) => t.stop());
      }
      setCameraReady(false);

      const stream = await navigator.mediaDevices.getUserMedia({
        video: {
          facingMode: "user",
          width: { ideal: 640, min: 320 },
          height: { ideal: 480, min: 240 },
        },
        audio: false,
      });

      streamRef.current = stream;
      setIsCameraOn(true);
    } catch (err: any) {
      if (err.name === "NotAllowedError") {
        addToast({ type: "error", message: "Không có quyền truy cập camera. Vui lòng cho phép camera trong trình duyệt." });
      } else if (err.name === "NotFoundError") {
        addToast({ type: "error", message: "Không tìm thấy camera trên thiết bị." });
      } else {
        addToast({ type: "error", message: `Lỗi camera: ${err.message}` });
      }
      setIsCameraOn(false);
    }
  }, [addToast]);

  useEffect(() => {
    if (!isCameraOn || !videoRef.current || !streamRef.current) return;

    const video = videoRef.current;
    const stream = streamRef.current;

    const onReady = () => setCameraReady(true);

    video.onloadedmetadata = onReady;
    video.onplaying = onReady;
    video.onerror = () => addToast({ type: "error", message: "Lỗi camera" });
    video.srcObject = stream;

    if (video.readyState >= 2) onReady();

    readyTimeoutRef.current = setTimeout(() => setCameraReady(true), 1500);

    return () => {
      if (readyTimeoutRef.current) clearTimeout(readyTimeoutRef.current);
      video.onloadedmetadata = null;
      video.onplaying = null;
      video.onerror = null;
      video.srcObject = null;
    };
  }, [isCameraOn, addToast]);

  const captureImage = useCallback((): Promise<File> => {
    return new Promise((resolve, reject) => {
      const video = videoRef.current;
      if (!video || !video.videoWidth) {
        reject(new Error("Camera chưa sẵn sàng"));
        return;
      }
      const canvas = document.createElement("canvas");
      canvas.width = video.videoWidth;
      canvas.height = video.videoHeight;
      const ctx = canvas.getContext("2d");
      if (!ctx) {
        reject(new Error("Không thể tạo canvas"));
        return;
      }
      ctx.drawImage(video, 0, 0);
      canvas.toBlob((blob) => {
        if (blob) {
          const file = new File([blob], "face_capture.jpg", { type: "image/jpeg" });
          setCaptured(canvas.toDataURL("image/jpeg"));
          resolve(file);
        } else {
          reject(new Error("Không thể tạo ảnh"));
        }
      }, "image/jpeg", 0.9);
    });
  }, []);

  const handleLookup = async () => {
    if (!mssv.trim()) return;
    setLoading(true);
    try {
      const res = await api.kioskLookup(mssv.trim());
      setLookup(res);
      if (res.exists && res.has_face && !res.is_expired) {
        setStep("verify");
        await startCamera();
      } else if (res.exists && !res.has_face) {
        setStep("enroll_form");
        await startCamera();
      } else if (res.exists && res.is_expired) {
        setStep("result");
        setResult({ success: false, message: "Thẻ hội viên đã hết hạn", patron: null, job_id: null });
      } else {
        setStep("enroll_form");
        await startCamera();
      }
    } finally {
      setLoading(false);
    }
  };

  const handleNewRegistration = async () => {
    setMssv("");
    setStep("enroll_form");
    await startCamera();
  };

  const pollTask = useCallback(async (jobId: string, intervalMs = 1000, timeoutMs = 30000): Promise<any> => {
    const start = Date.now();
    while (Date.now() - start < timeoutMs) {
      await new Promise((r) => setTimeout(r, intervalMs));
      try {
        const task = await api.getTaskStatus(jobId);
        if (task.status === "SUCCESS") return task.result;
        if (task.status === "FAILURE") throw new Error(task.result?.error || "Task failed");
        setStatusText(task.result?.status === "granted" ? "Đã ghi nhận..." : "Đang xử lý...");
      } catch {
      }
    }
    throw new Error("Timeout waiting for result");
  }, []);

  const CAPTURE_ANGLE_SEQUENCE = [
    { angle: "frontal", label: "Nhìn thẳng", icon: Eye, tip: "Giữ mặt thẳng, mắt mở tự nhiên" },
    { angle: "right", label: "Quay phải", icon: ArrowLeft, tip: "Xoay đầu phải 30°" },
    { angle: "left", label: "Quay trái", icon: ArrowRight, tip: "Xoay đầu trái 30°" },
    { angle: "down", label: "Cúi xuống", icon: ArrowDown, tip: "Cúi nhẹ cằm xuống" },
  ];

  useEffect(() => {
    if (currentCaptureIdx < 0 || currentCaptureIdx >= CAPTURE_ANGLE_SEQUENCE.length) return;
    if (!cameraReady || !isMultiCapturing) return;

    let cancelled = false;
    let c = 3;
    setCaptureCountdown(c);

    const timer = setInterval(async () => {
      c--;
      if (cancelled) { clearInterval(timer); return; }

      if (c <= 0) {
        clearInterval(timer);
        setCaptureCountdown(null);

        try {
          const file = await captureImage();
          if (!cancelled) {
            setCaptureAngles((prev) => [...prev, { ...CAPTURE_ANGLE_SEQUENCE[currentCaptureIdx], file }]);
            const nextIdx = currentCaptureIdx + 1;
            if (nextIdx >= CAPTURE_ANGLE_SEQUENCE.length) {
              setIsMultiCapturing(false);
              setCurrentCaptureIdx(-1);
            } else {
              setTimeout(() => { if (!cancelled) setCurrentCaptureIdx(nextIdx); }, 600);
            }
          }
        } catch (err: any) {
          if (!cancelled) {
            addToast({ type: "error", message: `Lỗi chụp: ${err.message}` });
            setIsMultiCapturing(false);
            setCurrentCaptureIdx(-1);
            setCaptureCountdown(null);
            setLoading(false);
            setStatusText("");
          }
        }
      } else {
        setCaptureCountdown(c);
      }
    }, 1000);

    return () => { cancelled = true; clearInterval(timer); };
  }, [currentCaptureIdx, cameraReady, isMultiCapturing, captureImage, addToast]);

  const handleEnroll = async () => {
    if (!form.full_name) return;
    setLoading(true);
    setStatusText("Đang chuẩn bị chụp...");
    setCaptureAngles([]);
    setIsMultiCapturing(true);
    setCurrentCaptureIdx(0);
  };

  useEffect(() => {
    if (captureAngles.length !== CAPTURE_ANGLE_SEQUENCE.length || isMultiCapturing) return;
    if (captureAngles.length === 0) return;

    (async () => {
      setStatusText("Đang gửi dữ liệu...");
      try {
        const frontal = captureAngles.find((a) => a.angle === "frontal");
        const right = captureAngles.find((a) => a.angle === "right");
        const left = captureAngles.find((a) => a.angle === "left");
        const down = captureAngles.find((a) => a.angle === "down");
        if (!frontal?.file || !right?.file || !left?.file || !down?.file) {
          throw new Error("Thiếu ảnh chụp");
        }

        stopCamera();
        const studentCode = form.student_code || mssv;
        const res = await api.kioskBatchEnroll(
          frontal.file, right.file, left.file, down.file,
          form.full_name, studentCode,
          defaultExpiryStr,
          form.class_name || undefined,
        );

        if (res.success) {
          addToast({ type: "info", message: "Đã tạo độc giả với đầy đủ 4 góc khuôn mặt" });
        }
        setResult(res);
        setStep("result");
        setForm({ full_name: "", student_code: "", class_name: "" });
      } catch (err: any) {
        const msg = getErrorMessage(err) || "Đăng ký thất bại";
        setResult({ success: false, message: msg, patron: null, job_id: null });
        setStep("result");
        addToast({ type: "error", message: msg });
      } finally {
        setLoading(false);
        setStatusText("");
      }
    })();
  }, [captureAngles, isMultiCapturing]);

  const handleVerify = async () => {
    setLoading(true);
    setStatusText("Đang chụp ảnh...");
    try {
      const imageFile = await captureImage();
      stopCamera();
      setStatusText("Đang gửi dữ liệu...");
      const res = await api.kioskEnter(imageFile, mssv);
      if (res.job_id) {
        setStatusText("Đang xác thực khuôn mặt...");
        const taskResult = await pollTask(res.job_id);
        const success = taskResult?.status === "success";
        const confidence = taskResult?.score ?? taskResult?.confidence;
        setResult({
          success,
          message: success
            ? `Xác thực thành công — ${taskResult?.access_type === "exit" ? "Ra" : "Vào"} thư viện`
            : (taskResult?.error || "Xác thực thất bại"),
          patron: res.patron,
          job_id: res.job_id,
          confidence,
        });
      } else {
        setResult(res);
      }
      setStep("result");
    } catch (err: any) {
      const msg = getErrorMessage(err) || "Xác thực thất bại";
      setResult({ success: false, message: msg, patron: null, job_id: null });
      setStep("result");
      addToast({ type: "error", message: msg });
    } finally {
      setLoading(false);
      setStatusText("");
    }
  };

  const reset = () => {
    setStep("idle");
    setMssv("");
    setLookup(null);
    setResult(null);
    setCaptured(null);
    setIsMultiCapturing(false);
    setCaptureAngles([]);
    setCurrentCaptureIdx(-1);
    setCaptureCountdown(null);
    stopCamera();
  };

  const sseConnectedRef = useRef(false);

  useEffect(() => {
    if (sseConnectedRef.current) return;
    sseConnectedRef.current = true;
    const cleanup = api.connectAccessSSE((event: CameraEvent) => {
      console.log("[SSE] event:", JSON.stringify(event));
      if (event.bbox || event.landmarks) {
        const overlay = { bbox: event.bbox, landmarks: event.landmarks };
        if (event.camera_id === ENTRY_CAM_ID) {
          setEntryOverlay({ ...overlay, status: event.status });
          if (entryCamRef.current && entryCanvasRef.current) {
            drawFaceOverlay(entryCamRef.current, entryCanvasRef.current, overlay, event.status);
          }
        } else if (event.camera_id === EXIT_CAM_ID) {
          setExitOverlay({ ...overlay, status: event.status });
          if (exitCamRef.current && exitCanvasRef.current) {
            drawFaceOverlay(exitCamRef.current, exitCanvasRef.current, overlay, event.status);
          }
        }
        if (overlayTimeoutRef.current) clearTimeout(overlayTimeoutRef.current);
        overlayTimeoutRef.current = setTimeout(() => {
          setEntryOverlay(null);
          setExitOverlay(null);
          [entryCanvasRef, exitCanvasRef].forEach((ref) => {
            const c = ref.current;
            if (c) {
              const ctx = c.getContext("2d");
              ctx?.clearRect(0, 0, c.width, c.height);
            }
          });
        }, 2000);
      }
      if (event.status === "granted") {
        const type = event.access_type === "entry" ? "entry" : "exit";
        addToast({
          type,
          message: `${event.full_name} — ${type === "entry" ? "Vào" : "Ra"} thư viện`,
          patron_name: event.full_name,
        });
        setTodayCounts((c) => ({ ...c, [type === "entry" ? "entries" : "exits"]: c[type === "entry" ? "entries" : "exits"] + 1 }));
        setRecentLogs((prev) => {
          const newLog: AccessLogPublic = {
            id: `sse-${Date.now()}`,
            patron_id: event.patron_id || null,
            patron_name: event.full_name || null,
            student_code: event.student_code || null,
            access_type: event.access_type || "entry",
            verify_method: "face",
            confidence: event.score || null,
            camera_id: event.camera_id,
            access_time: new Date().toISOString(),
            status: "success",
          };
          return [newLog, ...prev.slice(0, 19)];
        });
      } else if (event.status === "no_match") {
        setTodayCounts((c) => ({ ...c, no_match: c.no_match + 1 }));
        addToast({ type: "info", message: event.full_name ? `${event.full_name} — chưa có lượt vào, bỏ qua` : "Khuôn mặt mới — không nhận diện được" });
      } else if (event.status === "expired") {
        addToast({ type: "error", message: `${event.full_name} — thẻ đã hết hạn` });
      } else if (event.status === "spoof") {
        setTodayCounts((c) => ({ ...c, spoof: c.spoof + 1 }));
        addToast({ type: "error", message: "Phát hiện giả mạo!" });
      } else if (event.status === "error") {
        addToast({ type: "error", message: `Lỗi xử lý: ${event.error || "không xác định"}` });
      } else {
        addToast({ type: "info", message: `${event.status} — ${event.full_name || ""}` });
      }
    });
    return () => {
      sseConnectedRef.current = false;
      cleanup();
    };
  }, [addToast]);

  useEffect(() => {
    if (!navigator.mediaDevices?.enumerateDevices) {
      setCamStatus("unavailable");
      return;
    }
    navigator.mediaDevices.enumerateDevices().then((devices) => {
      const hasCam = devices.some((d) => d.kind === "videoinput");
      setCamStatus(hasCam ? "available" : "unavailable");
    }).catch(() => setCamStatus("blocked"));
  }, []);

  const loadHistory = useCallback(async () => {
    try {
      const data = await api.getAccessLogs({
        dateFrom: historyDateFrom || undefined,
        dateTo: historyDateTo || undefined,
        limit: 50,
      });
      setRecentLogs(data.items ?? []);
    } catch {}
  }, [historyDateFrom, historyDateTo]);

  useEffect(() => { loadHistory(); }, [loadHistory]);

  useEffect(() => {
    (async () => {
      setFreqLoading(true);
      try {
        const data = await api.getAccessFrequency();
        setFrequency(data.daily);
      } catch {
      } finally {
        setFreqLoading(false);
      }
    })();
  }, []);

  useEffect(() => {
    const poll = async () => {
      try { setCameraStatusList(Array.isArray(await api.getCameraStatus()) ? await api.getCameraStatus() : []); } catch {}
    };
    poll();
    const iv = setInterval(poll, 10000);
    return () => clearInterval(iv);
  }, []);

  return (
    <div className="space-y-6">
      <button onClick={() => router.push("/dashboard")} className="text-blue-600 hover:underline text-sm">&larr; Quay lại Dashboard</button>
      <h1 className="text-3xl font-bold">Gate Kiosk</h1>

      {toasts.length > 0 && (
        <div className="fixed top-4 right-4 z-50 space-y-2 max-w-sm">
          {toasts.map((t) => (
            <div
              key={t.id}
              className={`px-4 py-3 rounded-lg shadow-lg text-white text-sm font-medium animate-slide-in ${
                t.type === "entry" ? "bg-green-600" :
                t.type === "exit" ? "bg-orange-600" :
                t.type === "error" ? "bg-red-600" : "bg-blue-600"
              }`}
            >
              {t.patron_name && <strong>{t.patron_name}</strong>} {t.message}
            </div>
          ))}
        </div>
      )}

      <div className="grid grid-cols-2 gap-4">
          <div className="border rounded-lg overflow-hidden bg-black">
            <div className="bg-gray-800 text-white px-3 py-1 text-sm font-medium flex items-center gap-2">
              <span>Cổng vào — Camera 1</span>
              <span className={`inline-block w-2 h-2 rounded-full ${entryCamOk === null ? "bg-yellow-400" : entryCamOk ? "bg-green-400" : "bg-red-400"}`} />
            </div>
            <div className="relative">
              <img ref={entryCamRef} src={`${ENTRY_CAM}?_t=${entryTs}`} className="w-full h-64 object-contain" alt="Entry cam"
                onLoad={() => setEntryCamOk(true)} onError={() => setEntryCamOk(false)} />
              <canvas ref={entryCanvasRef} className="absolute inset-0 w-full h-full pointer-events-none z-10" />
            </div>
          </div>
          <div className="border rounded-lg overflow-hidden bg-black">
            <div className="bg-gray-800 text-white px-3 py-1 text-sm font-medium flex items-center gap-2">
              <span>Cổng ra — Camera 2</span>
              <span className={`inline-block w-2 h-2 rounded-full ${exitCamOk === null ? "bg-yellow-400" : exitCamOk ? "bg-green-400" : "bg-red-400"}`} />
            </div>
            <div className="relative">
              <img ref={exitCamRef} src={`${EXIT_CAM}?_t=${exitTs}`} className="w-full h-64 object-contain" alt="Exit cam"
                onLoad={() => setExitCamOk(true)} onError={() => setExitCamOk(false)} />
              <canvas ref={exitCanvasRef} className="absolute inset-0 w-full h-full pointer-events-none z-10" />
            </div>
          </div>
      </div>

      {/* Camera stats bar */}
      <div className="grid grid-cols-2 md:grid-cols-4 gap-3">
        <div className="bg-green-50 border border-green-200 rounded-lg p-3 text-center">
          <p className="text-2xl font-bold text-green-700">{todayCounts.entries}</p>
          <p className="text-xs text-green-600">Vào hôm nay</p>
        </div>
        <div className="bg-orange-50 border border-orange-200 rounded-lg p-3 text-center">
          <p className="text-2xl font-bold text-orange-700">{todayCounts.exits}</p>
          <p className="text-xs text-orange-600">Ra hôm nay</p>
        </div>
        <div className="bg-gray-50 border border-gray-200 rounded-lg p-3 text-center">
          <p className="text-2xl font-bold text-gray-700">{todayCounts.no_match}</p>
          <p className="text-xs text-gray-600">Không nhận diện</p>
        </div>
        <div className="bg-red-50 border border-red-200 rounded-lg p-3 text-center">
          <p className="text-2xl font-bold text-red-700">{todayCounts.spoof}</p>
          <p className="text-xs text-red-600">Giả mạo</p>
        </div>
      </div>

      {/* Camera status detail */}
      {cameraStatusList.length > 0 && (
        <div>
          <button className="text-sm text-blue-600 hover:underline" onClick={() => setShowCamDetail(!showCamDetail)}>
            {showCamDetail ? "Ẩn" : "Chi tiết"} trạng thái camera
          </button>
          {showCamDetail && (
            <div className="mt-2 space-y-2">
              {cameraStatusList.map((cs) => (
                <div key={cs.camera_id} className="border rounded-lg p-3 bg-white text-sm">
                  <div className="flex items-center justify-between">
                    <span className="font-medium">{cs.camera_id}</span>
                    <span className={`px-2 py-0.5 rounded-full text-xs font-medium ${
                      cs.connected ? "bg-green-100 text-green-800" : "bg-red-100 text-red-800"
                    }`}>{cs.connected ? "Online" : "Offline"}</span>
                  </div>
                  <div className="mt-1 text-gray-500 grid grid-cols-3 gap-2 text-xs">
                    <span>Frames: {cs.frames_processed}</span>
                    <span>Lần thử lại: {cs.retry_count}</span>
                    <span>{cs.last_frame_time ? `Cuối: ${new Date(cs.last_frame_time).toLocaleTimeString("vi-VN")}` : "Chưa có frame"}</span>
                  </div>
                  {cs.last_error && <p className="text-red-500 text-xs mt-1">{cs.last_error}</p>}
                  {!cs.connected && (
                    <button className="mt-2 text-xs text-blue-600 hover:underline"
                      onClick={() => api.reconnectCamera(cs.camera_id)}>Reconnect</button>
                  )}
                </div>
              ))}
            </div>
          )}
        </div>
      )}

      {step === "idle" && (
        <div className="max-w-md space-y-4">
          <div className="flex items-center gap-2 text-sm p-2 rounded-md bg-gray-50 border">
            <span className={`inline-block w-2.5 h-2.5 rounded-full ${
              camStatus === "checking" ? "bg-yellow-400 animate-pulse" :
              camStatus === "available" ? "bg-green-500" : "bg-red-500"
            }`} />
            <span>
              {camStatus === "checking" && "Đang kiểm tra camera..."}
              {camStatus === "available" && "Camera sẵn sàng"}
              {camStatus === "unavailable" && "Không tìm thấy camera — dùng upload ảnh"}
              {camStatus === "blocked" && "Camera bị chặn — cho phép camera trong trình duyệt"}
            </span>
          </div>

          <label className="block">
            <span className="text-sm font-medium">Nhập MSSV:</span>
            <input className="mt-1 block w-full px-3 py-2 border rounded-md" value={mssv} onChange={(e) => setMssv(e.target.value)} onKeyDown={(e) => e.key === "Enter" && handleLookup()} placeholder="MSSV" />
          </label>
          <div className="flex gap-2">
            <button className="px-4 py-2 bg-blue-600 text-white rounded-md" onClick={handleLookup} disabled={loading}>
              {loading ? "Đang kiểm tra..." : "Tra cứu"}
            </button>
            <button className="px-4 py-2 bg-green-600 text-white rounded-md" onClick={handleNewRegistration}>
              Đăng ký thẻ mới
            </button>
            {camStatus === "checking" && (
              <button className="px-4 py-2 bg-gray-200 text-gray-600 rounded-md text-sm" onClick={() => setCamStatus("unavailable")}>Bỏ qua</button>
            )}
          </div>
        </div>
      )}

      {(step === "enroll_form" || step === "verify") && (
        <div className="grid grid-cols-2 gap-6">
          <div>
            <div className="relative bg-black rounded-lg overflow-hidden">
              <video ref={videoRef} autoPlay playsInline muted className="w-full rounded-lg" />
              {!cameraReady && !isMultiCapturing && (
                <div className="absolute inset-0 flex items-center justify-center bg-black/50 text-white">
                  Đang mở camera...
                </div>
              )}
              {captureCountdown !== null && (() => {
                const cfg = CAPTURE_ANGLE_SEQUENCE[currentCaptureIdx];
                const ArrowIcon = cfg?.icon;
                return (
                  <div className="absolute inset-0 flex items-center justify-center bg-black/70">
                    <div className="text-center">
                      {ArrowIcon && (
                        <div className="animate-bounce mb-2">
                          <ArrowIcon className="w-10 h-10 mx-auto text-yellow-400" />
                        </div>
                      )}
                      <p className="text-white text-xl font-semibold mb-1">{cfg?.label}</p>
                      <p className="text-gray-300 text-sm mb-4">{cfg?.tip}</p>
                      <div className="flex justify-center gap-1 mb-2">
                        {CAPTURE_ANGLE_SEQUENCE.map((_, i) => (
                          <span
                            key={i}
                            className={`w-3 h-3 rounded-full ${i < captureAngles.length ? "bg-green-500" : i === currentCaptureIdx ? "bg-yellow-400" : "bg-gray-600"}`}
                          />
                        ))}
                      </div>
                      <p className="text-white text-5xl font-bold drop-shadow-lg">{captureCountdown}</p>
                    </div>
                  </div>
                );
              })()}
            </div>
            {captured && !isMultiCapturing && <img src={captured} className="w-full mt-2 rounded-lg border" />}
            {captureAngles.length > 0 && captureAngles.length < CAPTURE_ANGLE_SEQUENCE.length && (
              <div className="mt-2 text-sm text-green-600">
                Đã chụp: {captureAngles.map((a) => a.label).join(", ")}
              </div>
            )}
          </div>
          <div className="space-y-4">
            {step === "enroll_form" && (
              <>
                <h2 className="text-xl font-semibold">Đăng ký mới</h2>
                <p className="text-gray-600">Vui lòng nhìn vào camera và điền thông tin</p>
                {[
                  ["full_name", "Họ tên", "text"],
                  ["student_code", "MSSV", "text"],
                  ["class_name", "Lớp", "text"],
                ].map(([key, label, type]) => (
                  <label key={key} className="block">
                    <span className="text-sm font-medium">{label}:</span>
                    <input type={type as string}
                      className="mt-1 block w-full px-3 py-2 border rounded-md"
                      value={(form as any)[key] || ""}
                      onChange={(e) => setForm({ ...form, [key]: e.target.value })}
                    />
                  </label>
                ))}
                <p className="text-xs text-gray-500">Hạn thẻ: <strong>{defaultExpiryStr}</strong> (1 năm kể từ hôm nay)</p>
                <button className="px-4 py-2 bg-green-600 text-white rounded-md" onClick={handleEnroll} disabled={loading || isMultiCapturing}>
                  {loading ? "Đang đăng ký..." : isMultiCapturing ? "Đang chụp..." : "Đăng ký & Vào cổng"}
                </button>
              </>
            )}
            {step === "verify" && (
              <>
                <h2 className="text-xl font-semibold">Xác thực khuôn mặt</h2>
                <p className="text-gray-600">Đã tìm thấy thông tin. Vui lòng nhìn vào camera để xác thực.</p>
                <p><strong>Họ tên:</strong> {lookup?.patron?.full_name}</p>
                <p><strong>MSSV:</strong> {lookup?.patron?.student_code}</p>
                <button className="px-4 py-2 bg-green-600 text-white rounded-md" onClick={handleVerify} disabled={loading}>
                  {loading ? "Đang xác thực..." : "Vào cổng"}
                </button>
                {statusText && <p className="text-blue-600 text-sm animate-pulse">{statusText}</p>}
              </>
            )}
          </div>
        </div>
      )}

      {step === "result" && (
        <div className="space-y-4">
          {statusText && <p className="text-blue-600 text-sm animate-pulse">{statusText}</p>}
          <div className={`p-4 rounded-lg ${result?.success ? "bg-green-100" : "bg-red-100"}`}>
            <p className="text-lg font-semibold">{result?.success ? "Thành công" : "Thất bại"}</p>
            <p>{result?.message}</p>
            {result?.success && result?.confidence && (
              <p className="text-sm text-green-700">Độ chính xác: {(Number(result.confidence) * 100).toFixed(1)}%</p>
            )}
            {result?.patron && (
              <>
                <p><strong>Họ tên:</strong> {result.patron.full_name}</p>
                <p><strong>MSSV:</strong> {result.patron.student_code}</p>
              </>
            )}
          </div>
          <button onClick={reset} className="px-4 py-2 bg-blue-600 text-white rounded-md">Làm lại</button>
        </div>
      )}

      {frequency.length > 0 && (
        <FrequencyChart data={frequency} loading={freqLoading} />
      )}

      <div>
        <h2 className="text-xl font-semibold mb-3">Lịch sử ra vào gần đây</h2>
        <div className="flex flex-wrap gap-2 mb-3">
          <label className="block">
            <span className="text-xs font-medium text-gray-600">Từ ngày</span>
            <input
              type="date"
              className="mt-1 block w-36 px-3 py-2 border rounded-md text-sm"
              value={historyDateFrom}
              onChange={(e) => setHistoryDateFrom(e.target.value)}
            />
          </label>
          <label className="block">
            <span className="text-xs font-medium text-gray-600">Đến ngày</span>
            <input
              type="date"
              className="mt-1 block w-36 px-3 py-2 border rounded-md text-sm"
              value={historyDateTo}
              onChange={(e) => setHistoryDateTo(e.target.value)}
            />
          </label>
        </div>
        {recentLogs.length === 0 ? (
          <p className="text-gray-500 text-sm">Chưa có dữ liệu</p>
        ) : (
          <div className="overflow-x-auto border rounded-lg">
            <table className="w-full text-sm border-collapse">
              <thead>
                <tr className="bg-gray-100 text-left">
                  <th className="p-2 font-medium">Thời gian</th>
                  <th className="p-2 font-medium">Họ tên</th>
                  <th className="p-2 font-medium">MSSV</th>
                  <th className="p-2 font-medium">Loại</th>
                  <th className="p-2 font-medium">Cổng</th>
                </tr>
              </thead>
              <tbody>
                {recentLogs.map((log) => (
                  <tr key={log.id} className="border-t hover:bg-gray-50">
                    <td className="p-2 whitespace-nowrap text-gray-600">{new Date(log.access_time).toLocaleTimeString("vi-VN")}</td>
                    <td className="p-2 font-medium">{log.patron_name || "-"}</td>
                    <td className="p-2 text-gray-600">{log.student_code || "-"}</td>
                    <td className="p-2">
                      <span className={`px-2 py-0.5 rounded-full text-xs font-medium ${
                        log.access_type === "entry" ? "bg-green-100 text-green-800" : "bg-orange-100 text-orange-800"
                      }`}>
                        {log.access_type === "entry" ? "Vào" : "Ra"}
                      </span>
                    </td>
                    <td className="p-2 text-gray-600">{log.camera_id}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
      </div>
    </div>
  );
}
</file>

<file path="src/app/login/page.tsx">
"use client";

import { useState, useCallback, useRef, useEffect } from "react";
import { Eye, Camera, Upload } from "lucide-react";
import { useAuth } from "@/lib/auth-context";
import { useRouter } from "next/navigation";
import Link from "next/link";
import api, { getErrorMessage } from "@/lib/api-client";

type LoginMode = "password" | "face";

export default function LoginPage() {
  const { login, setAuthFromToken } = useAuth();
  const router = useRouter();
  const [mode, setMode] = useState<LoginMode>("password");
  const [email, setEmail] = useState("");
  const [password, setPassword] = useState("");
  const [error, setError] = useState("");
  const [isLoading, setIsLoading] = useState(false);

  const [imageFile, setImageFile] = useState<File | null>(null);
  const [imagePreview, setImagePreview] = useState<string | null>(null);
  const [isCameraOn, setIsCameraOn] = useState(false);
  const [cameraReady, setCameraReady] = useState(false);
  const [success, setSuccess] = useState(false);
  const [faceFailCount, setFaceFailCount] = useState(0);
  const faceFailCountRef = useRef(0);
  const videoRef = useRef<HTMLVideoElement>(null);
  const streamRef = useRef<MediaStream | null>(null);
  const readyTimeoutRef = useRef<ReturnType<typeof setTimeout>>(null);
  const autoCaptureTimeoutRef = useRef<ReturnType<typeof setTimeout> | null>(null);

  const startCamera = useCallback(async () => {
    try {
      setError("");
      setCameraReady(false);
      if (streamRef.current) {
        streamRef.current.getTracks().forEach((t) => t.stop());
      }
      const stream = await navigator.mediaDevices.getUserMedia({
        video: { facingMode: "user", width: { ideal: 640 }, height: { ideal: 480 } },
        audio: false,
      });
      streamRef.current = stream;
      setIsCameraOn(true);
    } catch {
      setError("Không thể truy cập camera");
      setIsCameraOn(false);
    }
  }, []);

  useEffect(() => {
    if (!isCameraOn || !videoRef.current || !streamRef.current) return;
    const video = videoRef.current;
    const stream = streamRef.current;
    const onReady = () => {
      setCameraReady(true);
    };
    video.onloadedmetadata = onReady;
    video.onplaying = onReady;
    video.onerror = () => setError("Camera error");
    video.srcObject = stream;
    if (video.readyState >= 2) onReady();
    readyTimeoutRef.current = setTimeout(() => setCameraReady(true), 3000);
    return () => {
      if (readyTimeoutRef.current) clearTimeout(readyTimeoutRef.current);
      if (autoCaptureTimeoutRef.current) clearTimeout(autoCaptureTimeoutRef.current);
      video.onloadedmetadata = null;
      video.onplaying = null;
      video.onerror = null;
      video.srcObject = null;
    };
  }, [isCameraOn]);

  useEffect(() => {
    if (cameraReady && mode === "face" && !imagePreview) {
      autoCaptureTimeoutRef.current = setTimeout(autoCapture, 1500);
    }
    return () => {
      if (autoCaptureTimeoutRef.current) clearTimeout(autoCaptureTimeoutRef.current);
    };
  }, [cameraReady, mode, imagePreview]);

  const stopCamera = useCallback(() => {
    if (streamRef.current) {
      streamRef.current.getTracks().forEach((t) => t.stop());
      streamRef.current = null;
    }
    setIsCameraOn(false);
    setCameraReady(false);
  }, []);

  useEffect(() => {
    return () => {
      stopCamera();
    };
  }, [stopCamera]);

  const resetFaceState = () => {
    setImageFile(null);
    setImagePreview(null);
  };

  const doFaceLogin = useCallback(async (file: File) => {
    setError("");
    setIsLoading(true);
    try {
      const res = await api.faceLogin(file);
      const payload = JSON.parse(atob(res.access_token.split(".")[1]));
      const email = payload?.email || "";
      const role = ((payload?.roles as string[])?.[0]) || "user";
      setAuthFromToken(res.access_token, res.refresh_token, email, role);
      setSuccess(true);
      setIsLoading(false);
      setFaceFailCount(0);
      faceFailCountRef.current = 0;
      setTimeout(() => router.push("/dashboard"), 500);
    } catch (err: any) {
      const msg = getErrorMessage(err) || "Đăng nhập thất bại";
      setError(msg);
      setIsLoading(false);
      const newCount = faceFailCountRef.current + 1;
      faceFailCountRef.current = newCount;
      setFaceFailCount(newCount);
      if (newCount >= 2) {
        setMode("password");
        setFaceFailCount(0);
        faceFailCountRef.current = 0;
        resetFaceState();
        setError(msg + " — Chuyển sang đăng nhập mật khẩu");
      } else {
        resetFaceState();
        startCamera();
      }
    }
  }, [router]);

  const handlePasswordSubmit = async (e: React.FormEvent) => {
    e.preventDefault();
    setError("");
    setIsLoading(true);
    try {
      await login(email, password);
      window.location.href = "/dashboard";
    } catch (err: any) {
      setError(getErrorMessage(err) || "Login failed");
    } finally {
      setIsLoading(false);
    }
  };

  const handleFileChange = (e: React.ChangeEvent<HTMLInputElement>) => {
    const file = e.target.files?.[0];
    if (!file) return;
    setImageFile(file);
    const reader = new FileReader();
    reader.onload = (ev) => setImagePreview(ev.target?.result as string);
    reader.readAsDataURL(file);
    stopCamera();
  };

  const capturePhoto = useCallback((cb?: (file: File) => void) => {
    if (!videoRef.current || !cameraReady) return;
    const video = videoRef.current;
    if (video.videoWidth === 0 || video.videoHeight === 0) return;
    const canvas = document.createElement("canvas");
    canvas.width = video.videoWidth;
    canvas.height = video.videoHeight;
    const ctx = canvas.getContext("2d");
    if (!ctx) return;
    ctx.drawImage(video, 0, 0);
    canvas.toBlob((blob) => {
      if (!blob) return;
      const file = new File([blob], "face.jpg", { type: "image/jpeg" });
      setImageFile(file);
      setImagePreview(canvas.toDataURL("image/jpeg"));
      cb?.(file);
    }, "image/jpeg", 0.9);
  }, [cameraReady]);

  const autoCapture = useCallback(() => {
    capturePhoto((file) => {
      stopCamera();
      doFaceLogin(file);
    });
  }, [capturePhoto, stopCamera, doFaceLogin]);

  const switchToFace = () => {
    setMode("face");
    setError("");
    setFaceFailCount(0);
    resetFaceState();
  };

  const switchToPassword = () => {
    setMode("password");
    setError("");
    stopCamera();
  };

  return (
    <div className="min-h-screen flex items-center justify-center bg-gray-50">
      <div className="max-w-md w-full p-6 bg-white rounded-lg shadow-md">
        <div className="text-center mb-6">
          <h1 className="text-2xl font-bold">Welcome Back</h1>
          <p className="text-gray-600">Sign in to your account</p>
        </div>

        <div className="flex mb-6 border rounded-lg overflow-hidden">
          <button
            type="button"
            onClick={switchToPassword}
            className={`flex-1 py-2 text-sm font-medium ${
              mode === "password"
                ? "bg-primary text-primary-foreground"
                : "bg-gray-100 text-gray-600 hover:bg-gray-200"
            }`}
          >
            Password
          </button>
          <button
            type="button"
            onClick={switchToFace}
            className={`flex-1 py-2 text-sm font-medium flex items-center justify-center gap-1 ${
              mode === "face"
                ? "bg-primary text-primary-foreground"
                : "bg-gray-100 text-gray-600 hover:bg-gray-200"
            }`}
          >
            <Eye className="w-4 h-4" />
            Face
          </button>
        </div>

        {error && (
          <div className="mb-4 p-3 bg-red-50 text-red-600 rounded-md text-sm">
            {error}
          </div>
        )}

        {success ? (
          <div className="text-center py-8">
            <div className="rounded-full h-16 w-16 bg-green-100 flex items-center justify-center mx-auto mb-4">
              <svg className="w-8 h-8 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M5 13l4 4L19 7" />
              </svg>
            </div>
            <p className="text-lg font-semibold text-green-600">Login Successful!</p>
            <p className="text-sm text-gray-500 mt-1">Redirecting to dashboard...</p>
          </div>
        ) : isLoading ? (
          <div className="text-center py-8">
            <div className="animate-spin rounded-full h-12 w-12 border-t-2 border-b-2 border-primary mx-auto mb-4" />
            <p className="text-gray-600">Verifying face...</p>
          </div>
        ) : mode === "password" ? (
          <form onSubmit={handlePasswordSubmit} className="space-y-4">
            <div>
              <label htmlFor="email" className="block text-sm font-medium mb-1">Email</label>
              <input
                id="email" type="email" value={email} autoComplete="email"
                onChange={(e) => setEmail(e.target.value)}
                className="w-full px-3 py-2 border rounded-md focus:outline-none focus:ring-2 focus:ring-primary" required
              />
            </div>
            <div>
              <label htmlFor="password" className="block text-sm font-medium mb-1">Password</label>
              <input
                id="password" type="password" value={password} autoComplete="current-password"
                onChange={(e) => setPassword(e.target.value)}
                className="w-full px-3 py-2 border rounded-md focus:outline-none focus:ring-2 focus:ring-primary" required
              />
            </div>
            <button type="submit" disabled={isLoading}
              className="w-full py-2 bg-primary text-primary-foreground rounded-md hover:opacity-90 disabled:opacity-50"
            >
              {isLoading ? "Signing in..." : "Sign In"}
            </button>
          </form>
        ) : (
          <div className="space-y-4">
            {imagePreview ? (
              <div className="space-y-2">
                <div className="aspect-video bg-black rounded-lg overflow-hidden">
                  <img src={imagePreview} alt="Captured" className="w-full h-full object-contain" />
                </div>
                <button type="button" onClick={() => { resetFaceState(); startCamera(); }}
                  className="w-full py-2 text-sm bg-gray-100 rounded-md hover:bg-gray-200"
                >
                  Retake
                </button>
              </div>
            ) : (
              <>
                <div className="relative aspect-video bg-black rounded-lg overflow-hidden">
                  {isCameraOn ? (
                    <>
                      <video ref={videoRef} autoPlay playsInline muted className="w-full h-full object-contain" />
                      {!cameraReady ? (
                        <div className="absolute inset-0 flex items-center justify-center bg-black/50 text-white">
                          Loading camera...
                        </div>
                      ) : (
                        <div className="absolute inset-0 flex items-center justify-center pointer-events-none">
                          <div className="w-48 h-48 border-2 border-primary/50 rounded-full" />
                        </div>
                      )}
                    </>
                  ) : (
                    <div className="flex items-center justify-center h-full text-gray-400 text-sm p-4">
                      Click "Start Camera" or "Upload"
                    </div>
                  )}
                </div>
                <div className="flex gap-3">
                  {!isCameraOn && (
                    <button type="button" onClick={startCamera}
                      className="flex-1 flex items-center justify-center gap-2 px-4 py-2 bg-gray-100 rounded-md hover:bg-gray-200"
                    >
                      <Camera className="w-5 h-5" /> Start Camera
                    </button>
                  )}
                  <label className="flex-1 flex items-center justify-center gap-2 px-4 py-2 bg-gray-100 rounded-md hover:bg-gray-200 cursor-pointer">
                    <Upload className="w-5 h-5" /> Upload
                    <input type="file" accept="image/*" capture="user" onChange={handleFileChange} className="hidden" />
                  </label>
                  {isCameraOn && (
                    <button type="button" onClick={stopCamera}
                      className="px-4 py-2 text-red-600 bg-red-50 rounded-md hover:bg-red-100"
                    >
                      Stop
                    </button>
                  )}
                </div>
              </>
            )}
          </div>
        )}

        <p className="mt-4 text-center text-sm text-gray-600">
          Don&apos;t have an account?{" "}
          <Link href="/register" className="text-primary hover:underline">Register</Link>
        </p>
      </div>
    </div>
  );
}
</file>

<file path="src/lib/types.ts">
// === Auth ===
export interface LoginRequest {
  email: string;
  password: string;
}

export interface RegisterRequest {
  email: string;
  password: string;
  full_name?: string;
  role?: string;
}

// User-service returns user info along with tokens
export interface UserServiceAuthResponse {
  user: UserPublic;
  access_token: string;
  refresh_token?: string;
}

export interface TokenResponse {
  access_token: string;
  refresh_token: string | null;
  token_type: string;
}

export interface UserPublic {
  id: string;
  email: string;
  full_name: string | null;
  role: string;
  has_face?: boolean;
}

export interface RefreshRequest {
  refresh_token: string;
}

// === Tasks ===
export interface TaskStatusResponse {
  task_id: string;
  status: "PENDING" | "SUCCESS" | "FAILURE" | "RETRY" | "STARTED" | "ERROR";
  result: TaskResult | null;
}

export interface LivenessBreakdown {
  lbp?: number;
  color?: number;
  noise?: number;
  fft?: number;
  multi_scale?: number;
  bbox?: number;
  insightface?: number;
}

export interface TaskResult {
  status: string;
  user_id?: string;
  verified?: boolean;
  score?: number;
  matches?: Array<{ user_id: string; score: number }>;
  liveness_score?: number;
  is_live?: boolean;
  breakdown?: LivenessBreakdown;
  error?: string;
  type?: string;
  access_token?: string;
  refresh_token?: string;
  detail?: string;
}

// === Users ===
export interface UserListResponse {
  users: UserPublic[];
  total: number;
}

// === Face Operations ===
export interface EnrollmentResult {
  job_id: string;
}

export interface VerificationResult {
  job_id: string;
}

export interface IdentificationResult {
  job_id: string;
}

export interface LivenessResult {
  job_id: string;
}

// === API Error ===
export interface ApiError {
  detail: string;
}

