"use client";

import { useEffect, useState } from "react";
import {
  Avatar,
  Box,
  Card,
  CardContent,
  Chip,
  CircularProgress,
  IconButton,
  LinearProgress,
  Paper,
  Stack,
  Typography,
} from "@mui/material";
import AutoAwesomeIcon from "@mui/icons-material/AutoAwesomeOutlined";
import BookIcon from "@mui/icons-material/MenuBookOutlined";
import CloseIcon from "@mui/icons-material/CloseOutlined";
import LightbulbIcon from "@mui/icons-material/LightbulbOutlined";
import api from "@/lib/api-client";
import type { BookRecommendation, BookRecommendationResponse } from "@/lib/types";
import { fadeInUp } from "@/lib/animations";

export default function BookRecommendations({
  studentCode,
  onClose,
}: {
  studentCode: string;
  onClose?: () => void;
}) {
  const [data, setData] = useState<BookRecommendationResponse | null>(null);
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState("");

  useEffect(() => {
    if (!studentCode) return;
    setLoading(true);
    setError("");
    api
      .getBookRecommendations(studentCode)
      .then(setData)
      .catch(() => setError("Không thể tải gợi ý sách"))
      .finally(() => setLoading(false));
  }, [studentCode]);

  if (loading) {
    return (
      <Paper variant="outlined" sx={{ p: 3 }}>
        <Stack spacing={2} sx={{ alignItems: "center" }}>
          <CircularProgress size={24} />
          <Typography variant="body2" color="text.secondary">AI đang phân tích sở thích đọc sách...</Typography>
        </Stack>
      </Paper>
    );
  }

  if (error) return null;

  if (!data || !data.recommendations.length) return null;

  return (
    <Paper variant="outlined" sx={{ p: 2, borderColor: "info.main" }}>
      <Stack spacing={2}>
        <Stack direction="row" spacing={1.5} sx={{ alignItems: "center", justifyContent: "space-between" }}>
          <Stack direction="row" spacing={1} sx={{ alignItems: "center" }}>
            <AutoAwesomeIcon color="info" fontSize="small" />
            <Typography variant="subtitle1" sx={{ fontWeight: 900 }}>
              Gợi ý sách cho {data.patron_name}
            </Typography>
            <Chip size="small" variant="outlined" label="AI đề xuất" color="info" />
          </Stack>
          {onClose && (
            <IconButton size="small" onClick={onClose}><CloseIcon fontSize="small" /></IconButton>
          )}
        </Stack>

        <Box sx={{
          display: "grid",
          gridTemplateColumns: { xs: "1fr", sm: "repeat(2, 1fr)", md: "repeat(3, 1fr)", lg: "repeat(5, 1fr)" },
          gap: 2,
        }}>
          {data.recommendations.slice(0, 5).map((book, idx) => (
            <RecommendationCard key={book.book_id || book.isbn} book={book} index={idx} />
          ))}
        </Box>
      </Stack>
    </Paper>
  );
}

function RecommendationCard({ book, index }: { book: BookRecommendation; index: number }) {
  return (
    <Card
      variant="outlined"
      sx={{
        animation: `${fadeInUp} 0.35s ease-out`,
        animationDelay: `${index * 0.08}s`,
        animationFillMode: "both",
        "&:hover": { borderColor: "info.main", boxShadow: "0 2px 8px rgba(3,165,226,0.12)" },
      }}
    >
      <CardContent sx={{ p: 2, "&:last-child": { pb: 2 } }}>
        <Stack spacing={1}>
          <Box sx={{ display: "flex", gap: 1.5, alignItems: "flex-start" }}>
            {book.cover_url ? (
              <Box
                component="img"
                src={book.cover_url}
                alt={book.title}
                sx={{
                  width: 42,
                  height: 58,
                  objectFit: "cover",
                  borderRadius: 0.5,
                  flexShrink: 0,
                  bgcolor: "background.default",
                }}
              />
            ) : (
              <Avatar
                variant="rounded"
                sx={{ width: 42, height: 58, bgcolor: "background.default", flexShrink: 0 }}
              >
                <BookIcon fontSize="small" />
              </Avatar>
            )}
            <Box sx={{ minWidth: 0, flex: 1 }}>
              <Typography variant="body2" sx={{ fontWeight: 900, lineHeight: 1.3 }} noWrap>{book.title}</Typography>
              <Typography variant="caption" color="text.secondary" noWrap>{book.author}</Typography>
              {book.category && (
                <Chip size="small" label={book.category} sx={{ mt: 0.5, height: 18, fontSize: 10 }} />
              )}
            </Box>
          </Box>
          <Stack direction="row" spacing={0.5} sx={{ alignItems: "center" }}>
            <LightbulbIcon sx={{ fontSize: 14, color: "info.main" }} />
            <Typography variant="caption" color="info.main" sx={{ lineHeight: 1.3 }}>{book.reason}</Typography>
          </Stack>
          <Box sx={{ display: "flex", alignItems: "center", gap: 1 }}>
            <LinearProgress
              variant="determinate"
              value={book.relevance_score}
              color={book.relevance_score >= 70 ? "success" : book.relevance_score >= 40 ? "warning" : "info"}
              sx={{ flex: 1, height: 4, borderRadius: 4 }}
            />
            <Typography variant="caption" color="text.secondary" sx={{ flexShrink: 0, fontWeight: 700 }}>
              {book.relevance_score}%
            </Typography>
          </Box>
        </Stack>
      </CardContent>
    </Card>
  );
}
</file>

<file path="src/components/BorrowIPCameraDialog.tsx">
"use client";

import { useCallback, useEffect, useRef, useState } from "react";
import {
  Alert,
  Avatar,
  Box,
  Button,
  Chip,
  CircularProgress,
  Dialog,
  DialogActions,
  DialogContent,
  DialogTitle,
  IconButton,
  Paper,
  Snackbar,
  Stack,
  TextField,
  Typography,
} from "@mui/material";
import BookIcon from "@mui/icons-material/MenuBookOutlined";
import CloseIcon from "@mui/icons-material/Close";
import DeleteIcon from "@mui/icons-material/DeleteOutlined";
import ErrorIcon from "@mui/icons-material/ReportOutlined";
import QrCodeScannerIcon from "@mui/icons-material/QrCodeScannerOutlined";
import api, { getErrorMessage } from "@/lib/api-client";
import type { BookWithStats } from "@/lib/types";
import { slideInRight, successPop } from "@/lib/animations";
import IPCameraStream from "./IPCameraStream";

interface ScannedBorrowItem {
  barcode: string;
  isbn: string;
  loading: boolean;
  can_borrow: boolean;
  reason: string | null;
  book: BookWithStats | null;
  copy_id: string | null;
  book_id: string | null;
  copy_barcode: string | null;
}

interface Props {
  open: boolean;
  patronId: string;
  patronName: string;
  maxItems?: number;
  cameraUrl: string;
  onClose: () => void;
  onSuccess: (message: string) => void;
}

export default function BorrowIPCameraDialog({
  open,
  patronId,
  patronName,
  maxItems,
  cameraUrl,
  onClose,
  onSuccess,
}: Props) {
  const [scanned, setScanned] = useState<ScannedBorrowItem[]>([]);
  const [lookingUp, setLookingUp] = useState(false);
  const [createError, setCreateError] = useState("");
  const [scanToast, setScanToast] = useState("");
  const [lookupError, setLookupError] = useState<string | null>(null);
  const [note, setNote] = useState("");
  const lastScannedRef = useRef<string | null>(null);

  const lookupItem = useCallback(async (barcode: string, isbn: string) => {
    setScanned((prev) => prev.map((item) =>
      item.barcode === barcode ? { ...item, loading: true } : item
    ));
    try {
      const result = await api.lookupBorrowSlip({
        patron_id: patronId,
        items: [{ barcode, isbn }],
      });
      const item = result.items.find((i) => i.barcode === barcode);
      if (!item) {
        setScanned((prev) => prev.filter((i) => i.barcode !== barcode));
        setLookupError(`Sách ISBN ${barcode} không tồn tại trong thư viện`);
        return;
      }
      if (!item.can_borrow) {
        setScanned((prev) => prev.filter((i) => i.barcode !== barcode));
        const msg = item.reason || "Sách không thể mượn";
        const title = item.book?.title || "";
        setLookupError(title ? `"${title}": ${msg}` : `${msg} (ISBN: ${barcode})`);
        return;
      }
      setScanned((prev) => prev.map((i) =>
        i.barcode === barcode ? {
          ...i,
          loading: false,
          can_borrow: item.can_borrow,
          reason: item.reason,
          book: item.book,
          copy_id: item.copy?.id || null,
          book_id: item.book?.id || null,
          copy_barcode: item.copy?.barcode || null,
        } : i
      ));
    } catch {
      setScanned((prev) => prev.filter((item) => item.barcode !== barcode));
      setLookupError(`Lỗi tra cứu: ${barcode}`);
    }
  }, [patronId]);

  const addScanned = useCallback((isbn: string) => {
    if (!/^\d{10,13}$/.test(isbn.replace(/-/g, ""))) return;
    const normalized = isbn.replace(/-/g, "");
    lastScannedRef.current = normalized;
    setScanToast(normalized);
    setScanned((prev) => {
      if (prev.some((item) => item.barcode === normalized)) {
        setScanToast(`Sách ${normalized} đã có trong danh sách`);
        return prev;
      }
      if (maxItems !== undefined && prev.length >= maxItems) {
        setScanToast(`Chỉ được mượn tối đa ${maxItems} cuốn`);
        return prev;
      }
      return [...prev, {
        barcode: normalized,
        isbn: normalized,
        loading: true,
        can_borrow: false,
        reason: null,
        book: null,
        copy_id: null,
        book_id: null,
        copy_barcode: null,
      }];
    });
    lookupItem(normalized, normalized);
  }, [lookupItem, maxItems]);

  useEffect(() => {
    if (!open) {
      setScanned([]);
      setCreateError("");
      setScanToast("");
      setNote("");
      lastScannedRef.current = null;
    }
  }, [open]);

  const removeItem = (barcode: string) => {
    setScanned((prev) => prev.filter((item) => item.barcode !== barcode));
  };

  const handleCreateSlip = async () => {
    const validItems = scanned.filter((item) => item.can_borrow && item.book_id && item.copy_id);
    if (!validItems.length || !patronId) return;
    setCreateError("");
    try {
      const confirmResult = await api.confirmBorrowSlip({
        patron_id: patronId,
        items: validItems.map((item) => ({
          barcode: item.copy_barcode || item.barcode,
          isbn: item.isbn,
          book_id: item.book_id!,
          copy_id: item.copy_id!,
        })),
        note: note.trim() || null,
      });
      if (confirmResult.status === "success") {
        setScanned([]);
        onSuccess(confirmResult.message);
        onClose();
      }
    } catch (err) {
      const detail = getErrorMessage(err);
      const removedBarcodes: string[] = [];
      const toastMsg = detail;

      const matchTitle = detail.match(/^Sach "(.+)" da duoc doc gia nay muon$/);
      if (matchTitle) {
        const title = matchTitle[1];
        setScanned((prev) => {
          const filtered = prev.filter((item) => {
            if (item.book?.title === title) {
              removedBarcodes.push(item.barcode);
              return false;
            }
            return true;
          });
          return filtered;
        });
      } else {
        const matchBarcode = detail.match(/^(?:Ban sao|Ma vach) ([^\s]+) (?:dang duoc muon|khong ton tai)/);
        if (matchBarcode) {
          const barcode = matchBarcode[1];
          setScanned((prev) => {
            const filtered = prev.filter((item) => {
              if (item.barcode === barcode || item.barcode.includes(barcode)) {
                removedBarcodes.push(item.barcode);
                return false;
              }
              return true;
            });
            return filtered;
          });
        } else {
          setCreateError(detail);
        }
      }
      if (removedBarcodes.length > 0) {
        setScanToast(toastMsg);
      }
    }
  };

  const validCount = scanned.filter((item) => item.can_borrow).length;
  const totalScanned = scanned.length;

  return (
    <>
      <Dialog open={open} onClose={lookingUp ? undefined : onClose} fullWidth maxWidth="xl">
        <DialogTitle>
          <Stack direction="row" spacing={1} sx={{ alignItems: "center", justifyContent: "space-between" }}>
            <Stack direction="row" spacing={1} sx={{ alignItems: "center" }}>
              <QrCodeScannerIcon color="primary" />
              <Typography variant="h6" sx={{ fontWeight: 900 }}>
                Quét mã vạch sách (IP Camera)
              </Typography>
            </Stack>
            {!lookingUp && (
              <IconButton size="small" onClick={onClose}><CloseIcon /></IconButton>
            )}
          </Stack>
        </DialogTitle>
        <DialogContent dividers sx={{ p: 2, display: "flex", flexDirection: "column", overflow: "hidden" }}>
          <Box sx={{ display: "flex", gap: 2, flexDirection: { xs: "column", md: "row" }, flex: 1, overflow: "hidden" }}>
            <Box sx={{ width: { md: "50%" }, flexShrink: 0 }}>
              <IPCameraStream
                cameraUrl={cameraUrl}
                onBarcodeDetected={addScanned}
              />
            </Box>

            <Stack spacing={1.5} sx={{ flex: 1, overflow: "auto" }}>
              <Stack direction="row" spacing={1} sx={{ alignItems: "center" }}>
                <QrCodeScannerIcon color="primary" sx={{ fontSize: 20 }} />
                <Typography variant="subtitle2" sx={{ fontWeight: 900 }}>
                  {totalScanned > 0 ? `Đã quét (${totalScanned} cuốn)` : "Sách đã quét"}
                </Typography>
              </Stack>

              {createError ? <Alert severity="error" onClose={() => setCreateError("")}>{createError}</Alert> : null}

              {scanned.length === 0 ? (
                <Alert severity="info" sx={{ flex: 1, display: "flex", alignItems: "center" }}>
                  Đưa mã vạch vào camera. Sách sẽ xuất hiện tại đây.
                </Alert>
              ) : (
                scanned.map((item) => {
                  const isLastScanned = item.barcode === lastScannedRef.current;
                  const hasError = !item.loading && !item.can_borrow;
                  const isSuccess = !item.loading && item.can_borrow;
                  return (
                    <Paper
                      key={item.barcode}
                      variant="outlined"
                      sx={{
                        p: 1.5,
                        borderColor: isLastScanned ? "primary.main" : hasError ? "error.main" : undefined,
                        bgcolor: isLastScanned ? "action.hover" : hasError ? "error.50" : undefined,
                        animation: isSuccess
                          ? `${successPop} 0.4s ease-out`
                          : isLastScanned
                          ? `${slideInRight} 0.3s ease-out`
                          : undefined,
                      }}
                    >
                      <Stack direction="row" spacing={1.5} sx={{ alignItems: "flex-start" }}>
                        {item.loading ? (
                          <Avatar variant="rounded" sx={{ width: 40, height: 56, bgcolor: "background.default", flexShrink: 0 }}>
                            <CircularProgress size={20} />
                          </Avatar>
                        ) : item.book?.cover_url ? (
                          <Box
                            component="img"
                            src={item.book.cover_url}
                            alt={item.book.title}
                            sx={{ width: 40, height: 56, objectFit: "cover", borderRadius: 0.5, flexShrink: 0 }}
                          />
                        ) : (
                          <Avatar variant="rounded" sx={{ width: 40, height: 56, bgcolor: hasError ? "error.main" : "background.default", flexShrink: 0 }}>
                            {hasError ? <ErrorIcon fontSize="small" /> : <BookIcon />}
                          </Avatar>
                        )}
                        <Stack spacing={0.3} sx={{ flex: 1, minWidth: 0 }}>
                          {item.loading ? (
                            <Typography variant="body2" color="text.secondary">Đang tra cứu...</Typography>
                          ) : item.can_borrow && item.book ? (
                            <>
                              <Typography variant="body2" sx={{ fontWeight: 900 }} noWrap>
                                {item.book.title}
                              </Typography>
                              <Typography variant="caption" color="text.secondary" noWrap>
                                {item.book.author || "-"}
                              </Typography>
                              <Typography variant="caption" sx={{ fontFamily: "monospace", color: "primary.main" }}>
                                {item.barcode}
                              </Typography>
                              <Stack direction="row" spacing={0.5} sx={{ alignItems: "center", flexWrap: "wrap", mt: 0.5 }}>
                                <Chip size="small" variant="outlined" label={`Kho: ${item.book.total_copies}`} sx={{ height: 20, fontSize: 11 }} />
                                <Chip size="small" variant="outlined" color="success" label={`Sẵn: ${item.book.available_copies}`} sx={{ height: 20, fontSize: 11 }} />
                              </Stack>
                            </>
                          ) : (
                            <>
                              <Typography variant="body2" sx={{ fontWeight: 900 }} noWrap color="error">
                                {item.book?.title || item.barcode}
                              </Typography>
                              {item.reason && (
                                <Typography variant="caption" color="error">
                                  {item.reason}
                                </Typography>
                              )}
                            </>
                          )}
                        </Stack>
                        <IconButton size="small" color="error" onClick={() => removeItem(item.barcode)} sx={{ mt: 0.5 }}>
                          <DeleteIcon fontSize="small" />
                        </IconButton>
                      </Stack>
                    </Paper>
                  );
                })
              )}
            </Stack>
          </Box>
        </DialogContent>
        <DialogActions sx={{ flexDirection: "column", alignItems: "stretch", px: 3, pb: 2, gap: 1.5 }}>
          <TextField
            size="small"
            placeholder="Ghi chú phiếu mượn (tùy chọn)..."
            value={note}
            onChange={(e) => setNote(e.target.value)}
            fullWidth
            multiline
            maxRows={3}
            sx={{ "& .MuiInputBase-root": { fontSize: 13 } }}
          />
          <Stack direction="row" spacing={1} sx={{ justifyContent: "flex-end" }}>
            <Button onClick={onClose} disabled={lookingUp}>Hủy</Button>
            <Button
              variant="contained"
              disabled={lookingUp || validCount === 0}
              onClick={handleCreateSlip}
            >
              {lookingUp ? "Đang xử lý..." : `Tạo phiếu mượn (${validCount} cuốn)`}
            </Button>
          </Stack>
        </DialogActions>
      </Dialog>

      <Snackbar
        open={!!scanToast}
        autoHideDuration={2000}
        onClose={() => setScanToast("")}
        anchorOrigin={{ vertical: "top", horizontal: "right" }}
      >
        {scanToast ? (
          <Alert
            severity="success"
            onClose={() => setScanToast("")}
            sx={{
              animation: `${slideInRight} 0.3s ease-out`,
              boxShadow: 4,
            }}
          >
            {scanToast}
          </Alert>
        ) : undefined}
      </Snackbar>

      <Dialog open={!!lookupError} onClose={() => setLookupError(null)} maxWidth="sm" fullWidth>
        <DialogTitle sx={{ fontWeight: 900 }}>Thông báo</DialogTitle>
        <DialogContent>
          <Typography>{lookupError}</Typography>
        </DialogContent>
        <DialogActions>
          <Button onClick={() => setLookupError(null)} variant="contained">Đóng</Button>
        </DialogActions>
      </Dialog>
    </>
  );
}
</file>

<file path="src/components/camera-capture.tsx">
"use client";

import { useCallback, useEffect, useRef, useState } from "react";
import {
  Alert,
  Box,
  Button,
  CircularProgress,
  Paper,
  Stack,
  Typography,
} from "@mui/material";
import AddAPhotoOutlinedIcon from "@mui/icons-material/AddAPhotoOutlined";
import CameraswitchOutlinedIcon from "@mui/icons-material/CameraswitchOutlined";
import PhotoCameraOutlinedIcon from "@mui/icons-material/PhotoCameraOutlined";
import UploadFileOutlinedIcon from "@mui/icons-material/UploadFileOutlined";

export default function CameraCapture({
  onCapture,
}: {
  onCapture: (file: File, dataUrl: string) => void;
}) {
  const [image, setImage] = useState<string | null>(null);
  const [isCameraOn, setIsCameraOn] = useState(false);
  const [error, setError] = useState<string>("");
  const [cameraReady, setCameraReady] = useState(false);
  const videoRef = useRef<HTMLVideoElement>(null);
  const streamRef = useRef<MediaStream | null>(null);
  const readyTimeoutRef = useRef<ReturnType<typeof setTimeout> | null>(null);

  const stopCamera = useCallback(() => {
    if (streamRef.current) {
      streamRef.current.getTracks().forEach((track) => track.stop());
      streamRef.current = null;
    }
    setIsCameraOn(false);
    setCameraReady(false);
  }, []);

  const startCamera = useCallback(async () => {
    try {
      setError("");
      setCameraReady(false);
      stopCamera();
      const stream = await navigator.mediaDevices.getUserMedia({
        video: { facingMode: "user", width: { ideal: 640, min: 320 }, height: { ideal: 480, min: 240 } },
        audio: false,
      });
      streamRef.current = stream;
      setIsCameraOn(true);
    } catch (err: any) {
      if (err.name === "NotAllowedError") setError("Không có quyền truy cập camera. Hãy cấp quyền camera cho trình duyệt rồi thử lại.");
      else if (err.name === "NotFoundError") setError("Không tìm thấy camera trên thiết bị.");
      else setError("Không thể khởi động camera.");
      setIsCameraOn(false);
    }
  }, [stopCamera]);

  useEffect(() => {
    if (!isCameraOn || !videoRef.current || !streamRef.current) return;
    const video = videoRef.current;
    const onReady = () => setCameraReady(true);
    video.onloadedmetadata = onReady;
    video.onplaying = onReady;
    video.onerror = () => setError("Camera gặp lỗi khi phát hình.");
    video.srcObject = streamRef.current;
    if (video.readyState >= 2) onReady();
    readyTimeoutRef.current = setTimeout(() => setCameraReady(true), 3000);
    return () => {
      if (readyTimeoutRef.current) clearTimeout(readyTimeoutRef.current);
      video.onloadedmetadata = null;
      video.onplaying = null;
      video.onerror = null;
      video.srcObject = null;
    };
  }, [isCameraOn]);

  const capturePhoto = () => {
    if (!videoRef.current || !cameraReady || videoRef.current.videoWidth === 0) {
      setError("Camera chưa sẵn sàng, vui lòng đợi thêm một chút.");
      return;
    }
    const canvas = document.createElement("canvas");
    canvas.width = videoRef.current.videoWidth;
    canvas.height = videoRef.current.videoHeight;
    const ctx = canvas.getContext("2d");
    if (!ctx) {
      setError("Không thể chụp ảnh từ camera.");
      return;
    }
    ctx.drawImage(videoRef.current, 0, 0);
    canvas.toBlob((blob) => {
      if (!blob) return;
      const capturedFile = new File([blob], "face_capture.jpg", { type: "image/jpeg" });
      const dataUrl = canvas.toDataURL("image/jpeg");
      setImage(dataUrl);
      onCapture(capturedFile, dataUrl);
      stopCamera();
    }, "image/jpeg", 0.9);
  };

  const handleFileChange = (event: React.ChangeEvent<HTMLInputElement>) => {
    const selectedFile = event.target.files?.[0];
    if (!selectedFile) return;
    const reader = new FileReader();
    reader.onload = (loadEvent) => {
      const dataUrl = loadEvent.target?.result as string;
      setImage(dataUrl);
      onCapture(selectedFile, dataUrl);
    };
    reader.readAsDataURL(selectedFile);
  };

  const reset = () => {
    setImage(null);
    setError("");
    stopCamera();
  };

  useEffect(() => () => stopCamera(), [stopCamera]);

  return (
    <Stack spacing={1.5}>
      <Paper
        variant="outlined"
        sx={{
          position: "relative",
          overflow: "hidden",
          bgcolor: "black",
          aspectRatio: "16 / 9",
          display: "flex",
          alignItems: "center",
          justifyContent: "center",
        }}
      >
        {image ? (
          <Box component="img" src={image} alt="Ảnh đã chụp" sx={{ width: "100%", height: "100%", objectFit: "contain" }} />
        ) : isCameraOn ? (
          <>
            <Box component="video" ref={videoRef} autoPlay playsInline muted sx={{ width: "100%", height: "100%", objectFit: "contain" }} />
            {!cameraReady && (
              <Stack sx={{ position: "absolute", inset: 0, bgcolor: "rgba(0,0,0,.55)", color: "common.white", alignItems: "center", justifyContent: "center" }} spacing={1}>
                <CircularProgress size={26} color="inherit" />
                <Typography variant="body2">Đang kết nối camera...</Typography>
              </Stack>
            )}
          </>
        ) : (
          <Stack spacing={1} sx={{ alignItems: "center", textAlign: "center", color: "grey.300", p: 3 }}>
            <PhotoCameraOutlinedIcon sx={{ fontSize: 42 }} />
            <Typography>{error || "Bật camera hoặc tải ảnh lên để bắt đầu."}</Typography>
          </Stack>
        )}
      </Paper>

      {error && !isCameraOn && <Alert severity="warning">{error}</Alert>}

      <Stack direction={{ xs: "column", sm: "row" }} spacing={1}>
        {image ? (
          <Button variant="outlined" startIcon={<CameraswitchOutlinedIcon />} onClick={reset} fullWidth>
            Chụp lại
          </Button>
        ) : !isCameraOn ? (
          <Button variant="contained" startIcon={<PhotoCameraOutlinedIcon />} onClick={startCamera} fullWidth>
            Bật camera
          </Button>
        ) : (
          <Button variant="contained" startIcon={<AddAPhotoOutlinedIcon />} onClick={capturePhoto} disabled={!cameraReady} fullWidth>
            Chụp ảnh
          </Button>
        )}

        {!image && (
          <Button variant="outlined" component="label" startIcon={<UploadFileOutlinedIcon />} fullWidth>
            Tải ảnh
            <input type="file" accept="image/*" onChange={handleFileChange} hidden />
          </Button>
        )}

        {isCameraOn && !image && (
          <Button color="error" variant="text" onClick={stopCamera}>
            Tắt
          </Button>
        )}
      </Stack>
    </Stack>
  );
}
</file>

