<file path="src/app/(dashboard)/stats/finance/page.tsx">
"use client";

import dynamic from "next/dynamic";
import { useCallback, useEffect, useState } from "react";
import {
  Alert,
  Box,
  Button,
  Chip,
  CircularProgress,
  Stack,
  Typography,
  useTheme,
} from "@mui/material";
import AttachMoneyIcon from "@mui/icons-material/AttachMoneyOutlined";
import AccountBalanceWalletIcon from "@mui/icons-material/AccountBalanceWalletOutlined";
import QrCode2Icon from "@mui/icons-material/QrCode2Outlined";
import WarningAmberIcon from "@mui/icons-material/WarningAmberOutlined";
import RefreshIcon from "@mui/icons-material/RefreshOutlined";
import api, { getErrorMessage } from "@/lib/api-client";
import type { FinanceStats } from "@/lib/types";
import { StatCard, ChartCard, SectionLayout, TabNavigation, KpiGrid, type KpiCardProps } from "../_components";

const BarChart = dynamic(() => import("recharts").then((m) => m.BarChart), { ssr: false });
const Bar = dynamic(() => import("recharts").then((m) => m.Bar), { ssr: false });
const CartesianGrid = dynamic(() => import("recharts").then((m) => m.CartesianGrid), { ssr: false });
const ResponsiveContainer = dynamic(() => import("recharts").then((m) => m.ResponsiveContainer), { ssr: false });
const Tooltip = dynamic(() => import("recharts").then((m) => m.Tooltip), { ssr: false });
const XAxis = dynamic(() => import("recharts").then((m) => m.XAxis), { ssr: false });
const YAxis = dynamic(() => import("recharts").then((m) => m.YAxis), { ssr: false });

function formatCurrency(amount: number): string {
  return new Intl.NumberFormat("vi-VN", { style: "currency", currency: "VND" }).format(amount);
}

const tabs = [
  { label: "Tổng quan", href: "/stats" },
  { label: "Tài chính", href: "/stats/finance" },
  { label: "Kho sách", href: "/stats/inventory" },
  { label: "Nhận diện", href: "/stats/recognition" },
  { label: "Real-time", href: "/stats/realtime" },
];

export default function FinancePage() {
  const theme = useTheme();
  const [data, setData] = useState<FinanceStats | null>(null);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState<string | null>(null);

  const fetchData = useCallback(async () => {
    try {
      setLoading(true);
      setError(null);
      const res = await api.getFinanceStats(12);
      setData(res);
    } catch (err: any) {
      setError(getErrorMessage(err) || "Lỗi tải thống kê tài chính");
    } finally {
      setLoading(false);
    }
  }, []);

  useEffect(() => {
    fetchData();
  }, [fetchData]);

  const isEmpty = !data || (data.collected_total === 0 && data.outstanding_total === 0);

  const kpiCards: KpiCardProps[] = data
    ? [
        {
          label: "Tổng tiền phạt đã thu",
          value: formatCurrency(data.collected_total),
          icon: <AttachMoneyIcon />,
          gradient: "linear-gradient(135deg, #059669 0%, #047857 100%)",
          delta: `${data.paid_count} lượt đã thanh toán`,
          deltaColor: "success" as const,
          pct: data.paid_count > 0 ? Math.min(100, (data.paid_count / (data.paid_count + data.unpaid_count)) * 100) : 0,
        },
        {
          label: "Tiền mặt (Cash)",
          value: formatCurrency(data.by_method.cash),
          icon: <AccountBalanceWalletIcon />,
          gradient: "linear-gradient(135deg, #0A2540 0%, #0F3C5C 100%)",
          delta: "Thu trực tiếp tại quầy",
          deltaColor: "default" as const,
        },
        {
          label: "Chuyển khoản QR",
          value: formatCurrency(data.by_method.qr ?? data.by_method.qr_code ?? 0),
          icon: <QrCode2Icon />,
          gradient: "linear-gradient(135deg, #D4AF37 0%, #B89628 100%)",
          delta: "Cổng thanh toán điện tử",
          deltaColor: "default" as const,
        },
        {
          label: "Tiền phạt tồn đọng",
          value: formatCurrency(data.outstanding_total),
          icon: <WarningAmberIcon />,
          gradient: "linear-gradient(135deg, #DC2626 0%, #B91C1C 100%)",
          delta: `${data.unpaid_count} lượt chưa thanh toán`,
          deltaColor: data.outstanding_total > 0 ? "error" : "success",
          pct: data.unpaid_count > 0 ? Math.min(100, (data.unpaid_count / (data.paid_count + data.unpaid_count)) * 100) : 0,
        },
      ]
    : [];

  return (
    <Stack spacing={3} sx={{ minHeight: 900 }}>
      <TabNavigation tabs={tabs} />

      <SectionLayout
        title="Thống kê tài chính & Tiền phạt"
        subtitle="Tổng hợp tiền phạt đã thu theo phương thức thanh toán và xu hướng 12 tháng"
        icon={<AttachMoneyIcon />}
        actions={
          <Button size="small" startIcon={<RefreshIcon />} onClick={fetchData} disabled={loading}>
            {loading ? <CircularProgress size={20} /> : "Làm mới"}
          </Button>
        }
        kpiCards={<KpiGrid cards={kpiCards} />}
      >
        {loading && (
          <Chip variant="outlined" label="Đang tải dữ liệu..." icon={<CircularProgress size={16} />} color="info" />
        )}

        {error && (
          <Alert
            severity="error"
            action={
              <Button color="inherit" size="small" startIcon={<RefreshIcon />} onClick={fetchData}>
                Thử lại
              </Button>
            }
          >
            {error}
          </Alert>
        )}

        {isEmpty && (
          <Alert severity="info">
            Chưa có dữ liệu tài chính. Hiện chưa có bản ghi thu tiền phạt hoặc nợ phạt nào trong hệ thống.
          </Alert>
        )}

        {data && data.monthly && data.monthly.length > 0 && (
          <ChartCard
            title="Doanh thu tiền phạt theo tháng"
            subtitle="12 tháng gần nhất"
            height={350}
          >
            <ResponsiveContainer width="100%" height={350}>
              <BarChart data={data.monthly} margin={{ top: 10, right: 20, left: 10, bottom: 20 }}>
                <CartesianGrid strokeDasharray="3 3" stroke={theme.palette.divider} vertical={false} />
                <XAxis dataKey="month" tick={{ fill: theme.palette.text.secondary, fontSize: 11 }} />
                <YAxis
                  tick={{ fill: theme.palette.text.secondary, fontSize: 11 }}
                  tickFormatter={(val) => `${(val / 1000).toLocaleString("vi-VN")}k`}
                />
                <Tooltip
                  contentStyle={{
                    backgroundColor: theme.palette.background.paper,
                    border: `1px solid ${theme.palette.divider}`,
                    borderRadius: 8,
                    color: theme.palette.text.primary,
                    boxShadow: theme.palette.mode === "dark" ? "0 4px 20px rgba(0,0,0,0.5)" : "0 4px 20px rgba(0,0,0,0.08)",
                  }}
                  itemStyle={{ color: theme.palette.text.primary, fontWeight: 600 }}
                  labelStyle={{ color: theme.palette.text.secondary, fontWeight: 700 }}
                  formatter={(val: any) => [formatCurrency(Number(val) || 0), "Doanh thu"]}
                />
                <Bar dataKey="collected" name="Tiền phạt đã thu" fill={theme.palette.mode === "dark" ? "#34D399" : "#059669"} radius={[4, 4, 0, 0]} />
              </BarChart>
            </ResponsiveContainer>
          </ChartCard>
        )}

        {data && (
          <Box sx={{ mt: 3 }}>
            <Typography variant="h6" sx={{ fontWeight: 800, mb: 2 }}>
              Chi tiết phương thức thanh toán
            </Typography>
            <Stack direction="row" spacing={2} sx={{ flexWrap: "wrap" }}>
              <Chip
                label={`Tiền mặt: ${formatCurrency(data.by_method.cash)}`}
                icon={<AccountBalanceWalletIcon />}
                size="medium"
                color="info"
                variant="outlined"
              />
              <Chip
                label={`QR Code: ${formatCurrency(data.by_method.qr ?? data.by_method.qr_code ?? 0)}`}
                icon={<QrCode2Icon />}
                size="medium"
                color="warning"
                variant="outlined"
              />
              <Chip
                label={`Tổng thu: ${formatCurrency(data.collected_total)}`}
                icon={<AttachMoneyIcon />}
                size="medium"
                color="success"
                variant="outlined"
              />
              <Chip
                label={`Còn nợ: ${formatCurrency(data.outstanding_total)}`}
                icon={<WarningAmberIcon />}
                size="medium"
                color="error"
                variant="outlined"
              />
            </Stack>
          </Box>
        )}
      </SectionLayout>
    </Stack>
  );
}
</file>

<file path="src/app/(dashboard)/stats/inventory/page.tsx">
"use client";

import dynamic from "next/dynamic";
import { useCallback, useEffect, useState } from "react";
import {
  Alert,
  Box,
  Button,
  Chip,
  CircularProgress,
  Stack,
  Typography,
  alpha,
  useTheme,
} from "@mui/material";
import MenuBookIcon from "@mui/icons-material/MenuBookOutlined";
import ContentCopyIcon from "@mui/icons-material/ContentCopyOutlined";
import PriceCheckIcon from "@mui/icons-material/PriceCheckOutlined";
import AddBusinessIcon from "@mui/icons-material/AddBusinessOutlined";
import RefreshIcon from "@mui/icons-material/RefreshOutlined";
import api, { getErrorMessage } from "@/lib/api-client";
import type { InventoryStats } from "@/lib/types";
import { StatCard, ChartCard, SectionLayout, TabNavigation, KpiGrid } from "../_components";

const BarChart = dynamic(() => import("recharts").then((m) => m.BarChart), { ssr: false });
const Bar = dynamic(() => import("recharts").then((m) => m.Bar), { ssr: false });
const CartesianGrid = dynamic(() => import("recharts").then((m) => m.CartesianGrid), { ssr: false });
const ResponsiveContainer = dynamic(() => import("recharts").then((m) => m.ResponsiveContainer), { ssr: false });
const Tooltip = dynamic(() => import("recharts").then((m) => m.Tooltip), { ssr: false });
const XAxis = dynamic(() => import("recharts").then((m) => m.XAxis), { ssr: false });
const YAxis = dynamic(() => import("recharts").then((m) => m.YAxis), { ssr: false });

const STATUS_LABELS: Record<string, string> = {
  available: "Có sẵn",
  borrowed: "Đang mượn",
  maintenance: "Bảo trì",
  disposed: "Đã thanh lý",
  reserved: "Đã đặt trước",
};

const CONDITION_LABELS: Record<string, { label: string; color: "success" | "info" | "warning" | "error" | "default" }> = {
  new: { label: "Mới 100%", color: "success" },
  good: { label: "Bình thường", color: "info" },
  minor_damage: { label: "Hư nhẹ", color: "warning" },
  major_damage: { label: "Hư nặng", color: "error" },
  lost: { label: "Mất sách", color: "error" },
};

const tabs = [
  { label: "Tổng quan", href: "/stats" },
  { label: "Tài chính", href: "/stats/finance" },
  { label: "Kho sách", href: "/stats/inventory" },
  { label: "Nhận diện", href: "/stats/recognition" },
  { label: "Real-time", href: "/stats/realtime" },
];

export default function InventoryPage() {
  const theme = useTheme();
  const [data, setData] = useState<InventoryStats | null>(null);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState<string | null>(null);

  const fetchData = useCallback(async () => {
    try {
      setLoading(true);
      setError(null);
      const res = await api.getInventoryStats();
      setData(res);
    } catch (err: any) {
      setError(getErrorMessage(err) || "Lỗi tải thống kê kho sách");
    } finally {
      setLoading(false);
    }
  }, []);

  useEffect(() => {
    fetchData();
  }, [fetchData]);

  const isEmpty = !data || (data.books_total === 0 && data.copies_total === 0);

  const kpiCards = data
    ? [
        {
          label: "Tổng đầu sách",
          value: data.books_total,
          icon: <MenuBookIcon />,
          gradient: "linear-gradient(135deg, #0A2540 0%, #0F3C5C 100%)",
          delta: "Số lượng đầu sách lưu trữ",
          deltaColor: "default" as const,
        },
        {
          label: "Tổng bản sao",
          value: data.copies_total,
          icon: <ContentCopyIcon />,
          gradient: "linear-gradient(135deg, #D4AF37 0%, #B89628 100%)",
          delta: `Sẵn sàng mượn: ${data.copies_by_status.available ?? 0}`,
          deltaColor: "success" as const,
        },
        {
          label: "Định giá sách",
          value: `${data.price_coverage.priced} / ${data.books_total}`,
          icon: <PriceCheckIcon />,
          gradient: "linear-gradient(135deg, #059669 0%, #047857 100%)",
          delta: `Đã định giá: ${data.price_coverage.priced} cuốn`,
          deltaColor: "success" as const,
        },
        {
          label: "Nhập mới (30 ngày)",
          value: data.imports_last_30d,
          icon: <AddBusinessIcon />,
          gradient: "linear-gradient(135deg, #8B0000 0%, #700000 100%)",
          delta: "Bản sao bổ sung gần đây",
          deltaColor: "default" as const,
        },
      ]
    : [];

  const statusChartData = data
    ? Object.entries(data.copies_by_status).map(([st, cnt]) => ({
        status: STATUS_LABELS[st] || st,
        count: cnt,
      }))
    : [];

  const categoryChartData = data ? (data.categories || []).slice(0, 8) : [];

  const isDark = theme.palette.mode === "dark";

  return (
    <Stack spacing={3} sx={{ minHeight: 900 }}>
      <TabNavigation tabs={tabs} />

      <SectionLayout
        title="Thống kê kho sách & Hiện trạng"
        subtitle="Phân bố bản sao theo trạng thái mượn trả, tình trạng vật lý và danh mục khoa / thể loại"
        icon={<MenuBookIcon />}
        actions={
          <Button size="small" startIcon={<RefreshIcon />} onClick={fetchData} disabled={loading}>
            {loading ? <CircularProgress size={20} /> : "Làm mới"}
          </Button>
        }
        kpiCards={<KpiGrid cards={kpiCards} />}
      >
        {loading && (
          <Chip variant="outlined" label="Đang tải dữ liệu..." icon={<CircularProgress size={16} />} color="info" />
        )}

        {error && (
          <Alert
            severity="error"
            action={
              <Button color="inherit" size="small" startIcon={<RefreshIcon />} onClick={fetchData}>
                Thử lại
              </Button>
            }
          >
            {error}
          </Alert>
        )}

        {isEmpty && (
          <Alert severity="info">
            Chưa có dữ liệu kho sách. Hiện chưa có đầu sách hoặc bản sao sách nào trong hệ thống thư viện.
          </Alert>
        )}

        {data && (
          <>
            <Box sx={{ p: 2, borderRadius: 2, bgcolor: alpha(theme.palette.divider, 0.05), border: `1px solid ${theme.palette.divider}` }}>
              <Typography variant="subtitle2" sx={{ fontWeight: 700, mb: 1.5, color: "text.primary" }}>
                Tình trạng vật lý bản sao sách
              </Typography>
              <Stack direction="row" spacing={1} useFlexGap sx={{ flexWrap: "wrap" }}>
                {Object.entries(data.copies_by_condition).map(([cond, count]) => {
                  const meta = CONDITION_LABELS[cond] || { label: cond, color: "default" };
                  return (
                    <Chip
                      key={cond}
                      label={`${meta.label}: ${count} bản`}
                      color={meta.color as any}
                      variant="outlined"
                      sx={{
                        fontWeight: 700,
                        ...(isDark && {
                          bgcolor:
                            meta.color === "info"
                              ? "rgba(56, 189, 248, 0.16)"
                              : meta.color === "success"
                              ? "rgba(52, 211, 153, 0.16)"
                              : meta.color === "warning"
                              ? "rgba(251, 191, 36, 0.16)"
                              : meta.color === "error"
                              ? "rgba(248, 113, 113, 0.16)"
                              : undefined,
                          color:
                            meta.color === "info"
                              ? "#38bdf8"
                              : meta.color === "success"
                              ? "#34d399"
                              : meta.color === "warning"
                              ? "#fbbf24"
                              : meta.color === "error"
                              ? "#f87171"
                              : undefined,
                          borderColor:
                            meta.color === "info"
                              ? "rgba(56, 189, 248, 0.5)"
                              : meta.color === "success"
                              ? "rgba(52, 211, 153, 0.5)"
                              : meta.color === "warning"
                              ? "rgba(251, 191, 36, 0.5)"
                              : meta.color === "error"
                              ? "rgba(248, 113, 113, 0.5)"
                              : undefined,
                        }),
                      }}
                    />
                  );
                })}
              </Stack>
            </Box>

            <Box sx={{ display: "grid", gridTemplateColumns: { xs: "1fr", md: "5fr 7fr" }, gap: 3, mt: 3 }}>
              <ChartCard title="Phân bổ theo trạng thái" subtitle="Số lượng bản sao theo trạng thái mượn trả" height={300}>
                <ResponsiveContainer width="100%" height={300}>
                  <BarChart data={statusChartData} margin={{ top: 10, right: 10, left: 10, bottom: 20 }}>
                    <CartesianGrid strokeDasharray="3 3" stroke={theme.palette.divider} vertical={false} />
                    <XAxis dataKey="status" tick={{ fill: theme.palette.text.secondary, fontSize: 11 }} />
                    <YAxis allowDecimals={false} tick={{ fill: theme.palette.text.secondary, fontSize: 11 }} />
                    <Tooltip
                      contentStyle={{
                        backgroundColor: theme.palette.background.paper,
                        border: `1px solid ${theme.palette.divider}`,
                        borderRadius: 8,
                        color: theme.palette.text.primary,
                        boxShadow: isDark ? "0 4px 20px rgba(0,0,0,0.5)" : "0 4px 20px rgba(0,0,0,0.08)",
                      }}
                      itemStyle={{ color: theme.palette.text.primary, fontWeight: 600 }}
                      labelStyle={{ color: theme.palette.text.secondary, fontWeight: 700 }}
                    />
                    <Bar dataKey="count" name="Số bản sao" fill={isDark ? "#38bdf8" : "#0A2540"} radius={[4, 4, 0, 0]} />
                  </BarChart>
                </ResponsiveContainer>
              </ChartCard>

              <Box sx={{ display: "flex", flexDirection: "column" }}>
                <ChartCard title="Phân bổ theo Khoa / Thể loại sách" subtitle="Top 8 danh mục có nhiều đầu sách nhất" height={300}>
                  <ResponsiveContainer width="100%" height={300}>
                    <BarChart data={categoryChartData} margin={{ top: 10, right: 10, left: 10, bottom: 20 }}>
                      <CartesianGrid strokeDasharray="3 3" stroke={theme.palette.divider} vertical={false} />
                      <XAxis dataKey="name" interval={0} tick={{ fill: theme.palette.text.secondary, fontSize: 11 }} />
                      <YAxis allowDecimals={false} tick={{ fill: theme.palette.text.secondary, fontSize: 11 }} />
                      <Tooltip
                        contentStyle={{
                          backgroundColor: theme.palette.background.paper,
                          border: `1px solid ${theme.palette.divider}`,
                          borderRadius: 8,
                          color: theme.palette.text.primary,
                          boxShadow: isDark ? "0 4px 20px rgba(0,0,0,0.5)" : "0 4px 20px rgba(0,0,0,0.08)",
                        }}
                        itemStyle={{ color: theme.palette.text.primary, fontWeight: 600 }}
                        labelStyle={{ color: theme.palette.text.secondary, fontWeight: 700 }}
                      />
                      <Bar dataKey="count" name="Số đầu sách" fill={isDark ? "#fbbf24" : "#D4AF37"} radius={[4, 4, 0, 0]} />
                    </BarChart>
                  </ResponsiveContainer>
                </ChartCard>
                <Stack direction="row" spacing={1} useFlexGap sx={{ flexWrap: "wrap", mt: 1 }}>
                  {categoryChartData.map((cat) => (
                    <Chip
                      key={cat.name}
                      label={`${cat.name}: ${cat.count} đầu sách`}
                      size="small"
                      variant="outlined"
                      sx={{ fontSize: 11 }}
                    />
                  ))}
                </Stack>
              </Box>
            </Box>
          </>
        )}
      </SectionLayout>
    </Stack>
  );
}
</file>

<file path="src/app/(dashboard)/stats/realtime/page.tsx">
"use client";

import { useCallback, useEffect, useState } from "react";
import {
  Alert,
  Box,
  Button,
  Chip,
  CircularProgress,
  Stack,
  Table,
  TableBody,
  TableCell,
  TableContainer,
  TableHead,
  TableRow,
  Typography,
  useTheme,
} from "@mui/material";
import CameraIcon from "@mui/icons-material/PhotoCameraOutlined";
import CheckCircleIcon from "@mui/icons-material/CheckCircleOutlined";
import ErrorOutlineIcon from "@mui/icons-material/ErrorOutlineOutlined";
import PeopleIcon from "@mui/icons-material/HowToRegOutlined";
import RefreshIcon from "@mui/icons-material/RefreshOutlined";
import SettingsInputAntennaIcon from "@mui/icons-material/SettingsInputAntennaOutlined";
import api, { getErrorMessage } from "@/lib/api-client";
import type { CameraStatus, ActivePatron } from "@/lib/types";
import { StatCard, SectionLayout, TabNavigation, KpiGrid, type KpiCardProps } from "../_components";

const tabs = [
  { label: "Tổng quan", href: "/stats" },
  { label: "Tài chính", href: "/stats/finance" },
  { label: "Kho sách", href: "/stats/inventory" },
  { label: "Nhận diện", href: "/stats/recognition" },
  { label: "Real-time", href: "/stats/realtime" },
];

export default function RealtimePage() {
  const theme = useTheme();
  const [cameraStatuses, setCameraStatuses] = useState<CameraStatus[]>([]);
  const [activePatrons, setActivePatrons] = useState<ActivePatron[]>([]);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState<string | null>(null);

  const fetchData = useCallback(async () => {
    try {
      setLoading(true);
      setError(null);
      const [camerasRes, patronsRes] = await Promise.allSettled([
        api.getCameraStatus(),
        api.getActivePatrons(),
      ]);
      if (camerasRes.status === "fulfilled") setCameraStatuses(camerasRes.value);
      if (patronsRes.status === "fulfilled") setActivePatrons(patronsRes.value.items);
    } catch (err: any) {
      setError(getErrorMessage(err) || "Lỗi tải dữ liệu real-time");
    } finally {
      setLoading(false);
    }
  }, []);

  useEffect(() => {
    fetchData();
    const interval = setInterval(fetchData, 30000);
    return () => clearInterval(interval);
  }, [fetchData]);

  const onlineCameras = cameraStatuses.filter((c) => c.connected).length;
  const totalCameras = cameraStatuses.length;

  const kpiCards: KpiCardProps[] = [
    {
      label: "Camera hoạt động",
      value: `${onlineCameras}/${totalCameras}`,
      icon: <CameraIcon />,
      gradient: onlineCameras === totalCameras
        ? "linear-gradient(135deg, #059669 0%, #047857 100%)"
        : onlineCameras > 0
        ? "linear-gradient(135deg, #D4AF37 0%, #B89628 100%)"
        : "linear-gradient(135deg, #DC2626 0%, #B91C1C 100%)",
      delta: onlineCameras === totalCameras ? "Tất cả online" : `${totalCameras - onlineCameras} offline`,
      deltaColor: onlineCameras === totalCameras ? "success" : onlineCameras > 0 ? "warning" : "error",
    },
    {
      label: "Độc giả đang có mặt",
      value: activePatrons.length,
      icon: <PeopleIcon />,
      gradient: "linear-gradient(135deg, #0A2540 0%, #0F3C5C 100%)",
      delta: "Đang trong thư viện",
      deltaColor: "default" as const,
    },
    {
      label: "Trạng thái kết nối",
      value: onlineCameras === totalCameras ? "Ổn định" : "Có vấn đề",
      icon: <SettingsInputAntennaIcon />,
      gradient: onlineCameras === totalCameras
        ? "linear-gradient(135deg, #059669 0%, #047857 100%)"
        : "linear-gradient(135deg, #DC2626 0%, #B91C1C 100%)",
      delta: "Auto refresh 30s",
      deltaColor: onlineCameras === totalCameras ? "success" : "error",
    },
    {
      label: "Cập nhật gần nhất",
      value: new Date().toLocaleTimeString("vi-VN", { hour: "2-digit", minute: "2-digit" }),
      icon: <RefreshIcon />,
      gradient: "linear-gradient(135deg, #8B0000 0%, #700000 100%)",
      delta: "Tự động làm mới",
      deltaColor: "default" as const,
    },
  ];

  return (
    <Stack spacing={3} sx={{ minHeight: 900 }}>
      <TabNavigation tabs={tabs} />

      <SectionLayout
        title="Real-time: Camera & Hiện diện"
        subtitle="Trạng thái camera, độc giả đang có mặt - Tự động cập nhật mỗi 30 giây"
        icon={<CameraIcon />}
        actions={
          <Button size="small" startIcon={<RefreshIcon />} onClick={fetchData} disabled={loading}>
            {loading ? <CircularProgress size={20} /> : "Làm mới ngay"}
          </Button>
        }
        kpiCards={<KpiGrid cards={kpiCards} />}
      >
        {loading && (
          <Chip variant="outlined" label="Đang tải dữ liệu..." icon={<CircularProgress size={16} />} color="info" />
        )}

        {error && (
          <Alert
            severity="error"
            action={
              <Button color="inherit" size="small" startIcon={<RefreshIcon />} onClick={fetchData}>
                Thử lại
              </Button>
            }
          >
            {error}
          </Alert>
        )}

        <Box sx={{ display: "grid", gridTemplateColumns: { xs: "1fr", md: "1fr 1fr" }, gap: 3 }}>
          <Box>
            <Typography variant="h6" sx={{ fontWeight: 800, mb: 2 }}>
              Trạng thái Camera ({onlineCameras}/{totalCameras} online)
            </Typography>
            {cameraStatuses.length === 0 ? (
              <Alert severity="info">Không có camera nào được cấu hình</Alert>
            ) : (
              <Box sx={{ display: "grid", gridTemplateColumns: { xs: "1fr", sm: "repeat(2, 1fr)", md: "repeat(3, 1fr)" }, gap: 2 }}>
                {cameraStatuses.map((cam, idx) => {
                  const isOnline = cam.connected && cam.running;
                  const hasError = cam.last_error && !isOnline;
                  return (
                    <Box
                      key={cam.camera_id}
                      sx={{
                        borderRadius: 3,
                        overflow: "hidden",
                        border: `2px solid ${isOnline ? "success.main" : "error.main"}`,
                        transition: "transform 0.2s, box-shadow 0.2s",
                        "&:hover": { transform: "translateY(-2px)", boxShadow: 4 },
                      }}
                    >
                      <Box sx={{ p: 2, bgcolor: isOnline ? "success.50" : "error.50" }}>
                        <Stack direction="row" spacing={1.5} sx={{ alignItems: "center", mb: 1.5 }}>
                          <Box
                            sx={{
                              width: 40,
                              height: 40,
                              borderRadius: "50%",
                              background: isOnline ? "success.main" : "error.main",
                              display: "flex",
                              alignItems: "center",
                              justifyContent: "center",
                              boxShadow: "0 4px 12px rgba(0,0,0,0.15)",
                            }}
                          >
                            <CameraIcon sx={{ fontSize: 22, color: "white" }} />
                          </Box>
                          <Box sx={{ flex: 1 }}>
                            <Typography variant="subtitle2" sx={{ fontWeight: 700 }}>
                              {cam.camera_id === "entry_gate" ? "Cổng vào" : cam.camera_id === "exit_gate" ? "Cổng ra" : "Kiosk"}
                            </Typography>
                            <Stack direction="row" spacing={0.5} sx={{ alignItems: "center" }}>
                              {isOnline ? (
                                <CheckCircleIcon sx={{ fontSize: 14, color: "success.main" }} />
                              ) : (
                                <ErrorOutlineIcon sx={{ fontSize: 14, color: "error.main" }} />
                              )}
                              <Typography variant="caption" color={isOnline ? "success.main" : "error.main"} sx={{ fontWeight: 600 }}>
                                {isOnline ? "Online" : "Offline"}
                              </Typography>
                            </Stack>
                          </Box>
                        </Stack>

                        <Stack spacing={1}>
                          <Stack direction="row" sx={{ justifyContent: "space-between" }}>
                            <Typography variant="caption" color="text.secondary">Khung hình xử lý</Typography>
                            <Typography variant="caption" sx={{ fontWeight: 700, fontFamily: "monospace" }}>
                              {cam.frames_processed.toLocaleString("vi-VN")}
                            </Typography>
                          </Stack>
                          {cam.last_frame_time ? (
                            <Stack direction="row" sx={{ justifyContent: "space-between" }}>
                              <Typography variant="caption" color="text.secondary">Khung cuối</Typography>
                              <Typography variant="caption" sx={{ fontFamily: "monospace" }}>
                                {new Date(cam.last_frame_time).toLocaleTimeString("vi-VN")}
                              </Typography>
                            </Stack>
                          ) : null}
                          {cam.retry_count > 0 ? (
                            <Stack direction="row" sx={{ justifyContent: "space-between" }}>
                              <Typography variant="caption" color="text.secondary">Số lần retry</Typography>
                              <Chip size="small" label={cam.retry_count} color="warning" sx={{ height: 20, fontSize: "0.7rem" }} />
                            </Stack>
                          ) : null}
                          {cam.last_error && !isOnline ? (
                            <Typography variant="caption" color="error.main" sx={{ mt: 0.5, lineHeight: 1.3 }}>
                              {cam.last_error}
                            </Typography>
                          ) : null}
                        </Stack>
                      </Box>
                    </Box>
                  );
                })}
              </Box>
            )}
          </Box>

          <Box>
            <Typography variant="h6" sx={{ fontWeight: 800, mb: 2 }}>
              Độc giả đang có mặt ({activePatrons.length})
            </Typography>
            {activePatrons.length === 0 ? (
              <Alert severity="info">Không có độc giả nào trong thư viện</Alert>
            ) : (
              <Stack spacing={1} sx={{ maxHeight: 500, overflowY: "auto" }}>
                {activePatrons.slice(0, 30).map((p, idx) => (
                  <Box
                    key={p.id}
                    sx={{
                      borderRadius: 2,
                      border: "1px solid",
                      borderColor: "divider",
                      p: 1.5,
                      transition: "background 0.15s",
                      "&:hover": { bgcolor: "action.hover" },
                    }}
                  >
                    <Stack direction="row" spacing={1.5} sx={{ alignItems: "center", justifyContent: "space-between" }}>
                      <Stack direction="row" spacing={1.25} sx={{ alignItems: "center", minWidth: 0 }}>
                        <Box
                          sx={{
                            width: 36,
                            height: 36,
                            borderRadius: "50%",
                            background: "linear-gradient(135deg, #059669 0%, #047857 100%)",
                            display: "flex",
                            alignItems: "center",
                            justifyContent: "center",
                            color: "white",
                            fontWeight: 900,
                            fontSize: 14,
                            boxShadow: "0 2px 8px rgba(0,0,0,0.15)",
                          }}
                        >
                          {p.full_name?.charAt(0) || "?"}
                        </Box>
                        <Box sx={{ minWidth: 0 }}>
                          <Typography variant="body2" sx={{ fontWeight: 700, fontSize: "0.85rem" }} noWrap>
                            {p.full_name || "Không rõ tên"}
                          </Typography>
                          <Typography variant="caption" color="text.secondary" sx={{ fontFamily: "monospace" }}>
                            {p.student_code || "---"}
                          </Typography>
                        </Box>
                      </Stack>
                      <Box sx={{ textAlign: "right", minWidth: 120 }}>
                        <Typography variant="caption" sx={{ fontFamily: "monospace" }}>
                          {new Date(p.entered_at).toLocaleTimeString("vi-VN")}
