        permanent_address: u.permanent_address ?? u.permanentAddress ?? null,
        created_at: u.created_at ?? u.createdAt ?? null,
        identity_number: u.identity_number ?? u.identityNumber ?? null,
        class_name: u.class_name ?? u.className ?? null,
