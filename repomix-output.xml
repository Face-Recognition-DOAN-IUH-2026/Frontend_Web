<file path="src/app/(dashboard)/liveness/page.tsx">
"use client";

import { useState } from "react";
import { Eye, EyeOff } from "lucide-react";
import CameraCapture from "@/components/camera-capture";
import JobPoll from "@/components/job-poll";
import api, { getErrorMessage } from "@/lib/api-client";
import type { LivenessBreakdown } from "@/lib/types";

const breakdownLabels: Record<keyof LivenessBreakdown, string> = {
  lbp: "Kết cấu (LBP)",
  color: "Màu sắc",
  noise: "Nhiễu",
  fft: "Tần số (FFT)",
  multi_scale: "Đa tỷ lệ",
  bbox: "Tỷ lệ khuôn mặt",
  insightface: "Học sâu",
};

function BreakdownBar({ label, score }: { label: string; score: number }) {
  const pct = Math.round(score * 100);
  const color =
    score >= 0.7 ? "bg-green-500" : score >= 0.4 ? "bg-yellow-500" : "bg-red-500";
  return (
    <div className="flex items-center gap-2 text-sm">
      <span className="w-28 text-right text-gray-600 shrink-0">{label}</span>
      <div className="flex-1 bg-gray-200 rounded h-2">
        <div
          className={`h-2 rounded transition-all duration-500 ${color}`}
          style={{ width: `${pct}%` }}
        />
      </div>
      <span className="w-10 text-right font-mono text-xs text-gray-500">{pct}%</span>
    </div>
  );
}

function LivenessResultCard({ result }: { result: any }) {
  const isLive = result.is_live;
  const score = result.liveness_score ?? 0;
  const breakdown: LivenessBreakdown | undefined = result.breakdown;

  return (
    <div className="bg-white p-6 rounded-lg border space-y-4">
      <div className="flex items-center gap-3">
        {isLive ? (
          <Eye className="w-8 h-8 text-green-600" />
        ) : (
          <EyeOff className="w-8 h-8 text-red-600" />
        )}
        <div>
          <p className="text-xl font-bold">
            {isLive ? "KHUÔN MẶT THẬT" : "PHÁT HIỆN GIẢ MẠO"}
          </p>
          <p className="text-sm text-gray-500">
            Độ tin cậy: {(score * 100).toFixed(1)}%
          </p>
        </div>
      </div>

      {breakdown && (
        <div className="space-y-2 pt-3 border-t">
          <p className="text-xs font-semibold text-gray-400 uppercase tracking-wide">
            Chi tiết kỹ thuật
          </p>
          {Object.entries(breakdownLabels).map(([key, label]) => {
            const val = breakdown[key as keyof LivenessBreakdown];
            if (val === undefined) return null;
            return <BreakdownBar key={key} label={label} score={val} />;
          })}
        </div>
      )}
    </div>
  );
}

export default function LivenessPage() {
  const [imageFile, setImageFile] = useState<File | null>(null);
  const [consent, setConsent] = useState(false);
  const [isLoading, setIsLoading] = useState(false);
  const [jobId, setJobId] = useState<string | null>(null);
  const [result, setResult] = useState<any>(null);
  const [error, setError] = useState("");

  const handleCapture = (file: File, _dataUrl: string) => {
    setImageFile(file);
    setResult(null);
    setError("");
  };

  const handleSubmit = async (e: React.FormEvent) => {
    e.preventDefault();
    if (!imageFile) return;

    setError("");
    setIsLoading(true);
    setJobId(null);
    setResult(null);

    try {
      const data = await api.livenessCheck(imageFile, consent);
      setJobId(data.job_id);
    } catch (err: any) {
      setError(getErrorMessage(err) || "Kiểm tra liveness thất bại");
      setIsLoading(false);
    }
  };

  const handleComplete = (res: any) => {
    setResult(res);
    setIsLoading(false);
    setJobId(null);
  };

  const handleError = (err: string) => {
    setError(err);
    setIsLoading(false);
    setJobId(null);
  };

  const handleReset = () => {
    setImageFile(null);
    setJobId(null);
    setResult(null);
    setError("");
  };

  return (
    <div className="max-w-2xl mx-auto">
      <h1 className="text-2xl font-bold mb-6">Kiểm tra Liveness</h1>

      {error && (
        <div className="mb-4 p-4 bg-red-50 text-red-600 rounded-lg">{error}</div>
      )}

      {result ? (
        <div className="space-y-4">
          <LivenessResultCard result={result} />
          <div className="flex justify-center">
            <button
              onClick={handleReset}
              className="px-6 py-2 bg-primary text-primary-foreground rounded-md hover:opacity-90"
            >
              Thử lại
            </button>
          </div>
        </div>
      ) : jobId ? (
        <JobPoll
          jobId={jobId}
          onComplete={handleComplete}
          onError={handleError}
        />
      ) : (
        <form
          onSubmit={handleSubmit}
          className="bg-white p-6 rounded-lg border space-y-6"
        >
          <div>
            <label className="block text-sm font-medium mb-2">
              Chụp ảnh khuôn mặt để kiểm tra liveness
            </label>
            <CameraCapture onCapture={handleCapture} />
          </div>

          <div className="flex items-center gap-3">
            <input
              type="checkbox"
              id="consent"
              checked={consent}
              onChange={(e) => setConsent(e.target.checked)}
              className="w-5 h-5"
            />
            <label htmlFor="consent" className="text-sm text-gray-600">
              Tôi đồng ý với việc kiểm tra liveness trên dữ liệu khuôn mặt của mình.
            </label>
          </div>

          <button
            type="submit"
            disabled={!imageFile || !consent || isLoading}
            className="w-full py-3 bg-primary text-primary-foreground rounded-md hover:opacity-90 disabled:opacity-50"
          >
            {isLoading ? "Đang kiểm tra..." : "Kiểm tra Liveness"}
          </button>
        </form>
      )}
    </div>
  );
}
</file>

<file path="src/app/login/page.tsx">
"use client";

import { useState, useCallback, useRef, useEffect } from "react";
import { Eye, Camera, Upload } from "lucide-react";
import { useAuth } from "@/lib/auth-context";
import { useRouter } from "next/navigation";
import Link from "next/link";
import api, { getErrorMessage } from "@/lib/api-client";

type LoginMode = "password" | "face";

export default function LoginPage() {
  const { login, setAuthFromToken } = useAuth();
  const router = useRouter();
  const [mode, setMode] = useState<LoginMode>("password");
  const [email, setEmail] = useState("");
  const [password, setPassword] = useState("");
  const [error, setError] = useState("");
  const [isLoading, setIsLoading] = useState(false);

  const [imageFile, setImageFile] = useState<File | null>(null);
  const [imagePreview, setImagePreview] = useState<string | null>(null);
  const [isCameraOn, setIsCameraOn] = useState(false);
  const [cameraReady, setCameraReady] = useState(false);
  const [jobId, setJobId] = useState<string | null>(null);
  const [success, setSuccess] = useState(false);
  const videoRef = useRef<HTMLVideoElement>(null);
  const streamRef = useRef<MediaStream | null>(null);
  const readyTimeoutRef = useRef<ReturnType<typeof setTimeout>>(null);
  const pollIntervalRef = useRef<ReturnType<typeof setInterval> | null>(null);

  const startCamera = useCallback(async () => {
    try {
      setError("");
      setCameraReady(false);
      if (streamRef.current) {
        streamRef.current.getTracks().forEach((t) => t.stop());
      }
      const stream = await navigator.mediaDevices.getUserMedia({
        video: { facingMode: "user", width: { ideal: 640 }, height: { ideal: 480 } },
        audio: false,
      });
      streamRef.current = stream;
      setIsCameraOn(true);
    } catch {
      setError("Camera access denied or not available");
      setIsCameraOn(false);
    }
  }, []);

  useEffect(() => {
    if (!isCameraOn || !videoRef.current || !streamRef.current) return;
    const video = videoRef.current;
    const stream = streamRef.current;
    const onReady = () => setCameraReady(true);
    video.onloadedmetadata = onReady;
    video.onplaying = onReady;
    video.onerror = () => setError("Camera error");
    video.srcObject = stream;
    if (video.readyState >= 2) onReady();
    readyTimeoutRef.current = setTimeout(() => setCameraReady(true), 3000);
    return () => {
      if (readyTimeoutRef.current) clearTimeout(readyTimeoutRef.current);
      video.onloadedmetadata = null;
      video.onplaying = null;
      video.onerror = null;
      video.srcObject = null;
    };
  }, [isCameraOn]);

  const stopCamera = useCallback(() => {
    if (streamRef.current) {
      streamRef.current.getTracks().forEach((t) => t.stop());
      streamRef.current = null;
    }
    setIsCameraOn(false);
    setCameraReady(false);
  }, []);

  useEffect(() => {
    return () => {
      stopCamera();
      if (pollIntervalRef.current) {
        clearInterval(pollIntervalRef.current);
        pollIntervalRef.current = null;
      }
    };
  }, [stopCamera]);

  const capturePhoto = () => {
    if (!videoRef.current || !cameraReady) return;
    const video = videoRef.current;
    if (video.videoWidth === 0 || video.videoHeight === 0) return;
    const canvas = document.createElement("canvas");
    canvas.width = video.videoWidth;
    canvas.height = video.videoHeight;
    const ctx = canvas.getContext("2d");
    if (!ctx) return;
    ctx.drawImage(video, 0, 0);
    canvas.toBlob((blob) => {
      if (!blob) return;
      const file = new File([blob], "face.jpg", { type: "image/jpeg" });
      setImageFile(file);
      setImagePreview(canvas.toDataURL("image/jpeg"));
      stopCamera();
    }, "image/jpeg", 0.9);
  };

  const handlePasswordSubmit = async (e: React.FormEvent) => {
    e.preventDefault();
    setError("");
    setIsLoading(true);
    try {
      await login(email, password);
    } catch (err: any) {
      setError(getErrorMessage(err) || "Login failed");
    } finally {
      setIsLoading(false);
    }
  };

  const handleFileChange = (e: React.ChangeEvent<HTMLInputElement>) => {
    const file = e.target.files?.[0];
    if (!file) return;
    setImageFile(file);
    const reader = new FileReader();
    reader.onload = (ev) => setImagePreview(ev.target?.result as string);
    reader.readAsDataURL(file);
    stopCamera();
  };

  const handleFaceSubmit = async (e: React.FormEvent) => {
    e.preventDefault();
    if (!imageFile || !email) return;
    setError("");
    setIsLoading(true);
    setJobId(null);
    try {
      const { job_id } = await api.faceLogin(email, imageFile);
      setJobId(job_id);
      pollFaceLogin(job_id);
    } catch (err: any) {
      setError(getErrorMessage(err) || "Face login failed");
      setIsLoading(false);
    }
  };

  const pollFaceLogin = useCallback(
    async (taskId: string) => {
      if (pollIntervalRef.current) clearInterval(pollIntervalRef.current);
      pollIntervalRef.current = setInterval(async () => {
        try {
          const resp = await api.getTaskStatus(taskId);
          if (resp.status === "SUCCESS" && resp.result) {
            if (pollIntervalRef.current) clearInterval(pollIntervalRef.current);
            pollIntervalRef.current = null;
            if (resp.result.status === "error") {
              setError(resp.result.error || "Face login failed");
              setIsLoading(false);
              setJobId(null);
            } else if (resp.result.access_token) {
              setAuthFromToken(resp.result.access_token, resp.result.refresh_token || null, email, "user");
              setSuccess(true);
              setJobId(null);
              setIsLoading(false);
              setTimeout(() => router.push("/dashboard"), 500);
            }
          } else if (resp.status === "FAILURE") {
            if (pollIntervalRef.current) clearInterval(pollIntervalRef.current);
            pollIntervalRef.current = null;
            setError(resp.result?.error || "Face login failed");
            setIsLoading(false);
            setJobId(null);
          }
        } catch {
          if (pollIntervalRef.current) clearInterval(pollIntervalRef.current);
          pollIntervalRef.current = null;
          setError("Failed to poll login status");
          setIsLoading(false);
          setJobId(null);
        }
      }, 2000);
    },
    [email, router],
  );

  return (
    <div className="min-h-screen flex items-center justify-center bg-gray-50">
      <div className="max-w-md w-full p-6 bg-white rounded-lg shadow-md">
        <div className="text-center mb-6">
          <h1 className="text-2xl font-bold">Welcome Back</h1>
          <p className="text-gray-600">Sign in to your account</p>
        </div>

        <div className="flex mb-6 border rounded-lg overflow-hidden">
          <button
            type="button"
            onClick={() => { setMode("password"); setError(""); setJobId(null); }}
            className={`flex-1 py-2 text-sm font-medium ${
              mode === "password"
                ? "bg-primary text-primary-foreground"
                : "bg-gray-100 text-gray-600 hover:bg-gray-200"
            }`}
          >
            Password
          </button>
          <button
            type="button"
            onClick={() => { setMode("face"); setError(""); setJobId(null); }}
            className={`flex-1 py-2 text-sm font-medium flex items-center justify-center gap-1 ${
              mode === "face"
                ? "bg-primary text-primary-foreground"
                : "bg-gray-100 text-gray-600 hover:bg-gray-200"
            }`}
          >
            <Eye className="w-4 h-4" />
            Face
          </button>
        </div>

        {error && (
          <div className="mb-4 p-3 bg-red-50 text-red-600 rounded-md text-sm">
            {error}
          </div>
        )}

        {success ? (
          <div className="text-center py-8">
            <div className="rounded-full h-16 w-16 bg-green-100 flex items-center justify-center mx-auto mb-4">
              <svg className="w-8 h-8 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M5 13l4 4L19 7" />
              </svg>
            </div>
            <p className="text-lg font-semibold text-green-600">Login Successful!</p>
            <p className="text-sm text-gray-500 mt-1">Redirecting to dashboard...</p>
          </div>
        ) : jobId ? (
          <div className="text-center py-8">
            <div className="animate-spin rounded-full h-12 w-12 border-t-2 border-b-2 border-primary mx-auto mb-4" />
            <p className="text-gray-600">Verifying face...</p>
            <p className="text-xs text-gray-400 mt-1">Job ID: {jobId}</p>
          </div>
        ) : mode === "password" ? (
          <form onSubmit={handlePasswordSubmit} className="space-y-4">
            <div>
              <label htmlFor="email" className="block text-sm font-medium mb-1">Email</label>
              <input
                id="email" type="email" value={email} autoComplete="email"
                onChange={(e) => setEmail(e.target.value)}
                className="w-full px-3 py-2 border rounded-md focus:outline-none focus:ring-2 focus:ring-primary" required
              />
            </div>
            <div>
              <label htmlFor="password" className="block text-sm font-medium mb-1">Password</label>
              <input
                id="password" type="password" value={password} autoComplete="current-password"
                onChange={(e) => setPassword(e.target.value)}
                className="w-full px-3 py-2 border rounded-md focus:outline-none focus:ring-2 focus:ring-primary" required
              />
            </div>
            <button type="submit" disabled={isLoading}
              className="w-full py-2 bg-primary text-primary-foreground rounded-md hover:opacity-90 disabled:opacity-50"
            >
              {isLoading ? "Signing in..." : "Sign In"}
            </button>
          </form>
        ) : (
          <form onSubmit={handleFaceSubmit} className="space-y-4">
            <div>
              <label htmlFor="face-email" className="block text-sm font-medium mb-1">Email</label>
              <input
                id="face-email" type="email" value={email}
                onChange={(e) => setEmail(e.target.value)}
                className="w-full px-3 py-2 border rounded-md focus:outline-none focus:ring-2 focus:ring-primary"
                placeholder="Enter your email" required
              />
            </div>

            {imagePreview ? (
              <div className="space-y-2">
                <div className="aspect-video bg-black rounded-lg overflow-hidden">
                  <img src={imagePreview} alt="Captured" className="w-full h-full object-contain" />
                </div>
                <button type="button" onClick={() => { setImageFile(null); setImagePreview(null); }}
                  className="w-full py-2 text-sm bg-gray-100 rounded-md hover:bg-gray-200"
                >
                  Retake
                </button>
              </div>
            ) : (
              <>
                <div className="relative aspect-video bg-black rounded-lg overflow-hidden">
                  {isCameraOn ? (
                    <>
                      <video ref={videoRef} autoPlay playsInline muted className="w-full h-full object-contain" />
                      {!cameraReady && (
                        <div className="absolute inset-0 flex items-center justify-center bg-black/50 text-white">
                          Loading camera...
                        </div>
                      )}
                    </>
                  ) : (
                    <div className="flex items-center justify-center h-full text-gray-400 text-sm p-4">
                      Click "Start Camera" or "Upload"
                    </div>
                  )}
                </div>
                <div className="flex gap-3">
                  {!isCameraOn ? (
                    <button type="button" onClick={startCamera}
                      className="flex-1 flex items-center justify-center gap-2 px-4 py-2 bg-gray-100 rounded-md hover:bg-gray-200"
                    >
                      <Camera className="w-5 h-5" /> Start Camera
                    </button>
                  ) : (
                    <button type="button" onClick={capturePhoto} disabled={!cameraReady}
                      className="flex-1 px-4 py-2 bg-primary text-primary-foreground rounded-md hover:opacity-90 disabled:opacity-50"
                    >
                      Capture
                    </button>
                  )}
                  <label className="flex-1 flex items-center justify-center gap-2 px-4 py-2 bg-gray-100 rounded-md hover:bg-gray-200 cursor-pointer">
                    <Upload className="w-5 h-5" /> Upload
                    <input type="file" accept="image/*" capture="user" onChange={handleFileChange} className="hidden" />
                  </label>
                  {isCameraOn && (
                    <button type="button" onClick={stopCamera}
                      className="px-4 py-2 text-red-600 bg-red-50 rounded-md hover:bg-red-100"
                    >
                      Stop
                    </button>
                  )}
                </div>
              </>
            )}

            {imagePreview && (
              <button type="submit" disabled={!email || isLoading}
                className="w-full py-2 bg-primary text-primary-foreground rounded-md hover:opacity-90 disabled:opacity-50 flex items-center justify-center gap-2"
              >
                <Eye className="w-4 h-4" />
                {isLoading ? "Verifying..." : "Login with Face"}
              </button>
            )}
          </form>
        )}

        <p className="mt-4 text-center text-sm text-gray-600">
          Don&apos;t have an account?{" "}
          <Link href="/register" className="text-primary hover:underline">Register</Link>
        </p>
      </div>
    </div>
  );
}
