    font-size: 0.6875rem;
    font-weight: 400;
    color: #7A7368;
  }
  .text-mono {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.8125rem;
  }
}

@layer components {
  /* Card variants */
  .card {
    @apply bg-surface rounded-lg border border-border p-4;
  }
  .card-elevated {
    @apply bg-surface-2 rounded-lg border p-4;
    border-color: #3A4052;
  }
  .card-bordered {
    @apply bg-surface-3 rounded-xl p-6;
    border: 1px solid #3A4052;
  }

  /* Button styles */
  .btn {
    @apply inline-flex items-center justify-center gap-2 font-body font-medium text-sm rounded-md transition-all duration-150 focus:outline-none focus:ring-2 focus:ring-primary/50 disabled:opacity-50 disabled:cursor-not-allowed;
  }
  .btn-primary {
    @apply btn bg-primary px-4 py-2.5 active:scale-[0.98];
    color: #12151E;
  }
  .btn-primary:hover {
    background-color: #A88430;
  }
  .btn-secondary {
    @apply btn bg-surface-2 text-text border px-4 py-2.5 active:scale-[0.98];
    border-color: #2E3345;
  }
  .btn-secondary:hover {
    background-color: #2C3042;
    border-color: #3A4052;
  }
  .btn-ghost {
    @apply btn bg-transparent px-3 py-2;
    color: #B8B0A4;
  }
  .btn-ghost:hover {
    background-color: #242838;
    color: #EDE8DF;
  }
  .btn-danger {
    @apply btn px-4 py-2.5 active:scale-[0.98];
    background-color: rgba(196, 78, 78, 0.1);
    color: #C44E4E;
    border: 1px solid rgba(196, 78, 78, 0.2);
  }
  .btn-danger:hover {
    background-color: rgba(196, 78, 78, 0.2);
  }

  /* Input styles */
  .input {
    @apply w-full bg-surface-2 border border-border rounded-md px-3 py-2.5 text-body-md text-text placeholder:text-text-3 transition-colors focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary/30;
  }

  /* Badge styles */
  .badge {
    @apply inline-flex items-center gap-1 px-2 py-0.5 rounded-sm text-body-sm font-medium;
  }
  .badge-success {
    @apply badge bg-success/15 text-success;
  }
  .badge-error {
    @apply badge bg-error/15 text-error;
  }
  .badge-warning {
    @apply badge bg-warning/15 text-warning;
  }
  .badge-info {
    @apply badge bg-info/15 text-info;
  }
  .badge-neutral {
    @apply badge bg-surface-2 text-text-2;
  }

  /* Nav item */
  .nav-item {
    @apply flex items-center gap-3 px-3 py-2.5 rounded-md text-body-md text-text transition-all duration-150 hover:bg-surface-2 hover:text-text cursor-pointer;
  }
  .nav-item-active {
    @apply nav-item bg-primary/10 text-primary border-l-[3px] border-primary;
  }

  /* Table styles */
  .table-container {
    @apply overflow-x-auto rounded-lg border border-border;
  }
  .table {
    @apply w-full text-body-sm;
  }
  .table th {
    @apply text-label px-4 py-3 text-left bg-surface-2 border-b border-border;
  }
  .table td {
    @apply px-4 py-3 border-b border-border last:border-b-0;
  }
  .table tr {
    @apply transition-colors hover:bg-surface-2/50;
  }
  .table tr:hover td {
    @apply bg-surface-2/50;
  }

  /* Stat card */
  .stat-card {
    @apply card-elevated relative overflow-hidden;
  }
  .stat-card::before {
    content: '';
    @apply absolute top-0 left-0 w-1 h-full;
  }

  /* Surface variants */
  .surface {
    @apply bg-surface;
  }
  .surface-2 {
    @apply bg-surface-2;
  }
  .surface-3 {
    @apply bg-surface-3;
  }
}

@layer base {
  /* Focus visible styles */
  *:focus-visible {
    @apply outline-none ring-2 ring-primary/50 ring-offset-2 ring-offset-bg;
  }

  /* Selection color */
  ::selection {
    background: rgba(212, 168, 83, 0.3);
    color: #EDE8DF;
  }
}

/* Shimmer loading animation */
.shimmer {
  background: linear-gradient(
    90deg,
    #1C2030 0%,
    #242838 50%,
    #1C2030 100%
  );
  background-size: 200% 100%;
  animation: shimmer 1.5s ease-in-out infinite;
}

/* Toast container positioning */
.toast-container {
  position: fixed;
  top: 16px;
  right: 16px;
  z-index: 9999;
  display: flex;
  flex-direction: column;
  gap: 8px;
  pointer-events: none;
}

.toast-container > * {
  pointer-events: auto;
}
