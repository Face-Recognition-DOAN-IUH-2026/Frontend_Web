"use client";

import { useState } from "react";
import {
  Box,
  Button,
  Card,
  CardContent,
  Chip,
  Dialog,
  DialogContent,
  DialogTitle,
  IconButton,
  Typography,
} from "@mui/material";
import CloseIcon from "@mui/icons-material/Close";
import LocationOnIcon from "@mui/icons-material/LocationOnOutlined";
import MapIcon from "@mui/icons-material/MapOutlined";
import ViewInArIcon from "@mui/icons-material/ViewInArOutlined";
import dynamic from "next/dynamic";
import type { BookCardData } from "../../BookCard";

const VRViewer = dynamic(
  () => import("@/app/library/vr-tour/_components/VRViewer"),
  { ssr: false }
);

interface BookLocationCardProps {
  data: BookCardData & { shelf_location?: string };
}

export default function BookLocationCard({ data }: BookLocationCardProps) {
  const [mapOpen, setMapOpen] = useState(false);
  const [vrOpen, setVrOpen] = useState(false);

  const floorMatch = data.shelf_location?.match(/^([A-Za-z]+\d+)/);
  const floorLabel = floorMatch ? `Tầng ${floorMatch[1]}` : null;

  return (
    <>
      <Card
        sx={{
          maxWidth: 360,
          border: "1px solid",
          borderColor: "divider",
          borderRadius: 2,
          overflow: "hidden",
          my: 1,
        }}
      >
        <CardContent sx={{ p: 2 }}>
          <Typography variant="h6" component="h3" sx={{ fontWeight: 600, mb: 0.5 }}>
            {data.title}
          </Typography>

          {data.author && (
            <Typography variant="body2" color="text.secondary" sx={{ mb: 1 }}>
              Tác giả: {data.author}
            </Typography>
          )}

          <Box sx={{ display: "flex", flexWrap: "wrap", gap: 0.5, mb: 1 }}>
            {data.isbn && (
              <Chip label={`ISBN: ${data.isbn}`} size="small" variant="outlined" />
            )}
            {data.categories && (
              <Chip label={data.categories} size="small" color="primary" variant="outlined" />
            )}
            {data.source && (
              <Chip
                label={data.source === "database" ? "Trong thư viện" : "Google Books"}
                size="small"
                color={data.source === "database" ? "success" : "info"}
              />
            )}
          </Box>

          {data.shelf_location && (
            <Box
              sx={{
                display: "flex",
                alignItems: "center",
                gap: 0.5,
                mt: 1,
                p: 1,
                bgcolor: "action.hover",
                borderRadius: 1,
              }}
            >
              <LocationOnIcon fontSize="small" color="primary" />
              <Typography variant="body2" color="text.secondary">
                Vị trí: <strong>{data.shelf_location}</strong>
              </Typography>
              {floorLabel && (
                <Chip label={floorLabel} size="small" variant="outlined" sx={{ ml: "auto" }} />
              )}
            </Box>
          )}

          <Button
            variant="outlined"
            size="small"
            startIcon={<MapIcon />}
            onClick={() => setMapOpen(true)}
            fullWidth
            sx={{ mt: 1.5 }}
            disabled={!floorLabel}
          >
            Xem trên bản đồ
          </Button>
          {data.shelf_location ? (
            <Button
              variant="contained"
              size="small"
              startIcon={<ViewInArIcon />}
              onClick={() => setVrOpen(true)}
              fullWidth
              sx={{ mt: 1, background: "linear-gradient(135deg, #10b981 0%, #059669 100%)", "&:hover": { background: "linear-gradient(135deg, #059669 0%, #047857 100%)" } }}
            >
              Chỉ đường 3D
            </Button>
          ) : null}
        </CardContent>
      </Card>

      <Dialog
        open={mapOpen}
        onClose={() => setMapOpen(false)}
        maxWidth="md"
        fullWidth
        slotProps={{ paper: { sx: { borderRadius: 2 } } }}
      >
        <>
          <DialogTitle sx={{ display: "flex", alignItems: "center", justifyContent: "space-between" }}>
            <Box sx={{ display: "flex", alignItems: "center", gap: 1 }}>
              <MapIcon color="primary" />
              <Typography variant="h6" sx={{ fontWeight: 700 }}>
                {data.title} — {floorLabel || "Bản đồ thư viện"}
              </Typography>
            </Box>
            <IconButton onClick={() => setMapOpen(false)} size="small">
              <CloseIcon />
            </IconButton>
          </DialogTitle>
          <DialogContent>
            <Box
              sx={{
                p: 4,
                textAlign: "center",
                color: "text.secondary",
              }}
            >
              <MapIcon sx={{ fontSize: 48, mb: 1, opacity: 0.4 }} />
              <Typography variant="body1" sx={{ mb: 1 }}>
                Bản đồ tầng đang được tải
              </Typography>
              <Typography variant="body2">
                Sách nằm tại vị trí <strong>{data.shelf_location}</strong>
                {floorLabel ? ` (${floorLabel})` : ""}
              </Typography>
            </Box>
          </DialogContent>
        </>
      </Dialog>

      <Dialog open={vrOpen} onClose={() => setVrOpen(false)} maxWidth="lg" fullWidth fullScreen>
        <DialogTitle sx={{ m: 0, p: 2, display: "flex", justifyContent: "space-between", alignItems: "center", bgcolor: "#0f172a", color: "white" }}>
          <Typography variant="h6">Chỉ đường đến kệ — {data.shelf_location}</Typography>
          <IconButton onClick={() => setVrOpen(false)} sx={{ color: "white" }}>
            <CloseIcon />
          </IconButton>
        </DialogTitle>
        <DialogContent dividers sx={{ p: 0, overflow: "hidden" }}>
          {vrOpen ? <VRViewer /> : null}
        </DialogContent>
      </Dialog>
    </>
  );
}
</file>

<file path="src/app/(dashboard)/_components/AIWidget/cards/LibraryHoursCard.tsx">
"use client";

import React from "react";
import {
  Box,
  Card,
  CardContent,
  Chip,
  Divider,
  Stack,
  Typography,
  useTheme,
  alpha,
} from "@mui/material";
import AccessTimeFilledIcon from "@mui/icons-material/AccessTimeFilled";
import CalendarTodayOutlinedIcon from "@mui/icons-material/CalendarTodayOutlined";
import InfoOutlinedIcon from "@mui/icons-material/InfoOutlined";

export interface LibraryScheduleItem {
  days: string;
  hours: string;
}

export interface LibraryScheduleData {
  schedule: LibraryScheduleItem[];
  note?: string;
}

interface LibraryHoursCardProps {
  data: LibraryScheduleData;
}

function normalizeDays(days: string): string {
  return days
    .replace(/Monday\s*-\s*Friday/i, "Thứ Hai - Thứ Sáu")
    .replace(/Saturday\s*-\s*Sunday/i, "Thứ Bảy - Chủ Nhật")
    .replace(/Monday/i, "Thứ Hai")
    .replace(/Tuesday/i, "Thứ Ba")
    .replace(/Wednesday/i, "Thứ Tư")
    .replace(/Thursday/i, "Thứ Năm")
    .replace(/Friday/i, "Thứ Sáu")
    .replace(/Saturday/i, "Thứ Bảy")
    .replace(/Sunday/i, "Chủ Nhật");
}

export default function LibraryHoursCard({ data }: LibraryHoursCardProps) {
  const theme = useTheme();
  const isDark = theme.palette.mode === "dark";

  const scheduleList = Array.isArray(data?.schedule) ? data.schedule : [];
  const note = data?.note;

  return (
    <Card
      elevation={0}
      sx={{
        maxWidth: 380,
        width: "100%",
        my: 1,
        borderRadius: 2.5,
        border: "1px solid",
        borderColor: isDark ? alpha("#0A2540", 0.4) : alpha("#0A2540", 0.15),
        background: isDark
          ? "linear-gradient(145deg, rgba(10, 37, 64, 0.4) 0%, rgba(15, 23, 42, 0.95) 100%)"
          : "linear-gradient(145deg, rgba(248, 250, 252, 0.95) 0%, rgba(255, 255, 255, 0.98) 100%)",
        boxShadow: isDark
          ? "0 4px 20px rgba(0, 0, 0, 0.4)"
          : "0 4px 16px rgba(10, 37, 64, 0.06)",
        overflow: "hidden",
      }}
    >
      {/* Header bar */}
      <Box
        sx={{
          px: 2,
          py: 1.25,
          background: isDark
            ? "linear-gradient(90deg, rgba(10, 37, 64, 0.5) 0%, rgba(15, 60, 92, 0.3) 100%)"
            : "linear-gradient(90deg, rgba(10, 37, 64, 0.06) 0%, rgba(139, 0, 0, 0.03) 100%)",
          borderBottom: "1px solid",
          borderColor: "divider",
          display: "flex",
          alignItems: "center",
          justifyContent: "space-between",
        }}
      >
        <Box sx={{ display: "flex", alignItems: "center", gap: 1 }}>
          <AccessTimeFilledIcon
            sx={{
              color: isDark ? "#D4AF37" : "primary.main",
              fontSize: 20,
            }}
          />
          <Typography variant="subtitle2" sx={{ fontWeight: 700, letterSpacing: 0.2 }}>
            Lịch mở cửa thư viện IUH
          </Typography>
        </Box>
        <Chip
          label="Chính thức"
          size="small"
          sx={{
            height: 20,
            fontSize: "0.7rem",
            fontWeight: 600,
            bgcolor: isDark ? alpha("#10B981", 0.2) : alpha("#10B981", 0.12),
            color: isDark ? "#34D399" : "#059669",
            border: "1px solid",
            borderColor: isDark ? alpha("#10B981", 0.3) : alpha("#10B981", 0.25),
          }}
        />
      </Box>

      <CardContent sx={{ p: 2, "&:last-child": { pb: 2 } }}>
        <Stack spacing={1.25}>
          {scheduleList.map((item, idx) => {
            const displayDays = normalizeDays(item.days);
            const isWeekend =
              displayDays.includes("Thứ Bảy") || displayDays.includes("Chủ Nhật");

            return (
              <Box
                key={idx}
                sx={{
                  display: "flex",
                  alignItems: "center",
                  justifyContent: "space-between",
                  p: 1.25,
                  borderRadius: 1.5,
                  bgcolor: isDark
                    ? alpha("#FFFFFF", 0.04)
                    : alpha("#F1F5F9", 0.75),
                  border: "1px solid",
                  borderColor: isDark
                    ? alpha("#FFFFFF", 0.06)
                    : alpha("#E2E8F0", 0.8),
                  transition: "all 0.2s ease",
                  "&:hover": {
                    bgcolor: isDark
                      ? alpha("#FFFFFF", 0.07)
                      : alpha("#E2E8F0", 0.9),
                  },
                }}
              >
                <Box sx={{ display: "flex", alignItems: "center", gap: 1 }}>
                  <CalendarTodayOutlinedIcon
                    sx={{
                      fontSize: 16,
                      color: isWeekend
                        ? isDark
                          ? "#F59E0B"
                          : "#D97706"
                        : isDark
                        ? "#94A3B8"
                        : "#64748B",
                    }}
                  />
                  <Typography variant="body2" sx={{ fontWeight: 600 }}>
                    {displayDays}
                  </Typography>
                </Box>

                <Chip
                  label={item.hours}
                  size="small"
                  sx={{
                    fontWeight: 700,
                    fontFamily: "monospace",
                    fontSize: "0.8rem",
                    bgcolor: isWeekend
                      ? isDark
                        ? alpha("#F59E0B", 0.2)
                        : alpha("#F59E0B", 0.12)
                      : isDark
                      ? alpha("#0A2540", 0.4)
                      : alpha("#0A2540", 0.08),
                    color: isWeekend
                      ? isDark
                        ? "#FBBF24"
                        : "#B45309"
                      : isDark
                      ? "#93C5FD"
                      : "#0A2540",
                    border: "1px solid",
                    borderColor: isWeekend
                      ? isDark
                        ? alpha("#F59E0B", 0.3)
                        : alpha("#F59E0B", 0.25)
                      : isDark
                      ? alpha("#0A2540", 0.5)
                      : alpha("#0A2540", 0.2),
                  }}
                />
              </Box>
            );
          })}
        </Stack>

        {note && (
          <>
            <Divider sx={{ my: 1.5 }} />
            <Box
              sx={{
                display: "flex",
                alignItems: "flex-start",
                gap: 1,
                p: 1,
                borderRadius: 1.5,
                bgcolor: isDark
                  ? alpha("#D97706", 0.1)
                  : alpha("#FEF3C7", 0.7),
                border: "1px solid",
                borderColor: isDark
                  ? alpha("#D97706", 0.2)
                  : alpha("#FDE68A", 0.8),
              }}
            >
              <InfoOutlinedIcon
                sx={{
                  fontSize: 16,
                  color: isDark ? "#FBBF24" : "#B45309",
                  mt: "2px",
                  flexShrink: 0,
                }}
              />
              <Typography
                variant="caption"
                sx={{
                  color: isDark ? "#FDE68A" : "#92400E",
                  lineHeight: 1.4,
                  fontWeight: 500,
                }}
              >
                {note}
              </Typography>
            </Box>
          </>
        )}
      </CardContent>
    </Card>
  );
}
</file>

