<file path="src/app/(dashboard)/layout.tsx">
"use client";

import { useEffect, useMemo, useState } from "react";
import { useRouter } from "next/navigation";
import {
  AppBar,
  Avatar,
  Badge,
  Box,
  Chip,
  CircularProgress,
  IconButton,
  Stack,
  Toolbar,
  Tooltip,
  Typography,
  useTheme,
  alpha,
} from "@mui/material";
import BellIcon from "@mui/icons-material/NotificationsOutlined";
import Brightness6Icon from "@mui/icons-material/Brightness6Outlined";
import DarkModeIcon from "@mui/icons-material/DarkModeOutlined";
import LightModeIcon from "@mui/icons-material/LightModeOutlined";
import UserIcon from "@mui/icons-material/PersonOutlined";
import { useAuth } from "@/lib/auth-context";
import { useColorMode } from "@/lib/mui-theme";
import api from "@/lib/api-client";
import Sidebar from "@/app/(dashboard)/_components/Sidebar";
import NotificationDropdown from "@/app/(dashboard)/_components/ui/NotificationDropdown";
import AvatarUser from "@/app/(dashboard)/_components/ui/AvatarUser";
import BreadcrumbsNav from "@/app/(dashboard)/_components/ui/BreadcrumbsNav";

function Topbar({ user }: { user: any }) {
  const theme = useTheme();
  const { mode, effectiveMode, preference, reducedMotion, toggleMode } = useColorMode();
  const [bellAnchorEl, setBellAnchorEl] = useState<HTMLElement | null>(null);
  const [unreadCount, setUnreadCount] = useState(0);
  const bellOpen = Boolean(bellAnchorEl);

  const modeIcon = useMemo(() => {
    if (preference === "auto") return <Brightness6Icon fontSize="small" />;
    return preference === "dark" ? <DarkModeIcon fontSize="small" /> : <LightModeIcon fontSize="small" />;
  }, [preference]);

  const modeTooltip = useMemo(() => {
    if (reducedMotion === "reduce") return "Chế độ hiển thị (Đã bật giảm chuyển động)";
    if (preference === "auto") return `Chế độ tự động (${effectiveMode === "dark" ? "Tối" : "Sáng"}) - Nhấn để thay đổi`;
    if (preference === "dark") return "Chế độ tối - Nhấn để chuyển";
    return "Chế độ sáng - Nhấn để chuyển";
  }, [preference, effectiveMode, reducedMotion]);

  useEffect(() => {
    let mounted = true;

    const fetchCount = async () => {
      try {
        const { count } = await api.getUnreadCount();
        if (mounted) setUnreadCount(count);
      } catch {
        // silently fail
      }
    };

    fetchCount();

    // Poll every 30 seconds as fallback
    const interval = setInterval(fetchCount, 30000);

    return () => {
      mounted = false;
      clearInterval(interval);
    };
  }, []);

  const handleBellClick = (event: React.MouseEvent<HTMLElement>) => {
    if (bellAnchorEl) {
      setBellAnchorEl(null);
    } else {
      setBellAnchorEl(event.currentTarget);
    }
  };

  const handleBellClose = () => {
    setBellAnchorEl(null);
    // Refresh count after closing
    api.getUnreadCount().then(({ count }) => setUnreadCount(count)).catch(() => {});
  };

  return (
    <>
      <AppBar
        position="sticky"
        color="default"
        elevation={0}
        sx={{
          borderBottom: 1,
          borderColor: "divider",
          borderTop: `3px solid ${theme.palette.primary.main}`, // IUH Red Brand Accent Stripe
          bgcolor: "background.paper",
          color: "text.primary",
        }}
      >
        <Toolbar sx={{ justifyContent: "space-between", gap: 1.5, minHeight: 64, pl: { xs: 6.5, md: 3 }, pr: { xs: 2, md: 3 } }}>
          {/* IUH Academic Branding Title */}
          <Stack direction="row" spacing={1.5} sx={{ display: { xs: "none", md: "flex" }, alignItems: "center" }}>
            <Box
              sx={{
                width: 8,
                height: 8,
                borderRadius: "50%",
                bgcolor: theme.palette.primary.main,
              }}
            />
            <Typography
              variant="subtitle2"
              sx={{
                fontFamily: "'Space Grotesk', sans-serif",
                fontWeight: 700,
                letterSpacing: "0.02em",
                color: "text.primary",
                fontSize: "0.88rem",
              }}
            >
              TRƯỜNG ĐẠI HỌC CÔNG NGHIỆP TP.HCM • TRẠM THỦ THƯ
            </Typography>
            <Chip
              label="HỌC THUẬT & KỸ THUẬT"
              size="small"
              sx={{
                height: 20,
                fontSize: "0.65rem",
                fontWeight: 700,
                borderRadius: "2px",
                bgcolor: alpha(theme.palette.secondary.main, 0.12),
                color: theme.palette.mode === "dark" ? theme.palette.secondary.light : theme.palette.secondary.dark,
                border: `1px solid ${alpha(theme.palette.secondary.main, 0.35)}`,
              }}
            />
          </Stack>

          <Stack direction="row" spacing={1.5} sx={{ alignItems: "center" }}>
            <Box sx={{ position: "relative" }}>
            <Tooltip title="Thông báo">
              <IconButton color="inherit" onClick={handleBellClick}>
                <Badge badgeContent={unreadCount > 0 ? (unreadCount > 99 ? "99+" : unreadCount) : 0} color="error" invisible={unreadCount === 0}>
                  <BellIcon fontSize="small" />
                </Badge>
              </IconButton>
            </Tooltip>
            <NotificationDropdown anchorEl={bellAnchorEl} open={bellOpen} onClose={handleBellClose} />
          </Box>
          <Tooltip title={modeTooltip} arrow>
            <IconButton color="inherit" onClick={toggleMode}>
              {modeIcon}
            </IconButton>
          </Tooltip>
          <Stack direction="row" spacing={1.25} sx={{ alignItems: "center", pl: 1.5, borderLeft: `1px solid ${theme.palette.divider}` }}>
            <AvatarUser user={user} size={34} />
            <Box sx={{ display: { xs: "none", sm: "block" }, minWidth: 0, maxWidth: 160 }}>
              <Typography variant="body2" sx={{ fontWeight: 700, overflow: "hidden", textOverflow: "ellipsis", whiteSpace: "nowrap" }}>
                {user?.full_name || "Admin"}
              </Typography>
              <Typography variant="caption" color="text.secondary" sx={{ textTransform: "capitalize", display: "block", overflow: "hidden", textOverflow: "ellipsis", whiteSpace: "nowrap" }}>
                {user?.role || "staff"}
              </Typography>
            </Box>
          </Stack>
        </Stack>
      </Toolbar>
    </AppBar>
    </>
  );
}

import { PermissionProvider, usePermission } from "@/lib/permission-context";
import { usePathname } from "next/navigation";
import { Button } from "@mui/material";
import LockOutlinedIcon from "@mui/icons-material/LockOutlined";

function DashboardGuard({ children }: { children: React.ReactNode }) {
  const { canAccessPage, loading, permissions } = usePermission();
  const pathname = usePathname();
  const router = useRouter();

  const isAllowed = canAccessPage(pathname);

  if (loading && !permissions) {
    return (
      <Box sx={{ flex: 1, display: "grid", placeItems: "center", minHeight: 300 }}>
        <CircularProgress size={32} />
      </Box>
    );
  }

  if (!isAllowed) {
    return (
      <Box
        sx={{
          flex: 1,
          display: "flex",
          flexDirection: "column",
          alignItems: "center",
          justifyContent: "center",
          p: 4,
          textAlign: "center",
          bgcolor: "background.paper",
          borderRadius: 3,
          border: 1,
          borderColor: "divider",
          my: "auto",
        }}
      >
        <Avatar
          sx={{
            width: 56,
            height: 56,
            bgcolor: "error.light",
            color: "error.main",
            mb: 2,
          }}
        >
          <LockOutlinedIcon fontSize="large" />
        </Avatar>
        <Typography variant="h5" color="error.main" gutterBottom sx={{ fontWeight: 700 }}>
          Truy cập bị từ chối (403 Forbidden)
        </Typography>
        <Typography variant="body1" color="text.secondary" sx={{ mb: 3, maxWidth: 500 }}>
          Tài khoản của bạn chưa được cấp quyền truy cập trang này (<code>{pathname}</code>). Vui lòng liên hệ Quản trị viên để được cấp quyền.
        </Typography>
        <Button
          variant="contained"
          onClick={() => router.push("/dashboard")}
          sx={{ textTransform: "none", borderRadius: 2 }}
        >
          Quay lại Bảng điều khiển
        </Button>
      </Box>
    );
  }

  return <>{children}</>;
}

export default function DashboardLayout({ children }: { children: React.ReactNode }) {
  const { isAuthenticated, isLoading, user } = useAuth();
  const router = useRouter();

  useEffect(() => {
    if (!isLoading && !isAuthenticated) {
      router.push("/login");
    }
  }, [isAuthenticated, isLoading, router]);

  if (isLoading) {
    return (
      <Box sx={{ minHeight: "100vh", bgcolor: "background.default", display: "grid", placeItems: "center" }}>
        <Stack spacing={2} sx={{ alignItems: "center" }}>
          <CircularProgress color="primary" />
          <Typography variant="body2" color="text.secondary">Đang tải...</Typography>
        </Stack>
      </Box>
    );
  }

  if (!isAuthenticated) return null;

  return (
    <PermissionProvider>
      <Box sx={{ display: "flex", minHeight: "100vh", bgcolor: "background.default" }}>
        <Sidebar />
        <Box sx={{ flex: 1, minWidth: 0, display: "flex", flexDirection: "column" }}>
          <Topbar user={user} />
          <Box component="main" sx={{ flex: 1, display: "flex", flexDirection: "column", p: { xs: 2, md: 3 } }}>
            <BreadcrumbsNav />
            <DashboardGuard>{children}</DashboardGuard>
          </Box>
        </Box>
      </Box>
    </PermissionProvider>
  );
}
</file>

<file path="src/app/(dashboard)/dashboard/admin/page.tsx">
"use client";

import { useEffect, useState, useMemo } from "react";
import { useRouter } from "next/navigation";
import {
  Alert,
  Avatar,
  Box,
  Button,
  Chip,
  CircularProgress,
  Drawer,
  Card,
  CardActionArea,
  Divider,
  Grid,
  IconButton,
  Stack,
  TextField,
  Typography,
  ToggleButton,
  ToggleButtonGroup,
  alpha,
} from "@mui/material";
import DataTable, { type DataTableColumn } from "@/app/(dashboard)/_components/ui/DataTable";
import { useToast } from "@/lib/toast-context";
import AddOutlinedIcon from "@mui/icons-material/AddOutlined";
import AdminPanelSettingsOutlinedIcon from "@mui/icons-material/AdminPanelSettingsOutlined";
import FaceRetouchingNaturalOutlinedIcon from "@mui/icons-material/FaceRetouchingNaturalOutlined";
import GroupsOutlinedIcon from "@mui/icons-material/GroupsOutlined";
import PersonOutlineOutlinedIcon from "@mui/icons-material/PersonOutlineOutlined";
import AccountBoxOutlinedIcon from "@mui/icons-material/AccountBoxOutlined";
import CloseIcon from "@mui/icons-material/Close";
import BadgeOutlinedIcon from "@mui/icons-material/BadgeOutlined";
import SupervisorAccountOutlinedIcon from "@mui/icons-material/SupervisorAccountOutlined";
import RefreshOutlinedIcon from "@mui/icons-material/RefreshOutlined";
import CheckCircleOutlinedIcon from "@mui/icons-material/CheckCircleOutlined";
import RadioButtonUncheckedIcon from "@mui/icons-material/RadioButtonUnchecked";
import EmptyState from "@/app/(dashboard)/_components/ui/EmptyState";
import SearchField from "@/app/(dashboard)/_components/ui/SearchField";
import PageHeader from "@/app/(dashboard)/_components/ui/PageHeader";
import AvatarUser from "@/app/(dashboard)/_components/ui/AvatarUser";
import MuiStatCard from "@/app/(dashboard)/_components/ui/MuiStatCard";
import DashboardCard from "@/app/(dashboard)/_components/ui/DashboardCard";
import { staggerSx } from "@/lib/useStaggeredAnimation";
import api from "@/lib/api-client";
import { useAuth } from "@/lib/auth-context";
import { usePermission } from "@/lib/permission-context";
import { fadeInUp, shimmer } from "@/lib/animations";
import { initials, roleLabel, statusLabel, statusColor } from "@/lib/utils";
import type { UserPublic } from "@/lib/types";

function roleChipColor(role: string): "warning" | "primary" | "default" | "success" {
  if (role === "admin") return "warning";
  if (role === "staff") return "primary";
  return "default";
}

const STAT_GRADIENT: Record<string, string> = {
  total:  "linear-gradient(135deg, #8B0000 0%, #700000 100%)",
  admin:  "linear-gradient(135deg, #D4AF37 0%, #B89628 100%)",
  staff:  "linear-gradient(135deg, #0A2540 0%, #0F3C5C 100%)",
  patron: "linear-gradient(135deg, #1E6091 0%, #154E78 100%)",
  face:   "linear-gradient(135deg, #059669 0%, #047857 100%)",
};

export default function AdminPage() {
  const { user, isLoading, isAuthenticated } = useAuth();
  const { canAccessPage, loading: permLoading } = usePermission();
  const router = useRouter();
  const [users, setUsers] = useState<UserPublic[]>([]);
  const [total, setTotal] = useState(0);
  const [loading, setLoading] = useState(true);
  const [showCreate, setShowCreate] = useState(false);
  const [createForm, setCreateForm] = useState({ email: "", password: "", role: "staff" });
  const { toast } = useToast();
  const [createError, setCreateError] = useState("");
  const [search, setSearch] = useState("");
  const [roleFilter, setRoleFilter] = useState<"all" | "admin" | "staff" | "patron">("all");
  const [page, setPage] = useState(0);
  const [rowsPerPage, setRowsPerPage] = useState(10);

  useEffect(() => {
    if (!isLoading && !permLoading) {
      if (!isAuthenticated) {
        router.push("/login");
      } else if (user?.role !== "admin" && !canAccessPage("/dashboard/admin")) {
        router.push("/dashboard");
      }
    }
  }, [isLoading, permLoading, isAuthenticated, user, canAccessPage, router]);

  const load = async () => {
    try {
      setLoading(true);
      const data = await api.listUsers({ skip: 0, limit: 1000 });
      setUsers(data.users);
      setTotal(data.total);
    } finally {
      setLoading(false);
    }
  };

  useEffect(() => { load(); }, []);

  useEffect(() => {
    setPage(0);
  }, [search, roleFilter]);

  const filtered = useMemo(() => {
    let list = users;
    if (roleFilter !== "all") list = list.filter((u) => u.role === roleFilter);
    if (search.trim()) {
      const q = search.toLowerCase();
      list = list.filter(
        (u) =>
          u.email.toLowerCase().includes(q) ||
          (u.full_name || "").toLowerCase().includes(q)
      );
    }
    return list;
  }, [users, roleFilter, search]);

  const columns: DataTableColumn<UserPublic>[] = [
    {
      key: "email",
      label: "Người dùng",
      sortable: true,
      render: (_, item) => (
        <Stack direction="row" spacing={1.5} sx={{ alignItems: "center" }}>
          <AvatarUser user={item} size={36} />
          <Box sx={{ minWidth: 0 }}>
            <Typography sx={{ fontWeight: 700, fontSize: "0.88rem" }} noWrap>
              {item.email}
            </Typography>
            {item.full_name ? (
              <Typography variant="caption" color="text.secondary" noWrap>
                {item.full_name}
              </Typography>
            ) : null}
          </Box>
        </Stack>
      ),
    },
    {
      key: "role",
      label: "Vai trò",
      sortable: true,
      render: (_, item) => (
        <Chip
          size="small"
          color={roleChipColor(item.role)}
          label={roleLabel(item.role)}
          sx={{ fontWeight: 700, fontSize: "0.75rem", borderRadius: 1.5 }}
        />
      ),
    },
    {
      key: "has_face",
      label: "Sinh trắc học",
      sortable: true,
      render: (_, item) => (
        <Stack direction="row" spacing={0.75} sx={{ alignItems: "center" }}>
          {item.has_face ? (
            <CheckCircleOutlinedIcon sx={{ fontSize: 18, color: "success.main" }} />
          ) : (
            <RadioButtonUncheckedIcon sx={{ fontSize: 18, color: "text.disabled" }} />
          )}
          <Typography variant="body2" color={item.has_face ? "success.main" : "text.disabled"} sx={{ fontWeight: 600 }}>
            {item.has_face ? "Đã đăng ký" : "Chưa đăng ký"}
          </Typography>
        </Stack>
      ),
    },
    {
      key: "status",
      label: "Trạng thái",
      sortable: true,
      render: (_, item) => (
        <Chip
          size="small"
          color={item.status === "active" ? "success" : item.status === "deleted" ? "error" : "default"}
          label={item.status === "active" ? "Hoạt động" : item.status === "deleted" ? "Đã xóa" : item.status ?? "—"}
          variant="outlined"
          sx={{ fontWeight: 600, fontSize: "0.72rem", borderRadius: 1.5 }}
        />
      ),
    },
  ];

  const handleCreate = async () => {
    if (!createForm.email || !createForm.password) {
      setCreateError("Vui lòng nhập email và mật khẩu.");
      return;
    }
    try {
      setCreateError("");
      await api.register({ ...createForm, skip_verification: true } as any);
      setShowCreate(false);
      setCreateForm({ email: "", password: "", role: "staff" });
      toast.success("Tạo người dùng thành công. Tài khoản đã active.");
      load();
    } catch (err: any) {
      const errorMsg = err?.response?.data?.detail || "Tạo người dùng thất bại.";
      setCreateError(errorMsg);
      toast.error(errorMsg);
    }
  };

  if (isLoading) {
    return (
      <Stack sx={{ minHeight: 400, alignItems: "center", justifyContent: "center" }}>
        <CircularProgress sx={{ animation: `${shimmer} 1.5s ease-in-out infinite` }} />
      </Stack>
    );
  }
  if (!isAuthenticated) return null;

  const adminCount  = users.filter((u) => u.role === "admin").length;
  const staffCount  = users.filter((u) => u.role === "staff").length;
  const patronCount = users.filter((u) => u.role === "patron").length;
  const faceCount   = users.filter((u) => u.has_face).length;
  const noFaceCount = Math.max(0, total - faceCount);
  const faceRate    = total > 0 ? Math.round((faceCount / total) * 100) : 0;

  const STATS: { key: string; label: string; value: number | string; icon: any; gradient: string; pct?: number; delta?: string; deltaColor?: "success" | "warning" | "error" | "default" }[] = [
    {
      key: "face",
      label: "Đã có khuôn mặt (AI)",
      value: faceCount,
      icon: FaceRetouchingNaturalOutlinedIcon,
      gradient: "linear-gradient(135deg, #059669 0%, #047857 100%)",
      pct: faceRate,
      delta: total > 0 ? `${faceRate}% đã kích hoạt Face-ID` : undefined,
      deltaColor: "success",
    },
    {
      key: "noface",
      label: "Chưa có khuôn mặt",
      value: noFaceCount,
      icon: AccountBoxOutlinedIcon,
