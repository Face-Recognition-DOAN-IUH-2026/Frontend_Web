"use client";

import { useState } from "react";
import {
  Alert,
  Box,
  Button,
  Checkbox,
  Chip,
  FormControlLabel,
  LinearProgress,
  Paper,
  Stack,
  Table,
  TableBody,
  TableCell,
  TableContainer,
  TableHead,
  TableRow,
  Typography,
} from "@mui/material";
import FaceOutlinedIcon from "@mui/icons-material/FaceOutlined";
import RestartAltOutlinedIcon from "@mui/icons-material/RestartAltOutlined";
import SearchOutlinedIcon from "@mui/icons-material/SearchOutlined";
import CameraCapture from "@/components/camera-capture";
import JobPoll from "@/components/job-poll";
import api, { getErrorMessage } from "@/lib/api-client";
import { shimmer } from "@/lib/animations";

export default function IdentifyPage() {
  const [imageFile, setImageFile] = useState<File | null>(null);
  const [dataUrl, setDataUrl] = useState<string>("");
  const [consent, setConsent] = useState(false);
  const [isLoading, setIsLoading] = useState(false);
  const [jobId, setJobId] = useState<string | null>(null);
  const [error, setError] = useState("");
  const [matches, setMatches] = useState<any[] | null>(null);

  const handleCapture = (file: File, url: string) => {
    setImageFile(file);
    setDataUrl(url);
    setMatches(null);
  };

  const handleSubmit = async (event: React.FormEvent) => {
    event.preventDefault();
    if (!imageFile) return;
    setError("");
    setIsLoading(true);
    setJobId(null);
    setMatches(null);
    try {
      const data = await api.identifyFace(imageFile, consent);
      setJobId(data.job_id);
    } catch (err: any) {
      setError(getErrorMessage(err) || "Nhận diện thất bại.");
      setIsLoading(false);
    }
  };

  const reset = () => {
    setMatches(null);
    setDataUrl("");
    setImageFile(null);
    setJobId(null);
    setError("");
    setIsLoading(false);
  };

  return (
    <Stack spacing={3} sx={{ maxWidth: 1040, mx: "auto" }}>
      <Paper variant="outlined" sx={{ p: 3 }}>
        <Stack direction="row" spacing={1.5} sx={{ alignItems: "center" }}>
          <SearchOutlinedIcon color="primary" />
          <Box>
            <Typography variant="h4" sx={{ fontWeight: 850 }}>Nhận diện khuôn mặt</Typography>
            <Typography color="text.secondary">Tìm người dùng gần nhất trong kho khuôn mặt đã đăng ký.</Typography>
          </Box>
        </Stack>
      </Paper>

      {error && <Alert severity="error">{error}</Alert>}

      {jobId ? (
        <JobPoll
          jobId={jobId}
          onComplete={(result) => { setIsLoading(false); setJobId(null); setMatches(result?.matches || []); }}
          onError={(message) => { setError(message); setIsLoading(false); setJobId(null); }}
        />
      ) : matches ? (
        <Stack spacing={2}>
          <Paper variant="outlined" sx={{ p: 2.5 }}>
            <Stack direction={{ xs: "column", md: "row" }} spacing={2} sx={{ justifyContent: "space-between", alignItems: { md: "center" } }}>
              <Stack direction="row" spacing={1.5} sx={{ alignItems: "center" }}>
                <FaceOutlinedIcon color="primary" />
                <Box>
                  <Typography variant="h5" sx={{ fontWeight: 850 }}>Tìm thấy {matches.length} kết quả</Typography>
                  <Typography color="text.secondary">Kết quả được sắp xếp theo độ tin cậy giảm dần.</Typography>
                </Box>
              </Stack>
              <Button startIcon={<RestartAltOutlinedIcon />} variant="outlined" onClick={reset}>Thử lại</Button>
            </Stack>
          </Paper>

          {dataUrl && (
            <Box component="img" src={dataUrl} alt="Ảnh đã chụp" sx={{ width: 160, height: 160, objectFit: "cover", borderRadius: 2, border: 1, borderColor: "divider", mx: "auto" }} />
          )}

          {matches.length === 0 ? (
            <Alert severity="info">Không tìm thấy khuôn mặt phù hợp.</Alert>
          ) : (
            <Paper variant="outlined" sx={{ overflow: "hidden" }}>
              <TableContainer>
                <Table sx={{ minWidth: 820 }}>
                  <TableHead>
                    <TableRow>
                      <TableCell>Độ tin cậy</TableCell>
                      <TableCell>User ID</TableCell>
                      <TableCell>Tên</TableCell>
                      <TableCell>Email</TableCell>
                      <TableCell>Vai trò</TableCell>
                    </TableRow>
                  </TableHead>
                  <TableBody>
                    {matches.map((match, index) => {
                      const score = Number(match.score ?? 0);
                      const percent = Number((score * 100).toFixed(1));
                      return (
                        <TableRow key={`${match.user_id}-${index}`} hover>
                          <TableCell sx={{ minWidth: 180 }}>
                            <Stack direction="row" spacing={1} sx={{ alignItems: "center" }}>
                              <LinearProgress
                                variant="determinate"
                                value={Math.min(percent, 100)}
                                color={score > 0.6 ? "success" : score > 0.3 ? "warning" : "error"}
                                sx={{ width: 90, height: 7, borderRadius: 99 }}
                              />
                              <Typography variant="body2" sx={{ fontFamily: "monospace" }}>{percent}%</Typography>
                            </Stack>
                          </TableCell>
                          <TableCell sx={{ fontFamily: "monospace", color: "text.secondary" }}>{match.user_id}</TableCell>
                          <TableCell sx={{ fontWeight: 750 }}>{match.full_name || "-"}</TableCell>
                          <TableCell sx={{ color: "text.secondary" }}>{match.email || "-"}</TableCell>
                          <TableCell><Chip size="small" label={match.role || "-"} /></TableCell>
                        </TableRow>
                      );
                    })}
                  </TableBody>
                </Table>
              </TableContainer>
            </Paper>
          )}
        </Stack>
      ) : (
        <Paper variant="outlined" sx={{ p: 2.5 }}>
          <Box component="form" onSubmit={handleSubmit}>
            <Stack spacing={2.5}>
              <CameraCapture onCapture={handleCapture} />
              <FormControlLabel
                control={<Checkbox checked={consent} onChange={(event) => setConsent(event.target.checked)} />}
                label="Tôi đồng ý cho hệ thống xử lý dữ liệu khuôn mặt để nhận diện."
              />
              <Button type="submit" variant="contained" disabled={!imageFile || !consent || isLoading} fullWidth>
                {isLoading ? "Đang gửi..." : "Nhận diện khuôn mặt"}
              </Button>
            </Stack>
          </Box>
        </Paper>
      )}
    </Stack>
  );
}
</file>

<file path="src/app/(dashboard)/liveness/page.tsx">
"use client";

import { useState } from "react";
import {
  Alert,
  Box,
  Button,
  Checkbox,
  FormControlLabel,
  LinearProgress,
  Paper,
  Stack,
  Typography,
} from "@mui/material";
import FaceRetouchingNaturalOutlinedIcon from "@mui/icons-material/FaceRetouchingNaturalOutlined";
import RestartAltOutlinedIcon from "@mui/icons-material/RestartAltOutlined";
import VisibilityOffOutlinedIcon from "@mui/icons-material/VisibilityOffOutlined";
import VisibilityOutlinedIcon from "@mui/icons-material/VisibilityOutlined";
import CameraCapture from "@/components/camera-capture";
import JobPoll from "@/components/job-poll";
import api, { getErrorMessage } from "@/lib/api-client";
import { shimmer } from "@/lib/animations";
import type { LivenessBreakdown } from "@/lib/types";

const breakdownLabels: Record<keyof LivenessBreakdown, string> = {
  lbp: "Kết cấu ảnh",
  color: "Màu sắc",
  noise: "Nhiễu ảnh",
  fft: "Tần số ảnh",
  multi_scale: "Đa tỷ lệ",
  bbox: "Tỷ lệ khuôn mặt",
  insightface: "Mô hình học sâu",
};

function BreakdownBar({ label, score }: { label: string; score: number }) {
  const percent = Math.round(score * 100);
  return (
    <Stack direction={{ xs: "column", sm: "row" }} spacing={1.25} sx={{ alignItems: { sm: "center" } }}>
      <Typography variant="body2" color="text.secondary" sx={{ width: { sm: 150 }, flexShrink: 0 }}>{label}</Typography>
      <LinearProgress
        variant="determinate"
        value={percent}
        color={score >= 0.7 ? "success" : score >= 0.4 ? "warning" : "error"}
        sx={{ flex: 1, height: 8, borderRadius: 99, minWidth: 120 }}
      />
      <Typography variant="caption" color="text.secondary" sx={{ width: 44, fontFamily: "monospace", textAlign: "right" }}>
        {percent}%
      </Typography>
    </Stack>
  );
}

function LivenessResultCard({ result }: { result: any }) {
  const isLive = Boolean(result.is_live);
  const score = Number(result.liveness_score ?? 0);
  const breakdown: LivenessBreakdown | undefined = result.breakdown;

  return (
    <Paper variant="outlined" sx={{ p: 3 }}>
      <Stack spacing={2.5}>
        <Stack direction="row" spacing={1.5} sx={{ alignItems: "center" }}>
          {isLive ? <VisibilityOutlinedIcon color="success" sx={{ fontSize: 48 }} /> : <VisibilityOffOutlinedIcon color="error" sx={{ fontSize: 48 }} />}
          <Box>
            <Typography variant="h5" sx={{ fontWeight: 900 }}>
              {isLive ? "Khuôn mặt thật" : "Phát hiện giả mạo"}
            </Typography>
            <Typography color="text.secondary">Điểm liveness: {(score * 100).toFixed(1)}%</Typography>
          </Box>
        </Stack>

        <LinearProgress
          variant="determinate"
          value={Math.min(score * 100, 100)}
          color={isLive ? "success" : "error"}
          sx={{ height: 9, borderRadius: 99 }}
        />

        {breakdown && (
          <Stack spacing={1.5}>
            <Typography variant="overline" color="text.secondary">Chi tiết kỹ thuật</Typography>
            {Object.entries(breakdownLabels).map(([key, label]) => {
              const value = breakdown[key as keyof LivenessBreakdown];
              if (value === undefined) return null;
              return <BreakdownBar key={key} label={label} score={value} />;
            })}
          </Stack>
        )}
      </Stack>
    </Paper>
  );
}

export default function LivenessPage() {
  const [imageFile, setImageFile] = useState<File | null>(null);
  const [consent, setConsent] = useState(false);
  const [isLoading, setIsLoading] = useState(false);
  const [jobId, setJobId] = useState<string | null>(null);
  const [result, setResult] = useState<any>(null);
  const [error, setError] = useState("");

  const handleCapture = (file: File) => {
    setImageFile(file);
    setResult(null);
    setError("");
  };

  const handleSubmit = async (event: React.FormEvent) => {
    event.preventDefault();
    if (!imageFile) return;
    setError("");
    setIsLoading(true);
    setJobId(null);
    setResult(null);
    try {
      const data = await api.livenessCheck(imageFile, consent);
      setJobId(data.job_id);
    } catch (err: any) {
      setError(getErrorMessage(err) || "Kiểm tra liveness thất bại.");
      setIsLoading(false);
    }
  };

  const reset = () => {
    setImageFile(null);
    setJobId(null);
    setResult(null);
    setError("");
    setIsLoading(false);
  };

  return (
    <Stack spacing={3} sx={{ maxWidth: 920, mx: "auto" }}>
      <Paper variant="outlined" sx={{ p: 3 }}>
        <Stack direction="row" spacing={1.5} sx={{ alignItems: "center" }}>
          <FaceRetouchingNaturalOutlinedIcon color="primary" />
          <Box>
            <Typography variant="h4" sx={{ fontWeight: 850 }}>Kiểm tra liveness</Typography>
            <Typography color="text.secondary">Đánh giá ảnh khuôn mặt thật hay ảnh giả mạo trước khi xử lý nhận diện.</Typography>
          </Box>
        </Stack>
      </Paper>

      {error && <Alert severity="error">{error}</Alert>}

      {result ? (
        <Stack spacing={2}>
          <LivenessResultCard result={result} />
          <Button startIcon={<RestartAltOutlinedIcon />} variant="outlined" onClick={reset} sx={{ alignSelf: "center" }}>
            Thử lại
          </Button>
        </Stack>
      ) : jobId ? (
        <JobPoll
          jobId={jobId}
          onComplete={(value) => { setResult(value); setIsLoading(false); setJobId(null); }}
          onError={(message) => { setError(message); setIsLoading(false); setJobId(null); }}
        />
      ) : (
        <Paper variant="outlined" sx={{ p: 2.5 }}>
          <Box component="form" onSubmit={handleSubmit}>
            <Stack spacing={2.5}>
              <CameraCapture onCapture={handleCapture} />
              <FormControlLabel
                control={<Checkbox checked={consent} onChange={(event) => setConsent(event.target.checked)} />}
                label="Tôi đồng ý cho hệ thống xử lý dữ liệu khuôn mặt để kiểm tra liveness."
              />
              <Button type="submit" variant="contained" disabled={!imageFile || !consent || isLoading} fullWidth>
                {isLoading ? "Đang gửi..." : "Kiểm tra liveness"}
              </Button>
            </Stack>
          </Box>
        </Paper>
      )}
    </Stack>
  );
}
