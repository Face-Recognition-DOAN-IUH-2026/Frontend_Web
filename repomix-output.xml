<file path="src/components/gate/CameraFeed.tsx">
"use client";

import { useEffect, useRef, useState } from "react";
import {
  Box,
  Chip,
  CircularProgress,
  Paper,
  Stack,
  Typography,
} from "@mui/material";
import VideocamOutlinedIcon from "@mui/icons-material/VideocamOutlined";

interface CameraFeedProps {
  src: string;
  label: string;
  overlay?: {
    bbox?: [number, number, number, number];
    landmarks?: [number, number][];
    status?: string;
  } | null;
  onStatusChange?: (ok: boolean) => void;
}

const OVERLAY_COLORS: Record<string, string> = {
  granted: "#22c55e",
  wrong_direction: "#eab308",
  expired: "#f97316",
  spoof: "#ef4444",
};

export default function CameraFeed({ src, label, overlay, onStatusChange }: CameraFeedProps) {
  const imgRef = useRef<HTMLImageElement>(null);
  const canvasRef = useRef<HTMLCanvasElement>(null);
  const [ts] = useState(() => Date.now());
  const [ok, setOk] = useState<boolean | null>(null);

  useEffect(() => {
    onStatusChange?.(ok === true);
  }, [ok, onStatusChange]);

  useEffect(() => {
    if (!overlay?.bbox && !overlay?.landmarks) return;
    const img = imgRef.current;
    const canvas = canvasRef.current;
    if (!img || !canvas) return;

    const rect = img.getBoundingClientRect();
    const scaleX = rect.width / (img.naturalWidth || 1);
    const scaleY = rect.height / (img.naturalHeight || 1);

    canvas.width = rect.width;
    canvas.height = rect.height;
    const ctx = canvas.getContext("2d");
    if (!ctx) return;
    ctx.clearRect(0, 0, canvas.width, canvas.height);

    if (overlay.bbox) {
      const [x1, y1, x2, y2] = overlay.bbox;
      ctx.strokeStyle = OVERLAY_COLORS[overlay.status || "granted"] || "#22c55e";
      ctx.lineWidth = 3;
      ctx.strokeRect(x1 * scaleX, y1 * scaleY, (x2 - x1) * scaleX, (y2 - y1) * scaleY);
    }

    if (overlay.landmarks) {
      overlay.landmarks.forEach(([x, y]) => {
        ctx.beginPath();
        ctx.arc(x * scaleX, y * scaleY, 4, 0, 2 * Math.PI);
        ctx.fillStyle = "#ef4444";
        ctx.fill();
      });
    }
  }, [overlay]);

  return (
    <Paper variant="outlined" sx={{ overflow: "hidden", height: "100%" }}>
      <Stack
        direction="row"
        spacing={1.25}
        sx={{ alignItems: "center", justifyContent: "space-between", px: 2, py: 1.25, borderBottom: 1, borderColor: "divider" }}
      >
        <Stack direction="row" spacing={1} sx={{ alignItems: "center" }}>
          <VideocamOutlinedIcon color="disabled" fontSize="small" />
          <Typography sx={{ fontWeight: 800 }}>{label}</Typography>
        </Stack>
        <Chip
          size="small"
          color={ok === null ? "warning" : ok ? "success" : "error"}
          label={ok === null ? "Đang nối" : ok ? "Online" : "Mất tín hiệu"}
        />
      </Stack>

      <Box sx={{ position: "relative", aspectRatio: "16 / 9", bgcolor: "common.black" }}>
        <Box
          component="img"
          ref={imgRef}
          src={`${src}?_t=${ts}`}
          onLoad={() => setOk(true)}
          onError={() => setOk(false)}
          alt={label}
          sx={{ width: "100%", height: "100%", objectFit: "contain", display: "block" }}
        />
        <Box component="canvas" ref={canvasRef} sx={{ position: "absolute", inset: 0, width: "100%", height: "100%", pointerEvents: "none" }} />
        {ok === null && (
          <Stack sx={{ position: "absolute", inset: 0, bgcolor: "rgba(0,0,0,.55)", color: "common.white", alignItems: "center", justifyContent: "center" }} spacing={1}>
            <CircularProgress color="inherit" size={28} />
            <Typography variant="body2">Đang kết nối...</Typography>
          </Stack>
        )}
      </Box>
    </Paper>
  );
}
</file>

<file path="src/components/gate/ResultCard.tsx">
'use client';

import PulseAnimation from './PulseAnimation';

interface ResultCardProps {
  status: 'success' | 'error' | 'unregistered' | 'processing';
  patronInfo?: {
    fullName: string;
    mssv: string;
    faculty: string;
  };
  message?: string;
}

export default function ResultCard({ status, patronInfo, message }: ResultCardProps) {
  type PulseColor = 'emerald' | 'red' | 'amber' | 'none';
  const config: Record<string, {
    borderColor: string;
    bgColor: string;
    pulseColor: PulseColor;
    icon: React.ReactNode;
  }> = {
    success: {
      borderColor: 'border-emerald-500',
      bgColor: 'bg-emerald-500/10',
      pulseColor: 'emerald',
      icon: (
        <svg className="w-16 h-16 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
      ),
    },
    error: {
      borderColor: 'border-red-500',
      bgColor: 'bg-red-500/10',
      pulseColor: 'red',
      icon: (
        <svg className="w-16 h-16 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
      ),
    },
    unregistered: {
      borderColor: 'border-amber-500',
      bgColor: 'bg-amber-500/10',
      pulseColor: 'amber',
      icon: (
        <svg className="w-16 h-16 text-amber-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636" />
        </svg>
      ),
    },
    processing: {
      borderColor: 'border-slate-500',
      bgColor: 'bg-slate-500/10',
      pulseColor: 'none',
      icon: (
        <div className="w-16 h-16 border-4 border-slate-500 border-t-transparent rounded-full animate-spin" />
      ),
    },
  };

  const { borderColor, bgColor, pulseColor, icon } = config[status];

  return (
    <div className={`relative border-2 ${borderColor} ${bgColor} rounded-2xl p-8 text-center`}>
      {pulseColor !== 'none' && (
        <div className="absolute inset-0 flex items-center justify-center pointer-events-none">
          <PulseAnimation color={pulseColor} />
        </div>
      )}

      <div className="relative z-10">
        <div className="flex justify-center mb-4">{icon}</div>

        {patronInfo && (
          <div className="space-y-2 mb-4">
            <h3 className="text-2xl font-bold text-white">{patronInfo.fullName}</h3>
            <p className="text-amber-400 font-mono text-lg">{patronInfo.mssv}</p>
            <p className="text-slate-400">{patronInfo.faculty}</p>
          </div>
        )}

        {message && (
          <p className={`text-lg ${status === 'success' ? 'text-emerald-400' : status === 'error' ? 'text-red-400' : 'text-amber-400'}`}>
            {message}
          </p>
        )}
      </div>
    </div>
  );
}
