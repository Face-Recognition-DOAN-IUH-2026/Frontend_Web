<file path="src/app/(dashboard)/active/page.tsx">
"use client";

import React, { useCallback, useEffect, useMemo, useRef, useState } from "react";
import {
  Alert,
  Avatar,
  Box,
  Button,
  Dialog,
  DialogActions,
  DialogContent,
  DialogTitle,
  Grid,
  IconButton,
  InputAdornment,
  Stack,
  TextField,
  Tooltip,
  Typography,
} from "@mui/material";
import { useToast } from "@/lib/toast-context";
import AccessTimeOutlinedIcon from "@mui/icons-material/AccessTimeOutlined";
import AssignmentOutlinedIcon from "@mui/icons-material/AssignmentOutlined";
import DoorFrontOutlinedIcon from "@mui/icons-material/DoorFrontOutlined";
import ExitToAppOutlinedIcon from "@mui/icons-material/ExitToAppOutlined";
import LocationOnOutlinedIcon from "@mui/icons-material/LocationOnOutlined";
import LogoutIcon from "@mui/icons-material/LogoutOutlined";
import MenuBookOutlinedIcon from "@mui/icons-material/MenuBookOutlined";
import SearchOutlinedIcon from "@mui/icons-material/SearchOutlined";
import TerminalOutlinedIcon from "@mui/icons-material/TerminalOutlined";
import UserCheckIcon from "@mui/icons-material/HowToRegOutlined";
import WarningAmberOutlinedIcon from "@mui/icons-material/WarningAmberOutlined";
import PeopleIcon from "@mui/icons-material/PeopleOutlined";
import api, { getErrorMessage } from "@/lib/api-client";
import { usePermission, getPermissionDeniedReason } from "@/lib/permission-context";
import { staggerSx } from "@/lib/useStaggeredAnimation";
import PageHeader from "@/app/(dashboard)/_components/ui/PageHeader";
import DashboardCard from "@/app/(dashboard)/_components/ui/DashboardCard";
import MuiStatCard from "@/app/(dashboard)/_components/ui/MuiStatCard";
import LoadingOverlay from "@/app/(dashboard)/_components/ui/LoadingOverlay";
import EmptyState from "@/app/(dashboard)/_components/ui/EmptyState";
import AvatarUser from "@/app/(dashboard)/_components/ui/AvatarUser";
import type { ActivePatron, CameraEvent } from "@/lib/types";

const ACTIVE_CAMERA_IDS = new Set(["entry_gate", "exit_gate", "kiosk"]);

const CAMERA_CONFIG: Record<string, { label: string; icon: React.ElementType }> = {
  entry_gate: { label: "Cổng vào", icon: DoorFrontOutlinedIcon },
  exit_gate: { label: "Cổng ra", icon: ExitToAppOutlinedIcon },
  kiosk: { label: "Kiosk", icon: TerminalOutlinedIcon },
};

function formatTime(value: string) {
  return new Date(value).toLocaleTimeString("vi-VN", {
    hour: "2-digit",
    minute: "2-digit",
  });
}

function getDuration(value: string) {
  const diffMs = Date.now() - new Date(value).getTime();
  const minutes = Math.max(0, Math.floor(diffMs / 60000));
  if (minutes < 1) return { text: "Vừa vào", level: 0 as const };
  if (minutes < 60) return { text: `${minutes} phút`, level: 1 as const };
  const hours = Math.floor(minutes / 60);
  const rest = minutes % 60;
  if (hours < 2) return { text: rest ? `${hours} giờ ${rest} phút` : `${hours} giờ`, level: 2 as const };
  return { text: rest ? `${hours} giờ ${rest} phút` : `${hours} giờ`, level: 3 as const };
}

const DURATION_ACCENT: Record<number, string> = {
  0: "#4A8C5C",
  1: "#4A8C5C",
  2: "#C49A3C",
  3: "#B85C4A",
};

function initials(name?: string) {
  const parts = (name || "").trim().split(/\s+/).filter(Boolean);
  if (parts.length === 0) return "?";
  if (parts.length === 1) return parts[0].charAt(0).toUpperCase();
  return `${parts[0].charAt(0)}${parts[parts.length - 1].charAt(0)}`.toUpperCase();
}

function normalizeQuery(value: string) {
  return value.trim().toLowerCase();
}

export default function ActivePage() {
  const { can } = usePermission();
  const canUpdate = can("borrows", "update");
  const { toast } = useToast();
  const [patrons, setPatrons] = useState<ActivePatron[]>([]);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState<string | null>(null);
  const [search, setSearch] = useState("");
  const [lastUpdate, setLastUpdate] = useState<Date>(new Date());
  const [exitPatron, setExitPatron] = useState<ActivePatron | null>(null);
  const [exiting, setExiting] = useState(false);
  const [sseConnected, setSseConnected] = useState(false);
  const hasLoadedRef = useRef(false);
  const fallbackRef = useRef<ReturnType<typeof setInterval> | null>(null);

  const load = useCallback(async () => {
    try {
      setError(null);
      const data = await api.getActivePatrons();
      const allowed = data.items
        .filter((p) => ACTIVE_CAMERA_IDS.has(p.camera_id))
        .sort((a, b) => new Date(b.entered_at).getTime() - new Date(a.entered_at).getTime());
      setPatrons(allowed);
      setLastUpdate(new Date());
      hasLoadedRef.current = true;
    } catch {
      setError("Không thể tải danh sách độc giả.");
    } finally {
      setLoading(false);
    }
  }, []);

  const handleSSEEvent = useCallback((event: CameraEvent) => {
    if (!event.access_type || !event.patron_id) return;
    if (!ACTIVE_CAMERA_IDS.has(event.camera_id)) return;

    if (event.access_type === "entry" && event.status === "granted") {
      setPatrons((prev) => {
        if (prev.some((p) => p.id === event.patron_id)) return prev;
        const newPatron: ActivePatron = {
          id: event.patron_id!,
          full_name: event.full_name || event.student_code || "",
          student_code: event.student_code || "",
          entered_at: new Date().toISOString(),
          camera_id: event.camera_id,
          image_url: null,
          confidence: event.score ?? null,
        };
        return [newPatron, ...prev];
      });
      setLastUpdate(new Date());
    } else if (event.access_type === "exit" && event.status === "granted") {
      setPatrons((prev) => prev.filter((p) => p.id !== event.patron_id));
      setLastUpdate(new Date());
    }
  }, []);

  const startFallbackPolling = useCallback(() => {
    if (fallbackRef.current) clearInterval(fallbackRef.current);
    fallbackRef.current = setInterval(() => {
      if (!hasLoadedRef.current) return;
      load();
    }, 60000);
  }, [load]);

  const stopFallbackPolling = useCallback(() => {
    if (fallbackRef.current) {
      clearInterval(fallbackRef.current);
      fallbackRef.current = null;
    }
  }, []);

  useEffect(() => {
    load();

    const cleanup = api.connectAccessSSE(handleSSEEvent, (connected) => {
      setSseConnected(connected);
      if (connected) {
        stopFallbackPolling();
      } else {
        startFallbackPolling();
      }
    });

    startFallbackPolling();

    return () => {
      cleanup();
      stopFallbackPolling();
    };
  }, [handleSSEEvent, load, startFallbackPolling, stopFallbackPolling]);

  const q = normalizeQuery(search);
  const filtered = useMemo(() => {
    if (!q) return patrons;
    return patrons.filter((p) =>
      p.full_name.toLowerCase().includes(q) || p.student_code.toLowerCase().includes(q)
    );
  }, [patrons, search]);

  const stalePatrons = useMemo(() => {
    const now = Date.now();
    return patrons.filter((p) => {
      const hours = (now - new Date(p.entered_at).getTime()) / (1000 * 60 * 60);
      return hours > 8;
    });
  }, [patrons]);

  // Chỉ số phục vụ nguyên tắc 5 giây
  const LIBRARY_CAPACITY = 200; // Sức chứa tối đa phòng đọc
  const activeCount = patrons.length;
  const occupancyPct = Math.min(100, Math.round((activeCount / LIBRARY_CAPACITY) * 100));

  const avgDurationMinutes = useMemo(() => {
    if (patrons.length === 0) return 0;
    const now = Date.now();
    const totalMinutes = patrons.reduce((acc, p) => {
      const diffMs = now - new Date(p.entered_at).getTime();
      return acc + Math.max(0, Math.floor(diffMs / 60000));
    }, 0);
    return Math.round(totalMinutes / patrons.length);
  }, [patrons]);

  const avgDurationText = useMemo(() => {
    if (avgDurationMinutes < 1) return "< 1 phút";
    if (avgDurationMinutes < 60) return `${avgDurationMinutes} phút`;
    const h = Math.floor(avgDurationMinutes / 60);
    const m = avgDurationMinutes % 60;
    return m > 0 ? `${h}h ${m}m` : `${h} giờ`;
  }, [avgDurationMinutes]);

  const handleForceExit = async () => {
    if (!exitPatron) return;
    setExiting(true);
    try {
      await api.forceExitPatron(exitPatron.id);
      toast.success(`Đã đánh dấu ${exitPatron.full_name || exitPatron.student_code} đã ra`);
      setExitPatron(null);
      await load();
    } catch (err) {
      toast.error(getErrorMessage(err) || "Lỗi khi đánh dấu ra");
    } finally {
      setExiting(false);
    }
  };

  return (
    <Stack spacing={3}>
      <PageHeader
        title="Độc giả đang có mặt"
        subtitle="Giám sát phòng đọc thời gian thực qua hệ thống camera AI & cổng kiểm soát"
        icon={PeopleIcon}
        statBadges={`${patrons.length} độc giả đang ở trong thư viện — cập nhật ${lastUpdate.toLocaleTimeString("vi-VN")}`}
        onRefresh={load}
        actions={
          <Stack direction="row" spacing={1} sx={{ alignItems: "center" }}>
            <Stack direction="row" spacing={0.5} sx={{ alignItems: "center" }}>
              <Box sx={{ width: 6, height: 6, borderRadius: "50%", bgcolor: error ? "error.main" : sseConnected ? "#6ee7b7" : "#fcd34d", animation: sseConnected ? "pulse 2s ease-in-out infinite" : undefined }} />
              <Typography variant="caption" color="text.secondary">
                {error ? "Lỗi" : sseConnected ? "Live" : "Polling"}
              </Typography>
            </Stack>
          </Stack>
        }
      />

      {/* Dãy KPI chuẩn 5 giây */}
      <Grid container spacing={2}>
        {/* Card 1: Góc trên bên trái - Chỉ số cốt lõi nhất */}
        <Grid size={{ xs: 12, sm: 4 }}>
          <MuiStatCard
            label="Đang trong phòng đọc"
            value={activeCount}
            icon={UserCheckIcon}
            gradient="linear-gradient(135deg, #0A2540 0%, #0F3C5C 100%)"
            pct={occupancyPct}
            delta={`${occupancyPct}% sức chứa (${activeCount}/${LIBRARY_CAPACITY} chỗ)`}
            deltaColor={occupancyPct >= 90 ? "error" : occupancyPct >= 75 ? "warning" : "default"}
            index={0}
          />
        </Grid>

        {/* Card 2: Cảnh báo lưu lại quá 8 giờ (Tô màu có mục đích) */}
        <Grid size={{ xs: 12, sm: 4 }}>
          <MuiStatCard
            label="Lưu lại quá 8 giờ"
            value={stalePatrons.length}
            icon={WarningAmberOutlinedIcon}
            gradient={stalePatrons.length > 0 ? "linear-gradient(135deg, #8B0000 0%, #700000 100%)" : "linear-gradient(135deg, #475569 0%, #334155 100%)"}
            pct={activeCount > 0 ? Math.round((stalePatrons.length / activeCount) * 100) : 0}
            delta={stalePatrons.length > 0 ? "⚠ Nghi vấn quên check-out, cần xử lý" : "✓ 0 độc giả quá thời gian quy định"}
            deltaColor={stalePatrons.length > 0 ? "error" : "success"}
            index={1}
          />
        </Grid>

        {/* Card 3: Thời gian lưu lại trung bình */}
        <Grid size={{ xs: 12, sm: 4 }}>
          <MuiStatCard
            label="Thời gian lưu lại TB"
            value={avgDurationText}
            icon={AccessTimeOutlinedIcon}
            gradient="linear-gradient(135deg, #D4AF37 0%, #B89628 100%)"
            delta={activeCount > 0 ? `Tính trên ${activeCount} độc giả hiện diện` : "Chưa có lượt vào"}
            deltaColor="default"
            index={2}
          />
        </Grid>
      </Grid>

      {stalePatrons.length > 0 ? (
        <Alert severity="warning" sx={{ borderRadius: 2 }}>
          <Typography variant="subtitle2" sx={{ fontWeight: 700 }}>
            {stalePatrons.length} độc giả ở trong thư viện quá 8 giờ
          </Typography>
          <Typography variant="body2">
            Có thể gate không detect exit. Kiểm tra và sử dụng nút &ldquo;Đánh dấu đã ra&rdquo; nếu cần.
          </Typography>
        </Alert>
      ) : null}

      <DashboardCard
        title="Độc giả"
        subtitle={`${filtered.length} kết quả`}
        actions={
          <TextField
            value={search}
            onChange={(e) => setSearch(e.target.value)}
            placeholder="Tìm theo tên hoặc MSSV..."
            size="small"
            sx={{ width: { xs: "100%", sm: 320 }, "& .MuiOutlinedInput-root": { borderRadius: 2, bgcolor: "background.paper", "&:hover": { "& fieldset": { borderColor: "primary.main" } } } }}
            slotProps={{
              input: {
                startAdornment: (
                  <InputAdornment position="start">
                    <SearchOutlinedIcon fontSize="small" />
                  </InputAdornment>
                ),
              },
            }}
          />
        }
      >
        <LoadingOverlay loading={loading && patrons.length === 0} message="Đang tải...">
          {patrons.length === 0 && !loading ? (
            <EmptyState
              icon={<Box sx={{ width: 64, height: 64, borderRadius: 3, display: "flex", alignItems: "center", justifyContent: "center", bgcolor: "rgba(0,0,0,0.04)", color: "text.disabled", mb: 1 }}><MenuBookOutlinedIcon sx={{ fontSize: 32 }} /></Box>}
              title="Thư viện đang yên tĩnh"
              description="Chưa có độc giả nào trong thư viện. Danh sách sẽ tự động cập nhật khi có lượt vào hợp lệ."
            />
          ) : filtered.length === 0 && patrons.length > 0 ? (
            <EmptyState
              icon={<SearchOutlinedIcon sx={{ fontSize: 36, color: "text.disabled" }} />}
              title={`Không tìm thấy độc giả "${search}"`}
            />
          ) : (
            <Grid container spacing={1.5}>
              {filtered.map((patron, idx) => {
                const dur = getDuration(patron.entered_at);
                const accent = DURATION_ACCENT[dur.level];
                const percent = patron.confidence == null ? null : Math.round(patron.confidence * 100);
                const avatarGradient =
                  dur.level <= 1
                    ? "linear-gradient(135deg, #10b981 0%, #059669 100%)"
                    : dur.level === 2
                      ? "linear-gradient(135deg, #f59e0b 0%, #d97706 100%)"
                      : "linear-gradient(135deg, #ef4444 0%, #dc2626 100%)";
                return (
                  <Grid key={patron.id} size={{ xs: 12, xl: 6 }} sx={staggerSx(idx, 0.05)}>
                    <Box
                      sx={{
                        borderRadius: 2,
                        overflow: "hidden",
                        position: "relative",
                        border: "1px solid",
                        borderColor: "divider",
                        transition: "transform 0.2s, box-shadow 0.2s",
                        "&:hover": {
                          transform: "translateY(-1px)",
                          boxShadow: 4,
                        },
                      }}
                    >
                      <Box
                        sx={{
                          position: "absolute",
                          left: 0,
                          top: 0,
                          bottom: 0,
                          width: 3,
                          bgcolor: accent,
                          opacity: 0.7,
                        }}
                      />

                      <Box sx={{ pl: 2.5, pr: 2, py: 1.5 }}>
                        <Stack direction="row" spacing={1.5} sx={{ alignItems: "flex-start" }}>
                          <AvatarUser user={patron} role="patron" size={36} />
                          <Box sx={{ minWidth: 0, flex: 1 }}>
                            <Stack
                              direction="row"
                              spacing={1}
                              sx={{ justifyContent: "space-between", alignItems: "flex-start" }}
                            >
                              <Box sx={{ minWidth: 0 }}>
                                <Typography noWrap sx={{ fontWeight: 700, fontSize: 14 }}>
                                  {patron.full_name || "Chưa có tên"}
                                </Typography>
                                <Typography
                                  variant="caption"
                                  color="text.secondary"
                                  sx={{ fontFamily: "monospace", fontSize: 12 }}
                                >
                                  {patron.student_code}
                                </Typography>
                              </Box>
                              <Stack direction="row" spacing={0.5} sx={{ alignItems: "center", flexShrink: 0 }}>
                                {percent != null ? (
                                  <Tooltip title={`Độ chính xác: ${percent}%`}>
                                    <Box
                                      sx={{
                                        width: 8,
                                        height: 8,
                                        borderRadius: "50%",
                                        bgcolor:
                                          percent >= 80 ? "success.main" : percent >= 60 ? "warning.main" : "error.main",
                                      }}
                                    />
                                  </Tooltip>
                                ) : null}
                                <Box
                                  sx={{
                                    px: 1,
                                    py: 0.25,
                                    borderRadius: 0.75,
                                    bgcolor:
                                      dur.level <= 1
                                        ? "rgba(74,140,92,0.1)"
                                        : dur.level === 2
                                          ? "rgba(196,154,60,0.1)"
                                          : "rgba(184,92,74,0.1)",
                                  }}
                                >
                                  <Typography
                                    variant="caption"
                                    sx={{ fontWeight: 700, fontSize: 11, color: accent, whiteSpace: "nowrap" }}
                                  >
                                    {dur.text}
                                  </Typography>
                                </Box>
                              </Stack>
                            </Stack>

                            <Stack direction="row" spacing={2} sx={{ mt: 1, flexWrap: "wrap", rowGap: 0.5 }}>
                              <Stack direction="row" spacing={0.5} sx={{ alignItems: "center" }}>
                                <AccessTimeOutlinedIcon sx={{ fontSize: 13, color: "text.disabled" }} />
                                <Typography variant="caption" color="text.secondary" sx={{ fontSize: 12 }}>
                                  {formatTime(patron.entered_at)}
                                </Typography>
                              </Stack>
                              <Stack direction="row" spacing={0.5} sx={{ alignItems: "center" }}>
                                <LocationOnOutlinedIcon sx={{ fontSize: 13, color: "text.disabled" }} />
                                <Typography variant="caption" color="text.secondary" sx={{ fontSize: 12 }}>
                                  {CAMERA_CONFIG[patron.camera_id]?.label || patron.camera_id}
                                </Typography>
                              </Stack>
                            </Stack>
                          </Box>
                          <Tooltip title={!canUpdate ? getPermissionDeniedReason("borrows", "update") : "Đánh dấu đã ra"}>
                            <span>
                              <IconButton
                                size="small"
                                color="warning"
                                disabled={!canUpdate}
                                onClick={() => {
                                  if (!canUpdate) return;
                                  setExitPatron(patron);
                                }}
                                sx={{ flexShrink: 0, mt: 0.5 }}
                              >
                                <LogoutIcon fontSize="small" />
                              </IconButton>
                            </span>
                          </Tooltip>
                        </Stack>
                      </Box>
                    </Box>
                  </Grid>
                );
              })}
            </Grid>
          )}
        </LoadingOverlay>
      </DashboardCard>

      <Dialog open={!!exitPatron} onClose={() => exiting ? undefined : setExitPatron(null)} maxWidth="xs" fullWidth>
        <DialogTitle sx={{ fontWeight: 900 }}>Xác nhận đánh dấu đã ra?</DialogTitle>
        <DialogContent>
          <Typography>
            Độc giả <strong>{exitPatron?.full_name || exitPatron?.student_code}</strong> sẽ được đánh dấu đã rời khỏi thư viện.
          </Typography>
          <Typography variant="body2" color="text.secondary" sx={{ mt: 1 }}>
            Dùng khi gate không detect được exit.
          </Typography>
        </DialogContent>
        <DialogActions>
          <Button onClick={() => setExitPatron(null)} disabled={exiting}>Hủy</Button>
          <Button variant="contained" color="warning" onClick={handleForceExit} disabled={exiting}>
            {exiting ? "Đang xử lý..." : "Đánh dấu đã ra"}
          </Button>
        </DialogActions>
      </Dialog>
    </Stack>
  );
}
</file>

<file path="src/app/(dashboard)/identify/page.tsx">
"use client";

import { useEffect, useRef, useState } from "react";
import { Alert, Box, Button, Checkbox, Chip, CircularProgress, LinearProgress, Stack, Table, TableBody, TableCell, TableContainer, TableHead, TableRow, Typography } from "@mui/material";
import FaceRetouchingNaturalOutlinedIcon from "@mui/icons-material/FaceRetouchingNaturalOutlined";
import RestartAltOutlinedIcon from "@mui/icons-material/RestartAltOutlined";
import CameraCapture from "@/app/(dashboard)/_components/camera-capture";
import api, { getErrorMessage } from "@/lib/api-client";
import PageHeader from "@/app/(dashboard)/_components/ui/PageHeader";
import DashboardCard from "@/app/(dashboard)/_components/ui/DashboardCard";
import EmptyState from "@/app/(dashboard)/_components/ui/EmptyState";
import { staggerSx } from "@/lib/useStaggeredAnimation";
import { getAlertSeverity } from "@/lib/alert-utils";
import type { FaceResultEvent } from "@/lib/types";
import { preprocessImage, isImageTooDark, getImageSizeReduction } from "@/lib/image-preprocessor";

export default function IdentifyPage() {
  const [imageFile, setImageFile] = useState<File | null>(null);
  const [dataUrl, setDataUrl] = useState<string>("");
  const [consent, setConsent] = useState(false);
  const [isLoading, setIsLoading] = useState(false);
  const [isProcessing, setIsProcessing] = useState(false);
  const [error, setError] = useState("");
  const [matches, setMatches] = useState<any[] | null>(null);
  const [connected, setConnected] = useState(false);
  const [lowLightWarning, setLowLightWarning] = useState(false);
  const [processingStats, setProcessingStats] = useState<{
    originalSize: number;
    processedSize: number;
    reduction: number;
  } | null>(null);
  const cleanupRef = useRef<(() => void) | null>(null);

  useEffect(() => {
    const cleanup = api.connectFaceResultSSE(
    (event: FaceResultEvent) => {
      if (event.process_type !== "identify") return;
      if (event.status === "SUCCESS" && event.result) {
        const resultMatches = event.result.matches;
        setMatches(Array.isArray(resultMatches) ? resultMatches : []);
        setIsLoading(false);
      } else if (event.status === "FAILURE") {
        setError((event.result?.error as string) || "Nhận diện thất bại.");
        setIsLoading(false);
      }
    },
      (connected) => setConnected(connected),
    );
    cleanupRef.current = cleanup;
    return () => { cleanup(); cleanupRef.current = null; };
  }, []);

  const handleCapture = (file: File, url: string) => {
    setImageFile(file);
    setDataUrl(url);
    setMatches(null);
    setLowLightWarning(false);
    setProcessingStats(null);
  };

  const handleFileUpload = (file: File) => {
    const reader = new FileReader();
    reader.onload = (e) => {
      const url = e.target?.result as string;
      setImageFile(file);
      setDataUrl(url);
      setMatches(null);
      setLowLightWarning(false);
      setProcessingStats(null);
    };
    reader.readAsDataURL(file);
  };

  const handleSubmit = async (event: React.FormEvent) => {
    event.preventDefault();
    if (!imageFile) return;
    setError("");
    setIsLoading(true);
    setIsProcessing(true);
    setMatches(null);
    setLowLightWarning(false);
    setProcessingStats(null);
    
    try {
      const preprocessed = await preprocessImage(imageFile, {
        maxWidth: 640,
        maxHeight: 480,
        quality: 0.85,
        convertToGrayscale: false,
        brightnessThreshold: 50,
      });

      setProcessingStats({
        originalSize: preprocessed.originalSize,
        processedSize: preprocessed.processedSize,
        reduction: getImageSizeReduction(preprocessed.originalSize, preprocessed.processedSize),
      });

      if (isImageTooDark(preprocessed.brightness, 50)) {
        setLowLightWarning(true);
        setIsLoading(false);
        setIsProcessing(false);
        return;
      }

      const reader = new FileReader();
      const base64 = await new Promise<string>((resolve, reject) => {
        reader.onload = () => {
          const result = reader.result as string;
          const base64Data = result.split(',')[1];
          resolve(base64Data);
        };
        reader.onerror = reject;
        reader.readAsDataURL(preprocessed.blob);
      });

      setIsProcessing(false);

      const result = await api.processFaceImageSync({
        image: base64,
        camera_id: "identify_dashboard",
        process_type: "identify",
        consent_given: consent,
      });

      if (result.status === "success" && result.result?.matches) {
        setMatches(Array.isArray(result.result.matches) ? result.result.matches : []);
      } else if (result.result?.error) {
        setError(result.result.error as string);
      } else {
        setError("Nhận diện thất bại.");
      }
    } catch (err: any) {
      setError(getErrorMessage(err) || "Nhận diện thất bại.");
    } finally {
      setIsLoading(false);
      setIsProcessing(false);
    }
  };

  const reset = () => {
    setMatches(null);
    setDataUrl("");
    setImageFile(null);
    setError("");
    setIsLoading(false);
    setIsProcessing(false);
    setLowLightWarning(false);
    setProcessingStats(null);
  };

  return (
    <Stack spacing={3} sx={{ maxWidth: 1040, mx: "auto" }}>
      <Box sx={staggerSx(0)}>
        <PageHeader
          title="Nhận diện khuôn mặt"
          subtitle="Tìm người dùng gần nhất trong kho khuôn mặt đã đăng ký."
          icon={FaceRetouchingNaturalOutlinedIcon}
        />
      </Box>

      {error ? (
        <Box sx={staggerSx(1)}>
          <Alert severity={getAlertSeverity(error)}>{error}</Alert>
        </Box>
      ) : null}

      {lowLightWarning ? (
        <Box sx={staggerSx(1)}>
          <Alert 
            severity="warning" 
            action={
              <Button color="inherit" size="small" onClick={reset}>
                Thử lại
              </Button>
            }
          >
            Ánh sáng yếu! Vui lòng di chuyển đến nơi có ánh sáng tốt hơn hoặc bật đèn.
          </Alert>
        </Box>
      ) : null}

      {isLoading ? (
        <Box sx={staggerSx(1)}>
          <DashboardCard>
            <Stack direction="row" spacing={2} sx={{ alignItems: "center" }}>
              <CircularProgress size={24} sx={{ color: "primary.main" }} />
              <Box sx={{ flex: 1, minWidth: 0 }}>
                <Typography sx={{ fontWeight: 800 }}>
                  {isProcessing ? "Đang tiền xử lý ảnh..." : "Đang nhận diện..."}
                </Typography>
                <Typography variant="body2" color="text.secondary">
                  {connected ? "Kết nối SSE đang chờ kết quả" : "Đang kết nối..."}
                </Typography>
                <LinearProgress sx={{ mt: 1, height: 6, borderRadius: 3 }} />
              </Box>
            </Stack>
          </DashboardCard>
        </Box>
      ) : matches ? (
        <Stack spacing={2} sx={staggerSx(1)}>
          <DashboardCard
            title={`Tìm thấy ${matches.length} kết quả`}
            subtitle="Kết quả được sắp xếp theo độ tin cậy giảm dần."
            actions={<Button startIcon={<RestartAltOutlinedIcon />} variant="outlined" onClick={reset}>Thử lại</Button>}
          />

          {dataUrl ? (
            <DashboardCard noPadding>
              <Box component="img" src={dataUrl} alt="Ảnh đã chụp" sx={{ width: 160, height: 160, objectFit: "cover", borderRadius: 2, border: 1, borderColor: "divider", mx: "auto" }} />
            </DashboardCard>
          ) : null}

          {processingStats ? (
            <DashboardCard>
              <Typography variant="body2" color="text.secondary">
                Ảnh đã xử lý: {processingStats.originalSize} → {processingStats.processedSize} 
                (giảm {processingStats.reduction}%)
              </Typography>
            </DashboardCard>
          ) : null}

          {matches.length === 0 ? (
            <DashboardCard>
              <EmptyState
                icon={<FaceRetouchingNaturalOutlinedIcon />}
                title="Không tìm thấy khuôn mặt phù hợp"
                description="Không có kết quả nào khớp với khuôn mặt đã cung cấp."
              />
            </DashboardCard>
          ) : (
            <DashboardCard noPadding>
      <TableContainer sx={{ overflowX: "auto" }}>
      <Table sx={{ minWidth: 820 }}>
                  <TableHead>
                    <TableRow>
                      <TableCell>Độ tin cậy</TableCell>
                      <TableCell>User ID</TableCell>
                      <TableCell>Tên</TableCell>
                      <TableCell>Email</TableCell>
                      <TableCell>Vai trò</TableCell>
                    </TableRow>
                  </TableHead>
                  <TableBody>
                    {matches.map((match, index) => {
                      const score = Number(match.score ?? 0);
                      const percent = Number((score * 100).toFixed(1));
                      return (
                        <TableRow key={`${match.user_id}-${index}`} hover>
                          <TableCell sx={{ minWidth: 180 }}>
                            <Stack direction="row" spacing={1} sx={{ alignItems: "center" }}>
                              <LinearProgress
                                variant="determinate"
                                value={Math.min(percent, 100)}
                                color={score > 0.6 ? "success" : score > 0.3 ? "warning" : "error"}
                                sx={{ width: 90, height: 6, borderRadius: 3 }}
                              />
                              <Typography variant="body2" sx={{ fontFamily: "monospace" }}>{percent}%</Typography>
                            </Stack>
                          </TableCell>
                          <TableCell sx={{ fontFamily: "monospace", color: "text.secondary" }}>{match.user_id}</TableCell>
                          <TableCell sx={{ fontWeight: 750 }}>{match.full_name || "-"}</TableCell>
                          <TableCell sx={{ color: "text.secondary" }}>{match.email || "-"}</TableCell>
                          <TableCell><Chip size="small" label={match.role || "-"} /></TableCell>
                        </TableRow>
                      );
                    })}
                  </TableBody>
                </Table>
              </TableContainer>
            </DashboardCard>
          )}
        </Stack>
      ) : (
        <Box sx={staggerSx(1)}>
          <DashboardCard>
            <Box component="form" onSubmit={handleSubmit}>
              <Stack spacing={2.5}>
                <CameraCapture onCapture={handleCapture} onFileUpload={handleFileUpload} />
       <Stack direction={{ xs: "column", sm: "row" }} spacing={1} sx={{ alignItems: { xs: "flex-start", sm: "center" } }}>
         <Checkbox checked={consent} onChange={(event) => setConsent(event.target.checked)} />
         <Typography variant="body2" sx={{ color: "text.secondary", lineHeight: 1.5, mt: { xs: -0.5, sm: 0 } }}>
           Tôi đồng ý cho hệ thống xử lý dữ liệu khuôn mặt để nhận diện.
         </Typography>
       </Stack>
                <Button type="submit" variant="contained" disabled={!imageFile || !consent || isLoading} fullWidth>
                  {isLoading ? "Đang gửi..." : "Nhận diện khuôn mặt"}
                </Button>
              </Stack>
            </Box>
          </DashboardCard>
        </Box>
      )}
    </Stack>
  );
}
</file>

<file path="src/app/(dashboard)/patrons/[id]/page.tsx">
"use client";

import { useCallback, useEffect, useMemo, useState } from "react";
import { useParams, useRouter } from "next/navigation";
import {
  Alert,
  Avatar,
  Box,
  Button,
  Chip,
  Dialog,
  DialogActions,
  DialogContent,
  DialogTitle,
  Divider,
  Grid,
  IconButton,
  LinearProgress,
  MenuItem,
  Paper,
  Stack,
  Tab,
  Table,
  TableBody,
  TableCell,
  TableContainer,
  TableHead,
  TableRow,
  Tabs,
  TextField,
  Typography,
} from "@mui/material";
import AutoStoriesOutlinedIcon from "@mui/icons-material/AutoStoriesOutlined";
import BadgeOutlinedIcon from "@mui/icons-material/BadgeOutlined";
import CalendarTodayIcon from "@mui/icons-material/CalendarTodayOutlined";
import DeleteOutlineOutlinedIcon from "@mui/icons-material/DeleteOutlineOutlined";
import CloseIcon from "@mui/icons-material/Close";
import EditOutlinedIcon from "@mui/icons-material/EditOutlined";
import EventAvailableOutlinedIcon from "@mui/icons-material/EventAvailableOutlined";
import FaceRetouchingNaturalOutlinedIcon from "@mui/icons-material/FaceRetouchingNaturalOutlined";
import HistoryOutlinedIcon from "@mui/icons-material/HistoryOutlined";
import MailIcon from "@mui/icons-material/MailOutlined";
import PhoneIcon from "@mui/icons-material/PhoneOutlined";
import SchoolIcon from "@mui/icons-material/SchoolOutlined";
import UpdateOutlinedIcon from "@mui/icons-material/UpdateOutlined";
import PersonIcon from "@mui/icons-material/PersonOutlined";
import LocationOnIcon from "@mui/icons-material/LocationOnOutlined";
import VerifiedIcon from "@mui/icons-material/VerifiedOutlined";
import api, { getErrorMessage } from "@/lib/api-client";
import MultiAngleCapture from "@/app/(dashboard)/_components/MultiAngleCapture";
import PageHeader from "@/app/(dashboard)/_components/ui/PageHeader";
import DashboardCard from "@/app/(dashboard)/_components/ui/DashboardCard";
import EmptyState from "@/app/(dashboard)/_components/ui/EmptyState";
import LoadingOverlay from "@/app/(dashboard)/_components/ui/LoadingOverlay";
import AvatarUser from "@/app/(dashboard)/_components/ui/AvatarUser";
import { useTaskSSE } from "@/lib/hooks/useTaskSSE";
import { useToast } from "@/lib/toast-context";
import { staggerSx } from "@/lib/useStaggeredAnimation";
import {
  mapEnrollError,
  extractFailedAngles,
  buildAngleErrorMessage,
} from "@/lib/face-enroll-errors";
import { initials, formatDate, formatDateTime, statusLabel, statusColor } from "@/lib/utils";
import type { AccessLogPublic, BorrowRecord, PatronPublic, PatronUpdate } from "@/lib/types";
import type { CaptureAngle } from "@/app/(dashboard)/_components/MultiAngleCapture";

const CAMERA_LABELS: Record<string, string> = {
  entry_gate: "Cổng vào",
  exit_gate: "Cổng ra",
  kiosk: "Kiosk",
  web_login: "Đăng nhập web",
};

function borrowStatus(record: BorrowRecord) {  const overdue = record.status === "borrowed" && new Date(record.due_at) < new Date();
  if (record.status === "returned") return { label: "Đã trả", color: "default" as const };
  if (overdue) return { label: "Quá hạn", color: "error" as const };
  return { label: "Đang mượn", color: "success" as const };
}

function MetaRow({ icon, label, value }: { icon: React.ReactNode; label: string; value: React.ReactNode }) {
  return (
    <Stack direction="row" spacing={1.5} sx={{ alignItems: "flex-start", py: 1 }}>
      <Box sx={{ color: "text.secondary", mt: 0.3, minWidth: 20 }}>{icon}</Box>
      <Box sx={{ flex: 1, minWidth: 0 }}>
        <Typography variant="caption" color="text.secondary" sx={{ textTransform: "uppercase", letterSpacing: 0.5 }}>
          {label}
        </Typography>
        <Typography variant="body2" sx={{ fontWeight: 600, wordBreak: "break-word" }}>
          {value || "-"}
        </Typography>
      </Box>
    </Stack>
  );
}

export default function PatronDetailPage() {
  const { id } = useParams<{ id: string }>();
  const router = useRouter();

  const [patron, setPatron] = useState<PatronPublic | null>(null);
  const [loading, setLoading] = useState(true);
  const [logs, setLogs] = useState<AccessLogPublic[]>([]);
  const [logsTotal, setLogsTotal] = useState(0);
  const [logsSkip, setLogsSkip] = useState(0);
  const logsLimit = 20;
  const [borrows, setBorrows] = useState<BorrowRecord[]>([]);
  const [tab, setTab] = useState(0);

  const [editForm, setEditForm] = useState<PatronUpdate>({});
  const [showEdit, setShowEdit] = useState(false);
  const [showDelete, setShowDelete] = useState(false);
  const [deleteConfirmText, setDeleteConfirmText] = useState("");
  const [showRestore, setShowRestore] = useState(false);
  const [restoreConfirmText, setRestoreConfirmText] = useState("");
  const [showEnroll, setShowEnroll] = useState(false);
  const { toast } = useToast();
  const enrollTask = useTaskSSE(120000);
  const [consent, setConsent] = useState(false);
  const [enrollError, setEnrollError] = useState("");
  const [enrollSuccess, setEnrollSuccess] = useState("");
  const [enrollLoading, setEnrollLoading] = useState(false);

  const loadPatron = useCallback(async () => {
    try {
      const data = await api.getPatron(id);
      setPatron(data);
    } catch {
      setPatron(null);
    }
  }, [id]);

  const loadLogs = useCallback(async () => {
    try {
      const data = await api.getAccessLogs({ patronId: id, skip: logsSkip, limit: logsLimit });
      setLogs(data.items);
      setLogsTotal(data.total);
    } catch {
      setLogs([]);
      setLogsTotal(0);
    }
  }, [id, logsSkip]);

  const loadBorrows = useCallback(async () => {
    try {
      const data = await api.getBorrowHistory({ patronId: id });
      setBorrows(data);
    } catch {
      setBorrows([]);
    }
  }, [id]);

  useEffect(() => {
    (async () => {
      setLoading(true);
      await Promise.all([loadPatron(), loadLogs(), loadBorrows()]);
      setLoading(false);
    })();
  }, [loadPatron, loadLogs, loadBorrows]);

  const openEdit = () => {
    if (!patron) return;
    setEditForm({
      full_name: patron.full_name,
      class_name: patron.class_name || undefined,
      identity_number: patron.identity_number || undefined,
      email: patron.email || undefined,
      phone: patron.phone || undefined,
      membership_expiry: patron.membership_expiry,
      status: patron.status,
      course: patron.course || undefined,
    });
    setShowEdit(true);
  };

  const handleEdit = async () => {
    if (!patron) return;
    await api.updatePatron(patron.id, editForm);
    setShowEdit(false);
    toast.success("Đã cập nhật thông tin độc giả.");
    await loadPatron();
  };

  const handleRenew = async () => {
    if (!patron) return;
    const next = new Date(patron.membership_expiry);
    if (next < new Date()) next.setTime(Date.now());
    next.setFullYear(next.getFullYear() + 1);
    await api.updatePatron(patron.id, { membership_expiry: next.toISOString().split("T")[0] });
    toast.success("Đã gia hạn thẻ thêm 1 năm.");
    await loadPatron();
  };

  const handleDelete = async () => {
    if (!patron || deleteConfirmText !== "XÓA") return;
    try {
      await api.deletePatron(patron.id);
      toast.success(`Đã xóa độc giả ${patron.full_name}`);
      router.push("/patrons");
    } catch (err: any) {
      if (err?.response?.status === 404) {
        toast.error("Độc giả không tồn tại hoặc đã bị xóa.");
        router.push("/patrons");
      } else {
        toast.error(`Xóa thất bại: ${getErrorMessage(err) || "Lỗi không xác định"}`);
      }
    }
  };

  const handleRestore = async () => {
    if (!patron || restoreConfirmText !== "KHÔI PHỤC") return;
    try {
      await api.restorePatron(patron.id);
      setShowRestore(false);
      setRestoreConfirmText("");
      toast.success("Đã khôi phục độc giả.");
      await loadPatron();
    } catch (err: any) {
      toast.error(`Khôi phục thất bại: ${getErrorMessage(err) || "Lỗi không xác định"}`);
    }
  };

  const handleEnroll = async (files: Record<CaptureAngle, File>) => {
    if (!patron) return;
    setEnrollLoading(true);
    setEnrollError("");
    setEnrollSuccess("");
    try {
      const res = await api.enrollPatronFaceBatch(patron.id, {
        frontal: files.frontal,
        right: files.right,
        left: files.left,
        down: files.down,
      });
      // Enroll chạy bất đồng bộ trên worker: chờ job hoàn tất qua SSE rồi mới báo kết quả
      if (res?.job_id) {
        enrollTask.start(res.job_id);
      } else {
        finishEnrollSuccess();
        await loadPatron();
      }
    } catch (err: any) {
      setEnrollLoading(false);
      const message = mapEnrollError(
        err?.response?.data?.error || err?.response?.data?.detail,
        getErrorMessage(err) || "Đăng ký thất bại."
      );
      setEnrollError(message);
      toast(message, "error");
    }
  };

  const finishEnrollSuccess = () => {
    setEnrollSuccess("Đăng ký khuôn mặt thành công.");
    setShowEnroll(false);
    setConsent(false);
    setEnrollLoading(false);
  };

  // Lắng nghe kết quả job enroll từ SSE: thành công mới reload (has_face) và toast
  useEffect(() => {
    const s = enrollTask.state.status;
    if (s === "SUCCESS") {
      enrollTask.reset();
      finishEnrollSuccess();
      toast("Đăng ký khuôn mặt thành công.", "success");
      loadPatron();
    } else if (s === "FAILURE" || s === "ERROR" || s === "TIMEOUT") {
      enrollTask.reset();
      setEnrollLoading(false);
      // Ưu tiên hiện rõ góc nào lỗi để chụp lại, thay vì câu chung "N angle(s) failed"
      const failedAngles = extractFailedAngles(enrollTask.state.result);
      const message =
        failedAngles.length > 0
          ? `${buildAngleErrorMessage(failedAngles, "Đăng ký khuôn mặt thất bại.")} Toàn bộ đã được rollback, vui lòng chụp lại các góc lỗi.`
          : mapEnrollError(enrollTask.state.error, "Đăng ký khuôn mặt thất bại.");
      setEnrollError(message);
      toast(message, "error");
    }
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [enrollTask.state.status]);

  const logsPageCount = Math.max(1, Math.ceil(logsTotal / logsLimit));
  const logsCurrentPage = Math.floor(logsSkip / logsLimit) + 1;
  const activeBorrowCount = useMemo(() => borrows.filter((item) => item.status === "borrowed").length, [borrows]);
  const overdueCount = useMemo(() => borrows.filter((item) => item.status === "borrowed" && new Date(item.due_at) < new Date()).length, [borrows]);
  const expired = !patron ? false : new Date(patron.membership_expiry) < new Date();

  const headerActions = patron ? (
    patron.status === "deleted" ? (
      <Button variant="contained" color="success" onClick={() => setShowRestore(true)}>
        Khôi phục
      </Button>
    ) : (
      <Stack direction="row" spacing={1} sx={{ flexWrap: "wrap" }}>
        <Button variant="outlined" startIcon={<EditOutlinedIcon />} onClick={openEdit}>
          Sửa
        </Button>
        <Button variant="outlined" startIcon={<UpdateOutlinedIcon />} onClick={handleRenew}>
          Gia hạn
        </Button>
        {!patron.has_face ? (
          <Button variant="contained" startIcon={<FaceRetouchingNaturalOutlinedIcon />} onClick={() => setShowEnroll(true)}>
            Đăng ký khuôn mặt
          </Button>
        ) : (
          <Button variant="outlined" startIcon={<FaceRetouchingNaturalOutlinedIcon />} onClick={() => setShowEnroll(true)}>
            Cập nhật khuôn mặt
          </Button>
        )}
        <Button color="error" variant="outlined" startIcon={<DeleteOutlineOutlinedIcon />} onClick={() => setShowDelete(true)}>
          Xóa
        </Button>
      </Stack>
    )
  ) : null;

  return (
    <LoadingOverlay loading={loading} message="Đang tải hồ sơ độc giả...">
      {!patron ? (
        <EmptyState
          icon={<PersonIcon sx={{ fontSize: 56 }} />}
          title="Không tìm thấy độc giả"
          description="Độc giả có thể đã bị xóa hoặc ID không hợp lệ."
          action={
            <Button variant="contained" startIcon={<PersonIcon />} onClick={() => router.push("/patrons")}>
              Quay lại danh sách
            </Button>
          }
        />
      ) : (
        <Stack spacing={3}>
          <PageHeader
            backHref="/patrons"
            title={patron.full_name}
            subtitle={`MSSV: ${patron.student_code} · Mã thẻ: ${patron.card_number || "-"}`}
            icon={PersonIcon}
            actions={headerActions}
          />

          {patron.status === "deleted" && <Alert severity="error" sx={{ fontWeight: 600 }}>Độc giả này đã bị xóa. Dữ liệu sẽ được giữ lại và có thể khôi phục.</Alert>}
          {patron.status === "inactive" && <Alert severity="warning" sx={{ fontWeight: 600 }}>Thẻ độc giả đang bị tạm khóa.</Alert>}
          {expired && <Alert severity="warning" sx={{ fontWeight: 600 }}>Thẻ độc giả đã hết hạn. Vui lòng gia hạn để tiếp tục sử dụng.</Alert>}
          {enrollSuccess && <Alert severity="success">{enrollSuccess}</Alert>}

          <Grid container spacing={3}>
            {/* Left column — Profile card */}
            <Grid size={{ xs: 12, md: 4 }} sx={staggerSx(0)}>
              <DashboardCard noPadding>
                <Box
                  sx={{
                    height: 100,
                    background: patron.status === "active" && !expired
                      ? "linear-gradient(135deg, #10b981 0%, #059669 100%)"
                      : expired
                        ? "linear-gradient(135deg, #f59e0b 0%, #d97706 100%)"
                        : "linear-gradient(135deg, #64748b 0%, #475569 100%)",
                  }}
                />
                <Box sx={{ px: 2.5, pb: 2.5, mt: -5, textAlign: "center" }}>
                  <AvatarUser
                    user={patron}
                    role="patron"
                    size={80}
                    border="4px solid rgba(255,255,255,0.9)"
                    sx={{ mx: "auto", boxShadow: 2, fontSize: "1.8rem" }}
                  />

                  <Typography variant="h6" sx={{ fontWeight: 800, mt: 1.5 }}>{patron.full_name}</Typography>
                  <Typography variant="body2" color="text.secondary" sx={{ fontFamily: "monospace" }}>{patron.student_code}</Typography>

                  <Stack direction="row" spacing={0.75} sx={{ justifyContent: "center", mt: 1.5, flexWrap: "wrap", gap: 0.5 }}>
                    <Chip label={statusLabel(patron.status)} color={statusColor(patron.status)} size="small" sx={{ fontWeight: 600 }} />
                    <Chip
                      icon={<FaceRetouchingNaturalOutlinedIcon sx={{ fontSize: "16px !important" }} />}
                      label={patron.has_face ? "Đã có khuôn mặt" : "Chưa có khuôn mặt"}
                      color={patron.has_face ? "success" : "default"}
                      size="small"
                      variant="outlined"
                    />
                  </Stack>

                  <Divider sx={{ my: 2 }} />

                  <Stack spacing={0}>
                    <MetaRow icon={<SchoolIcon fontSize="small" />} label="Khóa học" value={patron.course} />
                    <MetaRow icon={<BadgeOutlinedIcon fontSize="small" />} label="Lớp" value={patron.class_name} />
                    <MetaRow icon={<CalendarTodayIcon fontSize="small" />} label="Hạn thẻ" value={
                      <span style={{ color: expired ? "#d32f2f" : undefined, fontWeight: 700 }}>
                        {formatDate(patron.membership_expiry)}{expired ? " (Hết hạn)" : ""}
                      </span>
                    } />
                    <MetaRow icon={<MailIcon fontSize="small" />} label="Email" value={patron.email} />
                    <MetaRow icon={<PhoneIcon fontSize="small" />} label="Số điện thoại" value={patron.phone} />
                    <MetaRow icon={<LocationOnIcon fontSize="small" />} label="HKTT" value={patron.permanent_address} />
                  </Stack>
                </Box>
              </DashboardCard>
            </Grid>

            {/* Right column — Tabs */}
            <Grid size={{ xs: 12, md: 8 }} sx={staggerSx(1)}>
              <Stack spacing={3}>
                {/* Stats row */}
                <Stack direction="row" spacing={1.5}>
                  {[
                    { label: "Đang mượn", value: activeBorrowCount, color: "info" as const, icon: <AutoStoriesOutlinedIcon fontSize="small" /> },
                    { label: "Quá hạn", value: overdueCount, color: "error" as const, icon: <EventAvailableOutlinedIcon fontSize="small" /> },
                    { label: "Lượt ra/vào", value: logsTotal, color: "success" as const, icon: <HistoryOutlinedIcon fontSize="small" /> },
                  ].map((item, idx) => (
                    <Paper key={item.label} variant="outlined" sx={{
                      flex: 1,
                      p: 1.5,
                      textAlign: "center",
                      borderColor: `${item.color}.main`,
                      borderRadius: 2,
                      background: item.color === "info" ? "rgba(2,136,209,0.08)" : item.color === "error" ? "rgba(211,47,47,0.08)" : "rgba(46,125,50,0.08)",
                      ...staggerSx(idx),
                    }}>
                      <Box sx={{ color: `${item.color}.main`, mb: 0.5 }}>{item.icon}</Box>
                      <Typography variant="h5" sx={{ fontWeight: 900, color: `${item.color}.main` }}>{item.value}</Typography>
                      <Typography variant="caption" color="text.secondary" sx={{ textTransform: "uppercase", letterSpacing: 0.5 }}>{item.label}</Typography>
                    </Paper>
                  ))}
                </Stack>

                {/* Tabs */}
                <DashboardCard noPadding>
                  <Box sx={{ borderBottom: 1, borderColor: "divider", px: 2.5 }}>
                    <Tabs value={tab} onChange={(_, v) => setTab(v)}>
                      <Tab label="Thông tin chi tiết" />
                      <Tab label={`Lịch sử mượn (${borrows.length})`} />
                      <Tab label={`Lịch sử ra/vào (${logsTotal})`} />
                    </Tabs>
                  </Box>

                  {/* Tab 0: Info detail */}
                  {tab === 0 && (
                    <Box sx={{ p: 2.5 }}>
                      <Grid container spacing={0.5}>
                        {[
                          { label: "Họ tên", value: patron.full_name, icon: <PersonIcon fontSize="small" /> },
                          { label: "MSSV", value: patron.student_code, icon: <BadgeOutlinedIcon fontSize="small" /> },
                          { label: "Lớp", value: patron.class_name, icon: <SchoolIcon fontSize="small" /> },
                          { label: "Khóa học", value: patron.course, icon: <SchoolIcon fontSize="small" /> },
                          { label: "Mã thẻ", value: patron.card_number, icon: <BadgeOutlinedIcon fontSize="small" /> },
                          { label: "CCCD/CMND", value: patron.identity_number, icon: <BadgeOutlinedIcon fontSize="small" /> },
                          { label: "Email", value: patron.email, icon: <MailIcon fontSize="small" /> },
                          { label: "Số điện thoại", value: patron.phone, icon: <PhoneIcon fontSize="small" /> },
                          { label: "HKTT", value: patron.permanent_address, icon: <LocationOnIcon fontSize="small" /> },
                          { label: "Ngày cấp thẻ", value: formatDate(patron.issue_date), icon: <CalendarTodayIcon fontSize="small" /> },
                          { label: "Ngày tạo", value: formatDateTime(patron.created_at), icon: <CalendarTodayIcon fontSize="small" /> },
                        ].map((item) => (
                          <Grid key={item.label} size={{ xs: 12, sm: 6 }}>
                            <MetaRow icon={item.icon} label={item.label} value={item.value} />
                          </Grid>
                        ))}
                      </Grid>
                    </Box>
                  )}

                  {/* Tab 1: Borrow history */}
                  {tab === 1 && (
                    <Box>
                      {borrows.length === 0 ? (
                        <Alert severity="info" sx={{ m: 2 }}>Độc giả này chưa mượn cuốn sách nào.</Alert>
                      ) : (
                        <TableContainer sx={{ overflowX: "auto" }}>
                          <Table sx={{ minWidth: 700 }} size="small">
                            <TableHead>
                              <TableRow>
                                <TableCell>Sách</TableCell>
                                <TableCell>Mượn</TableCell>
                                <TableCell>Hạn trả</TableCell>
                                <TableCell>Trả</TableCell>
                                <TableCell>Trạng thái</TableCell>
                              </TableRow>
                            </TableHead>
                            <TableBody>
                              {borrows.map((record) => {
                                const status = borrowStatus(record);
                                return (
                                  <TableRow key={record.id} hover>
                                    <TableCell>
                                      <Typography variant="body2" sx={{ fontWeight: 700 }}>{record.book?.title || record.book_id}</Typography>
                                      <Typography variant="caption" color="text.secondary" sx={{ fontFamily: "monospace" }}>{record.book?.isbn || ""}</Typography>
                                    </TableCell>
                                    <TableCell>{formatDate(record.borrow_at)}</TableCell>
                                    <TableCell sx={{ color: status.color === "error" ? "error.main" : "inherit", fontWeight: status.color === "error" ? 800 : 400 }}>
                                      {formatDate(record.due_at)}
                                    </TableCell>
                                    <TableCell>{formatDate(record.return_at)}</TableCell>
                                    <TableCell><Chip size="small" color={status.color} label={status.label} /></TableCell>
                                  </TableRow>
                                );
                              })}
                            </TableBody>
                          </Table>
                        </TableContainer>
                      )}
                    </Box>
                  )}

                  {/* Tab 2: Access logs */}
                  {tab === 2 && (
                    <Box>
                      {logs.length === 0 ? (
                        <Alert severity="info" sx={{ m: 2 }}>Chưa có lịch sử ra/vào.</Alert>
                      ) : (
                        <>
                          <TableContainer sx={{ overflowX: "auto" }}>
                            <Table sx={{ minWidth: 700 }} size="small">
                              <TableHead>
                                <TableRow>
                                  <TableCell>Thời gian</TableCell>
                                  <TableCell>Loại</TableCell>
                                  <TableCell>Cổng</TableCell>
                                  <TableCell>Phương thức</TableCell>
                                  <TableCell>Độ tin cậy</TableCell>
                                  <TableCell>Kết quả</TableCell>
                                </TableRow>
                              </TableHead>
                              <TableBody>
                                {logs.map((log) => {
                                  const confidence = log.confidence == null ? null : Math.round(log.confidence * 100);
                                  return (
                                    <TableRow key={log.id} hover>
                                      <TableCell sx={{ whiteSpace: "nowrap" }}>{formatDateTime(log.access_time)}</TableCell>
                                      <TableCell>
                                        <Chip size="small" color={log.access_type === "entry" ? "success" : "warning"} label={log.access_type === "entry" ? "Vào" : "Ra"} />
                                      </TableCell>
                                      <TableCell>{CAMERA_LABELS[log.camera_id] || log.camera_id}</TableCell>
                                      <TableCell>{log.verify_method}</TableCell>
                                      <TableCell sx={{ minWidth: 120 }}>
                                        {confidence == null ? (
                                          <Typography color="text.secondary">-</Typography>
                                        ) : (
                                          <Stack direction="row" spacing={1} sx={{ alignItems: "center" }}>
                                            <LinearProgress
                                              variant="determinate"
                                              value={confidence}
                                              color={confidence >= 80 ? "success" : confidence >= 60 ? "warning" : "error"}
                                              sx={{ width: 60, height: 6, borderRadius: 99 }}
                                            />
                                            <Typography variant="caption" color="text.secondary">{confidence}%</Typography>
                                          </Stack>
                                        )}
                                      </TableCell>
                                      <TableCell>
                                        <Chip size="small" color={["success", "granted"].includes(log.status) ? "success" : "error"} label={["success", "granted"].includes(log.status) ? "Thành công" : "Thất bại"} />
                                      </TableCell>
                                    </TableRow>
                                  );
                                })}
                              </TableBody>
                            </Table>
                          </TableContainer>
                          {logsTotal > logsLimit && (
                            <Stack direction="row" spacing={1} sx={{ p: 2, alignItems: "center", justifyContent: "space-between" }}>
                              <Typography color="text.secondary">Tổng: {logsTotal}</Typography>
                              <Stack direction="row" spacing={1} sx={{ alignItems: "center" }}>
                                <Button variant="outlined" size="small" disabled={logsCurrentPage <= 1} onClick={() => setLogsSkip(0)}>Đầu</Button>
                                <Typography color="text.secondary" variant="body2">Trang {logsCurrentPage}/{logsPageCount}</Typography>
                                <Button variant="outlined" size="small" disabled={logsCurrentPage >= logsPageCount} onClick={() => setLogsSkip((logsPageCount - 1) * logsLimit)}>Cuối</Button>
                              </Stack>
                            </Stack>
                          )}
                        </>
                      )}
                    </Box>
                  )}
                </DashboardCard>
              </Stack>
            </Grid>
          </Grid>

          {/* Face enrollment dialog */}
          <Dialog open={showEnroll} onClose={() => { setShowEnroll(false); setEnrollError(""); setConsent(false); }} fullWidth maxWidth="md">
            <DialogTitle sx={{ m: 0, px: 3, py: 2 }}>
              <Stack direction="row" spacing={1.5} sx={{ alignItems: "center" }}>
                <Avatar sx={{ bgcolor: "primary.main", width: 44, height: 44 }}>
                  <FaceRetouchingNaturalOutlinedIcon />
                </Avatar>
                <Box sx={{ flex: 1, minWidth: 0 }}>
                  <Typography variant="h6" sx={{ fontWeight: 800, lineHeight: 1.25 }}>
                    {patron.has_face ? "Cập nhật khuôn mặt" : "Đăng ký khuôn mặt 4 góc"}
                  </Typography>
                  <Typography variant="body2" color="text.secondary">
                    {patron.full_name} · MSSV {patron.student_code} · Chụp đủ các góc để tăng độ chính xác khi nhận diện
                  </Typography>
                </Box>
                <IconButton aria-label="Đóng" onClick={() => { setShowEnroll(false); setEnrollError(""); setConsent(false); }}>
                  <CloseIcon />
                </IconButton>
              </Stack>
            </DialogTitle>
            <DialogContent dividers sx={{ px: 3, py: 2.5 }}>
              <MultiAngleCapture consent={consent} setConsent={setConsent} onFilesReady={handleEnroll} />
              {enrollError && <Alert severity="error" sx={{ mt: 2 }}>{enrollError}</Alert>}
              {enrollLoading && <Alert severity="info" sx={{ mt: 2 }}>Đang xử lý khuôn mặt trên máy chủ, vui lòng chờ...</Alert>}
            </DialogContent>
          </Dialog>

          {/* Edit dialog */}
          <Dialog open={showEdit} onClose={() => setShowEdit(false)} fullWidth maxWidth="sm">
            <DialogTitle>Sửa độc giả</DialogTitle>
            <DialogContent>
              <Stack spacing={2} sx={{ pt: 1 }}>
                <TextField label="Họ tên" value={editForm.full_name || ""} onChange={(e) => setEditForm({ ...editForm, full_name: e.target.value })} fullWidth />
                <TextField label="Lớp" value={editForm.class_name || ""} onChange={(e) => setEditForm({ ...editForm, class_name: e.target.value })} fullWidth />
                <TextField label="Khóa học" value={editForm.course || ""} onChange={(e) => setEditForm({ ...editForm, course: e.target.value })} fullWidth />
                <TextField label="CCCD/CMND" value={editForm.identity_number || ""} onChange={(e) => setEditForm({ ...editForm, identity_number: e.target.value })} fullWidth />
                <TextField label="Email" value={editForm.email || ""} onChange={(e) => setEditForm({ ...editForm, email: e.target.value })} fullWidth />
                <TextField label="Số điện thoại" value={editForm.phone || ""} onChange={(e) => setEditForm({ ...editForm, phone: e.target.value })} fullWidth />
                <TextField label="Hạn thẻ" type="date" value={editForm.membership_expiry || ""} onChange={(e) => setEditForm({ ...editForm, membership_expiry: e.target.value })} fullWidth slotProps={{ inputLabel: { shrink: true } }} />
                <TextField select label="Trạng thái" value={editForm.status || "active"} onChange={(e) => setEditForm({ ...editForm, status: e.target.value })} fullWidth>
                  <MenuItem value="active">Đang hoạt động</MenuItem>
                  <MenuItem value="inactive">Tạm khóa</MenuItem>
                </TextField>
              </Stack>
            </DialogContent>
            <DialogActions>
              <Button onClick={() => setShowEdit(false)}>Hủy</Button>
              <Button variant="contained" onClick={handleEdit}>Lưu</Button>
            </DialogActions>
          </Dialog>

          {/* Delete dialog */}
          <Dialog open={showDelete} onClose={() => { setShowDelete(false); setDeleteConfirmText(""); }} fullWidth maxWidth="xs">
            <DialogTitle>Xóa độc giả?</DialogTitle>
            <DialogContent>
              <Stack spacing={2}>
                <Typography color="text.secondary">
                  Hồ sơ <strong>{patron.full_name}</strong> sẽ bị xóa khỏi danh sách độc giả.
                </Typography>
                <Typography variant="body2" color="text.secondary">
                  Nhập <strong>XÓA</strong> để xác nhận:
                </Typography>
                <TextField value={deleteConfirmText} onChange={(e) => setDeleteConfirmText(e.target.value)} placeholder="Nhập XÓA" size="small" autoFocus fullWidth />
              </Stack>
            </DialogContent>
            <DialogActions>
              <Button onClick={() => { setShowDelete(false); setDeleteConfirmText(""); }}>Hủy</Button>
              <Button color="error" variant="contained" onClick={handleDelete} disabled={deleteConfirmText !== "XÓA"}>Xóa vĩnh viễn</Button>
            </DialogActions>
          </Dialog>

          {/* Restore dialog */}
          <Dialog open={showRestore} onClose={() => { setShowRestore(false); setRestoreConfirmText(""); }} fullWidth maxWidth="xs">
            <DialogTitle>Khôi phục độc giả?</DialogTitle>
            <DialogContent>
              <Stack spacing={2}>
                <Typography color="text.secondary">
                  Khôi phục hồ sơ <strong>{patron.full_name}</strong>? Nếu thẻ đã hết hạn, hạn thẻ sẽ được tự động gia hạn 1 năm.
                </Typography>
                <Typography variant="body2" color="text.secondary">
                  Nhập <strong>KHÔI PHỤC</strong> để xác nhận:
                </Typography>
                <TextField value={restoreConfirmText} onChange={(e) => setRestoreConfirmText(e.target.value)} placeholder="Nhập KHÔI PHỤC" size="small" autoFocus fullWidth />
              </Stack>
            </DialogContent>
            <DialogActions>
              <Button onClick={() => { setShowRestore(false); setRestoreConfirmText(""); }}>Hủy</Button>
              <Button color="success" variant="contained" onClick={handleRestore} disabled={restoreConfirmText !== "KHÔI PHỤC"}>Khôi phục</Button>
            </DialogActions>
          </Dialog>
        </Stack>
      )}
    </LoadingOverlay>
  );
}
</file>

