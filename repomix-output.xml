│   │   │   └── HoldButton.tsx
│   │   ├── (dashboard)/         # Protected dashboard routes
│   │   │   ├── _components/     # Dashboard-specific components (sidebar, AI widget, stat cards, tables)
│   │   │   ├── dashboard/       # Overview, admin panel
│   │   │   ├── borrow/          # Mượn sách
│   │   │   ├── return/          # Trả sách
│   │   │   ├── books/           # Danh mục sách, chi tiết sách
