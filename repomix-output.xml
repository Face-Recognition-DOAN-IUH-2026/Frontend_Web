"use client";

import { useCallback, useEffect, useRef, useState } from "react";
import { useSearchParams, useRouter } from "next/navigation";
import {
  Alert,
  Box,
  Button,
  Checkbox,
  FormControlLabel,
  LinearProgress,
  Paper,
  Stack,
  TextField,
  Typography,
} from "@mui/material";
import ArrowBackIcon from "@mui/icons-material/ArrowBackOutlined";
import CheckCircleOutlineOutlinedIcon from "@mui/icons-material/CheckCircleOutlineOutlined";
import ErrorOutlineOutlinedIcon from "@mui/icons-material/ErrorOutlineOutlined";
import FaceIcon from "@mui/icons-material/FaceOutlined";
import RestartAltOutlinedIcon from "@mui/icons-material/RestartAltOutlined";
import VerifiedUserOutlinedIcon from "@mui/icons-material/VerifiedUserOutlined";
import VideocamIcon from "@mui/icons-material/VideocamOutlined";
import CircularProgress from "@mui/material/CircularProgress";
import CameraCapture from "@/components/camera-capture";
import JobPoll from "@/components/job-poll";
import { useAuth } from "@/lib/auth-context";
import api, { getErrorMessage } from "@/lib/api-client";
import type { TaskResult } from "@/lib/types";

function decodeJwt(token: string): { sub: string } | null {
  try {
    const base64Url = token.split(".")[1];
    const base64 = base64Url.replace(/-/g, "+").replace(/_/g, "/");
    const jsonPayload = decodeURIComponent(
      atob(base64)
        .split("")
        .map((c) => `%${(`00${c.charCodeAt(0).toString(16)}`).slice(-2)}`)
        .join("")
    );
    return JSON.parse(jsonPayload);
  } catch {
    return null;
  }
}

function BorrowVerifyFlow({ studentCode, onDone }: { studentCode: string; onDone: () => void }) {
  const router = useRouter();
  const videoRef = useRef<HTMLVideoElement>(null);
  const streamRef = useRef<MediaStream | null>(null);
  const [cameraReady, setCameraReady] = useState(false);
  const [cameraError, setCameraError] = useState("");
  const [verifying, setVerifying] = useState(false);
  const [error, setError] = useState("");
  const [success, setSuccess] = useState(false);

  const stopCamera = useCallback(() => {
    if (streamRef.current) {
      streamRef.current.getTracks().forEach((t) => t.stop());
      streamRef.current = null;
    }
    setCameraReady(false);
  }, []);

  useEffect(() => {
    (async () => {
      try {
        const stream = await navigator.mediaDevices.getUserMedia({
          video: { facingMode: "user", width: { ideal: 640 }, height: { ideal: 480 } },
          audio: false,
        });
        streamRef.current = stream;
        if (videoRef.current) {
          videoRef.current.srcObject = stream;
          videoRef.current.onloadedmetadata = () => setCameraReady(true);
        }
      } catch (err: any) {
        if (err.name === "NotAllowedError") setCameraError("Không có quyền truy cập camera.");
        else if (err.name === "NotFoundError") setCameraError("Không tìm thấy camera.");
        else setCameraError("Không thể khởi động camera.");
      }
    })();
    return () => stopCamera();
  }, [stopCamera]);

  const handleVerify = useCallback(async () => {
    if (!videoRef.current) return;
    setVerifying(true);
    setError("");

    try {
      const video = videoRef.current;
      const canvas = document.createElement("canvas");
      canvas.width = video.videoWidth;
      canvas.height = video.videoHeight;
      const ctx = canvas.getContext("2d");
      if (!ctx) { setError("Canvas context error"); setVerifying(false); return; }
      ctx.translate(canvas.width, 0);
      ctx.scale(-1, 1);
      ctx.drawImage(video, 0, 0, canvas.width, canvas.height);

      const blob = await new Promise<Blob>((resolve, reject) => {
        canvas.toBlob((b) => { if (b) resolve(b); else reject(new Error("toBlob failed")); }, "image/jpeg", 0.85);
      });
      const file = new File([blob], "capture.jpg", { type: "image/jpeg" });

      const lookupResult = await api.lookupPatron(studentCode);
      if (!lookupResult.exists || !lookupResult.patron) {
        setError("Không tìm thấy độc giả"); setVerifying(false); return;
      }
      if (lookupResult.is_expired) {
        setError("Thẻ độc giả đã hết hạn"); setVerifying(false); return;
      }
      if (lookupResult.is_locked) {
        setError("Thẻ độc giả đã bị khóa"); setVerifying(false); return;
      }

      const verifyResult = await api.verifyFace(file, lookupResult.patron.id, true);

      let attempts = 0;
      const maxAttempts = 30;
      while (attempts < maxAttempts) {
        await new Promise((r) => setTimeout(r, 1000));
        const taskStatus = await api.getTaskStatus(verifyResult.job_id);
        if (taskStatus.status === "SUCCESS" && taskStatus.result) {
          if (taskStatus.result.verified) {
            try {
              const data = await api.getActiveBorrowsByStudentCode(studentCode);
              stopCamera();
              sessionStorage.setItem("verifiedPatron", JSON.stringify({
                student_code: studentCode,
                patron_id: data.patron.id,
                full_name: data.patron.full_name || data.patron.student_code,
                total: data.total,
                overdue_count: data.overdue_count,
              }));
              setSuccess(true);
              setTimeout(() => router.push("/borrow"), 1000);
              return;
            } catch (err: any) {
              const status = err?.response?.status || err?.status;
              if (status === 403) {
                setError("Độc giả chưa ở trong thư viện hoặc thẻ đã bị khóa.");
              } else {
                setError(getErrorMessage(err) || "Không thể kiểm tra thông tin độc giả");
              }
              setVerifying(false);
              return;
            }
          }
          setError("Khuôn mặt không khớp với độc giả này");
          setVerifying(false);
          return;
        }
        if (taskStatus.status === "FAILURE" || taskStatus.status === "ERROR") {
          setError(taskStatus.result?.error || taskStatus.result?.detail || "Xác minh thất bại");
          setVerifying(false);
          return;
        }
        attempts++;
      }
      setError("Hết thời gian chờ xác minh");
      setVerifying(false);
    } catch (err) {
      setError(getErrorMessage(err) || "Lỗi xác minh khuôn mặt");
      setVerifying(false);
    }
  }, [studentCode, stopCamera, router]);

  return (
    <Paper variant="outlined" sx={{ p: 3, maxWidth: 500, mx: "auto" }}>
      <Stack spacing={2.5} sx={{ alignItems: "center" }}>
        <VideocamIcon color="primary" sx={{ fontSize: 48 }} />
        <Typography variant="h5" sx={{ fontWeight: 900 }}>Xác minh khuôn mặt</Typography>
        <Typography variant="body2" color="text.secondary" sx={{ textAlign: "center" }}>
          Độc giả: <strong>{studentCode}</strong>
        </Typography>

        {error && <Alert severity="error" sx={{ width: "100%" }} onClose={() => setError("")}>{error}</Alert>}

        {success ? (
          <Stack spacing={2} sx={{ alignItems: "center", py: 4 }}>
            <CircularProgress size={48} color="success" />
            <Typography variant="h6" color="success.main" sx={{ fontWeight: 900 }}>Xác minh thành công!</Typography>
            <Typography variant="body2" color="text.secondary">Đang chuyển về trang mượn sách...</Typography>
          </Stack>
        ) : (
          <Box sx={{ width: "100%", position: "relative", borderRadius: 1, overflow: "hidden", bgcolor: "black" }}>
            <video ref={videoRef} autoPlay playsInline muted style={{ width: "100%", height: "auto", display: "block", transform: "scaleX(-1)" }} />
            {!cameraReady && !cameraError && (
              <Stack sx={{ position: "absolute", inset: 0, bgcolor: "rgba(0,0,0,.55)", color: "common.white", alignItems: "center", justifyContent: "center" }} spacing={1}>
                <CircularProgress size={28} color="inherit" />
                <Typography variant="body2">Đang khởi động camera...</Typography>
              </Stack>
            )}
            {cameraError && (
              <Stack sx={{ position: "absolute", inset: 0, bgcolor: "rgba(0,0,0,.75)", color: "error.main", alignItems: "center", justifyContent: "center", p: 3 }} spacing={1}>
                <VideocamIcon sx={{ fontSize: 48 }} />
                <Typography variant="body2" sx={{ textAlign: "center" }}>{cameraError}</Typography>
                <Button size="small" variant="outlined" color="inherit" onClick={() => { setCameraError(""); streamRef.current = null; }}>
                  Thử lại
                </Button>
              </Stack>
            )}
            {verifying && cameraReady && (
              <Stack sx={{ position: "absolute", inset: 0, bgcolor: "rgba(0,0,0,.5)", alignItems: "center", justifyContent: "center" }} spacing={1}>
                <CircularProgress size={28} color="inherit" />
                <Typography variant="body2" sx={{ color: "common.white" }}>Đang xác minh...</Typography>
              </Stack>
            )}
          </Box>
        )}

        {!success && (
          <Stack direction="row" spacing={1.5} sx={{ width: "100%" }}>
            <Button variant="outlined" fullWidth startIcon={<ArrowBackIcon />} onClick={() => router.push("/borrow")} disabled={verifying}>
              Quay lại
            </Button>
            <Button variant="contained" fullWidth startIcon={verifying ? undefined : <FaceIcon />} onClick={handleVerify} disabled={verifying || !cameraReady || !!cameraError}>
              {verifying ? "Đang xác minh..." : "Xác minh ngay"}
            </Button>
          </Stack>
        )}
      </Stack>
    </Paper>
  );
}

export default function VerifyPage() {
  const searchParams = useSearchParams();
  const studentCode = searchParams.get("student_code") || "";
  const { accessToken } = useAuth();
  const [imageFile, setImageFile] = useState<File | null>(null);
  const [targetUserId, setTargetUserId] = useState("");
  const [consent, setConsent] = useState(false);
  const [isLoading, setIsLoading] = useState(false);
  const [jobId, setJobId] = useState<string | null>(null);
  const [error, setError] = useState("");
  const [result, setResult] = useState<TaskResult | null>(null);

  useEffect(() => {
    if (accessToken) {
      const payload = decodeJwt(accessToken);
      if (payload?.sub) setTargetUserId(payload.sub);
    }
  }, [accessToken]);

  const handleCapture = (file: File) => {
    setImageFile(file);
    setResult(null);
  };

  const handleSubmit = async (event: React.FormEvent) => {
    event.preventDefault();
    if (!imageFile || !targetUserId) return;
    setError("");
    setIsLoading(true);
    setJobId(null);
    try {
      const res = await api.verifyFace(imageFile, targetUserId, consent);
      setJobId(res.job_id);
    } catch (err: any) {
      setError(getErrorMessage(err) || "Xác thực thất bại.");
      setIsLoading(false);
    }
  };

  const reset = () => {
    setResult(null);
    setImageFile(null);
    setJobId(null);
    setError("");
    setIsLoading(false);
  };

  if (studentCode) {
    return (
      <Stack spacing={3} sx={{ maxWidth: 920, mx: "auto", py: 4 }}>
        <BorrowVerifyFlow studentCode={studentCode} onDone={() => {}} />
      </Stack>
    );
  }

  return (
    <Stack spacing={3} sx={{ maxWidth: 920, mx: "auto" }}>
      <Paper variant="outlined" sx={{ p: 3 }}>
        <Stack direction="row" spacing={1.5} sx={{ alignItems: "center" }}>
          <VerifiedUserOutlinedIcon color="primary" />
          <Box>
            <Typography variant="h4" sx={{ fontWeight: 850 }}>Xác thực khuôn mặt</Typography>
            <Typography color="text.secondary">So khớp ảnh hiện tại với hồ sơ khuôn mặt của một người dùng cụ thể.</Typography>
          </Box>
        </Stack>
      </Paper>

      {error && <Alert severity="error">{error}</Alert>}

      {jobId ? (
        <JobPoll
          jobId={jobId}
          onComplete={(value) => { setResult(value); setIsLoading(false); setJobId(null); }}
          onError={(message) => { setError(message); setIsLoading(false); setJobId(null); }}
        />
      ) : result ? (
        <Paper variant="outlined" sx={{ p: 3 }}>
          <Stack spacing={2}>
            <Stack direction="row" spacing={1.5} sx={{ alignItems: "center" }}>
              {result.verified ? <CheckCircleOutlineOutlinedIcon color="success" sx={{ fontSize: 44 }} /> : <ErrorOutlineOutlinedIcon color="error" sx={{ fontSize: 44 }} />}
              <Box>
                <Typography variant="h5" sx={{ fontWeight: 850 }}>
                  {result.verified ? "Xác thực thành công" : "Xác thực thất bại"}
                </Typography>
                {result.score != null && (
                  <Typography color="text.secondary">Độ tin cậy: {(Number(result.score) * 100).toFixed(1)}%</Typography>
                )}
              </Box>
            </Stack>
            {result.score != null && (
              <LinearProgress variant="determinate" value={Math.min(Number(result.score) * 100, 100)} color={result.verified ? "success" : "error"} sx={{ height: 8, borderRadius: 99 }} />
            )}
            {result.error && <Alert severity="error">{result.error}</Alert>}
            <Button startIcon={<RestartAltOutlinedIcon />} variant="outlined" onClick={reset} sx={{ alignSelf: "flex-start" }}>
              Thử lại
            </Button>
          </Stack>
        </Paper>
      ) : (
        <Paper variant="outlined" sx={{ p: 2.5 }}>
          <Box component="form" onSubmit={handleSubmit}>
            <Stack spacing={2.5}>
              <CameraCapture onCapture={handleCapture} />
              <TextField
                label="User ID"
                value={targetUserId}
                onChange={(event) => setTargetUserId(event.target.value)}
                placeholder="User ID cần xác thực"
                required
                fullWidth
              />
              <FormControlLabel
                control={<Checkbox checked={consent} onChange={(event) => setConsent(event.target.checked)} />}
                label="Tôi đồng ý cho hệ thống xử lý dữ liệu khuôn mặt để xác thực."
              />
              <Button type="submit" variant="contained" disabled={!imageFile || !targetUserId || !consent || isLoading} fullWidth>
                {isLoading ? "Đang gửi..." : "Xác thực khuôn mặt"}
              </Button>
            </Stack>
          </Box>
        </Paper>
      )}
    </Stack>
  );
}
</file>

<file path="src/components/library-2d/FloorTablePanel.tsx">
"use client";

import { useMemo, useState } from "react";
import type { ShelfData, BookData } from "./types";

interface FloorTablePanelProps {
  shelves: ShelfData[];
  onBookClick?: (book: BookData) => void;
  onFloorSelect?: (floor: string) => void;
}

const FACE_LABELS = ["Mặt trái", "Mặt phải"] as const;

function groupByFloor(shelves: ShelfData[]): Record<string, ShelfData[]> {
  const map: Record<string, ShelfData[]> = {};
  for (const s of shelves) {
    const f = s.floor || "A";
    if (!map[f]) map[f] = [];
    map[f].push(s);
  }
  for (const f of Object.keys(map)) {
    map[f].sort((a, b) => a.shelfNum - b.shelfNum);
  }
  return map;
}

export default function FloorTablePanel({ shelves, onBookClick, onFloorSelect }: FloorTablePanelProps) {
  const floorMap = useMemo(() => groupByFloor(shelves), [shelves]);
  const floors = useMemo(() => Object.keys(floorMap).sort(), [floorMap]);
  const [activeFloor, setActiveFloor] = useState(() => floors[0] || "A");

  const currentShelves = floorMap[activeFloor] || [];

  const handleFloorClick = (f: string) => {
    setActiveFloor(f);
    onFloorSelect?.(f);
  };

  return (
    <div
      className="absolute top-14 left-4 z-20 w-[520px] rounded-xl bg-surface/95 backdrop-blur-xl shadow-xl border border-primary/10 flex flex-col animate-fade-in"
      style={{ maxHeight: "calc(100vh - 80px)" }}
    >
      {/* Header */}
      <div className="shrink-0 px-4 pt-4 pb-3 border-b border-border">
        <h3 className="text-sm font-bold text-text flex items-center gap-1.5">
          <svg className="w-4 h-4 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth={2}>
            <path strokeLinecap="round" strokeLinejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
          </svg>
          Bảng chọn tầng
        </h3>

        {/* Floor tabs */}
        <div className="flex items-center gap-1.5 mt-3">
          {floors.map((f) => (
            <button
              key={f}
              onClick={() => handleFloorClick(f)}
              className={`px-3 py-1.5 rounded-lg text-xs font-semibold transition-all border ${
                activeFloor === f
                  ? "bg-primary text-white border-primary"
                  : "bg-surface-2 text-text-2 border-border hover:bg-surface-3"
              }`}
            >
              Tầng {f}
            </button>
          ))}
          <span className="ml-auto text-[10px] text-text-3">
            {currentShelves.length} kệ
          </span>
        </div>
      </div>

      {/* Table scroll area */}
      <div className="min-h-0 flex-1 overflow-y-auto overscroll-contain">
        <table className="w-full text-xs border-collapse">
          <thead className="sticky top-0 z-10">
            <tr className="bg-surface-2">
              <th className="px-3 py-2 text-left font-bold text-text-3 uppercase tracking-wider w-[60px]">Kệ</th>
              <th className="px-3 py-2 text-left font-bold text-text-3 uppercase tracking-wider w-[50px]">Tầng</th>
              <th className="px-3 py-2 text-left font-bold text-text-3 uppercase tracking-wider w-[70px]">Mặt</th>
              <th className="px-3 py-2 text-left font-bold text-text-3 uppercase tracking-wider">Sách</th>
            </tr>
          </thead>
          <tbody>
            {currentShelves.map((shelf) => {
              const tierMap = new Map<number, [BookData[], BookData[]]>();
              for (const book of shelf.books) {
                const t = book.tierIndex;
                if (!tierMap.has(t)) tierMap.set(t, [[], []]);
                tierMap.get(t)![book.face === 1 ? 1 : 0].push(book);
              }
              const tiers = Array.from(tierMap.entries()).sort(([a], [b]) => a - b);

              return tiers.flatMap(([tierIndex, faces], ti) =>
                faces.map((faceBooks, faceIdx) => {
                  const isFirst = ti === 0 && faceIdx === 0;
                  const isFirstFace = faceIdx === 0;
                  return (
                    <tr
                      key={`${shelf.id}-${tierIndex}-${faceIdx}`}
                      className={`border-t border-border hover:bg-primary/[0.04] transition ${
                        isFirst ? "border-t-2 border-t-primary/20" : ""
                      }`}
                    >
                      {isFirst && (
                        <td className="px-3 py-2 font-bold text-primary align-top" rowSpan={tiers.length * 2}>
                          {shelf.code}
                        </td>
                      )}
                      {isFirstFace && (
                        <td className="px-3 py-2 text-text-2 font-medium align-top" rowSpan={2}>
                          {tierIndex + 1}
                        </td>
                      )}
                      <td className="px-3 py-1.5 text-text-3 whitespace-nowrap">
                        {FACE_LABELS[faceIdx]}
                      </td>
                      <td className="px-3 py-1.5">
                        {faceBooks.length === 0 ? (
                          <span className="text-text-3 italic">Trống</span>
                        ) : (
                          <div className="flex flex-wrap gap-x-2 gap-y-0.5">
                            {faceBooks.map((book) => (
                              <button
                                key={book.id}
                                onClick={() => onBookClick?.(book)}
                                className="text-left group/row"
                              >
                                <span className="text-text group-hover/row:text-primary transition">
                                  {book.title}
                                </span>
                                <span className="text-text-3 ml-0.5">— {book.author}</span>
                                <span
                                  className={`ml-1 inline-block w-1.5 h-1.5 rounded-full align-middle ${
                                    book.status === "available" ? "bg-success" : "bg-error"
                                  }`}
                                />
                              </button>
                            ))}
                          </div>
                        )}
                      </td>
                    </tr>
                  );
                })
              );
            })}
          </tbody>
        </table>
      </div>
    </div>
  );
}
