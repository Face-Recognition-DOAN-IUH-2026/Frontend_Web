<file path="src/app/(dashboard)/_components/ui/AvatarUser.tsx">
"use client";

import { useState } from "react";
import { Avatar, Box, Stack, Typography, type SxProps, type Theme } from "@mui/material";
import { initials, stringToColor } from "@/lib/utils";

const ROLE_GRADIENT: Record<string, string> = {
  admin: "linear-gradient(135deg, #D4AF37 0%, #B89628 100%)",
  staff: "linear-gradient(135deg, #0A2540 0%, #0F3C5C 100%)",
  patron: "linear-gradient(135deg, #8B0000 0%, #700000 100%)",
};

export interface AvatarUserProps {
  user?: {
    full_name?: string | null;
    fullName?: string | null;
    name?: string | null;
    email?: string | null;
    avatar_url?: string | null;
    avatarUrl?: string | null;
    role?: string | null;
  } | null;
  name?: string | null;
  email?: string | null;
  avatarUrl?: string | null;
  role?: string | null;
  size?: number;
  showName?: boolean;
  showRole?: boolean;
  border?: boolean | string;
  sx?: SxProps<Theme>;
  className?: string;
  onClick?: () => void;
}

export default function AvatarUser({
  user,
  name,
  email,
  avatarUrl,
  role,
  size = 36,
  showName = false,
  showRole = false,
  border = false,
  sx,
  className,
  onClick,
}: AvatarUserProps) {
  const [imgError, setImgError] = useState(false);

  const displayName =
    user?.full_name ||
    user?.fullName ||
    user?.name ||
    name ||
    user?.email ||
    email?.split("@")[0] ||
    "User";

  const rawUrl = user?.avatar_url || user?.avatarUrl || avatarUrl;
  const effectiveAvatarUrl = imgError ? undefined : rawUrl || undefined;
  const effectiveRole = (user?.role || role || "").toLowerCase();

  const bgGradient = ROLE_GRADIENT[effectiveRole] || stringToColor(displayName);

  const borderStyle =
    typeof border === "string"
      ? border
      : border
      ? "2px solid rgba(255,255,255,0.85)"
      : "none";

  const avatarNode = (
    <Avatar
      src={effectiveAvatarUrl}
      slotProps={{
        img: {
          onError: () => setImgError(true),
        },
      }}
      className={className}
      onClick={onClick}
      sx={{
        width: size,
        height: size,
        background: effectiveAvatarUrl ? "transparent" : bgGradient,
        color: "#ffffff",
        fontWeight: 750,
        fontSize: Math.max(10, Math.round(size * 0.38)),
        boxShadow: "0 2px 6px rgba(0,0,0,0.12)",
        border: borderStyle,
        flexShrink: 0,
        cursor: onClick ? "pointer" : "inherit",
        ...sx,
      }}
    >
      {initials(displayName)}
    </Avatar>
  );

  if (!showName) {
    return avatarNode;
  }

  return (
    <Stack direction="row" spacing={1.25} sx={{ alignItems: "center", minWidth: 0 }}>
      {avatarNode}
      <Box sx={{ minWidth: 0, flex: 1 }}>
        <Typography variant="body2" sx={{ fontWeight: 700, lineHeight: 1.3 }} noWrap>
          {displayName}
        </Typography>
        {showRole && effectiveRole ? (
          <Typography
            variant="caption"
            color="text.secondary"
            sx={{ textTransform: "capitalize", display: "block" }}
            noWrap
          >
            {effectiveRole === "admin"
              ? "Quản trị viên"
              : effectiveRole === "staff"
              ? "Nhân viên"
              : "Độc giả"}
          </Typography>
        ) : email || user?.email ? (
          <Typography variant="caption" color="text.secondary" sx={{ display: "block" }} noWrap>
            {email || user?.email}
          </Typography>
        ) : null}
      </Box>
    </Stack>
  );
}
</file>

<file path="src/app/(dashboard)/_components/ui/DataTable.tsx">
import { ReactNode } from "react";
import Table from "antd/es/table";
import type { ColumnsType, TablePaginationConfig } from "antd/es/table";
import EmptyState from "./EmptyState";

export interface DataTableColumn<T = any> {
  key: string;
  label: string;
  sortable?: boolean;
  align?: "left" | "center" | "right";
  width?: number | string;
  fixed?: "left" | "right";
  filterOptions?: { text: string; value: string }[];
  render?: (value: any, row: T, index: number) => ReactNode;
}

interface DataTableProps<T = any> {
  columns: DataTableColumn<T>[];
  rows: T[];
  loading?: boolean;
  emptyTitle?: string;
  emptyDescription?: string;
  page?: number;
  rowsPerPage?: number;
  totalCount?: number;
  onPageChange?: (page: number) => void;
  onRowsPerPageChange?: (rowsPerPage: number) => void;
  onRowClick?: (row: T) => void;
  getRowId?: (row: T) => string | number;
  scrollX?: number | string;
}

export default function DataTable<T extends Record<string, any>>({
  columns,
  rows,
  loading = false,
  emptyTitle = "Không có dữ liệu",
  emptyDescription,
  page = 0,
  rowsPerPage = 10,
  totalCount,
  onPageChange,
  onRowsPerPageChange,
  onRowClick,
  getRowId,
  scrollX,
}: DataTableProps<T>) {
  const antdColumns: ColumnsType<T> = columns.map((col) => {
    const colDef: ColumnsType<T>[number] = {
      key: col.key,
      dataIndex: col.key,
      title: col.label,
      align: col.align || "left",
      width: col.width,
      fixed: col.fixed,
      sorter: col.sortable ? (a: T, b: T) => {
        const av = a[col.key];
        const bv = b[col.key];
        if (av == null && bv == null) return 0;
        if (av == null) return -1;
        if (bv == null) return 1;
        if (typeof av === "number" && typeof bv === "number") return av - bv;
        return String(av).localeCompare(String(bv));
      } : undefined,
      render: col.render
        ? (value: any, row: T, index: number) => col.render!(value, row, index)
        : (value: any) => value ?? "-",
    };

    if (col.filterOptions) {
      colDef.filters = col.filterOptions.map((o) => ({ text: o.text, value: o.value }));
      colDef.onFilter = (value: any, record: T) => String(record[col.key]) === String(value);
    }

    return colDef;
  });

  const pagination: TablePaginationConfig | false = totalCount !== undefined && onPageChange
    ? {
        current: page + 1,
        pageSize: rowsPerPage,
        total: totalCount,
        showSizeChanger: true,
        pageSizeOptions: ["10", "20", "50", "100"],
        showTotal: (total, range) => `${range[0]}-${range[1]} / ${total}`,
        onChange: (p: number, ps: number) => {
          // antd bắn onChange cho cả 2 hành động:
          // - chuyển trang (pageSize giữ nguyên) -> chỉ báo đổi trang
          // - đổi pageSize (kèm reset trang) -> chỉ báo đổi size, parent tự về trang đầu
          if (ps && ps !== rowsPerPage) {
            onRowsPerPageChange?.(ps);
          } else {
            onPageChange(p - 1);
          }
        },
      }
    : false;

  if (!loading && rows.length === 0) {
    return <EmptyState title={emptyTitle} description={emptyDescription} />;
  }

  return (
    <Table<T>
      columns={antdColumns}
      dataSource={rows}
      rowKey={getRowId ? (row: T) => getRowId(row) : undefined}
      loading={loading}
      size="small"
      pagination={pagination}
      scroll={scrollX ? { x: scrollX } : undefined}
      onRow={onRowClick ? (record: T) => ({ onClick: () => onRowClick(record), style: { cursor: "pointer" } }) : undefined}
    />
  );
}
</file>

