  it("renders failure state with error message", async () => {
    mockApi.getTaskStatus
      .mockResolvedValueOnce({
        task_id: "fail-task",
        status: "PENDING",
        result: null,
      })
      .mockResolvedValueOnce({
        task_id: "fail-task",
        status: "FAILURE",
