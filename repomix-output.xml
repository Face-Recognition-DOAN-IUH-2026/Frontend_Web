<file path="src/app/login/page.tsx">
"use client";

import { useCallback, useEffect, useRef, useState } from "react";
import { useRouter } from "next/navigation";
import {
  Alert,
  Box,
  Button,
  CircularProgress,
  Dialog,
  DialogContent,
  IconButton,
  InputAdornment,
  Paper,
  Stack,
  TextField,
  ToggleButton,
  ToggleButtonGroup,
  Typography,
  useTheme,
} from "@mui/material";
import VisibilityIcon from "@mui/icons-material/Visibility";
import VisibilityOffIcon from "@mui/icons-material/VisibilityOff";
import CloseIcon from "@mui/icons-material/Close";
import AutoStoriesOutlinedIcon from "@mui/icons-material/AutoStoriesOutlined";
import CheckCircleOutlineOutlinedIcon from "@mui/icons-material/CheckCircleOutlineOutlined";
import FaceRetouchingNaturalOutlinedIcon from "@mui/icons-material/FaceRetouchingNaturalOutlined";
import LoginOutlinedIcon from "@mui/icons-material/LoginOutlined";
import PhotoCameraOutlinedIcon from "@mui/icons-material/PhotoCameraOutlined";
import StopCircleOutlinedIcon from "@mui/icons-material/StopCircleOutlined";
import { useAuth } from "@/lib/auth-context";
import api, { getErrorMessage } from "@/lib/api-client";
import dynamic from "next/dynamic";
const LoginBackground3D = dynamic(() => import("@/components/LoginBackground3D"), { ssr: false });

type LoginMode = "password" | "face";

export default function LoginPage() {
  const theme = useTheme();
  const { login, setAuthFromToken } = useAuth();
  const router = useRouter();
  const [mode, setMode] = useState<LoginMode>("password");
  const [email, setEmail] = useState("");
  const [password, setPassword] = useState("");
  const [showPassword, setShowPassword] = useState(false);
  const [error, setError] = useState("");
  const [isLoading, setIsLoading] = useState(false);
  const [imagePreview, setImagePreview] = useState<string | null>(null);
  const [isCameraOn, setIsCameraOn] = useState(false);
  const [cameraReady, setCameraReady] = useState(false);
  const [success, setSuccess] = useState(false);

  const [forgotOpen, setForgotOpen] = useState(false);
  const [forgotStep, setForgotStep] = useState<1 | 2 | 3 | 4>(1);
  const [forgotEmail, setForgotEmail] = useState("");
  const [forgotCode, setForgotCode] = useState("");
  const [forgotPassword, setForgotPassword] = useState("");
  const [forgotConfirmPassword, setForgotConfirmPassword] = useState("");
  const [forgotLoading, setForgotLoading] = useState(false);
  const [forgotError, setForgotError] = useState("");
  const [showForgotPassword, setShowForgotPassword] = useState(false);
  const faceFailCountRef = useRef(0);
  const videoRef = useRef<HTMLVideoElement>(null);
  const streamRef = useRef<MediaStream | null>(null);
  const readyTimeoutRef = useRef<ReturnType<typeof setTimeout> | null>(null);
  const autoCaptureTimeoutRef = useRef<ReturnType<typeof setTimeout> | null>(null);

  const stopCamera = useCallback(() => {
    if (streamRef.current) {
      streamRef.current.getTracks().forEach((track) => track.stop());
      streamRef.current = null;
    }
    setIsCameraOn(false);
    setCameraReady(false);
  }, []);

  const resetFaceState = () => {
    setImagePreview(null);
  };

  const startCamera = useCallback(async () => {
    try {
      setError("");
      setCameraReady(false);
      stopCamera();
      const stream = await navigator.mediaDevices.getUserMedia({
        video: { facingMode: "user", width: { ideal: 640 }, height: { ideal: 480 } },
        audio: false,
      });
      streamRef.current = stream;
      setIsCameraOn(true);
    } catch (err: any) {
      if (err.name === "NotAllowedError") setError("Không có quyền truy cập camera. Hãy cấp quyền camera rồi thử lại.");
      else if (err.name === "NotFoundError") setError("Không tìm thấy camera trên thiết bị.");
      else setError("Không thể truy cập camera.");
      setIsCameraOn(false);
    }
  }, [stopCamera]);

  useEffect(() => {
    if (!isCameraOn || !videoRef.current || !streamRef.current) return;
    const video = videoRef.current;
    const onReady = () => setCameraReady(true);
    video.onloadedmetadata = onReady;
    video.onplaying = onReady;
    video.onerror = () => setError("Camera gặp lỗi.");
    video.srcObject = streamRef.current;
    if (video.readyState >= 2) onReady();
    readyTimeoutRef.current = setTimeout(() => setCameraReady(true), 3000);
    return () => {
      if (readyTimeoutRef.current) clearTimeout(readyTimeoutRef.current);
      if (autoCaptureTimeoutRef.current) clearTimeout(autoCaptureTimeoutRef.current);
      video.onloadedmetadata = null;
      video.onplaying = null;
      video.onerror = null;
      video.srcObject = null;
    };
  }, [isCameraOn]);

  useEffect(() => () => stopCamera(), [stopCamera]);

  const doFaceLogin = useCallback(async (file: File) => {
    setError("");
    setIsLoading(true);
    try {
      const res = await api.faceLogin(file);
      if (!res.access_token) throw new Error("Backend did not return access_token");
      const payload = JSON.parse(atob(res.access_token.split(".")[1]));
      const userEmail = payload?.email || "";
      const role = ((payload?.roles as string[])?.[0]) || "user";
      setAuthFromToken(res.access_token, res.refresh_token, userEmail, role);
      setSuccess(true);
      setIsLoading(false);
      faceFailCountRef.current = 0;
      setTimeout(() => { window.location.href = "/dashboard"; }, 500);
    } catch (err: any) {
      const msg = getErrorMessage(err) || "Đăng nhập thất bại.";
      setError(msg);
      setIsLoading(false);
      const newCount = faceFailCountRef.current + 1;
      faceFailCountRef.current = newCount;
      if (newCount >= 2) {
        setMode("password");
        faceFailCountRef.current = 0;
        resetFaceState();
        stopCamera();
        setError(`${msg} Chuyển sang đăng nhập bằng mật khẩu.`);
      } else {
        resetFaceState();
        startCamera();
      }
    }
  }, [router, setAuthFromToken, startCamera, stopCamera]);

  const capturePhoto = useCallback((callback?: (file: File) => void) => {
    const video = videoRef.current;
    if (!video || !cameraReady || video.videoWidth === 0 || video.videoHeight === 0) return;
    const canvas = document.createElement("canvas");
    canvas.width = video.videoWidth;
    canvas.height = video.videoHeight;
    const ctx = canvas.getContext("2d");
    if (!ctx) return;
    ctx.drawImage(video, 0, 0);
    canvas.toBlob((blob) => {
      if (!blob) return;
      const file = new File([blob], "face.jpg", { type: "image/jpeg" });
      setImagePreview(canvas.toDataURL("image/jpeg"));
      callback?.(file);
    }, "image/jpeg", 0.9);
  }, [cameraReady]);

  const autoCapture = useCallback(() => {
    capturePhoto((file) => {
      stopCamera();
      doFaceLogin(file);
    });
  }, [capturePhoto, doFaceLogin, stopCamera]);

  useEffect(() => {
    if (cameraReady && mode === "face" && !imagePreview && !isLoading) {
      autoCaptureTimeoutRef.current = setTimeout(autoCapture, 1500);
    }
    return () => {
      if (autoCaptureTimeoutRef.current) clearTimeout(autoCaptureTimeoutRef.current);
    };
  }, [cameraReady, mode, imagePreview, isLoading, autoCapture]);

  const handlePasswordSubmit = async (event: React.FormEvent) => {
    event.preventDefault();
    setError("");
    setIsLoading(true);
    try {
      await login(email, password);
      window.location.href = "/dashboard";
    } catch (err: any) {
      setError(getErrorMessage(err) || "Đăng nhập thất bại.");
    } finally {
      setIsLoading(false);
    }
  };

  const switchMode = (_event: React.MouseEvent<HTMLElement>, value: LoginMode | null) => {
    if (!value) return;
    setMode(value);
    setError("");
    resetFaceState();
    faceFailCountRef.current = 0;
    if (value === "password") stopCamera();
  };

  const handleForgotSendCode = async () => {
    if (!forgotEmail) {
      setForgotError("Vui lòng nhập email");
      return;
    }
    setForgotLoading(true);
    setForgotError("");
    try {
      await api.client.post("/auth/forgot-password", { email: forgotEmail });
      setForgotStep(2);
    } catch (err: any) {
      setForgotError(getErrorMessage(err) || "Không thể gửi mã reset");
    } finally {
      setForgotLoading(false);
    }
  };

  const handleVerifyCode = async () => {
    if (!forgotCode || forgotCode.length !== 6) {
      setForgotError("Vui lòng nhập đầy đủ 6 chữ số mã xác minh");
      return;
    }
    setForgotLoading(true);
    setForgotError("");
    try {
      await api.client.post("/auth/verify-reset-code", { email: forgotEmail, code: forgotCode });
      setForgotStep(3);
    } catch (err: any) {
      setForgotError(getErrorMessage(err) || "Mã xác minh không hợp lệ");
    } finally {
      setForgotLoading(false);
    }
  };

  const handleForgotReset = async () => {
    if (!forgotPassword || !forgotConfirmPassword) {
      setForgotError("Vui lòng nhập mật khẩu mới");
      return;
    }
    if (forgotPassword !== forgotConfirmPassword) {
      setForgotError("Mật khẩu mới không khớp");
      return;
    }
    if (forgotPassword.length < 6) {
      setForgotError("Mật khẩu phải ít nhất 6 ký tự");
      return;
    }
    setForgotLoading(true);
    setForgotError("");
    try {
      await api.client.post("/auth/reset-password", {
        email: forgotEmail,
        code: forgotCode,
        new_password: forgotPassword,
      });
      setForgotStep(4);
    } catch (err: any) {
      setForgotError(getErrorMessage(err) || "Đặt lại mật khẩu thất bại");
    } finally {
      setForgotLoading(false);
    }
  };

  const closeForgotDialog = () => {
    setForgotOpen(false);
    setForgotStep(1);
    setForgotEmail("");
    setForgotCode("");
    setForgotPassword("");
    setForgotConfirmPassword("");
    setForgotError("");
    setShowForgotPassword(false);
  };

  return (
    <>
      <LoginBackground3D />
      <Box
        sx={{
          minHeight: "100vh",
          display: "grid",
          placeItems: "center",
          p: 2,
          position: "relative",
          zIndex: 1,
        }}
      >
      <Paper
        variant="outlined"
        sx={{
          width: "100%",
          maxWidth: 460,
          p: 4,
          background: `linear-gradient(180deg, ${theme.palette.background.paper}, ${theme.palette.background.default})`,
        }}
      >
        <Stack spacing={3}>
          <Stack spacing={1.25} sx={{ alignItems: "center", textAlign: "center" }}>
            <Box sx={{ width: 58, height: 58, borderRadius: 2, bgcolor: "primary.main", color: "primary.contrastText", display: "grid", placeItems: "center" }}>
              <AutoStoriesOutlinedIcon fontSize="large" />
            </Box>
            <Box>
              <Typography variant="h4" sx={{ fontWeight: 900, letterSpacing: 0 }}>THƯ VIỆN IUH</Typography>
              <Typography color="text.secondary">Đăng nhập vào hệ thống quản lý</Typography>
            </Box>
          </Stack>

          <ToggleButtonGroup value={mode} exclusive onChange={switchMode} fullWidth color="primary">
            <ToggleButton value="password">Mật khẩu</ToggleButton>
            <ToggleButton value="face">Khuôn mặt</ToggleButton>
          </ToggleButtonGroup>

          {error && <Alert severity="error">{error}</Alert>}

          {success ? (
            <Alert icon={<CheckCircleOutlineOutlinedIcon />} severity="success">
              Đăng nhập thành công. Đang chuyển hướng...
            </Alert>
          ) : isLoading ? (
            <Stack sx={{ py: 5, alignItems: "center" }} spacing={2}>
              <CircularProgress />
              <Typography color="text.secondary">{mode === "face" ? "Đang xác thực khuôn mặt..." : "Đang đăng nhập..."}</Typography>
            </Stack>
          ) : mode === "password" ? (
            <Box component="form" onSubmit={handlePasswordSubmit}>
              <Stack spacing={2}>
                <TextField label="Email" type="email" value={email} onChange={(event) => setEmail(event.target.value)} autoComplete="email" required fullWidth />
                <TextField label="Mật khẩu" type="password" value={password} onChange={(event) => setPassword(event.target.value)} autoComplete="current-password" required fullWidth />
                <Button type="submit" variant="contained" startIcon={<LoginOutlinedIcon />} size="large" fullWidth>
                  Đăng nhập
                </Button>
                <Typography variant="body2" sx={{ textAlign: "center" }}>
                  <Box
                    component="button"
                    type="button"
                    onClick={() => setForgotOpen(true)}
                    sx={{
                      border: "none",
                      bgcolor: "transparent",
                      color: "primary.main",
                      cursor: "pointer",
                      fontWeight: 600,
                      fontSize: "0.875rem",
                      textDecoration: "underline",
                      "&:hover": { color: "primary.dark" },
                    }}
                  >
                    Quên mật khẩu?
                  </Box>
                </Typography>
              </Stack>
            </Box>
          ) : (
            <Stack spacing={2}>
              <Paper
                variant="outlined"
                sx={{ aspectRatio: "16 / 9", overflow: "hidden", bgcolor: "black", display: "grid", placeItems: "center", position: "relative" }}
              >
                {imagePreview ? (
                  <Box component="img" src={imagePreview} alt="Ảnh khuôn mặt" sx={{ width: "100%", height: "100%", objectFit: "contain" }} />
                ) : isCameraOn ? (
                  <>
                    <Box component="video" ref={videoRef} autoPlay playsInline muted sx={{ width: "100%", height: "100%", objectFit: "contain" }} />
                    {!cameraReady && (
                      <Stack sx={{ position: "absolute", inset: 0, bgcolor: "rgba(0,0,0,.55)", color: "common.white", alignItems: "center", justifyContent: "center" }}>
                        <CircularProgress color="inherit" size={26} />
                        <Typography variant="body2" sx={{ mt: 1 }}>Đang kết nối camera...</Typography>
                      </Stack>
                    )}
                    {cameraReady && (
                      <Box sx={{ position: "absolute", width: 190, height: 190, border: 2, borderColor: "primary.main", borderRadius: "50%", opacity: 0.7 }} />
                    )}
                  </>
                ) : (
                  <Stack spacing={1} sx={{ alignItems: "center", color: "grey.300" }}>
                    <FaceRetouchingNaturalOutlinedIcon sx={{ fontSize: 42 }} />
                    <Typography>Bật camera để đăng nhập bằng khuôn mặt</Typography>
                  </Stack>
                )}
              </Paper>

              {imagePreview ? (
                <Button variant="outlined" onClick={() => { resetFaceState(); startCamera(); }}>
                  Chụp lại
                </Button>
              ) : !isCameraOn ? (
                <Button variant="contained" startIcon={<PhotoCameraOutlinedIcon />} onClick={startCamera}>
                  Bật camera
                </Button>
              ) : (
                <Button color="error" variant="outlined" startIcon={<StopCircleOutlinedIcon />} onClick={stopCamera}>
                  Tắt camera
                </Button>
              )}
            </Stack>
          )}
        </Stack>
      </Paper>

      <Dialog open={forgotOpen} onClose={closeForgotDialog} maxWidth="xs" fullWidth>
        <DialogContent sx={{ p: 3 }}>
          <Box sx={{ display: "flex", justifyContent: "space-between", alignItems: "center", mb: 1 }}>
            <Typography variant="h6" sx={{ fontWeight: 800 }}>
              {forgotStep === 4 ? "Thành công" : "Quên mật khẩu"}
            </Typography>
            <IconButton onClick={closeForgotDialog} size="small">
              <CloseIcon />
            </IconButton>
          </Box>

          {forgotStep < 4 && (
            <Box sx={{ display: "flex", justifyContent: "center", alignItems: "center", mb: 3, mt: 1 }}>
              {[1, 2, 3].map((s) => (
                <Box key={s} sx={{ display: "flex", alignItems: "center" }}>
                  <Box
                    sx={{
                      width: 32, height: 32, borderRadius: "50%",
                      display: "flex", alignItems: "center", justifyContent: "center",
                      fontSize: 14, fontWeight: 700,
                      bgcolor: forgotStep >= s ? "primary.main" : "action.hover",
                      color: forgotStep >= s ? "primary.contrastText" : "text.secondary",
                      transition: "all 0.3s ease",
                    }}
                  >
                    {forgotStep > s ? "✓" : s}
                  </Box>
                  {s < 3 && (
                    <Box sx={{
                      width: 40, height: 2, mx: 0.5,
                      bgcolor: forgotStep > s ? "primary.main" : "action.hover",
                      transition: "background-color 0.3s ease",
                    }} />
                  )}
                </Box>
              ))}
            </Box>
          )}

          {forgotError && (
            <Alert severity="error" sx={{ mb: 2 }}>{forgotError}</Alert>
          )}

          {forgotStep === 1 && (
            <Stack spacing={2}>
              <Typography variant="body2" color="text.secondary">
                Nhập email để nhận mã xác minh.
              </Typography>
              <TextField
                label="Email"
                type="email"
                value={forgotEmail}
                onChange={(e) => setForgotEmail(e.target.value)}
                fullWidth
                autoFocus
              />
              <Button
                variant="contained"
                onClick={handleForgotSendCode}
                disabled={forgotLoading}
                fullWidth
              >
                {forgotLoading ? "Đang gửi..." : "Gửi mã xác minh"}
              </Button>
            </Stack>
          )}

          {forgotStep === 2 && (
            <Stack spacing={2}>
              <Typography variant="body2" color="text.secondary">
                Nhập mã 6 chữ số đã gửi đến <strong>{forgotEmail}</strong>
              </Typography>
              <Box sx={{ display: "flex", gap: 1, justifyContent: "center" }}>
                {[0, 1, 2, 3, 4, 5].map((i) => (
                  <TextField
                    key={i}
                    id={`code-${i}`}
                    value={forgotCode[i] || ""}
                    onChange={(e) => {
                      const val = e.target.value.replace(/\D/g, "");
                      if (val.length > 1) return;
                      const newCode = forgotCode.split("");
                      newCode[i] = val;
                      const code = newCode.join("").slice(0, 6);
                      setForgotCode(code);
                      if (val && i < 5) {
                        setTimeout(() => document.getElementById(`code-${i + 1}`)?.focus(), 10);
                      }
                    }}
                    onKeyDown={(e) => {
                      if (e.key === "Backspace" && !forgotCode[i] && i > 0) {
                        setTimeout(() => document.getElementById(`code-${i - 1}`)?.focus(), 10);
                      }
                    }}
                    slotProps={{ htmlInput: { maxLength: 1, style: { textAlign: "center", fontSize: "1.5rem", fontWeight: 700, width: 44, height: 44, padding: 0 } } }}
                    sx={{ "& fieldset": { borderRadius: 1.5 } }}
                  />
                ))}
              </Box>
              <Button
                variant="contained"
                onClick={handleVerifyCode}
                disabled={forgotLoading || forgotCode.length !== 6}
                fullWidth
              >
                {forgotLoading ? "Đang xác minh..." : "Xác minh mã"}
              </Button>
              <Button
                variant="text"
                size="small"
                onClick={() => { setForgotStep(1); setForgotCode(""); setForgotError(""); }}
              >
                ← Quay lại
              </Button>
            </Stack>
          )}

          {forgotStep === 3 && (
            <Stack spacing={2}>
              <Typography variant="body2" color="text.secondary">
                Tạo mật khẩu mới cho tài khoản của bạn.
              </Typography>
              <TextField
                label="Mật khẩu mới"
                type={showForgotPassword ? "text" : "password"}
                value={forgotPassword}
                onChange={(e) => setForgotPassword(e.target.value)}
                fullWidth
                autoFocus
                slotProps={{
                  input: {
                    endAdornment: (
                      <InputAdornment position="end">
                        <IconButton onClick={() => setShowForgotPassword(!showForgotPassword)} edge="end" size="small">
                          {showForgotPassword ? <VisibilityOffIcon /> : <VisibilityIcon />}
                        </IconButton>
                      </InputAdornment>
                    ),
                  },
                }}
              />
              <TextField
                label="Xác nhận mật khẩu mới"
                type={showForgotPassword ? "text" : "password"}
                value={forgotConfirmPassword}
                onChange={(e) => setForgotConfirmPassword(e.target.value)}
                fullWidth
              />
              <Button
                variant="contained"
                onClick={handleForgotReset}
                disabled={forgotLoading}
                fullWidth
              >
                {forgotLoading ? "Đang xử lý..." : "Đặt lại mật khẩu"}
              </Button>
              <Button
                variant="text"
                size="small"
                onClick={() => { setForgotStep(2); setForgotError(""); setForgotPassword(""); setForgotConfirmPassword(""); }}
              >
                ← Quay lại
              </Button>
            </Stack>
          )}

          {forgotStep === 4 && (
            <Stack spacing={2} sx={{ alignItems: "center", py: 2 }}>
              <Box sx={{ width: 64, height: 64, borderRadius: "50%", bgcolor: "success.light", display: "grid", placeItems: "center" }}>
                <CheckCircleOutlineOutlinedIcon sx={{ fontSize: 40, color: "success.main" }} />
              </Box>
              <Typography variant="h6" sx={{ fontWeight: 700 }}>Đặt lại mật khẩu thành công!</Typography>
              <Typography variant="body2" color="text.secondary" sx={{ textAlign: "center" }}>
                Bạn có thể đăng nhập bằng mật khẩu mới ngay bây giờ.
              </Typography>
              <Button variant="contained" onClick={closeForgotDialog} fullWidth sx={{ mt: 1 }}>
                Quay lại đăng nhập
              </Button>
            </Stack>
          )}
        </DialogContent>
      </Dialog>
    </Box>
    </>
  );
}
</file>

<file path="src/components/staff-schedule/AssignStaffDialog.tsx">
"use client";

import { useMemo, useState } from "react";
import {
  Alert,
  Box,
  Button,
  Checkbox,
  CircularProgress,
  Dialog,
  DialogActions,
  DialogContent,
  DialogTitle,
  FormControlLabel,
  MenuItem,
  Stack,
  TextField,
  Typography,
} from "@mui/material";
import api from "@/lib/api-client";
import type { ScheduleStaff, StaffShift, LibraryZone, StaffScheduleAssignment } from "@/lib/types";

interface AssignStaffDialogProps {
  open: boolean;
  date: string;
  shiftId: string;
  shiftName: string;
  shifts: StaffShift[];
  zones: LibraryZone[];
  staff: ScheduleStaff[];
  existingAssignments: StaffScheduleAssignment[];
  dayAssignments: StaffScheduleAssignment[];
  onClose: () => void;
  onAssigned: () => void;
}

export default function AssignStaffDialog({
  open,
  date,
  shiftId,
  shiftName,
  shifts,
  zones,
  staff,
  existingAssignments,
  dayAssignments,
  onClose,
  onAssigned,
}: AssignStaffDialogProps) {
  const [zoneId, setZoneId] = useState("");
  const [staffId, setStaffId] = useState("");
  const [saving, setSaving] = useState(false);
  const [error, setError] = useState<string | null>(null);
  const [forceSave, setForceSave] = useState(false);
  const [warnings, setWarnings] = useState<string[]>([]);

  const shift = useMemo(() => shifts.find((s) => s.id === shiftId), [shifts, shiftId]);

  const existingStaffIds = useMemo(
    () => new Set(existingAssignments.map((a) => a.staffId)),
    [existingAssignments],
  );

  const availableStaff = useMemo(
    () => staff.filter((s) => !existingStaffIds.has(s.id)),
    [staff, existingStaffIds],
  );

  const reset = () => {
    setZoneId("");
    setStaffId("");
    setError(null);
    setForceSave(false);
    setWarnings([]);
  };

  const gatherWarnings = (): string[] => {
    const w: string[] = [];
    const selectedStaff = staff.find((s) => s.id === staffId);
    if (!selectedStaff) return w;
    const existAsg = dayAssignments.find((a) => a.staffId === staffId);
    if (existAsg) {
      const existShift = shifts.find((sh) => sh.id === existAsg.shiftId);
      const newStart = shift?.startTime?.slice(0, 5);
      const newEnd = shift?.endTime?.slice(0, 5);
      const existStart = existShift?.startTime?.slice(0, 5);
      const existEnd = existShift?.endTime?.slice(0, 5);
      const isOverlap = newStart && newEnd && existStart && existEnd && (newStart < existEnd && newEnd > existStart);
      if (isOverlap) {
        w.push(`${selectedStaff.fullName || selectedStaff.email} đã có ca ${existShift?.name || existAsg.shiftId} trùng giờ`);
      }
    }
    return w;
  };

  const handleAssign = async () => {
    if (!zoneId || !staffId) {
      setError("Vui lòng chọn khu vực và nhân viên");
      return;
    }
    const w = gatherWarnings();
    if (w.length > 0 && !forceSave) {
      setWarnings(w);
      return;
    }
    setSaving(true);
    setError(null);
    setWarnings([]);
    try {
      const params: any = { staffId, shiftId, zoneId, workDate: date };
      if (forceSave && w.length > 0) params.force = true;
      await api.createScheduleAssignment(params);
      reset();
      onAssigned();
    } catch (err: any) {
      const data = err?.response?.data;
      setError(data?.error || data?.message || data?.detail?.[0]?.message || err?.message || "Có lỗi xảy ra");
    } finally {
      setSaving(false);
    }
  };

  const getStaffLabel = (s: ScheduleStaff) => {
    const existAsg = dayAssignments.find((a) => a.staffId === s.id);
    if (existAsg) {
      const existShift = shifts.find((sh) => sh.id === existAsg.shiftId);
      const newStart = shift?.startTime?.slice(0, 5);
      const newEnd = shift?.endTime?.slice(0, 5);
      const existStart = existShift?.startTime?.slice(0, 5);
      const existEnd = existShift?.endTime?.slice(0, 5);
      const isOverlap = newStart && newEnd && existStart && existEnd && (newStart < existEnd && newEnd > existStart);

      if (isOverlap) {
        return `${s.fullName || s.email} (⚠ Trùng ca: ${existShift?.name || existAsg.shiftId})`;
      }
      return `${s.fullName || s.email} (Đã có ca: ${existShift?.name || existAsg.shiftId})`;
    }
    return s.fullName || s.email;
  };

  return (
    <Dialog open={open} onClose={onClose} maxWidth="xs" fullWidth>
      <DialogTitle sx={{ display: "flex", justifyContent: "space-between", alignItems: "center", pb: 1 }}>
        Phân ca trực
      </DialogTitle>
      <DialogContent sx={{ pt: 0 }}>
        <Stack spacing={2}>
          <Box>
            <Typography variant="caption" color="text.secondary">
              Ngày: {date}
            </Typography>
            <Typography variant="caption" color="primary.main" sx={{ fontWeight: 600, ml: 1 }}>
              Ca: {shiftName}
            </Typography>
            {shift && (
              <Typography variant="caption" color="text.secondary" sx={{ display: "block" }}>
                {shift.startTime?.slice(0, 5)} &ndash; {shift.endTime?.slice(0, 5)}
              </Typography>
            )}
          </Box>

          <TextField
            select
            size="small"
            label="Khu vực"
            value={zoneId}
            onChange={(e) => { setZoneId(e.target.value); setError(null); }}
            fullWidth
          >
            <MenuItem value="">Chọn khu vực</MenuItem>
            {zones.map((z) => (
              <MenuItem key={z.id} value={z.id}>{z.zoneName}</MenuItem>
            ))}
          </TextField>

          <TextField
            select
            size="small"
            label={
              <span>
                Nhân viên
                {availableStaff.length < staff.length && (
                  <span style={{ fontWeight: 400, color: "#999", marginLeft: 4 }}>
                    ({staff.length - availableStaff.length} đã xếp)
                  </span>
                )}
              </span>
            }
            value={staffId}
            onChange={(e) => { setStaffId(e.target.value); setError(null); }}
            fullWidth
          >
            <MenuItem value="">Chọn nhân viên</MenuItem>
            {availableStaff.map((s) => (
              <MenuItem key={s.id} value={s.id}>{getStaffLabel(s)}</MenuItem>
            ))}
            {availableStaff.length === 0 && (
              <MenuItem disabled>Tất cả nhân viên đã được xếp</MenuItem>
            )}
          </TextField>

          {error && <Alert severity="error">{error}</Alert>}

          {warnings.length > 0 && (
            <Box>
              <Alert severity="warning" sx={{ mb: 1 }}>
                {warnings.map((w, i) => <div key={i}>⚠ {w}</div>)}
              </Alert>
              <FormControlLabel
                control={<Checkbox checked={forceSave} onChange={(e) => setForceSave(e.target.checked)} size="small" />}
                label="Vẫn xếp ca bất chấp cảnh báo"
              />
            </Box>
          )}
        </Stack>
      </DialogContent>
      <DialogActions sx={{ px: 3, pb: 2 }}>
        <Button onClick={onClose} variant="outlined" size="small">Hủy</Button>
        <Button
          onClick={handleAssign}
          variant="contained"
          size="small"
          disabled={saving || availableStaff.length === 0}
        >
          {saving ? <CircularProgress size={14} color="inherit" /> : "Xếp ca"}
        </Button>
      </DialogActions>
    </Dialog>
  );
}
</file>

<file path="src/components/staff-schedule/TemplateManagementPanel.tsx">
"use client";

import { useEffect, useState } from "react";
import {
  Alert,
  Box,
  Button,
  CircularProgress,
  Dialog,
  DialogActions,
  DialogContent,
  DialogContentText,
  DialogTitle,
  Divider,
  Drawer,
  IconButton,
  MenuItem,
  Stack,
  TextField,
  ToggleButton,
  ToggleButtonGroup,
  Typography,
} from "@mui/material";
import CloseIcon from "@mui/icons-material/Close";
import DeleteIcon from "@mui/icons-material/Delete";
import AddIcon from "@mui/icons-material/Add";
import api from "@/lib/api-client";
import type { LibraryZone, StaffShift, ScheduleStaff } from "@/lib/types";

interface Props {
  open: boolean;
  onClose: () => void;
  zones: LibraryZone[];
  shifts: StaffShift[];
  staff: ScheduleStaff[];
  onUpdated: () => void;
}

function getApiError(err: any): string {
  const data = err?.response?.data;
  return data?.error || data?.message || err?.message || "Có lỗi xảy ra";
}

const DAYS = ["CN", "T2", "T3", "T4", "T5", "T6", "T7"];

export default function TemplateManagementPanel({ open, onClose, zones, shifts, staff, onUpdated }: Props) {
  const [templates, setTemplates] = useState<any[]>([]);
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState<string | null>(null);
  const [saving, setSaving] = useState(false);

  const [name, setName] = useState("");
  const [selectedDays, setSelectedDays] = useState<number[]>([1]);
  const [shiftId, setShiftId] = useState("");
  const [zoneId, setZoneId] = useState("");
  const [staffId, setStaffId] = useState("");
  const [validFrom, setValidFrom] = useState("");
  const [validTo, setValidTo] = useState("");

  const [deleteConfirmOpen, setDeleteConfirmOpen] = useState(false);
  const [deleteTargetId, setDeleteTargetId] = useState<string | null>(null);

  const loadData = async () => {
    setLoading(true);
    try {
      const result = await api.getScheduleTemplates();
      setTemplates(result);
    } catch (err) {
      setError(getApiError(err));
    } finally {
      setLoading(false);
    }
  };

  useEffect(() => {
    if (open) loadData();
  }, [open]);

  const handleCreate = async () => {
    if (!name.trim() || !shiftId || !zoneId || !staffId || selectedDays.length === 0) {
      setError("Vui lòng điền tên mẫu, chọn ca trực, khu vực, nhân viên và ít nhất 1 ngày trong tuần");
      return;
    }
    const duplicate = selectedDays.some((day) =>
      templates.some((t) => t.shiftId === shiftId && t.zoneId === zoneId && t.dayOfWeek === day && t.staffId === staffId)
    );
    if (duplicate) {
      setError("Nhân viên này đã có ca trực trong khung giờ/khu vực này vào ngày đã chọn");
      return;
    }
    setSaving(true);
    setError(null);
    try {
      for (const day of selectedDays) {
        await api.createScheduleTemplate({
          name: name.trim(),
          dayOfWeek: day,
          shiftId,
          zoneId,
          staffId,
          validFrom: validFrom || undefined,
          validTo: validTo || undefined,
        });
      }
      setName(""); setShiftId(""); setZoneId(""); setStaffId(""); setValidFrom(""); setValidTo("");
      setSelectedDays([1]);
      await loadData();
      onUpdated();
    } catch (err) {
      setError(getApiError(err));
    } finally {
      setSaving(false);
    }
  };

  const openDeleteConfirm = (id: string) => {
    setDeleteTargetId(id);
    setDeleteConfirmOpen(true);
  };

  const handleConfirmDelete = async () => {
    if (!deleteTargetId) return;
    try {
      await api.deleteScheduleTemplate(deleteTargetId);
      await loadData();
      onUpdated();
    } catch (err) {
      setError(getApiError(err));
    } finally {
      setDeleteConfirmOpen(false);
      setDeleteTargetId(null);
    }
  };

  const getStaffName = (id: string) => {
    const s = staff.find((x) => x.id === id);
    return s?.fullName || s?.email || "Nhân viên";
  };
  const getShiftName = (id: string) => shifts.find((s) => s.id === id)?.name || "Ca";
  const getZoneName = (id: string) => zones.find((z) => z.id === id)?.zoneName || "Khu vực";

  return (
    <>
      <Drawer anchor="right" open={open} onClose={onClose} sx={{ zIndex: 1300 }}>
        <Box sx={{ width: { xs: "100%", sm: 420 }, height: "100%", display: "flex", flexDirection: "column" }}>
          <Box sx={{ display: "flex", alignItems: "center", justifyContent: "space-between", px: 2, py: 1.5, borderBottom: 1, borderColor: "divider" }}>
            <Typography variant="subtitle2" color="primary" sx={{ fontWeight: 700 }}>
              Mẫu lịch tự động
            </Typography>
            <IconButton onClick={onClose} size="small">
              <CloseIcon fontSize="small" />
            </IconButton>
          </Box>

          <Box sx={{ flex: 1, overflowY: "auto", p: 2, display: "flex", flexDirection: "column", gap: 2 }}>
            {error && <Alert severity="error" onClose={() => setError(null)}>{error}</Alert>}

            <Stack spacing={1.5}>
              <TextField
                size="small"
                placeholder="Tên mẫu (vd: Ca sáng T2-T6)"
                value={name}
                onChange={(e) => setName(e.target.value)}
                fullWidth
              />

              <Box>
                <Typography variant="caption" color="text.secondary" sx={{ display: "block", mb: 0.5 }}>Ngày trong tuần</Typography>
                <ToggleButtonGroup
                  value={selectedDays}
                  onChange={(_, v) => setSelectedDays(v)}
                  size="small"
                  sx={{ flexWrap: "wrap", gap: 0.5, "& .MuiToggleButton-root": { px: 1, py: 0.25, fontSize: "0.7rem", textTransform: "none", borderRadius: 1 } }}
                >
                  {DAYS.map((d, i) => (
                    <ToggleButton key={i} value={i}>{d}</ToggleButton>
                  ))}
                </ToggleButtonGroup>
              </Box>

              <TextField
                select
                size="small"
                label="Ca trực"
                value={shiftId}
                onChange={(e) => setShiftId(e.target.value)}
                fullWidth
              >
                <MenuItem value="">Chọn ca trực</MenuItem>
                {shifts.filter((s) => s.isActive).map((s) => (
                  <MenuItem key={s.id} value={s.id}>{s.name} ({s.startTime?.slice(0, 5)}-{s.endTime?.slice(0, 5)})</MenuItem>
                ))}
              </TextField>

              <TextField
                select
                size="small"
                label="Khu vực"
                value={zoneId}
                onChange={(e) => setZoneId(e.target.value)}
                fullWidth
              >
                <MenuItem value="">Chọn khu vực</MenuItem>
                {zones.filter((z) => z.isActive).map((z) => (
                  <MenuItem key={z.id} value={z.id}>{z.zoneName} (Tầng {z.floor})</MenuItem>
                ))}
              </TextField>

              <TextField
                select
                size="small"
                label="Nhân viên"
                value={staffId}
                onChange={(e) => setStaffId(e.target.value)}
                fullWidth
              >
                <MenuItem value="">Chọn nhân viên</MenuItem>
                {staff.map((s) => (
                  <MenuItem key={s.id} value={s.id}>{s.fullName || s.email}</MenuItem>
                ))}
              </TextField>

              <Box>
                <Typography variant="caption" color="text.secondary" sx={{ display: "block", mb: 0.5 }}>Thời hạn áp dụng</Typography>
                <Stack direction="row" spacing={0.5} sx={{ mb: 1 }}>
                  <Button
                    size="small"
                    variant={!validFrom && !validTo ? "contained" : "outlined"}
                    onClick={() => { setValidFrom(""); setValidTo(""); }}
                    sx={{ fontSize: "0.65rem", textTransform: "none" }}
                  >
                    Vô thời hạn
                  </Button>
                  <Button
                    size="small"
                    variant={validFrom && validTo && validFrom.startsWith(`${new Date().getFullYear()}-${String(new Date().getMonth() + 1).padStart(2, '0')}`) ? "contained" : "outlined"}
                    onClick={() => {
                      const now = new Date();
                      const first = new Date(now.getFullYear(), now.getMonth(), 1);
                      const last = new Date(now.getFullYear(), now.getMonth() + 1, 0);
                      setValidFrom(first.toISOString().split("T")[0]);
                      setValidTo(last.toISOString().split("T")[0]);
                    }}
                    sx={{ fontSize: "0.65rem", textTransform: "none" }}
                  >
                    Tháng này
                  </Button>
                  <Button
                    size="small"
                    variant={validFrom && validTo && validFrom.startsWith(`${new Date().getFullYear()}-${String(new Date().getMonth() + 2).padStart(2, '0')}`) ? "contained" : "outlined"}
                    onClick={() => {
                      const now = new Date();
                      const first = new Date(now.getFullYear(), now.getMonth() + 1, 1);
                      const last = new Date(now.getFullYear(), now.getMonth() + 2, 0);
                      setValidFrom(first.toISOString().split("T")[0]);
                      setValidTo(last.toISOString().split("T")[0]);
                    }}
                    sx={{ fontSize: "0.65rem", textTransform: "none" }}
                  >
                    Tháng sau
                  </Button>
                </Stack>
                <Stack direction="row" spacing={1}>
                  <TextField
                    size="small"
                    type="date"
                    label="Từ ngày"
                    value={validFrom}
                    onChange={(e) => setValidFrom(e.target.value)}
                    sx={{ flex: 1 }}
                    slotProps={{ inputLabel: { shrink: true } }}
                  />
                  <TextField
                    size="small"
                    type="date"
                    label="Đến ngày"
                    value={validTo}
                    onChange={(e) => setValidTo(e.target.value)}
                    sx={{ flex: 1 }}
                    slotProps={{ inputLabel: { shrink: true } }}
                  />
                </Stack>
              </Box>

              <Button
                fullWidth
                variant="contained"
                size="small"
                onClick={handleCreate}
                disabled={saving}
                startIcon={saving ? <CircularProgress size={14} color="inherit" /> : <AddIcon />}
              >
                {saving ? "Đang tạo..." : "Thêm mẫu"}
              </Button>
            </Stack>

            <Divider />

            <Box>
              <Typography variant="caption" color="text.secondary" sx={{ fontWeight: 600, textTransform: "uppercase", letterSpacing: 0.5 }}>
                Đã tạo ({templates.length})
              </Typography>
              {loading && <Typography variant="body2" color="text.secondary" sx={{ fontStyle: "italic", mt: 0.5 }}>Đang tải...</Typography>}
              {!loading && templates.length === 0 && (
                <Typography variant="body2" color="text.secondary" sx={{ fontStyle: "italic", mt: 0.5 }}>Chưa có mẫu nào</Typography>
              )}
              <Stack spacing={0.5} sx={{ mt: 0.5 }}>
                {templates.map((t) => (
                  <Box key={t.id} sx={{ display: "flex", alignItems: "center", justifyContent: "space-between", px: 1.5, py: 1, borderRadius: 1, bgcolor: "background.paper", border: 1, borderColor: "divider" }}>
                    <Box>
                      <Typography variant="body2" sx={{ fontWeight: 500 }}>{t.name}</Typography>
                      <Typography variant="caption" color="text.secondary">
                        {DAYS[t.dayOfWeek]} · {getShiftName(t.shiftId)} · {getZoneName(t.zoneId)}
                      </Typography>
                      <Typography variant="caption" color="text.secondary" sx={{ display: "block" }}>
                        {getStaffName(t.staffId)}
                        {t.validFrom ? ` (${t.validFrom} → ${t.validTo || "..."})` : " (Vô thời hạn)"}
                      </Typography>
                    </Box>
                    <IconButton size="small" color="error" onClick={() => openDeleteConfirm(t.id)}>
                      <DeleteIcon fontSize="small" />
                    </IconButton>
                  </Box>
                ))}
              </Stack>
            </Box>
          </Box>
        </Box>
      </Drawer>

      <Dialog open={deleteConfirmOpen} onClose={() => setDeleteConfirmOpen(false)}>
        <DialogTitle>Xác nhận xóa</DialogTitle>
        <DialogContent>
          <DialogContentText>Xóa mẫu lịch này?</DialogContentText>
        </DialogContent>
        <DialogActions>
          <Button onClick={() => setDeleteConfirmOpen(false)}>Hủy</Button>
          <Button onClick={handleConfirmDelete} variant="contained" color="error">Xóa</Button>
        </DialogActions>
      </Dialog>
    </>
  );
}
</file>

<file path="src/app/(dashboard)/active/page.tsx">
"use client";

import React, { useCallback, useEffect, useMemo, useRef, useState } from "react";
import {
  Alert,
  Avatar,
  Box,
  Button,
  Dialog,
  DialogActions,
  DialogContent,
  DialogTitle,
  Grid,
  IconButton,
  InputAdornment,
  Stack,
  TextField,
  Tooltip,
  Typography,
} from "@mui/material";
import AccessTimeOutlinedIcon from "@mui/icons-material/AccessTimeOutlined";
import AssignmentOutlinedIcon from "@mui/icons-material/AssignmentOutlined";
import DoorFrontOutlinedIcon from "@mui/icons-material/DoorFrontOutlined";
import ExitToAppOutlinedIcon from "@mui/icons-material/ExitToAppOutlined";
import LocationOnOutlinedIcon from "@mui/icons-material/LocationOnOutlined";
import LogoutIcon from "@mui/icons-material/LogoutOutlined";
import MenuBookOutlinedIcon from "@mui/icons-material/MenuBookOutlined";
import SearchOutlinedIcon from "@mui/icons-material/SearchOutlined";
import TerminalOutlinedIcon from "@mui/icons-material/TerminalOutlined";
import api, { getErrorMessage } from "@/lib/api-client";
import { staggerSx } from "@/lib/useStaggeredAnimation";
import NoticeSnackbar from "@/components/ui/NoticeSnackbar";
import PageHeader from "@/components/ui/PageHeader";
import DashboardCard from "@/components/ui/DashboardCard";
import MuiStatCard from "@/components/ui/MuiStatCard";
import LoadingOverlay from "@/components/ui/LoadingOverlay";
import EmptyState from "@/components/ui/EmptyState";
import type { ActivePatron, CameraEvent } from "@/lib/types";

const ACTIVE_CAMERA_IDS = new Set(["entry_gate", "exit_gate", "kiosk"]);

const CAMERA_CONFIG: Record<string, { label: string; icon: React.ElementType }> = {
  entry_gate: { label: "Cổng vào", icon: DoorFrontOutlinedIcon },
  exit_gate: { label: "Cổng ra", icon: ExitToAppOutlinedIcon },
  kiosk: { label: "Kiosk", icon: TerminalOutlinedIcon },
};

function formatTime(value: string) {
  return new Date(value).toLocaleTimeString("vi-VN", {
    hour: "2-digit",
    minute: "2-digit",
  });
}

function getDuration(value: string) {
  const diffMs = Date.now() - new Date(value).getTime();
  const minutes = Math.max(0, Math.floor(diffMs / 60000));
  if (minutes < 1) return { text: "Vừa vào", level: 0 as const };
  if (minutes < 60) return { text: `${minutes} phút`, level: 1 as const };
  const hours = Math.floor(minutes / 60);
  const rest = minutes % 60;
  if (hours < 2) return { text: rest ? `${hours} giờ ${rest} phút` : `${hours} giờ`, level: 2 as const };
  return { text: rest ? `${hours} giờ ${rest} phút` : `${hours} giờ`, level: 3 as const };
}

const DURATION_ACCENT: Record<number, string> = {
  0: "#4A8C5C",
  1: "#4A8C5C",
  2: "#C49A3C",
  3: "#B85C4A",
};

function initials(name?: string) {
  const parts = (name || "").trim().split(/\s+/).filter(Boolean);
  if (parts.length === 0) return "?";
  if (parts.length === 1) return parts[0].charAt(0).toUpperCase();
  return `${parts[0].charAt(0)}${parts[parts.length - 1].charAt(0)}`.toUpperCase();
}

function normalizeQuery(value: string) {
  return value.trim().toLowerCase();
}

const STAT_CARDS = [
  { key: "entry_gate", label: "Cổng vào", icon: DoorFrontOutlinedIcon, gradient: "linear-gradient(135deg, #10b981 0%, #059669 100%)" },
  { key: "exit_gate", label: "Cổng ra", icon: ExitToAppOutlinedIcon, gradient: "linear-gradient(135deg, #f59e0b 0%, #d97706 100%)" },
  { key: "kiosk", label: "Kiosk", icon: TerminalOutlinedIcon, gradient: "linear-gradient(135deg, #6366f1 0%, #4338ca 100%)" },
] as const;

export default function ActivePage() {
  const [patrons, setPatrons] = useState<ActivePatron[]>([]);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState<string | null>(null);
  const [search, setSearch] = useState("");
  const [lastUpdate, setLastUpdate] = useState<Date>(new Date());
  const [exitPatron, setExitPatron] = useState<ActivePatron | null>(null);
  const [exiting, setExiting] = useState(false);
  const [snackbar, setSnackbar] = useState<{ severity: "success" | "error"; message: string } | null>(null);
  const [sseConnected, setSseConnected] = useState(false);
  const hasLoadedRef = useRef(false);
  const fallbackRef = useRef<ReturnType<typeof setInterval> | null>(null);

  const load = useCallback(async () => {
    try {
      setError(null);
      const data = await api.getActivePatrons();
      const allowed = data.items
        .filter((p) => ACTIVE_CAMERA_IDS.has(p.camera_id))
        .sort((a, b) => new Date(b.entered_at).getTime() - new Date(a.entered_at).getTime());
      setPatrons(allowed);
      setLastUpdate(new Date());
      hasLoadedRef.current = true;
    } catch {
      setError("Không thể tải danh sách độc giả.");
    } finally {
      setLoading(false);
    }
  }, []);

  const handleSSEEvent = useCallback((event: CameraEvent) => {
    if (!event.access_type || !event.patron_id) return;
    if (!ACTIVE_CAMERA_IDS.has(event.camera_id)) return;

    if (event.access_type === "entry" && event.status === "granted") {
      setPatrons((prev) => {
        if (prev.some((p) => p.id === event.patron_id)) return prev;
        const newPatron: ActivePatron = {
          id: event.patron_id!,
          full_name: event.full_name || event.student_code || "",
          student_code: event.student_code || "",
          entered_at: new Date().toISOString(),
          camera_id: event.camera_id,
          image_url: null,
          confidence: event.score ?? null,
        };
        return [newPatron, ...prev];
      });
      setLastUpdate(new Date());
    } else if (event.access_type === "exit" && event.status === "granted") {
      setPatrons((prev) => prev.filter((p) => p.id !== event.patron_id));
      setLastUpdate(new Date());
    }
  }, []);

  const startFallbackPolling = useCallback(() => {
    if (fallbackRef.current) clearInterval(fallbackRef.current);
    fallbackRef.current = setInterval(() => {
      if (!hasLoadedRef.current) return;
      load();
    }, 60000);
  }, [load]);

  const stopFallbackPolling = useCallback(() => {
    if (fallbackRef.current) {
      clearInterval(fallbackRef.current);
      fallbackRef.current = null;
    }
  }, []);

  useEffect(() => {
    load();

    const cleanup = api.connectAccessSSE(handleSSEEvent, (connected) => {
      setSseConnected(connected);
      if (connected) {
        stopFallbackPolling();
      } else {
        startFallbackPolling();
      }
    });

    startFallbackPolling();

    return () => {
      cleanup();
      stopFallbackPolling();
    };
  }, [handleSSEEvent, load, startFallbackPolling, stopFallbackPolling]);

  const q = normalizeQuery(search);
  const filtered = useMemo(() => {
    if (!q) return patrons;
    return patrons.filter((p) =>
      p.full_name.toLowerCase().includes(q) || p.student_code.toLowerCase().includes(q)
    );
  }, [patrons, search]);

  const cameraCounts = useMemo(() =>
    patrons.reduce<Record<string, number>>((acc, p) => {
      acc[p.camera_id] = (acc[p.camera_id] || 0) + 1;
      return acc;
    }, {}),
    [patrons]
  );

  const stalePatrons = useMemo(() => {
    const now = Date.now();
    return patrons.filter((p) => {
      const hours = (now - new Date(p.entered_at).getTime()) / (1000 * 60 * 60);
      return hours > 8;
    });
  }, [patrons]);

  const handleForceExit = async () => {
    if (!exitPatron) return;
    setExiting(true);
    try {
      await api.forceExitPatron(exitPatron.id);
      setSnackbar({ severity: "success", message: `Đã đánh dấu ${exitPatron.full_name || exitPatron.student_code} đã ra` });
      setExitPatron(null);
      await load();
    } catch (err) {
      setSnackbar({ severity: "error", message: getErrorMessage(err) || "Lỗi khi đánh dấu ra" });
    } finally {
      setExiting(false);
    }
  };

  return (
    <Stack spacing={3}>
      <PageHeader
        title="Mượn đang hoạt động"
        icon={AssignmentOutlinedIcon}
        gradient="linear-gradient(135deg, #1e1b4b 0%, #312e81 50%, #1e1b4b 100%)"
        statBadges={`${patrons.length} độc giả đang ở trong thư viện — cập nhật ${lastUpdate.toLocaleTimeString("vi-VN")}`}
        onRefresh={load}
        actions={
          <Stack direction="row" spacing={1} sx={{ alignItems: "center" }}>
            <Stack direction="row" spacing={0.5} sx={{ alignItems: "center" }}>
              <Box sx={{ width: 6, height: 6, borderRadius: "50%", bgcolor: error ? "error.main" : sseConnected ? "#6ee7b7" : "#fcd34d", animation: sseConnected ? "pulse 2s ease-in-out infinite" : undefined }} />
              <Typography variant="caption" sx={{ color: "rgba(199,210,254,0.7)" }}>
                {error ? "Lỗi" : sseConnected ? "Live" : "Polling"}
              </Typography>
            </Stack>
          </Stack>
        }
      />

      <Grid container spacing={2}>
        {STAT_CARDS.map((cam, idx) => (
          <Grid key={cam.key} size={{ xs: 12, sm: 4 }}>
            <MuiStatCard
              label={cam.label}
              value={cameraCounts[cam.key] || 0}
              icon={cam.icon}
              gradient={cam.gradient}
              index={idx}
            />
          </Grid>
        ))}
      </Grid>

      {stalePatrons.length > 0 ? (
        <Alert severity="warning" sx={{ borderRadius: 2 }}>
          <Typography variant="subtitle2" sx={{ fontWeight: 700 }}>
            {stalePatrons.length} độc giả ở trong thư viện quá 8 giờ
          </Typography>
          <Typography variant="body2">
            Có thể gate không detect exit. Kiểm tra và sử dụng nút &ldquo;Đánh dấu đã ra&rdquo; nếu cần.
          </Typography>
        </Alert>
      ) : null}

      <DashboardCard
        title="Độc giả"
        subtitle={`${filtered.length} kết quả`}
        actions={
          <TextField
            value={search}
            onChange={(e) => setSearch(e.target.value)}
            placeholder="Tìm theo tên hoặc MSSV..."
            size="small"
            sx={{ width: { xs: "100%", sm: 320 }, "& .MuiOutlinedInput-root": { borderRadius: 2, bgcolor: "background.paper", "&:hover": { "& fieldset": { borderColor: "primary.main" } } } }}
            slotProps={{
              input: {
                startAdornment: (
                  <InputAdornment position="start">
                    <SearchOutlinedIcon fontSize="small" />
                  </InputAdornment>
                ),
              },
            }}
          />
        }
      >
        <LoadingOverlay loading={loading && patrons.length === 0} message="Đang tải...">
          {patrons.length === 0 && !loading ? (
            <EmptyState
              icon={<Box sx={{ width: 64, height: 64, borderRadius: 3, display: "flex", alignItems: "center", justifyContent: "center", bgcolor: "rgba(0,0,0,0.04)", color: "text.disabled", mb: 1 }}><MenuBookOutlinedIcon sx={{ fontSize: 32 }} /></Box>}
              title="Thư viện đang yên tĩnh"
              description="Chưa có độc giả nào trong thư viện. Danh sách sẽ tự động cập nhật khi có lượt vào hợp lệ."
            />
          ) : filtered.length === 0 && patrons.length > 0 ? (
            <EmptyState
              icon={<SearchOutlinedIcon sx={{ fontSize: 36, color: "text.disabled" }} />}
              title={`Không tìm thấy độc giả "${search}"`}
            />
          ) : (
            <Grid container spacing={1.5}>
              {filtered.map((patron, idx) => {
                const dur = getDuration(patron.entered_at);
                const accent = DURATION_ACCENT[dur.level];
                const percent = patron.confidence == null ? null : Math.round(patron.confidence * 100);
                const avatarGradient =
                  dur.level <= 1
                    ? "linear-gradient(135deg, #10b981 0%, #059669 100%)"
                    : dur.level === 2
                      ? "linear-gradient(135deg, #f59e0b 0%, #d97706 100%)"
                      : "linear-gradient(135deg, #ef4444 0%, #dc2626 100%)";
                return (
                  <Grid key={patron.id} size={{ xs: 12, xl: 6 }} sx={staggerSx(idx, 0.05)}>
                    <Box
                      sx={{
                        borderRadius: 2,
                        overflow: "hidden",
                        position: "relative",
                        border: "1px solid",
                        borderColor: "divider",
                        transition: "transform 0.2s, box-shadow 0.2s",
                        "&:hover": {
                          transform: "translateY(-1px)",
                          boxShadow: 4,
                        },
                      }}
                    >
                      <Box
                        sx={{
                          position: "absolute",
                          left: 0,
                          top: 0,
                          bottom: 0,
                          width: 3,
                          bgcolor: accent,
                          opacity: 0.7,
                        }}
                      />

                      <Box sx={{ pl: 2.5, pr: 2, py: 1.5 }}>
                        <Stack direction="row" spacing={1.5} sx={{ alignItems: "flex-start" }}>
                          <Avatar
                            sx={{
                              width: 36,
                              height: 36,
                              fontSize: 13,
                              fontWeight: 700,
                              background: avatarGradient,
                              color: "#fff",
                            }}
                          >
                            {initials(patron.full_name)}
                          </Avatar>
                          <Box sx={{ minWidth: 0, flex: 1 }}>
                            <Stack
                              direction="row"
                              spacing={1}
                              sx={{ justifyContent: "space-between", alignItems: "flex-start" }}
                            >
                              <Box sx={{ minWidth: 0 }}>
                                <Typography noWrap sx={{ fontWeight: 700, fontSize: 14 }}>
                                  {patron.full_name || "Chưa có tên"}
                                </Typography>
                                <Typography
                                  variant="caption"
                                  color="text.secondary"
                                  sx={{ fontFamily: "monospace", fontSize: 12 }}
                                >
                                  {patron.student_code}
                                </Typography>
                              </Box>
                              <Stack direction="row" spacing={0.5} sx={{ alignItems: "center", flexShrink: 0 }}>
                                {percent != null ? (
                                  <Tooltip title={`Độ chính xác: ${percent}%`}>
                                    <Box
                                      sx={{
                                        width: 8,
                                        height: 8,
                                        borderRadius: "50%",
                                        bgcolor:
                                          percent >= 80 ? "success.main" : percent >= 60 ? "warning.main" : "error.main",
                                      }}
                                    />
                                  </Tooltip>
                                ) : null}
                                <Box
                                  sx={{
                                    px: 1,
                                    py: 0.25,
                                    borderRadius: 0.75,
                                    bgcolor:
                                      dur.level <= 1
                                        ? "rgba(74,140,92,0.1)"
                                        : dur.level === 2
                                          ? "rgba(196,154,60,0.1)"
                                          : "rgba(184,92,74,0.1)",
                                  }}
                                >
                                  <Typography
                                    variant="caption"
                                    sx={{ fontWeight: 700, fontSize: 11, color: accent, whiteSpace: "nowrap" }}
                                  >
                                    {dur.text}
                                  </Typography>
                                </Box>
                              </Stack>
                            </Stack>

                            <Stack direction="row" spacing={2} sx={{ mt: 1, flexWrap: "wrap", rowGap: 0.5 }}>
                              <Stack direction="row" spacing={0.5} sx={{ alignItems: "center" }}>
                                <AccessTimeOutlinedIcon sx={{ fontSize: 13, color: "text.disabled" }} />
                                <Typography variant="caption" color="text.secondary" sx={{ fontSize: 12 }}>
                                  {formatTime(patron.entered_at)}
                                </Typography>
                              </Stack>
                              <Stack direction="row" spacing={0.5} sx={{ alignItems: "center" }}>
                                <LocationOnOutlinedIcon sx={{ fontSize: 13, color: "text.disabled" }} />
                                <Typography variant="caption" color="text.secondary" sx={{ fontSize: 12 }}>
                                  {CAMERA_CONFIG[patron.camera_id]?.label || patron.camera_id}
                                </Typography>
                              </Stack>
                            </Stack>
                          </Box>
                          <Tooltip title="Đánh dấu đã ra">
                            <IconButton
                              size="small"
                              color="warning"
                              onClick={() => setExitPatron(patron)}
                              sx={{ flexShrink: 0, mt: 0.5 }}
                            >
                              <LogoutIcon fontSize="small" />
                            </IconButton>
                          </Tooltip>
                        </Stack>
                      </Box>
                    </Box>
                  </Grid>
                );
              })}
            </Grid>
          )}
        </LoadingOverlay>
      </DashboardCard>

      <Dialog open={!!exitPatron} onClose={() => exiting ? undefined : setExitPatron(null)} maxWidth="xs" fullWidth>
        <DialogTitle sx={{ fontWeight: 900 }}>Xác nhận đánh dấu đã ra?</DialogTitle>
        <DialogContent>
          <Typography>
            Độc giả <strong>{exitPatron?.full_name || exitPatron?.student_code}</strong> sẽ được đánh dấu đã rời khỏi thư viện.
          </Typography>
          <Typography variant="body2" color="text.secondary" sx={{ mt: 1 }}>
            Dùng khi gate không detect được exit.
          </Typography>
        </DialogContent>
        <DialogActions>
          <Button onClick={() => setExitPatron(null)} disabled={exiting}>Hủy</Button>
          <Button variant="contained" color="warning" onClick={handleForceExit} disabled={exiting}>
            {exiting ? "Đang xử lý..." : "Đánh dấu đã ra"}
          </Button>
        </DialogActions>
      </Dialog>

      <NoticeSnackbar open={!!snackbar} message={snackbar?.message || ""} severity={snackbar?.severity || "success"} onClose={() => setSnackbar(null)} anchorOrigin={{ vertical: "top", horizontal: "right" }} />
    </Stack>
  );
}
</file>

<file path="src/app/(dashboard)/patrons/[id]/page.tsx">
"use client";

import { useCallback, useEffect, useMemo, useState } from "react";
import { useParams, useRouter } from "next/navigation";
import {
  Alert,
  Avatar,
  Box,
  Button,
  Chip,
  Dialog,
  DialogActions,
  DialogContent,
  DialogTitle,
  Divider,
  Grid,
  LinearProgress,
  MenuItem,
  Stack,
  Table,
  TableBody,
  TableCell,
  TableContainer,
  TableHead,
  TableRow,
  TextField,
  Typography,
} from "@mui/material";
import AutoStoriesOutlinedIcon from "@mui/icons-material/AutoStoriesOutlined";
import BadgeOutlinedIcon from "@mui/icons-material/BadgeOutlined";
import DeleteOutlineOutlinedIcon from "@mui/icons-material/DeleteOutlineOutlined";
import EditOutlinedIcon from "@mui/icons-material/EditOutlined";
import EventAvailableOutlinedIcon from "@mui/icons-material/EventAvailableOutlined";
import FaceRetouchingNaturalOutlinedIcon from "@mui/icons-material/FaceRetouchingNaturalOutlined";
import HistoryOutlinedIcon from "@mui/icons-material/HistoryOutlined";
import UpdateOutlinedIcon from "@mui/icons-material/UpdateOutlined";
import PersonIcon from "@mui/icons-material/PersonOutlined";
import api, { getErrorMessage } from "@/lib/api-client";
import MultiAngleCapture from "@/components/MultiAngleCapture";
import { slideInRight } from "@/lib/animations";
import PageHeader from "@/components/ui/PageHeader";
import DashboardCard from "@/components/ui/DashboardCard";
import EmptyState from "@/components/ui/EmptyState";
import LoadingOverlay from "@/components/ui/LoadingOverlay";
import NoticeSnackbar from "@/components/ui/NoticeSnackbar";
import { staggerSx } from "@/lib/useStaggeredAnimation";
import type { AccessLogPublic, BorrowRecord, PatronPublic, PatronUpdate } from "@/lib/types";
import type { CaptureAngle } from "@/components/MultiAngleCapture";

const CAMERA_LABELS: Record<string, string> = {
  entry_gate: "Cổng vào",
  exit_gate: "Cổng ra",
  kiosk: "Kiosk",
  web_login: "Đăng nhập web",
};

function initials(name: string) {
  const parts = name.trim().split(/\s+/).filter(Boolean);
  if (parts.length === 0) return "?";
  if (parts.length === 1) return parts[0].charAt(0).toUpperCase();
  return `${parts[0].charAt(0)}${parts[parts.length - 1].charAt(0)}`.toUpperCase();
}

function formatDate(value?: string | null) {
  if (!value) return "-";
  return new Date(value).toLocaleDateString("vi-VN");
}

function formatDateTime(value?: string | null) {
  if (!value) return "-";
  return new Date(value).toLocaleString("vi-VN");
}

function statusLabel(status: string) {
  if (status === "active") return "Đang hoạt động";
  if (status === "inactive") return "Tạm khóa";
  if (status === "expired") return "Hết hạn";
  if (status === "deleted") return "Đã xóa";
  return status;
}

function borrowStatus(record: BorrowRecord) {
  const overdue = record.status === "borrowed" && new Date(record.due_at) < new Date();
  if (record.status === "returned") return { label: "Đã trả", color: "default" as const };
  if (overdue) return { label: "Quá hạn", color: "error" as const };
  return { label: "Đang mượn", color: "success" as const };
}

export default function PatronDetailPage() {
  const { id } = useParams<{ id: string }>();
  const router = useRouter();

  const [patron, setPatron] = useState<PatronPublic | null>(null);
  const [loading, setLoading] = useState(true);
  const [logs, setLogs] = useState<AccessLogPublic[]>([]);
  const [logsTotal, setLogsTotal] = useState(0);
  const [logsSkip, setLogsSkip] = useState(0);
  const logsLimit = 20;
  const [borrows, setBorrows] = useState<BorrowRecord[]>([]);

  const [editForm, setEditForm] = useState<PatronUpdate>({});
  const [showEdit, setShowEdit] = useState(false);
  const [showDelete, setShowDelete] = useState(false);
  const [deleteConfirmText, setDeleteConfirmText] = useState("");
  const [showRestore, setShowRestore] = useState(false);
  const [restoreConfirmText, setRestoreConfirmText] = useState("");
  const [showEnroll, setShowEnroll] = useState(false);
  const [consent, setConsent] = useState(false);
  const [enrollError, setEnrollError] = useState("");
  const [enrollSuccess, setEnrollSuccess] = useState("");
  const [enrollLoading, setEnrollLoading] = useState(false);
  const [notice, setNotice] = useState("");

  const loadPatron = useCallback(async () => {
    try {
      const data = await api.getPatron(id);
      setPatron(data);
    } catch {
      setPatron(null);
    }
  }, [id]);

  const loadLogs = useCallback(async () => {
    try {
      const data = await api.getAccessLogs({ patronId: id, skip: logsSkip, limit: logsLimit });
      setLogs(data.items);
      setLogsTotal(data.total);
    } catch {
      setLogs([]);
      setLogsTotal(0);
    }
  }, [id, logsSkip]);

  const loadBorrows = useCallback(async () => {
    try {
      const data = await api.getBorrowHistory({ patronId: id });
      setBorrows(data);
    } catch {
      setBorrows([]);
    }
  }, [id]);

  useEffect(() => {
    (async () => {
      setLoading(true);
      await Promise.all([loadPatron(), loadLogs(), loadBorrows()]);
      setLoading(false);
    })();
  }, [loadPatron, loadLogs, loadBorrows]);

  const openEdit = () => {
    if (!patron) return;
    setEditForm({
      full_name: patron.full_name,
      class_name: patron.class_name || undefined,
      identity_number: patron.identity_number || undefined,
      email: patron.email || undefined,
      phone: patron.phone || undefined,
      membership_expiry: patron.membership_expiry,
      status: patron.status,
      course: patron.course || undefined,
    });
    setShowEdit(true);
  };

  const handleEdit = async () => {
    if (!patron) return;
    await api.updatePatron(patron.id, editForm);
    setShowEdit(false);
    setNotice("Đã cập nhật thông tin độc giả.");
    await loadPatron();
  };

  const handleRenew = async () => {
    if (!patron) return;
    const current = new Date(patron.membership_expiry);
    const next = new Date(current);
    next.setFullYear(next.getFullYear() + 1);
    await api.updatePatron(patron.id, { membership_expiry: next.toISOString().split("T")[0] });
    setNotice("Đã gia hạn thẻ thêm 1 năm.");
    await loadPatron();
  };

  const handleDelete = async () => {
    if (!patron || deleteConfirmText !== "XÓA") return;
    try {
      await api.deletePatron(patron.id);
      router.push("/patrons");
    } catch (err: any) {
      if (err?.response?.status === 404) {
        setNotice("Độc giả không tồn tại hoặc đã bị xóa.");
        router.push("/patrons");
      } else {
        setNotice(`Xóa thất bại: ${getErrorMessage(err) || "Lỗi không xác định"}`);
      }
    }
  };

  const handleRestore = async () => {
    if (!patron || restoreConfirmText !== "KHÔI PHỤC") return;
    try {
      await api.restorePatron(patron.id);
      setShowRestore(false);
      setRestoreConfirmText("");
      setNotice("Đã khôi phục độc giả.");
      await loadPatron();
    } catch (err: any) {
      setNotice(`Khôi phục thất bại: ${getErrorMessage(err) || "Lỗi không xác định"}`);
    }
  };

  const handleEnroll = async (files: Record<CaptureAngle, File>) => {
    if (!patron) return;
    setEnrollLoading(true);
    setEnrollError("");
    setEnrollSuccess("");
    try {
      await api.enrollPatronFaceBatch(patron.id, {
        frontal: files.frontal,
        right: files.right,
        left: files.left,
        down: files.down,
      });
      setEnrollSuccess("Đăng ký khuôn mặt thành công.");
      setShowEnroll(false);
      setConsent(false);
      await loadPatron();
    } catch (err: any) {
      const errCode = err?.response?.data?.error || err?.response?.data?.detail;
      const errorMessages: Record<string, string> = {
        LIVENESS_FAILED: "Ảnh không phải khuôn mặt thật, vui lòng chụp trực tiếp.",
        NO_FACE_DETECTED: "Không tìm thấy khuôn mặt trong ảnh, vui lòng thử lại.",
        MULTIPLE_FACES: "Có nhiều hơn 1 khuôn mặt trong ảnh, vui lòng chụp lại.",
        LOW_QUALITY: "Ảnh quá mờ hoặc thiếu sáng, vui lòng chụp lại với ánh sáng tốt hơn.",
        FACE_DETECTION_FAILED: "Không thể trích xuất khuôn mặt, vui lòng thử lại.",
      };
      setEnrollError(errorMessages[errCode] || getErrorMessage(err) || "Đăng ký thất bại.");
    } finally {
      setEnrollLoading(false);
    }
  };

  const pageCount = Math.max(1, Math.ceil(logsTotal / logsLimit));
  const currentPage = Math.floor(logsSkip / logsLimit) + 1;
  const activeBorrowCount = useMemo(() => borrows.filter((item) => item.status === "borrowed").length, [borrows]);
  const overdueCount = useMemo(() => borrows.filter((item) => item.status === "borrowed" && new Date(item.due_at) < new Date()).length, [borrows]);

  const expired = !patron ? false : new Date(patron.membership_expiry) < new Date();

  const headerActions = patron ? (
    patron.status === "deleted" ? (
      <Button variant="contained" color="success" onClick={() => setShowRestore(true)}>
        Khôi phục
      </Button>
    ) : (
      <Stack direction="row" spacing={1} sx={{ flexWrap: "wrap" }}>
        <Button variant="outlined" startIcon={<EditOutlinedIcon />} onClick={openEdit}>
          Sửa thông tin
        </Button>
        <Button variant="outlined" startIcon={<UpdateOutlinedIcon />} onClick={handleRenew}>
          Gia hạn thẻ
        </Button>
        {!patron.has_face ? (
          <Button variant="contained" startIcon={<FaceRetouchingNaturalOutlinedIcon />} onClick={() => setShowEnroll(true)}>
            Đăng ký khuôn mặt
          </Button>
        ) : null}
        <Button color="error" variant="outlined" startIcon={<DeleteOutlineOutlinedIcon />} onClick={() => setShowDelete(true)}>
          Xóa
        </Button>
      </Stack>
    )
  ) : null;

  return (
    <LoadingOverlay loading={loading} message="Đang tải hồ sơ độc giả...">
      {!patron ? (
        <EmptyState
          icon={<PersonIcon sx={{ fontSize: 56 }} />}
          title="Không tìm thấy độc giả"
          description="Độc giả có thể đã bị xóa hoặc ID không hợp lệ."
          action={
            <Button variant="contained" startIcon={<PersonIcon />} onClick={() => router.push("/patrons")}>
              Quay lại danh sách
            </Button>
          }
        />
      ) : (
        <Stack spacing={3}>
          <PageHeader
            backHref="/patrons"
            title={patron.full_name}
            subtitle={`MSSV: ${patron.student_code} · Mã thẻ: ${patron.card_number}`}
            icon={PersonIcon}
            actions={headerActions}
          />

          {patron.status === "deleted" ? (
            <Alert severity="error" sx={{ fontWeight: 600 }}>
              Độc giả này đã bị xóa. Dữ liệu sẽ được giữ lại và có thể khôi phục.
            </Alert>
          ) : null}
          {patron.status === "inactive" ? (
            <Alert severity="warning" sx={{ fontWeight: 600 }}>
              Thẻ độc giả đang bị tạm khóa.
            </Alert>
          ) : null}
          {patron.status === "expired" ? (
            <Alert severity="warning" sx={{ fontWeight: 600 }}>
              Thẻ độc giả đã hết hạn. Vui lòng gia hạn để tiếp tục sử dụng.
            </Alert>
          ) : null}

          <Stack direction="row" spacing={1} sx={{ flexWrap: "wrap" }}>
            <Chip
              color={patron.status === "active" ? "success" : patron.status === "deleted" ? "error" : "warning"}
              label={statusLabel(patron.status)}
            />
            <Chip color={patron.has_face ? "success" : "default"} icon={<FaceRetouchingNaturalOutlinedIcon />} label={patron.has_face ? "Đã có khuôn mặt" : "Chưa có khuôn mặt"} />
            <Chip color={expired ? "error" : "primary"} icon={<EventAvailableOutlinedIcon />} label={`Hạn thẻ: ${formatDate(patron.membership_expiry)}`} />
          </Stack>

          {enrollSuccess ? <Alert severity="success">{enrollSuccess}</Alert> : null}

          <Grid container spacing={2}>
            {[
              { label: "Đang mượn", value: activeBorrowCount, icon: <AutoStoriesOutlinedIcon />, color: "primary.main" },
              { label: "Quá hạn", value: overdueCount, icon: <EventAvailableOutlinedIcon />, color: "error.main" },
              { label: "Lượt ra/vào", value: logsTotal, icon: <HistoryOutlinedIcon />, color: "success.main" },
            ].map((item, idx) => (
              <Grid key={item.label} size={{ xs: 12, sm: 4 }} sx={staggerSx(idx)}>
                <DashboardCard>
                  <Stack direction="row" spacing={1.5} sx={{ alignItems: "center" }}>
                    <Avatar sx={{ bgcolor: "action.hover", color: item.color }}>{item.icon}</Avatar>
                    <Box>
                      <Typography color="text.secondary" variant="body2">{item.label}</Typography>
                      <Typography variant="h5" sx={{ fontWeight: 850 }}>{item.value}</Typography>
                    </Box>
                  </Stack>
                </DashboardCard>
              </Grid>
            ))}
          </Grid>

          <DashboardCard title="Thông tin thẻ">
            <Grid container spacing={2}>
              {[
                ["Họ tên", patron.full_name],
                ["MSSV", patron.student_code],
                ["Lớp", patron.class_name || "-"],
                ["Khóa học", patron.course || "-"],
                ["Mã thẻ", patron.card_number],
                ["CCCD/CMND", patron.identity_number || "-"],
                ["Email", patron.email || "-"],
                ["Số điện thoại", patron.phone || "-"],
                ["HKTT", patron.permanent_address || "-"],
                ["Ngày cấp thẻ", formatDate(patron.issue_date)],
                ["Ngày tạo", formatDateTime(patron.created_at)],
              ].map(([label, value]) => (
                <Grid key={label} size={{ xs: 12, sm: 6, lg: 4 }}>
                  <Typography variant="caption" color="text.secondary">{label}</Typography>
                  <Typography sx={{ fontWeight: 700, wordBreak: "break-word" }}>{value}</Typography>
                </Grid>
              ))}
            </Grid>
          </DashboardCard>

          <DashboardCard title="Lịch sử mượn sách" subtitle="Các bản ghi mượn/trả của độc giả này" noPadding>
            {borrows.length === 0 ? (
              <Alert severity="info" sx={{ m: 2 }}>Độc giả này chưa mượn cuốn sách nào.</Alert>
            ) : (
          <TableContainer sx={{ overflowX: "auto" }}>
          <Table sx={{ minWidth: 760 }}>
                  <TableHead>
                    <TableRow>
                      <TableCell>Sách</TableCell>
                      <TableCell>Ngày mượn</TableCell>
                      <TableCell>Hạn trả</TableCell>
                      <TableCell>Ngày trả</TableCell>
                      <TableCell>Tình trạng</TableCell>
                      <TableCell>Trạng thái</TableCell>
                    </TableRow>
                  </TableHead>
                  <TableBody>
                    {borrows.map((record, idx) => {
                      const status = borrowStatus(record);
                      return (
                        <TableRow key={record.id} hover sx={{ animation: `${slideInRight} 0.3s ease-out`, animationDelay: `${idx * 0.04}s`, animationFillMode: "both" }}>
                          <TableCell>
                            <Typography sx={{ fontWeight: 750 }}>{record.book?.title || record.book_id}</Typography>
                            <Typography variant="body2" color="text.secondary" sx={{ fontFamily: "monospace" }}>
                              {record.book?.isbn || record.book_id}
                            </Typography>
                          </TableCell>
                          <TableCell>{formatDate(record.borrow_at)}</TableCell>
                          <TableCell sx={{ color: status.color === "error" ? "error.main" : "inherit", fontWeight: status.color === "error" ? 800 : 400 }}>
                            {formatDate(record.due_at)}
                          </TableCell>
                          <TableCell>{formatDate(record.return_at)}</TableCell>
                          <TableCell>
                            {record.status === "returned" && record.note ? (
                              <Chip size="small" variant="outlined" label={record.note} sx={{ fontSize: 11 }} />
                            ) : (
                              <Typography variant="body2" color="text.disabled">-</Typography>
                            )}
                          </TableCell>
                          <TableCell><Chip size="small" color={status.color} label={status.label} /></TableCell>
                        </TableRow>
                      );
                    })}
                  </TableBody>
                </Table>
              </TableContainer>
            )}
          </DashboardCard>

          {showEnroll && !patron.has_face ? (
            <DashboardCard
              title="Đăng ký khuôn mặt 4 góc"
              subtitle="Chụp đủ các góc để tăng độ chính xác khi nhận diện."
              actions={
                <Button onClick={() => { setShowEnroll(false); setEnrollError(""); setConsent(false); }}>
                  Đóng
                </Button>
              }
            >
              <MultiAngleCapture consent={consent} setConsent={setConsent} onFilesReady={handleEnroll} />
              {enrollError ? <Alert severity="error" sx={{ mt: 2 }}>{enrollError}</Alert> : null}
              {enrollLoading ? <Alert severity="info" sx={{ mt: 2 }}>Đang đăng ký khuôn mặt...</Alert> : null}
            </DashboardCard>
          ) : null}

          <DashboardCard title="Lịch sử ra/vào" subtitle="Các lần hệ thống ghi nhận độc giả tại cổng/kiosk" noPadding>
            {logs.length === 0 ? (
              <Alert severity="info" sx={{ m: 2 }}>Chưa có lịch sử ra/vào.</Alert>
            ) : (
              <>
        <TableContainer sx={{ overflowX: "auto" }}>
        <Table sx={{ minWidth: 900 }}>
                    <TableHead>
                      <TableRow>
                        <TableCell>Thời gian</TableCell>
                        <TableCell>Loại</TableCell>
                        <TableCell>Cổng</TableCell>
                        <TableCell>Phương thức</TableCell>
                        <TableCell>Độ tin cậy</TableCell>
                        <TableCell>Kết quả</TableCell>
                      </TableRow>
                    </TableHead>
                    <TableBody>
                      {logs.map((log, idx) => {
                        const confidence = log.confidence == null ? null : Math.round(log.confidence * 100);
                        return (
                          <TableRow key={log.id} hover sx={{ animation: `${slideInRight} 0.3s ease-out`, animationDelay: `${idx * 0.03}s`, animationFillMode: "both" }}>
                            <TableCell sx={{ whiteSpace: "nowrap" }}>{formatDateTime(log.access_time)}</TableCell>
                            <TableCell>
                              <Chip size="small" color={log.access_type === "entry" ? "success" : "warning"} label={log.access_type === "entry" ? "Vào" : "Ra"} />
                            </TableCell>
                            <TableCell sx={{ color: "text.secondary" }}>{CAMERA_LABELS[log.camera_id] || log.camera_id}</TableCell>
                            <TableCell sx={{ color: "text.secondary" }}>{log.verify_method}</TableCell>
                            <TableCell sx={{ minWidth: 150 }}>
                              {confidence == null ? (
                                <Typography color="text.secondary">-</Typography>
                              ) : (
                                <Stack direction="row" spacing={1} sx={{ alignItems: "center" }}>
                                  <LinearProgress
                                    variant="determinate"
                                    value={confidence}
                                    color={confidence >= 80 ? "success" : confidence >= 60 ? "warning" : "error"}
                                    sx={{ width: 84, height: 7, borderRadius: 99 }}
                                  />
                                  <Typography variant="caption" color="text.secondary">{confidence}%</Typography>
                                </Stack>
                              )}
                            </TableCell>
                            <TableCell>
                              <Chip size="small" color={["success", "granted"].includes(log.status) ? "success" : "error"} label={["success", "granted"].includes(log.status) ? "Thành công" : "Thất bại"} />
                            </TableCell>
                          </TableRow>
                        );
                      })}
                    </TableBody>
                  </Table>
                </TableContainer>
                {logsTotal > logsLimit ? (
                  <Stack direction="row" spacing={1} sx={{ p: 2, alignItems: "center", justifyContent: "space-between" }}>
                    <Typography color="text.secondary">Tổng: {logsTotal}</Typography>
                    <Stack direction="row" spacing={1} sx={{ alignItems: "center" }}>
                      <Button variant="outlined" disabled={currentPage <= 1} onClick={() => setLogsSkip(0)}>Đầu</Button>
                      <Typography color="text.secondary">Trang {currentPage} / {pageCount}</Typography>
                      <Button variant="outlined" disabled={currentPage >= pageCount} onClick={() => setLogsSkip((pageCount - 1) * logsLimit)}>Cuối</Button>
                    </Stack>
                  </Stack>
                ) : null}
              </>
            )}
          </DashboardCard>

          <Dialog open={showEdit} onClose={() => setShowEdit(false)} fullWidth maxWidth="sm">
            <DialogTitle>Sửa độc giả</DialogTitle>
            <DialogContent>
              <Stack spacing={2} sx={{ pt: 1 }}>
                <TextField label="Họ tên" value={editForm.full_name || ""} onChange={(event) => setEditForm({ ...editForm, full_name: event.target.value })} fullWidth />
                <TextField label="Lớp" value={editForm.class_name || ""} onChange={(event) => setEditForm({ ...editForm, class_name: event.target.value })} fullWidth />
                <TextField label="CCCD/CMND" value={editForm.identity_number || ""} onChange={(event) => setEditForm({ ...editForm, identity_number: event.target.value })} fullWidth />
                <TextField label="Email" value={editForm.email || ""} onChange={(event) => setEditForm({ ...editForm, email: event.target.value })} fullWidth />
                <TextField label="Số điện thoại" value={editForm.phone || ""} onChange={(event) => setEditForm({ ...editForm, phone: event.target.value })} fullWidth />
                <TextField label="Khóa học" value={editForm.course || ""} onChange={(event) => setEditForm({ ...editForm, course: event.target.value })} fullWidth />
                <TextField
                  label="Hạn thẻ"
                  type="date"
                  value={editForm.membership_expiry || ""}
                  onChange={(event) => setEditForm({ ...editForm, membership_expiry: event.target.value })}
                  fullWidth
                  slotProps={{ inputLabel: { shrink: true } }}
                />
                <TextField select label="Trạng thái" value={editForm.status || "active"} onChange={(event) => setEditForm({ ...editForm, status: event.target.value })} fullWidth>
                  <MenuItem value="active">Đang hoạt động</MenuItem>
                  <MenuItem value="inactive">Tạm khóa</MenuItem>
                  <MenuItem value="expired">Hết hạn</MenuItem>
                </TextField>
              </Stack>
            </DialogContent>
            <DialogActions>
              <Button onClick={() => setShowEdit(false)}>Hủy</Button>
              <Button variant="contained" onClick={handleEdit}>Lưu</Button>
            </DialogActions>
          </Dialog>

          <Dialog open={showDelete} onClose={() => { setShowDelete(false); setDeleteConfirmText(""); }} fullWidth maxWidth="xs">
            <DialogTitle>Xóa độc giả?</DialogTitle>
            <DialogContent>
              <Stack spacing={2}>
                <Typography color="text.secondary">
                  Hồ sơ <strong>{patron.full_name}</strong> sẽ bị xóa khỏi danh sách độc giả. Dữ liệu liên quan (thông báo, lịch trực) cũng sẽ bị xóa.
                </Typography>
                <Typography variant="body2" color="text.secondary">
                  Nhập <strong>XÓA</strong> để xác nhận:
                </Typography>
                <TextField
                  value={deleteConfirmText}
                  onChange={(e) => setDeleteConfirmText(e.target.value)}
                  placeholder="Nhập XÓA"
                  size="small"
                  autoFocus
                  fullWidth
                />
              </Stack>
            </DialogContent>
            <DialogActions>
              <Button onClick={() => { setShowDelete(false); setDeleteConfirmText(""); }}>Hủy</Button>
              <Button color="error" variant="contained" onClick={handleDelete} disabled={deleteConfirmText !== "XÓA"}>
                Xóa vĩnh viễn
              </Button>
            </DialogActions>
          </Dialog>

          <Dialog open={showRestore} onClose={() => { setShowRestore(false); setRestoreConfirmText(""); }} fullWidth maxWidth="xs">
            <DialogTitle>Khôi phục độc giả?</DialogTitle>
            <DialogContent>
              <Stack spacing={2}>
                <Typography color="text.secondary">
                  Khôi phục hồ sơ <strong>{patron.full_name}</strong>? Nếu thẻ đã hết hạn, hạn thẻ sẽ được tự động gia hạn 1 năm.
                </Typography>
                <Typography variant="body2" color="text.secondary">
                  Nhập <strong>KHÔI PHỤC</strong> để xác nhận:
                </Typography>
                <TextField
                  value={restoreConfirmText}
                  onChange={(e) => setRestoreConfirmText(e.target.value)}
                  placeholder="Nhập KHÔI PHỤC"
                  size="small"
                  autoFocus
                  fullWidth
                />
              </Stack>
            </DialogContent>
            <DialogActions>
              <Button onClick={() => { setShowRestore(false); setRestoreConfirmText(""); }}>Hủy</Button>
              <Button color="success" variant="contained" onClick={handleRestore} disabled={restoreConfirmText !== "KHÔI PHỤC"}>
                Khôi phục
              </Button>
            </DialogActions>
          </Dialog>

          <NoticeSnackbar open={Boolean(notice)} message={notice || ""} severity="success" onClose={() => setNotice("")} />
        </Stack>
      )}
    </LoadingOverlay>
  );
}
</file>

<file path="src/app/(dashboard)/return/page.tsx">
"use client";

import { useCallback, useEffect, useMemo, useRef, useState } from "react";
import {
  Alert,
  AlertTitle,
  Avatar,
  Box,
  Button,
  Chip,
  CircularProgress,
  Dialog,
  DialogActions,
  DialogContent,
  DialogContentText,
  DialogTitle,
  Grid,
  IconButton,
  LinearProgress,
  List,
  MenuItem,
  Paper,
  Select,
  Slide,
  Stack,
  ToggleButton,
  ToggleButtonGroup,
  Typography,
} from "@mui/material";
import AlertIcon from "@mui/icons-material/WarningAmberOutlined";
import BookIcon from "@mui/icons-material/MenuBookOutlined";
import CameraAltIcon from "@mui/icons-material/CameraAltOutlined";
import CheckCircleIcon from "@mui/icons-material/CheckCircleOutlineOutlined";
import CloseIcon from "@mui/icons-material/Close";
import DeleteIcon from "@mui/icons-material/DeleteOutlined";
import QrCodeScannerIcon from "@mui/icons-material/QrCodeScannerOutlined";
import ReturnIcon from "@mui/icons-material/AssignmentReturnOutlined";
import UsersIcon from "@mui/icons-material/GroupsOutlined";
import api, { getErrorMessage } from "@/lib/api-client";
import { slideInRight } from "@/lib/animations";
import { staggerSx } from "@/lib/useStaggeredAnimation";
import PageHeader from "@/components/ui/PageHeader";
import DashboardCard from "@/components/ui/DashboardCard";
import EmptyState from "@/components/ui/EmptyState";
import LoadingOverlay from "@/components/ui/LoadingOverlay";
import NoticeSnackbar from "@/components/ui/NoticeSnackbar";
import SearchField from "@/components/ui/SearchField";
import type { BorrowRecord, StaffActiveBorrowerSummary, StaffPatronActiveBorrowsResponse } from "@/lib/types";

const _RAW_CAM_URL = process.env.NEXT_PUBLIC_BORROW_CAM_URL;
if (!_RAW_CAM_URL) throw new Error("NEXT_PUBLIC_BORROW_CAM_URL is not set");
const RAW_CAM_URL: string = _RAW_CAM_URL;
const BORROW_CAM_URL = `/api/camera/proxy?url=${encodeURIComponent(RAW_CAM_URL)}`;

type BorrowerFilter = "all" | "overdue" | "active";

function isOverdue(record: BorrowRecord) {
  return new Date(record.due_at) < new Date();
}

function daysUntil(value: string) {
  const today = new Date();
  const due = new Date(value);
  today.setHours(0, 0, 0, 0);
  due.setHours(0, 0, 0, 0);
  return Math.ceil((due.getTime() - today.getTime()) / 86400000);
}

function formatDate(value?: string) {
  if (!value) return "-";
  return new Date(value).toLocaleDateString("vi-VN");
}

function borrowerName(borrower: StaffActiveBorrowerSummary) {
  return borrower.patron.full_name || borrower.patron.student_code || "Không rõ tên";
}

function dueChip(record: BorrowRecord) {
  const left = daysUntil(record.due_at);
  if (left < 0) return <Chip size="small" color="error" label={`Quá hạn ${Math.abs(left)} ngày`} />;
  if (left <= 2) return <Chip size="small" color="warning" label="Sắp đến hạn" />;
  return <Chip size="small" color="success" label="Đúng hạn" />;
}

interface ScannedReturnItem {
  isbn: string;
  record: BorrowRecord;
  condition: string;
}

export default function ReturnPage() {
  const [borrowers, setBorrowers] = useState<StaffActiveBorrowerSummary[]>([]);
  const [selectedStudentCode, setSelectedStudentCode] = useState<string | null>(null);
  const [detail, setDetail] = useState<StaffPatronActiveBorrowsResponse | null>(null);
  const [search, setSearch] = useState("");
  const [filter, setFilter] = useState<BorrowerFilter>("all");
  const [loadingBorrowers, setLoadingBorrowers] = useState(true);
  const [loadingDetail, setLoadingDetail] = useState(false);
  const [returningId, setReturningId] = useState<string | null>(null);
  const [confirmRecord, setConfirmRecord] = useState<BorrowRecord | null>(null);
  const [condition, setCondition] = useState("");
  const [error, setError] = useState("");
  const [snackbar, setSnackbar] = useState<{ severity: "success" | "error" | "warning"; message: string } | null>(null);
  const [scannerOpen, setScannerOpen] = useState(false);
  const [scannedReturns, setScannedReturns] = useState<ScannedReturnItem[]>([]);
  const [batchReturning, setBatchReturning] = useState(false);
  const [scanToast, setScanToast] = useState("");
  const imgRef = useRef<HTMLImageElement>(null);
  const readerRef = useRef<any>(null);
  const [imgReady, setImgReady] = useState(false);
  const [cameraError, setCameraError] = useState("");
  const intervalRef = useRef<ReturnType<typeof setInterval> | null>(null);
  const lastScannedRef = useRef<string | null>(null);
  const debounceRef = useRef<ReturnType<typeof setTimeout> | null>(null);

  const loadBorrowers = useCallback(async () => {
    setLoadingBorrowers(true);
    setError("");
    try {
      const data = await api.getActiveBorrowers();
      setBorrowers(data.items);
      setSelectedStudentCode((current) => {
        if (current && data.items.some((item) => item.patron.student_code === current)) return current;
        return data.items[0]?.patron.student_code ?? null;
      });
    } catch (err: any) {
      setError(getErrorMessage(err) || "Không thể tải danh sách độc giả đang mượn");
    } finally {
      setLoadingBorrowers(false);
    }
  }, []);

  const loadPatronDetail = useCallback(async (studentCode: string) => {
    setLoadingDetail(true);
    setError("");
    try {
      const data = await api.getActiveBorrowsByStudentCode(studentCode);
      setDetail(data);
    } catch (err: any) {
      setDetail(null);
      setError(getErrorMessage(err) || "Không thể tải sách đang mượn của độc giả");
    } finally {
      setLoadingDetail(false);
    }
  }, []);

  useEffect(() => {
    loadBorrowers();
  }, [loadBorrowers]);

  useEffect(() => {
    if (selectedStudentCode) loadPatronDetail(selectedStudentCode);
    else setDetail(null);
    setScannedReturns([]);
  }, [selectedStudentCode, loadPatronDetail]);

  const filteredBorrowers = useMemo(() => {
    const q = search.trim().toLowerCase();
    return borrowers.filter((borrower) => {
      const matchesSearch = !q
        || borrower.patron.student_code.toLowerCase().includes(q)
        || (borrower.patron.full_name || "").toLowerCase().includes(q);
      const matchesFilter = filter === "all"
        || (filter === "overdue" && borrower.overdue_count > 0)
        || (filter === "active" && borrower.overdue_count === 0);
      return matchesSearch && matchesFilter;
    });
  }, [borrowers, filter, search]);

  const totals = useMemo(() => ({
    borrowers: borrowers.length,
    books: borrowers.reduce((sum, item) => sum + item.total_borrowed, 0),
    overdue: borrowers.reduce((sum, item) => sum + item.overdue_count, 0),
  }), [borrowers]);

  const selectedBorrower = useMemo(
    () => borrowers.find((item) => item.patron.student_code === selectedStudentCode) ?? null,
    [borrowers, selectedStudentCode],
  );

  const handleReturnRecord = async () => {
    if (!confirmRecord) return;
    setReturningId(confirmRecord.id);
    setError("");
    try {
      await api.staffReturnBorrowRecord(confirmRecord.id, condition || null);
      setSnackbar({ severity: "success", message: "Trả sách thành công" });
      setCondition("");
      setConfirmRecord(null);
      await loadBorrowers();
      if (selectedStudentCode) await loadPatronDetail(selectedStudentCode);
    } catch (err: any) {
      setSnackbar({ severity: "error", message: getErrorMessage(err) || "Trả sách thất bại" });
    } finally {
      setReturningId(null);
    }
  };

  const handleBatchReturn = async () => {
    if (!scannedReturns.length) return;
    setBatchReturning(true);
    let ok = 0;
    let fail = 0;
    for (const item of scannedReturns) {
      try {
        await api.staffReturnBorrowRecord(item.record.id, item.condition || null);
        ok++;
      } catch {
        fail++;
      }
    }
    setBatchReturning(false);
    setScannerOpen(false);
    setScannedReturns([]);
    setSnackbar({
      severity: fail > 0 ? "warning" : "success",
      message: `Trả ${ok} sách thành công${fail > 0 ? `, ${fail} thất bại` : ""}`,
    });
    await loadBorrowers();
    if (selectedStudentCode) await loadPatronDetail(selectedStudentCode);
  };

  const updateCondition = (isbn: string, value: string) => {
    setScannedReturns((prev) => prev.map((item) =>
      item.isbn === isbn ? { ...item, condition: value } : item
    ));
  };

  const removeScanned = (isbn: string) => {
    setScannedReturns((prev) => prev.filter((item) => item.isbn !== isbn));
  };

  const handleScanned = useCallback((isbn: string) => {
    const normalized = isbn.replace(/-/g, "");
    if (!/^\d{10,13}$/.test(normalized)) return;
    if (normalized === lastScannedRef.current) return;
    lastScannedRef.current = normalized;

    let toast = "";
    setScannedReturns((prev) => {
      if (prev.some((item) => item.isbn === normalized)) {
        toast = `Sách ${normalized} đã có trong danh sách`;
        return prev;
      }
      const match = detail?.records.find((r) => {
        const recordIsbn = (r.book?.isbn || "").replace(/-/g, "");
        return recordIsbn === normalized;
      });
      if (match) {
        toast = `Đã thêm: ${match.book?.title || normalized}`;
        return [...prev, { isbn: normalized, record: match, condition: "" }];
      }
      toast = `Không tìm thấy sách đang mượn: ${normalized}`;
      return prev;
    });
    setScanToast(toast);
    if (debounceRef.current) clearTimeout(debounceRef.current);
    debounceRef.current = setTimeout(() => {
      lastScannedRef.current = null;
    }, 2000);
  }, [detail]);

  const stopScanning = useCallback(() => {
    if (intervalRef.current) {
      clearInterval(intervalRef.current);
      intervalRef.current = null;
    }
  }, []);

  const stopReader = useCallback(() => {
    if (readerRef.current) {
      try { readerRef.current.reset(); } catch {}
      readerRef.current = null;
    }
  }, []);

  useEffect(() => {
    if (!scannerOpen) {
      stopScanning();
      setCameraError("");
      setImgReady(false);
      setScannedReturns([]);
      return;
    }
    setImgReady(false);
    setCameraError("");
  }, [scannerOpen, stopScanning]);

  useEffect(() => {
    if (!imgReady || !imgRef.current) return;
    stopScanning();
    intervalRef.current = setInterval(async () => {
      if (!imgRef.current) return;
      if (!readerRef.current) return;
      const img = imgRef.current;
      if (!img.complete) return;
      try {
        const result = await readerRef.current.decodeFromImageElement(img);
        if (result) {
          handleScanned(result.getText());
        }
      } catch {}
    }, 200);
    return () => stopScanning();
  }, [imgReady, handleScanned, stopScanning]);

  useEffect(() => {
    let active = true;
    (async () => {
      try {
        const { BrowserMultiFormatReader } = await import("@zxing/browser");
        if (!active) return;
        readerRef.current = new BrowserMultiFormatReader();
      } catch (err) {
        console.error("Failed to load ZXing:", err);
      }
    })();
    return () => { active = false; stopReader(); };
  }, []);

  const statBadges = `${totals.borrowers} độc giả | ${totals.books} sách đang mượn | ${totals.overdue} quá hạn`;

  const headerActions = selectedStudentCode ? (
    <Button variant="outlined" size="small" onClick={() => { setSelectedStudentCode(null); setDetail(null); }}
      sx={{ color: "#a5b4fc", borderColor: "rgba(165,180,252,0.4)", "&:hover": { borderColor: "#a5b4fc", bgcolor: "rgba(165,180,252,0.08)" } }}>
      Hủy chọn
    </Button>
  ) : null;

  const statCards = [
    { key: "borrowers", label: "Độc giả", value: totals.borrowers, icon: <UsersIcon sx={{ fontSize: 22 }} />, gradient: "linear-gradient(135deg, #6366f1 0%, #4338ca 100%)", pct: 100 },
    { key: "books", label: "Sách đang mượn", value: totals.books, icon: <BookIcon sx={{ fontSize: 22 }} />, gradient: "linear-gradient(135deg, #3b82f6 0%, #1d4ed8 100%)", pct: 100 },
    { key: "overdue", label: "Quá hạn", value: totals.overdue, icon: <AlertIcon sx={{ fontSize: 22 }} />, gradient: "linear-gradient(135deg, #ef4444 0%, #dc2626 100%)", pct: totals.books ? (totals.overdue / totals.books) * 100 : 0 },
  ];

  return (
    <Stack spacing={3}>
      <PageHeader
        title="Trả sách"
        icon={ReturnIcon}
        gradient="linear-gradient(135deg, #1e1b4b 0%, #312e81 50%, #1e1b4b 100%)"
        statBadges={statBadges}
        onRefresh={loadBorrowers}
        actions={headerActions}
      />

      <Box sx={{ display: "grid", gridTemplateColumns: { xs: "1fr", sm: "repeat(3, 1fr)" }, gap: 2 }}>
        {statCards.map((s, idx) => (
          <Paper key={s.key} variant="outlined" sx={{
            p: 2.5, borderRadius: 3, position: "relative", overflow: "hidden", borderColor: "divider",
            transition: "transform 0.2s, box-shadow 0.2s",
            ...staggerSx(idx),
            "&:hover": { transform: "translateY(-2px)", boxShadow: 4 },
          }}>
            <Box sx={{ position: "absolute", top: 0, right: 0, width: 80, height: 80, background: s.gradient, opacity: 0.12, borderRadius: "0 12px 0 80px" }} />
            <Stack direction="row" spacing={1.5} sx={{ alignItems: "flex-start" }}>
              <Avatar sx={{ background: s.gradient, width: 44, height: 44, boxShadow: "0 4px 12px rgba(0,0,0,0.15)" }}>{s.icon}</Avatar>
              <Box sx={{ flex: 1, minWidth: 0 }}>
                <Typography variant="caption" color="text.secondary" sx={{ fontWeight: 600, textTransform: "uppercase", letterSpacing: 0.5 }}>{s.label}</Typography>
                <Typography variant="h4" sx={{ fontWeight: 800, lineHeight: 1.2 }}>{s.value}</Typography>
              </Box>
            </Stack>
            <LinearProgress variant="determinate" value={s.pct} sx={{ mt: 1.5, height: 3, borderRadius: 2, bgcolor: "action.hover", "& .MuiLinearProgress-bar": { background: s.gradient, borderRadius: 2 } }} />
          </Paper>
        ))}
      </Box>

      {error ? (
        <Slide direction="down" in={!!error} timeout={250}>
          <Alert severity="error" onClose={() => setError("")} sx={{ animation: `${slideInRight} 0.25s ease-out` }}>
            <AlertTitle>Lỗi</AlertTitle>
            {error}
          </Alert>
        </Slide>
      ) : null}

      <Grid container spacing={2}>
        <Grid size={{ xs: 12, md: 5, lg: 4 }} sx={{ display: "flex", flexDirection: "column", gap: 2 }}>
          <DashboardCard>
            <Stack spacing={2}>
              <SearchField value={search} onChange={setSearch} placeholder="Tìm theo MSSV hoặc tên..." />

              <ToggleButtonGroup exclusive fullWidth size="small" value={filter} onChange={(_, value) => value && setFilter(value)}
                sx={{ "& .MuiToggleButton-root": { px: 2, py: 0.6, borderRadius: "20px!important", textTransform: "none", fontWeight: 600, fontSize: "0.78rem", border: "1px solid", borderColor: "divider" } }}>
                <ToggleButton value="all">Tất cả</ToggleButton>
                <ToggleButton value="overdue">Quá hạn</ToggleButton>
                <ToggleButton value="active">Đúng hạn</ToggleButton>
              </ToggleButtonGroup>
            </Stack>
          </DashboardCard>

          {loadingBorrowers ? (
            <DashboardCard>
              <LoadingOverlay loading message="Đang tải danh sách độc giả..." />
            </DashboardCard>
          ) : filteredBorrowers.length === 0 ? (
            <DashboardCard>
              <EmptyState
                icon={<UsersIcon sx={{ fontSize: 48, opacity: 0.3 }} />}
                title="Không tìm thấy độc giả phù hợp"
              />
            </DashboardCard>
          ) : (
            <List disablePadding sx={{ flex: 1, overflowY: "auto", display: "flex", flexDirection: "column", gap: 1 }}>
              {filteredBorrowers.map((borrower, idx) => {
                const selected = borrower.patron.student_code === selectedStudentCode;
                const hasOverdue = borrower.overdue_count > 0;
                return (
                  <Paper
                    key={borrower.patron.id}
                    variant="outlined"
                    onClick={() => setSelectedStudentCode(borrower.patron.student_code)}
                    sx={{
                      cursor: "pointer",
                      p: 1.5,
                      borderRadius: 3,
                      borderLeft: 4,
                      borderLeftColor: hasOverdue ? "error.main" : "success.main",
                      borderColor: selected ? "primary.main" : "divider",
                      bgcolor: selected ? "action.selected" : undefined,
                      transition: "all .15s",
                      ...staggerSx(idx, 0.04),
                      "&:hover": { borderColor: "primary.light", transform: "translateY(-1px)", boxShadow: 2 },
                    }}
                  >
                    <Stack direction="row" spacing={1.5} sx={{ alignItems: "center" }}>
                      <Avatar sx={{ width: 36, height: 36, bgcolor: hasOverdue ? "error.main" : "success.main", fontSize: 13, fontWeight: 700 }}>
                        {borrowerName(borrower)[0]?.toUpperCase() || "?"}
                      </Avatar>
                      <Box sx={{ minWidth: 0, flex: 1 }}>
                        <Typography sx={{ fontWeight: 900, fontSize: 14 }} noWrap>{borrowerName(borrower)}</Typography>
                        <Typography variant="caption" sx={{ fontFamily: "monospace", display: "block" }}>
                          {borrower.patron.student_code}
                        </Typography>
                        <Stack direction="row" spacing={0.5} sx={{ alignItems: "center", mt: 0.3 }}>
                          <Chip size="small" label={`${borrower.total_borrowed} sách`} sx={{ height: 18, fontSize: 10 }} />
                          {hasOverdue ? (
                            <Chip size="small" color="error" label={`${borrower.overdue_count} quá hạn`} sx={{ height: 18, fontSize: 10 }} />
                          ) : (
                            <Chip size="small" color="success" label="Tốt" sx={{ height: 18, fontSize: 10 }} />
                          )}
                        </Stack>
                      </Box>
                      <Typography variant="caption" color="text.secondary" sx={{ textAlign: "right", flexShrink: 0 }}>
                        {formatDate(borrower.nearest_due_at)}
                      </Typography>
                    </Stack>
                  </Paper>
                );
              })}
            </List>
          )}

          {selectedBorrower ? (
            <DashboardCard
              title={borrowerName(selectedBorrower)}
              subtitle={selectedBorrower.patron.student_code}
              actions={<Chip size="small" color="success" label="Đang mượn" icon={<CheckCircleIcon />} />}
            >
              <Stack spacing={2}>
                <Stack direction="row" spacing={1} sx={{ alignItems: "center", flexWrap: "wrap" }}>
                  <Chip size="small" color="primary" label={`${selectedBorrower.total_borrowed} sách`} />
                  {selectedBorrower.overdue_count > 0 ? (
                    <Chip size="small" color="error" label={`${selectedBorrower.overdue_count} quá hạn`} />
                  ) : null}
                </Stack>

                {selectedBorrower.overdue_count > 0 ? (
                  <Alert severity="error" sx={{ py: 0.5 }}>
                    <AlertIcon fontSize="small" sx={{ mr: 0.5 }} />
                    Có {selectedBorrower.overdue_count} cuốn sách quá hạn
                  </Alert>
                ) : null}

                <Button
                  variant="contained"
                  size="large"
                  fullWidth
                  startIcon={<QrCodeScannerIcon />}
                  onClick={() => setScannerOpen(true)}
                >
                  Quét mã vạch trả sách
                </Button>
              </Stack>
            </DashboardCard>
          ) : null}
        </Grid>

        <Grid size={{ xs: 12, md: 7, lg: 8 }} sx={{ display: "flex", flexDirection: "column", gap: 2 }}>
          {selectedBorrower ? (
            <DashboardCard
              title="Sách cần trả"
              actions={detail ? <Chip size="small" label={`${detail.total} cuốn`} /> : null}
            >
              {loadingDetail ? (
                <LoadingOverlay loading message="Đang tải danh sách sách..." />
              ) : !detail || detail.records.length === 0 ? (
                <EmptyState
                  icon={<CheckCircleIcon sx={{ fontSize: 48, color: "success.main" }} />}
                  title="Độc giả đã trả hết sách"
                />
              ) : (
                <Stack spacing={1.5}>
                  {detail.records.map((record, idx) => (
                    <Paper key={record.id} variant="outlined" sx={{
                      p: 1.5,
                      borderRadius: 3,
                      borderLeft: isOverdue(record) ? 4 : 0,
                      borderLeftColor: "error.main",
                      ...staggerSx(idx, 0.05),
                    }}>
                      <Stack direction="row" spacing={1.5} sx={{ alignItems: "flex-start" }}>
                        {record.book?.cover_url ? (
                          <Box component="img" src={record.book.cover_url} alt={record.book.title} sx={{ width: 40, height: 56, objectFit: "cover", borderRadius: 0.5, flexShrink: 0 }} />
                        ) : (
                          <Avatar variant="rounded" sx={{ width: 40, height: 56, bgcolor: "background.default", flexShrink: 0 }}>
                            <BookIcon />
                          </Avatar>
                        )}
                        <Stack spacing={0.3} sx={{ flex: 1, minWidth: 0 }}>
                          <Typography variant="body2" sx={{ fontWeight: 900 }} noWrap>{record.book?.title || record.book_id}</Typography>
                          <Typography variant="caption" color="text.secondary" noWrap>{record.book?.author || "-"}</Typography>
                          <Stack direction="row" spacing={1} sx={{ alignItems: "center", flexWrap: "wrap", gap: 0.5 }}>
                            <Typography variant="caption" sx={{ fontFamily: "monospace", color: "primary.main" }}>{record.book?.isbn}</Typography>
                            {dueChip(record)}
                          </Stack>
                          <Typography variant="caption" color="text.secondary">
                            Mượn: {formatDate(record.borrow_at)} | Hạn: {formatDate(record.due_at)}
                          </Typography>
                        </Stack>
                        <Button
                          size="small"
                          variant="contained"
                          color="success"
                          startIcon={<CheckCircleIcon />}
                          disabled={!!returningId}
                          onClick={() => setConfirmRecord(record)}
                          sx={{ flexShrink: 0 }}
                        >
                          Trả
                        </Button>
                      </Stack>
                    </Paper>
                  ))}
                </Stack>
              )}
            </DashboardCard>
          ) : (
            <DashboardCard>
              <EmptyState
                icon={<UsersIcon sx={{ fontSize: 72, opacity: 0.3 }} />}
                title="Chọn độc giả để xem sách cần trả"
                description="Chọn một độc giả từ danh sách bên trái"
              />
            </DashboardCard>
          )}
        </Grid>
      </Grid>

      <Dialog open={scannerOpen} onClose={batchReturning ? undefined : () => setScannerOpen(false)} fullWidth maxWidth="xl">
        <DialogTitle>
          <Stack direction="row" spacing={1} sx={{ alignItems: "center", justifyContent: "space-between" }}>
            <Stack direction="row" spacing={1} sx={{ alignItems: "center" }}>
              <QrCodeScannerIcon color="primary" />
              <Typography variant="h6" sx={{ fontWeight: 900 }}>Quét mã vạch trả sách (IP Camera)</Typography>
            </Stack>
            {!batchReturning ? (
              <IconButton size="small" onClick={() => setScannerOpen(false)}><CloseIcon fontSize="small" /></IconButton>
            ) : null}
          </Stack>
        </DialogTitle>
        <DialogContent dividers sx={{ p: 2, display: "flex", flexDirection: "column", overflow: "hidden" }}>
          <Box sx={{ display: "flex", gap: 2, flexDirection: { xs: "column", md: "row" }, flex: 1, overflow: "hidden" }}>
            <Box sx={{ width: { md: "50%" }, flexShrink: 0 }}>
              <Box sx={{ position: "relative", width: "100%", aspectRatio: "4/3", bgcolor: "black", borderRadius: 1, overflow: "hidden" }}>
                {cameraError ? (
                  <Stack spacing={1.5} sx={{ alignItems: "center", justifyContent: "center", height: "100%", color: "grey.300", p: 3 }}>
                    <CameraAltIcon sx={{ fontSize: 48 }} />
                    <Typography sx={{ textAlign: "center" }}>{cameraError}</Typography>
                  </Stack>
                ) : (
                  <>
                    <Box component="img" ref={imgRef} src={BORROW_CAM_URL} onLoad={() => setImgReady(true)} onError={() => setCameraError("Không thể kết nối IP Camera")} alt="IP Camera" sx={{ width: "100%", height: "100%", objectFit: "contain" }} />
                    {!imgReady && !cameraError ? (
                      <Stack sx={{ position: "absolute", inset: 0, bgcolor: "rgba(0,0,0,.55)", color: "common.white", alignItems: "center", justifyContent: "center" }} spacing={1}>
                        <CircularProgress size={28} color="inherit" />
                        <Typography variant="body2">Đang kết nối camera...</Typography>
                      </Stack>
                    ) : null}
                    <Box sx={{ position: "absolute", top: 8, left: 8, px: 1, py: 0.5, bgcolor: "rgba(0,0,0,.6)", borderRadius: 0.5 }}>
                      <Typography variant="caption" sx={{ color: "common.white", fontSize: 11 }}>IP Camera</Typography>
                    </Box>
                  </>
                )}
              </Box>
            </Box>

            <Stack spacing={1.5} sx={{ flex: 1, overflow: "auto" }}>
              <Stack direction="row" spacing={1} sx={{ alignItems: "center" }}>
                <QrCodeScannerIcon color="primary" sx={{ fontSize: 20 }} />
                <Typography variant="subtitle2" sx={{ fontWeight: 900 }}>
                  {scannedReturns.length > 0 ? `Đã quét (${scannedReturns.length} cuốn)` : "Sách đã quét"}
                </Typography>
              </Stack>

              {scannedReturns.length === 0 ? (
                <Alert severity="info" sx={{ flex: 1, display: "flex", alignItems: "center" }}>
                  Đưa mã vạch vào camera. Sách sẽ xuất hiện tại đây.
                </Alert>
              ) : (
                scannedReturns.map((item) => (
                  <Paper key={item.isbn} variant="outlined" sx={{ p: 1.5 }}>
                    <Stack direction="row" spacing={1.5} sx={{ alignItems: "flex-start" }}>
                      {item.record.book?.cover_url ? (
                        <Box component="img" src={item.record.book.cover_url} alt={item.record.book.title} sx={{ width: 40, height: 56, objectFit: "cover", borderRadius: 0.5, flexShrink: 0 }} />
                      ) : (
                        <Avatar variant="rounded" sx={{ width: 40, height: 56, bgcolor: "background.default", flexShrink: 0 }}>
                          <BookIcon />
                        </Avatar>
                      )}
                      <Stack spacing={0.3} sx={{ flex: 1, minWidth: 0 }}>
                        <Typography variant="body2" sx={{ fontWeight: 900 }} noWrap>{item.record.book?.title || item.record.book_id}</Typography>
                        {item.record.book?.author ? (
                          <Typography variant="caption" color="text.secondary" noWrap>{item.record.book.author}</Typography>
                        ) : null}
                        <Typography variant="caption" sx={{ fontFamily: "monospace", color: "primary.main" }}>{item.isbn}</Typography>
                        <Stack direction="row" spacing={1} sx={{ alignItems: "center", flexWrap: "wrap" }}>
                          {dueChip(item.record)}
                          {item.condition ? <Chip size="small" variant="outlined" label={item.condition} /> : null}
                        </Stack>
                        <Select value={item.condition} onChange={(e) => updateCondition(item.isbn, e.target.value)} displayEmpty fullWidth size="small" sx={{ mt: 0.5 }}>
                          <MenuItem value="">Tình trạng (tuỳ chọn)</MenuItem>
                          <MenuItem value="Còn mới">Còn mới</MenuItem>
                          <MenuItem value="Bình thường">Bình thường</MenuItem>
                          <MenuItem value="Sách cũ">Sách cũ</MenuItem>
                          <MenuItem value="Rách bìa">Rách bìa</MenuItem>
                          <MenuItem value="Rách trang">Rách trang</MenuItem>
                          <MenuItem value="Thiếu trang">Thiếu trang</MenuItem>
                          <MenuItem value="Ẩm mốc">Ẩm mốc</MenuItem>
                          <MenuItem value="Viết/bôi bẩn">Viết/bôi bẩn</MenuItem>
                          <MenuItem value="Hư hỏng nặng">Hư hỏng nặng</MenuItem>
                        </Select>
                      </Stack>
                      <IconButton size="small" color="error" onClick={() => removeScanned(item.isbn)} sx={{ mt: 0.5 }}>
                        <DeleteIcon fontSize="small" />
                      </IconButton>
                    </Stack>
                  </Paper>
                ))
              )}
            </Stack>
          </Box>
        </DialogContent>
        <DialogActions>
          <Button onClick={() => setScannerOpen(false)} disabled={batchReturning}>Đóng</Button>
          <Button variant="contained" color="success" disabled={batchReturning || scannedReturns.length === 0} onClick={handleBatchReturn}>
            {batchReturning ? "Đang trả sách..." : `Xác nhận trả (${scannedReturns.length} cuốn)`}
          </Button>
        </DialogActions>
      </Dialog>

      <Dialog open={!!confirmRecord} onClose={() => { setConfirmRecord(null); setCondition(""); }}>
        <DialogTitle>Xác nhận trả sách</DialogTitle>
        <DialogContent>
          <DialogContentText sx={{ mb: 2 }}>
            Trả sách "{confirmRecord?.book?.title || confirmRecord?.book_id}" cho độc giả {detail?.patron.full_name || detail?.patron.student_code}?
          </DialogContentText>
          <Select value={condition} onChange={(e) => setCondition(e.target.value)} displayEmpty fullWidth size="small">
            <MenuItem value="">Tình trạng sách (tuỳ chọn)</MenuItem>
            <MenuItem value="Còn mới">Còn mới</MenuItem>
            <MenuItem value="Bình thường">Bình thường</MenuItem>
            <MenuItem value="Sách cũ">Sách cũ</MenuItem>
            <MenuItem value="Rách bìa">Rách bìa</MenuItem>
            <MenuItem value="Rách trang">Rách trang</MenuItem>
            <MenuItem value="Thiếu trang">Thiếu trang</MenuItem>
            <MenuItem value="Ẩm mốc">Ẩm mốc</MenuItem>
            <MenuItem value="Viết/bôi bẩn">Viết/bôi bẩn</MenuItem>
            <MenuItem value="Hư hỏng nặng">Hư hỏng nặng</MenuItem>
          </Select>
        </DialogContent>
        <DialogActions>
          <Button onClick={() => { setConfirmRecord(null); setCondition(""); }}>Hủy</Button>
          <Button variant="contained" color="success" onClick={handleReturnRecord} disabled={!!returningId}>
            {returningId ? "Đang trả..." : "Xác nhận trả"}
          </Button>
        </DialogActions>
      </Dialog>

      <NoticeSnackbar open={!!snackbar} message={snackbar?.message || ""} severity={snackbar?.severity || "success"} onClose={() => setSnackbar(null)} anchorOrigin={{ vertical: "top", horizontal: "right" }} />

      <NoticeSnackbar open={!!scanToast} message={scanToast} severity="success" onClose={() => setScanToast("")} anchorOrigin={{ vertical: "top", horizontal: "right" }} />
    </Stack>
  );
}
</file>

