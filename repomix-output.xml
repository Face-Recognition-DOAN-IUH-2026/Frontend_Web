<file path="src/app/login/page.tsx">
"use client";

import { useCallback, useEffect, useRef, useState } from "react";
import { useRouter } from "next/navigation";
import {
  Alert,
  Box,
  Button,
  CircularProgress,
  Dialog,
  DialogContent,
  IconButton,
  InputAdornment,
  Paper,
  Stack,
  TextField,
  ToggleButton,
  ToggleButtonGroup,
  Typography,
  useTheme,
} from "@mui/material";
import VisibilityIcon from "@mui/icons-material/Visibility";
import VisibilityOffIcon from "@mui/icons-material/VisibilityOff";
import CloseIcon from "@mui/icons-material/Close";
import AutoStoriesOutlinedIcon from "@mui/icons-material/AutoStoriesOutlined";
import CheckCircleOutlineOutlinedIcon from "@mui/icons-material/CheckCircleOutlineOutlined";
import FaceRetouchingNaturalOutlinedIcon from "@mui/icons-material/FaceRetouchingNaturalOutlined";
import LoginOutlinedIcon from "@mui/icons-material/LoginOutlined";
import PhotoCameraOutlinedIcon from "@mui/icons-material/PhotoCameraOutlined";
import StopCircleOutlinedIcon from "@mui/icons-material/StopCircleOutlined";
import { useAuth } from "@/lib/auth-context";
import api, { getErrorMessage } from "@/lib/api-client";
import CameraFallback from "@/app/_components/CameraFallback";
import dynamic from "next/dynamic";
const LoginBackground3D = dynamic(() => import("@/app/login/_components/LoginBackground3D"), { ssr: false });

type LoginMode = "password" | "face";

export default function LoginPage() {
  const theme = useTheme();
  const { login, setAuthFromToken } = useAuth();
  const router = useRouter();
  const [mode, setMode] = useState<LoginMode>("password");
  const [email, setEmail] = useState("");
  const [password, setPassword] = useState("");
  const [showPassword, setShowPassword] = useState(false);
  const [error, setError] = useState("");
  const [isLoading, setIsLoading] = useState(false);
  const [imagePreview, setImagePreview] = useState<string | null>(null);
  const [isCameraOn, setIsCameraOn] = useState(false);
  const [cameraReady, setCameraReady] = useState(false);
  const [success, setSuccess] = useState(false);
  const [showFaceFallback, setShowFaceFallback] = useState(false);

  const [forgotOpen, setForgotOpen] = useState(false);
  const [forgotStep, setForgotStep] = useState<1 | 2 | 3 | 4>(1);
  const [forgotEmail, setForgotEmail] = useState("");
  const [forgotCode, setForgotCode] = useState("");
  const [forgotPassword, setForgotPassword] = useState("");
  const [forgotConfirmPassword, setForgotConfirmPassword] = useState("");
  const [forgotLoading, setForgotLoading] = useState(false);
  const [forgotError, setForgotError] = useState("");
  const [showForgotPassword, setShowForgotPassword] = useState(false);
  const faceFailCountRef = useRef(0);
  const videoRef = useRef<HTMLVideoElement>(null);
  const streamRef = useRef<MediaStream | null>(null);
  const readyTimeoutRef = useRef<ReturnType<typeof setTimeout> | null>(null);
  const autoCaptureTimeoutRef = useRef<ReturnType<typeof setTimeout> | null>(null);
  const frameCaptureRef = useRef<ReturnType<typeof setInterval> | null>(null);
  const lastFaceFrameRef = useRef<string | null>(null);
  const hasFaceCameraWorkedRef = useRef(false);

  const stopCamera = useCallback(() => {
    if (frameCaptureRef.current) {
      clearInterval(frameCaptureRef.current);
      frameCaptureRef.current = null;
    }
    if (streamRef.current) {
      streamRef.current.getTracks().forEach((track) => track.stop());
      streamRef.current = null;
    }
    setIsCameraOn(false);
    setCameraReady(false);
  }, []);

  const resetFaceState = () => {
    setImagePreview(null);
    setShowFaceFallback(false);
  };

  const startCamera = useCallback(async () => {
    try {
      setError("");
      setShowFaceFallback(false);
      setCameraReady(false);
      stopCamera();
      const stream = await navigator.mediaDevices.getUserMedia({
        video: { facingMode: "user", width: { ideal: 640 }, height: { ideal: 480 } },
        audio: false,
      });
      streamRef.current = stream;
      setIsCameraOn(true);
    } catch (err: any) {
      if (err.name === "NotAllowedError") setError("Không có quyền truy cập camera. Hãy cấp quyền camera rồi thử lại.");
      else if (err.name === "NotFoundError") setError("Không tìm thấy camera trên thiết bị.");
      else setError("Không thể truy cập camera.");
      setIsCameraOn(false);
      setShowFaceFallback(true);
    }
  }, [stopCamera]);

  useEffect(() => {
    if (!isCameraOn || !videoRef.current || !streamRef.current) return;
    const video = videoRef.current;
    const onReady = () => {
      setCameraReady(true);
      hasFaceCameraWorkedRef.current = true;
    };
    video.onloadedmetadata = onReady;
    video.onplaying = onReady;
    video.onerror = () => {
      setError("Camera gặp lỗi.");
      setShowFaceFallback(true);
    };
    video.srcObject = streamRef.current;
    if (video.readyState >= 2) {
      onReady();
      hasFaceCameraWorkedRef.current = true;
    }
    readyTimeoutRef.current = setTimeout(() => {
      setCameraReady(true);
      hasFaceCameraWorkedRef.current = true;
    }, 3000);
    return () => {
      if (readyTimeoutRef.current) clearTimeout(readyTimeoutRef.current);
      if (autoCaptureTimeoutRef.current) clearTimeout(autoCaptureTimeoutRef.current);
      video.onloadedmetadata = null;
      video.onplaying = null;
      video.onerror = null;
      video.srcObject = null;
    };
  }, [isCameraOn]);

  useEffect(() => {
    if (!isCameraOn || !cameraReady || !videoRef.current) return;
    frameCaptureRef.current = setInterval(() => {
      const video = videoRef.current;
      if (!video || video.videoWidth === 0 || !streamRef.current) return;
      try {
        const canvas = document.createElement("canvas");
        canvas.width = video.videoWidth;
        canvas.height = video.videoHeight;
        const ctx = canvas.getContext("2d");
        if (!ctx) return;
        ctx.drawImage(video, 0, 0);
        lastFaceFrameRef.current = canvas.toDataURL("image/jpeg", 0.3);
      } catch {
        lastFaceFrameRef.current = null;
      }
    }, 2000);
    return () => {
      if (frameCaptureRef.current) clearInterval(frameCaptureRef.current);
    };
  }, [isCameraOn, cameraReady]);

  useEffect(() => () => stopCamera(), [stopCamera]);

  const doFaceLogin = useCallback(async (file: File) => {
    setError("");
    setIsLoading(true);
    try {
      const res = await api.faceLogin(file);
      if (!res.access_token) throw new Error("Backend did not return access_token");
      const payload = JSON.parse(atob(res.access_token.split(".")[1]));
      const userEmail = payload?.email || "";
      const role = ((payload?.roles as string[])?.[0]) || "user";
      setAuthFromToken(res.access_token, res.refresh_token, userEmail, role);
      setSuccess(true);
      setIsLoading(false);
      faceFailCountRef.current = 0;
      setTimeout(() => { window.location.href = "/dashboard"; }, 500);
    } catch (err: any) {
      const msg = getErrorMessage(err) || "Đăng nhập thất bại.";
      setError(msg);
      setIsLoading(false);
      const newCount = faceFailCountRef.current + 1;
      faceFailCountRef.current = newCount;
      if (newCount >= 2) {
        setMode("password");
        faceFailCountRef.current = 0;
        resetFaceState();
        stopCamera();
        setError(`${msg} Chuyển sang đăng nhập bằng mật khẩu.`);
      } else {
        resetFaceState();
        startCamera();
      }
    }
  }, [router, setAuthFromToken, startCamera, stopCamera]);

  const capturePhoto = useCallback((callback?: (file: File) => void) => {
    const video = videoRef.current;
    if (!video || !cameraReady || video.videoWidth === 0 || video.videoHeight === 0) return;
    const canvas = document.createElement("canvas");
    canvas.width = video.videoWidth;
    canvas.height = video.videoHeight;
    const ctx = canvas.getContext("2d");
    if (!ctx) return;
    ctx.drawImage(video, 0, 0);
    canvas.toBlob((blob) => {
      if (!blob) return;
      const file = new File([blob], "face.jpg", { type: "image/jpeg" });
      setImagePreview(canvas.toDataURL("image/jpeg"));
      callback?.(file);
    }, "image/jpeg", 0.9);
  }, [cameraReady]);

  const autoCapture = useCallback(() => {
    capturePhoto((file) => {
      stopCamera();
      doFaceLogin(file);
    });
  }, [capturePhoto, doFaceLogin, stopCamera]);

  useEffect(() => {
    if (cameraReady && mode === "face" && !imagePreview && !isLoading) {
      autoCaptureTimeoutRef.current = setTimeout(autoCapture, 1500);
    }
    return () => {
      if (autoCaptureTimeoutRef.current) clearTimeout(autoCaptureTimeoutRef.current);
    };
  }, [cameraReady, mode, imagePreview, isLoading, autoCapture]);

  const handlePasswordSubmit = async (event: React.FormEvent) => {
    event.preventDefault();
    setError("");
    setIsLoading(true);
    try {
      await login(email, password);
      window.location.href = "/dashboard";
    } catch (err: any) {
      setError(getErrorMessage(err) || "Đăng nhập thất bại.");
    } finally {
      setIsLoading(false);
    }
  };

  const switchMode = (_event: React.MouseEvent<HTMLElement>, value: LoginMode | null) => {
    if (!value) return;
    setMode(value);
    setError("");
    setShowFaceFallback(false);
    resetFaceState();
    faceFailCountRef.current = 0;
    if (value === "password") stopCamera();
  };

  const handleForgotSendCode = async () => {
    if (!forgotEmail) {
      setForgotError("Vui lòng nhập email");
      return;
    }
    setForgotLoading(true);
    setForgotError("");
    try {
      await api.forgotPassword(forgotEmail);
      setForgotStep(2);
    } catch (err: any) {
      setForgotError(getErrorMessage(err) || "Không thể gửi mã reset");
    } finally {
      setForgotLoading(false);
    }
  };

  const handleVerifyCode = async () => {
    if (!forgotCode || forgotCode.length !== 6) {
      setForgotError("Vui lòng nhập đầy đủ 6 chữ số mã xác minh");
      return;
    }
    setForgotLoading(true);
    setForgotError("");
    try {
      await api.verifyResetCode(forgotEmail, forgotCode);
      setForgotStep(3);
    } catch (err: any) {
      setForgotError(getErrorMessage(err) || "Mã xác minh không hợp lệ");
    } finally {
      setForgotLoading(false);
    }
  };

  const handleForgotReset = async () => {
    if (!forgotPassword || !forgotConfirmPassword) {
      setForgotError("Vui lòng nhập mật khẩu mới");
      return;
    }
    if (forgotPassword !== forgotConfirmPassword) {
      setForgotError("Mật khẩu mới không khớp");
      return;
    }
    if (forgotPassword.length < 6) {
      setForgotError("Mật khẩu phải ít nhất 6 ký tự");
      return;
    }
    setForgotLoading(true);
    setForgotError("");
    try {
      await api.resetPassword(forgotEmail, forgotCode, forgotPassword);
      setForgotStep(4);
    } catch (err: any) {
      setForgotError(getErrorMessage(err) || "Đặt lại mật khẩu thất bại");
    } finally {
      setForgotLoading(false);
    }
  };

  const closeForgotDialog = () => {
    setForgotOpen(false);
    setForgotStep(1);
    setForgotEmail("");
    setForgotCode("");
    setForgotPassword("");
    setForgotConfirmPassword("");
    setForgotError("");
    setShowForgotPassword(false);
  };

  return (
    <>
      <LoginBackground3D />
      <Box
        sx={{
          minHeight: "100vh",
          display: "grid",
          placeItems: "center",
          p: 2,
          position: "relative",
          zIndex: 1,
        }}
      >
      <Paper
        variant="outlined"
        sx={{
          width: "100%",
          maxWidth: 460,
          p: 4,
          background: `linear-gradient(180deg, ${theme.palette.background.paper}, ${theme.palette.background.default})`,
        }}
      >
        <Stack spacing={3}>
          <Stack spacing={1.25} sx={{ alignItems: "center", textAlign: "center" }}>
            <Box sx={{ width: 58, height: 58, borderRadius: 2, bgcolor: "primary.main", color: "primary.contrastText", display: "grid", placeItems: "center" }}>
              <AutoStoriesOutlinedIcon fontSize="large" />
            </Box>
            <Box>
              <Typography variant="h4" sx={{ fontWeight: 900, letterSpacing: 0 }}>THƯ VIỆN IUH</Typography>
              <Typography color="text.secondary">Đăng nhập vào hệ thống quản lý</Typography>
            </Box>
          </Stack>

          <ToggleButtonGroup value={mode} exclusive onChange={switchMode} fullWidth color="primary">
            <ToggleButton value="password">Mật khẩu</ToggleButton>
            <ToggleButton value="face">Khuôn mặt</ToggleButton>
          </ToggleButtonGroup>

          {error && <Alert severity="error">{error}</Alert>}

          {success ? (
            <Alert icon={<CheckCircleOutlineOutlinedIcon />} severity="success">
              Đăng nhập thành công. Đang chuyển hướng...
            </Alert>
          ) : isLoading ? (
            <Stack sx={{ py: 5, alignItems: "center" }} spacing={2}>
              <CircularProgress />
              <Typography color="text.secondary">{mode === "face" ? "Đang xác thực khuôn mặt..." : "Đang đăng nhập..."}</Typography>
            </Stack>
          ) : mode === "password" ? (
            <Box component="form" onSubmit={handlePasswordSubmit}>
              <Stack spacing={2}>
                <TextField label="Email" type="email" value={email} onChange={(event) => setEmail(event.target.value)} autoComplete="email" required fullWidth />
                <TextField label="Mật khẩu" type="password" value={password} onChange={(event) => setPassword(event.target.value)} autoComplete="current-password" required fullWidth />
                <Button type="submit" variant="contained" startIcon={<LoginOutlinedIcon />} size="large" fullWidth>
                  Đăng nhập
                </Button>
                <Typography variant="body2" sx={{ textAlign: "center" }}>
                  <Box
                    component="button"
                    type="button"
                    onClick={() => setForgotOpen(true)}
                    sx={{
                      border: "none",
                      bgcolor: "transparent",
                      color: "primary.main",
                      cursor: "pointer",
                      fontWeight: 600,
                      fontSize: "0.875rem",
                      textDecoration: "underline",
                      "&:hover": { color: "primary.dark" },
                    }}
                  >
                    Quên mật khẩu?
                  </Box>
                </Typography>
              </Stack>
            </Box>
          ) : (
            <Stack spacing={2}>
              <Paper
                variant="outlined"
                sx={{ aspectRatio: "16 / 9", overflow: "hidden", bgcolor: "black", display: "grid", placeItems: "center", position: "relative" }}
              >
                {imagePreview ? (
                  <Box component="img" src={imagePreview} alt="Ảnh khuôn mặt" sx={{ width: "100%", height: "100%", objectFit: "contain" }} />
                ) : showFaceFallback ? (
                  <CameraFallback
                    lastFrameUrl={hasFaceCameraWorkedRef.current ? lastFaceFrameRef.current : null}
                    onRetry={startCamera}
                    showManualInput
                    manualLabel="Email"
                    manualPlaceholder="Nhập email để đăng nhập..."
                    onManualSubmit={(value) => { setEmail(value); setMode("password"); }}
                    showFileUpload={false}
                  />
                ) : isCameraOn ? (
                  <>
                    <Box component="video" ref={videoRef} autoPlay playsInline muted sx={{ width: "100%", height: "100%", objectFit: "contain" }} />
                    {!cameraReady && (
                      <Stack sx={{ position: "absolute", inset: 0, bgcolor: "rgba(0,0,0,.55)", color: "common.white", alignItems: "center", justifyContent: "center" }}>
                        <CircularProgress color="inherit" size={26} />
                        <Typography variant="body2" sx={{ mt: 1 }}>Đang kết nối camera...</Typography>
                      </Stack>
                    )}
                    {cameraReady && (
                      <Box sx={{ position: "absolute", width: 190, height: 190, border: 2, borderColor: "primary.main", borderRadius: "50%", opacity: 0.7 }} />
                    )}
                  </>
                ) : (
                  <Stack spacing={1} sx={{ alignItems: "center", color: "grey.300" }}>
                    <FaceRetouchingNaturalOutlinedIcon sx={{ fontSize: 42 }} />
                    <Typography>Bật camera để đăng nhập bằng khuôn mặt</Typography>
                  </Stack>
                )}
              </Paper>

              {imagePreview ? (
                <Button variant="outlined" onClick={() => { resetFaceState(); startCamera(); }}>
                  Chụp lại
                </Button>
              ) : !isCameraOn ? (
                <Button variant="contained" startIcon={<PhotoCameraOutlinedIcon />} onClick={startCamera}>
                  Bật camera
                </Button>
              ) : (
                <Button color="error" variant="outlined" startIcon={<StopCircleOutlinedIcon />} onClick={stopCamera}>
                  Tắt camera
                </Button>
              )}
            </Stack>
          )}
        </Stack>
      </Paper>

      <Dialog open={forgotOpen} onClose={closeForgotDialog} maxWidth="xs" fullWidth>
        <DialogContent sx={{ p: 3 }}>
          <Box sx={{ display: "flex", justifyContent: "space-between", alignItems: "center", mb: 1 }}>
            <Typography variant="h6" sx={{ fontWeight: 800 }}>
              {forgotStep === 4 ? "Thành công" : "Quên mật khẩu"}
            </Typography>
            <IconButton onClick={closeForgotDialog} size="small">
              <CloseIcon />
            </IconButton>
          </Box>

          {forgotStep < 4 && (
            <Box sx={{ display: "flex", justifyContent: "center", alignItems: "center", mb: 3, mt: 1 }}>
              {[1, 2, 3].map((s) => (
                <Box key={s} sx={{ display: "flex", alignItems: "center" }}>
                  <Box
                    sx={{
                      width: 32, height: 32, borderRadius: "50%",
                      display: "flex", alignItems: "center", justifyContent: "center",
                      fontSize: 14, fontWeight: 700,
                      bgcolor: forgotStep >= s ? "primary.main" : "action.hover",
                      color: forgotStep >= s ? "primary.contrastText" : "text.secondary",
                      transition: "all 0.3s ease",
                    }}
                  >
                    {forgotStep > s ? "✓" : s}
                  </Box>
                  {s < 3 && (
                    <Box sx={{
                      width: 40, height: 2, mx: 0.5,
                      bgcolor: forgotStep > s ? "primary.main" : "action.hover",
                      transition: "background-color 0.3s ease",
                    }} />
                  )}
                </Box>
              ))}
            </Box>
          )}

          {forgotError && (
            <Alert severity="error" sx={{ mb: 2 }}>{forgotError}</Alert>
          )}

          {forgotStep === 1 && (
            <Stack spacing={2}>
              <Typography variant="body2" color="text.secondary">
                Nhập email để nhận mã xác minh.
              </Typography>
              <TextField
                label="Email"
                type="email"
                value={forgotEmail}
                onChange={(e) => setForgotEmail(e.target.value)}
                fullWidth
                autoFocus
              />
              <Button
                variant="contained"
                onClick={handleForgotSendCode}
                disabled={forgotLoading}
                fullWidth
              >
                {forgotLoading ? "Đang gửi..." : "Gửi mã xác minh"}
              </Button>
            </Stack>
          )}

          {forgotStep === 2 && (
            <Stack spacing={2}>
              <Typography variant="body2" color="text.secondary">
                Nhập mã 6 chữ số đã gửi đến <strong>{forgotEmail}</strong>
              </Typography>
              <Box sx={{ display: "flex", gap: 1, justifyContent: "center" }}>
                {[0, 1, 2, 3, 4, 5].map((i) => (
                  <TextField
                    key={i}
                    id={`code-${i}`}
                    value={forgotCode[i] || ""}
                    onChange={(e) => {
                      const val = e.target.value.replace(/\D/g, "");
                      if (val.length > 1) return;
                      const newCode = forgotCode.split("");
                      newCode[i] = val;
                      const code = newCode.join("").slice(0, 6);
                      setForgotCode(code);
                      if (val && i < 5) {
                        setTimeout(() => document.getElementById(`code-${i + 1}`)?.focus(), 10);
                      }
                    }}
                    onKeyDown={(e) => {
                      if (e.key === "Backspace" && !forgotCode[i] && i > 0) {
                        setTimeout(() => document.getElementById(`code-${i - 1}`)?.focus(), 10);
                      }
                    }}
                    slotProps={{ htmlInput: { maxLength: 1, style: { textAlign: "center", fontSize: "1.5rem", fontWeight: 700, width: 44, height: 44, padding: 0 } } }}
                    sx={{ "& fieldset": { borderRadius: 1.5 } }}
                  />
                ))}
              </Box>
              <Button
                variant="contained"
                onClick={handleVerifyCode}
                disabled={forgotLoading || forgotCode.length !== 6}
                fullWidth
              >
                {forgotLoading ? "Đang xác minh..." : "Xác minh mã"}
              </Button>
              <Button
                variant="text"
                size="small"
                onClick={() => { setForgotStep(1); setForgotCode(""); setForgotError(""); }}
              >
                ← Quay lại
              </Button>
            </Stack>
          )}

          {forgotStep === 3 && (
            <Stack spacing={2}>
              <Typography variant="body2" color="text.secondary">
                Tạo mật khẩu mới cho tài khoản của bạn.
              </Typography>
              <TextField
                label="Mật khẩu mới"
                type={showForgotPassword ? "text" : "password"}
                value={forgotPassword}
                onChange={(e) => setForgotPassword(e.target.value)}
                fullWidth
                autoFocus
                slotProps={{
                  input: {
                    endAdornment: (
                      <InputAdornment position="end">
                        <IconButton onClick={() => setShowForgotPassword(!showForgotPassword)} edge="end" size="small">
                          {showForgotPassword ? <VisibilityOffIcon /> : <VisibilityIcon />}
                        </IconButton>
                      </InputAdornment>
                    ),
                  },
                }}
              />
              <TextField
                label="Xác nhận mật khẩu mới"
                type={showForgotPassword ? "text" : "password"}
                value={forgotConfirmPassword}
                onChange={(e) => setForgotConfirmPassword(e.target.value)}
                fullWidth
              />
              <Button
                variant="contained"
                onClick={handleForgotReset}
                disabled={forgotLoading}
                fullWidth
              >
                {forgotLoading ? "Đang xử lý..." : "Đặt lại mật khẩu"}
              </Button>
              <Button
                variant="text"
                size="small"
                onClick={() => { setForgotStep(2); setForgotError(""); setForgotPassword(""); setForgotConfirmPassword(""); }}
              >
                ← Quay lại
              </Button>
            </Stack>
          )}

          {forgotStep === 4 && (
            <Stack spacing={2} sx={{ alignItems: "center", py: 2 }}>
              <Box sx={{ width: 64, height: 64, borderRadius: "50%", bgcolor: "success.light", display: "grid", placeItems: "center" }}>
                <CheckCircleOutlineOutlinedIcon sx={{ fontSize: 40, color: "success.main" }} />
              </Box>
              <Typography variant="h6" sx={{ fontWeight: 700 }}>Đặt lại mật khẩu thành công!</Typography>
              <Typography variant="body2" color="text.secondary" sx={{ textAlign: "center" }}>
                Bạn có thể đăng nhập bằng mật khẩu mới ngay bây giờ.
              </Typography>
              <Button variant="contained" onClick={closeForgotDialog} fullWidth sx={{ mt: 1 }}>
                Quay lại đăng nhập
              </Button>
            </Stack>
          )}
        </DialogContent>
      </Dialog>
    </Box>
    </>
  );
}
</file>

<file path="src/app/(dashboard)/return/page.tsx">
"use client";

import { useCallback, useEffect, useMemo, useRef, useState } from "react";
import {
  Alert,
  AlertTitle,
  Avatar,
  Box,
  Button,
  Chip,
  CircularProgress,
  Dialog,
  DialogActions,
  DialogContent,
  DialogContentText,
  DialogTitle,
  Grid,
  IconButton,
  LinearProgress,
  List,
  MenuItem,
  Paper,
  Select,
  Slide,
  Stack,
  ToggleButton,
  ToggleButtonGroup,
  Typography,
} from "@mui/material";
import AlertIcon from "@mui/icons-material/WarningAmberOutlined";
import BookIcon from "@mui/icons-material/MenuBookOutlined";
import CameraAltIcon from "@mui/icons-material/CameraAltOutlined";
import CheckCircleIcon from "@mui/icons-material/CheckCircleOutlineOutlined";
import CloseIcon from "@mui/icons-material/Close";
import DeleteIcon from "@mui/icons-material/DeleteOutlined";
import RefreshIcon from "@mui/icons-material/RefreshOutlined";
import QrCodeScannerIcon from "@mui/icons-material/QrCodeScannerOutlined";
import ReturnIcon from "@mui/icons-material/AssignmentReturnOutlined";
import UsersIcon from "@mui/icons-material/GroupsOutlined";
import api, { getErrorMessage } from "@/lib/api-client";
import { slideInRight } from "@/lib/animations";
import { staggerSx } from "@/lib/useStaggeredAnimation";
import PageHeader from "@/app/(dashboard)/_components/ui/PageHeader";
import DashboardCard from "@/app/(dashboard)/_components/ui/DashboardCard";
import EmptyState from "@/app/(dashboard)/_components/ui/EmptyState";
import LoadingOverlay from "@/app/(dashboard)/_components/ui/LoadingOverlay";
import SearchField from "@/app/(dashboard)/_components/ui/SearchField";
import OverdueGuideModal from "@/app/(dashboard)/_components/OverdueGuideModal";
import notification from "antd/es/notification";
import type { BorrowRecord, StaffActiveBorrowerSummary, StaffPatronActiveBorrowsResponse } from "@/lib/types";

const _RAW_CAM_URL = process.env.NEXT_PUBLIC_BORROW_CAM_URL;
if (!_RAW_CAM_URL) throw new Error("NEXT_PUBLIC_BORROW_CAM_URL is not set");
const RAW_CAM_URL: string = _RAW_CAM_URL;
const BORROW_CAM_URL = `/api/camera/proxy?url=${encodeURIComponent(RAW_CAM_URL)}`;

type BorrowerFilter = "all" | "overdue" | "active";

function isOverdue(record: BorrowRecord) {
  return new Date(record.due_at) < new Date();
}

function daysUntil(value: string) {
  const today = new Date();
  const due = new Date(value);
  today.setHours(0, 0, 0, 0);
  due.setHours(0, 0, 0, 0);
  return Math.ceil((due.getTime() - today.getTime()) / 86400000);
}

function formatDate(value?: string) {
  if (!value) return "-";
  return new Date(value).toLocaleDateString("vi-VN");
}

function borrowerName(borrower: StaffActiveBorrowerSummary) {
  return borrower.patron.full_name || borrower.patron.student_code || "Không rõ tên";
}

function dueChip(record: BorrowRecord) {
  const left = daysUntil(record.due_at);
  if (left < 0) return <Chip size="small" color="error" label={`Quá hạn ${Math.abs(left)} ngày`} />;
  if (left <= 2) return <Chip size="small" color="warning" label="Sắp đến hạn" />;
  return <Chip size="small" color="success" label="Đúng hạn" />;
}

interface ScannedReturnItem {
  isbn: string;
  record: BorrowRecord;
  condition: string;
}

export default function ReturnPage() {
  const [apiAnt, contextHolder] = notification.useNotification();
  const [borrowers, setBorrowers] = useState<StaffActiveBorrowerSummary[]>([]);
  const [selectedStudentCode, setSelectedStudentCode] = useState<string | null>(null);
  const [detail, setDetail] = useState<StaffPatronActiveBorrowsResponse | null>(null);
  const [search, setSearch] = useState("");
  const [filter, setFilter] = useState<BorrowerFilter>("all");
  const [loadingBorrowers, setLoadingBorrowers] = useState(true);
  const [loadingDetail, setLoadingDetail] = useState(false);
  const [returningId, setReturningId] = useState<string | null>(null);
  const [confirmRecord, setConfirmRecord] = useState<BorrowRecord | null>(null);
  const [condition, setCondition] = useState("");
  const [error, setError] = useState("");
  const [scannerOpen, setScannerOpen] = useState(false);
  const [overdueGuideOpen, setOverdueGuideOpen] = useState(false);
  const [scannedReturns, setScannedReturns] = useState<ScannedReturnItem[]>([]);
  const [batchReturning, setBatchReturning] = useState(false);
  const imgRef = useRef<HTMLImageElement>(null);
  const readerRef = useRef<any>(null);
  const [imgReady, setImgReady] = useState(false);
  const [cameraError, setCameraError] = useState("");
  const intervalRef = useRef<ReturnType<typeof setInterval> | null>(null);
  const lastScannedRef = useRef<string | null>(null);
  const debounceRef = useRef<ReturnType<typeof setTimeout> | null>(null);
  const reconnectTimerRef = useRef<ReturnType<typeof setTimeout> | null>(null);

  const loadBorrowers = useCallback(async () => {
    setLoadingBorrowers(true);
    setError("");
    try {
      const data = await api.getActiveBorrowers();
      setBorrowers(data.items);
      setSelectedStudentCode((current) => {
        if (current && data.items.some((item) => item.patron.student_code === current)) return current;
        return data.items[0]?.patron.student_code ?? null;
      });
    } catch (err: any) {
      setError(getErrorMessage(err) || "Không thể tải danh sách độc giả đang mượn");
    } finally {
      setLoadingBorrowers(false);
    }
  }, []);

  const loadPatronDetail = useCallback(async (studentCode: string) => {
    setLoadingDetail(true);
    setError("");
    try {
      const data = await api.getActiveBorrowsByStudentCode(studentCode);
      setDetail(data);
    } catch (err: any) {
      setDetail(null);
      setError(getErrorMessage(err) || "Không thể tải sách đang mượn của độc giả");
    } finally {
      setLoadingDetail(false);
    }
  }, []);

  useEffect(() => {
    loadBorrowers();
  }, [loadBorrowers]);

  useEffect(() => {
    if (selectedStudentCode) loadPatronDetail(selectedStudentCode);
    else setDetail(null);
    setScannedReturns([]);
  }, [selectedStudentCode, loadPatronDetail]);

  const filteredBorrowers = useMemo(() => {
    const q = search.trim().toLowerCase();
    return borrowers.filter((borrower) => {
      const matchesSearch = !q
        || borrower.patron.student_code.toLowerCase().includes(q)
        || (borrower.patron.full_name || "").toLowerCase().includes(q);
      const matchesFilter = filter === "all"
        || (filter === "overdue" && borrower.overdue_count > 0)
        || (filter === "active" && borrower.overdue_count === 0);
      return matchesSearch && matchesFilter;
    });
  }, [borrowers, filter, search]);

  const totals = useMemo(() => ({
    borrowers: borrowers.length,
    books: borrowers.reduce((sum, item) => sum + item.total_borrowed, 0),
    overdue: borrowers.reduce((sum, item) => sum + item.overdue_count, 0),
  }), [borrowers]);

  const selectedBorrower = useMemo(
    () => borrowers.find((item) => item.patron.student_code === selectedStudentCode) ?? null,
    [borrowers, selectedStudentCode],
  );

  const handleReturnRecord = async () => {
    if (!confirmRecord) return;
    setReturningId(confirmRecord.id);
    setError("");
    try {
      await api.staffReturnBorrowRecord(confirmRecord.id, condition || null);
      apiAnt.success({ title: "Trả sách thành công", placement: "topRight" });
      setCondition("");
      setConfirmRecord(null);
      await loadBorrowers();
      if (selectedStudentCode) await loadPatronDetail(selectedStudentCode);
    } catch (err: any) {
      apiAnt.error({ title: getErrorMessage(err) || "Trả sách thất bại", placement: "topRight" });
    } finally {
      setReturningId(null);
    }
  };

  const handleBatchReturn = async () => {
    if (!scannedReturns.length) return;
    setBatchReturning(true);
    let ok = 0;
    let fail = 0;
    for (const item of scannedReturns) {
      try {
        await api.staffReturnBorrowRecord(item.record.id, item.condition || null);
        ok++;
      } catch {
        fail++;
      }
    }
    setBatchReturning(false);
    setScannerOpen(false);
    setScannedReturns([]);
    apiAnt[fail > 0 ? "warning" : "success"]({
      message: `Trả ${ok} sách thành công${fail > 0 ? `, ${fail} thất bại` : ""}`,
      placement: "topRight",
    });
    await loadBorrowers();
    if (selectedStudentCode) await loadPatronDetail(selectedStudentCode);
  };

  const updateCondition = (isbn: string, value: string) => {
    setScannedReturns((prev) => prev.map((item) =>
      item.isbn === isbn ? { ...item, condition: value } : item
    ));
  };

  const removeScanned = (isbn: string) => {
    setScannedReturns((prev) => prev.filter((item) => item.isbn !== isbn));
  };

  const handleScanned = useCallback((isbn: string) => {
    const normalized = isbn.replace(/-/g, "");
    if (normalized.length < 4) return;
    if (normalized === lastScannedRef.current) return;
    lastScannedRef.current = normalized;

    let toast = "";
    setScannedReturns((prev) => {
      if (prev.some((item) => item.isbn === normalized)) {
        toast = `Sách ${normalized} đã có trong danh sách`;
        return prev;
      }
      const match = detail?.records.find((r) => {
        const recordIsbn = (r.book?.isbn || "").replace(/-/g, "");
        return recordIsbn === normalized;
      });
      if (match) {
        toast = `Đã thêm: ${match.book?.title || normalized}`;
        return [...prev, { isbn: normalized, record: match, condition: "" }];
      }
      toast = `Độc giả không mượn sách: ${normalized}`;
      return prev;
    });
    if (toast) {
      const isDuplicate = toast.includes("đã có trong danh sách");
      apiAnt[toast.startsWith("Đã thêm") ? "success" : "warning"]({
        message: toast,
        placement: "topRight",
        duration: isDuplicate ? 3.5 : 2,
      });
    }
    if (debounceRef.current) clearTimeout(debounceRef.current);
    debounceRef.current = setTimeout(() => {
      lastScannedRef.current = null;
    }, 1200);
  }, [detail, apiAnt]);

  const loadingRef = useRef(false);
  const pollTimerRef = useRef<ReturnType<typeof setTimeout> | null>(null);

  const loadNextFrame = useCallback(() => {
    if (!imgRef.current || loadingRef.current) return;
    loadingRef.current = true;
    const sep = BORROW_CAM_URL.includes("?") ? "&" : "?";
    imgRef.current.src = `${BORROW_CAM_URL}${sep}_t=${Date.now()}`;
  }, []);

  const stopPolling = useCallback(() => {
    if (pollTimerRef.current) {
      clearTimeout(pollTimerRef.current);
      pollTimerRef.current = null;
    }
    loadingRef.current = false;
  }, []);

  const stopScanning = useCallback(() => {
    if (intervalRef.current) {
      clearInterval(intervalRef.current);
      intervalRef.current = null;
    }
  }, []);

  const stopAll = useCallback(() => {
    stopScanning();
    stopPolling();
  }, [stopScanning, stopPolling]);

  const stopReader = useCallback(() => {
    if (readerRef.current) {
      try { readerRef.current.reset(); } catch {}
      readerRef.current = null;
    }
  }, []);

  useEffect(() => {
    if (!scannerOpen) {
      stopAll();
      if (reconnectTimerRef.current) clearTimeout(reconnectTimerRef.current);
      setCameraError("");
      setImgReady(false);
      setScannedReturns([]);
      return;
    }
    setImgReady(false);
    setCameraError("");
    loadNextFrame();
  }, [scannerOpen, stopAll, loadNextFrame]);

  useEffect(() => {
    if (!imgReady || !imgRef.current) return;
    stopScanning();
    intervalRef.current = setInterval(() => {
      if (!imgRef.current || !readerRef.current) return;
      const img = imgRef.current;
      if (!img.complete || !(img.naturalWidth || img.width)) return;
      readerRef.current.decodeFromImageElement(img)
        .then((result: any) => { if (result) handleScanned(result.getText()); })
        .catch(() => {});
    }, 200);
    return () => stopScanning();
  }, [imgReady, handleScanned, stopScanning]);

  useEffect(() => {
    let active = true;
    (async () => {
      try {
        const { BrowserMultiFormatReader } = await import("@zxing/browser");
        if (!active) return;
        readerRef.current = new BrowserMultiFormatReader();
      } catch (err) {
        console.error("Failed to load ZXing:", err);
      }
    })();
    return () => { active = false; stopReader(); };
  }, []);

  const statBadges = `${totals.borrowers} độc giả | ${totals.books} sách đang mượn | ${totals.overdue} quá hạn`;

  const headerActions = selectedStudentCode ? (
    <Button variant="outlined" size="small" onClick={() => { setSelectedStudentCode(null); setDetail(null); }}
      sx={{ color: "#a5b4fc", borderColor: "rgba(165,180,252,0.4)", "&:hover": { borderColor: "#a5b4fc", bgcolor: "rgba(165,180,252,0.08)" } }}>
      Hủy chọn
    </Button>
  ) : null;

  const statCards = [
    { key: "borrowers", label: "Độc giả", value: totals.borrowers, icon: <UsersIcon sx={{ fontSize: 22 }} />, gradient: "linear-gradient(135deg, #6366f1 0%, #4338ca 100%)", pct: 100 },
    { key: "books", label: "Sách đang mượn", value: totals.books, icon: <BookIcon sx={{ fontSize: 22 }} />, gradient: "linear-gradient(135deg, #3b82f6 0%, #1d4ed8 100%)", pct: 100 },
    { key: "overdue", label: "Quá hạn", value: totals.overdue, icon: <AlertIcon sx={{ fontSize: 22 }} />, gradient: "linear-gradient(135deg, #ef4444 0%, #dc2626 100%)", pct: totals.books ? (totals.overdue / totals.books) * 100 : 0 },
  ];

  return (
    <Stack spacing={3}>
      <PageHeader
        title="Trả sách"
        icon={ReturnIcon}
        gradient="linear-gradient(135deg, #1e1b4b 0%, #312e81 50%, #1e1b4b 100%)"
        statBadges={statBadges}
        onRefresh={loadBorrowers}
        actions={headerActions}
      />

      <Box sx={{ display: "grid", gridTemplateColumns: { xs: "1fr", sm: "repeat(3, 1fr)" }, gap: 2 }}>
        {statCards.map((s, idx) => (
          <Paper key={s.key} variant="outlined" sx={{
            p: 2.5, borderRadius: 3, position: "relative", overflow: "hidden", borderColor: "divider",
            transition: "transform 0.2s, box-shadow 0.2s",
            ...staggerSx(idx),
            "&:hover": { transform: "translateY(-2px)", boxShadow: 4 },
          }}>
            <Box sx={{ position: "absolute", top: 0, right: 0, width: 80, height: 80, background: s.gradient, opacity: 0.12, borderRadius: "0 12px 0 80px" }} />
            <Stack direction="row" spacing={1.5} sx={{ alignItems: "flex-start" }}>
              <Avatar sx={{ background: s.gradient, width: 44, height: 44, boxShadow: "0 4px 12px rgba(0,0,0,0.15)" }}>{s.icon}</Avatar>
              <Box sx={{ flex: 1, minWidth: 0 }}>
                <Typography variant="caption" color="text.secondary" sx={{ fontWeight: 600, textTransform: "uppercase", letterSpacing: 0.5 }}>{s.label}</Typography>
                <Typography variant="h4" sx={{ fontWeight: 800, lineHeight: 1.2 }}>{s.value}</Typography>
              </Box>
            </Stack>
            <LinearProgress variant="determinate" value={s.pct} sx={{ mt: 1.5, height: 3, borderRadius: 2, bgcolor: "action.hover", "& .MuiLinearProgress-bar": { background: s.gradient, borderRadius: 2 } }} />
          </Paper>
        ))}
      </Box>

      {error ? (
        <Slide direction="down" in={!!error} timeout={250}>
          <Alert severity="error" onClose={() => setError("")} sx={{ animation: `${slideInRight} 0.25s ease-out` }}>
            <AlertTitle>Lỗi</AlertTitle>
            {error}
          </Alert>
        </Slide>
      ) : null}

      <Grid container spacing={2}>
        <Grid size={{ xs: 12, md: 5, lg: 4 }} sx={{ display: "flex", flexDirection: "column", gap: 2 }}>
          <DashboardCard>
            <Stack spacing={2}>
              <SearchField value={search} onChange={setSearch} placeholder="Tìm theo MSSV hoặc tên..." />

              <ToggleButtonGroup exclusive fullWidth size="small" value={filter} onChange={(_, value) => value && setFilter(value)}
                sx={{ "& .MuiToggleButton-root": { px: 2, py: 0.6, borderRadius: "20px!important", textTransform: "none", fontWeight: 600, fontSize: "0.78rem", border: "1px solid", borderColor: "divider" } }}>
                <ToggleButton value="all">Tất cả</ToggleButton>
