    const w: string[] = [];
    const selectedStaff = staff.find((s) => s.id === staffId);
    if (!selectedStaff) return w;
    const existAsg = dayAssignments.find((a) => a.staffId === staffId);
    if (existAsg) {
      const existShift = shifts.find((sh) => sh.id === existAsg.shiftId);
      const newStart = shift?.startTime?.slice(0, 5);
      const newEnd = shift?.endTime?.slice(0, 5);
      const existStart = existShift?.startTime?.slice(0, 5);
      const existEnd = existShift?.endTime?.slice(0, 5);
      const isOverlap = newStart && newEnd && existStart && existEnd && (newStart < existEnd && newEnd > existStart);
      if (isOverlap) {
        w.push(`${selectedStaff.fullName || selectedStaff.email} đã có ca ${existShift?.name || existAsg.shiftId} trùng giờ`);
      }
    }
    return w;
  };

  const handleAssign = async () => {
    try {
      const values = await form.validateFields();
      const w = gatherWarnings(values.staffId);
      if (w.length > 0 && !forceSave) {
        setWarnings(w);
        return;
      }
      setSaving(true);
      setError(null);
      setWarnings([]);
      const params: any = { staffId: values.staffId, shiftId, zoneId: values.zoneId, workDate: date };
      if (forceSave && w.length > 0) params.force = true;
      await api.createScheduleAssignment(params);
      apiAnt.success({ title: "Phân ca thành công", placement: "topRight" });
      reset();
      onAssigned();
    } catch (err: any) {
      if (err?.errorFields) return;
      const data = err?.response?.data;
      setError(data?.error || data?.message || data?.detail?.[0]?.message || err?.message || "Có lỗi xảy ra");
    } finally {
      setSaving(false);
    }
  };

  const getStaffLabel = (s: ScheduleStaff) => {
    const existAsg = dayAssignments.find((a) => a.staffId === s.id);
    if (existAsg) {
      const existShift = shifts.find((sh) => sh.id === existAsg.shiftId);
      const newStart = shift?.startTime?.slice(0, 5);
      const newEnd = shift?.endTime?.slice(0, 5);
      const existStart = existShift?.startTime?.slice(0, 5);
      const existEnd = existShift?.endTime?.slice(0, 5);
      const isOverlap = newStart && newEnd && existStart && existEnd && (newStart < existEnd && newEnd > existStart);

      if (isOverlap) {
        return `${s.fullName || s.email} (⚠ Trùng ca: ${existShift?.name || existAsg.shiftId})`;
      }
      return `${s.fullName || s.email} (Đã có ca: ${existShift?.name || existAsg.shiftId})`;
    }
    return s.fullName || s.email;
  };

  return (
    <Modal
      open={open}
      onCancel={() => { reset(); onClose(); }}
      title="Phân ca trực"
      width={420}
      footer={
        <div style={{ display: "flex", justifyContent: "flex-end", gap: 8 }}>
          <Button onClick={() => { reset(); onClose(); }} disabled={saving}>Hủy</Button>
          <Button
            type="primary"
            loading={saving}
            disabled={availableStaff.length === 0}
            onClick={handleAssign}
          >
            Xếp ca
          </Button>
        </div>
      }
    >
      <div style={{ display: "flex", gap: 8, marginBottom: 16, fontSize: "0.75rem" }}>
        <span style={{ color: isDark ? "#B8B0A4" : "#344054" }}>Ngày: {date}</span>
        <span style={{ color: "#1A73E8", fontWeight: 600 }}>Ca: {shiftName}</span>
        {shift && (
          <span style={{ color: isDark ? "#B8B0A4" : "#999" }}>
            {shift.startTime?.slice(0, 5)} – {shift.endTime?.slice(0, 5)}
          </span>
        )}
      </div>

      <Form
        form={form}
        layout="vertical"
        initialValues={{ zoneId: undefined, staffId: undefined, forceSave: false }}
        requiredMark={false}
        size="middle"
      >
        <Form.Item
          name="zoneId"
          label="Khu vực"
          rules={[{ required: true, message: "Vui lòng chọn khu vực" }]}
        >
          <Select
            placeholder="Chọn khu vực"
            options={zones.map((z) => ({ value: z.id, label: z.zoneName }))}
            allowClear
          />
        </Form.Item>

        <Form.Item
          name="staffId"
          label={
            <span>
              Nhân viên
              {availableStaff.length < staff.length && (
                <span style={{ fontWeight: 400, color: isDark ? "#B8B0A4" : "#999", marginLeft: 4 }}>
                  ({staff.length - availableStaff.length} đã xếp)
                </span>
              )}
            </span>
          }
          rules={[{ required: true, message: "Vui lòng chọn nhân viên" }]}
        >
          <Select
            placeholder="Chọn nhân viên"
            options={availableStaff.map((s) => ({ value: s.id, label: getStaffLabel(s) }))}
            notFoundContent="Tất cả nhân viên đã được xếp"
            allowClear
          />
        </Form.Item>
      </Form>

      {error && <Alert message={error} type="error" showIcon closable onClose={() => setError(null)} style={{ marginBottom: 12 }} />}

      {warnings.length > 0 && (
        <div style={{ marginBottom: 12 }}>
          <Alert
            type="warning"
            showIcon
            description={warnings.map((w, i) => <div key={i}>⚠ {w}</div>)}
            style={{ marginBottom: 8 }}
          />
          <Checkbox checked={forceSave} onChange={(e) => setForceSave(e.target.checked)}>
            Vẫn xếp ca bất chấp cảnh báo
          </Checkbox>
        </div>
      )}

      {contextHolder}
    </Modal>
  );
}
</file>

<file path="src/app/(dashboard)/_components/staff-schedule/AutoScheduleDialog.tsx">
"use client";

import { useState, useMemo, useEffect } from "react";
import Modal from "antd/es/modal";
import Button from "antd/es/button";
import Checkbox from "antd/es/checkbox";
import Steps from "antd/es/steps";
import DatePicker from "antd/es/date-picker";
import Tag from "antd/es/tag";
import dayjs from "dayjs";
import { useColorMode } from "@/lib/mui-theme";

const { RangePicker } = DatePicker;

function toDateInput(date: Date): string {
  const y = date.getFullYear();
  const m = String(date.getMonth() + 1).padStart(2, "0");
  const d = String(date.getDate()).padStart(2, "0");
  return `${y}-${m}-${d}`;
}

function formatDisplayDate(iso: string): string {
  const [y, m, d] = iso.split("-");
  return `${d}/${m}/${y}`;
}

function getMonday(d: Date): Date {
  const date = new Date(d);
  const day = date.getDay();
  const diff = date.getDate() - day + (day === 0 ? -6 : 1);
  date.setDate(diff);
  return date;
}

function getEndOfMonth(year: number, month: number): Date {
  return new Date(year, month + 1, 0);
}

interface QuickOption {
  label: string;
  sub: string;
  from: string;
  to: string;
}

function getQuickOptions(): QuickOption[] {
  const now = new Date();
  const monday = getMonday(now);
  const sunday = new Date(monday);
  sunday.setDate(monday.getDate() + 6);

  const nextMonday = new Date(monday);
  nextMonday.setDate(monday.getDate() + 7);
  const nextSunday = new Date(nextMonday);
  nextSunday.setDate(nextMonday.getDate() + 6);

  const monthStart = new Date(now.getFullYear(), now.getMonth(), 1);
  const monthEnd = getEndOfMonth(now.getFullYear(), now.getMonth());

  const nextMonthStart = new Date(now.getFullYear(), now.getMonth() + 1, 1);
  const nextMonthEnd = getEndOfMonth(now.getFullYear(), now.getMonth() + 1);

  const yearStart = new Date(now.getFullYear(), 0, 1);
  const yearEnd = new Date(now.getFullYear(), 11, 31);

  return [
    { label: "Tuần này", sub: `${monday.getDate()}/${monday.getMonth() + 1} — ${sunday.getDate()}/${sunday.getMonth() + 1}`, from: toDateInput(monday), to: toDateInput(sunday) },
    { label: "Tuần sau", sub: `${nextMonday.getDate()}/${nextMonday.getMonth() + 1} — ${nextSunday.getDate()}/${nextSunday.getMonth() + 1}`, from: toDateInput(nextMonday), to: toDateInput(nextSunday) },
    { label: "Tháng này", sub: `Tháng ${now.getMonth() + 1}/${now.getFullYear()}`, from: toDateInput(monthStart), to: toDateInput(monthEnd) },
    { label: "Tháng sau", sub: `Tháng ${now.getMonth() + 2 > 12 ? 1 : now.getMonth() + 2}/${now.getMonth() + 2 > 12 ? now.getFullYear() + 1 : now.getFullYear()}`, from: toDateInput(nextMonthStart), to: toDateInput(nextMonthEnd) },
    { label: "Năm nay", sub: `${now.getFullYear()}`, from: toDateInput(yearStart), to: toDateInput(yearEnd) },
  ];
}

interface ProposedItem {
  staffId: string;
  shiftId: string;
  zoneId: string;
  workDate: string;
  note: string;
  staffName?: string;
  shiftName?: string;
  zoneName?: string;
}

interface Props {
  open: boolean;
  onClose: () => void;
  onConfirm: (from: string, to: string) => void;
  onConfirmFinal: (selected: ProposedItem[]) => void;
  loading?: boolean;
  step: "select" | "preview";
  proposals: ProposedItem[];
  skippedCount: number;
  actualRange?: { from: string; to: string } | null;
}

export default function AutoScheduleDialog({ open, onClose, onConfirm, onConfirmFinal, loading, step, proposals, skippedCount, actualRange }: Props) {
  const { effectiveMode } = useColorMode();
  const isDark = effectiveMode === "dark";
  const [selected, setSelected] = useState<number | null>(0);
  const [useCustom, setUseCustom] = useState(false);
  const [customRange, setCustomRange] = useState<[dayjs.Dayjs | null, dayjs.Dayjs | null] | null>(null);
  const [checkedSet, setCheckedSet] = useState<Set<number>>(new Set());
  const options = getQuickOptions();

  useEffect(() => {
    if (step === "preview" && proposals.length > 0) {
      const initial = new Set<number>();
      for (let i = 0; i < Math.min(proposals.length, 50); i++) initial.add(i);
      setCheckedSet(initial);
    } else if (step === "select") {
      setCheckedSet(new Set());
    }
  }, [step, proposals.length]);

  const displayProposals = useMemo(() => proposals.slice(0, 50), [proposals]);

  const allChecked = displayProposals.length > 0 && displayProposals.every((_, i) => checkedSet.has(i));
  const selectedCount = useMemo(() => {
    let count = 0;
    for (let i = 0; i < displayProposals.length; i++) {
      if (checkedSet.has(i)) count++;
    }
    for (let i = displayProposals.length; i < proposals.length; i++) {
      count++;
    }
    return count;
  }, [checkedSet, displayProposals.length, proposals.length]);

  const toggleAll = () => {
    if (allChecked) {
      setCheckedSet(new Set());
    } else {
      const next = new Set<number>();
      for (let i = 0; i < displayProposals.length; i++) next.add(i);
      setCheckedSet(next);
    }
  };

  const toggleRow = (idx: number) => {
    const next = new Set(checkedSet);
    if (next.has(idx)) {
      next.delete(idx);
    } else {
      next.add(idx);
    }
    setCheckedSet(next);
  };

  const handleSelectConfirm = () => {
    if (useCustom) {
      if (!customRange || !customRange[0] || !customRange[1]) return;
      onConfirm(customRange[0].format("YYYY-MM-DD"), customRange[1].format("YYYY-MM-DD"));
    } else if (selected !== null) {
      onConfirm(options[selected].from, options[selected].to);
    }
  };

  const handleConfirmFinal = () => {
    const selectedItems: ProposedItem[] = [];
    for (let i = 0; i < proposals.length; i++) {
      if (i < displayProposals.length) {
        if (checkedSet.has(i)) selectedItems.push(proposals[i]);
      } else {
        selectedItems.push(proposals[i]);
      }
    }
    onConfirmFinal(selectedItems);
  };

  return (
    <Modal
      open={open}
      onCancel={onClose}
      width={step === "preview" ? 640 : 480}
      title={step === "select" ? "Gợi ý lịch tự động" : `Xác nhận tạo ${selectedCount} ca`}
      footer={
        <div style={{ display: "flex", justifyContent: "flex-end", gap: 8 }}>
          <Button onClick={onClose} disabled={loading}>
            {step === "preview" ? "Hủy" : "Đóng"}
          </Button>
          {step === "select" ? (
            <Button
              type="primary"
              onClick={handleSelectConfirm}
              disabled={useCustom ? !customRange || !customRange[0] || !customRange[1] : selected === null}
              style={{ background: "#f59e0b", borderColor: "#f59e0b" }}
            >
              Xem đề xuất
            </Button>
          ) : (
            <Button
              type="primary"
              onClick={handleConfirmFinal}
              loading={loading}
              disabled={selectedCount === 0}
              style={{ background: "#10b981", borderColor: "#10b981" }}
            >
              {loading ? "Đang tạo..." : `Xác nhận tạo ${selectedCount} ca`}
            </Button>
          )}
        </div>
      }
      mask={{ closable: !loading }}
    >
      {step === "select" ? (
        <div>
          <div style={{ marginBottom: 12 }}>
            <div style={{ fontSize: "0.75rem", fontWeight: 600, color: isDark ? "#B8B0A4" : "#344054", marginBottom: 8 }}>Chọn nhanh:</div>
            <div style={{ display: "grid", gridTemplateColumns: "repeat(3, 1fr)", gap: 8 }}>
              {options.map((opt, i) => (
                <div
                  key={i}
                  onClick={() => { setSelected(i); setUseCustom(false); }}
                  style={{
                    display: "flex", flexDirection: "column", alignItems: "center", gap: 4, padding: 12, borderRadius: 8,
                    border: `2px solid ${!useCustom && selected === i ? "#f59e0b" : isDark ? "#2E3345" : "#D0D7E2"}`,
                    background: !useCustom && selected === i ? "rgba(245,158,11,0.08)" : isDark ? "rgba(255,255,255,0.03)" : "#F5F7FA",
                    cursor: "pointer", transition: "all 0.15s",
                  }}
                >
                  <div style={{ fontWeight: 600, fontSize: "0.75rem", color: !useCustom && selected === i ? "#f59e0b" : isDark ? "#EDE2DF" : "#101828" }}>
                    {opt.label}
                  </div>
                  <div style={{ fontSize: "0.65rem", color: isDark ? "#B8B0A4" : "#999" }}>
                    {opt.sub}
                  </div>
                </div>
              ))}
            </div>
          </div>

          <div>
            <div style={{ fontSize: "0.75rem", fontWeight: 600, color: isDark ? "#B8B0A4" : "#344054", marginBottom: 8 }}>Hoặc chọn khoảng ngày:</div>
            <div
              onClick={() => { setUseCustom(true); setSelected(null); }}
              style={{
                display: "flex", alignItems: "center", gap: 8, padding: 12, borderRadius: 8,
                border: `2px solid ${useCustom ? "#f59e0b" : isDark ? "#2E3345" : "#D0D7E2"}`,
                background: useCustom ? "rgba(245,158,11,0.08)" : isDark ? "rgba(255,255,255,0.03)" : "#F5F7FA",
                cursor: "pointer", transition: "all 0.15s",
              }}
            >
              <RangePicker
                value={customRange as any}
                onChange={(dates) => {
                  setCustomRange(dates as any);
                  setUseCustom(true);
                  setSelected(null);
                }}
                format="DD/MM/YYYY"
                style={{ flex: 1 }}
                placeholder={["Từ ngày", "Đến ngày"]}
              />
            </div>
          </div>
        </div>
      ) : (
        <div>
          {proposals.length === 0 ? (
            <div style={{ textAlign: "center", padding: 24, color: isDark ? "#B8B0A4" : "#999" }}>
              <div style={{ fontSize: "0.875rem", fontStyle: "italic" }}>Không có đề xuất lịch mới</div>
              <div style={{ fontSize: "0.7rem", marginTop: 4 }}>Tất cả ca đã đủ nhân viên</div>
            </div>
          ) : (
            <>
              {actualRange && (
                <div style={{ fontSize: "0.7rem", color: isDark ? "#B8B0A4" : "#999", textAlign: "center", padding: "6px 12px", borderRadius: 6, background: isDark ? "rgba(255,255,255,0.03)" : "#F5F7FA", border: `1px solid ${isDark ? "#2E3345" : "#D0D7E2"}`, marginBottom: 12 }}>
                  Đề xuất từ <span style={{ color: "#10b981", fontWeight: 600 }}>{formatDisplayDate(actualRange.from)}</span> — <span style={{ color: "#10b981", fontWeight: 600 }}>{formatDisplayDate(actualRange.to)}</span>
                </div>
              )}

              <div style={{ display: "flex", gap: 12, marginBottom: 12 }}>
                <div style={{ flex: 1, textAlign: "center", padding: 8, borderRadius: 6, background: "rgba(16,185,129,0.1)" }}>
                  <div style={{ fontWeight: 700, color: "#10b981", fontSize: "1rem" }}>{selectedCount}</div>
                  <div style={{ fontSize: "0.6rem", color: isDark ? "#B8B0A4" : "#999" }}>Ca đã chọn</div>
                </div>
                {proposals.length - selectedCount > 0 && (
                  <div style={{ flex: 1, textAlign: "center", padding: 8, borderRadius: 6, background: "rgba(245,158,11,0.1)" }}>
                    <div style={{ fontWeight: 700, color: "#f59e0b", fontSize: "1rem" }}>{proposals.length - selectedCount}</div>
                    <div style={{ fontSize: "0.6rem", color: isDark ? "#B8B0A4" : "#999" }}>Bỏ chọn</div>
                  </div>
                )}
                {skippedCount > 0 && (
                  <div style={{ flex: 1, textAlign: "center", padding: 8, borderRadius: 6, background: "rgba(245,158,11,0.1)" }}>
                    <div style={{ fontWeight: 700, color: "#f59e0b", fontSize: "1rem" }}>{skippedCount}</div>
                    <div style={{ fontSize: "0.6rem", color: isDark ? "#B8B0A4" : "#999" }}>Bỏ qua</div>
                  </div>
                )}
              </div>

              <div style={{ maxHeight: 280, overflowY: "auto" }}>
                <div
                  onClick={toggleAll}
                  style={{
                    display: "flex", alignItems: "center", gap: 8, padding: "8px 12px", marginBottom: 4,
                    borderRadius: 6, cursor: "pointer", background: isDark ? "rgba(255,255,255,0.03)" : "#F5F7FA", border: `1px solid ${isDark ? "#2E3345" : "#D0D7E2"}`,
                  }}
                >
                  <Checkbox checked={allChecked} indeterminate={selectedCount > 0 && !allChecked} />
                  <span style={{ fontWeight: 600, color: isDark ? "#B8B0A4" : "#344054", fontSize: "0.7rem" }}>
                    {allChecked ? "Bỏ chọn tất cả" : "Chọn tất cả"}
                  </span>
                </div>

                {displayProposals.map((p, i) => {
                  const checked = checkedSet.has(i);
                  return (
                    <div
                      key={i}
                      onClick={() => toggleRow(i)}
                      style={{
                        display: "flex", alignItems: "center", gap: 8, padding: "8px 12px", marginBottom: 4,
                        borderRadius: 6, cursor: "pointer", transition: "background 0.1s",
                        background: checked ? "rgba(16,185,129,0.05)" : isDark ? "rgba(255,255,255,0.03)" : "#F5F7FA",
                        border: `1px solid ${checked ? "rgba(16,185,129,0.2)" : isDark ? "#2E3345" : "#D0D7E2"}`,
                      }}
                    >
                      <Checkbox checked={checked} />
                      <div style={{
                        width: 22, height: 22, borderRadius: "50%", display: "flex", alignItems: "center", justifyContent: "center",
                        fontSize: "0.6rem", fontWeight: 700, background: "rgba(16,185,129,0.15)", color: "#10b981", flexShrink: 0,
                      }}>
                        {i + 1}
                      </div>
                      <div style={{ flex: 1, minWidth: 0 }}>
                        <div style={{ fontWeight: 500, fontSize: "0.7rem", overflow: "hidden", textOverflow: "ellipsis", whiteSpace: "nowrap", color: isDark ? "#EDE2DF" : "#101828" }}>
                          {p.staffName || p.staffId.slice(0, 8)}
                        </div>
                        <div style={{ fontSize: "0.6rem", color: isDark ? "#B8B0A4" : "#999" }}>
                          {p.shiftName || "Ca"} — {p.zoneName || "Zone"} — {p.workDate}
                        </div>
                      </div>
                      <Tag color={p.note?.includes("template") ? "blue" : p.note?.includes("preference") ? "purple" : "default"} style={{ fontSize: "0.55rem" }}>
                        {p.note?.includes("template") ? "template" : p.note?.includes("preference") ? "sở thích" : "auto"}
                      </Tag>
                    </div>
                  );
                })}
                {proposals.length > 50 && (
                  <div style={{ textAlign: "center", fontSize: "0.6rem", color: isDark ? "#B8B0A4" : "#999", padding: "6px 0" }}>
                    ... và {proposals.length - 50} ca nữa (tự động chọn)
                  </div>
                )}
              </div>
            </>
          )}
        </div>
      )}
    </Modal>
  );
}
</file>

<file path="src/app/(dashboard)/_components/staff-schedule/DeleteWeekDialog.tsx">
"use client";

import { useCallback, useEffect, useState } from "react";
import Modal from "antd/es/modal";
import Alert from "antd/es/alert";
import Switch from "antd/es/switch";
import { useColorMode } from "@/lib/mui-theme";
import api from "@/lib/api-client";
import type { StaffScheduleAssignment } from "@/lib/types";

interface Props {
  open: boolean;
  onClose: () => void;
  weekFrom: string;
  weekTo: string;
  affectedCount?: number;
  onDeleted: () => void;
}

function getApiError(err: any): string {
  const data = err?.response?.data;
  return data?.error || data?.message || err?.message || "Có lỗi xảy ra";
}

function fmtDate(d: string) {
  const [y, m, day] = d.split("-");
  return `${day}/${m}/${y}`;
}

export default function DeleteWeekDialog({ open, onClose, weekFrom, weekTo, affectedCount, onDeleted }: Props) {
  const { effectiveMode } = useColorMode();
  const isDark = effectiveMode === "dark";
  const [notify, setNotify] = useState(true);
  const [loading, setLoading] = useState(false);
  const [result, setResult] = useState<{ cancelled: number; skipped: number; message: string } | null>(null);
  const [error, setError] = useState<string | null>(null);
  const [fetchedAffectedCount, setFetchedAffectedCount] = useState<number | null>(null);

  const today = new Date().toISOString().split("T")[0];
  const effectiveFrom = weekFrom < today ? today : weekFrom;
  const isPast = effectiveFrom > weekTo;

  const loadAffectedCount = useCallback(async () => {
    if (!open || isPast) return;
    try {
      const res = await api.getScheduleAssignments({ from: effectiveFrom, to: weekTo });
      const activeAssignments = res.items.filter(
        (a: StaffScheduleAssignment) => a.status !== "cancelled" && a.status !== "completed"
      );
      setFetchedAffectedCount(activeAssignments.length);
    } catch {
      setFetchedAffectedCount(null);
    }
  }, [open, isPast, effectiveFrom, weekTo]);

  useEffect(() => { loadAffectedCount(); }, [loadAffectedCount]);

  const handleConfirm = async () => {
    setLoading(true);
    setError(null);
    setResult(null);
    try {
      const res = await api.deleteWeekScheduleAssignments(weekFrom, weekTo, notify);
      setResult(res);
      onDeleted();
    } catch (err) {
      setError(getApiError(err));
    } finally {
      setLoading(false);
    }
  };

  const handleClose = () => {
    setResult(null);
    setError(null);
    setFetchedAffectedCount(null);
    onClose();
  };

  const displayCount = affectedCount ?? fetchedAffectedCount;

  return (
    <Modal
      open={open}
      onCancel={handleClose}
      title={result ? "Đã xóa lịch trực" : "Xóa lịch trực trong tuần"}
      width={440}
      okText={result ? "Đóng" : "Xác nhận xóa"}
      cancelText={result ? undefined : "Hủy bỏ"}
      okButtonProps={result ? {} : { danger: true, loading, onClick: handleConfirm }}
      cancelButtonProps={result ? { style: { display: "none" } } : { disabled: loading }}
      onOk={result ? handleClose : undefined}
      mask={{ closable: !loading }}
    >
      {result ? (
        <div>
          <Alert message={result.message} type="success" showIcon style={{ marginBottom: 8 }} />
          {result.skipped > 0 && (
            <div style={{ fontSize: "0.75rem", color: "#d97706" }}>
              Đã bỏ qua {result.skipped} ca trong quá khứ (không thể hủy).
            </div>
          )}
        </div>
      ) : isPast ? (
        <Alert message="Toàn bộ lịch trong tuần này đã qua. Không có ca nào để hủy." type="warning" showIcon />
      ) : (
        <div>
          <div style={{ padding: 12, borderRadius: 8, border: `1px solid ${isDark ? "#2E3345" : "#D0D7E2"}`, marginBottom: 12, background: isDark ? "rgba(255,255,255,0.03)" : "rgba(0,0,0,0.02)" }}>
            <div style={{ fontSize: "0.75rem", color: isDark ? "#B8B0A4" : "#344054", marginBottom: 4 }}>
              Thao tác này sẽ <span style={{ color: "#ef4444", fontWeight: 700 }}>hủy toàn bộ ca trực</span> từ hôm nay đến cuối tuần:
            </div>
            <div style={{ fontWeight: 600, fontSize: "0.875rem", color: isDark ? "#EDE2DF" : "#101828" }}>
              {effectiveFrom === today && weekFrom < today
                ? `${fmtDate(today)} → ${fmtDate(weekTo)} (các ngày quá khứ đã bỏ qua)`
                : `${fmtDate(weekFrom)} → ${fmtDate(weekTo)}`
              }
            </div>
            <div style={{ fontSize: "0.7rem", color: isDark ? "#B8B0A4" : "#999", marginTop: 6 }}>
              Tất cả yêu cầu đăng ký ca (bids) và đổi ca (swaps) đang chờ duyệt liên quan cũng sẽ bị hủy tự động.
            </div>
          </div>

          {displayCount !== undefined && displayCount !== null && (
            <Alert message={`${displayCount} ca trực sẽ bị ảnh hưởng trong khoảng thời gian này.`} type="info" showIcon style={{ marginBottom: 12 }} />
          )}

          <div style={{ display: "flex", alignItems: "center", gap: 8, marginBottom: 8 }}>
            <Switch checked={notify} onChange={setNotify} size="small" />
            <span style={{ fontSize: "0.75rem", fontWeight: 500 }}>Gửi thông báo hủy lịch đến nhân viên</span>
          </div>

          {notify && (
            <div style={{ fontSize: "0.7rem", color: "#6366f1", background: "rgba(99,102,241,0.05)", border: "1px solid rgba(99,102,241,0.2)", borderRadius: 6, padding: 8 }}>
              Nhân viên bị ảnh hưởng sẽ nhận thông báo qua hệ thống.
            </div>
          )}

          {error && <Alert message={error} type="error" showIcon closable onClose={() => setError(null)} style={{ marginTop: 12 }} />}
        </div>
      )}
    </Modal>
  );
}
</file>

<file path="src/app/(dashboard)/_components/BorrowIPCameraDialog.tsx">
"use client";

import { useCallback, useEffect, useRef, useState } from "react";
import {
  Alert,
  Avatar,
  Box,
  Button,
  Chip,
  CircularProgress,
  Dialog,
  DialogActions,
  DialogContent,
  DialogTitle,
  IconButton,
  InputAdornment,
  Paper,
  Snackbar,
  Stack,
  TextField,
  Typography,
} from "@mui/material";
import BookIcon from "@mui/icons-material/MenuBookOutlined";
import CloseIcon from "@mui/icons-material/Close";
import DeleteIcon from "@mui/icons-material/DeleteOutlined";
import ErrorIcon from "@mui/icons-material/ReportOutlined";
import QrCodeScannerIcon from "@mui/icons-material/QrCodeScannerOutlined";
import SearchIcon from "@mui/icons-material/SearchOutlined";
import api, { getErrorMessage } from "@/lib/api-client";
import type { BookWithStats } from "@/lib/types";
import { slideInRight, successPop } from "@/lib/animations";
import IPCameraStream from "./IPCameraStream";

interface ScannedBorrowItem {
  barcode: string;
  isbn: string;
  loading: boolean;
  can_borrow: boolean;
  reason: string | null;
  book: BookWithStats | null;
  copy_id: string | null;
  book_id: string | null;
  copy_barcode: string | null;
}

interface Props {
  open: boolean;
  patronId: string;
  patronName: string;
  maxItems?: number;
  cameraUrl: string;
  onClose: () => void;
  onSuccess: (message: string) => void;
}

export default function BorrowIPCameraDialog({
  open,
  patronId,
  patronName,
  maxItems,
  cameraUrl,
  onClose,
  onSuccess,
}: Props) {
  const [scanned, setScanned] = useState<ScannedBorrowItem[]>([]);
  const [lookingUp, setLookingUp] = useState(false);
  const [createError, setCreateError] = useState("");
  const [scanToast, setScanToast] = useState("");
  const [lookupError, setLookupError] = useState<string | null>(null);
  const [note, setNote] = useState("");
  const [manualIsbn, setManualIsbn] = useState("");
  const [duplicateFlash, setDuplicateFlash] = useState<string | null>(null);
  const lastScannedRef = useRef<string | null>(null);

  const lookupItem = useCallback(async (barcode: string, isbn: string) => {
    setScanned((prev) => prev.map((item) =>
      item.barcode === barcode ? { ...item, loading: true } : item
    ));
    try {
      const result = await api.lookupBorrowSlip({
        patron_id: patronId,
        items: [{ barcode, isbn }],
      });
      const item = result.items.find((i) => i.barcode === barcode);
      if (!item) {
        setScanned((prev) => prev.filter((i) => i.barcode !== barcode));
        setLookupError(`Sách ISBN ${barcode} không tồn tại trong thư viện`);
        return;
      }
      if (!item.can_borrow) {
        setScanned((prev) => prev.filter((i) => i.barcode !== barcode));
        const msg = item.reason || "Sách không thể mượn";
        setLookupError(msg);
        return;
      }
      setScanned((prev) => prev.map((i) =>
        i.barcode === barcode ? {
          ...i,
          loading: false,
          can_borrow: item.can_borrow,
          reason: item.reason,
          book: item.book,
          copy_id: item.copy?.id || null,
          book_id: item.book?.id || null,
          copy_barcode: item.copy?.barcode || null,
        } : i
      ));
    } catch (err: unknown) {
      setScanned((prev) => prev.filter((item) => item.barcode !== barcode));
      setLookupError(`Lỗi tra cứu: ${barcode} — ${getErrorMessage(err)}`);
    }
  }, [patronId]);

  const addScanned = useCallback((isbn: string) => {
    if (isbn.trim().length < 4) return;
    const normalized = isbn.replace(/-/g, "");
    lastScannedRef.current = normalized;
    setScanned((prev) => {
      const existing = prev.find((item) => item.barcode === normalized);
      if (existing) {
        setDuplicateFlash(normalized);
        setTimeout(() => setDuplicateFlash(null), 1500);
        setScanToast(`Sách ${existing.book?.title || normalized} đã quét rồi`);
        return prev;
      }
      if (maxItems !== undefined && prev.length >= maxItems) {
        setScanToast(`Chỉ được mượn tối đa ${maxItems} cuốn`);
        return prev;
      }
      setScanToast(`Đã quét: ${normalized}`);
      return [...prev, {
        barcode: normalized,
        isbn: normalized,
        loading: true,
        can_borrow: false,
        reason: null,
        book: null,
        copy_id: null,
        book_id: null,
        copy_barcode: null,
      }];
    });
    lookupItem(normalized, normalized);
  }, [lookupItem, maxItems]);

  useEffect(() => {
    if (!open) {
      setScanned([]);
      setCreateError("");
      setScanToast("");
      setNote("");
      setDuplicateFlash(null);
      lastScannedRef.current = null;
    }
  }, [open]);

  const removeItem = (barcode: string) => {
    setScanned((prev) => prev.filter((item) => item.barcode !== barcode));
  };

  const handleCreateSlip = async () => {
    const validItems = scanned.filter((item) => item.can_borrow && item.book_id && item.copy_id);
    if (!validItems.length || !patronId) return;
    setCreateError("");
    try {
      const confirmResult = await api.confirmBorrowSlip({
        patron_id: patronId,
        items: validItems.map((item) => ({
          barcode: item.copy_barcode || item.barcode,
          isbn: item.isbn,
          book_id: item.book_id!,
          copy_id: item.copy_id!,
        })),
        note: note.trim() || null,
      });
      if (confirmResult.status === "success") {
        setScanned([]);
        onSuccess(confirmResult.message);
        onClose();
      }
    } catch (err) {
      const detail = getErrorMessage(err);
      setCreateError(detail);
    }
  };

  const validCount = scanned.filter((item) => item.can_borrow).length;
  const totalScanned = scanned.length;

  return (
    <>
      <Dialog open={open} onClose={lookingUp ? undefined : onClose} fullWidth maxWidth="xl">
        <DialogTitle>
          <Stack direction="row" spacing={1} sx={{ alignItems: "center", justifyContent: "space-between" }}>
            <Stack direction="row" spacing={1} sx={{ alignItems: "center" }}>
              <QrCodeScannerIcon color="primary" />
              <Typography variant="h6" sx={{ fontWeight: 900 }}>
                Quét mã vạch sách (IP Camera)
              </Typography>
            </Stack>
            {!lookingUp && (
              <IconButton size="small" onClick={onClose}><CloseIcon /></IconButton>
            )}
          </Stack>
        </DialogTitle>
        <DialogContent dividers sx={{ p: 2, display: "flex", flexDirection: "column", overflow: "hidden" }}>
          <Box sx={{ display: "flex", gap: 2, flexDirection: { xs: "column", md: "row" }, flex: 1, overflow: "hidden" }}>
            <Box sx={{ width: { md: "50%" }, flexShrink: 0 }}>
              <IPCameraStream
                cameraUrl={cameraUrl}
                onBarcodeDetected={addScanned}
              />
            </Box>

            <Stack spacing={1.5} sx={{ flex: 1, overflow: "auto" }}>
              <Stack direction="row" spacing={1} sx={{ alignItems: "center" }}>
                <QrCodeScannerIcon color="primary" sx={{ fontSize: 20 }} />
                <Typography variant="subtitle2" sx={{ fontWeight: 900 }}>
                  {totalScanned > 0 ? `Đã quét (${totalScanned} cuốn)` : "Sách đã quét"}
                </Typography>
              </Stack>

              {createError ? <Alert severity="error" onClose={() => setCreateError("")}>{createError}</Alert> : null}

              {lookupError ? (
                <Paper variant="outlined" sx={{ p: 1.5, borderColor: "error.main", bgcolor: (t) => t.palette.mode === "dark" ? "rgba(239,68,68,0.12)" : "rgba(239,68,68,0.06)" }}>
                  <Stack spacing={1}>
                    <Stack direction="row" spacing={1} sx={{ alignItems: "center" }}>
                      <ErrorIcon color="error" sx={{ fontSize: 20 }} />
                      <Typography variant="body2" sx={{ fontWeight: 600, color: "error.main", flex: 1 }}>
                        {lookupError}
                      </Typography>
                      <IconButton size="small" onClick={() => setLookupError(null)}>
                        <CloseIcon fontSize="small" />
                      </IconButton>
                    </Stack>
                    <Button
                      size="small"
                      variant="outlined"
                      onClick={() => {
                        setManualIsbn("");
                        setLookupError(null);
                      }}
                      sx={{ textTransform: "none", fontWeight: 600, alignSelf: "flex-start" }}
                    >
                      Nhập ISBN thủ công
                    </Button>
                  </Stack>
                </Paper>
              ) : null}

              <TextField
                size="small"
                placeholder="Nhập ISBN thủ công..."
                value={manualIsbn}
                onChange={(e) => setManualIsbn(e.target.value)}
                onKeyDown={(e) => {
                  if (e.key === "Enter" && manualIsbn.trim()) {
                    addScanned(manualIsbn.trim());
                    setManualIsbn("");
                  }
                }}
                fullWidth
                slotProps={{
                  input: {
                    startAdornment: (
                      <InputAdornment position="start">
                        <SearchIcon fontSize="small" />
                      </InputAdornment>
                    ),
                  },
                }}
                sx={{ "& .MuiOutlinedInput-root": { borderRadius: 2 } }}
              />

              {scanned.length === 0 ? (
                <Alert severity="info" sx={{ flex: 1, display: "flex", alignItems: "center" }}>
                  Đưa mã vạch vào camera. Sách sẽ xuất hiện tại đây.
                </Alert>
              ) : (
                scanned.map((item) => {
                  const isLastScanned = item.barcode === lastScannedRef.current;
                  const isDupeFlash = item.barcode === duplicateFlash;
                  const hasError = !item.loading && !item.can_borrow;
                  const isSuccess = !item.loading && item.can_borrow;
                  return (
                    <Paper
                      key={item.barcode}
                      variant="outlined"
                      sx={{
                        p: 1.5,
                        borderColor: isDupeFlash ? "warning.main" : isLastScanned ? "primary.main" : hasError ? "error.main" : undefined,
                        borderWidth: isDupeFlash ? 2 : undefined,
                        bgcolor: isDupeFlash ? (t) => t.palette.mode === "dark" ? "rgba(245,158,11,0.15)" : "rgba(245,158,11,0.08)" : isLastScanned ? "action.hover" : hasError ? (t) => t.palette.mode === "dark" ? "rgba(239,68,68,0.12)" : "rgba(239,68,68,0.06)" : undefined,
                        animation: isSuccess
                          ? `${successPop} 0.4s ease-out`
                          : isDupeFlash
                          ? `${slideInRight} 0.3s ease-out`
                          : isLastScanned
                          ? `${slideInRight} 0.3s ease-out`
                          : undefined,
                      }}
                    >
                      <Stack direction="row" spacing={1.5} sx={{ alignItems: "flex-start" }}>
                        {item.loading ? (
                          <Avatar variant="rounded" sx={{ width: 40, height: 56, bgcolor: "background.default", flexShrink: 0 }}>
                            <CircularProgress size={20} />
                          </Avatar>
                        ) : item.book?.cover_url ? (
                          <Box
                            component="img"
                            src={item.book.cover_url}
                            alt={item.book.title}
                            sx={{ width: 40, height: 56, objectFit: "cover", borderRadius: 0.5, flexShrink: 0 }}
                          />
                        ) : (
                          <Avatar variant="rounded" sx={{ width: 40, height: 56, bgcolor: hasError ? "error.main" : "background.default", flexShrink: 0 }}>
                            {hasError ? <ErrorIcon fontSize="small" /> : <BookIcon />}
                          </Avatar>
                        )}
                        <Stack spacing={0.3} sx={{ flex: 1, minWidth: 0 }}>
                          {item.loading ? (
                            <Typography variant="body2" color="text.secondary">Đang tra cứu...</Typography>
                          ) : item.can_borrow && item.book ? (
                            <>
                              <Typography variant="body2" sx={{ fontWeight: 900 }} noWrap>
                                {item.book.title}
                              </Typography>
                              <Typography variant="caption" color="text.secondary" noWrap>
                                {item.book.author || "-"}
                              </Typography>
                              <Typography variant="caption" sx={{ fontFamily: "monospace", color: "primary.main" }}>
                                {item.barcode}
                              </Typography>
                              <Stack direction="row" spacing={0.5} sx={{ alignItems: "center", flexWrap: "wrap", mt: 0.5 }}>
                                <Chip size="small" variant="outlined" label={`Kho: ${item.book.total_copies}`} sx={{ height: 20, fontSize: 11 }} />
                                <Chip size="small" variant="outlined" color="success" label={`Sẵn: ${item.book.available_copies}`} sx={{ height: 20, fontSize: 11 }} />
                              </Stack>
                            </>
                          ) : (
                            <>
                              <Typography variant="body2" sx={{ fontWeight: 900 }} noWrap color="error">
                                {item.book?.title || item.barcode}
                              </Typography>
                              {item.reason && (
                                <Typography variant="caption" color="error">
                                  {item.reason}
                                </Typography>
                              )}
                            </>
                          )}
                        </Stack>
                        <IconButton size="small" color="error" onClick={() => removeItem(item.barcode)} sx={{ mt: 0.5 }}>
                          <DeleteIcon fontSize="small" />
                        </IconButton>
                      </Stack>
                    </Paper>
                  );
                })
              )}
            </Stack>
          </Box>
        </DialogContent>
        <DialogActions sx={{ flexDirection: "column", alignItems: "stretch", px: 3, pb: 2, gap: 1.5 }}>
          <TextField
            size="small"
            placeholder="Ghi chú phiếu mượn (tùy chọn)..."
            value={note}
            onChange={(e) => setNote(e.target.value)}
            fullWidth
            multiline
            maxRows={3}
            sx={{ "& .MuiInputBase-root": { fontSize: 13 } }}
          />
          <Stack direction="row" spacing={1} sx={{ justifyContent: "flex-end" }}>
            <Button onClick={onClose} disabled={lookingUp}>Hủy</Button>
            <Button
              variant="contained"
              disabled={lookingUp || validCount === 0}
              onClick={handleCreateSlip}
            >
              {lookingUp ? "Đang xử lý..." : `Tạo phiếu mượn (${validCount} cuốn)`}
            </Button>
          </Stack>
        </DialogActions>
      </Dialog>

      <Snackbar
        open={!!scanToast}
        autoHideDuration={scanToast?.includes("đã quét rồi") || scanToast?.includes("tối đa") ? 3500 : 2000}
        onClose={() => setScanToast("")}
        anchorOrigin={{ vertical: "top", horizontal: "right" }}
      >
        {scanToast ? (
          <Alert
            severity={
              scanToast.includes("đã quét rồi") || scanToast.includes("tối đa")
                ? "warning"
                : scanToast.startsWith("Đã quét")
                ? "success"
                : "info"
            }
            onClose={() => setScanToast("")}
            sx={{
              animation: `${slideInRight} 0.3s ease-out`,
              boxShadow: 4,
            }}
          >
            {scanToast}
          </Alert>
        ) : undefined}
      </Snackbar>
    </>
  );
}
</file>

<file path="src/app/(dashboard)/_components/BorrowScannerDialog.tsx">
"use client";

import { useCallback, useEffect, useRef, useState } from "react";
import {
  Alert,
  Avatar,
  Box,
  Button,
  Chip,
  CircularProgress,
  Dialog,
  DialogActions,
  DialogContent,
  DialogTitle,
  IconButton,
  Paper,
  Stack,
  Typography,
} from "@mui/material";
import Input from "antd/es/input";
import Result from "antd/es/result";
import Steps from "antd/es/steps";
import notification from "antd/es/notification";
import BookIcon from "@mui/icons-material/MenuBookOutlined";
import CameraAltIcon from "@mui/icons-material/CameraAltOutlined";
import CheckCircleIcon from "@mui/icons-material/CheckCircleOutlineOutlined";
import CloseIcon from "@mui/icons-material/Close";
import DeleteIcon from "@mui/icons-material/DeleteOutlined";
import ErrorIcon from "@mui/icons-material/ReportOutlined";
import QrCodeScannerIcon from "@mui/icons-material/QrCodeScannerOutlined";
import api, { getErrorMessage } from "@/lib/api-client";
import type { BookWithStats } from "@/lib/types";
import { slideInRight, successPop } from "@/lib/animations";

interface ScannedBorrowItem {
  barcode: string;
  isbn: string;
  loading: boolean;
  can_borrow: boolean;
  reason: string | null;
  book: BookWithStats | null;
  copy_id: string | null;
  book_id: string | null;
  copy_barcode: string | null;
}

export default function BorrowScannerDialog({
  open,
  patronId,
  maxItems,
  onClose,
  onSuccess,
}: {
  open: boolean;
  patronId: string;
  maxItems?: number;
  onClose: () => void;
  onSuccess: (message: string) => void;
}) {
  const [apiAnt, contextHolder] = notification.useNotification();
  const videoRef = useRef<HTMLVideoElement>(null);
  const streamRef = useRef<MediaStream | null>(null);
  const readerRef = useRef<any>(null);
  const lastScannedRef = useRef<string | null>(null);
  const [cameraReady, setCameraReady] = useState(false);
  const [cameraError, setCameraError] = useState("");
  const [scanned, setScanned] = useState<ScannedBorrowItem[]>([]);
  const [lookingUp, setLookingUp] = useState(false);
  const [createError, setCreateError] = useState("");
  const [scanToast, setScanToast] = useState("");
  const [lookupError, setLookupError] = useState<string | null>(null);
  const [manualIsbn, setManualIsbn] = useState("");
  const [successResult, setSuccessResult] = useState<{ message: string; bookCount: number } | null>(null);

  const stopCamera = useCallback(() => {
    if (readerRef.current) {
      try { readerRef.current.reset(); } catch {}
      readerRef.current = null;
    }
    if (streamRef.current) {
      streamRef.current.getTracks().forEach((track) => track.stop());
      streamRef.current = null;
    }
    if (videoRef.current) videoRef.current.srcObject = null;
    setCameraReady(false);
  }, []);

  const lookupItem = useCallback(async (barcode: string, isbn: string) => {
    setScanned((prev) => prev.map((item) =>
      item.barcode === barcode ? { ...item, loading: true } : item
    ));
    try {
      const result = await api.lookupBorrowSlip({
        patron_id: patronId,
        items: [{ barcode, isbn }],
      });
      const item = result.items.find((i) => i.barcode === barcode);
      if (!item) {
        setScanned((prev) => prev.filter((i) => i.barcode !== barcode));
        setLookupError(`Sách ISBN ${barcode} không tồn tại trong thư viện`);
        return;
      }
      if (!item.can_borrow) {
        setScanned((prev) => prev.filter((i) => i.barcode !== barcode));
        const msg = item.reason || 'Sách không thể mượn';
        const title = item.book?.title || '';
        setLookupError(title ? `"${title}": ${msg}` : `${msg} (ISBN: ${barcode})`);
        return;
      }
      setScanned((prev) => prev.map((i) =>
        i.barcode === barcode ? {
          ...i,
          loading: false,
          can_borrow: item.can_borrow,
          reason: item.reason,
          book: item.book,
          copy_id: item.copy?.id || null,
          book_id: item.book?.id || null,
          copy_barcode: item.copy?.barcode || null,
        } : i
      ));
    } catch {
      setScanned((prev) => prev.filter((item) => item.barcode !== barcode));
      setLookupError(`Lỗi tra cứu: ${barcode}`);
    }
  }, [patronId]);

  const addScanned = useCallback((isbn: string) => {
    if (!/^\d{10,13}$/.test(isbn.replace(/-/g, ""))) return;
    const normalized = isbn.replace(/-/g, "");
    lastScannedRef.current = normalized;
    setScanToast(normalized);
    setScanned((prev) => {
      if (prev.some((item) => item.barcode === normalized)) {
        setScanToast(`Sách ${normalized} đã có trong danh sách`);
        return prev;
      }
      if (maxItems !== undefined && prev.length >= maxItems) {
        setScanToast(`Chỉ được mượn tối đa ${maxItems} cuốn`);
        return prev;
      }
      return [...prev, {
        barcode: normalized,
        isbn: normalized,
        loading: true,
        can_borrow: false,
        reason: null,
        book: null,
        copy_id: null,
        book_id: null,
        copy_barcode: null,
      }];
    });
    lookupItem(normalized, normalized);
  }, [lookupItem, maxItems]);

  useEffect(() => {
    if (!open) {
      stopCamera();
      setScanned([]);
      setCameraError("");
      setCreateError("");
      setScanToast("");
      setSuccessResult(null);
      lastScannedRef.current = null;
      return;
    }
    let active = true;
    (async () => {
      try {
        setCameraError("");
        const { BrowserMultiFormatReader } = await import("@zxing/browser");
        if (!active) return;
        const stream = await navigator.mediaDevices.getUserMedia({
          video: { facingMode: "environment", width: { ideal: 640 }, height: { ideal: 480 } },
          audio: false,
        });
        if (!active) { stream.getTracks().forEach((t) => t.stop()); return; }
        streamRef.current = stream;
        if (videoRef.current) {
          videoRef.current.srcObject = stream;
          videoRef.current.onloadedmetadata = () => { setCameraReady(true); };
        }
      } catch (err: any) {
        if (!active) return;
        if (err.name === "NotAllowedError") setCameraError("Không có quyền truy cập camera. Hãy cấp quyền camera cho trình duyệt.");
        else if (err.name === "NotFoundError") setCameraError("Không tìm thấy camera trên thiết bị.");
        else setCameraError("Không thể khởi động camera.");
      }
    })();
    return () => { active = false; };
  }, [open, stopCamera]);

  useEffect(() => {
    if (!cameraReady || !videoRef.current || !open) return;
    let active = true;
    (async () => {
      try {
        const { BrowserMultiFormatReader } = await import("@zxing/browser");
        if (!active) return;
        const reader = new BrowserMultiFormatReader();
        readerRef.current = reader;
        reader.decodeFromVideoElement(videoRef.current!, (result, err) => {
          if (!active) return;
          if (result) {
            const code = result.getText();
            if (/^\d{10,13}$/.test(code.replace(/-/g, ""))) {
              addScanned(code);
            }
          }
        });
      } catch {}
    })();
    return () => { active = false; };
  }, [cameraReady, open, addScanned]);

  useEffect(() => () => stopCamera(), [stopCamera]);

  const removeItem = (barcode: string) => {
    setScanned((prev) => prev.filter((item) => item.barcode !== barcode));
  };

  const handleCreateSlip = async () => {
    const validItems = scanned.filter((item) => item.can_borrow && item.book_id && item.copy_id);
    if (!validItems.length || !patronId) return;
    setCreateError("");
    try {
      const confirmResult = await api.confirmBorrowSlip({
        patron_id: patronId,
        items: validItems.map((item) => ({
          barcode: item.copy_barcode || item.barcode,
          isbn: item.isbn,
          book_id: item.book_id!,
          copy_id: item.copy_id!,
        })),
      });
      if (confirmResult.status === "success") {
        stopCamera();
        setSuccessResult({ message: confirmResult.message, bookCount: validItems.length });
      }
    } catch (err) {
      const detail = getErrorMessage(err);
      const removedBarcodes: string[] = [];
      const toastMsg = detail;

      const matchTitle = detail.match(/^Sach "(.+)" da duoc doc gia nay muon$/);
      if (matchTitle) {
        const title = matchTitle[1];
        setScanned((prev) => {
          const filtered = prev.filter((item) => {
            if (item.book?.title === title) {
              removedBarcodes.push(item.barcode);
              return false;
            }
            return true;
          });
          return filtered;
        });
      } else {
        const matchBarcode = detail.match(/^(?:Ban sao|Ma vach) ([^\s]+) (?:dang duoc muon|khong ton tai)/);
        if (matchBarcode) {
          const barcode = matchBarcode[1];
          setScanned((prev) => {
            const filtered = prev.filter((item) => {
              if (item.barcode === barcode || item.barcode.includes(barcode)) {
                removedBarcodes.push(item.barcode);
                return false;
              }
              return true;
            });
            return filtered;
          });
        } else {
          setCreateError(detail);
        }
      }
      if (removedBarcodes.length > 0) {
        setScanToast(toastMsg);
      }
    }
  };

  const validCount = scanned.filter((item) => item.can_borrow).length;
  const totalScanned = scanned.length;
  const currentStep = successResult ? 2 : lookingUp ? 1 : 0;

  return (
    <>
      <Dialog open={open} onClose={lookingUp ? undefined : onClose} fullWidth maxWidth="xl">
        <DialogTitle>
          <Stack direction="row" spacing={1} sx={{ alignItems: "center", justifyContent: "space-between" }}>
            <Stack direction="row" spacing={1} sx={{ alignItems: "center" }}>
              <QrCodeScannerIcon color="primary" />
              <Typography variant="h6" sx={{ fontWeight: 900 }}>Quét ISBN sách</Typography>
            </Stack>
            {!lookingUp && !successResult && (
              <IconButton size="small" onClick={onClose}><CloseIcon /></IconButton>
            )}
          </Stack>
          <Steps
            current={currentStep}
            size="small"
            items={[
              { title: "Quét sách" },
              { title: "Xác nhận" },
              { title: "Hoàn tất" },
            ]}
            style={{ marginTop: 12 }}
          />
        </DialogTitle>
        <DialogContent dividers sx={{ p: 2, display: "flex", flexDirection: "column", overflow: "hidden" }}>
          {successResult ? (
            <Result
              status="success"
              title="Tạo phiếu mượn thành công"
              subTitle={`${successResult.bookCount} cuốn sách đã được thêm vào phiếu`}
              extra={[
                <Button key="close" variant="contained" onClick={() => {
                  setSuccessResult(null);
                  setScanned([]);
                  onSuccess(successResult.message);
                  onClose();
                }}>
                  Đóng
                </Button>,
              ]}
            />
          ) : (
          <Box sx={{ display: "flex", gap: 2, flexDirection: { xs: "column", md: "row" }, flex: 1, overflow: "hidden" }}>
            <Paper
              variant="outlined"
              sx={{
                position: "relative",
                overflow: "hidden",
                bgcolor: "black",
                width: { md: "50%" },
                aspectRatio: { xs: "16/9", md: "4/3" },
                display: "flex",
                alignItems: "center",
                justifyContent: "center",
                flexShrink: 0,
              }}
            >
              {cameraError ? (
                <Stack spacing={1} sx={{ alignItems: "center", color: "grey.300", p: 3 }}>
                  <CameraAltIcon sx={{ fontSize: 42 }} />
                  <Typography>{cameraError}</Typography>
                </Stack>
              ) : (
                <>
                  <Box
                    component="video"
                    ref={videoRef}
                    autoPlay
                    playsInline
                    muted
                    sx={{ width: "100%", height: "100%", objectFit: "contain" }}
                  />
                  {!cameraReady && (
                    <Stack sx={{ position: "absolute", inset: 0, bgcolor: "rgba(0,0,0,.55)", color: "common.white", alignItems: "center", justifyContent: "center" }} spacing={1}>
                      <CircularProgress size={26} color="inherit" />
                      <Typography variant="body2">Đang kết nối camera...</Typography>
                    </Stack>
                  )}
                </>
              )}
            </Paper>

            <Stack spacing={1.5} sx={{ flex: 1, overflow: "auto" }}>
              <Stack direction="row" spacing={1} sx={{ alignItems: "center" }}>
                <QrCodeScannerIcon color="primary" sx={{ fontSize: 20 }} />
                <Typography variant="subtitle2" sx={{ fontWeight: 900 }}>
                  {totalScanned > 0 ? `Đã quét (${totalScanned} cuốn)` : "Sách đã quét"}
                </Typography>
              </Stack>

              {createError ? <Alert severity="error" onClose={() => setCreateError("")}>{createError}</Alert> : null}

              {lookupError ? (
                <Paper variant="outlined" sx={{ p: 1.5, borderColor: "error.main", bgcolor: "error.50" }}>
                  <Stack spacing={1}>
                    <Stack direction="row" spacing={1} sx={{ alignItems: "center" }}>
                      <ErrorIcon color="error" sx={{ fontSize: 20 }} />
                      <Typography variant="body2" sx={{ fontWeight: 600, color: "error.900", flex: 1 }}>
                        {lookupError}
                      </Typography>
                      <IconButton size="small" onClick={() => setLookupError(null)}>
                        <CloseIcon fontSize="small" />
                      </IconButton>
                    </Stack>
                    <Button
                      size="small"
                      variant="outlined"
                      onClick={() => {
                        setManualIsbn("");
                        setLookupError(null);
                      }}
                      sx={{ textTransform: "none", fontWeight: 600, alignSelf: "flex-start" }}
                    >
                      Nhập ISBN thủ công
                    </Button>
                  </Stack>
                </Paper>
              ) : null}

              <Input
                size="middle"
                placeholder="Nhập ISBN thủ công..."
                prefix={<QrCodeScannerIcon style={{ fontSize: 14, color: "#999" }} />}
                value={manualIsbn}
                onChange={(e) => setManualIsbn(e.target.value)}
                onPressEnter={() => {
                  if (manualIsbn.trim()) {
                    addScanned(manualIsbn.trim());
                    setManualIsbn("");
                  }
                }}
                allowClear
              />

              {scanned.length === 0 ? (
                <Alert severity="info" sx={{ flex: 1, display: "flex", alignItems: "center" }}>
                  Đưa mã vạch ISBN vào camera. Sách sẽ xuất hiện tại đây.
                </Alert>
              ) : (
                scanned.map((item) => {
                  const isLastScanned = item.barcode === lastScannedRef.current;
                  const hasError = !item.loading && !item.can_borrow;
                  const isSuccess = !item.loading && item.can_borrow;
                  return (
                    <Paper
                      key={item.barcode}
                      variant="outlined"
                      sx={{
                        p: 1.5,
                        borderColor: isLastScanned ? "primary.main" : hasError ? "error.main" : undefined,
                        bgcolor: isLastScanned ? "action.hover" : hasError ? "error.50" : undefined,
                        animation: isSuccess
                          ? `${successPop} 0.4s ease-out`
                          : isLastScanned
                          ? `${slideInRight} 0.3s ease-out`
                          : undefined,
                      }}
                    >
                      <Stack direction="row" spacing={1.5} sx={{ alignItems: "flex-start" }}>
                        {item.loading ? (
                          <Avatar variant="rounded" sx={{ width: 40, height: 56, bgcolor: "background.default", flexShrink: 0 }}>
                            <CircularProgress size={20} />
                          </Avatar>
                        ) : item.book?.cover_url ? (
                          <Box
                            component="img"
                            src={item.book.cover_url}
                            alt={item.book.title}
                            sx={{ width: 40, height: 56, objectFit: "cover", borderRadius: 0.5, flexShrink: 0 }}
                          />
                        ) : (
                          <Avatar variant="rounded" sx={{ width: 40, height: 56, bgcolor: hasError ? "error.main" : "background.default", flexShrink: 0 }}>
                            {hasError ? <ErrorIcon fontSize="small" /> : <BookIcon />}
                          </Avatar>
                        )}
                        <Stack spacing={0.3} sx={{ flex: 1, minWidth: 0 }}>
                          {item.loading ? (
                            <Typography variant="body2" color="text.secondary">Đang tra cứu...</Typography>
                          ) : item.can_borrow && item.book ? (
                            <>
                              <Typography variant="body2" sx={{ fontWeight: 900 }} noWrap>
                                {item.book.title}
                              </Typography>
                              <Typography variant="caption" color="text.secondary" noWrap>
                                {item.book.author || "-"}
                              </Typography>
                              <Typography variant="caption" sx={{ fontFamily: "monospace", color: "primary.main" }}>
                                {item.barcode}
                              </Typography>
                              <Stack direction="row" spacing={0.5} sx={{ alignItems: "center", flexWrap: "wrap", mt: 0.5 }}>
                                <Chip size="small" variant="outlined" label={`Kho: ${item.book.total_copies}`} sx={{ height: 20, fontSize: 11 }} />
                                <Chip size="small" variant="outlined" color="success" label={`Sẵn: ${item.book.available_copies}`} sx={{ height: 20, fontSize: 11 }} />
                              </Stack>
                            </>
                          ) : (
                            <>
                              <Typography variant="body2" sx={{ fontWeight: 900 }} noWrap color="error">
                                {item.book?.title || item.barcode}
                              </Typography>
                              {item.reason && (
                                <Typography variant="caption" color="error">
                                  {item.reason}
                                </Typography>
                              )}
                            </>
                          )}
                        </Stack>
                        <IconButton size="small" color="error" onClick={() => removeItem(item.barcode)} sx={{ mt: 0.5 }}>
                          <DeleteIcon fontSize="small" />
                        </IconButton>
                      </Stack>
                    </Paper>
                  );
                })
              )}
            </Stack>
          </Box>
          )}
        </DialogContent>
        <DialogActions>
          <Button onClick={onClose} disabled={lookingUp}>Hủy</Button>
          {!successResult && (
            <Button
              variant="contained"
              disabled={lookingUp || validCount === 0}
              onClick={handleCreateSlip}
            >
              {lookingUp ? "Đang xử lý..." : `Tạo phiếu mượn (${validCount} cuốn)`}
            </Button>
          )}
        </DialogActions>
      </Dialog>

      {contextHolder}
    </>
  );
}
</file>

