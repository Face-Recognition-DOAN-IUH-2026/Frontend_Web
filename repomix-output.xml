                                )}
                                <Box
                                  sx={{
                                    px: 1,
                                    py: 0.25,
                                    borderRadius: 0.75,
                                    bgcolor:
                                      dur.level <= 1
                                        ? "rgba(74,140,92,0.1)"
                                        : dur.level === 2
                                          ? "rgba(196,154,60,0.1)"
                                          : "rgba(184,92,74,0.1)",
