                />

                <Stack direction="row" spacing={1.5} sx={{ justifyContent: "flex-end", pt: 1 }}>
                  <Button
                    variant="outlined"
                    onClick={() => setShowEmailModal(false)}
                    disabled={emailLoading}
                    sx={{ borderRadius: 2 }}
                  >
                    Hủy
                  </Button>
                  <Button
                    type="submit"
                    variant="contained"
                    disabled={emailLoading || !emailData.new_email}
                    endIcon={emailLoading ? <CircularProgress size={16} color="inherit" /> : <ArrowForwardIcon fontSize="small" />}
                    sx={{
                      borderRadius: 2,
                      px: 2.5,
                      fontWeight: 700,
                    }}
                  >
                    {emailLoading ? "Đang gửi..." : "Gửi mã OTP"}
                  </Button>
                </Stack>
              </Stack>
            </form>
          ) : (
            <form onSubmit={verifyEmailOtp}>
              <Stack spacing={2.5}>
                {/* Destination Email Info Card */}
                <Box
                  sx={{
                    p: 1.5,
                    borderRadius: 2.5,
                    bgcolor: (th) =>
                      th.palette.mode === "dark"
                        ? "rgba(56, 189, 248, 0.08)"
                        : "rgba(139, 0, 0, 0.04)",
                    border: "1px solid",
                    borderColor: (th) =>
                      th.palette.mode === "dark"
                        ? "rgba(56, 189, 248, 0.2)"
                        : "rgba(139, 0, 0, 0.15)",
                    display: "flex",
                    alignItems: "center",
                    justifyContent: "space-between",
                    gap: 1,
                  }}
                >
                  <Box sx={{ minWidth: 0 }}>
                    <Typography variant="caption" color="text.secondary" sx={{ display: "block", fontSize: "0.72rem" }}>
                      Mã xác nhận đã gửi đến:
                    </Typography>
                    <Typography
                      variant="body2"
                      sx={{
                        fontWeight: 700,
                        whiteSpace: "nowrap",
                        overflow: "hidden",
                        textOverflow: "ellipsis",
                      }}
                    >
                      {emailData.new_email}
                    </Typography>
                  </Box>
                  <Button
                    size="small"
                    variant="text"
                    startIcon={<EditIcon sx={{ fontSize: 16 }} />}
                    onClick={() => {
                      setEmailStep("request");
                      setEmailData((prev) => ({ ...prev, code: "" }));
                    }}
                    sx={{ textTransform: "none", fontSize: "0.78rem", minWidth: "auto", flexShrink: 0 }}
                  >
                    Đổi
                  </Button>
                </Box>

                {/* 6-slot OTP Input Component */}
                <Box sx={{ textAlign: "center", py: 0.5 }}>
                  <Typography variant="body2" color="text.secondary" sx={{ mb: 1.5, fontSize: "0.85rem" }}>
                    Nhập mã PIN 6 số để xác thực:
                  </Typography>

                  <OtpPinInput
                    length={6}
                    value={emailData.code}
                    onChange={(code) => setEmailData((prev) => ({ ...prev, code }))}
                    disabled={emailLoading}
                    autoFocus
                  />
                </Box>

                {/* Resend Cooldown Section */}
                <Box
                  sx={{
                    display: "flex",
                    alignItems: "center",
                    justifyContent: "center",
                    gap: 0.5,
                  }}
                >
                  {resendCooldown > 0 ? (
                    <Chip
                      icon={<AccessTimeIcon sx={{ fontSize: "16px !important" }} />}
                      label={`Gửi lại mã sau ${resendCooldown}s`}
                      size="small"
                      variant="outlined"
                      sx={{
                        fontWeight: 600,
                        fontSize: "0.75rem",
                        borderColor: "divider",
                      }}
                    />
                  ) : (
                    <Button
                      size="small"
                      variant="text"
                      startIcon={<RefreshIcon sx={{ fontSize: 16 }} />}
                      onClick={handleResendOtp}
                      disabled={emailLoading}
                      sx={{ textTransform: "none", fontWeight: 700, fontSize: "0.8rem" }}
                    >
                      Chưa nhận được mã? Gửi lại
                    </Button>
                  )}
                </Box>

                {/* Action Buttons */}
                <Stack direction="row" spacing={1.5} sx={{ justifyContent: "flex-end", pt: 0.5 }}>
                  <Button
                    variant="outlined"
                    startIcon={<ArrowBackIcon fontSize="small" />}
                    onClick={() => setEmailStep("request")}
                    disabled={emailLoading}
                    sx={{ borderRadius: 2 }}
                  >
                    Quay lại
                  </Button>
                  <Button
                    type="submit"
                    variant="contained"
                    disabled={emailLoading || emailData.code.length !== 6}
                    startIcon={
                      emailLoading ? (
                        <CircularProgress size={16} color="inherit" />
                      ) : (
                        <CheckIcon fontSize="small" />
                      )
                    }
                    sx={{
                      borderRadius: 2,
                      px: 2.5,
                      fontWeight: 700,
                    }}
                  >
                    {emailLoading ? "Đang xác thực..." : "Xác thực & Lưu"}
                  </Button>
                </Stack>
              </Stack>
            </form>
          )}
        </DialogContent>
      </Dialog>
    </Stack>
  );
}
