<file path="src/lib/error-reporter.ts">
const API_BASE = process.env.NEXT_PUBLIC_API_URL || 'http://localhost:80';

interface ReportErrorParams {
  title: string;
  description?: string;
  priority?: 'Highest' | 'High' | 'Medium' | 'Low';
  labels?: string[];
  service?: string;
  endpoint?: string;
  method?: string;
  stacktrace?: string;
  requestBody?: string;
}

export async function reportError(params: ReportErrorParams): Promise<void> {
  try {
    await fetch(`${API_BASE}/errors/report`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        ...params,
        service: params.service || 'frontend-web',
      }),
    });
  } catch {
    // Silent fail — error reporting should never break the app
  }
}

// Global error handler for unhandled errors
export function setupGlobalErrorHandlers() {
  if (typeof window === 'undefined') return;

  window.addEventListener('error', (event) => {
    reportError({
      title: `[Frontend-Web] Uncaught Error - ${event.message}`,
      description: event.message,
      priority: 'High',
      labels: ['frontend-web', 'uncaught-error'],
      stacktrace: event.error?.stack || `${event.filename}:${event.lineno}:${event.colno}`,
    });
  });

  window.addEventListener('unhandledrejection', (event) => {
    const reason = event.reason;
    const message = reason instanceof Error ? reason.message : String(reason);
    const stack = reason instanceof Error ? reason.stack : undefined;
    reportError({
      title: `[Frontend-Web] Unhandled Promise Rejection - ${message}`,
      description: message,
      priority: 'High',
      labels: ['frontend-web', 'unhandled-rejection'],
      stacktrace: stack,
    });
  });
}
</file>

<file path="src/lib/event-bus.ts">
type Listener = (...args: any[]) => void;

class EventBus {
  private listeners: Record<string, Listener[]> = {};

  on(event: string, fn: Listener): () => void {
    (this.listeners[event] ??= []).push(fn);
    return () => this.off(event, fn);
  }

  off(event: string, fn: Listener): void {
    const list = this.listeners[event];
    if (list) this.listeners[event] = list.filter(l => l !== fn);
  }

  emit(event: string, ...args: any[]): void {
    this.listeners[event]?.forEach(fn => fn(...args));
  }
}

export const bus = new EventBus();
</file>

<file path="src/lib/image-utils.ts">
const MAX_DIMENSION = 1280;
const JPEG_QUALITY = 0.85;

export interface DownscaleOptions {
  maxDimension?: number;
  quality?: number;
}

export async function downscaleImage(
  file: File,
  options: DownscaleOptions = {},
): Promise<Blob> {
  const { maxDimension = MAX_DIMENSION, quality = JPEG_QUALITY } = options;

  const img = await loadImage(file);
  const { width, height } = computeDimensions(
    img.naturalWidth,
    img.naturalHeight,
    maxDimension,
  );

  const canvas = document.createElement('canvas');
  canvas.width = width;
  canvas.height = height;

  const ctx = canvas.getContext('2d');
  if (!ctx) throw new Error('Failed to get canvas 2D context');

  ctx.drawImage(img, 0, 0, width, height);

  return new Promise<Blob>((resolve, reject) => {
    canvas.toBlob(
      (blob) => {
        if (blob) resolve(blob);
        else reject(new Error('Canvas toBlob returned null'));
      },
      'image/jpeg',
      quality,
    );
  });
}

export async function downscaleImageToFile(
  file: File,
  options: DownscaleOptions = {},
): Promise<File> {
  const blob = await downscaleImage(file, options);
  return new File([blob], file.name.replace(/\.[^.]+$/, '.jpg'), {
    type: 'image/jpeg',
    lastModified: Date.now(),
  });
}

function loadImage(file: File): Promise<HTMLImageElement> {
  return new Promise((resolve, reject) => {
    const img = new Image();
    img.onload = () => {
      URL.revokeObjectURL(img.src);
      resolve(img);
    };
    img.onerror = () => reject(new Error('Failed to load image'));
    img.src = URL.createObjectURL(file);
  });
}

export function computeDimensions(
  originalWidth: number,
  originalHeight: number,
  maxDimension: number,
): { width: number; height: number } {
  if (originalWidth <= maxDimension && originalHeight <= maxDimension) {
    return { width: originalWidth, height: originalHeight };
  }
  const ratio = Math.min(maxDimension / originalWidth, maxDimension / originalHeight);
  return {
    width: Math.round(originalWidth * ratio),
    height: Math.round(originalHeight * ratio),
  };
}
</file>

