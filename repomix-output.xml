                                    onDelete={(item) => setConfirm({
                                      type: "assignment",
                                      id: item.id,
                                      title: "Xóa lịch trực đã phân?",
                                      message: `${item.staff?.fullName || item.staff?.email || "Nhân viên"} sẽ được gỡ khỏi ca ${shift.name} ngày ${date}.`,
                                    })}
                                  />
                                </Paper>
                              );
                            })}
                          </Stack>
                        ))}
                      </Box>
                    ))}
                  </Stack>
                </Box>
              </Paper>
            </Stack>
            <DragOverlay dropAnimation={null}>
