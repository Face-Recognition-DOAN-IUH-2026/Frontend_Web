<file path="src/app/(dashboard)/dashboard/admin/page.tsx">
"use client";

import { useEffect, useState } from "react";
import { useRouter } from "next/navigation";
import {
  Alert,
  Avatar,
  Box,
  Button,
  Chip,
  CircularProgress,
  Dialog,
  DialogActions,
  DialogContent,
  DialogTitle,
  FormControl,
  Grid,
  InputLabel,
  MenuItem,
  Paper,
  Select,
  Snackbar,
  Stack,
  Table,
  TableBody,
  TableCell,
  TableContainer,
  TableHead,
  TableRow,
  TextField,
  Typography,
} from "@mui/material";
import AddOutlinedIcon from "@mui/icons-material/AddOutlined";
import AdminPanelSettingsOutlinedIcon from "@mui/icons-material/AdminPanelSettingsOutlined";
import DeleteOutlineOutlinedIcon from "@mui/icons-material/DeleteOutlineOutlined";
import FaceRetouchingNaturalOutlinedIcon from "@mui/icons-material/FaceRetouchingNaturalOutlined";
import GroupsOutlinedIcon from "@mui/icons-material/GroupsOutlined";
import PersonOutlineOutlinedIcon from "@mui/icons-material/PersonOutlineOutlined";
import api from "@/lib/api-client";
import { useAuth } from "@/lib/auth-context";
import { fadeInUp, shimmer, slideInRight } from "@/lib/animations";
import type { UserPublic } from "@/lib/types";

function roleLabel(role: string) {
  if (role === "admin") return "Quản trị";
  if (role === "staff") return "Nhân viên";
  if (role === "patron") return "Độc giả";
  return role;
}

function initials(email: string) {
  return email.slice(0, 1).toUpperCase();
}

export default function AdminPage() {
  const { isLoading, isAuthenticated } = useAuth();
  const router = useRouter();
  const [users, setUsers] = useState<UserPublic[]>([]);
  const [total, setTotal] = useState(0);
  const [loading, setLoading] = useState(true);
  const [showCreate, setShowCreate] = useState(false);
  const [deleteTarget, setDeleteTarget] = useState<UserPublic | null>(null);
  const [deleteConfirmText, setDeleteConfirmText] = useState("");
  const [restoreTarget, setRestoreTarget] = useState<UserPublic | null>(null);
  const [restoreConfirmText, setRestoreConfirmText] = useState("");
  const [createForm, setCreateForm] = useState({ email: "", password: "", role: "staff" });
  const [createError, setCreateError] = useState("");
  const [notice, setNotice] = useState("");

  useEffect(() => {
    if (!isLoading && !isAuthenticated) router.push("/login");
  }, [isLoading, isAuthenticated, router]);

  const load = async () => {
    try {
      const data = await api.listUsers();
      setUsers(data.users);
      setTotal(data.total);
    } finally {
      setLoading(false);
    }
  };

  useEffect(() => { load(); }, []);

  const handleCreate = async () => {
    if (!createForm.email || !createForm.password) {
      setCreateError("Vui lòng nhập email và mật khẩu.");
      return;
    }
    try {
      setCreateError("");
      await api.register(createForm);
      setShowCreate(false);
      setCreateForm({ email: "", password: "", role: "staff" });
      setNotice("Đã tạo người dùng mới.");
      load();
    } catch (err: any) {
      setCreateError(err?.response?.data?.detail || "Tạo người dùng thất bại.");
    }
  };

  const handleDelete = async () => {
    if (!deleteTarget || deleteConfirmText !== "XÓA") return;
    const current = deleteTarget;
    setDeleteTarget(null);
    setDeleteConfirmText("");
    setUsers((prev) => prev.filter((u) => u.id !== current.id));
    try {
      await api.deleteUser(current.id);
      setNotice("Đã xóa người dùng.");
    } catch {
      setNotice("Xóa thất bại, dữ liệu đã được tải lại.");
      load();
    }
  };

  const handleRestore = async () => {
    if (!restoreTarget || restoreConfirmText !== "KHÔI PHỤC") return;
    const current = restoreTarget;
    setRestoreTarget(null);
    setRestoreConfirmText("");
    setUsers((prev) => prev.filter((u) => u.id !== current.id));
    try {
      await api.restoreUser(current.id);
      setNotice("Đã khôi phục người dùng.");
      load();
    } catch {
      setNotice("Khôi phục thất bại.");
      load();
    }
  };

  if (isLoading) {
    return (
      <Stack sx={{ minHeight: 400, alignItems: "center", justifyContent: "center" }}>
        <CircularProgress sx={{ animation: `${shimmer} 1.5s ease-in-out infinite` }} />
      </Stack>
    );
  }
  if (!isAuthenticated) return null;

  const adminCount = users.filter((item) => item.role === "admin").length;
  const staffCount = users.filter((item) => item.role === "staff").length;
  const faceCount = users.filter((item) => item.has_face).length;

  return (
    <Stack spacing={3}>
      <Paper variant="outlined" sx={{ p: 3 }}>
        <Stack direction={{ xs: "column", md: "row" }} spacing={2} sx={{ alignItems: { md: "center" }, justifyContent: "space-between" }}>
          <Box>
            <Stack direction="row" spacing={1.25} sx={{ alignItems: "center" }}>
              <AdminPanelSettingsOutlinedIcon color="primary" />
              <Typography variant="h4" sx={{ fontWeight: 850 }}>
                Quản trị người dùng
              </Typography>
            </Stack>
            <Typography color="text.secondary" sx={{ mt: 0.5 }}>
              Tạo tài khoản admin/staff và theo dõi trạng thái đăng ký khuôn mặt.
            </Typography>
          </Box>
          <Button variant="contained" startIcon={<AddOutlinedIcon />} onClick={() => setShowCreate(true)}>
            Thêm người dùng
          </Button>
        </Stack>
      </Paper>

      <Grid container spacing={2}>
        {[
          { label: "Tổng người dùng", value: total, icon: <GroupsOutlinedIcon /> },
          { label: "Quản trị viên", value: adminCount, icon: <AdminPanelSettingsOutlinedIcon /> },
          { label: "Nhân viên", value: staffCount, icon: <PersonOutlineOutlinedIcon /> },
          { label: "Đã có khuôn mặt", value: faceCount, icon: <FaceRetouchingNaturalOutlinedIcon /> },
        ].map((item, idx) => (
          <Grid key={item.label} size={{ xs: 12, sm: 6, lg: 3 }} sx={{ animation: `${fadeInUp} 0.35s ease-out`, animationDelay: `${idx * 0.08}s`, animationFillMode: "both" }}>
            <Paper variant="outlined" sx={{ p: 2.25 }}>
              <Stack direction="row" spacing={1.5} sx={{ alignItems: "center" }}>
                <Avatar sx={{ bgcolor: "action.hover", color: "primary.main" }}>{item.icon}</Avatar>
                <Box>
                  <Typography color="text.secondary" variant="body2">{item.label}</Typography>
                  <Typography variant="h5" sx={{ fontWeight: 850 }}>{item.value}</Typography>
                </Box>
              </Stack>
            </Paper>
          </Grid>
        ))}
      </Grid>

      <Paper variant="outlined" sx={{ overflow: "hidden" }}>
        <TableContainer>
          <Table sx={{ minWidth: 760 }}>
            <TableHead>
              <TableRow>
                <TableCell>Email</TableCell>
                <TableCell>Vai trò</TableCell>
                <TableCell>Khuôn mặt</TableCell>
                <TableCell align="right">Hành động</TableCell>
              </TableRow>
            </TableHead>
            <TableBody>
              {loading ? (
                <TableRow>
                  <TableCell colSpan={4}>
                    <Stack sx={{ py: 6, alignItems: "center" }}>
                      <CircularProgress size={28} sx={{ animation: `${shimmer} 1.5s ease-in-out infinite` }} />
                    </Stack>
                  </TableCell>
                </TableRow>
              ) : users.length === 0 ? (
                <TableRow>
                  <TableCell colSpan={4}>
                    <Alert severity="info">Không có người dùng nào.</Alert>
                  </TableCell>
                </TableRow>
              ) : (
                users.map((item, idx) => (
                  <TableRow key={item.id} hover sx={{ animation: `${slideInRight} 0.3s ease-out`, animationDelay: `${idx * 0.03}s`, animationFillMode: "both" }}>
                    <TableCell>
                      <Stack direction="row" spacing={1.5} sx={{ alignItems: "center" }}>
                        <Avatar sx={{ width: 34, height: 34, bgcolor: "primary.main", color: "primary.contrastText", fontWeight: 800 }}>
                          {initials(item.email)}
                        </Avatar>
                        <Box sx={{ minWidth: 0 }}>
                          <Typography sx={{ fontWeight: 750 }} noWrap>{item.email}</Typography>
                          {item.full_name && <Typography variant="body2" color="text.secondary" noWrap>{item.full_name}</Typography>}
                        </Box>
                      </Stack>
                    </TableCell>
                    <TableCell>
                      <Chip
                        size="small"
                        color={item.role === "admin" ? "warning" : item.role === "staff" ? "primary" : "default"}
                        label={roleLabel(item.role)}
                      />
                    </TableCell>
                    <TableCell>
                      <Chip
                        size="small"
                        color={item.has_face ? "success" : "default"}
                        label={item.has_face ? "Đã xác thực" : "Chưa xác thực"}
                      />
                    </TableCell>
                    <TableCell align="right">
                      {item.status === "deleted" ? (
                        <Button
                          color="success"
                          variant="outlined"
                          size="small"
                          onClick={() => setRestoreTarget(item)}
                        >
                          Khôi phục
                        </Button>
                      ) : (
                        <Button
                          color="error"
                          variant="outlined"
                          size="small"
                          startIcon={<DeleteOutlineOutlinedIcon />}
                          onClick={() => setDeleteTarget(item)}
                        >
                          Xóa
                        </Button>
                      )}
                    </TableCell>
                  </TableRow>
                ))
              )}
            </TableBody>
          </Table>
        </TableContainer>
      </Paper>

      <Dialog open={showCreate} onClose={() => setShowCreate(false)} fullWidth maxWidth="sm">
        <DialogTitle>Thêm người dùng</DialogTitle>
        <DialogContent>
          <Stack spacing={2} sx={{ pt: 1 }}>
            {createError && <Alert severity="error">{createError}</Alert>}
            <TextField
              label="Email"
              type="email"
              value={createForm.email}
              onChange={(event) => setCreateForm({ ...createForm, email: event.target.value })}
              fullWidth
            />
            <TextField
              label="Mật khẩu"
              type="password"
              value={createForm.password}
              onChange={(event) => setCreateForm({ ...createForm, password: event.target.value })}
              fullWidth
            />
            <FormControl fullWidth>
              <InputLabel>Vai trò</InputLabel>
              <Select
                label="Vai trò"
                value={createForm.role}
                onChange={(event) => setCreateForm({ ...createForm, role: event.target.value })}
              >
                <MenuItem value="staff">Nhân viên</MenuItem>
                <MenuItem value="admin">Quản trị</MenuItem>
              </Select>
            </FormControl>
          </Stack>
        </DialogContent>
        <DialogActions>
          <Button onClick={() => setShowCreate(false)}>Hủy</Button>
          <Button variant="contained" onClick={handleCreate}>Tạo</Button>
        </DialogActions>
      </Dialog>

      <Dialog open={Boolean(deleteTarget)} onClose={() => { setDeleteTarget(null); setDeleteConfirmText(""); }} fullWidth maxWidth="xs">
        <DialogTitle>Xóa người dùng?</DialogTitle>
        <DialogContent>
          <Stack spacing={2}>
            <Typography color="text.secondary">
              Tài khoản <strong>{deleteTarget?.email}</strong> sẽ bị xóa khỏi hệ thống. Dữ liệu liên quan (thông báo, lịch trực) cũng sẽ bị xóa.
            </Typography>
            <Typography variant="body2" color="text.secondary">
              Nhập <strong>XÓA</strong> để xác nhận:
            </Typography>
            <TextField
              value={deleteConfirmText}
              onChange={(e) => setDeleteConfirmText(e.target.value)}
              placeholder="Nhập XÓA"
              size="small"
              autoFocus
              fullWidth
            />
          </Stack>
        </DialogContent>
        <DialogActions>
          <Button onClick={() => { setDeleteTarget(null); setDeleteConfirmText(""); }}>Hủy</Button>
          <Button color="error" variant="contained" onClick={handleDelete} disabled={deleteConfirmText !== "XÓA"}>
            Xóa vĩnh viễn
          </Button>
        </DialogActions>
      </Dialog>

      <Dialog open={Boolean(restoreTarget)} onClose={() => { setRestoreTarget(null); setRestoreConfirmText(""); }} fullWidth maxWidth="xs">
        <DialogTitle>Khôi phục người dùng?</DialogTitle>
        <DialogContent>
          <Stack spacing={2}>
            <Typography color="text.secondary">
              Khôi phục tài khoản <strong>{restoreTarget?.email}</strong>?
            </Typography>
            <Typography variant="body2" color="text.secondary">
              Nhập <strong>KHÔI PHỤC</strong> để xác nhận:
            </Typography>
            <TextField
              value={restoreConfirmText}
              onChange={(e) => setRestoreConfirmText(e.target.value)}
              placeholder="Nhập KHÔI PHỤC"
              size="small"
              autoFocus
              fullWidth
            />
          </Stack>
        </DialogContent>
        <DialogActions>
          <Button onClick={() => { setRestoreTarget(null); setRestoreConfirmText(""); }}>Hủy</Button>
          <Button color="success" variant="contained" onClick={handleRestore} disabled={restoreConfirmText !== "KHÔI PHỤC"}>
            Khôi phục
          </Button>
        </DialogActions>
      </Dialog>

      <Snackbar open={Boolean(notice)} autoHideDuration={3000} onClose={() => setNotice("")} message={notice} />
    </Stack>
  );
}
</file>

<file path="src/lib/auth-context.tsx">
"use client";

import {
  createContext,
  useContext,
  useState,
  useEffect,
  useCallback,
  type ReactNode,
} from "react";
import { useRouter } from "next/navigation";
import api from "./api-client";
import type { AuthContextType, AuthUser, LoginRequest } from "./types";

function decodeJwtPayload(token: string): Record<string, unknown> | null {
  try {
    const base64Url = token.split(".")[1];
    const base64 = base64Url.replace(/-/g, "+").replace(/_/g, "/");
    const jsonPayload = decodeURIComponent(
      atob(base64)
        .split("")
        .map((c) => "%" + ("00" + c.charCodeAt(0).toString(16)).slice(-2))
        .join("")
    );
    return JSON.parse(jsonPayload);
  } catch {
    return null;
  }
}

const AuthContext = createContext<AuthContextType | undefined>(undefined);

function assertWebRole(role: string) {
  if (role !== "admin" && role !== "staff") {
    throw new Error("Web quản trị chỉ dành cho admin hoặc staff. Độc giả vui lòng đăng nhập trên ứng dụng mobile.");
  }
}

export function AuthProvider({ children }: { children: ReactNode }) {
  const router = useRouter();
  const [user, setUser] = useState<AuthUser | null>(null);
  const [accessToken, setAccessToken] = useState<string | null>(null);
  const [isLoading, setIsLoading] = useState(true);

  const loadUserFromStorage = useCallback(() => {
    if (typeof window === "undefined") return;

    const storedToken = localStorage.getItem("access_token");
    const storedUser = localStorage.getItem("user");

    if (storedToken && storedUser) {
      try {
        setAccessToken(storedToken);
        setUser(JSON.parse(storedUser));
      } catch {
        localStorage.removeItem("access_token");
        localStorage.removeItem("user");
      }
    }
    setIsLoading(false);
  }, []);

  useEffect(() => {
    loadUserFromStorage();
  }, [loadUserFromStorage]);

  const setTokenCookie = (token: string) => {
    document.cookie = `access_token=${token}; path=/; max-age=86400; samesite=strict; secure`;
  };

  const clearTokenCookie = () => {
    document.cookie = "access_token=; path=/; max-age=0";
  };

  const login = async (email: string, password: string) => {
    const data: LoginRequest = { email, password };
    const response = await api.login(data);
    if (!response.access_token) {
      throw new Error("Backend did not return access_token");
    }

    localStorage.setItem("access_token", response.access_token);
    setTokenCookie(response.access_token);
    if (response.refresh_token) {
      localStorage.setItem("refresh_token", response.refresh_token);
    }
    setAccessToken(response.access_token);

    const payload = decodeJwtPayload(response.access_token);
    const userData: AuthUser = {
      id: (payload?.sub as string) || "",
      email,
      role: ((payload?.roles as string[])?.[0]) || "user",
      full_name: (payload?.full_name as string) || null,
    };
    assertWebRole(userData.role);
    localStorage.setItem("user", JSON.stringify(userData));
    setUser(userData);

    router.push("/dashboard");
  };

  const setAuthFromToken = (accessToken: string, refreshToken: string | null, email: string, role?: string) => {
    localStorage.setItem("access_token", accessToken);
    setTokenCookie(accessToken);
    if (refreshToken) {
      localStorage.setItem("refresh_token", refreshToken);
    }

    // Decode JWT to get user id and role if not provided
    const payload = decodeJwtPayload(accessToken);
    const userId = (payload?.sub as string) || "";
    const userRole = role || ((payload?.roles as string[])?.[0]) || "user";
    assertWebRole(userRole);

    const userData: AuthUser = { id: userId, email, role: userRole, full_name: (payload?.full_name as string) || null };
    localStorage.setItem("user", JSON.stringify(userData));
    setAccessToken(accessToken);
    setUser(userData);
  };

  const logout = () => {
    localStorage.removeItem("access_token");
    localStorage.removeItem("refresh_token");
    localStorage.removeItem("user");
    clearTokenCookie();
    setUser(null);
    setAccessToken(null);
    router.push("/login");
  };

  const refreshAccessToken = async (): Promise<boolean> => {
    try {
      const refreshToken = localStorage.getItem("refresh_token");
      if (!refreshToken) return false;

      const { access_token, refresh_token: newRefreshToken } = await api.refreshAuthToken(refreshToken);
      if (access_token) {
        localStorage.setItem("access_token", access_token);
        setTokenCookie(access_token);
        setAccessToken(access_token);
      }
      if (newRefreshToken) {
        localStorage.setItem("refresh_token", newRefreshToken);
      }
      return true;
    } catch {
      return false;
    }
  };

  return (
    <AuthContext.Provider
      value={{
        user,
        accessToken,
        login,
        setAuthFromToken,
        logout,
        refreshAccessToken,
        isAuthenticated: !!user && !!accessToken,
        isLoading,
      }}
    >
      {children}
    </AuthContext.Provider>
  );
}

export function useAuth() {
  const context = useContext(AuthContext);
  if (context === undefined) {
    throw new Error("useAuth must be used within an AuthProvider");
  }
  return context;
}
