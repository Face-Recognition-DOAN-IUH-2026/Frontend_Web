"use client";

import React from "react";
import {
  Alert,
  Box,
  Button,
  CircularProgress,
  Dialog,
  DialogActions,
  DialogContent,
  DialogTitle,
  Stack,
  TextField,
  Typography,
} from "@mui/material";
import AlertIcon from "@mui/icons-material/WarningAmberOutlined";
import LockIcon from "@mui/icons-material/LockOutlined";
import DeleteIcon from "@mui/icons-material/DeleteOutlineOutlined";
import type { BookWithStats } from "@/lib/types";

export interface BookBulkDeleteDialogProps {
  open: boolean;
  onClose: () => void;
  selectedIds: Set<string>;
  displayBooks: BookWithStats[];
  deleteInput: string;
  setDeleteInput: (val: string) => void;
  deleteConfirmed: boolean;
  deleting: boolean;
  onDelete: () => void;
}

export function BookBulkDeleteDialog({
  open,
  onClose,
  selectedIds,
  displayBooks,
  deleteInput,
  setDeleteInput,
  deleteConfirmed,
  deleting,
  onDelete,
}: BookBulkDeleteDialogProps) {
  const selectedBooks = displayBooks.filter((b) => selectedIds.has(b.id));
  const hasBorrowed = selectedBooks.some((b) => b.total_copies - b.available_copies > 0);

  return (
    <Dialog open={open} onClose={onClose} maxWidth="sm" fullWidth>
      <DialogTitle sx={{ display: "flex", alignItems: "center", gap: 1, fontFamily: "'Space Grotesk', sans-serif" }}>
        <AlertIcon sx={{ color: "warning.main" }} />
        Xóa {selectedIds.size} cuốn sách?
      </DialogTitle>
      <DialogContent>
        <Stack spacing={2} sx={{ mt: 1 }}>
          <Typography variant="body2" color="text.secondary">
            Sách sẽ bị xóa vĩnh viễn cùng tất cả bản sao:
          </Typography>
          <Box sx={{ maxHeight: 200, overflow: "auto", p: 1, bgcolor: "grey.900", borderRadius: 1 }}>
            {selectedBooks.map((book) => (
              <Stack key={book.id} direction="row" spacing={1} sx={{ py: 0.5, alignItems: "center" }}>
                {book.total_copies - book.available_copies > 0 ? (
                  <LockIcon fontSize="small" sx={{ color: "error.main" }} />
                ) : null}
                <Typography variant="body2" sx={{ fontFamily: "'JetBrains Mono', monospace", color: "text.secondary", minWidth: 120 }}>
                  {book.isbn}
                </Typography>
                <Typography variant="body2" sx={{ fontWeight: 600, flex: 1 }} noWrap>
                  {book.title}
                </Typography>
                <Typography variant="caption" color="text.secondary">
                  {book.total_copies} bản
                </Typography>
              </Stack>
            ))}
          </Box>
          {hasBorrowed ? (
            <Alert severity="error">
              Một số sách đang được mượn và sẽ không thể xóa. Hệ thống sẽ bỏ qua chúng.
            </Alert>
          ) : null}
          <TextField
            label='Nhập "XÓA" để xác nhận'
            value={deleteInput}
            onChange={(e) => setDeleteInput(e.target.value)}
            fullWidth
            size="small"
            autoFocus
          />
        </Stack>
      </DialogContent>
      <DialogActions sx={{ p: 2 }}>
        <Button onClick={onClose} sx={{ textTransform: "none" }}>
          Hủy
        </Button>
        <Button
          variant="contained"
          color="error"
          disabled={!deleteConfirmed || deleting}
          onClick={onDelete}
          startIcon={deleting ? <CircularProgress size={16} /> : <DeleteIcon />}
          sx={{ textTransform: "none", fontWeight: 700 }}
        >
          {deleting ? "Đang xóa..." : "Xóa vĩnh viễn"}
        </Button>
      </DialogActions>
    </Dialog>
  );
}
</file>

<file path="src/app/(dashboard)/_components/books/BookBulkPriceDialog.tsx">
"use client";

import React, { useState, useEffect } from "react";
import {
  Alert,
  Box,
  Button,
  Chip,
  CircularProgress,
  Dialog,
  DialogActions,
  DialogContent,
  DialogTitle,
  InputAdornment,
  Stack,
  TextField,
  Typography,
} from "@mui/material";
import PaidOutlinedIcon from "@mui/icons-material/PaidOutlined";
import SellOutlinedIcon from "@mui/icons-material/SellOutlined";
import type { BookWithStats } from "@/lib/types";
import api, { getErrorMessage } from "@/lib/api-client";

export interface BookBulkPriceDialogProps {
  open: boolean;
  onClose: () => void;
  selectedIds: Set<string>;
  displayBooks: BookWithStats[];
  onSuccess: () => void;
  showNotice: (severity: "success" | "error" | "warning" | "info", message: string) => void;
}

const PRESET_PRICES = [50000, 80000, 100000, 120000, 150000, 200000];

export function BookBulkPriceDialog({
  open,
  onClose,
  selectedIds,
  displayBooks,
  onSuccess,
  showNotice,
}: BookBulkPriceDialogProps) {
  const [priceInput, setPriceInput] = useState<string>("");
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState<string | null>(null);

  const selectedBooks = displayBooks.filter((b) => selectedIds.has(b.id));

  // Reset form khi mở dialog
  useEffect(() => {
    if (open) {
      if (selectedBooks.length === 1 && selectedBooks[0].price != null) {
        setPriceInput(String(Math.round(Number(selectedBooks[0].price))));
      } else {
        setPriceInput("");
      }
      setError(null);
      setLoading(false);
    }
  }, [open, selectedBooks.length]);

  const numPrice = Number(priceInput.replace(/\D/g, ""));

  const handlePriceChange = (val: string) => {
    const raw = val.replace(/\D/g, "");
    setPriceInput(raw);
    if (error) setError(null);
  };

  const handleSave = async () => {
    if (!priceInput || isNaN(numPrice) || numPrice <= 0) {
      setError("Vui lòng nhập giá sách hợp lệ lớn hơn 0 đ");
      return;
    }
    if (selectedIds.size === 0) {
      setError("Chưa chọn cuốn sách nào");
      return;
    }

    setLoading(true);
    try {
      const bookIds = Array.from(selectedIds);
      const res = await api.bulkUpdateBookPrices(bookIds, numPrice);
      showNotice(
        "success",
        `Đã cập nhật đơn giá ${numPrice.toLocaleString("vi-VN")} đ cho ${res.updated || bookIds.length} cuốn sách`
      );
      onSuccess();
      onClose();
    } catch (err) {
      setError(getErrorMessage(err) || "Không thể cập nhật giá sách");
    } finally {
      setLoading(false);
    }
  };

  return (
    <Dialog open={open} onClose={loading ? undefined : onClose} maxWidth="sm" fullWidth>
      <DialogTitle sx={{ display: "flex", alignItems: "center", gap: 1, fontFamily: "'Space Grotesk', sans-serif" }}>
        <PaidOutlinedIcon sx={{ color: "primary.main" }} />
        {selectedIds.size === 1
          ? `Cập nhật đơn giá: ${selectedBooks[0]?.title || "1 cuốn sách"}`
          : `Sửa giá hàng loạt cho ${selectedIds.size} cuốn sách`}
      </DialogTitle>
      <DialogContent>
        <Stack spacing={2.5} sx={{ mt: 1 }}>
          <Typography variant="body2" color="text.secondary">
            Đơn giá này được dùng để quản lý giá trị tài sản thư viện và tự động tính phí bồi thường khi bạn đọc làm mất hoặc hư hỏng sách.
          </Typography>

          {/* Danh sách sách đang chọn */}
          <Box sx={{ maxHeight: 150, overflow: "auto", p: 1.5, bgcolor: "action.hover", borderRadius: 1 }}>
            {selectedBooks.slice(0, 5).map((book) => (
              <Stack key={book.id} direction="row" spacing={1} sx={{ py: 0.5, alignItems: "center" }}>
                <SellOutlinedIcon fontSize="small" sx={{ color: "text.secondary", fontSize: 16 }} />
                <Typography
                  variant="body2"
                  sx={{ fontFamily: "'JetBrains Mono', monospace", color: "text.secondary", minWidth: 120 }}
                >
                  {book.isbn}
                </Typography>
                <Typography variant="body2" sx={{ fontWeight: 600, flex: 1 }} noWrap>
                  {book.title}
                </Typography>
                <Typography variant="caption" color="primary.main" sx={{ fontWeight: 600 }}>
                  {book.price != null && Number(book.price) > 0
                    ? `${Number(book.price).toLocaleString("vi-VN")} đ`
                    : "Chưa có giá"}
                </Typography>
              </Stack>
            ))}
            {selectedBooks.length > 5 && (
              <Typography variant="caption" color="text.secondary" sx={{ display: "block", mt: 0.5, textAlign: "center" }}>
                ... và {selectedBooks.length - 5} cuốn sách khác
              </Typography>
            )}
          </Box>

          {/* Ô nhập giá */}
          <TextField
            label="Đơn giá mới (VNĐ)"
            value={priceInput ? Number(priceInput).toLocaleString("vi-VN") : ""}
            onChange={(e) => handlePriceChange(e.target.value)}
            fullWidth
            size="small"
            autoFocus
            error={Boolean(error)}
            helperText={error || "Ví dụ: 120.000 đ"}
            slotProps={{
              input: {
                endAdornment: <InputAdornment position="end">VNĐ</InputAdornment>,
              },
            }}
          />

          {/* Gợi ý mức giá phổ biến */}
          <Stack spacing={1}>
            <Typography variant="caption" color="text.secondary" sx={{ fontWeight: 600 }}>
              Gợi ý mức giá thông dụng:
            </Typography>
            <Stack direction="row" spacing={1} sx={{ flexWrap: "wrap", gap: 1 }}>
              {PRESET_PRICES.map((p) => (
                <Chip
                  key={p}
                  label={`${p.toLocaleString("vi-VN")} đ`}
                  clickable
                  variant={numPrice === p ? "filled" : "outlined"}
                  color={numPrice === p ? "primary" : "default"}
                  size="small"
                  onClick={() => handlePriceChange(String(p))}
                  sx={{ fontWeight: 600 }}
                />
              ))}
            </Stack>
          </Stack>

          {error && <Alert severity="error">{error}</Alert>}
        </Stack>
      </DialogContent>
      <DialogActions sx={{ p: 2 }}>
        <Button onClick={onClose} disabled={loading} sx={{ textTransform: "none" }}>
          Hủy
        </Button>
        <Button
          variant="contained"
          color="primary"
          disabled={loading || !numPrice || numPrice <= 0}
          onClick={handleSave}
          startIcon={loading ? <CircularProgress size={16} color="inherit" /> : <PaidOutlinedIcon />}
          sx={{ textTransform: "none", fontWeight: 700 }}
        >
          {loading ? "Đang cập nhật..." : `Áp dụng ${numPrice > 0 ? `${numPrice.toLocaleString("vi-VN")} đ` : ""}`}
        </Button>
      </DialogActions>
    </Dialog>
  );
}
</file>

<file path="src/app/(dashboard)/_components/books/BookCopiesTable.tsx">
"use client";

import React, { useState } from "react";
import {
  Box,
  Button,
  Chip,
  CircularProgress,
  Dialog,
  DialogActions,
  DialogContent,
  DialogTitle,
  FormControl,
  IconButton,
  InputLabel,
  MenuItem,
  Select,
  Stack,
  Table,
  TableBody,
  TableCell,
  TableContainer,
  TableHead,
  TableRow,
  TextField,
  Tooltip,
  Typography,
} from "@mui/material";
import AddIcon from "@mui/icons-material/Add";
import EditIcon from "@mui/icons-material/EditOutlined";
import DeleteIcon from "@mui/icons-material/DeleteOutlineOutlined";
import QrCode2Icon from "@mui/icons-material/QrCode2";
import api, { getErrorMessage } from "@/lib/api-client";
import type { BookCopy } from "@/lib/types";
import {
  CONDITION_CODES,
  CONDITION_LABELS,
  getConditionColor,
  COPY_STATUS_CODES,
  COPY_STATUS_LABELS,
  getStatusColor,
  type CopyCondition,
  type CopyStatus,
} from "@/lib/constants/copy";
import DashboardCard from "@/app/(dashboard)/_components/ui/DashboardCard";

interface BookCopiesTableProps {
  bookId: string;
  isbn?: string;
  copies?: BookCopy[];
  loading?: boolean;
  onRefresh: () => void;
  showNotice: (
    severity: "success" | "error" | "warning" | "info",
    message: string
  ) => void;
}

export function BookCopiesTable({
  bookId,
  isbn,
  copies: rawCopies = [],
  loading = false,
  onRefresh,
  showNotice,
}: BookCopiesTableProps) {
  const copies = Array.isArray(rawCopies)
    ? rawCopies
    : Array.isArray((rawCopies as any)?.items)
    ? (rawCopies as any).items
    : Array.isArray((rawCopies as any)?.data)
    ? (rawCopies as any).data
    : [];

  // Add modal state
  const [addOpen, setAddOpen] = useState(false);
  const [addLoading, setAddLoading] = useState(false);
  const [addBarcode, setAddBarcode] = useState("");
  const [addCondition, setAddCondition] = useState<CopyCondition>("new");
  const [addStatus, setAddStatus] = useState<CopyStatus>("available");
  const [addShelf, setAddShelf] = useState("");

  // Edit modal state
  const [editCopy, setEditCopy] = useState<BookCopy | null>(null);
  const [editLoading, setEditLoading] = useState(false);
  const [editCondition, setEditCondition] = useState<CopyCondition>("good");
  const [editStatus, setEditStatus] = useState<CopyStatus>("available");
  const [editShelf, setEditShelf] = useState("");
  const [editNote, setEditNote] = useState("");

  // Delete modal state
  const [deleteCopy, setDeleteCopy] = useState<BookCopy | null>(null);
  const [deleteLoading, setDeleteLoading] = useState(false);

  const handleOpenAdd = () => {
    setAddBarcode("");
    setAddCondition("new");
    setAddStatus("available");
    setAddShelf("");
    setAddOpen(true);
  };

  const handleCreate = async () => {
    setAddLoading(true);
    try {
      await api.createBookCopy({
        book_id: bookId,
        barcode: addBarcode.trim() || undefined,
        condition: addCondition,
        status: addStatus,
        shelf_location: addShelf.trim() || undefined,
      });
      showNotice("success", "Thêm bản sao thành công");
      setAddOpen(false);
      onRefresh();
    } catch (err) {
      showNotice("error", getErrorMessage(err) || "Thêm bản sao thất bại");
    } finally {
      setAddLoading(false);
    }
  };

  const handleOpenEdit = (copy: BookCopy) => {
    setEditCopy(copy);
    setEditCondition((copy.condition as CopyCondition) || "good");
    setEditStatus((copy.status as CopyStatus) || "available");
    setEditShelf(copy.shelf_location || "");
    setEditNote("");
  };

  const handleUpdate = async () => {
    if (!editCopy) return;
    setEditLoading(true);
    try {
      await api.updateBookCopy(editCopy.id, {
        condition: editCondition,
        status: editStatus,
        shelf_location: editShelf.trim() || undefined,
        note: editNote.trim() || undefined,
      });
      showNotice("success", "Cập nhật bản sao thành công");
      setEditCopy(null);
      onRefresh();
    } catch (err) {
      showNotice("error", getErrorMessage(err) || "Cập nhật bản sao thất bại");
    } finally {
      setEditLoading(false);
    }
  };

  const handleDelete = async () => {
    if (!deleteCopy) return;
    setDeleteLoading(true);
    try {
      await api.deleteBookCopy(deleteCopy.id);
      showNotice("success", "Xóa bản sao thành công");
      setDeleteCopy(null);
      onRefresh();
    } catch (err) {
      showNotice("error", getErrorMessage(err) || "Xóa bản sao thất bại");
    } finally {
      setDeleteLoading(false);
    }
  };

  const cardAction = (
    <Button
      variant="contained"
      size="small"
      startIcon={<AddIcon />}
      onClick={handleOpenAdd}
    >
      Thêm bản sao
    </Button>
  );

  return (
    <DashboardCard title="Danh sách bản sao" actions={cardAction}>
      {loading ? (
        <Box sx={{ display: "flex", justifyContent: "center", py: 4 }}>
          <CircularProgress size={32} />
        </Box>
      ) : copies.length === 0 ? (
        <Box sx={{ py: 3, textAlign: "center" }}>
          <Typography color="text.secondary">
            Chưa có bản sao nào. Hãy nhấn &quot;Thêm bản sao&quot; để tạo mã vạch quản lý.
          </Typography>
        </Box>
      ) : (
        <TableContainer>
          <Table size="small">
            <TableHead>
              <TableRow>
                <TableCell sx={{ fontWeight: 600 }}>Mã vạch</TableCell>
                <TableCell sx={{ fontWeight: 600 }}>Tình trạng</TableCell>
                <TableCell sx={{ fontWeight: 600 }}>Trạng thái</TableCell>
                <TableCell sx={{ fontWeight: 600 }}>Ngày nhập</TableCell>
                <TableCell sx={{ fontWeight: 600 }}>Vị trí kệ</TableCell>
                <TableCell align="right" sx={{ fontWeight: 600 }}>
                  Thao tác
                </TableCell>
              </TableRow>
            </TableHead>
            <TableBody>
              {copies.map((copy: BookCopy) => {
                const condition = (copy.condition as CopyCondition) || "new";
                const status = (copy.status as CopyStatus) || "available";
                const formattedDate = copy.imported_at
                  ? new Date(copy.imported_at).toLocaleDateString("vi-VN", {
                      day: "2-digit",
                      month: "2-digit",
                      year: "numeric",
                    })
                  : "-";

                return (
                  <TableRow key={copy.id} hover>
                    <TableCell>
                      <Stack direction="row" spacing={1} sx={{ alignItems: "center" }}>
                        <QrCode2Icon fontSize="small" sx={{ color: "text.secondary" }} />
                        <Typography
                          variant="body2"
                          sx={{ fontFamily: "monospace", fontWeight: 600 }}
                        >
                          {copy.barcode}
                        </Typography>
                      </Stack>
                    </TableCell>
                    <TableCell>
                      <Chip
                        size="small"
                        label={CONDITION_LABELS[condition] || condition}
                        color={getConditionColor(condition)}
                        variant="outlined"
                      />
                    </TableCell>
                    <TableCell>
                      <Chip
                        size="small"
                        label={COPY_STATUS_LABELS[status] || status}
                        color={getStatusColor(status)}
                      />
                    </TableCell>
                    <TableCell>{formattedDate}</TableCell>
                    <TableCell>{copy.shelf_location || "-"}</TableCell>
                    <TableCell align="right">
                      <Tooltip title="Chỉnh sửa bản sao">
                        <IconButton
                          aria-label={`Sửa bản sao ${copy.barcode}`}
                          size="small"
                          onClick={() => handleOpenEdit(copy)}
                        >
                          <EditIcon fontSize="small" />
                        </IconButton>
                      </Tooltip>
                      <Tooltip title="Xóa bản sao">
                        <IconButton
                          aria-label={`Xóa bản sao ${copy.barcode}`}
                          size="small"
                          color="error"
                          onClick={() => setDeleteCopy(copy)}
                        >
                          <DeleteIcon fontSize="small" />
                        </IconButton>
                      </Tooltip>
                    </TableCell>
                  </TableRow>
                );
              })}
            </TableBody>
          </Table>
        </TableContainer>
      )}

      {/* Add Copy Dialog */}
      <Dialog
        open={addOpen}
        onClose={() => !addLoading && setAddOpen(false)}
        maxWidth="xs"
        fullWidth
      >
        <DialogTitle sx={{ fontWeight: 700 }}>Thêm bản sao mới</DialogTitle>
        <DialogContent dividers>
          <Stack spacing={2} sx={{ pt: 1 }}>
            <TextField
              label="Mã vạch (Barcode)"
              placeholder={`VD: LIB-${isbn || "..."}-001`}
              helperText="Để trống để hệ thống tự động sinh theo mẫu LIB-<isbn>-<seq>"
              value={addBarcode}
              onChange={(e) => setAddBarcode(e.target.value)}
              fullWidth
            />
            <FormControl fullWidth>
              <InputLabel id="add-condition-label">Tình trạng sách</InputLabel>
              <Select
                labelId="add-condition-label"
                label="Tình trạng sách"
                value={addCondition}
                onChange={(e) => setAddCondition(e.target.value as CopyCondition)}
              >
                {CONDITION_CODES.map((code) => (
                  <MenuItem key={code} value={code}>
                    {CONDITION_LABELS[code]}
                  </MenuItem>
                ))}
              </Select>
            </FormControl>
            <FormControl fullWidth>
              <InputLabel id="add-status-label">Trạng thái mượn</InputLabel>
              <Select
                labelId="add-status-label"
                label="Trạng thái mượn"
                value={addStatus}
                onChange={(e) => setAddStatus(e.target.value as CopyStatus)}
              >
                {COPY_STATUS_CODES.map((code) => (
                  <MenuItem key={code} value={code}>
                    {COPY_STATUS_LABELS[code]}
                  </MenuItem>
                ))}
              </Select>
            </FormControl>
            <TextField
              label="Vị trí kệ"
              placeholder="VD: Kệ A1-02"
              value={addShelf}
              onChange={(e) => setAddShelf(e.target.value)}
              fullWidth
            />
          </Stack>
        </DialogContent>
        <DialogActions sx={{ px: 3, py: 2 }}>
          <Button onClick={() => setAddOpen(false)} disabled={addLoading}>
            Hủy
          </Button>
          <Button
            variant="contained"
            onClick={handleCreate}
            disabled={addLoading}
            startIcon={addLoading ? <CircularProgress size={16} /> : null}
          >
            {addLoading ? "Đang thêm..." : "Thêm"}
          </Button>
        </DialogActions>
      </Dialog>

      {/* Edit Copy Dialog */}
      <Dialog
        open={Boolean(editCopy)}
        onClose={() => !editLoading && setEditCopy(null)}
        maxWidth="xs"
        fullWidth
      >
        <DialogTitle sx={{ fontWeight: 700 }}>Cập nhật bản sao</DialogTitle>
        <DialogContent dividers>
          <Stack spacing={2} sx={{ pt: 1 }}>
            <TextField
              label="Mã vạch (Barcode)"
              value={editCopy?.barcode || ""}
              disabled
              fullWidth
            />
            <FormControl fullWidth>
              <InputLabel id="edit-condition-label">Tình trạng sách</InputLabel>
              <Select
                labelId="edit-condition-label"
                label="Tình trạng sách"
                value={editCondition}
                onChange={(e) => setEditCondition(e.target.value as CopyCondition)}
              >
                {CONDITION_CODES.map((code) => (
                  <MenuItem key={code} value={code}>
                    {CONDITION_LABELS[code]}
                  </MenuItem>
                ))}
              </Select>
            </FormControl>
            <FormControl fullWidth>
              <InputLabel id="edit-status-label">Trạng thái mượn</InputLabel>
              <Select
                labelId="edit-status-label"
                label="Trạng thái mượn"
                value={editStatus}
                onChange={(e) => setEditStatus(e.target.value as CopyStatus)}
              >
                {COPY_STATUS_CODES.map((code) => (
                  <MenuItem key={code} value={code}>
                    {COPY_STATUS_LABELS[code]}
                  </MenuItem>
                ))}
              </Select>
            </FormControl>
            <TextField
              label="Vị trí kệ"
              value={editShelf}
              onChange={(e) => setEditShelf(e.target.value)}
              fullWidth
            />
            <TextField
              label="Lý do thay đổi (ghi chú lịch sử)"
              placeholder="VD: Kiểm tra định kỳ, phát hiện rách gáy..."
              value={editNote}
              onChange={(e) => setEditNote(e.target.value)}
              multiline
              rows={2}
              fullWidth
            />
          </Stack>
        </DialogContent>
        <DialogActions sx={{ px: 3, py: 2 }}>
          <Button onClick={() => setEditCopy(null)} disabled={editLoading}>
            Hủy
          </Button>
          <Button
            variant="contained"
            onClick={handleUpdate}
            disabled={editLoading}
            startIcon={editLoading ? <CircularProgress size={16} /> : null}
          >
            {editLoading ? "Đang lưu..." : "Lưu"}
          </Button>
        </DialogActions>
      </Dialog>

      {/* Delete Copy Dialog */}
      <Dialog
        open={Boolean(deleteCopy)}
        onClose={() => !deleteLoading && setDeleteCopy(null)}
        maxWidth="xs"
        fullWidth
      >
        <DialogTitle sx={{ fontWeight: 700 }}>Xác nhận xóa bản sao</DialogTitle>
        <DialogContent>
          <Typography color="text.secondary">
            Bạn có chắc muốn xóa bản sao{" "}
            <strong>{deleteCopy?.barcode}</strong>? Thao tác này không thể hoàn tác.
          </Typography>
        </DialogContent>
        <DialogActions sx={{ px: 3, py: 2 }}>
          <Button onClick={() => setDeleteCopy(null)} disabled={deleteLoading}>
            Hủy
          </Button>
          <Button
            color="error"
            variant="contained"
            onClick={handleDelete}
            disabled={deleteLoading}
            startIcon={deleteLoading ? <CircularProgress size={16} /> : null}
          >
            {deleteLoading ? "Đang xóa..." : "Xóa"}
          </Button>
        </DialogActions>
      </Dialog>
    </DashboardCard>
  );
}
export default BookCopiesTable;
</file>

<file path="src/app/(dashboard)/_components/books/BookImportChoiceDialog.tsx">
"use client";

import React, { useRef } from "react";
import {
  Box,
  Button,
  Card,
  CardContent,
  Chip,
  Dialog,
  DialogActions,
  DialogContent,
  DialogTitle,
  Divider,
  IconButton,
  Stack,
  Typography,
  alpha,
  useTheme,
} from "@mui/material";
import CloseRoundedIcon from "@mui/icons-material/CloseRounded";
import CloudDownloadRoundedIcon from "@mui/icons-material/CloudDownloadRounded";
import FileUploadRoundedIcon from "@mui/icons-material/FileUploadRounded";
import AutoAwesomeRoundedIcon from "@mui/icons-material/AutoAwesomeRounded";
import StorageRoundedIcon from "@mui/icons-material/StorageRounded";
import CheckCircleOutlineRoundedIcon from "@mui/icons-material/CheckCircleOutlineRounded";
import api from "@/lib/api-client";

export interface BookImportChoiceDialogProps {
  open: boolean;
  onClose: () => void;
  onSelectFile: (file: File, mode: "isbn" | "internal") => void;
}

export function BookImportChoiceDialog({
  open,
  onClose,
  onSelectFile,
}: BookImportChoiceDialogProps) {
  const theme = useTheme();
  const isbnInputRef = useRef<HTMLInputElement | null>(null);
  const internalInputRef = useRef<HTMLInputElement | null>(null);

  const handleDownloadTemplate = async (type: "basic" | "full") => {
    try {
      await api.downloadBookTemplate(type);
