<file path="src/app/(dashboard)/_components/dashboard/BookConditionCard.tsx">
"use client";

import { useEffect, useMemo, useState } from "react";
import { Box, Chip, Stack, Typography } from "@mui/material";
import {
  Cell,
  Pie,
  PieChart,
  ResponsiveContainer,
  Tooltip,
} from "recharts";
import DashboardCard from "@/app/(dashboard)/_components/ui/DashboardCard";
import EmptyState from "@/app/(dashboard)/_components/ui/EmptyState";
import LibraryIcon from "@mui/icons-material/MenuBookOutlined";
import api, { getErrorMessage } from "@/lib/api-client";
import type { ConditionDistribution } from "@/lib/types";
import { CONDITION_LABELS } from "@/lib/constants/copy";

const CONDITION_COLORS: Record<string, string> = {
  new: "#10b981",
  good: "#6366f1",
  minor_damage: "#f59e0b",
  major_damage: "#ef4444",
  lost: "#8b5cf6",
  unknown: "#94a3b8",
};

const CONDITION_ORDER = ["new", "good", "minor_damage", "major_damage", "lost", "unknown"];

export default function BookConditionCard() {
  const [data, setData] = useState<ConditionDistribution | null>(null);
  const [error, setError] = useState("");

  useEffect(() => {
    api
      .getConditionDistribution()
      .then(setData)
      .catch((err) => setError(getErrorMessage(err) || "Không tải được thống kê tình trạng sách"));
  }, []);

  const slices = useMemo(() => {
    if (!data) return [];
    return CONDITION_ORDER.filter((key) => (data.conditions[key] || 0) > 0).map((key) => ({
      key,
      label: (CONDITION_LABELS as Record<string, string>)[key] || (key === "unknown" ? "Không rõ" : key),
      value: data.conditions[key],
      color: CONDITION_COLORS[key] || "#94a3b8",
    }));
  }, [data]);

  const total = data?.total_copies ?? 0;

  return (
    <DashboardCard
      title="Tình trạng sách"
      subtitle={total > 0 ? `${total} bản sao` : undefined}
      actions={
        total > 0 ? (
          <Chip size="small" label={`${total} bản sao`} sx={{ fontWeight: 700 }} />
        ) : undefined
      }
    >
      {error ? (
        <Typography variant="body2" color="error.main">{error}</Typography>
      ) : !data || total === 0 ? (
        <EmptyState
          icon={<LibraryIcon sx={{ fontSize: 40, color: "text.disabled" }} />}
          title="Chưa có dữ liệu tình trạng sách"
        />
      ) : (
        <Stack direction={{ xs: "column", sm: "row" }} spacing={2} sx={{ alignItems: "center" }}>
          <Box sx={{ height: 200, width: "100%", maxWidth: 240, minWidth: 0 }}>
            <ResponsiveContainer width="100%" height="100%" minWidth={0} minHeight={160}>
              <PieChart>
                <Tooltip formatter={(value: any) => [`${value} bản`, "Số lượng"]} />
                <Pie data={slices} dataKey="value" nameKey="label" innerRadius={55} outerRadius={85} paddingAngle={2}>
                  {slices.map((s) => (
                    <Cell key={s.key} fill={s.color} />
                  ))}
                </Pie>
              </PieChart>
            </ResponsiveContainer>
          </Box>
          <Stack spacing={1} sx={{ flex: 1, minWidth: 0, width: "100%" }}>
            {slices.map((s) => (
              <Stack key={s.key} direction="row" spacing={1} sx={{ alignItems: "center" }}>
                <Box sx={{ width: 10, height: 10, borderRadius: "50%", bgcolor: s.color, flexShrink: 0 }} />
                <Typography variant="body2" sx={{ flex: 1 }} noWrap>
                  {s.label}
                </Typography>
                <Typography variant="body2" sx={{ fontWeight: 800 }}>
                  {s.value}
                </Typography>
                <Typography variant="caption" color="text.secondary" sx={{ minWidth: 40, textAlign: "right" }}>
                  {Math.round((s.value / total) * 100)}%
                </Typography>
              </Stack>
            ))}
          </Stack>
        </Stack>
      )}
    </DashboardCard>
  );
}
</file>

<file path="src/app/(dashboard)/_components/dashboard/OverdueBooksCard.tsx">
"use client";

import Link from "next/link";
import { useMemo } from "react";
import {
  Box,
  Button,
  Chip,
  Stack,
  Table,
  TableBody,
  TableCell,
  TableContainer,
  TableHead,
  TableRow,
  Typography,
} from "@mui/material";
import ArrowForwardIcon from "@mui/icons-material/ArrowForward";
import WarningAmberIcon from "@mui/icons-material/WarningAmberOutlined";
import DashboardCard from "@/app/(dashboard)/_components/ui/DashboardCard";
import EmptyState from "@/app/(dashboard)/_components/ui/EmptyState";
import type { BorrowRecord } from "@/lib/types";

const DAY_MS = 86400000;

interface OverdueRow {
  id: string;
  title: string;
  barcode: string;
  dueDate: string;
  daysOverdue: number;
}

export default function OverdueBooksCard({ borrows }: { borrows: BorrowRecord[] }) {
  const rows: OverdueRow[] = useMemo(() => {
    const now = Date.now();
    return borrows
      .filter((r) => r.status === "borrowed" && r.due_at && new Date(r.due_at).getTime() < now)
      .map((r) => ({
        id: r.id,
        title: r.book?.title || `Sách #${r.book_id.slice(0, 8)}`,
        barcode: r.copy?.barcode || "—",
        dueDate: new Date(r.due_at).toLocaleDateString("vi-VN"),
        daysOverdue: Math.max(1, Math.ceil((now - new Date(r.due_at).getTime()) / DAY_MS)),
      }))
      .sort((a, b) => b.daysOverdue - a.daysOverdue)
      .slice(0, 8);
  }, [borrows]);

  return (
    <DashboardCard
      title="Sách quá hạn"
      subtitle={rows.length > 0 ? `${rows.length} cuốn cần thu hồi` : undefined}
      actions={
        <Button component={Link} href="/return" endIcon={<ArrowForwardIcon />} size="small">
          Đi đến trang trả sách
        </Button>
      }
      noPadding
    >
      {rows.length === 0 ? (
        <EmptyState
          icon={<WarningAmberIcon sx={{ fontSize: 40, color: "text.disabled" }} />}
          title="Không có sách quá hạn"
          description="Tất cả sách đang mượn đều còn trong hạn"
        />
      ) : (
        <TableContainer sx={{ maxHeight: 320, overflowY: "auto" }}>
          <Table size="small">
            <TableHead>
              <TableRow>
                <TableCell sx={{ fontWeight: 700 }}>Sách</TableCell>
                <TableCell sx={{ fontWeight: 700 }}>Hạn trả</TableCell>
                <TableCell align="right" sx={{ fontWeight: 700 }}>Trễ hạn</TableCell>
              </TableRow>
            </TableHead>
            <TableBody>
              {rows.map((row) => (
                <TableRow key={row.id} hover>
                  <TableCell>
                    <Typography variant="body2" sx={{ fontWeight: 700 }} noWrap title={row.title}>
                      {row.title}
                    </Typography>
                    <Typography variant="caption" color="text.secondary" sx={{ fontFamily: "monospace" }}>
                      {row.barcode}
                    </Typography>
                  </TableCell>
                  <TableCell sx={{ fontFamily: "monospace" }}>{row.dueDate}</TableCell>
                  <TableCell align="right">
                    <Chip size="small" color="error" label={`quá hạn ${row.daysOverdue} ngày`} sx={{ fontWeight: 700 }} />
                  </TableCell>
                </TableRow>
              ))}
            </TableBody>
          </Table>
        </TableContainer>
      )}
    </DashboardCard>
  );
}
</file>

<file path="src/app/(dashboard)/_components/dashboard/TodayScheduleCard.tsx">
"use client";

import Link from "next/link";
import { Box, Button, Chip, Stack, Typography } from "@mui/material";
import ArrowForwardIcon from "@mui/icons-material/ArrowForward";
import CalendarIcon from "@mui/icons-material/CalendarMonthOutlined";
import DashboardCard from "@/app/(dashboard)/_components/ui/DashboardCard";
import EmptyState from "@/app/(dashboard)/_components/ui/EmptyState";
import type { StaffScheduleAssignment } from "@/lib/types";

interface TodayScheduleCardProps {
  assignments: StaffScheduleAssignment[];
  loading: boolean;
}

function formatShiftTime(startTime?: string, endTime?: string) {
  if (!startTime || !endTime) return "";
  return `${startTime.slice(0, 5)} - ${endTime.slice(0, 5)}`;
}

function statusColor(status: string) {
  const map: Record<string, "success" | "warning" | "error" | "info" | "default"> = {
    approved: "success",
    confirmed: "success",
    checked_in: "success",
    pending: "warning",
    pending_confirm: "warning",
    pending_admin_confirm: "warning",
    unchecked: "error",
    absent: "error",
    cancelled: "default",
  };
  return map[status] || "default";
}

function statusLabel(status: string) {
  const map: Record<string, string> = {
    approved: "Đã duyệt",
    confirmed: "Đã xác nhận",
    checked_in: "Đã check-in",
    pending: "Chờ duyệt",
    pending_confirm: "Chờ xác nhận",
    pending_admin_confirm: "Chờ admin",
    unchecked: "Chưa check-in",
    absent: "Vắng mặt",
    cancelled: "Đã hủy",
  };
  return map[status] || status;
}

export default function TodayScheduleCard({ assignments, loading }: TodayScheduleCardProps) {
  return (
    <DashboardCard
      title="Lịch trực hôm nay"
      subtitle={`${assignments.length} ca trực`}
      actions={
        <Button component={Link} href="/staff-schedules" endIcon={<ArrowForwardIcon />} size="small">
          Xem lịch
        </Button>
      }
      noPadding
    >
      {assignments.length === 0 ? (
        <EmptyState
          icon={<CalendarIcon sx={{ fontSize: 40, color: "text.disabled" }} />}
          title="Hôm nay không có ca trực"
        />
      ) : (
        <Stack spacing={1} sx={{ p: 2.5 }}>
          {assignments.slice(0, 6).map((a) => (
            <Stack
              key={a.id}
              direction="row"
              spacing={1.5}
              sx={{
                alignItems: "center",
                justifyContent: "space-between",
                p: 1.5,
                borderRadius: 2,
                border: "1px solid",
                borderColor: "divider",
              }}
            >
              <Stack direction="row" spacing={1.5} sx={{ alignItems: "center", minWidth: 0 }}>
                <Box sx={{ minWidth: 0 }}>
                  <Typography variant="body2" sx={{ fontWeight: 700 }} noWrap>
                    {a.shift?.name || "Ca trực"} · {formatShiftTime(a.shift?.startTime, a.shift?.endTime)}
                  </Typography>
                  <Typography variant="caption" color="text.secondary" noWrap>
                    {a.staff?.fullName || a.staffId} · {a.zone?.zoneName || a.zoneId}
                  </Typography>
                </Box>
              </Stack>
              <Chip size="small" label={statusLabel(a.status)} color={statusColor(a.status)} sx={{ fontWeight: 600, fontSize: "0.72rem" }} />
            </Stack>
          ))}
        </Stack>
      )}
    </DashboardCard>
  );
}
