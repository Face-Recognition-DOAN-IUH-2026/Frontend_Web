<file path="src/app/(dashboard)/_components/ui/NotificationDropdown.tsx">
"use client";

import { useState, useEffect, useRef, useCallback } from "react";
import { useRouter } from "next/navigation";
import { Box, CircularProgress, Paper, Typography } from "@mui/material";
import {
  NotificationsOutlined,
  ErrorOutlined,
  CalendarMonthOutlined,
  BadgeOutlined,
  ShieldOutlined,
  BarChartOutlined,
  PersonOffOutlined,
  MenuBookOutlined,
  LocalFireDepartmentOutlined,
} from "@mui/icons-material";
import api from "@/lib/api-client";
import type { Notification } from "@/lib/types";

const NOTIFICATION_CONFIG: Record<string, { icon: React.ReactNode; color: string; label: string }> = {
  borrow: { icon: <MenuBookOutlined fontSize="small" />, color: "success.main", label: "Mượn sách" },
  return: { icon: <MenuBookOutlined fontSize="small" />, color: "primary.main", label: "Trả sách" },
  book_available: { icon: <MenuBookOutlined fontSize="small" />, color: "success.main", label: "Sách có sẵn" },
  overdue_reminder: { icon: <ErrorOutlined fontSize="small" />, color: "error.main", label: "Quá hạn" },
  due_soon_reminder: { icon: <ErrorOutlined fontSize="small" />, color: "warning.main", label: "Sắp đến hạn" },
  fine_notice: { icon: <ErrorOutlined fontSize="small" />, color: "error.main", label: "Phí phạt" },
  schedule_change: { icon: <CalendarMonthOutlined fontSize="small" />, color: "warning.main", label: "Lịch trực" },
  shift_reminder: { icon: <CalendarMonthOutlined fontSize="small" />, color: "secondary.main", label: "Nhắc lịch" },
  membership_expiry: { icon: <BadgeOutlined fontSize="small" />, color: "error.main", label: "Hạn thẻ" },
  anomaly_alert: { icon: <ShieldOutlined fontSize="small" />, color: "error.main", label: "Bất thường" },
  fire_hazard: { icon: <LocalFireDepartmentOutlined fontSize="small" />, color: "error.main", label: "Cảnh báo cháy" },
  hazard_alert: { icon: <LocalFireDepartmentOutlined fontSize="small" />, color: "error.main", label: "Nguy cơ cháy" },
  smoke_alert: { icon: <ShieldOutlined fontSize="small" />, color: "warning.main", label: "Cảnh báo khói" },
  smoke_hazard: { icon: <ShieldOutlined fontSize="small" />, color: "warning.main", label: "Phát hiện khói" },
  daily_report: { icon: <BarChartOutlined fontSize="small" />, color: "primary.main", label: "Thống kê" },
  staff_absence: { icon: <PersonOffOutlined fontSize="small" />, color: "warning.main", label: "Vắng mặt" },
  bid_warning: { icon: <ErrorOutlined fontSize="small" />, color: "warning.main", label: "Đấu giá" },
  swap_warning: { icon: <ErrorOutlined fontSize="small" />, color: "warning.main", label: "Đổi ca" },
};

function getConfig(type: string) {
  return NOTIFICATION_CONFIG[type] || { icon: <NotificationsOutlined fontSize="small" />, color: "primary.main", label: "Thông báo" };
}

function formatRelativeTime(isoString: string): string {
  const now = new Date();
  const date = new Date(isoString);
  const diffMs = now.getTime() - date.getTime();
  const diffSec = Math.floor(diffMs / 1000);
  const diffMin = Math.floor(diffSec / 60);
  const diffHour = Math.floor(diffMin / 60);
  const diffDay = Math.floor(diffHour / 24);

  if (diffSec < 60) return "Vừa xong";
  if (diffMin < 60) return `${diffMin} phút trước`;
  if (diffHour < 24) return `${diffHour} giờ trước`;
  if (diffDay < 7) return `${diffDay} ngày trước`;
  return date.toLocaleDateString("vi-VN");
}

interface NotificationDropdownProps {
  anchorEl: HTMLElement | null;
  open: boolean;
  onClose: () => void;
}

export default function NotificationDropdown({ anchorEl, open, onClose }: NotificationDropdownProps) {
  const router = useRouter();
  const [notifications, setNotifications] = useState<Notification[]>([]);
  const [loading, setLoading] = useState(false);
  const dropdownRef = useRef<HTMLDivElement>(null);

  const fetchNotifications = useCallback(async () => {
    if (!open) return;
    try {
      setLoading(true);
      const result = await api.getNotifications({ limit: 20 });
      setNotifications(result.items);
    } catch {
      // silently fail
    } finally {
      setLoading(false);
    }
  }, [open]);

  useEffect(() => {
    fetchNotifications();
  }, [fetchNotifications]);

  // Close on click outside
  useEffect(() => {
    if (!open) return;

    const handleClickOutside = (event: MouseEvent) => {
      if (
        dropdownRef.current &&
        !dropdownRef.current.contains(event.target as Node) &&
        anchorEl &&
        !anchorEl.contains(event.target as Node)
      ) {
        onClose();
      }
    };

    document.addEventListener("mousedown", handleClickOutside);
    return () => document.removeEventListener("mousedown", handleClickOutside);
  }, [open, onClose, anchorEl]);

  // Close on Escape
  useEffect(() => {
    if (!open) return;

    const handleEscape = (event: KeyboardEvent) => {
      if (event.key === "Escape") {
        onClose();
      }
    };

    document.addEventListener("keydown", handleEscape);
    return () => document.removeEventListener("keydown", handleEscape);
  }, [open, onClose]);

  const handleMarkAllRead = async () => {
    try {
      await api.markAllNotificationsAsRead();
      setNotifications((prev) => prev.map((n) => ({ ...n, isRead: true })));
    } catch {
      // silently fail
    }
  };

  const handleNotificationClick = async (notification: Notification) => {
    if (!notification.isRead) {
      try {
        await api.markNotificationAsRead(notification.id);
        setNotifications((prev) =>
          prev.map((n) => (n.id === notification.id ? { ...n, isRead: true } : n))
        );
      } catch {
        // silently fail
      }
    }
    onClose();
    router.push("/notifications");
  };

  if (!open) return null;

  return (
    <Paper
      ref={dropdownRef}
      elevation={8}
      onClick={(e) => e.stopPropagation()}
      sx={{
        position: "absolute",
        top: "100%",
        right: 0,
        mt: 1,
        width: 380,
        maxHeight: 480,
        borderRadius: 2,
        overflow: "hidden",
        zIndex: 1300,
        border: "1px solid",
        borderColor: "divider",
      }}
    >
      <Box sx={{ p: 2, borderBottom: "1px solid", borderColor: "divider", display: "flex", justifyContent: "space-between", alignItems: "center" }}>
        <Typography variant="subtitle1" sx={{ fontWeight: 700 }}>
          Thông báo
        </Typography>
        <Typography
          variant="caption"
          sx={{ color: "primary.main", cursor: "pointer", fontWeight: 600, "&:hover": { textDecoration: "underline" } }}
          onClick={handleMarkAllRead}
        >
          Đánh dấu đã đọc tất cả
        </Typography>
      </Box>

      <Box sx={{ maxHeight: 400, overflow: "auto" }}>
        {loading ? (
          <Box sx={{ p: 4, display: "flex", justifyContent: "center" }}>
            <CircularProgress size={24} />
          </Box>
        ) : notifications.length === 0 ? (
          <Box sx={{ p: 4, textAlign: "center" }}>
            <NotificationsOutlined sx={{ fontSize: 40, color: "text.secondary", mb: 1 }} />
            <Typography variant="body2" color="text.secondary">
              Không có thông báo
            </Typography>
          </Box>
        ) : (
          notifications.map((notification) => {
            const config = getConfig(notification.type);
            return (
              <Box
                key={notification.id}
                onClick={() => handleNotificationClick(notification)}
                sx={{
                  p: 2,
                  display: "flex",
                  gap: 1.5,
                  cursor: "pointer",
                  borderBottom: "1px solid",
                  borderColor: "divider",
                  bgcolor: notification.isRead ? "transparent" : "action.hover",
                  "&:hover": { bgcolor: "action.selected" },
                }}
              >
                <Box sx={{ color: config.color, mt: 0.5 }}>{config.icon}</Box>
                <Box sx={{ flex: 1, minWidth: 0 }}>
                  <Typography variant="body2" sx={{ fontWeight: notification.isRead ? 400 : 700 }} noWrap>
                    {notification.title}
                  </Typography>
                  <Typography variant="caption" color="text.secondary" sx={{ display: "block", whiteSpace: "pre-wrap", wordBreak: "break-word" }}>
                    {notification.body}
                  </Typography>
                  <Typography variant="caption" color="text.disabled" sx={{ mt: 0.5, display: "block" }}>
                    {formatRelativeTime(notification.createdAt)}
                  </Typography>
                </Box>
                {!notification.isRead && (
                  <Box sx={{ width: 8, height: 8, borderRadius: "50%", bgcolor: "error.main", mt: 1, flexShrink: 0 }} />
                )}
              </Box>
            );
          })
        )}
      </Box>
    </Paper>
  );
}
</file>

<file path="src/app/(dashboard)/_components/IsbnScannerDialog.tsx">
"use client";

import { useCallback, useEffect, useRef, useState } from "react";
import {
  Alert,
  Avatar,
  Box,
  Button,
  Chip,
  CircularProgress,
  Dialog,
  DialogActions,
  DialogContent,
  DialogTitle,
  IconButton,
  InputAdornment,
  Paper,
  Stack,
  TextField,
  Typography,
  useMediaQuery,
  useTheme,
} from "@mui/material";
import { useToast } from "@/lib/toast-context";
import BookIcon from "@mui/icons-material/MenuBookOutlined";
import CameraAltIcon from "@mui/icons-material/CameraAltOutlined";
import CheckCircleIcon from "@mui/icons-material/CheckCircleOutlineOutlined";
import CloseIcon from "@mui/icons-material/Close";
import DeleteIcon from "@mui/icons-material/DeleteOutlined";
import QrCodeScannerIcon from "@mui/icons-material/QrCodeScannerOutlined";
import api, { getErrorMessage } from "@/lib/api-client";
import type { BookImportResultRow, BookWithStats } from "@/lib/types";

interface ScannedItem {
  isbn: string;
  quantity: number;
  lookup: BookWithStats | null;
  loading: boolean;
}

export default function IsbnScannerDialog({
  open,
  onClose,
  onImportComplete,
}: {
  open: boolean;
  onClose: () => void;
  onImportComplete: (results: BookImportResultRow[]) => void;
}) {
  const { toast } = useToast();
  const videoRef = useRef<HTMLVideoElement>(null);
  const streamRef = useRef<MediaStream | null>(null);
  const readerRef = useRef<any>(null);
  const lastScannedRef = useRef<string | null>(null);
  const [cameraReady, setCameraReady] = useState(false);
  const [cameraError, setCameraError] = useState("");
  const [scanned, setScanned] = useState<ScannedItem[]>([]);
  const [importing, setImporting] = useState(false);
  const [importError, setImportError] = useState("");
  const [manualInput, setManualInput] = useState("");

  const stopCamera = useCallback(() => {
    if (readerRef.current) {
      try { readerRef.current.reset(); } catch {}
      readerRef.current = null;
    }
    if (streamRef.current) {
      streamRef.current.getTracks().forEach((track) => track.stop());
      streamRef.current = null;
    }
    if (videoRef.current) videoRef.current.srcObject = null;
    setCameraReady(false);
  }, []);

  const lookupIsbn = useCallback(async (isbn: string) => {
    setScanned((prev) => prev.map((item) =>
      item.isbn === isbn ? { ...item, loading: true } : item
    ));
    try {
      const book = await api.lookupBookByIsbn(isbn);
      setScanned((prev) => prev.map((item) =>
        item.isbn === isbn ? { ...item, lookup: book, loading: false } : item
      ));
    } catch (err) {
      setScanned((prev) => prev.filter((item) => item.isbn !== isbn));
      toast.error(`Không tìm thấy ISBN: ${isbn}`);
    }
  }, [toast]);

  const cleanIsbn = (raw: string) => {
    const trimmed = raw.trim();
    const libMatch = trimmed.match(/^LIB[-]?(\d{10,13})[-]?(\d+)?$/i);
    if (libMatch) return libMatch[1];
    return trimmed.replace(/[-\s]/g, "");
  };

  const addScanned = useCallback((rawCode: string) => {
    const normalized = cleanIsbn(rawCode);
    if (!/^\d{10,13}$/.test(normalized)) return;
    lastScannedRef.current = normalized;
    toast.success(`Đã quét ISBN: ${normalized}`);
    setScanned((prev) => {
      if (prev.some((item) => item.isbn === normalized)) {
        return prev.map((item) =>
          item.isbn === normalized ? { ...item, quantity: item.quantity + 1 } : item
        );
      }
      return [...prev, { isbn: normalized, quantity: 1, lookup: null, loading: true }];
    });
    lookupIsbn(normalized);
  }, [lookupIsbn, toast]);

  useEffect(() => {
    if (!open) {
      stopCamera();
      setScanned([]);
      setCameraError("");
      setImportError("");
      setManualInput("");
      lastScannedRef.current = null;
      return;
    }
    let active = true;
    (async () => {
      try {
        setCameraError("");
        const { BrowserMultiFormatReader } = await import("@zxing/browser");
        if (!active) return;
        const stream = await navigator.mediaDevices.getUserMedia({
          video: { facingMode: "environment", width: { ideal: 640 }, height: { ideal: 480 } },
          audio: false,
        });
        if (!active) { stream.getTracks().forEach((t) => t.stop()); return; }
        streamRef.current = stream;
        if (videoRef.current) {
          videoRef.current.srcObject = stream;
          videoRef.current.onloadedmetadata = () => { setCameraReady(true); };
        }
      } catch (err: any) {
        if (!active) return;
        if (err.name === "NotAllowedError") setCameraError("Không có quyền truy cập camera. Hãy cấp quyền camera cho trình duyệt.");
        else if (err.name === "NotFoundError") setCameraError("Không tìm thấy camera trên thiết bị.");
        else setCameraError("Không thể khởi động camera.");
      }
    })();
    return () => { active = false; };
  }, [open, stopCamera]);

  useEffect(() => {
    if (!cameraReady || !videoRef.current || !open) return;
    let active = true;
    (async () => {
      try {
        const { BrowserMultiFormatReader } = await import("@zxing/browser");
        const { BarcodeFormat, DecodeHintType } = await import("@zxing/library");
        if (!active) return;
        const hints = new Map();
        hints.set(DecodeHintType.POSSIBLE_FORMATS, [
          BarcodeFormat.CODE_128,
          BarcodeFormat.EAN_13,
          BarcodeFormat.CODE_39,
          BarcodeFormat.EAN_8,
          BarcodeFormat.UPC_A,
          BarcodeFormat.UPC_E,
          BarcodeFormat.QR_CODE,
        ]);
        hints.set(DecodeHintType.TRY_HARDER, true);
        const reader = new BrowserMultiFormatReader(hints, {
          delayBetweenScanAttempts: 150,
          delayBetweenScanSuccess: 1000,
        });
        readerRef.current = reader;
        reader.decodeFromVideoElement(videoRef.current!, (result, err) => {
          if (!active) return;
          if (result) {
            const code = result.getText();
            if (code) {
              addScanned(code);
            }
          }
        });
      } catch {}
    })();
    return () => { active = false; };
  }, [cameraReady, open, addScanned]);

  useEffect(() => () => stopCamera(), [stopCamera]);

  const removeItem = (isbn: string) => {
    setScanned((prev) => prev.filter((item) => item.isbn !== isbn));
  };

  const updateQuantity = (isbn: string, value: number) => {
    setScanned((prev) => prev.map((item) =>
      item.isbn === isbn ? { ...item, quantity: Math.max(1, value || 1) } : item
    ));
  };

  const handleImport = async () => {
    const valid = scanned.filter((item) => item.lookup);
    if (!valid.length) return;
    setImporting(true);
    setImportError("");
    try {
      const result = await api.batchImportByIsbn(valid.map((item) => ({ isbn: item.isbn, quantity: item.quantity })));
      onImportComplete(result.results);
      stopCamera();
      setScanned([]);
    } catch (err) {
      const msg = getErrorMessage(err);
      setImportError(msg);
      toast.error(msg);
    } finally {
      setImporting(false);
    }
  };

  const theme = useTheme();
  const isMobile = useMediaQuery(theme.breakpoints.down("sm"));

  const validCount = scanned.filter((item) => item.lookup).length;
  const isNew = (item: ScannedItem) => item.lookup && item.lookup.total_copies === 0;

  return (
    <>
      <Dialog open={open} onClose={importing ? undefined : onClose} fullWidth maxWidth="xl" fullScreen={isMobile}>
        <DialogTitle>
          <Stack direction="row" spacing={1} sx={{ alignItems: "center", justifyContent: "space-between" }}>
            <Stack direction="row" spacing={1} sx={{ alignItems: "center" }}>
              <QrCodeScannerIcon color="primary" />
              <Typography variant="h6" sx={{ fontWeight: 900 }}>Quét mã ISBN</Typography>
            </Stack>
            {!importing && (
              <IconButton size="small" onClick={onClose}><CloseIcon /></IconButton>
            )}
          </Stack>
        </DialogTitle>
        <DialogContent dividers sx={{ p: 2, display: "flex", flexDirection: "column", overflow: "hidden" }}>
          <Box sx={{ display: "flex", gap: 2, flexDirection: { xs: "column", md: "row" }, flex: 1, overflow: "hidden" }}>
            <Paper
              variant="outlined"
              sx={{
                position: "relative",
                overflow: "hidden",
                bgcolor: "black",
                width: { md: "50%" },
                aspectRatio: { xs: "16/9", md: "4/3" },
                display: "flex",
                alignItems: "center",
                justifyContent: "center",
                flexShrink: 0,
              }}
            >
              {cameraError ? (
                <Stack spacing={1} sx={{ alignItems: "center", color: "grey.300", p: 3 }}>
                  <CameraAltIcon sx={{ fontSize: 42 }} />
                  <Typography>{cameraError}</Typography>
                </Stack>
              ) : (
                <>
                  <Box
                    component="video"
                    ref={videoRef}
                    autoPlay
                    playsInline
                    muted
                    sx={{ width: "100%", height: "100%", objectFit: "contain" }}
                  />
                  {!cameraReady && (
                    <Stack sx={{ position: "absolute", inset: 0, bgcolor: "rgba(0,0,0,.55)", color: "common.white", alignItems: "center", justifyContent: "center" }} spacing={1}>
                      <CircularProgress size={26} color="inherit" />
                      <Typography variant="body2">Đang kết nối camera...</Typography>
                    </Stack>
                  )}
                </>
              )}
            </Paper>

            <Stack spacing={1.5} sx={{ flex: 1, overflow: "auto" }}>
              <Stack direction="row" spacing={1} sx={{ alignItems: "center" }}>
                <QrCodeScannerIcon color="primary" sx={{ fontSize: 20 }} />
                <Typography variant="subtitle2" sx={{ fontWeight: 900 }}>
                  {scanned.length > 0 ? `Đã quét (${scanned.length} cuốn)` : "Sách đã quét"}
                </Typography>
              </Stack>

              {importError ? <Alert severity="error" onClose={() => setImportError("")}>{importError}</Alert> : null}

              <TextField
                size="small"
                placeholder="Quét hoặc nhập mã sách (ISBN hoặc LIB-9780140328721-001)..."
                value={manualInput}
                onChange={(e) => setManualInput(e.target.value)}
                onKeyDown={(e) => {
                  if (e.key === "Enter" && manualInput.trim()) {
                    e.preventDefault();
                    addScanned(manualInput.trim());
                    setManualInput("");
                  }
                }}
                slotProps={{
                  input: {
                    startAdornment: (
                      <InputAdornment position="start">
                        <QrCodeScannerIcon fontSize="small" sx={{ color: "text.secondary" }} />
                      </InputAdornment>
                    ),
                  },
                }}
                fullWidth
              />

              {scanned.length === 0 ? (
                <Alert severity="info" sx={{ flex: 1, display: "flex", alignItems: "center" }}>
                  Đưa mã vạch ISBN hoặc mã bản sao LIB-... vào camera, hoặc nhập mã ở trên.
                </Alert>
              ) : (
                scanned.map((item) => {
                  const isLastScanned = item.isbn === lastScannedRef.current;
                  return (
                    <Paper
                      key={item.isbn}
                      variant="outlined"
                      sx={{
                        p: 1.5,
                        borderColor: isLastScanned ? "primary.main" : undefined,
                        bgcolor: isLastScanned ? "action.hover" : undefined,
                      }}
                    >
                      <Stack direction="row" spacing={1.5} sx={{ alignItems: "flex-start" }}>
                        {item.lookup?.cover_url ? (
                          <Box
                            component="img"
                            src={item.lookup.cover_url}
                            alt={item.lookup.title}
                            sx={{ width: 40, height: 56, objectFit: "cover", borderRadius: 0.5, flexShrink: 0 }}
                          />
                        ) : (
                          <Avatar variant="rounded" sx={{ width: 40, height: 56, bgcolor: "background.default", flexShrink: 0 }}>
                            <BookIcon />
                          </Avatar>
                        )}
                        <Stack spacing={0.3} sx={{ flex: 1, minWidth: 0 }}>
                          <Stack direction="row" spacing={0.5} sx={{ alignItems: "center" }}>
                            {item.loading ? (
                              <Typography variant="body2" color="text.secondary">Đang tra cứu...</Typography>
                            ) : item.lookup ? (
                              <>
                                <Typography variant="body2" sx={{ fontWeight: 900, flex: 1 }} noWrap>
                                  {item.lookup.title}
                                </Typography>
                                {isNew(item) && <Chip size="small" color="success" label="Mới" sx={{ height: 20 }} />}
                              </>
                            ) : null}
                          </Stack>
                          {item.lookup && (
                            <Typography variant="caption" color="text.secondary" noWrap>
                              {item.lookup.author || "-"}
                            </Typography>
                          )}
                          <Typography variant="caption" sx={{ fontFamily: "monospace", color: "primary.main" }}>
                            {item.isbn}
                          </Typography>
                          {item.lookup && !item.loading && (
                            <Stack direction="row" spacing={1} sx={{ alignItems: "center", flexWrap: "wrap" }}>
                              {isNew(item) ? (
                                <Chip size="small" variant="outlined" label="Sách mới - chưa có trong kho" sx={{ height: 20, fontSize: 11 }} />
                              ) : (
                                <Stack direction="row" spacing={0.5} sx={{ alignItems: "center", flexWrap: "wrap" }}>
                                  <Chip size="small" variant="outlined" label={`Kho: ${item.lookup.total_copies}`} sx={{ height: 20, fontSize: 11 }} />
                                  <Chip size="small" variant="outlined" color="success" label={`Sẵn: ${item.lookup.available_copies}`} sx={{ height: 20, fontSize: 11 }} />
                                </Stack>
                              )}
                            </Stack>
                          )}
                          {item.lookup && !item.loading && (
                            <Stack direction="row" spacing={1} sx={{ alignItems: "center", mt: 0.5 }}>
                              <TextField
                                type="number"
                                size="small"
                                label="SL thêm"
                                value={item.quantity}
                                onChange={(e) => updateQuantity(item.isbn, parseInt(e.target.value) || 1)}
                                slotProps={{ htmlInput: { min: 1, style: { textAlign: "center", width: 40 } } }}
                                sx={{ width: 100 }}
                              />
                              {!isNew(item) && (
                                <Typography variant="caption" color="text.secondary">
                                  → Tổng: {item.lookup.total_copies + item.quantity}
                                </Typography>
                              )}
                            </Stack>
                          )}
                        </Stack>
                        <IconButton size="small" color="error" onClick={() => removeItem(item.isbn)} sx={{ mt: 0.5 }}>
                          <DeleteIcon fontSize="small" />
                        </IconButton>
                      </Stack>
                    </Paper>
                  );
                })
              )}

            </Stack>
          </Box>
        </DialogContent>
        <DialogActions>
          <Button onClick={onClose} disabled={importing}>Đóng</Button>
          <Button
            variant="contained"
            disabled={importing || validCount === 0}
            onClick={handleImport}
          >
            {importing ? "Đang nhập vào kho..." : `Nhập vào kho (${validCount} cuốn)`}
          </Button>
        </DialogActions>
      </Dialog>
    </>
  );
}
</file>

<file path="src/app/(dashboard)/_components/ProfileDialog.tsx">
"use client";

import { useState, useEffect, useRef } from "react";
import { getErrorMessage } from "@/lib/api-client";
import {
  Avatar,
  Box,
  Button,
  Dialog,
  DialogContent,
  Divider,
  IconButton,
  List,
  ListItem,
  ListItemButton,
  ListItemIcon,
  ListItemText,
  Stack,
  Typography,
  CircularProgress,
  Alert,
} from "@mui/material";
import PhotoCameraIcon from "@mui/icons-material/PhotoCamera";
import DeleteIcon from "@mui/icons-material/Delete";
import LockResetIcon from "@mui/icons-material/LockReset";
import FaceIcon from "@mui/icons-material/FaceRetouchingNaturalOutlined";
import LogoutIcon from "@mui/icons-material/LogoutOutlined";
import { useAuth } from "@/lib/auth-context";
import api from "@/lib/api-client";
import AvatarUser from "@/app/(dashboard)/_components/ui/AvatarUser";

interface ProfileDialogProps {
  open: boolean;
  onClose: () => void;
}

export default function ProfileDialog({ open, onClose }: ProfileDialogProps) {
  const { user, logout, updateUser } = useAuth();
  const [avatarUrl, setAvatarUrl] = useState<string | null>(null);
  const [uploading, setUploading] = useState(false);
  const [error, setError] = useState<string | null>(null);
  const [success, setSuccess] = useState(false);
  const fileInputRef = useRef<HTMLInputElement>(null);

  useEffect(() => {
    if (open && user) {
      const fetchUser = async () => {
        try {
          const userData = await api.getCurrentUser();
          setAvatarUrl(userData.avatar_url ?? null);
          if (userData.avatar_url !== user.avatar_url) {
            updateUser({ avatar_url: userData.avatar_url ?? null });
          }
        } catch (err) {
          console.error("Failed to fetch user data", err);
        }
      };
      fetchUser();
    }
  }, [open, user, updateUser]);

  const handleFileChange = async (event: React.ChangeEvent<HTMLInputElement>) => {
    const file = event.target.files?.[0];
    if (!file) return;

    setUploading(true);
    setError(null);
    setSuccess(false);

    try {
      const result = await api.uploadAvatar(file);
      setAvatarUrl(result.avatarUrl);
      updateUser({ avatar_url: result.avatarUrl });
      setSuccess(true);
    } catch (err: any) {
      setError(getErrorMessage(err) || "Tải ảnh thất bại");
    } finally {
      setUploading(false);
    }
  };

  const handleDeleteAvatar = async () => {
    setUploading(true);
    setError(null);
    try {
      await api.deleteAvatar();
      setAvatarUrl(null);
      updateUser({ avatar_url: null });
      setSuccess(true);
    } catch (err: any) {
      setError(getErrorMessage(err) || "Xóa ảnh thất bại");
    } finally {
      setUploading(false);
    }
  };

  const handleLogout = () => {
    onClose();
    logout();
  };

  if (!user) return null;

  return (
    <Dialog
      open={open}
      onClose={onClose}
      maxWidth="xs"
      fullWidth
      slotProps={{
        paper: { sx: { borderRadius: 3, overflow: "visible" } },
        backdrop: { sx: { backgroundColor: "rgba(0,0,0,0.4)" } },
      }}
    >
      <DialogContent sx={{ p: 0 }}>
        <Box
          sx={{
            position: "relative",
            display: "flex",
            flexDirection: "column",
            alignItems: "center",
            gap: 2,
            pt: 4,
            pb: 3,
            px: 3,
          }}
        >
          <Box sx={{ position: "relative" }}>
            <AvatarUser
              avatarUrl={avatarUrl || user?.avatar_url}
              name={user?.full_name}
              email={user?.email}
              role={user?.role}
              size={88}
              border="3px solid rgba(255,255,255,0.85)"
              sx={{
                fontSize: "2.2rem",
                transition: "transform 0.2s ease, box-shadow 0.2s ease",
                "&:hover": {
                  transform: "scale(1.03)",
                  boxShadow: "0 4px 16px rgba(0,0,0,0.2)",
                },
              }}
            />
            <IconButton
              component="label"
              size="small"
              sx={{
                position: "absolute",
                bottom: 0,
                right: 0,
                bgcolor: "primary.main",
                color: "white",
                "&:hover": { bgcolor: "primary.dark" },
                boxShadow: 2,
                width: 30,
                height: 30,
              }}
            >
              <input
                ref={fileInputRef}
                type="file"
                hidden
                accept="image/*"
                onChange={handleFileChange}
              />
              <PhotoCameraIcon sx={{ fontSize: 16 }} />
            </IconButton>
          </Box>

          <Box sx={{ textAlign: "center" }}>
            <Typography variant="h6" sx={{ fontWeight: 800 }}>
              {user.full_name || "Người dùng"}
            </Typography>
            <Typography variant="body2" color="text.secondary">
              {user.email}
            </Typography>
            <Box
              component="span"
              sx={{
                display: "inline-block",
                mt: 0.75,
                px: 1.5,
                py: 0.25,
                borderRadius: 99,
                bgcolor: "primaryContainer",
                color: "primary.main",
                fontSize: "0.7rem",
                fontWeight: 800,
                textTransform: "uppercase",
                letterSpacing: 0.5,
              }}
            >
              {user.role === "admin" ? "Quản trị viên" : user.role === "staff" ? "Nhân viên" : "Độc giả"}
            </Box>
          </Box>

          {uploading && (
            <Box sx={{ display: "flex", flexDirection: "row", gap: 1, alignItems: "center" }}>
              <CircularProgress size={14} />
              <Typography variant="caption">Đang xử lý...</Typography>
            </Box>
          )}

          {error && (
            <Alert severity="error" sx={{ width: "100%", py: 0 }}>
              {error}
            </Alert>
          )}

          {success && (
            <Alert severity="success" sx={{ width: "100%", py: 0 }}>
              Cập nhật thành công!
            </Alert>
          )}

          {avatarUrl && !uploading && (
            <Button
              size="small"
              color="error"
              startIcon={<DeleteIcon />}
              onClick={handleDeleteAvatar}
              sx={{ mt: -1 }}
            >
              Xóa ảnh
            </Button>
          )}

          <Divider sx={{ width: "100%", my: 1 }} />

          <List sx={{ width: "100%", py: 0 }}>
            <ListItemButton
              onClick={onClose}
              sx={{
                borderRadius: 2,
                "&:hover": { bgcolor: "action.hover" },
              }}
            >
              <ListItemIcon sx={{ minWidth: 40 }}>
                <FaceIcon color="primary" />
              </ListItemIcon>
              <ListItemText
                primary="Cập nhật khuôn mặt"
                slotProps={{ primary: { sx: { fontWeight: 600, fontSize: "0.9rem" } } }}
              />
            </ListItemButton>

            <ListItemButton
              onClick={onClose}
              sx={{
                borderRadius: 2,
                "&:hover": { bgcolor: "action.hover" },
              }}
            >
              <ListItemIcon sx={{ minWidth: 40 }}>
                <LockResetIcon color="primary" />
              </ListItemIcon>
              <ListItemText
                primary="Đổi mật khẩu"
                slotProps={{ primary: { sx: { fontWeight: 600, fontSize: "0.9rem" } } }}
              />
            </ListItemButton>

            <ListItemButton
              onClick={handleLogout}
              sx={{
                borderRadius: 2,
                "&:hover": { bgcolor: "action.hover" },
              }}
            >
              <ListItemIcon sx={{ minWidth: 40 }}>
                <LogoutIcon color="error" />
              </ListItemIcon>
              <ListItemText
                primary="Đăng xuất"
                slotProps={{ primary: { sx: { fontWeight: 600, fontSize: "0.9rem", color: "error.main" } } }}
              />
            </ListItemButton>
          </List>
        </Box>
      </DialogContent>
    </Dialog>
  );
}
