import React from "react";
import { render, screen, waitFor, fireEvent, act } from "@testing-library/react";
import userEvent from "@testing-library/user-event";
import { bus } from "@/lib/event-bus";

// Mock api-client — default export is what `import api from` resolves to
jest.mock("@/lib/api-client", () => ({
  __esModule: true,
  default: {
    login: jest.fn(),
    client: {
      interceptors: {
        request: { use: jest.fn(), eject: jest.fn() },
        response: { use: jest.fn(), eject: jest.fn() },
      },
    },
  },
  api: {
    login: jest.fn(),
    client: {
      interceptors: {
        request: { use: jest.fn(), eject: jest.fn() },
        response: { use: jest.fn(), eject: jest.fn() },
      },
    },
  },
  retryPendingRequests: jest.fn(),
  cancelPendingRequests: jest.fn(),
  getErrorMessage: jest.fn((err: any) => err?.message || "Unknown error"),
}));

// Mock auth-context
jest.mock("@/lib/auth-context", () => ({
  useAuth: () => ({
    user: { id: "1", email: "admin@test.com", role: "admin" },
    isAuthenticated: false,
    isLoading: false,
    login: jest.fn(),
    setAuthFromToken: jest.fn(),
    logout: jest.fn(),
    refreshAccessToken: jest.fn(),
    accessToken: "old-token",
  }),
  AuthProvider: ({ children }: { children: React.ReactNode }) => <>{children}</>,
}));

import ReauthOverlay from "@/components/ReauthOverlay";

function emitAuthRequired() {
  act(() => { bus.emit("auth:required"); });
}

describe("ReauthOverlay", () => {
  beforeEach(() => {
    bus["listeners"] = {};
    jest.clearAllMocks();
  });

  it("should not render when auth:required has not been emitted", () => {
    render(<ReauthOverlay />);
    expect(screen.queryByRole("dialog")).not.toBeInTheDocument();
  });

  it("should render when auth:required event is emitted", async () => {
    render(<ReauthOverlay />);
    emitAuthRequired();
    await waitFor(() => {
      expect(screen.getByRole("dialog")).toBeInTheDocument();
    });
  });

  it("should show the user email in the overlay", async () => {
    render(<ReauthOverlay />);
    emitAuthRequired();
    await waitFor(() => {
      expect(screen.getByDisplayValue("admin@test.com")).toBeInTheDocument();
    });
  });

  it("should call retryPendingRequests on successful re-login", async () => {
    // default export's login is what `import api from` uses
    const mockDefault = require("@/lib/api-client").default;
    mockDefault.login.mockResolvedValue({
      access_token: "new-token",
      refresh_token: "new-refresh",
    });

    const mockRetry = require("@/lib/api-client").retryPendingRequests;

    render(<ReauthOverlay />);
    emitAuthRequired();

    await waitFor(() => {
      expect(screen.getByRole("dialog")).toBeInTheDocument();
    });

    const passwordInput = screen.getByLabelText(/mật khẩu/i);
    await userEvent.type(passwordInput, "newpass123");

    const loginButton = screen.getByRole("button", { name: /đăng nhập/i });
    await userEvent.click(loginButton);

    await waitFor(() => {
      expect(mockRetry).toHaveBeenCalledWith("new-token");
    });
  });

  it("should call cancelPendingRequests on dismiss", async () => {
    const mockCancel = require("@/lib/api-client").cancelPendingRequests;

    render(<ReauthOverlay />);
    emitAuthRequired();

    await waitFor(() => {
      expect(screen.getByRole("dialog")).toBeInTheDocument();
    });

    act(() => { bus.emit("auth:cancelled"); });

    await waitFor(() => {
      expect(mockCancel).toHaveBeenCalled();
    });
  });

  it("should show error on failed re-login", async () => {
    const mockDefault = require("@/lib/api-client").default;
    mockDefault.login.mockRejectedValue({
      response: { data: { detail: "Sai mật khẩu" } },
    });

    render(<ReauthOverlay />);
    emitAuthRequired();

    await waitFor(() => {
      expect(screen.getByRole("dialog")).toBeInTheDocument();
    });

    const passwordInput = screen.getByLabelText(/mật khẩu/i);
    await userEvent.type(passwordInput, "wrongpass");

    const loginButton = screen.getByRole("button", { name: /đăng nhập/i });
    await userEvent.click(loginButton);

    await waitFor(() => {
      expect(screen.getByText(/sai mật khẩu/i)).toBeInTheDocument();
    });
  });
});
