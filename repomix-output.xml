          alignItems: { xs: "stretch", sm: "center" },
          justifyContent: "space-between",
        }}
      >
        <Box sx={{ flex: 1, minWidth: { xs: "100%", sm: 280, md: 360 } }}>
          <SearchField
            value={query}
