"use client";

import { useState, useEffect, useRef } from "react";
import {
  Avatar,
  Box,
  Button,
  Dialog,
  DialogContent,
  Divider,
  IconButton,
  List,
  ListItem,
  ListItemButton,
  ListItemIcon,
  ListItemText,
  Stack,
  Typography,
  CircularProgress,
  Alert,
} from "@mui/material";
import PhotoCameraIcon from "@mui/icons-material/PhotoCamera";
import DeleteIcon from "@mui/icons-material/Delete";
import LockResetIcon from "@mui/icons-material/LockReset";
import FaceIcon from "@mui/icons-material/FaceRetouchingNaturalOutlined";
import LogoutIcon from "@mui/icons-material/LogoutOutlined";
import { useAuth } from "@/lib/auth-context";
import api from "@/lib/api-client";

interface ProfileDialogProps {
  open: boolean;
  onClose: () => void;
}

export default function ProfileDialog({ open, onClose }: ProfileDialogProps) {
  const { user, logout } = useAuth();
  const [avatarUrl, setAvatarUrl] = useState<string | null>(null);
  const [uploading, setUploading] = useState(false);
  const [error, setError] = useState<string | null>(null);
  const [success, setSuccess] = useState(false);
  const fileInputRef = useRef<HTMLInputElement>(null);

  useEffect(() => {
    if (open && user) {
      const fetchUser = async () => {
        try {
          const userData = await api.getCurrentUser();
          setAvatarUrl(userData.avatar_url ?? null);
        } catch (err) {
          console.error("Failed to fetch user data", err);
        }
      };
      fetchUser();
    }
  }, [open, user]);

  const handleFileChange = async (event: React.ChangeEvent<HTMLInputElement>) => {
    const file = event.target.files?.[0];
    if (!file) return;

    setUploading(true);
    setError(null);
    setSuccess(false);

    try {
      const result = await api.uploadAvatar(file);
      setAvatarUrl(result.avatarUrl);
      setSuccess(true);
    } catch (err: any) {
      setError(err.message || "Upload failed");
    } finally {
      setUploading(false);
    }
  };

  const handleDeleteAvatar = async () => {
    setUploading(true);
    setError(null);
    try {
      await api.deleteAvatar();
      setAvatarUrl(null);
      setSuccess(true);
    } catch (err: any) {
      setError(err.message || "Delete failed");
    } finally {
      setUploading(false);
    }
  };

  const handleLogout = () => {
    onClose();
    logout();
  };

  if (!user) return null;

  return (
    <Dialog
      open={open}
      onClose={onClose}
      maxWidth="xs"
      fullWidth
      slotProps={{
        paper: { sx: { borderRadius: 3, overflow: "visible" } },
        backdrop: { sx: { backgroundColor: "rgba(0,0,0,0.4)" } },
      }}
    >
      <DialogContent sx={{ p: 0 }}>
        <Box
          sx={{
            position: "relative",
            display: "flex",
            flexDirection: "column",
            alignItems: "center",
            gap: 2,
            pt: 4,
            pb: 3,
            px: 3,
          }}
        >
          <Box sx={{ position: "relative" }}>
            <Avatar
              src={avatarUrl || undefined}
              sx={{
                width: 88,
                height: 88,
                fontSize: "2.5rem",
                fontWeight: 900,
                bgcolor: "primary.main",
                color: "primary.contrastText",
                transition: "transform 0.2s ease, box-shadow 0.2s ease",
                "&:hover": {
                  transform: "scale(1.03)",
                  boxShadow: `0 0 0 3px ${"primary.main"}40`,
                },
              }}
            >
              {(user.full_name || user.email || "U").charAt(0).toUpperCase()}
            </Avatar>
            <IconButton
              component="label"
              size="small"
              sx={{
                position: "absolute",
                bottom: 0,
                right: 0,
                bgcolor: "primary.main",
                color: "white",
                "&:hover": { bgcolor: "primary.dark" },
                boxShadow: 2,
                width: 30,
                height: 30,
              }}
            >
              <input
                ref={fileInputRef}
                type="file"
                hidden
                accept="image/*"
                onChange={handleFileChange}
              />
              <PhotoCameraIcon sx={{ fontSize: 16 }} />
            </IconButton>
          </Box>

          <Box sx={{ textAlign: "center" }}>
            <Typography variant="h6" sx={{ fontWeight: 800 }}>
              {user.full_name || "Người dùng"}
            </Typography>
            <Typography variant="body2" color="text.secondary">
              {user.email}
            </Typography>
            <Box
              component="span"
              sx={{
                display: "inline-block",
                mt: 0.75,
                px: 1.5,
                py: 0.25,
                borderRadius: 99,
                bgcolor: "primaryContainer",
                color: "primary.main",
                fontSize: "0.7rem",
                fontWeight: 800,
                textTransform: "uppercase",
                letterSpacing: 0.5,
              }}
            >
              {user.role === "admin" ? "Quản trị viên" : user.role === "staff" ? "Nhân viên" : "Độc giả"}
            </Box>
          </Box>

          {uploading && (
            <Box sx={{ display: "flex", flexDirection: "row", gap: 1, alignItems: "center" }}>
              <CircularProgress size={14} />
              <Typography variant="caption">Đang xử lý...</Typography>
            </Box>
          )}

          {error && (
            <Alert severity="error" sx={{ width: "100%", py: 0 }}>
              {error}
            </Alert>
          )}

          {success && (
            <Alert severity="success" sx={{ width: "100%", py: 0 }}>
              Cập nhật thành công!
            </Alert>
          )}

          {avatarUrl && !uploading && (
            <Button
              size="small"
              color="error"
              startIcon={<DeleteIcon />}
              onClick={handleDeleteAvatar}
              sx={{ mt: -1 }}
            >
              Xóa ảnh
            </Button>
          )}

          <Divider sx={{ width: "100%", my: 1 }} />

          <List sx={{ width: "100%", py: 0 }}>
            <ListItemButton
              onClick={onClose}
              sx={{
                borderRadius: 2,
                "&:hover": { bgcolor: "action.hover" },
              }}
            >
              <ListItemIcon sx={{ minWidth: 40 }}>
                <FaceIcon color="primary" />
              </ListItemIcon>
              <ListItemText
                primary="Cập nhật khuôn mặt"
                slotProps={{ primary: { sx: { fontWeight: 600, fontSize: "0.9rem" } } }}
              />
            </ListItemButton>

            <ListItemButton
              onClick={onClose}
              sx={{
                borderRadius: 2,
                "&:hover": { bgcolor: "action.hover" },
              }}
            >
              <ListItemIcon sx={{ minWidth: 40 }}>
                <LockResetIcon color="primary" />
              </ListItemIcon>
              <ListItemText
                primary="Đổi mật khẩu"
                slotProps={{ primary: { sx: { fontWeight: 600, fontSize: "0.9rem" } } }}
              />
            </ListItemButton>

            <ListItemButton
              onClick={handleLogout}
              sx={{
                borderRadius: 2,
                "&:hover": { bgcolor: "action.hover" },
              }}
            >
              <ListItemIcon sx={{ minWidth: 40 }}>
                <LogoutIcon color="error" />
              </ListItemIcon>
              <ListItemText
                primary="Đăng xuất"
                slotProps={{ primary: { sx: { fontWeight: 600, fontSize: "0.9rem", color: "error.main" } } }}
              />
            </ListItemButton>
          </List>
        </Box>
      </DialogContent>
    </Dialog>
  );
}
</file>

<file path="src/components/staff-schedule/AutoSchedulePreview.tsx">
"use client";

import { useMemo, useState } from "react";
import {
  Box,
  Button,
  Checkbox,
  Paper,
  Stack,
  Table,
  TableBody,
  TableCell,
  TableContainer,
  TableHead,
  TableRow,
  Typography,
} from "@mui/material";
import type { ScheduleStaff, StaffShift, LibraryZone } from "@/lib/types";

interface AutoScheduleProposal {
  staffId: string;
  shiftId: string;
  zoneId: string;
  workDate: string;
  note: string;
}

interface AutoSchedulePreviewProps {
  proposals: AutoScheduleProposal[];
  staff: ScheduleStaff[];
  shifts: StaffShift[];
  zones: LibraryZone[];
  onConfirm: (selected: AutoScheduleProposal[]) => void;
  onCancel: () => void;
  loading: boolean;
  skippedCount: number;
}

export default function AutoSchedulePreview({
  proposals,
  staff,
  shifts,
  zones,
  onConfirm,
  onCancel,
  loading,
  skippedCount,
}: AutoSchedulePreviewProps) {
  const [selected, setSelected] = useState<Set<number>>(
    () => new Set(proposals.map((_, i) => i))
  );

  const staffMap = useMemo(() => new Map(staff.map((s) => [s.id, s])), [staff]);
  const shiftMap = useMemo(() => new Map(shifts.map((s) => [s.id, s])), [shifts]);
  const zoneMap = useMemo(() => new Map(zones.map((z) => [z.id, z])), [zones]);

  const toggleAll = () => {
    if (selected.size === proposals.length) {
      setSelected(new Set());
    } else {
      setSelected(new Set(proposals.map((_, i) => i)));
    }
  };

  const toggleRow = (index: number) => {
    const next = new Set(selected);
    if (next.has(index)) {
      next.delete(index);
    } else {
      next.add(index);
    }
    setSelected(next);
  };

  const handleConfirm = () => {
    const selectedProposals = proposals.filter((_, i) => selected.has(i));
    onConfirm(selectedProposals);
  };

  if (!proposals.length) {
    return (
      <Box sx={{ py: 4, textAlign: "center" }}>
        <Typography color="text.secondary">
          {skippedCount > 0
            ? `Không có ca nào được đề xuất (${skippedCount} ca đã bỏ qua)`
            : "Không có ca nào được đề xuất"}
        </Typography>
      </Box>
    );
  }

  return (
    <Stack spacing={2}>
      <Stack direction="row" spacing={1} sx={{ alignItems: "center", justifyContent: "space-between" }}>
        <Typography variant="body2" sx={{ fontWeight: 600 }}>
          {selected.size}/{proposals.length} ca được chọn
          {skippedCount > 0 && (
            <Typography component="span" variant="caption" color="text.secondary" sx={{ ml: 1 }}>
              ({skippedCount} ca bỏ qua)
            </Typography>
          )}
        </Typography>
        <Button size="small" onClick={toggleAll} sx={{ textTransform: "none" }}>
          {selected.size === proposals.length ? "Bỏ chọn tất cả" : "Chọn tất cả"}
        </Button>
      </Stack>

      <TableContainer component={Paper} variant="outlined" sx={{ maxHeight: 400 }}>
        <Table size="small" stickyHeader>
          <TableHead>
            <TableRow>
              <TableCell padding="checkbox">
                <Checkbox
                  indeterminate={selected.size > 0 && selected.size < proposals.length}
                  checked={selected.size === proposals.length}
                  onChange={toggleAll}
                />
              </TableCell>
              <TableCell sx={{ fontWeight: 600 }}>Nhân viên</TableCell>
              <TableCell sx={{ fontWeight: 600 }}>Ca</TableCell>
              <TableCell sx={{ fontWeight: 600 }}>Khu vực</TableCell>
              <TableCell sx={{ fontWeight: 600 }}>Ngày</TableCell>
              <TableCell sx={{ fontWeight: 600 }}>Ghi chú</TableCell>
            </TableRow>
          </TableHead>
          <TableBody>
            {proposals.map((p, idx) => (
              <TableRow key={idx} hover selected={selected.has(idx)}>
                <TableCell padding="checkbox">
                  <Checkbox
                    checked={selected.has(idx)}
                    onChange={() => toggleRow(idx)}
                  />
                </TableCell>
                <TableCell>{staffMap.get(p.staffId)?.fullName || staffMap.get(p.staffId)?.email || p.staffId}</TableCell>
                <TableCell>{shiftMap.get(p.shiftId)?.name || p.shiftId}</TableCell>
                <TableCell>{zoneMap.get(p.zoneId)?.zoneName || p.zoneId}</TableCell>
                <TableCell>{new Date(p.workDate + "T00:00:00").toLocaleDateString("vi-VN", { day: "2-digit", month: "2-digit" })}</TableCell>
                <TableCell>{p.note || "-"}</TableCell>
              </TableRow>
            ))}
          </TableBody>
        </Table>
      </TableContainer>

      <Stack direction="row" spacing={1} sx={{ justifyContent: "flex-end" }}>
        <Button onClick={onCancel} sx={{ textTransform: "none" }}>
          Hủy
        </Button>
        <Button
          variant="contained"
          disabled={selected.size === 0 || loading}
          onClick={handleConfirm}
          sx={{ textTransform: "none", fontWeight: 600 }}
        >
          {loading ? "Đang xử lý..." : `Xác nhận (${selected.size} ca)`}
        </Button>
      </Stack>
    </Stack>
  );
}
</file>

