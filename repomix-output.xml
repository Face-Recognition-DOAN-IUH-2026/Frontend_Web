"use client";

import { useCallback, useEffect, useMemo, useRef, useState } from "react";
import {
  Alert,
  AlertTitle,
  Button,
  Grid,
  Slide,
  Stack,
  Typography,
} from "@mui/material";
import ReturnIcon from "@mui/icons-material/AssignmentReturnOutlined";
import api, { getErrorMessage } from "@/lib/api-client";
import { slideInRight } from "@/lib/animations";
import { getAlertSeverity, getAlertTitle } from "@/lib/alert-utils";
import { usePermission } from "@/lib/permission-context";
import { useToast } from "@/lib/toast-context";
import PageHeader from "@/app/(dashboard)/_components/ui/PageHeader";
import OverdueGuideModal from "@/app/(dashboard)/_components/OverdueGuideModal";
import type { BorrowRecord, StaffActiveBorrowerSummary, StaffPatronActiveBorrowsResponse } from "@/lib/types";
import type { PaymentOrderResponse } from "@/lib/types/borrow";
import type { PendingPaymentOrder } from "@/lib/types/borrow";

import {
  ReturnMetricsBar,
  ReturnBorrowerList,
  type BorrowerFilter,
  ReturnActiveBorrows,
  ReturnScannerDialog,
  ReturnConfirmDialog,
  ReturnReceipt,
  DynamicQrPaymentDialog,
  FinesLedger,
  PendingPaymentOrders,
} from "@/app/(dashboard)/_components/return";

export default function ReturnPage() {
  const { toast } = useToast();
  const [borrowers, setBorrowers] = useState<StaffActiveBorrowerSummary[]>([]);
  const [selectedStudentCode, setSelectedStudentCode] = useState<string | null>(null);
  const [detail, setDetail] = useState<StaffPatronActiveBorrowsResponse | null>(null);
  const [search, setSearch] = useState("");
  const [filter, setFilter] = useState<BorrowerFilter>("all");
  const [loadingBorrowers, setLoadingBorrowers] = useState(true);
  const [loadingDetail, setLoadingDetail] = useState(false);
  const [returningId, setReturningId] = useState<string | null>(null);
  const [confirmRecord, setConfirmRecord] = useState<BorrowRecord | null>(null);
  const [condition, setCondition] = useState("");
  const [note, setNote] = useState("");
  const [error, setError] = useState("");
  const [scannerOpen, setScannerOpen] = useState(false);
  const [overdueGuideOpen, setOverdueGuideOpen] = useState(false);

  const [fineConfig, setFineConfig] = useState<any>(null);
  const [receiptRecord, setReceiptRecord] = useState<BorrowRecord | null>(null);
  const [receiptPatron, setReceiptPatron] = useState<{ full_name?: string | null; student_code?: string | null } | null>(null);
  const [unpaidFines, setUnpaidFines] = useState<any[]>([]);
  const [payingFineId, setPayingFineId] = useState<string | null>(null);
  const [pendingOrders, setPendingOrders] = useState<PendingPaymentOrder[]>([]);
  const [loadingPending, setLoadingPending] = useState(false);
  const [confirmingCode, setConfirmingCode] = useState<string | null>(null);
  const [qrSourceItem, setQrSourceItem] = useState<any | null>(null);
  const [qrOrder, setQrOrder] = useState<PaymentOrderResponse | null>(null);
  const [qrPatronInfo, setQrPatronInfo] = useState<{ name?: string; studentCode?: string }>({});

  const showNotice = useCallback((type: "success" | "warning" | "error" | "info", msg: string, _duration?: number) => {
    toast(msg, type);
  }, [toast]);

  const showNoticeRef = useRef(showNotice);
  useEffect(() => {
    showNoticeRef.current = showNotice;
  }, [showNotice]);

  const loadBorrowers = useCallback(async () => {
    setLoadingBorrowers(true);
    setError("");
    try {
      const data = await api.getActiveBorrowers();
      setBorrowers(data.items);
      setSelectedStudentCode((current) => {
        if (current && data.items.some((item) => item.patron.student_code === current)) return current;
        return data.items[0]?.patron.student_code ?? null;
      });
    } catch (err: any) {
      setError(getErrorMessage(err) || "Không thể tải danh sách độc giả đang mượn");
    } finally {
      setLoadingBorrowers(false);
    }
  }, []);

  const loadPatronDetail = useCallback(async (studentCode: string) => {
    setLoadingDetail(true);
    setError("");
    try {
      const data = await api.getActiveBorrowsByStudentCode(studentCode);
      setDetail(data);
    } catch (err: any) {
      setDetail(null);
      setError(getErrorMessage(err) || "Không thể tải sách đang mượn của độc giả");
    } finally {
      setLoadingDetail(false);
    }
  }, []);

  const loadUnpaidFines = useCallback(async () => {
    try {
      const rows = await api.getUnpaidFines();
      setUnpaidFines(rows);
    } catch {
      setUnpaidFines([]);
    }
  }, []);

  const loadPendingOrders = useCallback(async () => {
    setLoadingPending(true);
    try {
      const rows = await api.listPendingPaymentOrders(50);
      setPendingOrders(rows);
    } catch {
      setPendingOrders([]);
    } finally {
      setLoadingPending(false);
    }
  }, []);

  useEffect(() => {
    api.getBorrowConfig()
      .then((cfg) => setFineConfig(cfg.fine ?? null))
      .catch(() => setFineConfig(null));
    void loadUnpaidFines();
    void loadPendingOrders();
  }, [loadUnpaidFines, loadPendingOrders]);

  useEffect(() => {
    loadBorrowers();
  }, [loadBorrowers]);

  useEffect(() => {
    if (selectedStudentCode) {
      loadPatronDetail(selectedStudentCode);
    } else {
      setDetail(null);
    }
  }, [selectedStudentCode, loadPatronDetail]);

  const filteredBorrowers = useMemo(() => {
    const q = search.trim().toLowerCase();
    return borrowers.filter((borrower) => {
      const matchesSearch = !q
        || borrower.patron.student_code.toLowerCase().includes(q)
        || (borrower.patron.full_name || "").toLowerCase().includes(q);
      const matchesFilter = filter === "all"
        || (filter === "overdue" && borrower.overdue_count > 0)
        || (filter === "active" && borrower.overdue_count === 0);
      return matchesSearch && matchesFilter;
    });
  }, [borrowers, filter, search]);

  const totals = useMemo(() => ({
    borrowers: borrowers.length,
    books: borrowers.reduce((sum, item) => sum + item.total_borrowed, 0),
    overdue: borrowers.reduce((sum, item) => sum + item.overdue_count, 0),
  }), [borrowers]);

  const selectedBorrower = useMemo(
    () => borrowers.find((item) => item.patron.student_code === selectedStudentCode) ?? null,
    [borrowers, selectedStudentCode],
  );

  const { can } = usePermission();
  const canUpdateBorrow = can("borrows", "update");

  const handlePayFine = async (recordId: string, paymentMethod: "cash" | "qr_code" = "cash") => {
    setPayingFineId(recordId);
    try {
      const res = await api.payFines([recordId], paymentMethod);
      if (res.activated && res.activated.length > 0) {
        showNoticeRef.current("success", "Đã thu phí thành công. Thẻ độc giả đã được tự động mở khóa!");
      } else {
        showNoticeRef.current("success", "Đã thu phí thành công.");
      }
      void loadUnpaidFines();
      void loadPendingOrders();
      await loadBorrowers();
      if (selectedStudentCode) await loadPatronDetail(selectedStudentCode);
    } catch (err: any) {
      showNoticeRef.current("error", getErrorMessage(err) || "Lỗi khi thu phí");
    } finally {
      setPayingFineId(null);
    }
  };

  const handleOpenQrPayment = async (item: any) => {
    if (!item?.patron?.id) {
      showNoticeRef.current("error", "Thiếu thông tin độc giả, không thể tạo mã VietQR");
      return;
    }
    try {
      const order = await api.createPaymentOrder({
        patron_id: item.patron?.id,
        record_ids: [item.record_id],
        payment_method: "vietqr",
      });
      setQrPatronInfo({
        name: item.patron?.full_name || undefined,
        studentCode: item.patron?.student_code || undefined,
      });
      setQrOrder(order);
      setQrSourceItem(item);
    } catch (err: any) {
      showNoticeRef.current("error", getErrorMessage(err) || "Không thể tạo mã thanh toán VietQR");
    }
  };

  const handleQrPaymentSuccess = async (orderCode: string) => {
    setQrOrder(null);
    setQrSourceItem(null);
    showNoticeRef.current("success", `Thanh toán VietQR thành công! (Mã GD: ${orderCode})`);
    void loadUnpaidFines();
    void loadPendingOrders();
    await loadBorrowers();
    if (selectedStudentCode) await loadPatronDetail(selectedStudentCode);
  };

  const handleConfirmOrder = async (orderCode: string) => {
    setConfirmingCode(orderCode);
    try {
      const res = await api.confirmPaymentOrder(orderCode);
      if (res.activatedPatrons && res.activatedPatrons.length > 0) {
        showNoticeRef.current("success", `Đã xác nhận nhận tiền đơn ${orderCode}. Thẻ độc giả đã được mở khóa!`);
      } else {
        showNoticeRef.current("success", `Đã xác nhận nhận tiền đơn ${orderCode}, nợ đã được gạch.`);
      }
      void loadUnpaidFines();
      void loadPendingOrders();
      await loadBorrowers();
      if (selectedStudentCode) await loadPatronDetail(selectedStudentCode);
    } catch (err: any) {
      showNoticeRef.current("error", getErrorMessage(err) || "Xác nhận nhận tiền thất bại");
    } finally {
      setConfirmingCode(null);
    }
  };

  const handleReturnRecord = async (payment?: { isPaidImmediately: boolean; paymentMethod: "cash" | "qr_code" }) => {
    if (!confirmRecord) return;
    setReturningId(confirmRecord.id);
    setError("");
    const isQr = payment?.paymentMethod === "qr_code" && (payment?.isPaidImmediately ?? true);
    try {
      const result = await api.staffReturnBorrowRecord(confirmRecord.id, note || null, condition || "good", {
        is_paid_immediately: isQr ? false : (payment?.isPaidImmediately ?? true),
        payment_method: payment?.paymentMethod ?? "cash",
      });
      showNoticeRef.current("success", "Trả sách thành công");
      setCondition("");
      setNote("");
      setConfirmRecord(null);

      const returnedRec = result.record;
      const totalDue = Number(returnedRec?.total_due ?? ((Number(returnedRec?.fine_amount) || 0) + (Number(returnedRec?.damage_fee) || 0)));

      if (isQr && returnedRec && totalDue > 0) {
        try {
          const order = await api.createPaymentOrder({
            patron_id: returnedRec.patron_id,
            record_ids: [returnedRec.id],
            payment_method: "vietqr",
          });
          setQrPatronInfo({
            name: detail?.patron.full_name || detail?.patron.student_code || undefined,
            studentCode: detail?.patron.student_code || undefined,
          });
          setQrOrder(order);
        } catch {
          showNoticeRef.current("warning", "Đã ghi nhận trả sách. Khoản phí đã được lưu vào sổ nợ.");
          setReceiptPatron(detail?.patron ? { full_name: detail.patron.full_name, student_code: detail.patron.student_code } : null);
          setReceiptRecord(returnedRec);
        }
      } else {
        setReceiptPatron(detail?.patron ? { full_name: detail.patron.full_name, student_code: detail.patron.student_code } : null);
        setReceiptRecord(returnedRec ?? null);
      }

      void loadUnpaidFines();
      await loadBorrowers();
      if (selectedStudentCode) await loadPatronDetail(selectedStudentCode);
    } catch (err: any) {
      showNoticeRef.current("error", getErrorMessage(err) || "Trả sách thất bại");
    } finally {
      setReturningId(null);
    }
  };

  const handleBatchComplete = async () => {
    await loadBorrowers();
    if (selectedStudentCode) await loadPatronDetail(selectedStudentCode);
  };

  const statBadges = `${totals.borrowers} độc giả | ${totals.books} sách đang mượn | ${totals.overdue} quá hạn`;

  const headerActions = selectedStudentCode ? (
    <Button
      variant="outlined"
      size="small"
      onClick={() => { setSelectedStudentCode(null); setDetail(null); }}
      sx={{
        color: "text.primary",
        borderColor: "divider",
        "&:hover": { borderColor: "primary.main", bgcolor: "action.hover" },
      }}
    >
      Hủy chọn
    </Button>
  ) : null;

  return (
    <Stack spacing={3}>
      <PageHeader
        title="Trả sách"
        icon={ReturnIcon}
        statBadges={statBadges}
        onRefresh={loadBorrowers}
        actions={headerActions}
      />

      <ReturnMetricsBar totals={totals} />

      {error ? (
        <Slide direction="down" in={!!error} timeout={250}>
          <Alert
            severity={getAlertSeverity(error)}
            onClose={() => setError("")}
            sx={{ animation: `${slideInRight} 0.25s ease-out`, borderRadius: 2 }}
          >
            <AlertTitle>{getAlertTitle(error)}</AlertTitle>
            {error}
          </Alert>
        </Slide>
      ) : null}

      <Grid container spacing={2}>
        <Grid size={{ xs: 12, md: 5, lg: 4 }}>
          <ReturnBorrowerList
            filteredBorrowers={filteredBorrowers}
            selectedStudentCode={selectedStudentCode}
            onSelectBorrower={setSelectedStudentCode}
            search={search}
            onSearchChange={setSearch}
            filter={filter}
            onFilterChange={setFilter}
            loading={loadingBorrowers}
            selectedBorrower={selectedBorrower}
            onOpenScanner={() => setScannerOpen(true)}
            onOpenOverdueGuide={() => setOverdueGuideOpen(true)}
          />
        </Grid>

        <Grid size={{ xs: 12, md: 7, lg: 8 }}>
          <ReturnActiveBorrows
            selectedBorrower={selectedBorrower}
            detail={detail}
            loadingDetail={loadingDetail}
            returningId={returningId}
            onConfirmReturn={(record) => {
              setConfirmRecord(record);
              setCondition(record.copy?.condition || "good");
              setNote("");
            }}
          />
        </Grid>
      </Grid>

      {/* Sổ nợ phí phạt (Khoản phí chưa thu) */}
      <FinesLedger
        items={unpaidFines}
        payingFineId={payingFineId}
        canUpdateBorrow={canUpdateBorrow}
        onRefresh={() => void loadUnpaidFines()}
        onPayCash={(recordId) => void handlePayFine(recordId, "cash")}
        onOpenQr={(item) => void handleOpenQrPayment(item)}
      />

      {/* Đơn VietQR chờ đối soát (đã CK nhưng webhook chưa về) */}
      <PendingPaymentOrders
        items={pendingOrders}
        loading={loadingPending}
        confirmingCode={confirmingCode}
        canUpdateBorrow={canUpdateBorrow}
        onRefresh={() => void loadPendingOrders()}
        onConfirm={(orderCode) => void handleConfirmOrder(orderCode)}
      />

      <ReturnScannerDialog
        open={scannerOpen}
        onClose={() => setScannerOpen(false)}
        detail={detail}
        fineConfig={fineConfig}
        onBatchComplete={handleBatchComplete}
        showNotice={(type, msg, duration) => showNoticeRef.current(type, msg, duration)}
      />

      <ReturnConfirmDialog
        record={confirmRecord}
        detail={detail}
        condition={condition}
        note={note}
        fineConfig={fineConfig}
        onConditionChange={setCondition}
        onNoteChange={setNote}
        onClose={() => { setConfirmRecord(null); setCondition(""); setNote(""); }}
        onConfirm={handleReturnRecord}
        loading={!!returningId}
      />

      <DynamicQrPaymentDialog
        open={!!qrOrder}
        order={qrOrder}
        patronName={qrPatronInfo.name}
        studentCode={qrPatronInfo.studentCode}
        onClose={() => { setQrOrder(null); setQrSourceItem(null); }}
        onSuccess={handleQrPaymentSuccess}
        onRegenerate={() => { if (qrSourceItem) void handleOpenQrPayment(qrSourceItem); }}
      />

      <ReturnReceipt
        record={receiptRecord}
        patron={receiptPatron}
        onClose={() => {
          setReceiptRecord(null);
          setReceiptPatron(null);
        }}
      />

      <OverdueGuideModal
        open={overdueGuideOpen}
        onClose={() => setOverdueGuideOpen(false)}
      />

    </Stack>
  );
}
</file>

<file path="src/app/(dashboard)/patrons/page.tsx">
"use client";

import { useCallback, useEffect, useMemo, useState } from "react";
import { useRouter } from "next/navigation";
import {
  Avatar,
  Box,
  Button,
  Chip,
  CircularProgress,
  Dialog,
  DialogActions,
  DialogContent,
  DialogTitle,
  Drawer,
  IconButton,
  MenuItem,
  Stack,
  TextField,
  Tooltip,
  Typography,
} from "@mui/material";
import CloseIcon from "@mui/icons-material/Close";
import DeleteIcon from "@mui/icons-material/DeleteOutlined";
import EditIcon from "@mui/icons-material/EditOutlined";
import PeopleIcon from "@mui/icons-material/PeopleOutlined";
import UpdateIcon from "@mui/icons-material/UpdateOutlined";
import api, { getErrorMessage } from "@/lib/api-client";
import { usePermission, getPermissionDeniedReason } from "@/lib/permission-context";
import { initials } from "@/lib/utils";
import { useToast } from "@/lib/toast-context";
import PageHeader from "@/app/(dashboard)/_components/ui/PageHeader";
import EmptyState from "@/app/(dashboard)/_components/ui/EmptyState";
import LoadingOverlay from "@/app/(dashboard)/_components/ui/LoadingOverlay";
import ConfirmDialog from "@/app/(dashboard)/_components/ui/ConfirmDialog";
import PatronStatCards from "@/app/(dashboard)/_components/ui/PatronStatCards";
import PatronToolbar from "@/app/(dashboard)/_components/ui/PatronToolbar";
import PatronListView from "@/app/(dashboard)/_components/ui/PatronListView";
import PatronImportWizard from "@/app/(dashboard)/_components/ui/PatronImportWizard";
import type { PatronCreate, PatronPublic, PatronUpdate } from "@/lib/types";

export type FilterValue = "all" | "active" | "inactive" | "expired" | "has_face" | "no_face" | "deleted";

const STAT_GRADIENT = {
  total: "linear-gradient(135deg, #0A2540 0%, #0F3C5C 100%)",
  active: "linear-gradient(135deg, #059669 0%, #047857 100%)",
  expired: "linear-gradient(135deg, #D97706 0%, #B45309 100%)",
  face: "linear-gradient(135deg, #8B0000 0%, #700000 100%)",
};

export default function PatronsPage() {
  const router = useRouter();
  const { can } = usePermission();
  const { toast } = useToast();
  const canUpdatePatron = can("patrons", "update");
  const canDeletePatron = can("patrons", "delete");

  const [patrons, setPatrons] = useState<PatronPublic[]>([]);
  const [query, setQuery] = useState("");
  const [debouncedQuery, setDebouncedQuery] = useState("");
  const [filter, setFilter] = useState<FilterValue>("all");
  const [loading, setLoading] = useState(false);

  useEffect(() => {
    const timer = setTimeout(() => {
      setDebouncedQuery(query);
    }, 350);
    return () => clearTimeout(timer);
  }, [query]);

  const [showImport, setShowImport] = useState(false);

  const [editTarget, setEditTarget] = useState<PatronPublic | null>(null);
  const [editForm, setEditForm] = useState<PatronUpdate>({});
  const [editSaving, setEditSaving] = useState(false);

  const [deleteTarget, setDeleteTarget] = useState<PatronPublic | null>(null);
  const [deleteConfirmText, setDeleteConfirmText] = useState("");

  const [restoreTarget, setRestoreTarget] = useState<PatronPublic | null>(null);
  const [restoreConfirmText, setRestoreConfirmText] = useState("");

  const [renewTarget, setRenewTarget] = useState<PatronPublic | null>(null);
  const [renewMonths, setRenewMonths] = useState(12);

  const load = useCallback(async () => {
    setLoading(true);
    try {
      const { items } = await api.searchPatrons(debouncedQuery || undefined, undefined, 0, 1000);
      setPatrons(items);
    } catch (err) {
      toast.error(getErrorMessage(err) || "Không thể tải danh sách độc giả");
    } finally {
      setLoading(false);
    }
  }, [debouncedQuery, toast]);

  useEffect(() => { load(); }, [load]);

  const filtered = useMemo(() => {
    let list = patrons;
    if (filter === "active") list = list.filter((p) => p.status === "active");
    else if (filter === "inactive") list = list.filter((p) => p.status === "inactive");
    else if (filter === "expired") list = list.filter((p) => !!p.membership_expiry && new Date(p.membership_expiry) < new Date());
    else if (filter === "deleted") list = list.filter((p) => p.status === "deleted");
    else if (filter === "has_face") list = list.filter((p) => p.has_face);
    else if (filter === "no_face") list = list.filter((p) => !p.has_face);
    return list;
  }, [patrons, filter]);

  const openEdit = (patron: PatronPublic) => {
    setEditTarget(patron);
    setEditForm({
      full_name: patron.full_name,
      class_name: patron.class_name || undefined,
      identity_number: patron.identity_number || undefined,
      email: patron.email || undefined,
      phone: patron.phone || undefined,
      membership_expiry: patron.membership_expiry,
      status: patron.status,
      course: patron.course || undefined,
      permanent_address: patron.permanent_address || undefined,
    });
  };

  const handleEdit = async () => {
    if (!editTarget) return;
    setEditSaving(true);
    try {
      await api.updatePatron(editTarget.id, editForm);
      setEditTarget(null);
      setEditForm({});
      await load();
      toast.success("Đã cập nhật độc giả");
    } catch (err) {
      toast.error(getErrorMessage(err) || "Cập nhật thất bại");
    } finally {
      setEditSaving(false);
    }
  };

  const handleDownloadTemplate = async () => {
    try {
      const blob = await api.downloadPatronTemplate();
      const url = window.URL.createObjectURL(blob);
      const a = document.createElement("a");
      a.href = url;
      a.download = "patron_import_template.xlsx";
      document.body.appendChild(a);
      a.click();
      a.remove();
      window.URL.revokeObjectURL(url);
      toast.success("Đã tải xuống biểu mẫu Excel.");
    } catch (err) {
      toast.error(getErrorMessage(err) || "Không thể tải biểu mẫu Excel");
    }
  };

  const handleRenew = async () => {
    if (!renewTarget) return;
    const next = new Date(renewTarget.membership_expiry);
    if (next < new Date()) next.setTime(Date.now());
    next.setMonth(next.getMonth() + renewMonths);
    try {
      await api.updatePatron(renewTarget.id, { membership_expiry: next.toISOString().split("T")[0] });
      setRenewTarget(null);
      setRenewMonths(12);
      await load();
      toast.success(`Đã gia hạn thẻ ${renewTarget.full_name} ${renewMonths} tháng`);
    } catch (err) {
      toast.error(getErrorMessage(err) || "Gia hạn thất bại");
    }
  };

  const handleDelete = async () => {
    if (!deleteTarget || deleteConfirmText !== "XÓA") return;
    const target = deleteTarget;
    setDeleteTarget(null);
    setDeleteConfirmText("");
    setPatrons((prev) => prev.filter((p) => p.id !== target.id));
    try {
      await api.deletePatron(target.id);
      toast.success(`Đã xóa độc giả ${target.full_name}`);
    } catch (err: any) {
      if (err?.response?.status === 404) toast.info("Độc giả đã bị xóa trước đó");
      else { toast.error(getErrorMessage(err) || "Xóa thất bại"); await load(); }
    }
  };

  const handleRestore = async () => {
    if (!restoreTarget || restoreConfirmText !== "KHÔI PHỤC") return;
    const target = restoreTarget;
    setRestoreTarget(null);
    setRestoreConfirmText("");
    setPatrons((prev) => prev.filter((p) => p.id !== target.id));
    try {
      await api.restorePatron(target.id);
      toast.success(`Đã khôi phục độc giả ${target.full_name}`);
    } catch (err: any) {
      toast.error(getErrorMessage(err) || "Khôi phục thất bại");
      await load();
    }
  };

  const statBadges = `${patrons.length} độc giả · ${patrons.filter((p) => p.status === "active").length} đang hoạt động · ${patrons.filter((p) => p.has_face).length} đã đăng ký khuôn mặt`;

  return (
    <Stack spacing={3}>
      <PageHeader
        title="Quản lý Độc giả"
        icon={PeopleIcon}
        statBadges={statBadges}
        onRefresh={load}
      />

      <PatronStatCards patrons={patrons} />

      <PatronToolbar
        query={query}
        onQueryChange={setQuery}
        filter={filter}
        onFilterChange={setFilter}
        onImportExcel={() => setShowImport(true)}
        onDownloadTemplate={handleDownloadTemplate}
      />

      {loading && filtered.length === 0 ? (
        <LoadingOverlay loading message="Đang tải danh sách độc giả..." />
      ) : filtered.length === 0 ? (
        <EmptyState
          icon={<PeopleIcon sx={{ fontSize: 32 }} />}
          title="Không tìm thấy độc giả nào"
          action={<Button size="small" sx={{ textTransform: "none" }} onClick={() => { setQuery(""); setFilter("all"); }}>Xóa bộ lọc</Button>}
        />
      ) : (
        <PatronListView
          patrons={filtered}
          onEdit={openEdit}
          onRenew={(p) => { setRenewTarget(p); setRenewMonths(12); }}
          onDelete={(p) => { setDeleteTarget(p); setDeleteConfirmText(""); }}
          onRestore={(p) => { setRestoreTarget(p); setRestoreConfirmText(""); }}
        />
      )}

      <PatronImportWizard open={showImport} onClose={() => setShowImport(false)} onSuccess={load} />

      <Drawer
        anchor="right"
        open={!!editTarget}
        onClose={() => { if (!editSaving) setEditTarget(null); }}
        slotProps={{ backdrop: { invisible: true } }}
      >
        <Box sx={{ width: { xs: "100vw", sm: 440 }, display: "flex", flexDirection: "column", height: "100%" }}>
          <Stack direction="row" sx={{ alignItems: "center", justifyContent: "space-between", px: 2.5, py: 2, borderBottom: 1, borderColor: "divider" }}>
            <Typography variant="h6" sx={{ fontWeight: 700 }}>Sửa độc giả</Typography>
            <IconButton onClick={() => setEditTarget(null)}><CloseIcon /></IconButton>
          </Stack>

          {editTarget ? (
            <Stack spacing={2.5} sx={{ flex: 1, overflow: "auto", px: 2.5, py: 2.5 }}>
              <Stack direction="row" spacing={2} sx={{ alignItems: "center" }}>
                <Avatar sx={{ width: 48, height: 48, bgcolor: STAT_GRADIENT.total, fontWeight: 700 }}>
                  {initials(editTarget.full_name)}
                </Avatar>
                <Box>
                  <Typography sx={{ fontWeight: 700 }}>{editTarget.full_name}</Typography>
                  <Typography variant="body2" color="text.secondary" sx={{ fontFamily: "monospace" }}>
                    {editTarget.student_code}
                  </Typography>
                </Box>
              </Stack>

              <TextField label="Họ tên" value={editForm.full_name || ""} onChange={(e) => setEditForm({ ...editForm, full_name: e.target.value })} fullWidth />
              <TextField label="Lớp" value={editForm.class_name || ""} onChange={(e) => setEditForm({ ...editForm, class_name: e.target.value })} fullWidth />
              <TextField label="Khóa học" value={editForm.course || ""} onChange={(e) => setEditForm({ ...editForm, course: e.target.value })} fullWidth />
              <TextField label="HKTT" value={editForm.permanent_address || ""} onChange={(e) => setEditForm({ ...editForm, permanent_address: e.target.value })} fullWidth multiline rows={2} />
              <TextField label="CMND/CCCD" value={editForm.identity_number || ""} onChange={(e) => setEditForm({ ...editForm, identity_number: e.target.value })} fullWidth />
              <TextField label="Email" value={editForm.email || ""} onChange={(e) => setEditForm({ ...editForm, email: e.target.value })} fullWidth />
              <TextField label="SĐT" value={editForm.phone || ""} onChange={(e) => setEditForm({ ...editForm, phone: e.target.value })} fullWidth />
              <TextField label="Hạn thẻ" type="date" value={editForm.membership_expiry || ""} onChange={(e) => setEditForm({ ...editForm, membership_expiry: e.target.value })} slotProps={{ inputLabel: { shrink: true } }} fullWidth />
              <TextField select label="Trạng thái" value={editForm.status || "active"} onChange={(e) => setEditForm({ ...editForm, status: e.target.value })} fullWidth>
                <MenuItem value="active">Hoạt động</MenuItem>
                <MenuItem value="inactive">Tạm khóa</MenuItem>
              </TextField>
            </Stack>
          ) : null}

          <Stack direction="row" spacing={1.5} sx={{ px: 2.5, py: 2, borderTop: 1, borderColor: "divider" }}>
            <Button fullWidth variant="outlined" onClick={() => setEditTarget(null)} disabled={editSaving}>Hủy</Button>
            <Tooltip title={!canUpdatePatron ? getPermissionDeniedReason("patrons", "update") : ""}>
              <span style={{ width: "100%" }}>
                <Button fullWidth variant="contained" onClick={handleEdit} disabled={editSaving || !canUpdatePatron}>
                  {editSaving ? <CircularProgress size={20} /> : "Lưu thay đổi"}
                </Button>
              </span>
            </Tooltip>
          </Stack>
        </Box>
      </Drawer>

      <Dialog open={!!renewTarget} onClose={() => { setRenewTarget(null); setRenewMonths(12); }}>
        <DialogTitle>Gia hạn thẻ độc giả</DialogTitle>
        <DialogContent>
          <Stack spacing={2}>
            <Typography>
              Gia hạn thẻ cho <strong>{renewTarget?.full_name}</strong> ({renewTarget?.student_code})
            </Typography>
            <Typography variant="body2" color="text.secondary">
              Hạn hiện tại: {renewTarget?.membership_expiry}
            </Typography>
            <TextField
              select
              label="Gia hạn thêm"
              value={renewMonths}
              onChange={(e) => setRenewMonths(Number(e.target.value))}
              fullWidth
            >
              <MenuItem value={1}>1 tháng</MenuItem>
              <MenuItem value={3}>3 tháng</MenuItem>
              <MenuItem value={6}>6 tháng</MenuItem>
              <MenuItem value={12}>1 năm</MenuItem>
              <MenuItem value={24}>2 năm</MenuItem>
            </TextField>
            <Typography variant="body2" color="primary.main" sx={{ fontWeight: 600 }}>
              Hạn mới: {(() => {
                const d = new Date(renewTarget?.membership_expiry || Date.now());
                if (d < new Date()) d.setTime(Date.now());
                d.setMonth(d.getMonth() + renewMonths);
                return d.toISOString().split("T")[0];
              })()}
            </Typography>
          </Stack>
        </DialogContent>
        <DialogActions>
          <Button onClick={() => { setRenewTarget(null); setRenewMonths(12); }} color="inherit">Hủy</Button>
          <Tooltip title={!canUpdatePatron ? getPermissionDeniedReason("patrons", "update") : ""}>
            <span>
              <Button variant="contained" onClick={handleRenew} disabled={!canUpdatePatron}>Gia hạn</Button>
            </span>
          </Tooltip>
        </DialogActions>
      </Dialog>

      <Dialog open={!!deleteTarget} onClose={() => { setDeleteTarget(null); setDeleteConfirmText(""); }}>
        <DialogTitle>Xóa độc giả?</DialogTitle>
        <DialogContent>
          <Stack spacing={2}>
            <Typography>
              Xóa <strong>{deleteTarget?.full_name}</strong>? Thao tác này sẽ xóa dữ liệu liên quan và không thể hoàn tác từ giao diện.
            </Typography>
            <Typography variant="body2" color="text.secondary">
              Nhập <strong>XÓA</strong> để xác nhận:
            </Typography>
            <TextField
              value={deleteConfirmText}
              onChange={(e) => setDeleteConfirmText(e.target.value)}
              placeholder="Nhập XÓA"
              size="small"
              autoFocus
              fullWidth
            />
          </Stack>
        </DialogContent>
        <DialogActions>
          <Button onClick={() => { setDeleteTarget(null); setDeleteConfirmText(""); }} color="inherit">Hủy</Button>
          <Tooltip title={!canDeletePatron ? getPermissionDeniedReason("patrons", "delete") : ""}>
            <span>
              <Button color="error" variant="contained" onClick={handleDelete} disabled={deleteConfirmText !== "XÓA" || !canDeletePatron}>
                Xóa vĩnh viễn
              </Button>
            </span>
          </Tooltip>
        </DialogActions>
      </Dialog>

      <Dialog open={!!restoreTarget} onClose={() => { setRestoreTarget(null); setRestoreConfirmText(""); }}>
        <DialogTitle>Khôi phục độc giả?</DialogTitle>
        <DialogContent>
          <Stack spacing={2}>
            <Typography>
              Khôi phục <strong>{restoreTarget?.full_name}</strong>? Nếu thẻ đã hết hạn, hạn thẻ sẽ được tự động gia hạn 1 năm.
            </Typography>
            <Typography variant="body2" color="text.secondary">
              Nhập <strong>KHÔI PHỤC</strong> để xác nhận:
            </Typography>
            <TextField
              value={restoreConfirmText}
              onChange={(e) => setRestoreConfirmText(e.target.value)}
              placeholder="Nhập KHÔI PHỤC"
              size="small"
              autoFocus
              fullWidth
            />
          </Stack>
        </DialogContent>
        <DialogActions>
          <Button onClick={() => { setRestoreTarget(null); setRestoreConfirmText(""); }} color="inherit">Hủy</Button>
          <Tooltip title={!canUpdatePatron ? getPermissionDeniedReason("patrons", "update") : ""}>
            <span>
              <Button color="success" variant="contained" onClick={handleRestore} disabled={restoreConfirmText !== "KHÔI PHỤC" || !canUpdatePatron}>
                Khôi phục
              </Button>
            </span>
          </Tooltip>
        </DialogActions>
      </Dialog>
    </Stack>
  );
}
</file>

<file path="src/app/(dashboard)/staff-schedules/page.tsx">
"use client";

import { useState, useMemo } from "react";
import { Alert, Box, Button, Divider, IconButton, MenuItem, Stack, TextField, ToggleButton, ToggleButtonGroup, Tooltip, Typography } from "@mui/material";
import PrevIcon from "@mui/icons-material/ArrowBack";
import NextIcon from "@mui/icons-material/ArrowForward";
import TodayIcon from "@mui/icons-material/TodayOutlined";
import PrintIcon from "@mui/icons-material/PrintOutlined";
import ActiveIcon from "@mui/icons-material/CheckCircleOutlined";
import TotalIcon from "@mui/icons-material/AssignmentOutlined";
import StaffIcon from "@mui/icons-material/PersonOutlined";
import MapIcon from "@mui/icons-material/PinDropOutlined";
import HistoryIcon from "@mui/icons-material/HistoryOutlined";
import AutoAwesomeIcon from "@mui/icons-material/AutoAwesomeOutlined";
import SettingsIcon from "@mui/icons-material/SettingsOutlined";
import ScheduleOutlined from "@mui/icons-material/ScheduleOutlined";
import { useAuth } from "@/lib/auth-context";
import { usePermission } from "@/lib/permission-context";
import { staggerSx } from "@/lib/useStaggeredAnimation";
import { useScheduleData, formatDateRange } from "@/hooks/useScheduleData";
import { useScheduleFilters } from "@/hooks/useScheduleFilters";
import { usePendingCounts } from "@/hooks/usePendingCounts";
import { useAutoSchedule } from "@/hooks/useAutoSchedule";
import api, { getErrorMessage } from "@/lib/api-client";
import type { StaffScheduleAssignment } from "@/lib/types";
import PageHeader from "@/app/(dashboard)/_components/ui/PageHeader";
import MuiStatCard from "@/app/(dashboard)/_components/ui/MuiStatCard";
import DashboardCard from "@/app/(dashboard)/_components/ui/DashboardCard";
import EmptyState from "@/app/(dashboard)/_components/ui/EmptyState";
import LoadingOverlay from "@/app/(dashboard)/_components/ui/LoadingOverlay";
import TimetableGrid from "@/app/(dashboard)/_components/staff-schedule/TimetableGrid";
import TimetableLegend from "@/app/(dashboard)/_components/staff-schedule/TimetableLegend";
import AssignStaffDialog from "@/app/(dashboard)/_components/staff-schedule/AssignStaffDialog";
import ScheduleManagementPanel from "@/app/(dashboard)/_components/staff-schedule/ScheduleManagementPanel";
import AutoScheduleDialog from "@/app/(dashboard)/_components/staff-schedule/AutoScheduleDialog";
import AuditLogsPanel from "@/app/(dashboard)/_components/staff-schedule/AuditLogsPanel";
import GeofenceConfigPanel from "@/app/(dashboard)/_components/staff-schedule/GeofenceConfigPanel";
import TemplateManagementPanel from "@/app/(dashboard)/_components/staff-schedule/TemplateManagementPanel";
import DeleteWeekDialog from "@/app/(dashboard)/_components/staff-schedule/DeleteWeekDialog";
import ManualCheckInAdmin from "@/app/(dashboard)/_components/staff-schedule/ManualCheckInAdmin";
import ScheduleFilterBar from "@/app/(dashboard)/_components/staff-schedule/ScheduleFilterBar";
import UndoSnackbar from "@/app/_components/UndoSnackbar";
import useUndo from "@/lib/hooks/useUndo";
import { useToast } from "@/lib/toast-context";

const STAT_GRADIENT = {
  total: "linear-gradient(135deg, #0A2540 0%, #0F3C5C 100%)",
  active: "linear-gradient(135deg, #059669 0%, #047857 100%)",
  staff: "linear-gradient(135deg, #3b82f6 0%, #1d4ed8 100%)",
};

export default function StaffSchedulesPage() {
  const { user } = useAuth();
  const { toast } = useToast();
  const { can } = usePermission();
  const isAdmin = user?.role === "admin";
  const isStaff = !!user;

  // Quyền thao tác lịch: Admin toàn quyền, hoặc nhân viên được cấp quyền riêng qua RBAC
  const canCreate = isAdmin || can("schedules", "create");
  const canUpdate = isAdmin || can("schedules", "update");
  const canDelete = isAdmin || can("schedules", "delete");
  const canManage = isAdmin || canCreate || canUpdate || canDelete;

  const {
    staff, zones, shifts, assignments, loading, error, setError,
    weekStart, days, from, to,
    goPrevWeek, goNextWeek, goToday, loadData,
  } = useScheduleData(canManage);

  const {
    filter, zoneFilter, shiftFilter,
    setFilter, setZoneFilter, setShiftFilter,
    shiftList, filteredAssignments, filteredShifts, weekStats,
  } = useScheduleFilters(assignments, shifts, staff, zones);

  const { pendingManualCount } = usePendingCounts(isAdmin || canUpdate, loading);

  const auto = useAutoSchedule(loadData, setError);

  const [showManagement, setShowManagement] = useState(false);
  const [assignDialog, setAssignDialog] = useState<{ date: string; shiftId: string; shiftName: string } | null>(null);
  const [showAuditLogs, setShowAuditLogs] = useState(false);
  const [showGeofence, setShowGeofence] = useState(false);
  const [showTemplates, setShowTemplates] = useState(false);
  const [showDeleteWeek, setShowDeleteWeek] = useState(false);
  const [showManualCheckIn, setShowManualCheckIn] = useState(false);

  const handleCellClick = (date: string, shiftId: string) => {
    const shift = shifts.find((s) => s.id === shiftId);
    setAssignDialog({ date, shiftId, shiftName: shift?.name || "" });
  };

  const [confirmingId, setConfirmingId] = useState<string | null>(null);

  const { pendingDelete, countdown, markForDelete, undo } = useUndo<string>({
    onConfirm: async (id) => {
      setConfirmingId(id);
      try {
        await api.deleteScheduleAssignment(id);
        await loadData();
        toast.success("Đã xóa vĩnh viễn phân công trực.");
      } catch (err) {
        const msg = getErrorMessage(err);
        setError(msg);
        toast.error(msg);
      } finally {
        setConfirmingId(null);
      }
    },
  });

  const hiddenIds = useMemo(() => new Set([pendingDelete, confirmingId].filter(Boolean) as string[]), [pendingDelete, confirmingId]);
  const filteredAssignmentsWithUndo = useMemo(
    () => filteredAssignments.filter((a) => !hiddenIds.has(a.id)),
    [filteredAssignments, hiddenIds],
  );

  const handleDeleteAssignment = (id: string) => markForDelete(id);

  if (!isStaff) {
    return (
      <EmptyState
        icon={<ScheduleOutlined sx={{ fontSize: 32 }} />}
        title="Không có quyền truy cập"
        description="Bạn không có quyền xem trang này."
      />
    );
  }

  const isCurrentWeek = from === (() => { const d = new Date(); const day = d.getDay() || 7; d.setDate(d.getDate() - day + 1); return d; })().toISOString().slice(0, 10);

  const headerActions = (
    <>
      <Tooltip title="Tuần trước">
        <IconButton onClick={goPrevWeek} size="small" sx={{ border: "1px solid", borderColor: "divider", color: "text.secondary", "&:hover": { bgcolor: "action.hover", color: "primary.main" } }}>
          <PrevIcon fontSize="small" />
        </IconButton>
      </Tooltip>
      <Button onClick={goToday} size="small" variant={isCurrentWeek ? "contained" : "outlined"} startIcon={<TodayIcon sx={{ fontSize: 16 }} />}
        sx={{ borderRadius: 2, fontWeight: 700, fontSize: "0.75rem",
          ...(isCurrentWeek
            ? { bgcolor: "primary.main", "&:hover": { bgcolor: "primary.dark" } }
            : { color: "text.secondary", borderColor: "divider", "&:hover": { borderColor: "primary.main", color: "primary.main" } }
          ),
        }}
      >
        Hôm nay
      </Button>
      <Tooltip title="Tuần sau">
        <IconButton onClick={goNextWeek} size="small" sx={{ border: "1px solid", borderColor: "divider", color: "text.secondary", "&:hover": { bgcolor: "action.hover", color: "primary.main" } }}>
          <NextIcon fontSize="small" />
        </IconButton>
      </Tooltip>
      {canCreate && (
        <Tooltip title="Gợi ý lịch tự động">
          <IconButton onClick={() => auto.setShowAutoSchedule(true)} size="small" sx={{ color: "#D4AF37", border: "1px solid rgba(212,175,55,0.4)", "&:hover": { bgcolor: "rgba(212,175,55,0.1)" } }}>
            <AutoAwesomeIcon fontSize="small" />
          </IconButton>
        </Tooltip>
      )}
      {(isAdmin || canUpdate) && (
        <Tooltip title="Quản lý ca/khu vực">
          <IconButton onClick={() => setShowManagement(true)} size="small" sx={{ border: "1px solid", borderColor: "divider", color: "text.secondary", "&:hover": { bgcolor: "action.hover", color: "primary.main" } }}>
            <SettingsIcon fontSize="small" />
          </IconButton>
        </Tooltip>
      )}
      {(isAdmin || canCreate) && (
        <Tooltip title="Mẫu lịch">
          <IconButton onClick={() => setShowTemplates(true)} size="small" sx={{ border: "1px solid", borderColor: "divider", color: "text.secondary", "&:hover": { bgcolor: "action.hover", color: "primary.main" } }}>
            <TotalIcon fontSize="small" />
          </IconButton>
        </Tooltip>
      )}
      {(isAdmin || canUpdate) && (
        <Tooltip title="Geofence">
          <IconButton onClick={() => setShowGeofence(true)} size="small" sx={{ color: "#D97706", border: "1px solid rgba(217,119,6,0.3)", "&:hover": { bgcolor: "rgba(217,119,6,0.1)" } }}>
            <MapIcon fontSize="small" />
          </IconButton>
        </Tooltip>
      )}
      {(isAdmin || canUpdate) && (
        <Tooltip title="Check-in thủ công">
          <IconButton onClick={() => setShowManualCheckIn(true)} size="small" sx={{ color: "primary.main", border: "1px solid", borderColor: "primary.light", "&:hover": { bgcolor: "action.hover" }, position: "relative" }}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth={2} style={{ width: 18, height: 18 }}>
              <path strokeLinecap="round" strokeLinejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4" />
            </svg>
            {pendingManualCount > 0 ? (
              <Box sx={{ position: "absolute", top: -4, right: -4, minWidth: 16, height: 16, borderRadius: "50%", bgcolor: "#ef4444", display: "flex", alignItems: "center", justifyContent: "center" }}>
                <Typography variant="caption" sx={{ color: "#fff", fontSize: "0.6rem", fontWeight: 800, lineHeight: 1 }}>{pendingManualCount > 9 ? "9+" : pendingManualCount}</Typography>
              </Box>
            ) : null}
          </IconButton>
        </Tooltip>
      )}
      {canManage && (
        <Tooltip title="Nhật ký">
          <IconButton onClick={() => setShowAuditLogs(true)} size="small" sx={{ border: "1px solid", borderColor: "divider", color: "text.secondary", "&:hover": { bgcolor: "action.hover", color: "primary.main" } }}>
            <HistoryIcon fontSize="small" />
          </IconButton>
        </Tooltip>
      )}
      {canDelete && (
        <Tooltip title="Xóa lịch tuần này">
          <IconButton
            onClick={() => setShowDeleteWeek(true)}
            size="small"
            sx={{ color: "#ef4444", border: "1px solid rgba(239,68,68,0.35)", "&:hover": { bgcolor: "rgba(239,68,68,0.1)" } }}
          >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth={2} style={{ width: 18, height: 18 }}>
              <path strokeLinecap="round" strokeLinejoin="round" d="M9 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
            </svg>
          </IconButton>
        </Tooltip>
      )}
      <Tooltip title="In lịch">
        <IconButton onClick={() => window.print()} size="small" sx={{ border: "1px solid", borderColor: "divider", color: "text.secondary", "&:hover": { bgcolor: "action.hover", color: "primary.main" } }}>
          <PrintIcon fontSize="small" />
        </IconButton>
      </Tooltip>
    </>
  );

  return (
    <Stack spacing={3}>
      <PageHeader
        title="Lịch trực theo tuần"
        subtitle={formatDateRange(days)}
        icon={ScheduleOutlined}
        onRefresh={loadData}
        actions={headerActions}
      />

      <Box sx={{ display: "grid", gridTemplateColumns: { xs: "1fr", sm: "repeat(3, 1fr)" }, gap: 2 }}>
        {[
          { key: "total", label: "Tổng ca tuần", value: weekStats.total, icon: TotalIcon, gradient: STAT_GRADIENT.total, pct: 100 },
          { key: "active", label: "Đang trực", value: weekStats.active, icon: ActiveIcon, gradient: STAT_GRADIENT.active, pct: weekStats.total ? (weekStats.active / weekStats.total) * 100 : 0 },
          { key: "staff", label: "Nhân viên", value: weekStats.staffCount, icon: StaffIcon, gradient: STAT_GRADIENT.staff, pct: 100 },
        ].map((s, idx) => (
          <Box key={s.key} sx={staggerSx(idx)}>
            <MuiStatCard label={s.label} value={s.value} icon={s.icon} gradient={s.gradient} pct={s.pct} index={idx} />
          </Box>
        ))}
      </Box>

      <ScheduleFilterBar
        filter={filter}
        setFilter={setFilter}
        zoneFilter={zoneFilter}
        setZoneFilter={setZoneFilter}
        shiftFilter={shiftFilter}
        setShiftFilter={setShiftFilter}
        zones={zones}
        shiftList={shiftList}
      />

      {error ? (
        <Alert severity="error" onClose={() => setError(null)} sx={{ borderRadius: 2 }}>{error}</Alert>
      ) : null}

      <LoadingOverlay loading={loading} message="Đang tải lịch trực...">
        <DashboardCard noPadding>
          <TimetableGrid
            days={days} shifts={filteredShifts} assignments={filteredAssignmentsWithUndo}
            filter={filter} isAdmin={canManage}
            onCellClick={canCreate ? handleCellClick : undefined}
            onDeleteAssignment={canDelete ? handleDeleteAssignment : undefined}
          />
          <Divider sx={{ borderColor: "divider" }} />
          <Box sx={{ p: { xs: 1.5, sm: 2 }, bgcolor: (theme) => theme.palette.mode === "dark" ? "rgba(15, 23, 42, 0.4)" : "rgba(248, 250, 252, 0.6)" }}>
            <TimetableLegend />
          </Box>
        </DashboardCard>
      </LoadingOverlay>

      <AssignStaffDialog
        open={!!assignDialog} date={assignDialog?.date || ""} shiftId={assignDialog?.shiftId || ""} shiftName={assignDialog?.shiftName || ""}
        shifts={shiftList} zones={zones} staff={staff}
        existingAssignments={assignments.filter((a) => a.shiftId === assignDialog?.shiftId && a.workDate === assignDialog?.date && a.status !== "cancelled")}
        dayAssignments={assignments.filter((a) => a.workDate === assignDialog?.date && a.status !== "cancelled")}
        onClose={() => setAssignDialog(null)}
        onAssigned={() => { setAssignDialog(null); loadData(); }}
      />

      <ScheduleManagementPanel open={showManagement} onClose={() => setShowManagement(false)} zones={zones} shifts={shiftList} onUpdate={loadData} />
      <AuditLogsPanel open={showAuditLogs} onClose={() => setShowAuditLogs(false)} />
      <GeofenceConfigPanel open={showGeofence} onClose={() => setShowGeofence(false)} zones={zones} onUpdated={loadData} />
