<file path="src/lib/event-bus.ts">
type Listener = (...args: any[]) => void;

class EventBus {
  private listeners: Record<string, Listener[]> = {};

  on(event: string, fn: Listener): () => void {
    (this.listeners[event] ??= []).push(fn);
    return () => this.off(event, fn);
  }

  off(event: string, fn: Listener): void {
    const list = this.listeners[event];
    if (list) this.listeners[event] = list.filter(l => l !== fn);
  }

  emit(event: string, ...args: any[]): void {
    this.listeners[event]?.forEach(fn => fn(...args));
  }
}

export const bus = new EventBus();
</file>

<file path="src/lib/face-enroll-errors.ts">
/**
 * Helper dùng chung cho lỗi đăng ký khuôn mặt (enroll-batch worker).
 * Worker trả về `{ error: "N angle(s) failed...", results: [{ angle, status, error }] }`
 * nhưng UI trước đây chỉ hiện câu chung nên thủ thư không biết góc nào lỗi.
 */

export const ANGLE_VI_LABELS: Record<string, string> = {
  frontal: "Nhìn thẳng",
  right: "Quay phải",
  left: "Quay trái",
  down: "Cúi xuống",
};

const ERROR_MESSAGES: Record<string, string> = {
  LIVENESS_FAILED: "Ảnh không phải khuôn mặt thật, vui lòng chụp trực tiếp.",
  NO_FACE_DETECTED: "Không tìm thấy khuôn mặt trong ảnh, vui lòng thử lại.",
  MULTIPLE_FACES: "Có nhiều hơn 1 khuôn mặt trong ảnh, vui lòng chụp lại.",
  LOW_QUALITY: "Ảnh quá mờ hoặc thiếu sáng, vui lòng chụp lại với ánh sáng tốt hơn.",
  FACE_DETECTION_FAILED: "Không thể trích xuất khuôn mặt, vui lòng thử lại.",
};

/**
 * Map mã lỗi backend sang tiếng Việt thân thiện.
 * - Mã kỹ thuật toàn chữ hoa (LIVENESS_FAILED...) → tra bảng.
 * - Câu sẵn có từ server (vd "Quá thời gian chờ kết quả.") → dùng luôn.
 * - Còn lại → fallback.
 */
export function mapEnrollError(code: string | null | undefined, fallback: string): string {
  if (code && ERROR_MESSAGES[code]) return ERROR_MESSAGES[code];
  if (code && code.length < 120 && !/^[A-Z_]+$/.test(code)) return code;
  return fallback;
}

export interface FailedAngle {
  angle: string;
  label: string;
  error: string | null;
}

/**
 * Trích danh sách góc lỗi từ result của worker.
 * Nhận `unknown` vì payload SSE không được type chặt.
 */
export function extractFailedAngles(result: unknown): FailedAngle[] {
  if (!result || typeof result !== "object") return [];
  const results = (result as { results?: unknown }).results;
  if (!Array.isArray(results)) return [];
  return results
    .filter(
      (r): r is { angle: string; status: string; error?: string } =>
        !!r &&
        typeof r === "object" &&
        typeof (r as { angle?: unknown }).angle === "string" &&
        (r as { status?: unknown }).status !== "success"
    )
    .map((r) => ({
      angle: r.angle,
      label: ANGLE_VI_LABELS[r.angle] ?? r.angle,
      error: typeof r.error === "string" ? r.error : null,
    }));
}

/**
 * Ghép thông báo chi tiết: "Góc Quay phải lỗi: Ảnh quá mờ...; Góc Cúi xuống lỗi: ..."
 * để thủ thư biết chính xác khung nào cần chụp lại.
 */
export function buildAngleErrorMessage(failed: FailedAngle[], fallback: string): string {
  if (failed.length === 0) return fallback;
  return failed
    .map((f) => `Góc ${f.label} lỗi: ${mapEnrollError(f.error, "không đạt yêu cầu")}`)
    .join("; ");
}
</file>

<file path="src/lib/fee-estimate.ts">
export interface FineBracket {
  from: number;
  to: number | null;
  amount: number;
}

export interface FineConfigDto {
  fine_brackets?: FineBracket[];
  fine_per_day?: number;
  damage_fee_pct?: { minor: number; major: number; lost: number };
  damage_fee_fixed?: { minor: number; major: number; lost: number };
  fallback_book_price?: number;
  fine_lock_threshold_days?: number;
}

export function estimateOverdueFine(overdueDays: number, fine?: FineConfigDto | null): number {
  if (overdueDays <= 0) return 0;

  const brackets = fine?.fine_brackets;
  const finePerDay = (fine?.fine_per_day ?? 5000) as number;

  if (brackets && brackets.length > 0) {
    for (const b of brackets) {
      const from = Number(b.from);
      const to = b.to === null || b.to === undefined ? Infinity : Number(b.to);
      if (overdueDays >= from && overdueDays <= to) return Number(b.amount);
    }
    const lastBracket = brackets[brackets.length - 1];
    if (lastBracket.to === null || lastBracket.to === undefined) return Number(lastBracket.amount);
    if (finePerDay > 0) return overdueDays * finePerDay;
    return Number(lastBracket.amount);
  }

  if (overdueDays <= 7) return 10000;
  if (overdueDays <= 14) return 20000;
  if (overdueDays <= 30) return 50000;
  return 100000;
}

export function estimateDamageFee(
  condition: string | null | undefined,
  priceVnd: number | null | undefined,
  fine?: FineConfigDto | null,
): number {
  const pct = fine?.damage_fee_pct ?? { minor: 30, major: 70, lost: 100 };
  const fixed = fine?.damage_fee_fixed ?? { minor: 5000, major: 10000, lost: 10000 };
  const fallback = fine?.fallback_book_price ?? 100000;
  const effectivePrice = priceVnd !== null && priceVnd !== undefined && Number(priceVnd) > 0 ? Number(priceVnd) : fallback;

  switch (condition) {
    case "minor_damage":
      return Math.round(effectivePrice * pct.minor / 100) + fixed.minor;
    case "major_damage":
      return Math.round(effectivePrice * pct.major / 100) + fixed.major;
    case "lost":
      return Math.round(effectivePrice * pct.lost / 100) + fixed.lost;
    default:
      return 0;
  }
}
</file>

<file path="src/lib/image-quality.ts">
/**
 * Kiểm tra chất lượng ảnh chụp từng góc (client-side quality gate).
 * Mục tiêu: ảnh mờ/thiếu sáng bị chặn ngay tại góc đó, không cho qua bước
 * kế tiếp — tránh phải chụp lại hàng loạt ở cuối như trước.
 *
 * Thuật toán:
 * - Độ nét: phương sai Laplacian (variance of Laplacian) trên ảnh xám.
 *   Ảnh nét có nhiều biên → phương sai cao; ảnh mờ/nhòe → thấp.
 * - Độ sáng: giá trị trung bình kênh sáng, chặn quá tối / cháy sáng.
 */

export const QUALITY_THRESHOLDS = {
  /** Phương sai Laplacian tối thiểu (ảnh webcam 640px). Tăng nếu lọt ảnh mờ. */
  blur: 80,
  /** Độ sáng trung bình tối thiểu (0-255). */
  minBrightness: 40,
  /** Độ sáng trung bình tối đa (0-255). */
  maxBrightness: 220,
};

export interface QualityMetrics {
  blurVariance: number;
  brightness: number;
}

export interface QualityVerdict {
  ok: boolean;
  reason: string | null;
}

/**
 * Phương sai của Laplacian (kernel 4-neighbour) trên mảng xám row-major.
 */
export function varianceOfLaplacian(
  gray: ArrayLike<number>,
  width: number,
  height: number
): number {
  if (width < 3 || height < 3 || gray.length < width * height) return 0;
  let sum = 0;
  let sumSq = 0;
  let n = 0;
  const at = (x: number, y: number) => gray[y * width + x];
  for (let y = 1; y < height - 1; y++) {
    for (let x = 1; x < width - 1; x++) {
      const lap = 4 * at(x, y) - at(x - 1, y) - at(x + 1, y) - at(x, y - 1) - at(x, y + 1);
      sum += lap;
      sumSq += lap * lap;
      n++;
    }
  }
  if (n === 0) return 0;
  const mean = sum / n;
  return sumSq / n - mean * mean;
}

/** Độ sáng trung bình 0-255. */
export function meanBrightness(
  gray: ArrayLike<number>,
  width: number,
  height: number
): number {
  const total = Math.min(gray.length, width * height);
  if (total === 0) return 0;
  let sum = 0;
  for (let i = 0; i < total; i++) sum += gray[i];
  return sum / total;
}

/** Kết luận đạt/không đạt kèm lý do tiếng Việt cho thủ thư. */
export function assessCaptureQuality(metrics: QualityMetrics): QualityVerdict {
  if (metrics.blurVariance < QUALITY_THRESHOLDS.blur) {
    return {
      ok: false,
      reason: "Ảnh bị mờ, vui lòng giữ yên điện thoại và chụp lại",
    };
  }
  if (metrics.brightness < QUALITY_THRESHOLDS.minBrightness) {
    return {
      ok: false,
      reason: "Ảnh quá tối, vui lòng chụp ở nơi đủ sáng",
    };
  }
  if (metrics.brightness > QUALITY_THRESHOLDS.maxBrightness) {
    return {
      ok: false,
      reason: "Ảnh bị cháy sáng, vui lòng tránh ngược sáng",
    };
  }
  return { ok: true, reason: null };
}
</file>

<file path="src/lib/image-utils.ts">
const MAX_DIMENSION = 1280;
const JPEG_QUALITY = 0.85;

export interface DownscaleOptions {
  maxDimension?: number;
  quality?: number;
}

export async function downscaleImage(
  file: File,
  options: DownscaleOptions = {},
): Promise<Blob> {
  const { maxDimension = MAX_DIMENSION, quality = JPEG_QUALITY } = options;

  const img = await loadImage(file);
  const { width, height } = computeDimensions(
    img.naturalWidth,
    img.naturalHeight,
    maxDimension,
  );

  const canvas = document.createElement('canvas');
  canvas.width = width;
  canvas.height = height;

  const ctx = canvas.getContext('2d');
  if (!ctx) throw new Error('Failed to get canvas 2D context');

  ctx.drawImage(img, 0, 0, width, height);

  return new Promise<Blob>((resolve, reject) => {
    canvas.toBlob(
      (blob) => {
        if (blob) resolve(blob);
        else reject(new Error('Canvas toBlob returned null'));
      },
      'image/jpeg',
      quality,
    );
  });
}

export async function downscaleImageToFile(
  file: File,
  options: DownscaleOptions = {},
): Promise<File> {
  const blob = await downscaleImage(file, options);
  return new File([blob], file.name.replace(/\.[^.]+$/, '.jpg'), {
    type: 'image/jpeg',
    lastModified: Date.now(),
  });
}

function loadImage(file: File): Promise<HTMLImageElement> {
  return new Promise((resolve, reject) => {
    const img = new Image();
    img.onload = () => {
      URL.revokeObjectURL(img.src);
      resolve(img);
    };
    img.onerror = () => reject(new Error('Failed to load image'));
    img.src = URL.createObjectURL(file);
  });
}

export function computeDimensions(
  originalWidth: number,
  originalHeight: number,
  maxDimension: number,
): { width: number; height: number } {
  if (originalWidth <= maxDimension && originalHeight <= maxDimension) {
    return { width: originalWidth, height: originalHeight };
  }
  const ratio = Math.min(maxDimension / originalWidth, maxDimension / originalHeight);
  return {
    width: Math.round(originalWidth * ratio),
    height: Math.round(originalHeight * ratio),
  };
}
</file>

