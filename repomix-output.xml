    border-color: #2E3345;
  }
  .btn-secondary:hover {
    background-color: #2C3042;
    border-color: #3A4052;
  }
  .btn-ghost {
    @apply btn bg-transparent px-3 py-2;
    color: #B8B0A4;
  }
  .btn-ghost:hover {
    background-color: #242838;
    color: #EDE8DF;
  }
  .btn-danger {
    @apply btn px-4 py-2.5 active:scale-[0.98];
    background-color: rgba(196, 78, 78, 0.1);
    color: #C44E4E;
    border: 1px solid rgba(196, 78, 78, 0.2);
  }
  .btn-danger:hover {
    background-color: rgba(196, 78, 78, 0.2);
  }

  /* Input styles */
  .input {
    @apply w-full bg-surface-2 border border-border rounded-md px-3 py-2.5 text-body-md text-text placeholder:text-text-3 transition-colors focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary/30;
  }

  /* Badge styles */
  .badge {
    @apply inline-flex items-center gap-1 px-2 py-0.5 rounded-sm text-body-sm font-medium;
  }
  .badge-success {
    @apply badge bg-success/15 text-success;
  }
  .badge-error {
    @apply badge bg-error/15 text-error;
  }
  .badge-warning {
    @apply badge bg-warning/15 text-warning;
  }
  .badge-info {
    @apply badge bg-info/15 text-info;
  }
  .badge-neutral {
    @apply badge bg-surface-2 text-text-2;
  }

  /* Nav item */
  .nav-item {
    @apply flex items-center gap-3 px-3 py-2.5 rounded-md text-body-md text-text transition-all duration-150 hover:bg-surface-2 hover:text-text cursor-pointer;
  }
  .nav-item-active {
    @apply nav-item bg-primary/10 text-primary border-l-[3px] border-primary;
  }

  /* Table styles */
  .table-container {
    @apply overflow-x-auto rounded-lg border border-border;
  }
  .table {
    @apply w-full text-body-sm;
  }
  .table th {
    @apply text-label px-4 py-3 text-left bg-surface-2 border-b border-border;
  }
  .table td {
    @apply px-4 py-3 border-b border-border last:border-b-0;
  }
  .table tr {
    @apply transition-colors hover:bg-surface-2/50;
  }
  .table tr:hover td {
    @apply bg-surface-2/50;
  }

  /* Stat card */
  .stat-card {
    @apply card-elevated relative overflow-hidden;
  }
  .stat-card::before {
    content: '';
    @apply absolute top-0 left-0 w-1 h-full;
  }

  /* Surface variants */
  .surface {
    @apply bg-surface;
  }
  .surface-2 {
    @apply bg-surface-2;
  }
  .surface-3 {
    @apply bg-surface-3;
  }
}

@layer base {
  /* Focus visible styles */
  *:focus-visible {
    @apply outline-none ring-2 ring-primary/50 ring-offset-2 ring-offset-bg;
  }

  /* Selection color */
  ::selection {
    background: rgba(26, 115, 232, 0.3);
    color: #EDE8DF;
  }
}

/* Shimmer loading animation */
.shimmer {
  background: linear-gradient(
    90deg,
    #1C2030 0%,
    #242838 50%,
    #1C2030 100%
  );
  background-size: 200% 100%;
  animation: shimmer 1.5s ease-in-out infinite;
}

/* Toast container positioning */
.toast-container {
  position: fixed;
  top: 16px;
  right: 16px;
  z-index: 9999;
  display: flex;
  flex-direction: column;
  gap: 8px;
  pointer-events: none;
}

.toast-container > * {
  pointer-events: auto;
}

/* Print styles - only show schedule table */
@media print {
  body {
    background: white !important;
    color: black !important;
    -webkit-print-color-adjust: exact;
    print-color-adjust: exact;
  }

  /* Hide everything except table and print-only header */
  nav,
  header,
  header nav,
  [class*="sidebar"],
  [class*="drawer"],
  button,
  .print\:hidden {
    display: none !important;
  }

  /* Show print-only header */
  .hidden.print\:block {
    display: block !important;
  }

  /* Page setup for landscape A4 */
  @page {
    size: landscape A4;
    margin: 8mm;
  }

  /* Ensure grid fits on page */
  .dot-grid-bg {
    font-size: 11px;
    overflow-x: visible !important;
    page-break-inside: avoid;
  }

  .dot-grid-bg > div {
    min-width: fit-content !important;
  }

  .dot-grid-bg {
    border: 1px solid #ccc !important;
  }

  .dot-grid-bg > div > div {
    border: 1px solid #ccc !important;
  }

  .dot-grid-bg > div > div.bg-surface {
    background: white !important;
  }

  ::-webkit-scrollbar {
    display: none !important;
  }

  /* Keep table visible in print */
  .space-y-5 .dot-grid-bg {
    display: grid !important;
  }
}
</file>

