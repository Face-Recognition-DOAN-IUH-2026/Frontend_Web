<file path="src/app/(dashboard)/active/page.tsx">
"use client";

import React, { useCallback, useEffect, useMemo, useRef, useState } from "react";
import {
  Alert,
  Avatar,
  Box,
  Button,
  Chip,
  CircularProgress,
  Dialog,
  DialogActions,
  DialogContent,
  DialogTitle,
  Grid,
  IconButton,
  InputAdornment,
  Paper,
  Snackbar,
  Stack,
  TextField,
  Tooltip,
  Typography,
  useTheme,
} from "@mui/material";
import AccessTimeOutlinedIcon from "@mui/icons-material/AccessTimeOutlined";
import DoorFrontOutlinedIcon from "@mui/icons-material/DoorFrontOutlined";
import ExitToAppOutlinedIcon from "@mui/icons-material/ExitToAppOutlined";
import GroupsOutlinedIcon from "@mui/icons-material/GroupsOutlined";
import LocationOnOutlinedIcon from "@mui/icons-material/LocationOnOutlined";
import MenuBookOutlinedIcon from "@mui/icons-material/MenuBookOutlined";
import RefreshOutlinedIcon from "@mui/icons-material/RefreshOutlined";
import SearchOutlinedIcon from "@mui/icons-material/SearchOutlined";
import TerminalOutlinedIcon from "@mui/icons-material/TerminalOutlined";
import LogoutIcon from "@mui/icons-material/LogoutOutlined";
import api, { getErrorMessage } from "@/lib/api-client";
import { fadeInUp, shimmer, slideInRight, successPop } from "@/lib/animations";
import type { ActivePatron, CameraEvent } from "@/lib/types";

const ACTIVE_CAMERA_IDS = new Set(["entry_gate", "exit_gate", "kiosk"]);

const CAMERA_CONFIG: Record<string, { label: string; icon: React.ElementType }> = {
  entry_gate: { label: "Cổng vào", icon: DoorFrontOutlinedIcon },
  exit_gate: { label: "Cổng ra", icon: ExitToAppOutlinedIcon },
  kiosk: { label: "Kiosk", icon: TerminalOutlinedIcon },
};

function formatTime(value: string) {
  return new Date(value).toLocaleTimeString("vi-VN", {
    hour: "2-digit",
    minute: "2-digit",
  });
}

function getDuration(value: string) {
  const diffMs = Date.now() - new Date(value).getTime();
  const minutes = Math.max(0, Math.floor(diffMs / 60000));
  if (minutes < 1) return { text: "Vừa vào", level: 0 as const };
  if (minutes < 60) return { text: `${minutes} phút`, level: 1 as const };
  const hours = Math.floor(minutes / 60);
  const rest = minutes % 60;
  if (hours < 2) return { text: rest ? `${hours} giờ ${rest} phút` : `${hours} giờ`, level: 2 as const };
  return { text: rest ? `${hours} giờ ${rest} phút` : `${hours} giờ`, level: 3 as const };
}

const DURATION_ACCENT: Record<number, string> = {
  0: "#4A8C5C",
  1: "#4A8C5C",
  2: "#C49A3C",
  3: "#B85C4A",
};

function initials(name?: string) {
  const parts = (name || "").trim().split(/\s+/).filter(Boolean);
  if (parts.length === 0) return "?";
  if (parts.length === 1) return parts[0].charAt(0).toUpperCase();
  return `${parts[0].charAt(0)}${parts[parts.length - 1].charAt(0)}`.toUpperCase();
}

function normalizeQuery(value: string) {
  return value.trim().toLowerCase();
}

export default function ActivePage() {
  const theme = useTheme();
  const isDark = theme.palette.mode === "dark";
  const [patrons, setPatrons] = useState<ActivePatron[]>([]);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState<string | null>(null);
  const [search, setSearch] = useState("");
  const [lastUpdate, setLastUpdate] = useState<Date>(new Date());
  const [exitPatron, setExitPatron] = useState<ActivePatron | null>(null);
  const [exiting, setExiting] = useState(false);
  const [snackbar, setSnackbar] = useState<{ severity: "success" | "error"; message: string } | null>(null);
  const [sseConnected, setSseConnected] = useState(false);
  const hasLoadedRef = useRef(false);
  const fallbackRef = useRef<ReturnType<typeof setInterval> | null>(null);

  const load = useCallback(async () => {
    try {
      setError(null);
      const data = await api.getActivePatrons();
      const allowed = data.items
        .filter((p) => ACTIVE_CAMERA_IDS.has(p.camera_id))
        .sort((a, b) => new Date(b.entered_at).getTime() - new Date(a.entered_at).getTime());
      setPatrons(allowed);
      setLastUpdate(new Date());
      hasLoadedRef.current = true;
    } catch {
      setError("Không thể tải danh sách độc giả.");
    } finally {
      setLoading(false);
    }
  }, []);

  const handleSSEEvent = useCallback((event: CameraEvent) => {
    if (!event.access_type || !event.patron_id) return;
    if (!ACTIVE_CAMERA_IDS.has(event.camera_id)) return;

    if (event.access_type === "entry" && event.status === "granted") {
      setPatrons((prev) => {
        if (prev.some((p) => p.id === event.patron_id)) return prev;
        const newPatron: ActivePatron = {
          id: event.patron_id!,
          full_name: event.full_name || event.student_code || "",
          student_code: event.student_code || "",
          entered_at: new Date().toISOString(),
          camera_id: event.camera_id,
          image_url: null,
          confidence: event.score ?? null,
        };
        return [newPatron, ...prev];
      });
      setLastUpdate(new Date());
    } else if (event.access_type === "exit" && event.status === "granted") {
      setPatrons((prev) => prev.filter((p) => p.id !== event.patron_id));
      setLastUpdate(new Date());
    }
  }, []);

  const startFallbackPolling = useCallback(() => {
    if (fallbackRef.current) clearInterval(fallbackRef.current);
    fallbackRef.current = setInterval(() => {
      if (!hasLoadedRef.current) return;
      load();
    }, 60000);
  }, [load]);

  const stopFallbackPolling = useCallback(() => {
    if (fallbackRef.current) {
      clearInterval(fallbackRef.current);
      fallbackRef.current = null;
    }
  }, []);

  useEffect(() => {
    load();

    const cleanup = api.connectAccessSSE(handleSSEEvent, (connected) => {
      setSseConnected(connected);
      if (connected) {
        stopFallbackPolling();
      } else {
        startFallbackPolling();
      }
    });

    startFallbackPolling();

    return () => {
      cleanup();
      stopFallbackPolling();
    };
  }, [handleSSEEvent, load, startFallbackPolling, stopFallbackPolling]);

  const q = normalizeQuery(search);
  const filtered = useMemo(() => {
    if (!q) return patrons;
    return patrons.filter((p) =>
      p.full_name.toLowerCase().includes(q) || p.student_code.toLowerCase().includes(q)
    );
  }, [patrons, search]);

  const cameraCounts = useMemo(() =>
    patrons.reduce<Record<string, number>>((acc, p) => {
      acc[p.camera_id] = (acc[p.camera_id] || 0) + 1;
      return acc;
    }, {}),
    [patrons]
  );

  const stalePatrons = useMemo(() => {
    const now = Date.now();
    return patrons.filter((p) => {
      const hours = (now - new Date(p.entered_at).getTime()) / (1000 * 60 * 60);
      return hours > 8;
    });
  }, [patrons]);

  const handleForceExit = async () => {
    if (!exitPatron) return;
    setExiting(true);
    try {
      await api.forceExitPatron(exitPatron.id);
      setSnackbar({ severity: "success", message: `Đã đánh dấu ${exitPatron.full_name || exitPatron.student_code} đã ra` });
      setExitPatron(null);
      await load();
    } catch (err) {
      setSnackbar({ severity: "error", message: getErrorMessage(err) || "Lỗi khi đánh dấu ra" });
    } finally {
      setExiting(false);
    }
  };

  return (
    <Stack spacing={3}>
      {/* Header — hero count + camera breakdown */}
      <Paper variant="outlined" sx={{ borderRadius: 3, overflow: "hidden" }}>
        <Box sx={{ p: { xs: 2.5, sm: 3 } }}>
          <Grid container spacing={3} sx={{ alignItems: "flex-end" }}>
            <Grid size={{ xs: 12, md: 5 }}>
              <Stack spacing={1}>
                <Typography
                  variant="caption"
                  sx={{
                    fontWeight: 700,
                    letterSpacing: 1.5,
                    textTransform: "uppercase",
                    color: "text.secondary",
                  }}
                >
                  Hiện tại
                </Typography>
                <Stack direction="row" spacing={1} sx={{ alignItems: "baseline" }}>
                  <Typography
                    variant="h2"
                    sx={{
                      fontWeight: 900,
                      letterSpacing: { xs: -1, sm: -2 },
                      lineHeight: 1,
                      fontSize: { xs: "3rem", sm: "3.75rem" },
                    }}
                  >
                    {patrons.length}
                  </Typography>
                  <Typography variant="h6" sx={{ fontWeight: 500, color: "text.secondary" }}>
                    độc giả
                  </Typography>
                </Stack>
                <Typography variant="body2" color="text.secondary" sx={{ maxWidth: 360 }}>
                  Danh sách độc giả đang ở trong thư viện, cập nhật từ hệ thống cổng và kiosk.
                </Typography>
              </Stack>
            </Grid>
            <Grid size={{ xs: 12, md: 7 }}>
              <Stack spacing={2}>
                <Stack direction="row" spacing={1.5} sx={{ flexWrap: "wrap" }}>
                  {Object.entries(CAMERA_CONFIG).map(([id, cfg]) => {
                    const Icon = cfg.icon as React.ComponentType<{ fontSize?: string; sx?: object }>;
                    return (
                      <Paper
                        key={id}
                        variant="outlined"
                        sx={{
                          flex: { xs: "1 1 100%", sm: "1 1 0" },
                          minWidth: 0,
                          p: 1.5,
                          display: "flex",
                          alignItems: "center",
                          gap: 1.5,
                          borderRadius: 2,
                          background: "transparent",
                        }}
                      >
                        <Box
                          sx={{
                            width: 36,
                            height: 36,
                            borderRadius: 1.5,
                            display: "flex",
                            alignItems: "center",
                            justifyContent: "center",
                            bgcolor: isDark ? "rgba(255,255,255,0.06)" : "rgba(0,0,0,0.04)",
                            color: "text.secondary",
                          }}
                        >
                          <Icon fontSize="small" />
                        </Box>
                        <Box sx={{ minWidth: 0 }}>
                          <Typography variant="caption" color="text.secondary" sx={{ fontWeight: 700, display: "block" }}>
                            {cfg.label}
                          </Typography>
                          <Typography variant="h6" sx={{ fontWeight: 800, lineHeight: 1.2 }}>
                            {cameraCounts[id] || 0}
                          </Typography>
                        </Box>
                      </Paper>
                    );
                  })}
                </Stack>
                <Stack
                  direction="row"
                  spacing={1}
                  sx={{ alignItems: "center", justifyContent: "space-between", flexWrap: "wrap", gap: 1 }}
                >
                  <Stack direction="row" spacing={1} sx={{ alignItems: "center" }}>
                    <Box
                      sx={{
                        width: 6,
                        height: 6,
                        borderRadius: "50%",
                        bgcolor: error ? "error.main" : sseConnected ? "success.main" : "warning.main",
                        animation: sseConnected ? "pulse 2s ease-in-out infinite" : undefined,
                      }}
                    />
                    <Typography variant="caption" color="text.secondary">
                      {error ? "Lỗi cập nhật" : sseConnected ? "Live" : "Polling"}
                      {` · ${lastUpdate.toLocaleTimeString("vi-VN")}`}
                    </Typography>
                  </Stack>
                  <Button size="small" variant="outlined" startIcon={<RefreshOutlinedIcon />} onClick={load} disabled={loading}>
                    Làm mới
                  </Button>
                </Stack>
              </Stack>
            </Grid>
          </Grid>
        </Box>
      </Paper>

      {stalePatrons.length > 0 && (
        <Alert severity="warning" sx={{ borderRadius: 2 }}>
          <Typography variant="subtitle2" sx={{ fontWeight: 700 }}>
            {stalePatrons.length} độc giả ở trong thư viện quá 8 giờ
          </Typography>
          <Typography variant="body2">
            Có thể gate không detect exit. Kiểm tra và sử dụng nút &ldquo;Đánh dấu đã ra&rdquo; nếu cần.
          </Typography>
        </Alert>
      )}

      {/* Patron list */}
      <Paper variant="outlined" sx={{ borderRadius: 3 }}>
        <Box sx={{ p: { xs: 2, sm: 2.5 } }}>
          {/* Search bar */}
          <Stack
            direction={{ xs: "column", sm: "row" }}
            spacing={2}
            sx={{ alignItems: { sm: "center" }, justifyContent: "space-between", mb: 2.5 }}
          >
            <Box>
              <Typography variant="h6" sx={{ fontWeight: 800 }}>
                Độc giả
              </Typography>
              <Typography color="text.secondary" variant="body2">
                {filtered.length} kết quả
              </Typography>
            </Box>
            <TextField
              value={search}
              onChange={(e) => setSearch(e.target.value)}
              placeholder="Tìm theo tên hoặc MSSV..."
              size="small"
              sx={{ width: { xs: "100%", sm: 320 } }}
              slotProps={{
                input: {
                  startAdornment: (
                    <InputAdornment position="start">
                      <SearchOutlinedIcon fontSize="small" />
                    </InputAdornment>
                  ),
                },
              }}
            />
          </Stack>

          {/* Content states */}
          {loading && patrons.length === 0 ? (
            <Stack sx={{ minHeight: 300, alignItems: "center", justifyContent: "center", gap: 2 }}>
              <CircularProgress size={28} sx={{ animation: `${shimmer} 1.5s ease-in-out infinite` }} />
              <Typography variant="body2" color="text.secondary">
                Đang tải...
              </Typography>
            </Stack>
          ) : patrons.length === 0 ? (
            <Stack
              sx={{
                minHeight: 300,
                alignItems: "center",
                justifyContent: "center",
                gap: 1.5,
                py: 6,
              }}
            >
              <Box
                sx={{
                  width: 64,
                  height: 64,
                  borderRadius: 3,
                  display: "flex",
                  alignItems: "center",
                  justifyContent: "center",
                  bgcolor: isDark ? "rgba(255,255,255,0.04)" : "rgba(0,0,0,0.04)",
                  color: "text.disabled",
                  mb: 1,
                }}
              >
                <MenuBookOutlinedIcon sx={{ fontSize: 32 }} />
              </Box>
              <Typography variant="h6" sx={{ fontWeight: 700, color: "text.secondary" }}>
                Thư viện đang yên tĩnh
              </Typography>
              <Typography variant="body2" color="text.disabled" sx={{ textAlign: "center", maxWidth: 360 }}>
                Chưa có độc giả nào trong thư viện. Danh sách sẽ tự động cập nhật khi có lượt vào hợp lệ.
              </Typography>
            </Stack>
          ) : filtered.length === 0 ? (
            <Stack
              sx={{
                minHeight: 200,
                alignItems: "center",
                justifyContent: "center",
                gap: 1.5,
                py: 4,
              }}
            >
              <SearchOutlinedIcon sx={{ fontSize: 36, color: "text.disabled" }} />
              <Typography variant="body1" color="text.secondary">
                Không tìm thấy độc giả &ldquo;{search}&rdquo;
              </Typography>
            </Stack>
          ) : (
            <Grid container spacing={1.5}>
              {filtered.map((patron, idx) => {
                const dur = getDuration(patron.entered_at);
                const accent = DURATION_ACCENT[dur.level];
                const percent = patron.confidence == null ? null : Math.round(patron.confidence * 100);
                return (
                  <Grid key={patron.id} size={{ xs: 12, xl: 6 }} sx={{ animation: `${fadeInUp} 0.35s ease-out`, animationDelay: `${idx * 0.05}s`, animationFillMode: "both" }}>
                    <Paper
                      variant="outlined"
                      sx={{
                        borderRadius: 2,
                        overflow: "hidden",
                        position: "relative",
                        transition: "box-shadow 0.15s",
                        "&:hover": {
                          boxShadow: theme.shadows[2],
                        },
                      }}
                    >
                      {/* Duration accent bar — like a book spine */}
                      <Box
                        sx={{
                          position: "absolute",
                          left: 0,
                          top: 0,
                          bottom: 0,
                          width: 3,
                          bgcolor: accent,
                          opacity: 0.7,
                        }}
                      />

                      <Box sx={{ pl: 2.5, pr: 2, py: 1.5 }}>
                        <Stack direction="row" spacing={1.5} sx={{ alignItems: "flex-start" }}>
                          <Avatar
                            sx={{
                              width: 36,
                              height: 36,
                              fontSize: 13,
                              fontWeight: 700,
                              bgcolor: isDark ? "rgba(255,255,255,0.08)" : "rgba(0,0,0,0.06)",
                              color: "text.primary",
                            }}
                          >
                            {initials(patron.full_name)}
                          </Avatar>
                          <Box sx={{ minWidth: 0, flex: 1 }}>
                            <Stack
                              direction="row"
                              spacing={1}
                              sx={{ justifyContent: "space-between", alignItems: "flex-start" }}
                            >
                              <Box sx={{ minWidth: 0 }}>
                                <Typography noWrap sx={{ fontWeight: 700, fontSize: 14 }}>
                                  {patron.full_name || "Chưa có tên"}
                                </Typography>
                                <Typography
                                  variant="caption"
                                  color="text.secondary"
                                  sx={{ fontFamily: "monospace", fontSize: 12 }}
                                >
                                  {patron.student_code}
                                </Typography>
                              </Box>
                              <Stack direction="row" spacing={0.5} sx={{ alignItems: "center", flexShrink: 0 }}>
                                {percent != null && (
                                  <Tooltip title={`Độ chính xác: ${percent}%`}>
                                    <Box
                                      sx={{
                                        width: 8,
                                        height: 8,
                                        borderRadius: "50%",
                                        bgcolor:
                                          percent >= 80 ? "success.main" : percent >= 60 ? "warning.main" : "error.main",
                                      }}
                                    />
                                  </Tooltip>
                                )}
                                <Box
                                  sx={{
                                    px: 1,
                                    py: 0.25,
                                    borderRadius: 0.75,
                                    bgcolor:
                                      dur.level <= 1
                                        ? isDark ? "rgba(74,140,92,0.15)" : "rgba(74,140,92,0.1)"
                                        : dur.level === 2
                                          ? isDark ? "rgba(196,154,60,0.15)" : "rgba(196,154,60,0.1)"
                                          : isDark ? "rgba(184,92,74,0.15)" : "rgba(184,92,74,0.1)",
                                  }}
                                >
                                  <Typography
                                    variant="caption"
                                    sx={{ fontWeight: 700, fontSize: 11, color: accent, whiteSpace: "nowrap" }}
                                  >
                                    {dur.text}
                                  </Typography>
                                </Box>
                              </Stack>
                            </Stack>

                            <Stack direction="row" spacing={2} sx={{ mt: 1, flexWrap: "wrap", rowGap: 0.5 }}>
                              <Stack direction="row" spacing={0.5} sx={{ alignItems: "center" }}>
                                <AccessTimeOutlinedIcon sx={{ fontSize: 13, color: "text.disabled" }} />
                                <Typography variant="caption" color="text.secondary" sx={{ fontSize: 12 }}>
                                  {formatTime(patron.entered_at)}
                                </Typography>
                              </Stack>
                              <Stack direction="row" spacing={0.5} sx={{ alignItems: "center" }}>
                                <LocationOnOutlinedIcon sx={{ fontSize: 13, color: "text.disabled" }} />
                                <Typography variant="caption" color="text.secondary" sx={{ fontSize: 12 }}>
                                  {CAMERA_CONFIG[patron.camera_id]?.label || patron.camera_id}
                                </Typography>
                              </Stack>
                            </Stack>
                          </Box>
                          <Tooltip title="Đánh dấu đã ra">
                            <IconButton
                              size="small"
                              color="warning"
                              onClick={() => setExitPatron(patron)}
                              sx={{ flexShrink: 0, mt: 0.5 }}
                            >
                              <LogoutIcon fontSize="small" />
                            </IconButton>
                          </Tooltip>
                        </Stack>
                      </Box>
                    </Paper>
                  </Grid>
                );
              })}
            </Grid>
          )}
        </Box>
      </Paper>

      <Dialog open={!!exitPatron} onClose={() => !exiting && setExitPatron(null)} maxWidth="xs" fullWidth>
        <DialogTitle sx={{ fontWeight: 900 }}>Xác nhận đánh dấu đã ra?</DialogTitle>
        <DialogContent>
          <Typography>
            Độc giả <strong>{exitPatron?.full_name || exitPatron?.student_code}</strong> sẽ được đánh dấu đã rời khỏi thư viện.
          </Typography>
          <Typography variant="body2" color="text.secondary" sx={{ mt: 1 }}>
            Dùng khi gate không detect được exit.
          </Typography>
        </DialogContent>
        <DialogActions>
          <Button onClick={() => setExitPatron(null)} disabled={exiting}>Hủy</Button>
          <Button variant="contained" color="warning" onClick={handleForceExit} disabled={exiting}>
            {exiting ? "Đang xử lý..." : "Đánh dấu đã ra"}
          </Button>
        </DialogActions>
      </Dialog>

      <Snackbar open={!!snackbar} autoHideDuration={3000} onClose={() => setSnackbar(null)} anchorOrigin={{ vertical: "top", horizontal: "right" }}>
        {snackbar ? (
          <Alert severity={snackbar.severity} onClose={() => setSnackbar(null)}>
            {snackbar.message}
          </Alert>
        ) : undefined}
      </Snackbar>
    </Stack>
  );
}
</file>

<file path="src/app/(dashboard)/enroll/page.tsx">
"use client";

import { useEffect, useRef, useState } from "react";
import {
  Alert,
  Box,
  Button,
  Card,
  CardContent,
  Chip,
  CircularProgress,
  Divider,
  Paper,
  Stack,
  Typography,
} from "@mui/material";
import CheckCircleOutlineOutlinedIcon from "@mui/icons-material/CheckCircleOutlineOutlined";
import ErrorOutlineOutlinedIcon from "@mui/icons-material/ErrorOutlineOutlined";
import FaceRetouchingNaturalOutlinedIcon from "@mui/icons-material/FaceRetouchingNaturalOutlined";
import RestartAltOutlinedIcon from "@mui/icons-material/RestartAltOutlined";
import api, { getErrorMessage } from "@/lib/api-client";
import { shimmer } from "@/lib/animations";
import MultiAngleCapture, { type CaptureAngle } from "@/components/MultiAngleCapture";

export default function EnrollPage() {
  const [consent, setConsent] = useState(false);
  const [isLoading, setIsLoading] = useState(false);
  const [jobId, setJobId] = useState<string | null>(null);
  const [result, setResult] = useState<any>(null);
  const [error, setError] = useState("");
  const pollIntervalRef = useRef<ReturnType<typeof setInterval> | null>(null);

  useEffect(() => {
    return () => {
      if (pollIntervalRef.current) clearInterval(pollIntervalRef.current);
    };
  }, []);

  const pollForResult = async (taskId: string) => {
    if (pollIntervalRef.current) clearInterval(pollIntervalRef.current);
    pollIntervalRef.current = setInterval(async () => {
      try {
        const data = await api.getTaskStatus(taskId);
        if (data.status === "SUCCESS") {
          if (pollIntervalRef.current) clearInterval(pollIntervalRef.current);
          const inner = data.result;
          if (inner?.status === "error") setError(inner.error || "Đăng ký thất bại.");
          setResult(inner);
          setIsLoading(false);
        } else if (data.status === "FAILURE") {
          if (pollIntervalRef.current) clearInterval(pollIntervalRef.current);
          setError(data.result?.error || "Đăng ký thất bại.");
          setResult(data.result);
          setIsLoading(false);
        }
      } catch {
        if (pollIntervalRef.current) clearInterval(pollIntervalRef.current);
        setError("Không thể lấy trạng thái tác vụ.");
        setIsLoading(false);
      }
    }, 2000);
  };

  const handleFilesReady = async (files: Record<CaptureAngle, File>) => {
    setError("");
    setIsLoading(true);
    setJobId(null);
    setResult(null);
    try {
      const data = await api.enrollBatch(files, consent);
      setJobId(data.job_id);
      await pollForResult(data.job_id);
    } catch (err: any) {
      setError(getErrorMessage(err) || "Đăng ký nhiều góc thất bại.");
      setIsLoading(false);
    }
  };

  const handleReset = () => {
    setConsent(false);
    setJobId(null);
    setResult(null);
    setError("");
    setIsLoading(false);
  };

  const failedCount = result?.results?.filter((item: any) => item.status !== "success").length || 0;
  const success = result && result.status !== "error";

  return (
    <Stack spacing={3} sx={{ maxWidth: 920, mx: "auto" }}>
      <Paper variant="outlined" sx={{ p: 3 }}>
        <Stack direction="row" spacing={1.5} sx={{ alignItems: "center" }}>
          <FaceRetouchingNaturalOutlinedIcon color="primary" />
          <Box>
            <Typography variant="h4" sx={{ fontWeight: 850 }}>Đăng ký khuôn mặt</Typography>
            <Typography color="text.secondary">Chụp đủ 4 góc để hệ thống tạo hồ sơ nhận diện ổn định hơn.</Typography>
          </Box>
        </Stack>
      </Paper>

      {error && <Alert icon={<ErrorOutlineOutlinedIcon />} severity="error">{error}</Alert>}

      {result ? (
        <Card variant="outlined">
          <CardContent>
            <Stack spacing={2.5}>
              <Stack direction="row" spacing={1.5} sx={{ alignItems: "center" }}>
                {success ? <CheckCircleOutlineOutlinedIcon color="success" sx={{ fontSize: 44 }} /> : <ErrorOutlineOutlinedIcon color="error" sx={{ fontSize: 44 }} />}
                <Box>
                  <Typography variant="h5" sx={{ fontWeight: 850 }}>
                    {success ? "Đăng ký thành công" : "Đăng ký thất bại một phần"}
                  </Typography>
                  <Typography color="text.secondary">
                    {success ? "Khuôn mặt đã được ghi nhận vào hệ thống." : `${failedCount} góc ảnh chưa đạt yêu cầu.`}
                  </Typography>
                </Box>
              </Stack>

              {result.results && (
                <>
                  <Divider />
                  <Stack spacing={1}>
                    <Typography variant="overline" color="text.secondary">Kết quả từng góc</Typography>
                    {result.results.map((item: any, index: number) => (
                      <Stack key={`${item.angle}-${index}`} direction="row" sx={{ alignItems: "center", justifyContent: "space-between" }}>
                        <Typography sx={{ textTransform: "capitalize" }}>{item.angle}</Typography>
                        <Chip size="small" color={item.status === "success" ? "success" : "error"} label={item.status === "success" ? "Thành công" : "Thất bại"} />
                      </Stack>
                    ))}
                  </Stack>
                </>
              )}

              <Button variant="contained" startIcon={<RestartAltOutlinedIcon />} onClick={handleReset} sx={{ alignSelf: "flex-start" }}>
                {success ? "Đăng ký thêm" : "Thử lại"}
              </Button>
            </Stack>
          </CardContent>
        </Card>
      ) : jobId ? (
        <Paper variant="outlined" sx={{ p: 3, textAlign: "center" }}>
          <CircularProgress sx={{ animation: `${shimmer} 1.5s ease-in-out infinite` }} />
          <Typography variant="h6" sx={{ mt: 2, fontWeight: 800 }}>Đang xử lý...</Typography>
          <Typography color="text.secondary" sx={{ fontFamily: "monospace", wordBreak: "break-all" }}>Job ID: {jobId}</Typography>
        </Paper>
      ) : (
        <Paper variant="outlined" sx={{ p: 2.5 }}>
          <MultiAngleCapture consent={consent} setConsent={setConsent} onFilesReady={handleFilesReady} />
          {isLoading && <Alert severity="info" sx={{ mt: 2 }}>Đang gửi dữ liệu đăng ký...</Alert>}
        </Paper>
      )}
    </Stack>
  );
}
</file>

<file path="src/app/(dashboard)/stats/page.tsx">
"use client";

import { useCallback, useEffect, useMemo, useState } from "react";
import { Bar, BarChart, CartesianGrid, Legend, ResponsiveContainer, Tooltip, XAxis, YAxis } from "recharts";
import {
  Alert,
  Avatar,
  Box,
  Card,
  CardContent,
  Chip,
  CircularProgress,
  Divider,
  Paper,
  Stack,
  Table,
  TableBody,
  TableCell,
  TableContainer,
  TableHead,
  TableRow,
  Typography,
  useTheme,
} from "@mui/material";
import ActivityIcon from "@mui/icons-material/TimelineOutlined";
import AlertIcon from "@mui/icons-material/WarningAmberOutlined";
import BookIcon from "@mui/icons-material/MenuBookOutlined";
import CameraIcon from "@mui/icons-material/PhotoCameraOutlined";
import ChartIcon from "@mui/icons-material/BarChartOutlined";
import ClockIcon from "@mui/icons-material/ScheduleOutlined";
import LoginIcon from "@mui/icons-material/LoginOutlined";
import LogoutIcon from "@mui/icons-material/LogoutOutlined";
import RadioIcon from "@mui/icons-material/SettingsInputAntennaOutlined";
import UserIcon from "@mui/icons-material/HowToRegOutlined";
import UsersIcon from "@mui/icons-material/GroupsOutlined";
import api from "@/lib/api-client";
import { fadeInUp, shimmer, slideInRight, successPop } from "@/lib/animations";
import type { AccessLogPublic, ActivePatron, BorrowRecord, CameraEvent, StatsResponse } from "@/lib/types";

type RealtimeState = "connecting" | "connected" | "disconnected";

function toDateStr(d: Date) {
  return d.toISOString().split("T")[0];
}

function isPhysicalAccessLog(log: AccessLogPublic) {
  return ["entry_gate", "exit_gate", "kiosk"].includes(log.camera_id);
}

function formatCameraId(cameraId?: string | null) {
  if (!cameraId || !["entry_gate", "exit_gate", "kiosk"].includes(cameraId)) return "-";
  return cameraId;
}

function formatTime(value?: string) {
  if (!value) return "--:--";
  return new Date(value).toLocaleTimeString("vi-VN", { hour: "2-digit", minute: "2-digit", second: "2-digit" });
}

function formatShortTime(value?: string) {
  if (!value) return "--:--";
  return new Date(value).toLocaleTimeString("vi-VN", { hour: "2-digit", minute: "2-digit" });
}

function formatConfidence(value?: number | null) {
  if (typeof value !== "number") return "-";
  return `${Math.round(value * 100)}%`;
}

function buildAccessLogFromEvent(event: CameraEvent): AccessLogPublic {
  return {
    id: `${event.camera_id}-${event.patron_id || event.student_code || "unknown"}-${Date.now()}`,
    patron_id: event.patron_id || null,
    patron_name: event.full_name || null,
    student_code: event.student_code || null,
    access_type: event.access_type === "exit" ? "exit" : "entry",
    verify_method: "face",
    confidence: event.score ?? null,
    camera_id: event.camera_id,
    access_time: new Date().toISOString(),
    status: event.status,
  };
}

function AccessTypeChip({ type }: { type?: string }) {
  if (type === "entry") return <Chip size="small" color="success" label="Vào" />;
  if (type === "exit") return <Chip size="small" color="warning" label="Ra" />;
  return <Chip size="small" label={type || "?"} />;
}

function StatusChip({ status }: { status?: string }) {
  if (status === "success" || status === "granted") return <Chip size="small" color="success" label="Thành công" />;
  if (status === "no_match") return <Chip size="small" color="warning" label="Không khớp" />;
  if (status === "expired") return <Chip size="small" color="warning" label="Hết hạn" />;
  if (status === "spoof") return <Chip size="small" color="error" label="Giả mạo" />;
  if (status === "wrong_direction") return <Chip size="small" color="warning" label="Sai chiều" />;
  if (status === "already_granted") return <Chip size="small" color="info" label="Đã ghi nhận" />;
  return <Chip size="small" color="error" label={status === "denied" ? "Từ chối" : "Thất bại"} />;
}

function MetricCard({ label, value, description, icon: Icon, color }: any) {
  return (
    <Card variant="outlined">
      <CardContent>
        <Stack direction="row" sx={{ justifyContent: "space-between", alignItems: "center" }}>
          <Box>
            <Typography variant="caption" color="text.secondary" sx={{ fontWeight: 900 }}>{label}</Typography>
            <Typography variant="h4" sx={{ fontWeight: 900 }}>{value}</Typography>
            <Typography variant="caption" color="text.secondary">{description}</Typography>
          </Box>
          <Avatar sx={{ bgcolor: color, color: "primary.contrastText" }}>
            <Icon />
          </Avatar>
        </Stack>
      </CardContent>
    </Card>
  );
}

export default function StatsPage() {
  const theme = useTheme();
  const [stats, setStats] = useState<StatsResponse | null>(null);
  const [todayLogs, setTodayLogs] = useState<AccessLogPublic[]>([]);
  const [activePatrons, setActivePatrons] = useState<ActivePatron[]>([]);
  const [activeBorrows, setActiveBorrows] = useState<BorrowRecord[]>([]);
  const [borrowStats, setBorrowStats] = useState<{ total: number; active: number; overdue: number } | null>(null);
  const [loading, setLoading] = useState(true);
  const [realtimeState, setRealtimeState] = useState<RealtimeState>("connecting");

  const refreshActivePatrons = useCallback(async () => {
    try {
      const active = await api.getActivePatrons();
      setActivePatrons(active.items);
    } catch {
      // Keep old data visible when realtime refresh fails.
    }
  }, []);

  useEffect(() => {
    (async () => {
      try {
        const today = toDateStr(new Date());
        const [s, logs, active, bStats, allActive] = await Promise.all([
          api.getStats(),
          api.getAccessLogs({ dateFrom: today, limit: 200 }),
          api.getActivePatrons(),
          api.getBorrowStats(),
          api.getAllActiveBorrows(),
        ]);
        setStats(s);
        setTodayLogs(logs.items.filter(isPhysicalAccessLog));
        setActivePatrons(active.items);
        setBorrowStats(bStats);
        setActiveBorrows(allActive || []);
      } catch (err) {
        console.error("Failed to load stats:", err);
      } finally {
        setLoading(false);
      }
    })();
  }, []);

  useEffect(() => {
    setRealtimeState("connecting");
    const cleanup = api.connectAccessSSE(
      (event: CameraEvent) => {
        if (event.status !== "granted") return;
        const log = buildAccessLogFromEvent(event);
        if (!isPhysicalAccessLog(log)) return;
        setTodayLogs((prev) => [log, ...prev].slice(0, 200));
        setStats((prev) => prev ? {
          ...prev,
          today_entries: prev.today_entries + (log.access_type === "entry" ? 1 : 0),
          today_exits: prev.today_exits + (log.access_type === "exit" ? 1 : 0),
        } : prev);
        refreshActivePatrons();
      },
      (connected) => setRealtimeState(connected ? "connected" : "disconnected"),
    );
    return cleanup;
  }, [refreshActivePatrons]);

  const todayLabel = useMemo(() => new Date().toLocaleDateString("vi-VN", {
    weekday: "long",
    day: "2-digit",
    month: "2-digit",
    year: "numeric",
  }), []);

  const hourlyData = useMemo(() => {
    const buckets = Array.from({ length: 24 }, (_, hour) => ({ hour, entry: 0, exit: 0, total: 0 }));
    todayLogs.forEach((log) => {
      const hour = new Date(log.access_time).getHours();
      if (log.access_type === "entry") buckets[hour].entry += 1;
      if (log.access_type === "exit") buckets[hour].exit += 1;
      buckets[hour].total += 1;
    });
    return buckets;
  }, [todayLogs]);

  const hasHourlyData = hourlyData.some((item) => item.total > 0);

  const recentBorrows = useMemo(() => [...activeBorrows]
    .sort((a, b) => new Date(b.borrow_at).getTime() - new Date(a.borrow_at).getTime())
    .slice(0, 12), [activeBorrows]);

  if (loading) {
    return (
      <Box sx={{ minHeight: 420, display: "grid", placeItems: "center" }}>
        <Stack spacing={2} sx={{ alignItems: "center" }}>
          <CircularProgress sx={{ animation: `${shimmer} 1.5s ease-in-out infinite` }} />
          <Typography variant="body2" color="text.secondary">Đang tải thống kê vận hành...</Typography>
        </Stack>
      </Box>
    );
  }

  if (!stats) {
    return <Alert severity="info">Không có dữ liệu thống kê.</Alert>;
  }

  const realtimeColor = realtimeState === "connected" ? "success" : realtimeState === "connecting" ? "warning" : "error";
  const realtimeLabel = realtimeState === "connected" ? "Đang cập nhật" : realtimeState === "connecting" ? "Đang kết nối" : "Mất kết nối";

  return (
    <Stack spacing={3}>
      <Paper variant="outlined" sx={{ p: 3 }}>
        <Stack direction={{ xs: "column", lg: "row" }} spacing={2} sx={{ justifyContent: "space-between" }}>
          <Box>
            <Stack direction="row" spacing={1} sx={{ alignItems: "center", flexWrap: "wrap" }}>
              <Chip color="primary" label="Hôm nay" />
              <Typography variant="body2" color="text.secondary">{todayLabel}</Typography>
            </Stack>
            <Typography variant="h4" sx={{ mt: 1.5 }}>Thống kê vận hành</Typography>
            <Typography variant="body2" color="text.secondary">Theo dõi ra/vào, hiện diện và mượn trả trong ngày</Typography>
          </Box>
          <Stack direction="row" spacing={1.5} sx={{ flexWrap: "wrap" }}>
            <Chip variant="outlined" label={`Tổng độc giả: ${(stats.total_patrons ?? 0).toLocaleString("vi-VN")}`} />
            <Chip color={realtimeColor as any} icon={<RadioIcon />} label={realtimeLabel} />
          </Stack>
        </Stack>
      </Paper>

      <Box sx={{ display: "grid", gridTemplateColumns: { xs: "1fr", sm: "repeat(2, 1fr)", lg: "repeat(4, 1fr)" }, gap: 2 }}>
        <MetricCard label="Đang trong thư viện" value={activePatrons.length} icon={UserIcon} color={theme.palette.success.main} description="Có mặt hiện tại" />
        <MetricCard label="Vào hôm nay" value={stats.today_entries} icon={LoginIcon} color={theme.palette.info.main} description="Từ 00:00" />
        <MetricCard label="Ra hôm nay" value={stats.today_exits} icon={LogoutIcon} color={theme.palette.warning.main} description="Từ 00:00" />
        <MetricCard label="Hoạt động hôm nay" value={todayLogs.length} icon={ActivityIcon} color={theme.palette.primary.main} description="Camera và kiosk" />
      </Box>

      <Box sx={{ display: "grid", gridTemplateColumns: { xs: "1fr", xl: "1.45fr 0.9fr" }, gap: 3 }}>
        <Paper variant="outlined" sx={{ p: 2 }}>
          <Stack direction="row" spacing={1} sx={{ alignItems: "center", mb: 2 }}>
            <ChartIcon color="primary" />
            <Box>
              <Typography variant="h6">Lượt ra/vào theo giờ hôm nay</Typography>
              <Typography variant="body2" color="text.secondary">Tách lượt vào và ra để nhìn cao điểm trong ngày</Typography>
            </Box>
          </Stack>
          {!hasHourlyData ? (
            <Box sx={{ height: 288, border: 1, borderStyle: "dashed", borderColor: "divider", borderRadius: 1, display: "grid", placeItems: "center", textAlign: "center" }}>
              <Box>
                <ClockIcon color="disabled" />
                <Typography variant="body2" color="text.secondary">Chưa có lượt ra/vào hôm nay</Typography>
              </Box>
            </Box>
          ) : (
            <Box sx={{ height: 288 }}>
              <ResponsiveContainer width="100%" height="100%">
                <BarChart data={hourlyData} margin={{ top: 10, right: 10, left: -18, bottom: 0 }}>
                  <CartesianGrid strokeDasharray="3 3" stroke={theme.palette.divider} vertical={false} />
                  <XAxis dataKey="hour" tick={{ fill: theme.palette.text.secondary, fontSize: 11 }} interval={1} />
                  <YAxis allowDecimals={false} tick={{ fill: theme.palette.text.secondary, fontSize: 11 }} />
                  <Tooltip
                    contentStyle={{ background: theme.palette.background.paper, border: `1px solid ${theme.palette.divider}`, borderRadius: 8 }}
                    labelFormatter={(label) => `${label}:00 - ${label}:59`}
                    formatter={(value: any, name: any) => [value, name === "entry" ? "Vào" : "Ra"]}
                  />
                  <Legend wrapperStyle={{ color: theme.palette.text.secondary, fontSize: 12 }} />
                  <Bar dataKey="entry" name="Vào" fill={theme.palette.success.main} radius={[4, 4, 0, 0]} />
                  <Bar dataKey="exit" name="Ra" fill={theme.palette.warning.main} radius={[4, 4, 0, 0]} />
                </BarChart>
              </ResponsiveContainer>
            </Box>
          )}
        </Paper>

        <Paper variant="outlined" sx={{ p: 2 }}>
          <Stack direction="row" spacing={1} sx={{ alignItems: "center", mb: 2 }}>
            <UserIcon color="primary" />
            <Box>
              <Typography variant="h6">Đang trong thư viện</Typography>
              <Typography variant="body2" color="text.secondary">{activePatrons.length} độc giả đang hiện diện</Typography>
            </Box>
          </Stack>
          {activePatrons.length === 0 ? (
            <Alert severity="info">Không có ai trong thư viện.</Alert>
          ) : (
            <Stack spacing={1} sx={{ maxHeight: 288, overflowY: "auto" }}>
              {activePatrons.slice(0, 20).map((p) => (
                <Paper key={p.id} variant="outlined" sx={{ p: 1.25 }}>
                  <Stack direction="row" spacing={1.5} sx={{ alignItems: "center", justifyContent: "space-between" }}>
                    <Stack direction="row" spacing={1.25} sx={{ alignItems: "center", minWidth: 0 }}>
                      <Avatar sx={{ bgcolor: "primary.main", color: "primary.contrastText", fontWeight: 900 }}>
                        {p.full_name?.charAt(0) || "?"}
                      </Avatar>
                      <Box sx={{ minWidth: 0 }}>
                        <Typography variant="body2" sx={{ fontWeight: 900 }} noWrap>{p.full_name || "Không rõ tên"}</Typography>
                        <Typography variant="caption" color="text.secondary" sx={{ fontFamily: "monospace" }}>{p.student_code || "---"}</Typography>
                      </Box>
                    </Stack>
                    <Box sx={{ textAlign: "right" }}>
                      <Typography variant="caption" sx={{ fontFamily: "monospace" }}>{formatShortTime(p.entered_at)}</Typography>
                      <Stack direction="row" spacing={0.5} sx={{ alignItems: "center", justifyContent: "flex-end" }}>
                        <CameraIcon sx={{ fontSize: 12 }} color="disabled" />
                        <Typography variant="caption" color="text.secondary" sx={{ fontFamily: "monospace" }}>{formatCameraId(p.camera_id)}</Typography>
                      </Stack>
                    </Box>
                  </Stack>
                </Paper>
              ))}
            </Stack>
          )}
        </Paper>
      </Box>

      <Paper variant="outlined">
        <Box sx={{ p: 2 }}>
          <Stack direction="row" spacing={1} sx={{ alignItems: "center" }}>
            <ActivityIcon color="primary" />
            <Box>
              <Typography variant="h6">Hoạt động hôm nay</Typography>
              <Typography variant="body2" color="text.secondary">Các lượt ra/vào mới nhất từ entry_gate, exit_gate và kiosk</Typography>
            </Box>
          </Stack>
        </Box>
        <Divider />
        {todayLogs.length === 0 ? (
          <Box sx={{ p: 4, textAlign: "center" }}>
            <RadioIcon color="disabled" />
            <Typography variant="body2" color="text.secondary">Chưa có hoạt động hôm nay</Typography>
          </Box>
        ) : (
          <TableContainer>
            <Table size="small">
              <TableHead>
                <TableRow>
                  <TableCell>Thời gian</TableCell>
                  <TableCell>Độc giả</TableCell>
                  <TableCell>Loại</TableCell>
                  <TableCell>Camera</TableCell>
                  <TableCell>Độ tin cậy</TableCell>
                  <TableCell>Trạng thái</TableCell>
                </TableRow>
              </TableHead>
              <TableBody>
                {todayLogs.slice(0, 30).map((log) => (
                  <TableRow key={log.id}>
                    <TableCell sx={{ fontFamily: "monospace" }}>{formatTime(log.access_time)}</TableCell>
                    <TableCell>
                      <Typography variant="body2" sx={{ fontWeight: 800 }}>{log.patron_name || "Không rõ tên"}</Typography>
                      <Typography variant="caption" color="text.secondary" sx={{ fontFamily: "monospace" }}>{log.student_code || log.patron_id || "---"}</Typography>
                    </TableCell>
                    <TableCell><AccessTypeChip type={log.access_type} /></TableCell>
                    <TableCell sx={{ fontFamily: "monospace" }}>{formatCameraId(log.camera_id)}</TableCell>
                    <TableCell sx={{ fontFamily: "monospace" }}>{formatConfidence(log.confidence)}</TableCell>
                    <TableCell><StatusChip status={log.status} /></TableCell>
                  </TableRow>
                ))}
              </TableBody>
            </Table>
          </TableContainer>
        )}
      </Paper>

      <Box sx={{ display: "grid", gridTemplateColumns: { xs: "1fr", lg: "repeat(3, 1fr)" }, gap: 2 }}>
        {[
          { label: "Tổng lượt mượn", value: borrowStats?.total ?? "—", icon: BookIcon, color: theme.palette.primary.main, description: "Tất cả phiếu mượn" },
          { label: "Đang mượn", value: borrowStats?.active ?? "—", icon: BookIcon, color: theme.palette.success.main, description: "Chưa trả" },
          { label: "Quá hạn", value: borrowStats?.overdue ?? "—", icon: AlertIcon, color: theme.palette.error.main, description: "Cần xử lý" },
        ].map((card, idx) => (
          <Box key={card.label} sx={{ animation: `${fadeInUp} 0.35s ease-out`, animationDelay: `${idx * 0.08}s`, animationFillMode: "both" }}>
            <MetricCard {...card} />
          </Box>
        ))}
      </Box>

      <Paper variant="outlined">
        <Box sx={{ p: 2 }}>
          <Stack direction="row" spacing={1} sx={{ alignItems: "center" }}>
            <BookIcon color="primary" />
            <Typography variant="h6">Sách đang mượn ({borrowStats?.active ?? 0})</Typography>
            {(borrowStats?.overdue ?? 0) > 0 ? <Chip size="small" color="error" label={`${borrowStats?.overdue ?? 0} quá hạn`} /> : null}
          </Stack>
        </Box>
        <Divider />
        {recentBorrows.length === 0 ? (
          <Box sx={{ p: 4, textAlign: "center" }}>
            <BookIcon color="disabled" />
            <Typography variant="body2" color="text.secondary">Không có sách đang được mượn</Typography>
          </Box>
        ) : (
          <TableContainer>
            <Table size="small">
              <TableHead>
                <TableRow>
                  <TableCell>Sách</TableCell>
                  <TableCell>Độc giả</TableCell>
                  <TableCell>Ngày mượn</TableCell>
                  <TableCell>Hạn trả</TableCell>
                  <TableCell>Trạng thái</TableCell>
                </TableRow>
              </TableHead>
              <TableBody>
                {recentBorrows.map((record, idx) => {
                  const overdue = new Date(record.due_at) < new Date();
                  return (
                    <TableRow key={record.id} selected={overdue} sx={{ animation: `${slideInRight} 0.3s ease-out`, animationDelay: `${idx * 0.04}s`, animationFillMode: "both" }}>
                      <TableCell>
                        <Typography variant="body2" sx={{ fontWeight: 800 }}>{record.book?.title || record.book_id}</Typography>
                        <Typography variant="caption" color="text.secondary" sx={{ fontFamily: "monospace" }}>{record.book?.isbn || record.book_id}</Typography>
                      </TableCell>
                      <TableCell sx={{ fontFamily: "monospace" }}>{record.patron_id}</TableCell>
                      <TableCell>{new Date(record.borrow_at).toLocaleDateString("vi-VN")}</TableCell>
                      <TableCell>{new Date(record.due_at).toLocaleDateString("vi-VN")}</TableCell>
                      <TableCell><Chip size="small" color={overdue ? "error" : "success"} label={overdue ? "Quá hạn" : "Đúng hạn"} sx={{ animation: `${successPop} 0.35s ease-out` }} /></TableCell>
                    </TableRow>
                  );
                })}
              </TableBody>
            </Table>
          </TableContainer>
        )}
      </Paper>
    </Stack>
  );
}
