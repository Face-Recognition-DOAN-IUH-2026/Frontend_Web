"use client";

import { useEffect, useMemo, useState } from "react";
import {
  Alert,
  Avatar,
  Box,
  Button,
  Card,
  CardContent,
  Chip,
  CircularProgress,
  Grid,
  InputAdornment,
  LinearProgress,
  Paper,
  Stack,
  TextField,
  Tooltip,
  Typography,
  useTheme,
} from "@mui/material";
import AccessTimeOutlinedIcon from "@mui/icons-material/AccessTimeOutlined";
import DoorFrontOutlinedIcon from "@mui/icons-material/DoorFrontOutlined";
import GroupsOutlinedIcon from "@mui/icons-material/GroupsOutlined";
import LocationOnOutlinedIcon from "@mui/icons-material/LocationOnOutlined";
import RefreshOutlinedIcon from "@mui/icons-material/RefreshOutlined";
import SearchOutlinedIcon from "@mui/icons-material/SearchOutlined";
import ShieldOutlinedIcon from "@mui/icons-material/ShieldOutlined";
import VerifiedUserOutlinedIcon from "@mui/icons-material/VerifiedUserOutlined";
import api from "@/lib/api-client";
import type { ActivePatron } from "@/lib/types";

const ACTIVE_CAMERA_IDS = new Set(["entry_gate", "exit_gate", "kiosk"]);

const CAMERA_LABELS: Record<string, string> = {
  entry_gate: "Cổng vào",
  exit_gate: "Cổng ra",
  kiosk: "Kiosk",
};

function formatTime(value: string) {
  return new Date(value).toLocaleTimeString("vi-VN", {
    hour: "2-digit",
    minute: "2-digit",
  });
}

function formatDuration(value: string) {
  const diffMs = Date.now() - new Date(value).getTime();
  const minutes = Math.max(0, Math.floor(diffMs / 60000));
  if (minutes < 1) return "Vừa vào";
  if (minutes < 60) return `${minutes} phút`;
  const hours = Math.floor(minutes / 60);
  const rest = minutes % 60;
  return rest ? `${hours} giờ ${rest} phút` : `${hours} giờ`;
}

function initials(name?: string) {
  const parts = (name || "").trim().split(/\s+/).filter(Boolean);
  if (parts.length === 0) return "?";
  if (parts.length === 1) return parts[0].charAt(0).toUpperCase();
  return `${parts[0].charAt(0)}${parts[parts.length - 1].charAt(0)}`.toUpperCase();
}

function normalizeQuery(value: string) {
  return value.trim().toLowerCase();
}

export default function ActivePage() {
  const theme = useTheme();
  const [patrons, setPatrons] = useState<ActivePatron[]>([]);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState<string | null>(null);
  const [search, setSearch] = useState("");
  const [lastUpdate, setLastUpdate] = useState<Date>(new Date());

  const load = async () => {
    try {
      setError(null);
      const data = await api.getActivePatrons();
      const allowed = data.items
        .filter((patron) => ACTIVE_CAMERA_IDS.has(patron.camera_id))
        .sort((a, b) => new Date(b.entered_at).getTime() - new Date(a.entered_at).getTime());
      setPatrons(allowed);
      setLastUpdate(new Date());
    } catch {
      setError("Không thể tải danh sách độc giả đang trong thư viện.");
    } finally {
      setLoading(false);
    }
  };

  useEffect(() => {
    load();
    const interval = setInterval(load, 10000);
    return () => clearInterval(interval);
  }, []);

  const filteredPatrons = useMemo(() => {
    const q = normalizeQuery(search);
    if (!q) return patrons;
    return patrons.filter((patron) => (
      patron.full_name.toLowerCase().includes(q)
      || patron.student_code.toLowerCase().includes(q)
    ));
  }, [patrons, search]);

  const cameraCounts = useMemo(() => (
    patrons.reduce<Record<string, number>>((acc, patron) => {
      acc[patron.camera_id] = (acc[patron.camera_id] || 0) + 1;
      return acc;
    }, {})
  ), [patrons]);

  return (
    <Stack spacing={3}>
      <Paper
        variant="outlined"
        sx={{
          overflow: "hidden",
          background: `linear-gradient(135deg, ${theme.palette.success.dark}33, ${theme.palette.background.paper} 55%)`,
        }}
      >
        <Grid container>
          <Grid size={{ xs: 12, md: 4 }}>
            <Box sx={{ p: 3, height: "100%", borderRight: { md: `1px solid ${theme.palette.divider}` } }}>
              <Stack spacing={2.5} sx={{ height: "100%", justifyContent: "space-between" }}>
                <Avatar sx={{ bgcolor: "success.main", color: "success.contrastText", width: 52, height: 52 }}>
                  <GroupsOutlinedIcon />
                </Avatar>
                <Box>
                  <Typography variant="overline" color="success.main" sx={{ fontWeight: 800 }}>
                    Đang trong thư viện
                  </Typography>
                  <Typography variant="h2" sx={{ mt: 0.5, fontWeight: 900, letterSpacing: 0 }}>
                    {patrons.length}
                  </Typography>
                  <Typography color="text.secondary">
                    Chỉ tính lượt hợp lệ từ cổng vào, cổng ra và kiosk.
                  </Typography>
                </Box>
              </Stack>
            </Box>
          </Grid>

          <Grid size={{ xs: 12, md: 8 }}>
            <Stack spacing={2.5} sx={{ p: 3 }}>
              <Stack direction={{ xs: "column", sm: "row" }} spacing={1.5} sx={{ justifyContent: "space-between" }}>
                <Box>
                  <Typography variant="h4" sx={{ fontWeight: 850 }}>
                    Hiện diện trong thư viện
                  </Typography>
                  <Typography color="text.secondary">
                    Theo dõi nhanh độc giả đang ở trong thư viện theo dữ liệu camera/kiosk.
                  </Typography>
                </Box>
                <Stack direction="row" spacing={1} sx={{ alignItems: "center", flexWrap: "wrap" }}>
                  <Chip color={error ? "error" : "success"} label={error ? "Lỗi cập nhật" : "Đang cập nhật"} />
                  <Tooltip title="Làm mới danh sách">
                    <span>
                      <Button
                        variant="outlined"
                        startIcon={<RefreshOutlinedIcon />}
                        onClick={load}
                        disabled={loading}
                      >
                        Làm mới
                      </Button>
                    </span>
                  </Tooltip>
                </Stack>
              </Stack>

              {error && <Alert severity="error">{error}</Alert>}

              <Grid container spacing={1.5}>
                {Object.entries(CAMERA_LABELS).map(([cameraId, label]) => (
                  <Grid key={cameraId} size={{ xs: 12, sm: 4 }}>
                    <Card variant="outlined" sx={{ height: "100%" }}>
                      <CardContent>
                        <Stack direction="row" spacing={1.5} sx={{ alignItems: "center" }}>
                          <Avatar sx={{ bgcolor: "action.hover", color: "text.secondary" }}>
                            <ShieldOutlinedIcon fontSize="small" />
                          </Avatar>
                          <Box>
                            <Typography color="text.secondary" variant="body2">
                              {label}
                            </Typography>
                            <Typography variant="h5" sx={{ fontWeight: 850 }}>
                              {cameraCounts[cameraId] || 0}
                            </Typography>
                          </Box>
                        </Stack>
                      </CardContent>
                    </Card>
                  </Grid>
                ))}
              </Grid>

              <Typography variant="caption" color="text.secondary">
                Cập nhật lần cuối: {lastUpdate.toLocaleTimeString("vi-VN")}
              </Typography>
            </Stack>
          </Grid>
        </Grid>
      </Paper>

      <Paper variant="outlined" sx={{ p: 2.5 }}>
        <Stack
          direction={{ xs: "column", md: "row" }}
          spacing={2}
          sx={{ alignItems: { md: "center" }, justifyContent: "space-between", mb: 2.5 }}
        >
          <Box>
            <Typography variant="h6" sx={{ fontWeight: 850 }}>
              Độc giả đang có mặt
            </Typography>
            <Typography color="text.secondary" variant="body2">
              {filteredPatrons.length} kết quả hiển thị
            </Typography>
          </Box>
          <TextField
            value={search}
            onChange={(event) => setSearch(event.target.value)}
            placeholder="Tìm theo tên hoặc MSSV..."
            size="small"
            sx={{ width: { xs: "100%", md: 360 } }}
            slotProps={{
              input: {
                startAdornment: (
                  <InputAdornment position="start">
                    <SearchOutlinedIcon fontSize="small" />
                  </InputAdornment>
                ),
              },
            }}
          />
        </Stack>

        {loading && patrons.length === 0 ? (
          <Stack spacing={2} sx={{ minHeight: 280, alignItems: "center", justifyContent: "center" }}>
            <CircularProgress size={32} />
            <Typography color="text.secondary">Đang tải danh sách...</Typography>
          </Stack>
        ) : patrons.length === 0 ? (
          <Alert icon={<DoorFrontOutlinedIcon />} severity="info">
            Chưa có độc giả trong thư viện. Danh sách sẽ tự cập nhật khi có lượt vào hợp lệ.
          </Alert>
        ) : filteredPatrons.length === 0 ? (
          <Alert icon={<SearchOutlinedIcon />} severity="warning">
            Không tìm thấy độc giả phù hợp với từ khóa hiện tại.
          </Alert>
        ) : (
          <Grid container spacing={1.5}>
            {filteredPatrons.map((patron) => {
              const percent = patron.confidence == null ? null : Math.round(patron.confidence * 100);
              return (
                <Grid key={patron.id} size={{ xs: 12, xl: 6 }}>
                  <Card variant="outlined" sx={{ height: "100%" }}>
                    <CardContent>
                      <Stack direction="row" spacing={2} sx={{ alignItems: "flex-start" }}>
                        <Avatar sx={{ bgcolor: "primary.main", color: "primary.contrastText", fontWeight: 800 }}>
                          {initials(patron.full_name)}
                        </Avatar>
                        <Box sx={{ minWidth: 0, flex: 1 }}>
                          <Stack
                            direction={{ xs: "column", sm: "row" }}
                            spacing={1}
                            sx={{ justifyContent: "space-between", alignItems: { sm: "flex-start" } }}
                          >
                            <Box sx={{ minWidth: 0 }}>
                              <Typography noWrap sx={{ fontWeight: 800 }}>
                                {patron.full_name || "Chưa có tên"}
                              </Typography>
                              <Typography variant="body2" color="text.secondary" sx={{ fontFamily: "monospace" }}>
                                {patron.student_code}
                              </Typography>
                            </Box>
                            <Chip color="success" label="Đang ở trong" size="small" />
                          </Stack>

                          <Grid container spacing={1.5} sx={{ mt: 2 }}>
                            <Grid size={{ xs: 12, sm: 4 }}>
                              <Stack direction="row" spacing={1} sx={{ alignItems: "center" }}>
                                <AccessTimeOutlinedIcon color="disabled" fontSize="small" />
                                <Typography variant="body2">{formatTime(patron.entered_at)}</Typography>
                              </Stack>
                            </Grid>
                            <Grid size={{ xs: 12, sm: 4 }}>
                              <Stack direction="row" spacing={1} sx={{ alignItems: "center" }}>
                                <LocationOnOutlinedIcon color="disabled" fontSize="small" />
                                <Typography variant="body2">
                                  {CAMERA_LABELS[patron.camera_id] || patron.camera_id}
                                </Typography>
                              </Stack>
                            </Grid>
                            <Grid size={{ xs: 12, sm: 4 }}>
                              <Stack direction="row" spacing={1} sx={{ alignItems: "center" }}>
                                <VerifiedUserOutlinedIcon color="disabled" fontSize="small" />
                                <Typography variant="body2">{formatDuration(patron.entered_at)}</Typography>
                              </Stack>
                            </Grid>
                          </Grid>

                          {percent != null && (
                            <Stack direction="row" spacing={1.5} sx={{ mt: 2, alignItems: "center" }}>
                              <LinearProgress
                                variant="determinate"
                                value={percent}
                                color={percent >= 80 ? "success" : percent >= 60 ? "warning" : "error"}
                                sx={{ flex: 1, height: 7, borderRadius: 99 }}
                              />
                              <Typography variant="caption" color="text.secondary" sx={{ minWidth: 38, textAlign: "right" }}>
                                {percent}%
                              </Typography>
                            </Stack>
                          )}
                        </Box>
                      </Stack>
                    </CardContent>
                  </Card>
                </Grid>
              );
            })}
          </Grid>
        )}
      </Paper>
    </Stack>
  );
}
</file>

<file path="src/app/(dashboard)/dashboard/admin/page.tsx">
"use client";

import { useEffect, useState } from "react";
import { useRouter } from "next/navigation";
import {
  Alert,
  Avatar,
  Box,
  Button,
  Chip,
  CircularProgress,
  Dialog,
  DialogActions,
  DialogContent,
  DialogTitle,
  FormControl,
  Grid,
  InputLabel,
  MenuItem,
  Paper,
  Select,
  Snackbar,
  Stack,
  Table,
  TableBody,
  TableCell,
  TableContainer,
  TableHead,
  TableRow,
  TextField,
  Typography,
} from "@mui/material";
import AddOutlinedIcon from "@mui/icons-material/AddOutlined";
import AdminPanelSettingsOutlinedIcon from "@mui/icons-material/AdminPanelSettingsOutlined";
import DeleteOutlineOutlinedIcon from "@mui/icons-material/DeleteOutlineOutlined";
import FaceRetouchingNaturalOutlinedIcon from "@mui/icons-material/FaceRetouchingNaturalOutlined";
import GroupsOutlinedIcon from "@mui/icons-material/GroupsOutlined";
import PersonOutlineOutlinedIcon from "@mui/icons-material/PersonOutlineOutlined";
import api from "@/lib/api-client";
import { useAuth } from "@/lib/auth-context";
import type { UserPublic } from "@/lib/types";

function roleLabel(role: string) {
  if (role === "admin") return "Quản trị";
  if (role === "staff") return "Nhân viên";
  if (role === "patron") return "Độc giả";
  return role;
}

function initials(email: string) {
  return email.slice(0, 1).toUpperCase();
}

export default function AdminPage() {
  const { isLoading, isAuthenticated } = useAuth();
  const router = useRouter();
  const [users, setUsers] = useState<UserPublic[]>([]);
  const [total, setTotal] = useState(0);
  const [loading, setLoading] = useState(true);
  const [showCreate, setShowCreate] = useState(false);
  const [deleteTarget, setDeleteTarget] = useState<UserPublic | null>(null);
  const [createForm, setCreateForm] = useState({ email: "", password: "", role: "staff" });
  const [createError, setCreateError] = useState("");
  const [notice, setNotice] = useState("");

  useEffect(() => {
    if (!isLoading && !isAuthenticated) router.push("/login");
  }, [isLoading, isAuthenticated, router]);

  const load = async () => {
    try {
      const data = await api.listUsers();
      setUsers(data.users);
      setTotal(data.total);
    } finally {
      setLoading(false);
    }
  };

  useEffect(() => { load(); }, []);

  const handleCreate = async () => {
    if (!createForm.email || !createForm.password) {
      setCreateError("Vui lòng nhập email và mật khẩu.");
      return;
    }
    try {
      setCreateError("");
      await api.register(createForm);
      setShowCreate(false);
      setCreateForm({ email: "", password: "", role: "staff" });
      setNotice("Đã tạo người dùng mới.");
      load();
    } catch (err: any) {
      setCreateError(err?.response?.data?.detail || "Tạo người dùng thất bại.");
    }
  };

  const handleDelete = async () => {
    if (!deleteTarget) return;
    const current = deleteTarget;
    setDeleteTarget(null);
    setUsers((prev) => prev.filter((u) => u.id !== current.id));
    try {
      await api.deleteUser(current.id);
      setNotice("Đã xóa người dùng.");
    } catch {
      setNotice("Xóa thất bại, dữ liệu đã được tải lại.");
      load();
    }
  };

  if (isLoading) {
    return (
      <Stack sx={{ minHeight: 400, alignItems: "center", justifyContent: "center" }}>
        <CircularProgress />
      </Stack>
    );
  }
  if (!isAuthenticated) return null;

  const adminCount = users.filter((item) => item.role === "admin").length;
  const staffCount = users.filter((item) => item.role === "staff").length;
  const faceCount = users.filter((item) => item.has_face).length;

  return (
    <Stack spacing={3}>
      <Paper variant="outlined" sx={{ p: 3 }}>
        <Stack direction={{ xs: "column", md: "row" }} spacing={2} sx={{ alignItems: { md: "center" }, justifyContent: "space-between" }}>
          <Box>
            <Stack direction="row" spacing={1.25} sx={{ alignItems: "center" }}>
              <AdminPanelSettingsOutlinedIcon color="primary" />
              <Typography variant="h4" sx={{ fontWeight: 850 }}>
                Quản trị người dùng
              </Typography>
            </Stack>
            <Typography color="text.secondary" sx={{ mt: 0.5 }}>
              Tạo tài khoản admin/staff và theo dõi trạng thái đăng ký khuôn mặt.
            </Typography>
          </Box>
          <Button variant="contained" startIcon={<AddOutlinedIcon />} onClick={() => setShowCreate(true)}>
            Thêm người dùng
          </Button>
        </Stack>
      </Paper>

      <Grid container spacing={2}>
        {[
          { label: "Tổng người dùng", value: total, icon: <GroupsOutlinedIcon /> },
          { label: "Quản trị viên", value: adminCount, icon: <AdminPanelSettingsOutlinedIcon /> },
          { label: "Nhân viên", value: staffCount, icon: <PersonOutlineOutlinedIcon /> },
          { label: "Đã có khuôn mặt", value: faceCount, icon: <FaceRetouchingNaturalOutlinedIcon /> },
        ].map((item) => (
          <Grid key={item.label} size={{ xs: 12, sm: 6, lg: 3 }}>
            <Paper variant="outlined" sx={{ p: 2.25 }}>
              <Stack direction="row" spacing={1.5} sx={{ alignItems: "center" }}>
                <Avatar sx={{ bgcolor: "action.hover", color: "primary.main" }}>{item.icon}</Avatar>
                <Box>
                  <Typography color="text.secondary" variant="body2">{item.label}</Typography>
                  <Typography variant="h5" sx={{ fontWeight: 850 }}>{item.value}</Typography>
                </Box>
              </Stack>
            </Paper>
          </Grid>
        ))}
      </Grid>

      <Paper variant="outlined" sx={{ overflow: "hidden" }}>
        <TableContainer>
          <Table sx={{ minWidth: 760 }}>
            <TableHead>
              <TableRow>
                <TableCell>Email</TableCell>
                <TableCell>Vai trò</TableCell>
                <TableCell>Khuôn mặt</TableCell>
                <TableCell align="right">Hành động</TableCell>
              </TableRow>
            </TableHead>
            <TableBody>
              {loading ? (
                <TableRow>
                  <TableCell colSpan={4}>
                    <Stack sx={{ py: 6, alignItems: "center" }}>
                      <CircularProgress size={28} />
                    </Stack>
                  </TableCell>
                </TableRow>
              ) : users.length === 0 ? (
                <TableRow>
                  <TableCell colSpan={4}>
                    <Alert severity="info">Không có người dùng nào.</Alert>
                  </TableCell>
                </TableRow>
              ) : (
                users.map((item) => (
                  <TableRow key={item.id} hover>
                    <TableCell>
                      <Stack direction="row" spacing={1.5} sx={{ alignItems: "center" }}>
                        <Avatar sx={{ width: 34, height: 34, bgcolor: "primary.main", color: "primary.contrastText", fontWeight: 800 }}>
                          {initials(item.email)}
                        </Avatar>
                        <Box sx={{ minWidth: 0 }}>
                          <Typography sx={{ fontWeight: 750 }} noWrap>{item.email}</Typography>
                          {item.full_name && <Typography variant="body2" color="text.secondary" noWrap>{item.full_name}</Typography>}
                        </Box>
                      </Stack>
                    </TableCell>
                    <TableCell>
                      <Chip
                        size="small"
                        color={item.role === "admin" ? "warning" : item.role === "staff" ? "primary" : "default"}
                        label={roleLabel(item.role)}
                      />
                    </TableCell>
                    <TableCell>
                      <Chip
                        size="small"
                        color={item.has_face ? "success" : "default"}
                        label={item.has_face ? "Đã xác thực" : "Chưa xác thực"}
                      />
                    </TableCell>
                    <TableCell align="right">
                      <Button
                        color="error"
                        variant="outlined"
                        size="small"
                        startIcon={<DeleteOutlineOutlinedIcon />}
                        onClick={() => setDeleteTarget(item)}
                      >
                        Xóa
                      </Button>
                    </TableCell>
                  </TableRow>
                ))
              )}
            </TableBody>
          </Table>
        </TableContainer>
      </Paper>

      <Dialog open={showCreate} onClose={() => setShowCreate(false)} fullWidth maxWidth="sm">
        <DialogTitle>Thêm người dùng</DialogTitle>
        <DialogContent>
          <Stack spacing={2} sx={{ pt: 1 }}>
            {createError && <Alert severity="error">{createError}</Alert>}
            <TextField
              label="Email"
              type="email"
              value={createForm.email}
              onChange={(event) => setCreateForm({ ...createForm, email: event.target.value })}
              fullWidth
            />
            <TextField
              label="Mật khẩu"
              type="password"
              value={createForm.password}
              onChange={(event) => setCreateForm({ ...createForm, password: event.target.value })}
              fullWidth
            />
            <FormControl fullWidth>
              <InputLabel>Vai trò</InputLabel>
              <Select
                label="Vai trò"
                value={createForm.role}
                onChange={(event) => setCreateForm({ ...createForm, role: event.target.value })}
              >
                <MenuItem value="staff">Nhân viên</MenuItem>
                <MenuItem value="admin">Quản trị</MenuItem>
              </Select>
            </FormControl>
          </Stack>
        </DialogContent>
        <DialogActions>
          <Button onClick={() => setShowCreate(false)}>Hủy</Button>
          <Button variant="contained" onClick={handleCreate}>Tạo</Button>
        </DialogActions>
      </Dialog>

      <Dialog open={Boolean(deleteTarget)} onClose={() => setDeleteTarget(null)} fullWidth maxWidth="xs">
        <DialogTitle>Xóa người dùng?</DialogTitle>
        <DialogContent>
          <Typography color="text.secondary">
            Tài khoản {deleteTarget?.email} sẽ bị xóa khỏi hệ thống.
          </Typography>
        </DialogContent>
        <DialogActions>
          <Button onClick={() => setDeleteTarget(null)}>Hủy</Button>
          <Button color="error" variant="contained" onClick={handleDelete}>Xóa</Button>
        </DialogActions>
      </Dialog>

      <Snackbar open={Boolean(notice)} autoHideDuration={3000} onClose={() => setNotice("")} message={notice} />
    </Stack>
  );
}
</file>

<file path="src/app/(dashboard)/history/page.tsx">
"use client";

import { useCallback, useEffect, useMemo, useRef, useState } from "react";
import {
  Alert,
  Box,
  Button,
  Card,
  CardContent,
  Chip,
  CircularProgress,
  Grid,
  InputAdornment,
  LinearProgress,
  MenuItem,
  Paper,
  Stack,
  Switch,
  Table,
  TableBody,
  TableCell,
  TableContainer,
  TableHead,
  TableRow,
  TextField,
  Typography,
  useTheme,
} from "@mui/material";
import BarChartOutlinedIcon from "@mui/icons-material/BarChartOutlined";
import FilterAltOutlinedIcon from "@mui/icons-material/FilterAltOutlined";
import HistoryOutlinedIcon from "@mui/icons-material/HistoryOutlined";
import LoginOutlinedIcon from "@mui/icons-material/LoginOutlined";
import LogoutOutlinedIcon from "@mui/icons-material/LogoutOutlined";
import SearchOutlinedIcon from "@mui/icons-material/SearchOutlined";
import SensorsOutlinedIcon from "@mui/icons-material/SensorsOutlined";
import {
  Bar,
  BarChart,
  CartesianGrid,
  Legend,
  ResponsiveContainer,
  Tooltip,
  XAxis,
  YAxis,
} from "recharts";
import api from "@/lib/api-client";
import type { AccessFrequencyDay, AccessLogPublic, CameraEvent } from "@/lib/types";

const PAGE_SIZES = [20, 50, 100];

const CAMERA_LABELS: Record<string, string> = {
  entry_gate: "Cổng vào",
  exit_gate: "Cổng ra",
  kiosk: "Kiosk",
  web_login: "Đăng nhập web",
};

function getStatusLabel(status: string) {
  if (status === "success" || status === "granted") return "Thành công";
  if (status === "expired") return "Hết hạn";
  if (status === "spoof") return "Giả mạo";
  return "Thất bại";
}

function getStatusColor(status: string): "success" | "warning" | "error" {
  if (status === "success" || status === "granted") return "success";
  if (status === "expired") return "warning";
  return "error";
}

function mapEventStatus(status: CameraEvent["status"]) {
  return status === "granted" ? "success" : status;
}

export default function HistoryPage() {
  const theme = useTheme();
  const [logs, setLogs] = useState<AccessLogPublic[]>([]);
  const [total, setTotal] = useState(0);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState<string | null>(null);
  const [live, setLive] = useState(true);

  const [search, setSearch] = useState("");
  const [accessType, setAccessType] = useState("");
  const [status, setStatus] = useState("");
  const [dateFrom, setDateFrom] = useState("");
  const [dateTo, setDateTo] = useState("");

  const [skip, setSkip] = useState(0);
  const [limit, setLimit] = useState(50);
  const totalPages = Math.max(1, Math.ceil(total / limit));
  const currentPage = Math.floor(skip / limit) + 1;

  const [frequency, setFrequency] = useState<AccessFrequencyDay[]>([]);
  const [freqLoading, setFreqLoading] = useState(false);

  const load = useCallback(async () => {
    setLoading(true);
    try {
      setError(null);
      const data = await api.getAccessLogs({
        search: search || undefined,
        accessType: accessType || undefined,
        status: status || undefined,
        dateFrom: dateFrom || undefined,
        dateTo: dateTo || undefined,
        skip,
        limit,
      });
      setLogs(data.items);
      setTotal(data.total);
    } catch {
      setError("Không thể tải lịch sử ra/vào.");
    } finally {
      setLoading(false);
    }
  }, [search, accessType, status, dateFrom, dateTo, skip, limit]);

  useEffect(() => { load(); }, [load]);

  useEffect(() => {
    (async () => {
      setFreqLoading(true);
      try {
        const data = await api.getAccessFrequency({
          dateFrom: dateFrom || undefined,
          dateTo: dateTo || undefined,
        });
        setFrequency(Array.isArray(data.daily) ? data.daily : []);
      } finally {
        setFreqLoading(false);
      }
    })();
  }, [dateFrom, dateTo]);

  const liveCleanup = useRef<(() => void) | null>(null);
  useEffect(() => {
    if (!live || skip !== 0) {
      if (liveCleanup.current) {
        liveCleanup.current();
        liveCleanup.current = null;
      }
      return;
    }

    const cleanup = api.connectAccessSSE((event: CameraEvent) => {
      const mappedStatus = mapEventStatus(event.status);
      if (search) {
        const q = search.toLowerCase();
        if (!event.full_name?.toLowerCase().includes(q) && !event.student_code?.toLowerCase().includes(q)) return;
      }
      if (status && mappedStatus !== status) return;
      if (accessType && event.access_type !== accessType) return;

      const newLog: AccessLogPublic = {
        id: `sse-${Date.now()}`,
        patron_id: event.patron_id || null,
        patron_name: event.full_name || null,
        student_code: event.student_code || null,
        access_type: event.access_type || "entry",
        verify_method: "face",
        confidence: event.score || null,
        camera_id: event.camera_id,
        access_time: new Date().toISOString(),
        status: mappedStatus,
      };
      setLogs((prev) => [newLog, ...prev.filter((log) => !log.id.startsWith("sse-")).slice(0, limit - 1)]);
      setTotal((prev) => prev + 1);
    });
    liveCleanup.current = cleanup;
    return cleanup;
  }, [live, skip, search, status, accessType, limit]);

  const handleFilter = () => {
    if (skip === 0) {
      load();
    } else {
      setSkip(0);
    }
  };

  const goToPage = (page: number) => {
    setSkip((page - 1) * limit);
  };

  const entryTotal = useMemo(() => frequency.reduce((sum, day) => sum + day.entry, 0), [frequency]);
  const exitTotal = useMemo(() => frequency.reduce((sum, day) => sum + day.exit, 0), [frequency]);

  return (
    <Stack spacing={3}>
      <Paper variant="outlined" sx={{ p: 3 }}>
        <Stack
          direction={{ xs: "column", lg: "row" }}
          spacing={2}
          sx={{ alignItems: { lg: "center" }, justifyContent: "space-between" }}
        >
          <Box>
            <Stack direction="row" spacing={1.25} sx={{ alignItems: "center" }}>
              <HistoryOutlinedIcon color="primary" />
              <Typography variant="h4" sx={{ fontWeight: 850 }}>
                Lịch sử ra/vào
              </Typography>
            </Stack>
            <Typography color="text.secondary" sx={{ mt: 0.5 }}>
              Tra cứu log theo độc giả, trạng thái, thời gian và theo dõi live từ camera.
            </Typography>
          </Box>
          <Stack direction="row" spacing={1} sx={{ alignItems: "center", flexWrap: "wrap" }}>
            <Chip color={live ? "success" : "default"} icon={<SensorsOutlinedIcon />} label={live ? "Live đang bật" : "Live đang tắt"} />
            <Chip label={`Tổng: ${total}`} />
          </Stack>
        </Stack>
      </Paper>

      <Paper variant="outlined" sx={{ p: 2.5 }}>
        <Stack direction="row" spacing={1.25} sx={{ alignItems: "center", mb: 2 }}>
          <FilterAltOutlinedIcon color="disabled" />
          <Typography variant="h6" sx={{ fontWeight: 850 }}>
            Bộ lọc
          </Typography>
        </Stack>

        <Grid container spacing={1.5} sx={{ alignItems: "center" }}>
          <Grid size={{ xs: 12, md: 3 }}>
            <TextField
              label="Tìm kiếm"
              placeholder="MSSV hoặc tên..."
              value={search}
              onChange={(event) => setSearch(event.target.value)}
              onKeyDown={(event) => event.key === "Enter" && handleFilter()}
              fullWidth
              size="small"
              slotProps={{
                input: {
                  startAdornment: (
                    <InputAdornment position="start">
                      <SearchOutlinedIcon fontSize="small" />
                    </InputAdornment>
                  ),
                },
              }}
            />
          </Grid>
          <Grid size={{ xs: 12, sm: 6, md: 1.7 }}>
            <TextField select label="Loại" value={accessType} onChange={(event) => setAccessType(event.target.value)} fullWidth size="small">
              <MenuItem value="">Tất cả</MenuItem>
              <MenuItem value="entry">Vào</MenuItem>
              <MenuItem value="exit">Ra</MenuItem>
            </TextField>
          </Grid>
          <Grid size={{ xs: 12, sm: 6, md: 1.9 }}>
            <TextField select label="Kết quả" value={status} onChange={(event) => setStatus(event.target.value)} fullWidth size="small">
              <MenuItem value="">Tất cả</MenuItem>
              <MenuItem value="success">Thành công</MenuItem>
              <MenuItem value="failed">Thất bại</MenuItem>
              <MenuItem value="expired">Hết hạn</MenuItem>
              <MenuItem value="spoof">Giả mạo</MenuItem>
            </TextField>
          </Grid>
          <Grid size={{ xs: 12, sm: 6, md: 1.8 }}>
            <TextField
              label="Từ ngày"
              type="date"
              value={dateFrom}
              onChange={(event) => setDateFrom(event.target.value)}
              fullWidth
              size="small"
              slotProps={{ inputLabel: { shrink: true } }}
            />
          </Grid>
          <Grid size={{ xs: 12, sm: 6, md: 1.8 }}>
            <TextField
              label="Đến ngày"
              type="date"
              value={dateTo}
              onChange={(event) => setDateTo(event.target.value)}
              fullWidth
              size="small"
              slotProps={{ inputLabel: { shrink: true } }}
            />
          </Grid>
          <Grid size={{ xs: 12, md: 1.3 }}>
            <Button variant="contained" onClick={handleFilter} disabled={loading} fullWidth>
              Lọc
            </Button>
          </Grid>
          <Grid size={{ xs: 12, md: 1.5 }}>
            <Stack direction="row" spacing={0.5} sx={{ alignItems: "center", justifyContent: { xs: "flex-start", md: "flex-end" } }}>
              <Typography variant="body2" color="text.secondary">Live</Typography>
              <Switch checked={live} onChange={(event) => setLive(event.target.checked)} />
            </Stack>
          </Grid>
        </Grid>
      </Paper>

      <Grid container spacing={2}>
        <Grid size={{ xs: 12, md: 8 }}>
          <Paper variant="outlined" sx={{ p: 2.5, height: "100%" }}>
            <Stack direction="row" spacing={1.25} sx={{ alignItems: "center", mb: 2 }}>
              <BarChartOutlinedIcon color="disabled" />
              <Typography variant="h6" sx={{ fontWeight: 850 }}>
                Tần suất ra/vào theo ngày
              </Typography>
            </Stack>

            {freqLoading ? (
              <Stack sx={{ height: 260, alignItems: "center", justifyContent: "center" }}>
                <CircularProgress size={28} />
              </Stack>
            ) : frequency.length === 0 ? (
              <Alert severity="info">Chưa có dữ liệu tần suất trong khoảng thời gian đã chọn.</Alert>
            ) : (
              <Box sx={{ height: 270 }}>
                <ResponsiveContainer width="100%" height="100%">
                  <BarChart data={frequency} margin={{ top: 8, right: 20, left: -10, bottom: 0 }}>
                    <CartesianGrid strokeDasharray="3 3" stroke={theme.palette.divider} />
                    <XAxis
                      dataKey="date"
                      fontSize={12}
                      tick={{ fill: theme.palette.text.secondary }}
                      tickFormatter={(value: string) => new Date(`${value}T00:00:00`).toLocaleDateString("vi-VN", { day: "2-digit", month: "2-digit" })}
                    />
                    <YAxis allowDecimals={false} fontSize={12} tick={{ fill: theme.palette.text.secondary }} />
                    <Tooltip
                      cursor={{ fill: theme.palette.action.hover }}
                      contentStyle={{
                        background: theme.palette.background.paper,
                        border: `1px solid ${theme.palette.divider}`,
                        borderRadius: 8,
                        color: theme.palette.text.primary,
                      }}
                      labelFormatter={(value) => new Date(`${value}T00:00:00`).toLocaleDateString("vi-VN", {
                        weekday: "long",
                        day: "2-digit",
                        month: "2-digit",
                        year: "numeric",
                      })}
                    />
                    <Legend />
                    <Bar dataKey="entry" fill={theme.palette.success.main} name="Vào" radius={[5, 5, 0, 0]} />
                    <Bar dataKey="exit" fill={theme.palette.warning.main} name="Ra" radius={[5, 5, 0, 0]} />
                  </BarChart>
                </ResponsiveContainer>
              </Box>
            )}
          </Paper>
        </Grid>

        <Grid size={{ xs: 12, md: 4 }}>
          <Stack spacing={2} sx={{ height: "100%" }}>
            <Card variant="outlined" sx={{ flex: 1 }}>
              <CardContent>
                <Stack direction="row" spacing={1.5} sx={{ alignItems: "center" }}>
                  <LoginOutlinedIcon color="success" />
                  <Box>
                    <Typography color="text.secondary">Lượt vào trong biểu đồ</Typography>
                    <Typography variant="h4" sx={{ fontWeight: 850 }}>{entryTotal}</Typography>
                  </Box>
                </Stack>
              </CardContent>
            </Card>
            <Card variant="outlined" sx={{ flex: 1 }}>
              <CardContent>
                <Stack direction="row" spacing={1.5} sx={{ alignItems: "center" }}>
                  <LogoutOutlinedIcon color="warning" />
                  <Box>
                    <Typography color="text.secondary">Lượt ra trong biểu đồ</Typography>
                    <Typography variant="h4" sx={{ fontWeight: 850 }}>{exitTotal}</Typography>
                  </Box>
                </Stack>
              </CardContent>
            </Card>
          </Stack>
        </Grid>
      </Grid>

      <Paper variant="outlined" sx={{ overflow: "hidden" }}>
        <Stack direction={{ xs: "column", md: "row" }} spacing={1.5} sx={{ p: 2, alignItems: { md: "center" }, justifyContent: "space-between" }}>
          <Box>
            <Typography variant="h6" sx={{ fontWeight: 850 }}>
              Nhật ký truy cập
            </Typography>
            <Typography color="text.secondary" variant="body2">
              Trang {currentPage} / {totalPages}
            </Typography>
          </Box>
          {error && <Alert severity="error" sx={{ py: 0 }}>{error}</Alert>}
        </Stack>

        <TableContainer>
          <Table size="small" sx={{ minWidth: 980 }}>
            <TableHead>
              <TableRow>
                <TableCell>Thời gian</TableCell>
                <TableCell>Độc giả</TableCell>
                <TableCell>MSSV</TableCell>
                <TableCell>Loại</TableCell>
                <TableCell>Phương thức</TableCell>
                <TableCell>Cổng</TableCell>
                <TableCell>Độ tin cậy</TableCell>
                <TableCell>Kết quả</TableCell>
              </TableRow>
            </TableHead>
            <TableBody>
              {loading && logs.length === 0 ? (
                <TableRow>
                  <TableCell colSpan={8}>
                    <Stack sx={{ py: 6, alignItems: "center" }}>
                      <CircularProgress size={28} />
                    </Stack>
                  </TableCell>
                </TableRow>
              ) : logs.length === 0 ? (
                <TableRow>
                  <TableCell colSpan={8}>
                    <Alert severity="info">Không có dữ liệu lịch sử phù hợp.</Alert>
                  </TableCell>
                </TableRow>
              ) : (
                logs.map((log) => {
                  const confidence = log.confidence == null ? null : Math.round(log.confidence * 100);
                  const statusColor = getStatusColor(log.status);
                  return (
                    <TableRow key={log.id} hover>
                      <TableCell sx={{ whiteSpace: "nowrap", fontFamily: "monospace", color: "text.secondary" }}>
                        {new Date(log.access_time).toLocaleString("vi-VN")}
                      </TableCell>
                      <TableCell sx={{ fontWeight: 700 }}>{log.patron_name || "-"}</TableCell>
                      <TableCell sx={{ fontFamily: "monospace", color: "text.secondary" }}>{log.student_code || "-"}</TableCell>
                      <TableCell>
                        <Chip
                          size="small"
                          color={log.access_type === "entry" ? "success" : "warning"}
                          label={log.access_type === "entry" ? "Vào" : "Ra"}
                        />
                      </TableCell>
                      <TableCell sx={{ color: "text.secondary" }}>{log.verify_method}</TableCell>
                      <TableCell sx={{ fontFamily: "monospace", color: "text.secondary" }}>
                        {CAMERA_LABELS[log.camera_id] || log.camera_id}
                      </TableCell>
                      <TableCell sx={{ minWidth: 150 }}>
                        {confidence == null ? (
                          <Typography color="text.secondary">-</Typography>
                        ) : (
                          <Stack direction="row" spacing={1} sx={{ alignItems: "center" }}>
                            <LinearProgress
                              variant="determinate"
                              value={confidence}
                              color={confidence >= 80 ? "success" : confidence >= 60 ? "warning" : "error"}
                              sx={{ width: 80, height: 7, borderRadius: 99 }}
                            />
                            <Typography variant="caption" color="text.secondary">{confidence}%</Typography>
                          </Stack>
                        )}
                      </TableCell>
                      <TableCell>
                        <Chip size="small" color={statusColor} label={getStatusLabel(log.status)} />
                      </TableCell>
                    </TableRow>
                  );
                })
              )}
            </TableBody>
          </Table>
        </TableContainer>

        <Stack
          direction={{ xs: "column", sm: "row" }}
          spacing={1.5}
          sx={{ p: 2, borderTop: `1px solid ${theme.palette.divider}`, alignItems: { sm: "center" }, justifyContent: "space-between" }}
        >
          <TextField
            select
            label="Số dòng"
            value={limit}
            onChange={(event) => { setLimit(Number(event.target.value)); setSkip(0); }}
            size="small"
            sx={{ width: 120 }}
          >
            {PAGE_SIZES.map((size) => (
              <MenuItem key={size} value={size}>{size}</MenuItem>
            ))}
          </TextField>

          <Stack direction="row" spacing={1} sx={{ alignItems: "center" }}>
            <Button variant="outlined" disabled={currentPage <= 1} onClick={() => goToPage(1)}>
              Đầu
            </Button>
            <Button variant="outlined" disabled={currentPage <= 1} onClick={() => goToPage(currentPage - 1)}>
              Trước
            </Button>
            <Typography color="text.secondary" sx={{ px: 1 }}>
              {currentPage} / {totalPages}
            </Typography>
            <Button variant="outlined" disabled={currentPage >= totalPages} onClick={() => goToPage(currentPage + 1)}>
              Sau
            </Button>
            <Button variant="outlined" disabled={currentPage >= totalPages} onClick={() => goToPage(totalPages)}>
              Cuối
            </Button>
          </Stack>
        </Stack>
      </Paper>
    </Stack>
  );
}
