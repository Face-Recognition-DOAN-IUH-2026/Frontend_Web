<file path="src/app/(dashboard)/_components/return/ReturnActiveBorrows.tsx">
"use client";

import {
  Avatar,
  Box,
  Button,
  Chip,
  Paper,
  Stack,
  Tooltip,
  Typography,
} from "@mui/material";
import BookIcon from "@mui/icons-material/MenuBookOutlined";
import CheckCircleIcon from "@mui/icons-material/CheckCircleOutlineOutlined";
import UsersIcon from "@mui/icons-material/GroupsOutlined";
import { usePermission, getPermissionDeniedReason } from "@/lib/permission-context";
import DashboardCard from "@/app/(dashboard)/_components/ui/DashboardCard";
import EmptyState from "@/app/(dashboard)/_components/ui/EmptyState";
import LoadingOverlay from "@/app/(dashboard)/_components/ui/LoadingOverlay";
import type { BorrowRecord, StaffActiveBorrowerSummary, StaffPatronActiveBorrowsResponse } from "@/lib/types";
import {
  CONDITION_LABELS,
  COPY_STATUS_LABELS,
  getConditionColor,
  getStatusColor,
  CopyCondition,
  CopyStatus,
} from "@/lib/constants/copy";

function isOverdue(record: BorrowRecord) {
  return new Date(record.due_at) < new Date();
}

function daysUntil(value: string) {
  const today = new Date();
  const due = new Date(value);
  today.setHours(0, 0, 0, 0);
  due.setHours(0, 0, 0, 0);
  return Math.ceil((due.getTime() - today.getTime()) / 86400000);
}

function formatDate(value?: string) {
  if (!value) return "-";
  return new Date(value).toLocaleDateString("vi-VN");
}

function dueChip(record: BorrowRecord) {
  const left = daysUntil(record.due_at);
  if (left < 0) return <Chip size="small" color="error" label={`Quá hạn ${Math.abs(left)} ngày`} sx={{ height: 20, fontSize: 11 }} />;
  if (left <= 2) return <Chip size="small" color="warning" label="Sắp đến hạn" sx={{ height: 20, fontSize: 11 }} />;
  return <Chip size="small" color="success" label="Đúng hạn" sx={{ height: 20, fontSize: 11 }} />;
}

interface ReturnActiveBorrowsProps {
  selectedBorrower: StaffActiveBorrowerSummary | null;
  detail: StaffPatronActiveBorrowsResponse | null;
  loadingDetail: boolean;
  returningId: string | null;
  onConfirmReturn: (record: BorrowRecord) => void;
}

export default function ReturnActiveBorrows({
  selectedBorrower,
  detail,
  loadingDetail,
  returningId,
  onConfirmReturn,
}: ReturnActiveBorrowsProps) {
  const { can } = usePermission();
  const canUpdateBorrow = can("borrows", "update");

  if (!selectedBorrower) {
    return (
      <DashboardCard>
        <EmptyState
          icon={<UsersIcon sx={{ fontSize: 64, opacity: 0.3 }} />}
          title="Chọn độc giả để xem sách cần trả"
          description="Chọn một độc giả từ danh sách bên trái để kiểm tra danh sách sách đang mượn"
        />
      </DashboardCard>
    );
  }

  return (
    <DashboardCard
      title="Sách cần trả"
      actions={detail ? <Chip size="small" label={`${detail.total} cuốn`} sx={{ fontWeight: 700 }} /> : null}
    >
      {loadingDetail ? (
        <LoadingOverlay loading message="Đang tải danh sách sách..." />
      ) : !detail || detail.records.length === 0 ? (
        <EmptyState
          icon={<CheckCircleIcon sx={{ fontSize: 56, color: "success.main" }} />}
          title="Độc giả đã trả hết sách"
          description="Hiện tại độc giả này không còn cuốn sách nào đang mượn."
        />
      ) : (
        <Stack spacing={1.5}>
          {detail.records.map((record) => (
            <Paper
              key={record.id}
              variant="outlined"
              sx={{
                p: 1.5,
                borderRadius: 2,
                borderLeft: isOverdue(record) ? 4 : 1,
                borderLeftColor: isOverdue(record) ? "error.main" : "divider",
                bgcolor: "background.paper",
              }}
            >
              <Stack direction="row" spacing={1.5} sx={{ alignItems: "flex-start" }}>
                {record.book?.cover_url ? (
                  <Box
                    component="img"
                    src={record.book.cover_url}
                    alt={record.book.title}
                    sx={{ width: 44, height: 62, objectFit: "cover", borderRadius: 1, flexShrink: 0 }}
                  />
                ) : (
                  <Avatar variant="rounded" sx={{ width: 44, height: 62, bgcolor: "action.hover", color: "text.secondary", flexShrink: 0 }}>
                    <BookIcon />
                  </Avatar>
                )}
                <Stack spacing={0.4} sx={{ flex: 1, minWidth: 0 }}>
                  <Typography variant="body2" sx={{ fontWeight: 700, fontSize: 14 }} noWrap>
                    {record.book?.title || record.book_id}
                  </Typography>
                  <Typography variant="caption" color="text.secondary" noWrap>
                    {record.book?.author || "Chưa rõ tác giả"}
                  </Typography>
                  <Stack direction="row" spacing={1} sx={{ alignItems: "center", flexWrap: "wrap", gap: 0.5 }}>
                    <Typography variant="caption" sx={{ fontFamily: "JetBrains Mono, monospace", color: "primary.main", fontWeight: 600 }}>
                      {record.book?.isbn}
                    </Typography>
                    {dueChip(record)}
                    {record.copy?.condition && (
                      <Chip
                        size="small"
                        color={getConditionColor(record.copy.condition)}
                        label={CONDITION_LABELS[record.copy.condition as CopyCondition] || record.copy.condition}
                        sx={{ height: 20, fontSize: 11 }}
                      />
                    )}
                    {record.copy?.status && (
                      <Chip
                        size="small"
                        color={getStatusColor(record.copy.status)}
                        label={COPY_STATUS_LABELS[record.copy.status as CopyStatus] || record.copy.status}
                        sx={{ height: 20, fontSize: 11 }}
                      />
                    )}
                  </Stack>
                  <Typography variant="caption" color="text.secondary">
                    {record.copy?.barcode ? `Mã: ${record.copy.barcode} | ` : ""}Mượn: {formatDate(record.borrow_at)} | Hạn: {formatDate(record.due_at)}
                  </Typography>
                </Stack>
                <Tooltip title={!canUpdateBorrow ? getPermissionDeniedReason("borrows", "update") : ""}>
                  <span>
                    <Button
                      size="small"
                      variant="contained"
                      color="success"
                      startIcon={<CheckCircleIcon />}
                      disabled={!!returningId || !canUpdateBorrow}
                      onClick={() => {
                        if (!canUpdateBorrow) return;
                        onConfirmReturn(record);
                      }}
                      sx={{ flexShrink: 0, alignSelf: "center", textTransform: "none", fontWeight: 700 }}
                    >
                      Trả
                    </Button>
                  </span>
                </Tooltip>
              </Stack>
            </Paper>
          ))}
        </Stack>
      )}
    </DashboardCard>
  );
}
</file>

<file path="src/app/(dashboard)/_components/staff-schedule/AssignmentCard.tsx">
"use client";

import { useState } from "react";
import { Box, Chip, IconButton, Tooltip, Typography } from "@mui/material";
import CloseIcon from "@mui/icons-material/Close";
import WarningAmberIcon from "@mui/icons-material/WarningAmberOutlined";
import CancelIcon from "@mui/icons-material/CancelOutlined";
import type { StaffScheduleAssignment } from "@/lib/types";

interface AssignmentCardProps {
  assignment: StaffScheduleAssignment;
  onDelete?: (id: string) => void;
  understaffed?: boolean;
}

type StatusKey = "past" | "active" | "future" | "today" | "understaffed" | "cancelled" | "completed";

const STATUS_META: Record<StatusKey, { label: string; chipColor: "default" | "success" | "primary" | "warning" | "error"; accentBorder?: string }> = {
  past:         { label: "Đã qua",     chipColor: "default" },
  active:       { label: "Đang trực",  chipColor: "success", accentBorder: "#10b981" },
  future:       { label: "Sắp tới",    chipColor: "primary" },
  today:        { label: "Hôm nay",    chipColor: "warning", accentBorder: "#f59e0b" },
  understaffed: { label: "Thiếu người", chipColor: "warning" },
  cancelled:    { label: "Đã hủy",     chipColor: "error" },
  completed:    { label: "Hoàn thành", chipColor: "default" },
};

function getStatus(assignment: StaffScheduleAssignment): StatusKey {
  if (assignment.status === "cancelled") return "cancelled";
  if (assignment.status === "completed") return "completed";
  const now = new Date();
  const today = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, "0")}-${String(now.getDate()).padStart(2, "0")}`;
  if (assignment.workDate < today) return "past";
  if (assignment.workDate > today) return "future";
  const current = `${String(now.getHours()).padStart(2, "0")}:${String(now.getMinutes()).padStart(2, "0")}`;
  const start = (assignment.shift?.startTime || "").slice(0, 5);
  const end = (assignment.shift?.endTime || "").slice(0, 5);
  if (start && end && current >= start && current <= end) return "active";
  return "today";
}

export default function AssignmentCard({ assignment, onDelete, understaffed }: AssignmentCardProps) {
  const [hover, setHover] = useState(false);
  const baseStatus = getStatus(assignment);
  const status: StatusKey = understaffed ? "understaffed" : baseStatus;
  const meta = STATUS_META[status];
  const displayName = assignment.staff?.fullName || assignment.staff?.email || "Nhân viên";
  const zoneName = assignment.zone?.zoneName || "";

  const isGround = status === "past" || status === "completed" || status === "future";
  const isFigure = status === "active" || status === "today";
  const isUnderstaffed = status === "understaffed";
  const isCancelled = status === "cancelled";

  return (
    <Box
      onMouseEnter={() => setHover(true)}
      onMouseLeave={() => setHover(false)}
      sx={{
        position: "relative",
        px: 1.5,
        py: 1,
        borderRadius: 1,
        border: "1px solid",
        borderColor: isCancelled
          ? "rgba(239,68,68,0.25)"
          : isUnderstaffed
          ? "rgba(251,146,60,0.35)"
          : isFigure
          ? "transparent"
          : "action.hover",
        borderLeftWidth: isFigure ? 3 : 1,
        borderLeftColor: meta.accentBorder,
        bgcolor: isCancelled
          ? "rgba(239,68,68,0.06)"
          : isUnderstaffed
          ? "rgba(251,146,60,0.08)"
          : isFigure
          ? "rgba(99,102,241,0.04)"
          : "background.paper",
        backgroundImage: isCancelled
          ? "repeating-linear-gradient(135deg, transparent, transparent 4px, rgba(239,68,68,0.06) 4px, rgba(239,68,68,0.06) 8px)"
          : "none",
        transition: "background 0.15s, border-color 0.15s",
        "&:hover": onDelete ? { borderColor: "action.focus" } : undefined,
      }}
    >
      {zoneName ? (
        <Typography
          variant="caption"
          sx={{ fontSize: "0.625rem", fontWeight: 500, color: "text.secondary", lineHeight: 1.2, display: "block", mb: 0.25 }}
        >
          {zoneName}
        </Typography>
      ) : null}
      <Typography
        variant="caption"
        sx={{
          fontWeight: 600,
          color: isCancelled ? "error.main" : isUnderstaffed ? "warning.dark" : isFigure ? "text.primary" : "text.secondary",
          display: "block",
          overflow: "hidden",
          textOverflow: "ellipsis",
          whiteSpace: "nowrap",
        }}
      >
        {displayName}
      </Typography>

      <Chip
        icon={isUnderstaffed ? <WarningAmberIcon sx={{ fontSize: 12 }} /> : isCancelled ? <CancelIcon sx={{ fontSize: 12 }} /> : undefined}
        label={meta.label}
        size="small"
        color={meta.chipColor}
        variant={isGround ? "outlined" : "filled"}
        sx={{
          mt: 0.5,
          height: 18,
          fontSize: "0.6rem",
          fontWeight: 700,
          "& .MuiChip-label": { px: 0.75 },
        }}
      />

      {onDelete ? (
        <Tooltip title="Xóa ca trực">
          <IconButton
            size="small"
            onClick={(e) => { e.stopPropagation(); onDelete(assignment.id); }}
            sx={{
              position: "absolute",
              top: -4,
              right: -4,
              width: 18,
              height: 18,
              bgcolor: "background.paper",
              border: "1px solid rgba(239,68,68,0.3)",
              color: "#ef4444",
              opacity: { xs: 1, md: hover ? 1 : 0 },
              transition: "opacity 0.15s",
              "&:hover": { bgcolor: "rgba(239,68,68,0.1)" },
              "& .MuiIconButton-root": { p: 0 },
            }}
          >
            <CloseIcon sx={{ fontSize: 10 }} />
          </IconButton>
        </Tooltip>
      ) : null}
    </Box>
  );
}
</file>

