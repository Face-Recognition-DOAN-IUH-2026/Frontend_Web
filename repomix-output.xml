<file path="src/hooks/useScheduleData.ts">
"use client";

import { useCallback, useEffect, useMemo, useState } from "react";
import api, { getErrorMessage } from "@/lib/api-client";
import { useAuth } from "@/lib/auth-context";
import type { ScheduleStaff, LibraryZone, StaffShift, StaffScheduleAssignment } from "@/lib/types";

export function startOfWeek(date = new Date()) {
  const value = new Date(date);
  const day = value.getDay() || 7;
  value.setDate(value.getDate() - day + 1);
  value.setHours(0, 0, 0, 0);
  return value;
}

export function getWeekDays(anchor: Date) {
  return Array.from({ length: 7 }, (_, i) => {
    const d = new Date(anchor);
    d.setDate(anchor.getDate() + i);
    return d;
  });
}

export function toDateInput(date: Date) {
  const y = date.getFullYear();
  const m = String(date.getMonth() + 1).padStart(2, "0");
  const d = String(date.getDate()).padStart(2, "0");
  return `${y}-${m}-${d}`;
}

export function formatDateRange(days: Date[]) {
  const from = days[0].toLocaleDateString("vi-VN", { day: "2-digit", month: "2-digit" });
  const to = days[6].toLocaleDateString("vi-VN", { day: "2-digit", month: "2-digit", year: "numeric" });
  return `${from} — ${to}`;
}

export interface ScheduleData {
  staff: ScheduleStaff[];
  zones: LibraryZone[];
  shifts: StaffShift[];
  assignments: StaffScheduleAssignment[];
  loading: boolean;
  error: string | null;
  weekStart: Date;
  days: Date[];
  from: string;
  to: string;
  goPrevWeek: () => void;
  goNextWeek: () => void;
  goToday: () => void;
  loadData: () => Promise<void>;
  setError: React.Dispatch<React.SetStateAction<string | null>>;
}

export function useScheduleData(): ScheduleData {
  const { user } = useAuth();
  const isAdmin = user?.role === "admin";
  const isStaff = !!user;
  const [weekStart, setWeekStart] = useState(startOfWeek);
  const [staff, setStaff] = useState<ScheduleStaff[]>([]);
  const [zones, setZones] = useState<LibraryZone[]>([]);
  const [shifts, setShifts] = useState<StaffShift[]>([]);
  const [assignments, setAssignments] = useState<StaffScheduleAssignment[]>([]);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState<string | null>(null);

  const days = useMemo(() => getWeekDays(weekStart), [weekStart]);
  const from = toDateInput(days[0]);
  const to = toDateInput(days[6]);

  const loadData = useCallback(async () => {
    if (!isStaff) return;
    setLoading(true);
    setError(null);
    try {
      if (isAdmin) {
        const [staffResult, zoneResult, shiftResult, assignmentResult] = await Promise.all([
          api.getScheduleStaffOptions(),
          api.getScheduleZones(),
          api.getScheduleShifts(),
          api.getScheduleAssignments({ from, to }),
        ]);
        setStaff(staffResult.filter((s) => s.role === "admin" || s.role === "staff"));
        setZones(zoneResult.filter((z) => z.isActive));
        setShifts(shiftResult.filter((s) => s.isActive));
        setAssignments(assignmentResult.items);
      } else {
        const [result, staffResult, shiftResult, zoneResult] = await Promise.all([
          api.getMySchedules({ from, to }),
          api.getScheduleStaffOptions(),
          api.getScheduleShifts(),
          api.getScheduleZones(),
        ]);
        setAssignments(result.items);
        setStaff(staffResult.filter((s) => s.role === "admin" || s.role === "staff"));
        setShifts(shiftResult.filter((s) => s.isActive));
        setZones(zoneResult.filter((z) => z.isActive));
      }
    } catch (err) {
      setError(getErrorMessage(err));
    } finally {
      setLoading(false);
    }
  }, [from, isAdmin, isStaff, to]);

  useEffect(() => { loadData(); }, [loadData]);

  const goPrevWeek = useCallback(() => {
    setWeekStart((prev) => { const d = new Date(prev); d.setDate(d.getDate() - 7); return d; });
  }, []);

  const goNextWeek = useCallback(() => {
    setWeekStart((prev) => { const d = new Date(prev); d.setDate(d.getDate() + 7); return d; });
  }, []);

  const goToday = useCallback(() => { setWeekStart(startOfWeek()); }, []);

  return {
    staff, zones, shifts, assignments, loading, error,
    weekStart, days, from, to,
    goPrevWeek, goNextWeek, goToday, loadData, setError,
  };
}
</file>

<file path="src/hooks/useScheduleFilters.ts">
"use client";

import { useMemo, useState } from "react";
import type { LibraryZone, ScheduleStaff, StaffScheduleAssignment, StaffShift } from "@/lib/types";

export interface ScheduleFilters {
  filter: string;
  zoneFilter: string;
  shiftFilter: string;
  setFilter: (v: string) => void;
  setZoneFilter: (v: string) => void;
  setShiftFilter: (v: string) => void;
  shiftList: StaffShift[];
  filteredAssignments: StaffScheduleAssignment[];
  filteredShifts: StaffShift[];
  weekStats: { total: number; active: number; staffCount: number };
}

export function useScheduleFilters(
  assignments: StaffScheduleAssignment[],
  shifts: StaffShift[],
  staff: ScheduleStaff[],
  zones: LibraryZone[],
): ScheduleFilters {
  const [filter, setFilter] = useState("all");
  const [zoneFilter, setZoneFilter] = useState("");
  const [shiftFilter, setShiftFilter] = useState("");

  const shiftList = useMemo(() => {
    return [...shifts].sort((a, b) => (a.startTime || "").localeCompare(b.startTime || ""));
  }, [shifts]);

  const filteredAssignments = useMemo(() => {
    return assignments.filter((a) => {
      if (zoneFilter && a.zoneId !== zoneFilter) return false;
      if (shiftFilter && a.shiftId !== shiftFilter) return false;
      return true;
    });
  }, [assignments, zoneFilter, shiftFilter]);

  const filteredShifts = useMemo(() => {
    if (!shiftFilter) return shiftList;
    return shiftList.filter((s) => s.id === shiftFilter);
  }, [shiftList, shiftFilter]);

  const weekStats = useMemo(() => {
    const total = assignments.filter((a) => a.status !== "cancelled").length;
    const today = new Date().toISOString().slice(0, 10);
    const active = assignments.filter((a) => a.status !== "cancelled" && a.workDate === today).length;
    return { total, active, staffCount: staff.length };
  }, [assignments, staff]);

  return {
    filter, zoneFilter, shiftFilter,
    setFilter, setZoneFilter, setShiftFilter,
    shiftList, filteredAssignments, filteredShifts, weekStats,
  };
}
</file>

<file path="src/middleware.ts">
import { NextResponse } from "next/server";
import type { NextRequest } from "next/server";
import { jwtVerify } from "jose";

const publicPaths = ["/login", "/register", "/", "/library/vr-tour"];

const JWT_SECRET = new TextEncoder().encode(
  process.env.JWT_ACCESS_SECRET || process.env.JWT_SECRET || ""
);

export async function middleware(request: NextRequest) {
  const path = request.nextUrl.pathname;

  if (publicPaths.includes(path)) {
    return NextResponse.next();
  }

  const token = request.cookies.get("access_token")?.value;
  if (!token) {
    const loginUrl = new URL("/login", request.url);
    loginUrl.searchParams.set("redirect", path);
    return NextResponse.redirect(loginUrl);
  }

  try {
    const { payload } = await jwtVerify(token, JWT_SECRET, {
      algorithms: ["HS256"],
      issuer: process.env.JWT_ISSUER || undefined,
      audience: process.env.JWT_AUDIENCE || undefined,
    });

    const role =
      (payload.roles as string[])?.[0] ||
      (payload.role as string) ||
      null;
    if (role !== "admin" && role !== "staff") {
      const loginUrl = new URL("/login", request.url);
      loginUrl.searchParams.set("reason", "staff-only");
      const response = NextResponse.redirect(loginUrl);
      response.cookies.delete("access_token");
      return response;
    }

    return NextResponse.next();
  } catch (err: any) {
    const loginUrl = new URL("/login", request.url);
    if (err.code === "ERR_JWT_EXPIRED") {
      loginUrl.searchParams.set("reason", "token-expired");
    } else {
      loginUrl.searchParams.set("reason", "invalid-token");
    }
    const response = NextResponse.redirect(loginUrl);
    response.cookies.delete("access_token");
    return response;
  }
}

export const config = {
  matcher: ["/((?!api|_next/static|_next/image|favicon.ico|VRLIB/).*)"],
};
</file>

