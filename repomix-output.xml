"use client";

import { useCallback, useEffect, useMemo, useRef, useState } from "react";
import {
  Alert,
  Box,
  Button,
  Card,
  CardContent,
  Chip,
  CircularProgress,
  Grid,
  InputAdornment,
  LinearProgress,
  MenuItem,
  Paper,
  Stack,
  Switch,
  Table,
  TableBody,
  TableCell,
  TableContainer,
  TableHead,
  TableRow,
  TextField,
  Typography,
  useTheme,
} from "@mui/material";
import BarChartOutlinedIcon from "@mui/icons-material/BarChartOutlined";
import FilterAltOutlinedIcon from "@mui/icons-material/FilterAltOutlined";
import HistoryOutlinedIcon from "@mui/icons-material/HistoryOutlined";
import LoginOutlinedIcon from "@mui/icons-material/LoginOutlined";
import LogoutOutlinedIcon from "@mui/icons-material/LogoutOutlined";
import SearchOutlinedIcon from "@mui/icons-material/SearchOutlined";
import SensorsOutlinedIcon from "@mui/icons-material/SensorsOutlined";
import {
  Bar,
  BarChart,
  CartesianGrid,
  Legend,
  ResponsiveContainer,
  Tooltip,
  XAxis,
  YAxis,
} from "recharts";
import api from "@/lib/api-client";
import { fadeInUp, shimmer, slideInRight, successPop } from "@/lib/animations";
import type { AccessFrequencyDay, AccessLogPublic, CameraEvent } from "@/lib/types";

const PAGE_SIZES = [20, 50, 100];

const CAMERA_LABELS: Record<string, string> = {
  entry_gate: "Cổng vào",
  exit_gate: "Cổng ra",
  kiosk: "Kiosk",
  web_login: "Đăng nhập web",
};

function getStatusLabel(status: string) {
  if (status === "success" || status === "granted") return "Thành công";
  if (status === "expired") return "Hết hạn";
  if (status === "spoof") return "Giả mạo";
  return "Thất bại";
}

function getStatusColor(status: string): "success" | "warning" | "error" {
  if (status === "success" || status === "granted") return "success";
  if (status === "expired") return "warning";
  return "error";
}

function mapEventStatus(status: CameraEvent["status"]) {
  return status === "granted" ? "success" : status;
}

export default function HistoryPage() {
  const theme = useTheme();
  const [logs, setLogs] = useState<AccessLogPublic[]>([]);
  const [total, setTotal] = useState(0);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState<string | null>(null);
  const [live, setLive] = useState(true);

  const [search, setSearch] = useState("");
  const [accessType, setAccessType] = useState("");
  const [status, setStatus] = useState("");
  const [dateFrom, setDateFrom] = useState("");
  const [dateTo, setDateTo] = useState("");

  const [skip, setSkip] = useState(0);
  const [limit, setLimit] = useState(50);
  const totalPages = Math.max(1, Math.ceil(total / limit));
  const currentPage = Math.floor(skip / limit) + 1;

  const [frequency, setFrequency] = useState<AccessFrequencyDay[]>([]);
  const [freqLoading, setFreqLoading] = useState(false);

  const load = useCallback(async () => {
    setLoading(true);
    try {
      setError(null);
      const data = await api.getAccessLogs({
        search: search || undefined,
        accessType: accessType || undefined,
        status: status || undefined,
        dateFrom: dateFrom || undefined,
        dateTo: dateTo || undefined,
        skip,
        limit,
      });
      setLogs(data.items);
      setTotal(data.total);
    } catch {
      setError("Không thể tải lịch sử ra/vào.");
    } finally {
      setLoading(false);
    }
  }, [search, accessType, status, dateFrom, dateTo, skip, limit]);

  useEffect(() => { load(); }, [load]);

  useEffect(() => {
    (async () => {
      setFreqLoading(true);
      try {
        const data = await api.getAccessFrequency({
          dateFrom: dateFrom || undefined,
          dateTo: dateTo || undefined,
        });
        setFrequency(Array.isArray(data.daily) ? data.daily : []);
      } finally {
        setFreqLoading(false);
      }
    })();
  }, [dateFrom, dateTo]);

  const liveCleanup = useRef<(() => void) | null>(null);
  useEffect(() => {
    if (!live || skip !== 0) {
      if (liveCleanup.current) {
        liveCleanup.current();
        liveCleanup.current = null;
      }
      return;
    }

    const cleanup = api.connectAccessSSE((event: CameraEvent) => {
      const mappedStatus = mapEventStatus(event.status);
      if (search) {
        const q = search.toLowerCase();
        if (!event.full_name?.toLowerCase().includes(q) && !event.student_code?.toLowerCase().includes(q)) return;
      }
      if (status && mappedStatus !== status) return;
      if (accessType && event.access_type !== accessType) return;

      const newLog: AccessLogPublic = {
        id: `sse-${Date.now()}`,
        patron_id: event.patron_id || null,
        patron_name: event.full_name || null,
        student_code: event.student_code || null,
        access_type: event.access_type || "entry",
        verify_method: "face",
        confidence: event.score || null,
        camera_id: event.camera_id,
        access_time: new Date().toISOString(),
        status: mappedStatus,
      };
      setLogs((prev) => [newLog, ...prev.filter((log) => !log.id.startsWith("sse-")).slice(0, limit - 1)]);
      setTotal((prev) => prev + 1);
    });
    liveCleanup.current = cleanup;
    return cleanup;
  }, [live, skip, search, status, accessType, limit]);

  const handleFilter = () => {
    if (skip === 0) {
      load();
    } else {
      setSkip(0);
    }
  };

  const goToPage = (page: number) => {
    setSkip((page - 1) * limit);
  };

  const entryTotal = useMemo(() => frequency.reduce((sum, day) => sum + day.entry, 0), [frequency]);
  const exitTotal = useMemo(() => frequency.reduce((sum, day) => sum + day.exit, 0), [frequency]);

  return (
    <Stack spacing={3}>
      <Paper variant="outlined" sx={{ p: 3 }}>
        <Stack
          direction={{ xs: "column", lg: "row" }}
          spacing={2}
          sx={{ alignItems: { lg: "center" }, justifyContent: "space-between" }}
        >
          <Box>
            <Stack direction="row" spacing={1.25} sx={{ alignItems: "center" }}>
              <HistoryOutlinedIcon color="primary" />
              <Typography variant="h4" sx={{ fontWeight: 850 }}>
                Lịch sử ra/vào
              </Typography>
            </Stack>
            <Typography color="text.secondary" sx={{ mt: 0.5 }}>
              Tra cứu log theo độc giả, trạng thái, thời gian và theo dõi live từ camera.
            </Typography>
          </Box>
          <Stack direction="row" spacing={1} sx={{ alignItems: "center", flexWrap: "wrap" }}>
            <Chip color={live ? "success" : "default"} icon={<SensorsOutlinedIcon />} label={live ? "Live đang bật" : "Live đang tắt"} />
            <Chip label={`Tổng: ${total}`} />
          </Stack>
        </Stack>
      </Paper>

      <Paper variant="outlined" sx={{ p: 2.5 }}>
        <Stack direction="row" spacing={1.25} sx={{ alignItems: "center", mb: 2 }}>
          <FilterAltOutlinedIcon color="disabled" />
          <Typography variant="h6" sx={{ fontWeight: 850 }}>
            Bộ lọc
          </Typography>
        </Stack>

        <Grid container spacing={1.5} sx={{ alignItems: "center" }}>
          <Grid size={{ xs: 12, md: 3 }}>
            <TextField
              label="Tìm kiếm"
              placeholder="MSSV hoặc tên..."
              value={search}
              onChange={(event) => setSearch(event.target.value)}
              onKeyDown={(event) => event.key === "Enter" && handleFilter()}
              fullWidth
              size="small"
              slotProps={{
                input: {
                  startAdornment: (
                    <InputAdornment position="start">
                      <SearchOutlinedIcon fontSize="small" />
                    </InputAdornment>
                  ),
                },
              }}
            />
          </Grid>
          <Grid size={{ xs: 12, sm: 6, md: 1.7 }}>
            <TextField select label="Loại" value={accessType} onChange={(event) => setAccessType(event.target.value)} fullWidth size="small">
              <MenuItem value="">Tất cả</MenuItem>
              <MenuItem value="entry">Vào</MenuItem>
              <MenuItem value="exit">Ra</MenuItem>
            </TextField>
          </Grid>
          <Grid size={{ xs: 12, sm: 6, md: 1.9 }}>
            <TextField select label="Kết quả" value={status} onChange={(event) => setStatus(event.target.value)} fullWidth size="small">
              <MenuItem value="">Tất cả</MenuItem>
              <MenuItem value="success">Thành công</MenuItem>
              <MenuItem value="failed">Thất bại</MenuItem>
              <MenuItem value="expired">Hết hạn</MenuItem>
              <MenuItem value="spoof">Giả mạo</MenuItem>
            </TextField>
          </Grid>
          <Grid size={{ xs: 12, sm: 6, md: 1.8 }}>
            <TextField
              label="Từ ngày"
              type="date"
              value={dateFrom}
              onChange={(event) => setDateFrom(event.target.value)}
              fullWidth
              size="small"
              slotProps={{ inputLabel: { shrink: true } }}
            />
          </Grid>
          <Grid size={{ xs: 12, sm: 6, md: 1.8 }}>
            <TextField
              label="Đến ngày"
              type="date"
              value={dateTo}
              onChange={(event) => setDateTo(event.target.value)}
              fullWidth
              size="small"
              slotProps={{ inputLabel: { shrink: true } }}
            />
          </Grid>
          <Grid size={{ xs: 12, md: 1.3 }}>
            <Button variant="contained" onClick={handleFilter} disabled={loading} fullWidth>
              Lọc
            </Button>
          </Grid>
          <Grid size={{ xs: 12, md: 1.5 }}>
            <Stack direction="row" spacing={0.5} sx={{ alignItems: "center", justifyContent: { xs: "flex-start", md: "flex-end" } }}>
              <Typography variant="body2" color="text.secondary">Live</Typography>
              <Switch checked={live} onChange={(event) => setLive(event.target.checked)} />
            </Stack>
          </Grid>
        </Grid>
      </Paper>

      <Grid container spacing={2}>
        <Grid size={{ xs: 12, md: 8 }}>
          <Paper variant="outlined" sx={{ p: 2.5, height: "100%" }}>
            <Stack direction="row" spacing={1.25} sx={{ alignItems: "center", mb: 2 }}>
              <BarChartOutlinedIcon color="disabled" />
              <Typography variant="h6" sx={{ fontWeight: 850 }}>
                Tần suất ra/vào theo ngày
              </Typography>
            </Stack>

            {freqLoading ? (
              <Stack sx={{ height: 260, alignItems: "center", justifyContent: "center" }}>
                <CircularProgress size={28} sx={{ animation: `${shimmer} 1.5s ease-in-out infinite` }} />
              </Stack>
            ) : frequency.length === 0 ? (
              <Alert severity="info">Chưa có dữ liệu tần suất trong khoảng thời gian đã chọn.</Alert>
            ) : (
              <Box sx={{ height: 270 }}>
                <ResponsiveContainer width="100%" height="100%">
                  <BarChart data={frequency} margin={{ top: 8, right: 20, left: -10, bottom: 0 }}>
                    <CartesianGrid strokeDasharray="3 3" stroke={theme.palette.divider} />
                    <XAxis
                      dataKey="date"
                      fontSize={12}
                      tick={{ fill: theme.palette.text.secondary }}
                      tickFormatter={(value: string) => new Date(`${value}T00:00:00`).toLocaleDateString("vi-VN", { day: "2-digit", month: "2-digit" })}
                    />
                    <YAxis allowDecimals={false} fontSize={12} tick={{ fill: theme.palette.text.secondary }} />
                    <Tooltip
                      cursor={{ fill: theme.palette.action.hover }}
                      contentStyle={{
                        background: theme.palette.background.paper,
                        border: `1px solid ${theme.palette.divider}`,
                        borderRadius: 8,
                        color: theme.palette.text.primary,
                      }}
                      labelFormatter={(value) => new Date(`${value}T00:00:00`).toLocaleDateString("vi-VN", {
                        weekday: "long",
                        day: "2-digit",
                        month: "2-digit",
                        year: "numeric",
                      })}
                    />
                    <Legend />
                    <Bar dataKey="entry" fill={theme.palette.success.main} name="Vào" radius={[5, 5, 0, 0]} />
                    <Bar dataKey="exit" fill={theme.palette.warning.main} name="Ra" radius={[5, 5, 0, 0]} />
                  </BarChart>
                </ResponsiveContainer>
              </Box>
            )}
          </Paper>
        </Grid>

        <Grid size={{ xs: 12, md: 4 }}>
          <Stack spacing={2} sx={{ height: "100%" }}>
            <Card variant="outlined" sx={{ flex: 1 }}>
              <CardContent>
                <Stack direction="row" spacing={1.5} sx={{ alignItems: "center" }}>
                  <LoginOutlinedIcon color="success" />
                  <Box>
                    <Typography color="text.secondary">Lượt vào trong biểu đồ</Typography>
                    <Typography variant="h4" sx={{ fontWeight: 850 }}>{entryTotal}</Typography>
                  </Box>
                </Stack>
              </CardContent>
            </Card>
            <Card variant="outlined" sx={{ flex: 1 }}>
              <CardContent>
                <Stack direction="row" spacing={1.5} sx={{ alignItems: "center" }}>
                  <LogoutOutlinedIcon color="warning" />
                  <Box>
                    <Typography color="text.secondary">Lượt ra trong biểu đồ</Typography>
                    <Typography variant="h4" sx={{ fontWeight: 850 }}>{exitTotal}</Typography>
                  </Box>
                </Stack>
              </CardContent>
            </Card>
          </Stack>
        </Grid>
      </Grid>

      <Paper variant="outlined" sx={{ overflow: "hidden" }}>
        <Stack direction={{ xs: "column", md: "row" }} spacing={1.5} sx={{ p: 2, alignItems: { md: "center" }, justifyContent: "space-between" }}>
          <Box>
            <Typography variant="h6" sx={{ fontWeight: 850 }}>
              Nhật ký truy cập
            </Typography>
            <Typography color="text.secondary" variant="body2">
              Trang {currentPage} / {totalPages}
            </Typography>
          </Box>
          {error && <Alert severity="error" sx={{ py: 0 }}>{error}</Alert>}
        </Stack>

        <TableContainer>
          <Table size="small" sx={{ minWidth: 980 }}>
            <TableHead>
              <TableRow>
                <TableCell>Thời gian</TableCell>
                <TableCell>Độc giả</TableCell>
                <TableCell>MSSV</TableCell>
                <TableCell>Loại</TableCell>
                <TableCell>Phương thức</TableCell>
                <TableCell>Cổng</TableCell>
                <TableCell>Độ tin cậy</TableCell>
                <TableCell>Kết quả</TableCell>
              </TableRow>
            </TableHead>
            <TableBody>
              {loading && logs.length === 0 ? (
                <TableRow>
                  <TableCell colSpan={8}>
                    <Stack sx={{ py: 6, alignItems: "center" }}>
                      <CircularProgress size={28} sx={{ animation: `${shimmer} 1.5s ease-in-out infinite` }} />
                    </Stack>
                  </TableCell>
                </TableRow>
              ) : logs.length === 0 ? (
                <TableRow>
                  <TableCell colSpan={8}>
                    <Alert severity="info">Không có dữ liệu lịch sử phù hợp.</Alert>
                  </TableCell>
                </TableRow>
              ) : (
                logs.map((log, idx) => {
                  const confidence = log.confidence == null ? null : Math.round(log.confidence * 100);
                  const statusColor = getStatusColor(log.status);
                  return (
                    <TableRow key={log.id} hover sx={{ animation: `${slideInRight} 0.3s ease-out`, animationDelay: `${idx * 0.03}s`, animationFillMode: "both" }}>
                      <TableCell sx={{ whiteSpace: "nowrap", fontFamily: "monospace", color: "text.secondary" }}>
                        {new Date(log.access_time).toLocaleString("vi-VN")}
                      </TableCell>
                      <TableCell sx={{ fontWeight: 700 }}>{log.patron_name || "-"}</TableCell>
                      <TableCell sx={{ fontFamily: "monospace", color: "text.secondary" }}>{log.student_code || "-"}</TableCell>
                      <TableCell>
                        <Chip
                          size="small"
                          color={log.access_type === "entry" ? "success" : "warning"}
                          label={log.access_type === "entry" ? "Vào" : "Ra"}
                        />
                      </TableCell>
                      <TableCell sx={{ color: "text.secondary" }}>{log.verify_method}</TableCell>
                      <TableCell sx={{ fontFamily: "monospace", color: "text.secondary" }}>
                        {CAMERA_LABELS[log.camera_id] || log.camera_id}
                      </TableCell>
                      <TableCell sx={{ minWidth: 150 }}>
                        {confidence == null ? (
                          <Typography color="text.secondary">-</Typography>
                        ) : (
                          <Stack direction="row" spacing={1} sx={{ alignItems: "center" }}>
                            <LinearProgress
                              variant="determinate"
                              value={confidence}
                              color={confidence >= 80 ? "success" : confidence >= 60 ? "warning" : "error"}
                              sx={{ width: 80, height: 7, borderRadius: 99 }}
                            />
                            <Typography variant="caption" color="text.secondary">{confidence}%</Typography>
                          </Stack>
                        )}
                      </TableCell>
                      <TableCell>
                        <Chip size="small" color={statusColor} label={getStatusLabel(log.status)} sx={{ animation: log.status === "success" || log.status === "granted" ? `${successPop} 0.35s ease-out` : undefined }} />
                      </TableCell>
                    </TableRow>
                  );
                })
              )}
            </TableBody>
          </Table>
        </TableContainer>

        <Stack
          direction={{ xs: "column", sm: "row" }}
          spacing={1.5}
          sx={{ p: 2, borderTop: `1px solid ${theme.palette.divider}`, alignItems: { sm: "center" }, justifyContent: "space-between" }}
        >
          <TextField
            select
            label="Số dòng"
            value={limit}
            onChange={(event) => { setLimit(Number(event.target.value)); setSkip(0); }}
            size="small"
            sx={{ width: 120 }}
          >
            {PAGE_SIZES.map((size) => (
              <MenuItem key={size} value={size}>{size}</MenuItem>
            ))}
          </TextField>

          <Stack direction="row" spacing={1} sx={{ alignItems: "center" }}>
            <Button variant="outlined" disabled={currentPage <= 1} onClick={() => goToPage(1)}>
              Đầu
            </Button>
            <Button variant="outlined" disabled={currentPage <= 1} onClick={() => goToPage(currentPage - 1)}>
              Trước
            </Button>
            <Typography color="text.secondary" sx={{ px: 1 }}>
              {currentPage} / {totalPages}
            </Typography>
            <Button variant="outlined" disabled={currentPage >= totalPages} onClick={() => goToPage(currentPage + 1)}>
              Sau
            </Button>
            <Button variant="outlined" disabled={currentPage >= totalPages} onClick={() => goToPage(totalPages)}>
              Cuối
            </Button>
          </Stack>
        </Stack>
      </Paper>
    </Stack>
  );
}
</file>

<file path="src/app/(dashboard)/return/page.tsx">
"use client";

import { useCallback, useEffect, useMemo, useRef, useState } from "react";
import {
  Alert,
  Avatar,
  Box,
  Button,
  Card,
  CardContent,
  Chip,
  CircularProgress,
  Dialog,
  DialogActions,
  DialogContent,
  DialogContentText,
  DialogTitle,
  Divider,
  IconButton,
  InputAdornment,
  List,
  ListItemButton,
  MenuItem,
  Paper,
  Select,
  Snackbar,
  Stack,
  Table,
  TableBody,
  TableCell,
  TableContainer,
  TableHead,
  TableRow,
  TextField,
  ToggleButton,
  ToggleButtonGroup,
  Typography,
} from "@mui/material";
import AlertIcon from "@mui/icons-material/WarningAmberOutlined";
import BookIcon from "@mui/icons-material/MenuBookOutlined";
import CameraAltIcon from "@mui/icons-material/CameraAltOutlined";
import CheckIcon from "@mui/icons-material/CheckCircleOutlined";
import CloseIcon from "@mui/icons-material/Close";
import DeleteIcon from "@mui/icons-material/DeleteOutlined";
import QrCodeScannerIcon from "@mui/icons-material/QrCodeScannerOutlined";
import RefreshIcon from "@mui/icons-material/Refresh";
import SearchIcon from "@mui/icons-material/Search";
import UsersIcon from "@mui/icons-material/GroupsOutlined";
import api, { getErrorMessage } from "@/lib/api-client";
import { fadeInUp, shimmer, slideInRight, successPop } from "@/lib/animations";
import type { BorrowRecord, StaffActiveBorrowerSummary, StaffPatronActiveBorrowsResponse } from "@/lib/types";

type BorrowerFilter = "all" | "overdue" | "active";

function isOverdue(record: BorrowRecord) {
  return new Date(record.due_at) < new Date();
}

function daysUntil(value: string) {
  const today = new Date();
  const due = new Date(value);
  today.setHours(0, 0, 0, 0);
  due.setHours(0, 0, 0, 0);
  return Math.ceil((due.getTime() - today.getTime()) / 86400000);
}

function formatDate(value?: string) {
  if (!value) return "-";
  return new Date(value).toLocaleDateString("vi-VN");
}

function borrowerName(borrower: StaffActiveBorrowerSummary) {
  return borrower.patron.full_name || borrower.patron.student_code || "Không rõ tên";
}

function dueChip(record: BorrowRecord) {
  const left = daysUntil(record.due_at);
  if (left < 0) return <Chip size="small" color="error" label={`Quá hạn ${Math.abs(left)} ngày`} />;
  if (left <= 2) return <Chip size="small" color="warning" label="Sắp đến hạn" />;
  return <Chip size="small" color="success" label="Đúng hạn" />;
}

interface ScannedReturnItem {
  isbn: string;
  record: BorrowRecord;
  condition: string;
}

export default function ReturnPage() {
  const [borrowers, setBorrowers] = useState<StaffActiveBorrowerSummary[]>([]);
  const [selectedStudentCode, setSelectedStudentCode] = useState<string | null>(null);
  const [detail, setDetail] = useState<StaffPatronActiveBorrowsResponse | null>(null);
  const [search, setSearch] = useState("");
  const [filter, setFilter] = useState<BorrowerFilter>("all");
  const [loadingBorrowers, setLoadingBorrowers] = useState(true);
  const [loadingDetail, setLoadingDetail] = useState(false);
  const [returningId, setReturningId] = useState<string | null>(null);
  const [confirmRecord, setConfirmRecord] = useState<BorrowRecord | null>(null);
  const [condition, setCondition] = useState("");
  const [error, setError] = useState("");
  const [snackbar, setSnackbar] = useState<{ severity: "success" | "error" | "warning"; message: string } | null>(null);

  const videoRef = useRef<HTMLVideoElement>(null);
  const streamRef = useRef<MediaStream | null>(null);
  const readerRef = useRef<any>(null);
  const [scannerOpen, setScannerOpen] = useState(false);
  const [cameraReady, setCameraReady] = useState(false);
  const [cameraError, setCameraError] = useState("");
  const [scannedReturns, setScannedReturns] = useState<ScannedReturnItem[]>([]);
  const [batchReturning, setBatchReturning] = useState(false);
  const [scanToast, setScanToast] = useState("");

  const loadBorrowers = useCallback(async () => {
    setLoadingBorrowers(true);
    setError("");
    try {
      const data = await api.getActiveBorrowers();
      setBorrowers(data.items);
      setSelectedStudentCode((current) => {
        if (current && data.items.some((item) => item.patron.student_code === current)) return current;
        return data.items[0]?.patron.student_code ?? null;
      });
    } catch (err: any) {
      setError(getErrorMessage(err) || "Không thể tải danh sách độc giả đang mượn");
    } finally {
      setLoadingBorrowers(false);
    }
  }, []);

  const loadPatronDetail = useCallback(async (studentCode: string) => {
    setLoadingDetail(true);
    setError("");
    try {
      const data = await api.getActiveBorrowsByStudentCode(studentCode);
      setDetail(data);
    } catch (err: any) {
      setDetail(null);
      setError(getErrorMessage(err) || "Không thể tải sách đang mượn của độc giả");
    } finally {
      setLoadingDetail(false);
    }
  }, []);

  useEffect(() => {
    loadBorrowers();
  }, [loadBorrowers]);

  useEffect(() => {
    if (selectedStudentCode) loadPatronDetail(selectedStudentCode);
    else setDetail(null);
    setScannedReturns([]);
  }, [selectedStudentCode, loadPatronDetail]);

  const filteredBorrowers = useMemo(() => {
    const q = search.trim().toLowerCase();
    return borrowers.filter((borrower) => {
      const matchesSearch = !q
        || borrower.patron.student_code.toLowerCase().includes(q)
        || (borrower.patron.full_name || "").toLowerCase().includes(q);
      const matchesFilter = filter === "all"
        || (filter === "overdue" && borrower.overdue_count > 0)
        || (filter === "active" && borrower.overdue_count === 0);
      return matchesSearch && matchesFilter;
    });
  }, [borrowers, filter, search]);

  const totals = useMemo(() => ({
    borrowers: borrowers.length,
    books: borrowers.reduce((sum, item) => sum + item.total_borrowed, 0),
    overdue: borrowers.reduce((sum, item) => sum + item.overdue_count, 0),
  }), [borrowers]);

  const selectedBorrower = useMemo(
    () => borrowers.find((item) => item.patron.student_code === selectedStudentCode) ?? null,
    [borrowers, selectedStudentCode],
  );

  const handleReturnRecord = async () => {
    if (!confirmRecord) return;
    setReturningId(confirmRecord.id);
    setError("");
    try {
      await api.staffReturnBorrowRecord(confirmRecord.id, condition || null);
      setSnackbar({ severity: "success", message: "Trả sách thành công" });
      setCondition("");
      setConfirmRecord(null);
      await loadBorrowers();
      if (selectedStudentCode) await loadPatronDetail(selectedStudentCode);
    } catch (err: any) {
      setSnackbar({ severity: "error", message: getErrorMessage(err) || "Trả sách thất bại" });
    } finally {
      setReturningId(null);
    }
  };

  const handleBatchReturn = async () => {
    if (!scannedReturns.length) return;
    setBatchReturning(true);
    let ok = 0;
    let fail = 0;
    for (const item of scannedReturns) {
      try {
        await api.staffReturnBorrowRecord(item.record.id, item.condition || null);
        ok++;
      } catch {
        fail++;
      }
    }
    setBatchReturning(false);
    setScannerOpen(false);
    setScannedReturns([]);
    setSnackbar({
      severity: fail > 0 ? "warning" : "success",
      message: `Trả ${ok} sách thành công${fail > 0 ? `, ${fail} thất bại` : ""}`,
    });
    await loadBorrowers();
    if (selectedStudentCode) await loadPatronDetail(selectedStudentCode);
  };

  const updateCondition = (isbn: string, value: string) => {
    setScannedReturns((prev) => prev.map((item) =>
      item.isbn === isbn ? { ...item, condition: value } : item
    ));
  };

  const removeScanned = (isbn: string) => {
    setScannedReturns((prev) => prev.filter((item) => item.isbn !== isbn));
  };

  const stopCamera = useCallback(() => {
    if (readerRef.current) {
      try { readerRef.current.reset(); } catch {}
      readerRef.current = null;
    }
    if (streamRef.current) {
      streamRef.current.getTracks().forEach((track) => track.stop());
      streamRef.current = null;
    }
    if (videoRef.current) videoRef.current.srcObject = null;
    setCameraReady(false);
  }, []);

  const handleScanned = useCallback((isbn: string) => {
    const normalized = isbn.replace(/-/g, "");
    let toast = "";
    setScannedReturns((prev) => {
      if (prev.some((item) => item.isbn === normalized)) {
        toast = `Sách ${normalized} đã có trong danh sách`;
        return prev;
      }
      const match = detail?.records.find((r) => {
        const recordIsbn = (r.book?.isbn || "").replace(/-/g, "");
        return recordIsbn === normalized;
      });
      if (match) {
        toast = `Đã thêm: ${match.book?.title || normalized}`;
        return [...prev, { isbn: normalized, record: match, condition: "" }];
      }
      toast = `Không tìm thấy sách đang mượn: ${normalized}`;
      return prev;
    });
    setScanToast(toast);
  }, [detail]);

  useEffect(() => {
    if (!scannerOpen) {
      stopCamera();
      setCameraError("");
      setCameraReady(false);
      return;
    }
    let active = true;
    (async () => {
      try {
        setCameraError("");
        const { BrowserMultiFormatReader } = await import("@zxing/browser");
        if (!active) return;
        const stream = await navigator.mediaDevices.getUserMedia({
          video: { facingMode: "environment", width: { ideal: 640 }, height: { ideal: 480 } },
          audio: false,
        });
        if (!active) { stream.getTracks().forEach((t) => t.stop()); return; }
        streamRef.current = stream;
        if (videoRef.current) {
          videoRef.current.srcObject = stream;
          videoRef.current.onloadedmetadata = () => { setCameraReady(true); };
        }
      } catch (err: any) {
        if (!active) return;
        if (err.name === "NotAllowedError") setCameraError("Không có quyền truy cập camera.");
        else if (err.name === "NotFoundError") setCameraError("Không tìm thấy camera trên thiết bị.");
        else setCameraError("Không thể khởi động camera.");
      }
    })();
    return () => { active = false; };
  }, [scannerOpen, stopCamera]);

  useEffect(() => {
    if (!cameraReady || !videoRef.current || !scannerOpen) return;
    let active = true;
    (async () => {
      try {
        const { BrowserMultiFormatReader } = await import("@zxing/browser");
        if (!active) return;
        const reader = new BrowserMultiFormatReader();
        readerRef.current = reader;
        reader.decodeFromVideoElement(videoRef.current!, (result, err) => {
          if (!active) return;
          if (result) {
            const code = result.getText();
            if (/^\d{10,13}$/.test(code.replace(/-/g, ""))) {
              handleScanned(code);
            }
          }
        });
      } catch {}
    })();
    return () => { active = false; };
  }, [cameraReady, scannerOpen, handleScanned]);

  useEffect(() => () => stopCamera(), [stopCamera]);

  return (
    <Stack spacing={3}>
      <Box sx={{ display: "grid", gridTemplateColumns: { xs: "1fr", md: "repeat(3, 1fr)" }, gap: 2 }}>
        {[
          { label: "Độc giả đang mượn", value: totals.borrowers, icon: UsersIcon, color: "primary.main" },
          { label: "Sách chưa trả", value: totals.books, icon: BookIcon, color: "success.main" },
          { label: "Sách quá hạn", value: totals.overdue, icon: AlertIcon, color: "error.main" },
        ].map((item) => {
          const Icon = item.icon;
          return (
            <Card key={item.label} variant="outlined">
              <CardContent>
                <Stack direction="row" sx={{ justifyContent: "space-between", alignItems: "center" }}>
                  <Box>
                    <Typography variant="caption" color="text.secondary" sx={{ fontWeight: 900 }}>{item.label}</Typography>
                    <Typography variant="h4" sx={{ fontWeight: 900 }}>{item.value}</Typography>
                  </Box>
                  <Avatar sx={{ bgcolor: item.color, color: "primary.contrastText" }}>
                    <Icon />
                  </Avatar>
                </Stack>
              </CardContent>
            </Card>
          );
        })}
      </Box>

      {error ? <Alert severity="error" onClose={() => setError("")}>{error}</Alert> : null}

      <Box sx={{ display: "grid", gridTemplateColumns: { xs: "1fr", xl: "420px minmax(0, 1fr)" }, gap: 3 }}>
        <Paper variant="outlined" sx={{ minHeight: 620, p: 2 }}>
          <Stack direction="row" sx={{ justifyContent: "space-between", alignItems: "flex-start", mb: 2 }}>
            <Box>
              <Typography variant="h6">Độc giả đang mượn</Typography>
              <Typography variant="body2" color="text.secondary">Chọn độc giả để xem sách cần trả</Typography>
            </Box>
            <Button startIcon={<RefreshIcon />} onClick={loadBorrowers} disabled={loadingBorrowers}>Tải lại</Button>
          </Stack>

          <TextField
            value={search}
            onChange={(event) => setSearch(event.target.value)}
            placeholder="Tìm theo MSSV hoặc tên..."
            fullWidth
            size="small"
            slotProps={{
              input: {
                startAdornment: <InputAdornment position="start"><SearchIcon fontSize="small" /></InputAdornment>,
              },
            }}
          />

          <ToggleButtonGroup
            exclusive
            fullWidth
            size="small"
            value={filter}
            onChange={(_, value) => value && setFilter(value)}
            sx={{ mt: 2 }}
          >
            <ToggleButton value="all">Tất cả</ToggleButton>
            <ToggleButton value="overdue">Quá hạn</ToggleButton>
            <ToggleButton value="active">Đúng hạn</ToggleButton>
          </ToggleButtonGroup>

          <Divider sx={{ my: 2 }} />

          {loadingBorrowers ? (
            <Box sx={{ py: 8, display: "grid", placeItems: "center" }}><CircularProgress sx={{ animation: `${shimmer} 1.5s ease-in-out infinite` }} /></Box>
          ) : borrowers.length === 0 ? (
            <Alert severity="info">Không có độc giả đang mượn sách.</Alert>
          ) : filteredBorrowers.length === 0 ? (
            <Alert severity="info">Không tìm thấy độc giả phù hợp.</Alert>
          ) : (
            <List disablePadding sx={{ maxHeight: 430, overflowY: "auto" }}>
              {filteredBorrowers.map((borrower, idx) => {
                const selected = borrower.patron.student_code === selectedStudentCode;
                return (
                  <ListItemButton
                    key={borrower.patron.id}
                    selected={selected}
                    onClick={() => setSelectedStudentCode(borrower.patron.student_code)}
                    sx={{ mb: 1, border: 1, borderColor: selected ? "primary.main" : "divider", borderRadius: 1, animation: `${fadeInUp} 0.3s ease-out`, animationDelay: `${idx * 0.04}s`, animationFillMode: "both" }}
                  >
                    <Box sx={{ minWidth: 0, flex: 1, pr: 1 }}>
                      <Typography sx={{ fontWeight: 900 }} noWrap>{borrowerName(borrower)}</Typography>
                      <Typography variant="caption" sx={{ display: "block", mt: 0.5, fontFamily: "monospace" }}>
                        {borrower.patron.student_code}
                      </Typography>
                      <Stack direction="row" spacing={1} sx={{ mt: 0.75, alignItems: "center", justifyContent: "space-between" }}>
                        <Typography variant="caption" color="text.secondary">{borrower.total_borrowed} sách đang mượn</Typography>
                        <Typography variant="caption" color="text.secondary">Hạn gần nhất {formatDate(borrower.nearest_due_at)}</Typography>
                      </Stack>
                    </Box>
                    <Chip
                      size="small"
                      color={borrower.overdue_count > 0 ? "error" : "success"}
                      label={borrower.overdue_count > 0 ? `${borrower.overdue_count} quá hạn` : "Đúng hạn"}
                    />
                  </ListItemButton>
                );
              })}
            </List>
          )}
        </Paper>

        <Paper variant="outlined" sx={{ minHeight: 620, p: 2 }}>
          <Stack direction="row" sx={{ justifyContent: "space-between", alignItems: "flex-start", mb: 2 }}>
            <Box>
              <Typography variant="h6">Chi tiết trả sách</Typography>
              <Typography variant="body2" color="text.secondary">
                {selectedBorrower ? `${borrowerName(selectedBorrower)} - ${selectedBorrower.patron.student_code}` : "Chọn một độc giả ở danh sách bên trái"}
              </Typography>
            </Box>
            {selectedStudentCode && (
              <Button
                size="small"
                variant="outlined"
                startIcon={<QrCodeScannerIcon />}
                onClick={() => setScannerOpen(true)}
              >
                Quét ISBN
              </Button>
            )}
          </Stack>

          {!selectedStudentCode ? (
            <Alert severity="info">Chọn một độc giả đang mượn để xem sách và xác nhận trả.</Alert>
          ) : loadingDetail ? (
            <Box sx={{ minHeight: 420, display: "grid", placeItems: "center" }}><CircularProgress sx={{ animation: `${shimmer} 1.5s ease-in-out infinite` }} /></Box>
          ) : !detail || detail.records.length === 0 ? (
            <Alert severity="success">Độc giả này đã trả hết sách.</Alert>
          ) : (
            <Stack spacing={2}>
              <Stack direction="row" spacing={1} sx={{ flexWrap: "wrap" }}>
                <Chip color="primary" label={`${detail.total} sách đang mượn`} />
                <Chip color={detail.overdue_count > 0 ? "error" : "success"} label={detail.overdue_count > 0 ? `${detail.overdue_count} quá hạn` : "Không quá hạn"} />
                {detail.patron.email ? <Chip variant="outlined" label={detail.patron.email} /> : null}
              </Stack>

              <TableContainer component={Paper} variant="outlined">
                <Table size="small">
                  <TableHead>
                    <TableRow>
                      <TableCell>Sách</TableCell>
                      <TableCell>ISBN</TableCell>
                      <TableCell>Ngày mượn</TableCell>
                      <TableCell>Hạn trả</TableCell>
                      <TableCell>Vị trí</TableCell>
                      <TableCell>Trạng thái</TableCell>
                      <TableCell align="right">Thao tác</TableCell>
                    </TableRow>
                  </TableHead>
                  <TableBody>
                    {detail.records.map((record) => (
                      <TableRow key={record.id} selected={isOverdue(record)}>
                        <TableCell>
                          <Typography variant="body2" sx={{ fontWeight: 800 }}>{record.book?.title || record.book_id}</Typography>
                          {record.book?.author ? <Typography variant="caption" color="text.secondary">{record.book.author}</Typography> : null}
                        </TableCell>
                        <TableCell sx={{ fontFamily: "monospace" }}>{record.book?.isbn || record.book_id}</TableCell>
                        <TableCell>{formatDate(record.borrow_at)}</TableCell>
                        <TableCell>{formatDate(record.due_at)}</TableCell>
                        <TableCell>{record.shelf_location || record.book?.shelf_location || "-"}</TableCell>
                        <TableCell>{dueChip(record)}</TableCell>
                        <TableCell align="right">
                          <Button
                            size="small"
                            variant="contained"
                            startIcon={<CheckIcon />}
                            disabled={!!returningId}
                            onClick={() => setConfirmRecord(record)}
                          >
                            Xác nhận trả
                          </Button>
                        </TableCell>
                      </TableRow>
                    ))}
                  </TableBody>
                </Table>
              </TableContainer>
            </Stack>
          )}
        </Paper>
      </Box>

      <Dialog open={scannerOpen} onClose={batchReturning ? undefined : () => setScannerOpen(false)} fullWidth maxWidth="md">
        <DialogTitle>
          <Stack direction="row" spacing={1} sx={{ alignItems: "center", justifyContent: "space-between" }}>
            <Stack direction="row" spacing={1} sx={{ alignItems: "center" }}>
              <QrCodeScannerIcon color="primary" />
              <Typography variant="h6" sx={{ fontWeight: 900 }}>Quét ISBN trả sách</Typography>
            </Stack>
            {!batchReturning && (
              <IconButton size="small" onClick={() => setScannerOpen(false)}><CloseIcon fontSize="small" /></IconButton>
            )}
          </Stack>
        </DialogTitle>
        <DialogContent dividers sx={{ p: 2, display: "flex", flexDirection: "column", overflow: "hidden" }}>
          <Box sx={{ display: "flex", gap: 2, flexDirection: { xs: "column", md: "row" }, flex: 1, overflow: "hidden" }}>
            <Paper
              variant="outlined"
              sx={{
                position: "relative",
                overflow: "hidden",
                bgcolor: "black",
                width: { md: "45%" },
                aspectRatio: { xs: "16/9", md: "4/3" },
                display: "flex",
                alignItems: "center",
                justifyContent: "center",
                flexShrink: 0,
              }}
            >
              {cameraError ? (
                <Stack spacing={1} sx={{ alignItems: "center", color: "grey.300", p: 3, textAlign: "center" }}>
                  <CameraAltIcon sx={{ fontSize: 42 }} />
                  <Typography variant="body2">{cameraError}</Typography>
                </Stack>
              ) : (
                <>
                  <Box
                    component="video"
                    ref={videoRef}
                    autoPlay
                    playsInline
                    muted
                    sx={{ width: "100%", height: "100%", objectFit: "contain" }}
                  />
                  {!cameraReady && (
                    <Stack sx={{ position: "absolute", inset: 0, bgcolor: "rgba(0,0,0,.55)", color: "common.white", alignItems: "center", justifyContent: "center" }} spacing={1}>
                      <CircularProgress size={26} color="inherit" />
                      <Typography variant="body2">Đang kết nối camera...</Typography>
                    </Stack>
                  )}
                </>
              )}
            </Paper>

            <Stack spacing={1.5} sx={{ flex: 1, overflow: "auto" }}>
              <Stack direction="row" spacing={1} sx={{ alignItems: "center" }}>
                <QrCodeScannerIcon color="primary" sx={{ fontSize: 20 }} />
                <Typography variant="subtitle2" sx={{ fontWeight: 900 }}>
                  {scannedReturns.length > 0 ? `Đã quét (${scannedReturns.length} cuốn)` : "Sách đã quét"}
                </Typography>
              </Stack>

              {scannedReturns.length === 0 ? (
                <Alert severity="info" sx={{ flex: 1, display: "flex", alignItems: "center" }}>
                  Đưa mã vạch ISBN vào camera. Sách sẽ xuất hiện tại đây.
                </Alert>
              ) : (
                scannedReturns.map((item) => (
                  <Paper key={item.isbn} variant="outlined" sx={{ p: 1.5 }}>
                    <Stack direction="row" spacing={1.5} sx={{ alignItems: "flex-start" }}>
                      {item.record.book?.cover_url ? (
                        <Box
                          component="img"
                          src={item.record.book.cover_url}
                          alt={item.record.book.title}
                          sx={{ width: 40, height: 56, objectFit: "cover", borderRadius: 0.5, flexShrink: 0 }}
                        />
                      ) : (
                        <Avatar variant="rounded" sx={{ width: 40, height: 56, bgcolor: "background.default", flexShrink: 0 }}>
                          <BookIcon />
                        </Avatar>
                      )}
                      <Stack spacing={0.3} sx={{ flex: 1, minWidth: 0 }}>
                        <Typography variant="body2" sx={{ fontWeight: 900 }} noWrap>
                          {item.record.book?.title || item.record.book_id}
                        </Typography>
                        {item.record.book?.author && (
                          <Typography variant="caption" color="text.secondary" noWrap>
                            {item.record.book.author}
                          </Typography>
                        )}
                        <Typography variant="caption" sx={{ fontFamily: "monospace", color: "primary.main" }}>
                          {item.isbn}
                        </Typography>
                        <Stack direction="row" spacing={1} sx={{ alignItems: "center", flexWrap: "wrap" }}>
                          {dueChip(item.record)}
                          <Typography variant="caption" color="text.secondary">
                            Mượn: {formatDate(item.record.borrow_at)}
                          </Typography>
                        </Stack>
                        <Select
                          value={item.condition}
                          onChange={(e) => updateCondition(item.isbn, e.target.value)}
                          displayEmpty
                          fullWidth
                          size="small"
                          sx={{ mt: 0.5 }}
                        >
                          <MenuItem value="">Tình trạng (tuỳ chọn)</MenuItem>
                          <MenuItem value="Còn mới">Còn mới</MenuItem>
                          <MenuItem value="Bình thường">Bình thường</MenuItem>
                          <MenuItem value="Sách cũ">Sách cũ</MenuItem>
                          <MenuItem value="Rách bìa">Rách bìa</MenuItem>
                          <MenuItem value="Rách trang">Rách trang</MenuItem>
                          <MenuItem value="Thiếu trang">Thiếu trang</MenuItem>
                          <MenuItem value="Ẩm mốc">Ẩm mốc</MenuItem>
                          <MenuItem value="Viết/bôi bẩn">Viết/bôi bẩn</MenuItem>
                          <MenuItem value="Hư hỏng nặng">Hư hỏng nặng</MenuItem>
                        </Select>
                      </Stack>
                      <IconButton size="small" color="error" onClick={() => removeScanned(item.isbn)} sx={{ mt: 0.5 }}>
                        <DeleteIcon fontSize="small" />
                      </IconButton>
                    </Stack>
                  </Paper>
                ))
              )}
            </Stack>
          </Box>
        </DialogContent>
        <DialogActions>
          <Button onClick={() => setScannerOpen(false)} disabled={batchReturning}>Đóng</Button>
          <Button
            variant="contained"
            disabled={batchReturning || scannedReturns.length === 0}
            onClick={handleBatchReturn}
          >
            {batchReturning ? "Đang trả sách..." : `Xác nhận trả (${scannedReturns.length} cuốn)`}
          </Button>
        </DialogActions>
      </Dialog>

      <Dialog open={!!confirmRecord} onClose={() => { setConfirmRecord(null); setCondition(""); }}>
        <DialogTitle>Xác nhận trả sách</DialogTitle>
        <DialogContent>
          <DialogContentText sx={{ mb: 2 }}>
            Trả sách "{confirmRecord?.book?.title || confirmRecord?.book_id}" cho độc giả {detail?.patron.full_name || detail?.patron.student_code}?
          </DialogContentText>
          <Select
            value={condition}
            onChange={(e) => setCondition(e.target.value)}
            displayEmpty
            fullWidth
            size="small"
          >
            <MenuItem value="">Tình trạng sách (tuỳ chọn)</MenuItem>
            <MenuItem value="Còn mới">Còn mới</MenuItem>
            <MenuItem value="Bình thường">Bình thường</MenuItem>
            <MenuItem value="Sách cũ">Sách cũ</MenuItem>
            <MenuItem value="Rách bìa">Rách bìa</MenuItem>
            <MenuItem value="Rách trang">Rách trang</MenuItem>
            <MenuItem value="Thiếu trang">Thiếu trang</MenuItem>
            <MenuItem value="Ẩm mốc">Ẩm mốc</MenuItem>
            <MenuItem value="Viết/bôi bẩn">Viết/bôi bẩn</MenuItem>
            <MenuItem value="Hư hỏng nặng">Hư hỏng nặng</MenuItem>
          </Select>
        </DialogContent>
        <DialogActions>
          <Button onClick={() => { setConfirmRecord(null); setCondition(""); }}>Hủy</Button>
          <Button variant="contained" onClick={handleReturnRecord} disabled={!!returningId || !condition}>
            {returningId ? "Đang trả..." : "Xác nhận trả"}
          </Button>
        </DialogActions>
      </Dialog>

      <Snackbar open={!!snackbar} autoHideDuration={3200} onClose={() => setSnackbar(null)}>
        {snackbar ? <Alert severity={snackbar.severity} onClose={() => setSnackbar(null)}>{snackbar.message}</Alert> : undefined}
      </Snackbar>

      <Snackbar
        open={!!scanToast}
        autoHideDuration={2000}
        onClose={() => setScanToast("")}
        anchorOrigin={{ vertical: "top", horizontal: "right" }}
        message={scanToast}
      />
    </Stack>
  );
}
</file>

<file path="src/app/register/page.tsx">
"use client";

import { useEffect, useRef, useState } from "react";
import {
  Alert, Box, Button, Card, CardContent, Checkbox, CircularProgress,
  FormControlLabel, Paper, Stack, Step, StepLabel, Stepper,
  TextField, Typography, alpha,
} from "@mui/material";
import { useRouter } from "next/navigation";
import Link from "next/link";
import api, { getErrorMessage } from "@/lib/api-client";
import StudentCardScanner, { type ScannedCardData } from "@/components/StudentCardScanner";
import MultiAngleCapture, { type CaptureAngle } from "@/components/MultiAngleCapture";

const steps = ["Quét thẻ", "Xác nhận thông tin", "Đăng ký", "Khuôn mặt"];

type RegisterPhase = "scan" | "confirm" | "form" | "face" | "face-enrolling" | "done";

export default function RegisterPage() {
  const router = useRouter();
  const [phase, setPhase] = useState<RegisterPhase>("scan");
  const [activeStep, setActiveStep] = useState(0);
  const [scannedData, setScannedData] = useState<ScannedCardData | null>(null);
  const [error, setError] = useState("");
  const [registering, setRegistering] = useState(false);
  const pollIntervalRef = useRef<ReturnType<typeof setInterval> | null>(null);

  const [email, setEmail] = useState("");
  const [password, setPassword] = useState("");
  const [fullName, setFullName] = useState("");
  const [studentCode, setStudentCode] = useState("");
  const [className, setClassName] = useState("");
  const [course, setCourse] = useState("");
  const [permanentAddress, setPermanentAddress] = useState("");
  const [dateOfBirth, setDateOfBirth] = useState("");
  const [faculty, setFaculty] = useState("");

  const [consent, setConsent] = useState(false);
  const [faceResult, setFaceResult] = useState<any>(null);
  const [faceLoading, setFaceLoading] = useState(false);
  const [faceError, setFaceError] = useState("");

  const [registrationTokens, setRegistrationTokens] = useState<{
    access_token: string; refresh_token?: string;
  } | null>(null);

  useEffect(() => {
    return () => {
      if (pollIntervalRef.current) clearInterval(pollIntervalRef.current);
    };
  }, []);

  const handleScanned = async (data: ScannedCardData) => {
    setError("");
    if (!data.studentCode) return;
    try {
      const existing = await api.lookupPatron(data.studentCode);
      if (existing.exists) {
        setError("MSSV này đã được đăng ký trong hệ thống. Vui lòng đăng nhập hoặc liên hệ thư viện để được hỗ trợ.");
        return;
      }
    } catch {
      setError("Không thể kiểm tra thông tin MSSV. Vui lòng thử lại.");
      return;
    }
    setScannedData(data);
    setFullName(data.fullName || "");
    setStudentCode(data.studentCode || "");
    setClassName(data.className || "");
    setCourse(data.course || "");
    setPermanentAddress(data.permanentAddress || "");
    setDateOfBirth(data.dateOfBirth || "");
    setFaculty(data.faculty || "");
    setActiveStep(1);
    setPhase("confirm");
  };

  const handleConfirmNext = () => {
    setActiveStep(2);
    setPhase("form");
  };

  const handleFormSubmit = async () => {
    if (!email || !password || !fullName || !studentCode) {
      setError("Vui lòng điền đầy đủ Email, Mật khẩu, Họ tên và MSSV");
      return;
    }
    setError("");
    setRegistering(true);
    try {
      const res = await api.patronRegister({
        full_name: fullName,
        student_code: studentCode,
        email,
        password,
        class_name: className || undefined,
        course: course || undefined,
        permanent_address: permanentAddress || undefined,
        date_of_birth: dateOfBirth || undefined,
        faculty: faculty || undefined,
      });
      localStorage.setItem("access_token", res.access_token);
      if (res.refresh_token) localStorage.setItem("refresh_token", res.refresh_token);
      setRegistrationTokens({ access_token: res.access_token, refresh_token: res.refresh_token });
      setRegistering(false);
      setActiveStep(3);
      setPhase("face");
    } catch (err: any) {
      setRegistering(false);
      setError(getErrorMessage(err) || "Đăng ký thất bại");
    }
  };

  const handleFilesReady = async (files: Record<CaptureAngle, File>) => {
    setFaceError("");
    setFaceLoading(true);
    setFaceResult(null);
    try {
      const data = await api.enrollBatch(files, consent);
      setPhase("face-enrolling");
      if (pollIntervalRef.current) clearInterval(pollIntervalRef.current);
      pollIntervalRef.current = setInterval(async () => {
        try {
          const statusData = await api.getTaskStatus(data.job_id);
          if (statusData.status === "SUCCESS") {
            if (pollIntervalRef.current) clearInterval(pollIntervalRef.current);
            if (statusData.result?.status === "error") {
              setFaceError(statusData.result.error || "Đăng ký khuôn mặt thất bại");
            }
            setFaceResult(statusData.result);
            setFaceLoading(false);
            setPhase("done");
          } else if (statusData.status === "FAILURE") {
            if (pollIntervalRef.current) clearInterval(pollIntervalRef.current);
            setFaceError(statusData.result?.error || "Đăng ký khuôn mặt thất bại");
            setFaceResult(statusData.result);
            setFaceLoading(false);
            setPhase("done");
          }
        } catch {
          if (pollIntervalRef.current) clearInterval(pollIntervalRef.current);
          setFaceError("Không thể lấy trạng thái tác vụ");
          setFaceLoading(false);
          setPhase("done");
        }
      }, 2000);
    } catch (err: any) {
      setFaceError(getErrorMessage(err) || "Đăng ký khuôn mặt thất bại");
      setFaceLoading(false);
      setPhase("face");
    }
  };

  const handleSkipFace = () => {
    setPhase("done");
  };

  const handleReset = () => {
    setPhase("scan");
    setActiveStep(0);
    setScannedData(null);
    setError("");
    setFaceResult(null);
    setFaceError("");
    setConsent(false);
    setRegistrationTokens(null);
    setEmail("");
    setPassword("");
    setFullName("");
    setStudentCode("");
    setClassName("");
    setCourse("");
    setPermanentAddress("");
    setDateOfBirth("");
    setFaculty("");
  };

  return (
    <Box
      sx={{
        minHeight: "100vh",
        display: "flex",
        alignItems: "center",
        justifyContent: "center",
        bgcolor: "background.default",
        p: 2,
      }}
    >
      <Card sx={{ maxWidth: 560, width: "100%" }}>
        <CardContent sx={{ p: { xs: 2, sm: 3 } }}>
          <Stack spacing={3}>
            <Typography variant="h5" sx={{ fontWeight: 700, textAlign: "center" }}>
              Đăng ký thẻ thư viện
            </Typography>

            {phase !== "done" && (
              <Stepper activeStep={activeStep} alternativeLabel>
                {steps.map((label) => (
                  <Step key={label}>
                    <StepLabel>{label}</StepLabel>
                  </Step>
                ))}
              </Stepper>
            )}

            {error && <Alert severity="error">{error}</Alert>}

            {phase === "scan" && (
              <StudentCardScanner
                onScanned={handleScanned}
                onError={(msg) => setError(msg)}
              />
            )}

            {phase === "confirm" && scannedData && (
              <Stack spacing={2}>
                <Typography variant="subtitle1" sx={{ fontWeight: 600 }}>
                  Thông tin từ thẻ sinh viên
                </Typography>
                <Paper variant="outlined" sx={{ p: 2, bgcolor: alpha("#000", 0.02) }}>
                  <Stack spacing={1}>
                    <ConfirmRow label="MSSV" value={scannedData.studentCode} />
                    <ConfirmRow label="Họ tên" value={scannedData.fullName} />
                    {scannedData.className && <ConfirmRow label="Lớp" value={scannedData.className} />}
                    {scannedData.dateOfBirth && <ConfirmRow label="Ngày sinh" value={scannedData.dateOfBirth} />}
                    {scannedData.course && <ConfirmRow label="Khóa học" value={scannedData.course} />}
                    {scannedData.permanentAddress && <ConfirmRow label="HKTT" value={scannedData.permanentAddress} />}
                    {scannedData.faculty && <ConfirmRow label="Khoa" value={scannedData.faculty} />}
                  </Stack>
                </Paper>
                <Typography variant="caption" color="text.secondary">
                  Bạn có thể chỉnh sửa thông tin ở bước tiếp theo
                </Typography>
                <Stack direction="row" spacing={2}>
                  <Button variant="contained" onClick={handleConfirmNext} fullWidth>
                    Tiếp theo
                  </Button>
                  <Button variant="outlined" onClick={() => { setPhase("scan"); setActiveStep(0); }} fullWidth>
                    Quét lại
                  </Button>
                </Stack>
              </Stack>
            )}

            {phase === "form" && (
              <Stack spacing={2}>
                <Typography variant="subtitle2" color="text.secondary">
                  Thông tin tài khoản
                </Typography>
                <TextField
                  label="Email"
                  type="email"
                  value={email}
                  onChange={(e) => setEmail(e.target.value)}
                  required
                  fullWidth
                  size="small"
                />
                <TextField
                  label="Mật khẩu"
                  type="password"
                  value={password}
                  onChange={(e) => setPassword(e.target.value)}
                  required
                  fullWidth
                  size="small"
                />
                <Typography variant="subtitle2" color="text.secondary" sx={{ mt: 1 }}>
                  Thông tin cá nhân
                </Typography>
                <TextField
                  label="Họ tên"
                  value={fullName}
                  onChange={(e) => setFullName(e.target.value)}
                  required
                  fullWidth
                  size="small"
                />
                <TextField
                  label="MSSV"
                  value={studentCode}
                  onChange={(e) => setStudentCode(e.target.value)}
                  required
                  fullWidth
                  size="small"
                />
                <Stack direction="row" spacing={2}>
                  <TextField
                    label="Lớp"
                    value={className}
                    onChange={(e) => setClassName(e.target.value)}
                    fullWidth
                    size="small"
                  />
                  <TextField
                    label="Ngày sinh"
                    value={dateOfBirth}
                    onChange={(e) => setDateOfBirth(e.target.value)}
                    placeholder="DD/MM/YYYY"
                    fullWidth
                    size="small"
                  />
                </Stack>
                <TextField
                  label="Khóa học"
                  value={course}
                  onChange={(e) => setCourse(e.target.value)}
                  fullWidth
                  size="small"
                />
                <TextField
                  label="HKTT"
                  value={permanentAddress}
                  onChange={(e) => setPermanentAddress(e.target.value)}
                  fullWidth
                  size="small"
                  multiline
                  rows={2}
                />
                <TextField
                  label="Khoa"
                  value={faculty}
                  onChange={(e) => setFaculty(e.target.value)}
                  fullWidth
                  size="small"
                />
                {scannedData && (
                  <Alert severity="info" sx={{ fontSize: "0.8rem" }}>
                    Đã điền thông tin từ thẻ sinh viên
                  </Alert>
                )}
                <Stack direction="row" spacing={2} sx={{ pt: 1 }}>
                  <Button
                    variant="contained"
                    onClick={handleFormSubmit}
                    disabled={registering}
                    fullWidth
                  >
                    {registering ? <CircularProgress size={20} /> : "Đăng ký"}
                  </Button>
                  <Button
                    variant="outlined"
                    onClick={() => { setPhase("scan"); setActiveStep(0); }}
                    fullWidth
                  >
                    Quay lại
                  </Button>
                </Stack>
              </Stack>
            )}

            {phase === "face" && (
              <Stack spacing={2}>
                <Typography variant="subtitle1" sx={{ fontWeight: 600 }}>
                  Đăng ký khuôn mặt (tùy chọn)
                </Typography>
                <Typography variant="body2" color="text.secondary">
                  Đăng ký khuôn mặt giúp bạn ra vào thư viện nhanh chóng mà không cần thẻ.
                  Bạn có thể bỏ qua bước này và làm sau.
                </Typography>
                <MultiAngleCapture
                  consent={consent}
                  setConsent={setConsent}
                  onFilesReady={handleFilesReady}
                />
                <Button color="inherit" variant="text" onClick={handleSkipFace} fullWidth>
                  Bỏ qua bước này
                </Button>
              </Stack>
            )}

            {phase === "face-enrolling" && (
              <Stack spacing={2} sx={{ alignItems: "center", py: 4 }}>
                <CircularProgress size={48} />
                <Typography>Đang xử lý đăng ký khuôn mặt...</Typography>
              </Stack>
            )}

            {phase === "done" && (
              <Stack spacing={2} sx={{ alignItems: "center", py: 3 }}>
                {faceLoading ? (
                  <>
                    <CircularProgress size={48} />
                    <Typography>Đang xử lý...</Typography>
                  </>
                ) : faceError ? (
                  <Alert severity="warning" sx={{ width: "100%" }}>
                    {faceError}
                  </Alert>
                ) : faceResult ? (
                  <Alert severity="success" sx={{ width: "100%" }}>
                    Đăng ký khuôn mặt thành công!
                  </Alert>
                ) : (
                  <Alert severity="info" sx={{ width: "100%" }}>
                    Bạn có thể đăng ký khuôn mặt sau trong phần quản lý tài khoản.
                  </Alert>
                )}
                <Typography variant="h6" sx={{ fontWeight: 600 }}>
                  Đăng ký thành công!
                </Typography>
                <Typography variant="body2" color="text.secondary" sx={{ textAlign: "center" }}>
                  Tài khoản thư viện của bạn đã được tạo. Vui lòng đăng nhập để sử dụng.
                </Typography>
                <Button variant="contained" onClick={() => router.push("/login")} fullWidth>
                  Đăng nhập
                </Button>
                <Button variant="text" onClick={handleReset} fullWidth>
                  Đăng ký tài khoản khác
                </Button>
              </Stack>
            )}
          </Stack>
        </CardContent>
      </Card>
    </Box>
  );
}

function ConfirmRow({ label, value }: { label: string; value: string | null }) {
  return (
    <Stack direction="row" spacing={1}>
      <Typography variant="body2" color="text.secondary" sx={{ minWidth: 90, flexShrink: 0 }}>
        {label}:
      </Typography>
      <Typography variant="body2" sx={{ fontWeight: 500 }}>
        {value ?? ""}
      </Typography>
    </Stack>
  );
}
</file>

<file path="src/app/(dashboard)/active/page.tsx">
"use client";

import { useEffect, useMemo, useState } from "react";
import {
  Alert,
  Avatar,
  Box,
  Button,
  Chip,
  CircularProgress,
  Grid,
  InputAdornment,
  Paper,
  Stack,
  TextField,
  Tooltip,
  Typography,
  useTheme,
} from "@mui/material";
import AccessTimeOutlinedIcon from "@mui/icons-material/AccessTimeOutlined";
import DoorFrontOutlinedIcon from "@mui/icons-material/DoorFrontOutlined";
import ExitToAppOutlinedIcon from "@mui/icons-material/ExitToAppOutlined";
import GroupsOutlinedIcon from "@mui/icons-material/GroupsOutlined";
import LocationOnOutlinedIcon from "@mui/icons-material/LocationOnOutlined";
import MenuBookOutlinedIcon from "@mui/icons-material/MenuBookOutlined";
import RefreshOutlinedIcon from "@mui/icons-material/RefreshOutlined";
import SearchOutlinedIcon from "@mui/icons-material/SearchOutlined";
import TerminalOutlinedIcon from "@mui/icons-material/TerminalOutlined";
import api from "@/lib/api-client";
import { fadeInUp, shimmer, slideInRight, successPop } from "@/lib/animations";
import type { ActivePatron } from "@/lib/types";

const ACTIVE_CAMERA_IDS = new Set(["entry_gate", "exit_gate", "kiosk"]);

const CAMERA_CONFIG: Record<string, { label: string; icon: React.ElementType }> = {
  entry_gate: { label: "Cổng vào", icon: DoorFrontOutlinedIcon },
  exit_gate: { label: "Cổng ra", icon: ExitToAppOutlinedIcon },
  kiosk: { label: "Kiosk", icon: TerminalOutlinedIcon },
};

function formatTime(value: string) {
  return new Date(value).toLocaleTimeString("vi-VN", {
    hour: "2-digit",
    minute: "2-digit",
  });
}

function getDuration(value: string) {
  const diffMs = Date.now() - new Date(value).getTime();
  const minutes = Math.max(0, Math.floor(diffMs / 60000));
  if (minutes < 1) return { text: "Vừa vào", level: 0 as const };
  if (minutes < 60) return { text: `${minutes} phút`, level: 1 as const };
  const hours = Math.floor(minutes / 60);
  const rest = minutes % 60;
  if (hours < 2) return { text: rest ? `${hours} giờ ${rest} phút` : `${hours} giờ`, level: 2 as const };
  return { text: rest ? `${hours} giờ ${rest} phút` : `${hours} giờ`, level: 3 as const };
}

const DURATION_ACCENT: Record<number, string> = {
  0: "#4A8C5C",
  1: "#4A8C5C",
  2: "#C49A3C",
  3: "#B85C4A",
};

function initials(name?: string) {
  const parts = (name || "").trim().split(/\s+/).filter(Boolean);
  if (parts.length === 0) return "?";
  if (parts.length === 1) return parts[0].charAt(0).toUpperCase();
  return `${parts[0].charAt(0)}${parts[parts.length - 1].charAt(0)}`.toUpperCase();
}

function normalizeQuery(value: string) {
  return value.trim().toLowerCase();
}

export default function ActivePage() {
  const theme = useTheme();
  const isDark = theme.palette.mode === "dark";
  const [patrons, setPatrons] = useState<ActivePatron[]>([]);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState<string | null>(null);
  const [search, setSearch] = useState("");
  const [lastUpdate, setLastUpdate] = useState<Date>(new Date());

  const load = async () => {
    try {
      setError(null);
      const data = await api.getActivePatrons();
      const allowed = data.items
        .filter((p) => ACTIVE_CAMERA_IDS.has(p.camera_id))
        .sort((a, b) => new Date(b.entered_at).getTime() - new Date(a.entered_at).getTime());
      setPatrons(allowed);
      setLastUpdate(new Date());
    } catch {
      setError("Không thể tải danh sách độc giả.");
    } finally {
      setLoading(false);
    }
  };

  useEffect(() => {
    load();
    const interval = setInterval(load, 10000);
    return () => clearInterval(interval);
  }, []);

  const q = normalizeQuery(search);
  const filtered = useMemo(() => {
    if (!q) return patrons;
    return patrons.filter((p) =>
      p.full_name.toLowerCase().includes(q) || p.student_code.toLowerCase().includes(q)
    );
  }, [patrons, search]);

  const cameraCounts = useMemo(() =>
    patrons.reduce<Record<string, number>>((acc, p) => {
      acc[p.camera_id] = (acc[p.camera_id] || 0) + 1;
      return acc;
    }, {}),
    [patrons]
  );

  return (
    <Stack spacing={3}>
      {/* Header — hero count + camera breakdown */}
      <Paper variant="outlined" sx={{ borderRadius: 3, overflow: "hidden" }}>
        <Box sx={{ p: { xs: 2.5, sm: 3 } }}>
          <Grid container spacing={3} sx={{ alignItems: "flex-end" }}>
            <Grid size={{ xs: 12, md: 5 }}>
              <Stack spacing={1}>
                <Typography
                  variant="caption"
                  sx={{
                    fontWeight: 700,
                    letterSpacing: 1.5,
                    textTransform: "uppercase",
                    color: "text.secondary",
                  }}
                >
                  Hiện tại
                </Typography>
                <Stack direction="row" spacing={1} sx={{ alignItems: "baseline" }}>
                  <Typography
                    variant="h2"
                    sx={{
                      fontWeight: 900,
                      letterSpacing: { xs: -1, sm: -2 },
                      lineHeight: 1,
                      fontSize: { xs: "3rem", sm: "3.75rem" },
                    }}
                  >
                    {patrons.length}
                  </Typography>
                  <Typography variant="h6" sx={{ fontWeight: 500, color: "text.secondary" }}>
                    độc giả
                  </Typography>
                </Stack>
                <Typography variant="body2" color="text.secondary" sx={{ maxWidth: 360 }}>
                  Danh sách độc giả đang ở trong thư viện, cập nhật từ hệ thống cổng và kiosk.
                </Typography>
              </Stack>
            </Grid>
            <Grid size={{ xs: 12, md: 7 }}>
              <Stack spacing={2}>
                <Stack direction="row" spacing={1.5} sx={{ flexWrap: "wrap" }}>
                  {Object.entries(CAMERA_CONFIG).map(([id, cfg]) => {
                    const Icon = cfg.icon;
                    return (
                      <Paper
                        key={id}
                        variant="outlined"
                        sx={{
                          flex: { xs: "1 1 100%", sm: "1 1 0" },
                          minWidth: 0,
                          p: 1.5,
                          display: "flex",
                          alignItems: "center",
                          gap: 1.5,
                          borderRadius: 2,
                          background: "transparent",
                        }}
                      >
                        <Box
                          sx={{
                            width: 36,
                            height: 36,
                            borderRadius: 1.5,
                            display: "flex",
                            alignItems: "center",
                            justifyContent: "center",
                            bgcolor: isDark ? "rgba(255,255,255,0.06)" : "rgba(0,0,0,0.04)",
                            color: "text.secondary",
                          }}
                        >
                          <Icon fontSize="small" />
                        </Box>
                        <Box sx={{ minWidth: 0 }}>
                          <Typography variant="caption" color="text.secondary" sx={{ fontWeight: 700, display: "block" }}>
                            {cfg.label}
                          </Typography>
                          <Typography variant="h6" sx={{ fontWeight: 800, lineHeight: 1.2 }}>
                            {cameraCounts[id] || 0}
                          </Typography>
                        </Box>
                      </Paper>
                    );
                  })}
                </Stack>
                <Stack
                  direction="row"
                  spacing={1}
                  sx={{ alignItems: "center", justifyContent: "space-between", flexWrap: "wrap", gap: 1 }}
                >
                  <Stack direction="row" spacing={1} sx={{ alignItems: "center" }}>
                    <Box
                      sx={{
                        width: 6,
                        height: 6,
                        borderRadius: "50%",
                        bgcolor: error ? "error.main" : "success.main",
                      }}
                    />
                    <Typography variant="caption" color="text.secondary">
                      {error ? "Lỗi cập nhật" : `Cập nhật: ${lastUpdate.toLocaleTimeString("vi-VN")}`}
                    </Typography>
                  </Stack>
                  <Button size="small" variant="outlined" startIcon={<RefreshOutlinedIcon />} onClick={load} disabled={loading}>
                    Làm mới
                  </Button>
                </Stack>
              </Stack>
            </Grid>
          </Grid>
        </Box>
      </Paper>

      {/* Patron list */}
      <Paper variant="outlined" sx={{ borderRadius: 3 }}>
        <Box sx={{ p: { xs: 2, sm: 2.5 } }}>
          {/* Search bar */}
          <Stack
            direction={{ xs: "column", sm: "row" }}
            spacing={2}
            sx={{ alignItems: { sm: "center" }, justifyContent: "space-between", mb: 2.5 }}
          >
            <Box>
              <Typography variant="h6" sx={{ fontWeight: 800 }}>
                Độc giả
              </Typography>
              <Typography color="text.secondary" variant="body2">
                {filtered.length} kết quả
              </Typography>
            </Box>
            <TextField
              value={search}
              onChange={(e) => setSearch(e.target.value)}
              placeholder="Tìm theo tên hoặc MSSV..."
              size="small"
              sx={{ width: { xs: "100%", sm: 320 } }}
              slotProps={{
                input: {
                  startAdornment: (
                    <InputAdornment position="start">
                      <SearchOutlinedIcon fontSize="small" />
                    </InputAdornment>
                  ),
                },
              }}
            />
          </Stack>

          {/* Content states */}
          {loading && patrons.length === 0 ? (
            <Stack sx={{ minHeight: 300, alignItems: "center", justifyContent: "center", gap: 2 }}>
              <CircularProgress size={28} sx={{ animation: `${shimmer} 1.5s ease-in-out infinite` }} />
              <Typography variant="body2" color="text.secondary">
                Đang tải...
              </Typography>
            </Stack>
          ) : patrons.length === 0 ? (
            <Stack
              sx={{
                minHeight: 300,
                alignItems: "center",
                justifyContent: "center",
                gap: 1.5,
                py: 6,
              }}
            >
              <Box
                sx={{
                  width: 64,
                  height: 64,
                  borderRadius: 3,
                  display: "flex",
                  alignItems: "center",
                  justifyContent: "center",
                  bgcolor: isDark ? "rgba(255,255,255,0.04)" : "rgba(0,0,0,0.04)",
                  color: "text.disabled",
                  mb: 1,
                }}
              >
                <MenuBookOutlinedIcon sx={{ fontSize: 32 }} />
              </Box>
              <Typography variant="h6" sx={{ fontWeight: 700, color: "text.secondary" }}>
                Thư viện đang yên tĩnh
              </Typography>
              <Typography variant="body2" color="text.disabled" sx={{ textAlign: "center", maxWidth: 360 }}>
                Chưa có độc giả nào trong thư viện. Danh sách sẽ tự động cập nhật khi có lượt vào hợp lệ.
              </Typography>
            </Stack>
          ) : filtered.length === 0 ? (
            <Stack
              sx={{
                minHeight: 200,
                alignItems: "center",
                justifyContent: "center",
                gap: 1.5,
                py: 4,
              }}
            >
              <SearchOutlinedIcon sx={{ fontSize: 36, color: "text.disabled" }} />
              <Typography variant="body1" color="text.secondary">
                Không tìm thấy độc giả &ldquo;{search}&rdquo;
              </Typography>
            </Stack>
          ) : (
            <Grid container spacing={1.5}>
              {filtered.map((patron, idx) => {
                const dur = getDuration(patron.entered_at);
                const accent = DURATION_ACCENT[dur.level];
                const percent = patron.confidence == null ? null : Math.round(patron.confidence * 100);
                return (
                  <Grid key={patron.id} size={{ xs: 12, xl: 6 }} sx={{ animation: `${fadeInUp} 0.35s ease-out`, animationDelay: `${idx * 0.05}s`, animationFillMode: "both" }}>
                    <Paper
                      variant="outlined"
                      sx={{
                        borderRadius: 2,
                        overflow: "hidden",
                        position: "relative",
                        transition: "box-shadow 0.15s",
                        "&:hover": {
                          boxShadow: theme.shadows[2],
                        },
                      }}
                    >
                      {/* Duration accent bar — like a book spine */}
                      <Box
                        sx={{
                          position: "absolute",
                          left: 0,
                          top: 0,
                          bottom: 0,
                          width: 3,
                          bgcolor: accent,
                          opacity: 0.7,
                        }}
                      />

                      <Box sx={{ pl: 2.5, pr: 2, py: 1.5 }}>
                        <Stack direction="row" spacing={1.5} sx={{ alignItems: "flex-start" }}>
                          <Avatar
                            sx={{
                              width: 36,
                              height: 36,
                              fontSize: 13,
                              fontWeight: 700,
                              bgcolor: isDark ? "rgba(255,255,255,0.08)" : "rgba(0,0,0,0.06)",
                              color: "text.primary",
                            }}
                          >
                            {initials(patron.full_name)}
                          </Avatar>
                          <Box sx={{ minWidth: 0, flex: 1 }}>
                            <Stack
                              direction="row"
                              spacing={1}
                              sx={{ justifyContent: "space-between", alignItems: "flex-start" }}
                            >
                              <Box sx={{ minWidth: 0 }}>
                                <Typography noWrap sx={{ fontWeight: 700, fontSize: 14 }}>
                                  {patron.full_name || "Chưa có tên"}
                                </Typography>
                                <Typography
                                  variant="caption"
                                  color="text.secondary"
                                  sx={{ fontFamily: "monospace", fontSize: 12 }}
                                >
                                  {patron.student_code}
                                </Typography>
                              </Box>
                              <Stack direction="row" spacing={0.5} sx={{ alignItems: "center", flexShrink: 0 }}>
                                {percent != null && (
                                  <Tooltip title={`Độ chính xác: ${percent}%`}>
                                    <Box
                                      sx={{
                                        width: 8,
                                        height: 8,
                                        borderRadius: "50%",
                                        bgcolor:
                                          percent >= 80 ? "success.main" : percent >= 60 ? "warning.main" : "error.main",
                                      }}
                                    />
                                  </Tooltip>
                                )}
                                <Box
                                  sx={{
                                    px: 1,
                                    py: 0.25,
                                    borderRadius: 0.75,
                                    bgcolor:
                                      dur.level <= 1
                                        ? isDark ? "rgba(74,140,92,0.15)" : "rgba(74,140,92,0.1)"
                                        : dur.level === 2
                                          ? isDark ? "rgba(196,154,60,0.15)" : "rgba(196,154,60,0.1)"
                                          : isDark ? "rgba(184,92,74,0.15)" : "rgba(184,92,74,0.1)",
                                  }}
                                >
                                  <Typography
                                    variant="caption"
                                    sx={{ fontWeight: 700, fontSize: 11, color: accent, whiteSpace: "nowrap" }}
                                  >
                                    {dur.text}
                                  </Typography>
                                </Box>
                              </Stack>
                            </Stack>

                            <Stack direction="row" spacing={2} sx={{ mt: 1, flexWrap: "wrap", rowGap: 0.5 }}>
                              <Stack direction="row" spacing={0.5} sx={{ alignItems: "center" }}>
                                <AccessTimeOutlinedIcon sx={{ fontSize: 13, color: "text.disabled" }} />
                                <Typography variant="caption" color="text.secondary" sx={{ fontSize: 12 }}>
                                  {formatTime(patron.entered_at)}
                                </Typography>
                              </Stack>
                              <Stack direction="row" spacing={0.5} sx={{ alignItems: "center" }}>
                                <LocationOnOutlinedIcon sx={{ fontSize: 13, color: "text.disabled" }} />
                                <Typography variant="caption" color="text.secondary" sx={{ fontSize: 12 }}>
                                  {CAMERA_CONFIG[patron.camera_id]?.label || patron.camera_id}
                                </Typography>
                              </Stack>
                            </Stack>
                          </Box>
                        </Stack>
                      </Box>
                    </Paper>
                  </Grid>
                );
              })}
            </Grid>
          )}
        </Box>
      </Paper>
    </Stack>
  );
}
</file>

<file path="src/app/(dashboard)/identify/page.tsx">
"use client";

import { useState } from "react";
import {
  Alert,
  Box,
  Button,
  Checkbox,
  Chip,
  FormControlLabel,
  LinearProgress,
  Paper,
  Stack,
  Table,
  TableBody,
  TableCell,
  TableContainer,
  TableHead,
  TableRow,
  Typography,
} from "@mui/material";
import FaceOutlinedIcon from "@mui/icons-material/FaceOutlined";
import RestartAltOutlinedIcon from "@mui/icons-material/RestartAltOutlined";
import SearchOutlinedIcon from "@mui/icons-material/SearchOutlined";
import CameraCapture from "@/components/camera-capture";
import JobPoll from "@/components/job-poll";
import api, { getErrorMessage } from "@/lib/api-client";
import { shimmer } from "@/lib/animations";

export default function IdentifyPage() {
  const [imageFile, setImageFile] = useState<File | null>(null);
  const [dataUrl, setDataUrl] = useState<string>("");
  const [consent, setConsent] = useState(false);
  const [isLoading, setIsLoading] = useState(false);
  const [jobId, setJobId] = useState<string | null>(null);
  const [error, setError] = useState("");
  const [matches, setMatches] = useState<any[] | null>(null);

  const handleCapture = (file: File, url: string) => {
    setImageFile(file);
    setDataUrl(url);
    setMatches(null);
  };

  const handleSubmit = async (event: React.FormEvent) => {
    event.preventDefault();
    if (!imageFile) return;
    setError("");
    setIsLoading(true);
    setJobId(null);
    setMatches(null);
    try {
      const data = await api.identifyFace(imageFile, consent);
      setJobId(data.job_id);
    } catch (err: any) {
      setError(getErrorMessage(err) || "Nhận diện thất bại.");
      setIsLoading(false);
    }
  };

  const reset = () => {
    setMatches(null);
    setDataUrl("");
    setImageFile(null);
    setJobId(null);
    setError("");
    setIsLoading(false);
  };

  return (
    <Stack spacing={3} sx={{ maxWidth: 1040, mx: "auto" }}>
      <Paper variant="outlined" sx={{ p: 3 }}>
        <Stack direction="row" spacing={1.5} sx={{ alignItems: "center" }}>
          <SearchOutlinedIcon color="primary" />
          <Box>
            <Typography variant="h4" sx={{ fontWeight: 850 }}>Nhận diện khuôn mặt</Typography>
            <Typography color="text.secondary">Tìm người dùng gần nhất trong kho khuôn mặt đã đăng ký.</Typography>
          </Box>
        </Stack>
      </Paper>

      {error && <Alert severity="error">{error}</Alert>}

      {jobId ? (
        <JobPoll
          jobId={jobId}
          onComplete={(result) => { setIsLoading(false); setJobId(null); setMatches(result?.matches || []); }}
          onError={(message) => { setError(message); setIsLoading(false); setJobId(null); }}
        />
      ) : matches ? (
        <Stack spacing={2}>
          <Paper variant="outlined" sx={{ p: 2.5 }}>
            <Stack direction={{ xs: "column", md: "row" }} spacing={2} sx={{ justifyContent: "space-between", alignItems: { md: "center" } }}>
              <Stack direction="row" spacing={1.5} sx={{ alignItems: "center" }}>
                <FaceOutlinedIcon color="primary" />
                <Box>
                  <Typography variant="h5" sx={{ fontWeight: 850 }}>Tìm thấy {matches.length} kết quả</Typography>
                  <Typography color="text.secondary">Kết quả được sắp xếp theo độ tin cậy giảm dần.</Typography>
                </Box>
              </Stack>
              <Button startIcon={<RestartAltOutlinedIcon />} variant="outlined" onClick={reset}>Thử lại</Button>
            </Stack>
          </Paper>

          {dataUrl && (
            <Box component="img" src={dataUrl} alt="Ảnh đã chụp" sx={{ width: 160, height: 160, objectFit: "cover", borderRadius: 2, border: 1, borderColor: "divider", mx: "auto" }} />
          )}

          {matches.length === 0 ? (
            <Alert severity="info">Không tìm thấy khuôn mặt phù hợp.</Alert>
          ) : (
            <Paper variant="outlined" sx={{ overflow: "hidden" }}>
              <TableContainer>
                <Table sx={{ minWidth: 820 }}>
                  <TableHead>
                    <TableRow>
                      <TableCell>Độ tin cậy</TableCell>
                      <TableCell>User ID</TableCell>
                      <TableCell>Tên</TableCell>
                      <TableCell>Email</TableCell>
                      <TableCell>Vai trò</TableCell>
                    </TableRow>
                  </TableHead>
                  <TableBody>
                    {matches.map((match, index) => {
                      const score = Number(match.score ?? 0);
                      const percent = Number((score * 100).toFixed(1));
                      return (
                        <TableRow key={`${match.user_id}-${index}`} hover>
                          <TableCell sx={{ minWidth: 180 }}>
                            <Stack direction="row" spacing={1} sx={{ alignItems: "center" }}>
                              <LinearProgress
                                variant="determinate"
                                value={Math.min(percent, 100)}
                                color={score > 0.6 ? "success" : score > 0.3 ? "warning" : "error"}
                                sx={{ width: 90, height: 7, borderRadius: 99 }}
                              />
                              <Typography variant="body2" sx={{ fontFamily: "monospace" }}>{percent}%</Typography>
                            </Stack>
                          </TableCell>
                          <TableCell sx={{ fontFamily: "monospace", color: "text.secondary" }}>{match.user_id}</TableCell>
                          <TableCell sx={{ fontWeight: 750 }}>{match.full_name || "-"}</TableCell>
                          <TableCell sx={{ color: "text.secondary" }}>{match.email || "-"}</TableCell>
                          <TableCell><Chip size="small" label={match.role || "-"} /></TableCell>
                        </TableRow>
                      );
                    })}
                  </TableBody>
                </Table>
              </TableContainer>
            </Paper>
          )}
        </Stack>
      ) : (
        <Paper variant="outlined" sx={{ p: 2.5 }}>
          <Box component="form" onSubmit={handleSubmit}>
            <Stack spacing={2.5}>
              <CameraCapture onCapture={handleCapture} />
              <FormControlLabel
                control={<Checkbox checked={consent} onChange={(event) => setConsent(event.target.checked)} />}
                label="Tôi đồng ý cho hệ thống xử lý dữ liệu khuôn mặt để nhận diện."
              />
              <Button type="submit" variant="contained" disabled={!imageFile || !consent || isLoading} fullWidth>
                {isLoading ? "Đang gửi..." : "Nhận diện khuôn mặt"}
              </Button>
            </Stack>
          </Box>
        </Paper>
      )}
    </Stack>
