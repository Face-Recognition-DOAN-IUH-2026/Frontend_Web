"use client";

import { useCallback, useEffect, useMemo, useState } from "react";
import { useParams, useRouter } from "next/navigation";
import {
  Alert,
  Avatar,
  Box,
  Button,
  Chip,
  Dialog,
  DialogActions,
  DialogContent,
  DialogTitle,
  Divider,
  Grid,
  MenuItem,
  Paper,
  Stack,
  Tab,
  Table,
  TableBody,
  TableCell,
  TableContainer,
  TableHead,
  TableRow,
  Tabs,
  TextField,
  Typography,
} from "@mui/material";
import AdminPanelSettingsOutlinedIcon from "@mui/icons-material/AdminPanelSettingsOutlined";
import BadgeOutlinedIcon from "@mui/icons-material/BadgeOutlined";
import CalendarTodayIcon from "@mui/icons-material/CalendarTodayOutlined";
import DeleteOutlineOutlinedIcon from "@mui/icons-material/DeleteOutlineOutlined";
import EditOutlinedIcon from "@mui/icons-material/EditOutlined";
import ErrorOutlineOutlinedIcon from "@mui/icons-material/ErrorOutlineOutlined";
import FaceRetouchingNaturalOutlinedIcon from "@mui/icons-material/FaceRetouchingNaturalOutlined";
import FingerprintOutlinedIcon from "@mui/icons-material/FingerprintOutlined";
import HistoryOutlinedIcon from "@mui/icons-material/HistoryOutlined";
import MailIcon from "@mui/icons-material/MailOutlined";
import PersonIcon from "@mui/icons-material/PersonOutlined";
import PhoneIcon from "@mui/icons-material/PhoneOutlined";
import LocationOnIcon from "@mui/icons-material/LocationOnOutlined";
import SchoolIcon from "@mui/icons-material/SchoolOutlined";
import ShieldIcon from "@mui/icons-material/ShieldOutlined";
import VerifiedIcon from "@mui/icons-material/VerifiedOutlined";
import api, { getErrorMessage } from "@/lib/api-client";
import PageHeader from "@/app/(dashboard)/_components/ui/PageHeader";
import DashboardCard from "@/app/(dashboard)/_components/ui/DashboardCard";
import EmptyState from "@/app/(dashboard)/_components/ui/EmptyState";
import LoadingOverlay from "@/app/(dashboard)/_components/ui/LoadingOverlay";
import notification from "antd/es/notification";
import { staggerSx } from "@/lib/useStaggeredAnimation";
import { initials, formatDate, formatDateTime, roleLabel, statusLabel, statusColor } from "@/lib/utils";
import type { UserPublic } from "@/lib/types";

const ROLE_OPTIONS = [
  { value: "patron", label: "Độc giả (Patron)" },
  { value: "staff", label: "Nhân viên (Staff)" },
  { value: "admin", label: "Quản trị (Admin)" },
];

const STATUS_OPTIONS = [
  { value: "active", label: "Hoạt động" },
  { value: "suspended", label: "Tạm khóa" },
  { value: "inactive", label: "Không hoạt động" },
];

function MetaRow({ icon, label, value }: { icon: React.ReactNode; label: string; value: React.ReactNode }) {
  return (
    <Stack direction="row" spacing={1.5} sx={{ alignItems: "flex-start", py: 1 }}>
      <Box sx={{ color: "text.secondary", mt: 0.3, minWidth: 20 }}>{icon}</Box>
      <Box sx={{ flex: 1, minWidth: 0 }}>
        <Typography variant="caption" color="text.secondary" sx={{ textTransform: "uppercase", letterSpacing: 0.5 }}>
          {label}
        </Typography>
        <Typography variant="body2" sx={{ fontWeight: 600, wordBreak: "break-word" }}>
          {value || "-"}
        </Typography>
      </Box>
    </Stack>
  );
}

export default function UserDetailPage() {
  const [apiAnt, contextHolder] = notification.useNotification();
  const { id } = useParams<{ id: string }>();
  const router = useRouter();

  const [user, setUser] = useState<UserPublic | null>(null);
  const [loading, setLoading] = useState(true);
  const [tab, setTab] = useState(0);

  const [editForm, setEditForm] = useState({
    full_name: "",
    phone: "",
    student_code: "",
    class_name: "",
    course: "",
    identity_number: "",
    permanent_address: "",
    card_number: "",
    issue_date: "",
    membership_expiry: "",
    role: "",
    status: "active",
  });
  const [showEdit, setShowEdit] = useState(false);
  const [saving, setSaving] = useState(false);
  const [editError, setEditError] = useState("");

  const [showDelete, setShowDelete] = useState(false);
  const [deleteConfirmText, setDeleteConfirmText] = useState("");

  const loadUser = useCallback(async () => {
    try {
      const data = await api.getUser(id);
      setUser(data);
    } catch {
      try {
        const list = await api.listUsers();
        const found = list.users.find((u) => u.id === id);
        if (found) setUser(found);
        else setUser(null);
      } catch {
        setUser(null);
      }
    }
  }, [id]);

  useEffect(() => {
    (async () => {
      setLoading(true);
      await loadUser();
      setLoading(false);
    })();
  }, [loadUser]);

  const openEdit = () => {
    if (!user) return;
    setEditForm({
      full_name: user.full_name || "",
      phone: user.phone || "",
      student_code: user.student_code || "",
      class_name: user.class_name || "",
      course: user.course || "",
      identity_number: user.identity_number || "",
      permanent_address: user.permanentAddress || user.permanent_address || "",
      card_number: user.card_number || "",
      issue_date: user.issue_date || "",
      membership_expiry: user.membership_expiry || "",
      role: user.role,
      status: user.status || "active",
    });
    setEditError("");
    setShowEdit(true);
  };

  const handleSave = async () => {
    setEditError("");
    setSaving(true);
    try {
      const data: Record<string, string> = {};
      if (editForm.full_name) data.full_name = editForm.full_name;
      if (editForm.phone) data.phone = editForm.phone;
      if (editForm.student_code) data.student_code = editForm.student_code;
      if (editForm.class_name) data.class_name = editForm.class_name;
      if (editForm.course) data.course = editForm.course;
      if (editForm.identity_number) data.identity_number = editForm.identity_number;
      if (editForm.permanent_address) data.permanent_address = editForm.permanent_address;
      if (editForm.card_number) data.card_number = editForm.card_number;
      if (editForm.issue_date) data.issue_date = editForm.issue_date;
      if (editForm.membership_expiry) data.membership_expiry = editForm.membership_expiry;
      data.role = editForm.role;
      data.status = editForm.status;

      const updated = await api.updateUser(id, data);
      setUser(updated);
      setShowEdit(false);
      apiAnt.success({ title: "Đã cập nhật thông tin người dùng.", placement: "topRight" });
      await loadUser();
    } catch (err: any) {
      const status = err?.response?.status;
      const msg = getErrorMessage(err) || "Lưu thất bại";
      setEditError(
        status === 409
          ? `${msg} — Số thẻ hoặc mã sinh viên đã tồn tại.`
          : msg
      );
    } finally {
      setSaving(false);
    }
  };

  const handleDelete = async () => {
    if (!user || deleteConfirmText !== "XÓA") return;
    try {
      await api.deleteUser(user.id);
      apiAnt.success({ title: "Đã xóa người dùng.", placement: "topRight" });
      router.push("/dashboard/admin");
    } catch (err: any) {
      apiAnt.error({ title: `Xóa thất bại: ${getErrorMessage(err) || "Lỗi không xác định"}`, placement: "topRight" });
    }
  };

  const expired = !user ? false : user.membership_expiry != null && new Date(user.membership_expiry) < new Date();
  const isSuspended = user?.status === "suspended";

  const headerActions = user ? (
    <Stack direction="row" spacing={1} sx={{ flexWrap: "wrap" }}>
      <Button variant="outlined" startIcon={<EditOutlinedIcon />} onClick={openEdit}>
        Sửa
      </Button>
      <Button color="error" variant="outlined" startIcon={<DeleteOutlineOutlinedIcon />} onClick={() => setShowDelete(true)}>
        Xóa
      </Button>
    </Stack>
  ) : null;

  return (
    <LoadingOverlay loading={loading} message="Đang tải hồ sơ người dùng...">
      {!user ? (
        <EmptyState
          icon={<PersonIcon sx={{ fontSize: 56 }} />}
          title="Không tìm thấy người dùng"
          description="Hồ sơ có thể đã bị xóa hoặc ID không hợp lệ."
          action={
            <Button variant="contained" startIcon={<PersonIcon />} onClick={() => router.push("/dashboard/admin")}>
              Quay lại danh sách
            </Button>
          }
        />
      ) : (
        <Stack spacing={3}>
          <PageHeader
            backHref="/dashboard/admin"
            title={user.full_name || "Chưa cập nhật"}
            subtitle={`Email: ${user.email}`}
            icon={AdminPanelSettingsOutlinedIcon}
            actions={headerActions}
          />

          {isSuspended && user.suspended_reason && (
            <Alert severity="error" sx={{ fontWeight: 600 }}>
              Lý do khóa: {user.suspended_reason}
            </Alert>
          )}

          <Grid container spacing={3}>
            {/* Left column — Profile card */}
            <Grid size={{ xs: 12, md: 4 }} sx={staggerSx(0)}>
              <DashboardCard noPadding>
                <Box
                  sx={{
                    height: 100,
                    background: user.role === "admin"
                      ? "linear-gradient(135deg, #f59e0b 0%, #d97706 100%)"
                      : user.role === "staff"
                        ? "linear-gradient(135deg, #3b82f6 0%, #2563eb 100%)"
                        : "linear-gradient(135deg, #64748b 0%, #475569 100%)",
                  }}
                />
                <Box sx={{ px: 2.5, pb: 2.5, mt: -5, textAlign: "center" }}>
                  <Avatar
                    sx={{
                      width: 80,
                      height: 80,
                      mx: "auto",
                      bgcolor: user.role === "admin" ? "rgba(245,158,11,0.15)" : user.role === "staff" ? "rgba(59,130,246,0.15)" : "rgba(100,116,139,0.15)",
                      color: user.role === "admin" ? "warning.main" : user.role === "staff" ? "primary.main" : "text.secondary",
                      fontWeight: 700,
                      fontSize: 28,
                      border: "4px solid",
                      borderColor: "background.paper",
                      boxShadow: 2,
                    }}
                    src={user.avatar_url || undefined}
                  >
                    {initials(user.full_name || user.email)}
                  </Avatar>

                  <Typography variant="h6" sx={{ fontWeight: 800, mt: 1.5 }}>{user.full_name || "Chưa cập nhật"}</Typography>
                  <Typography variant="body2" color="text.secondary" sx={{ fontFamily: "monospace" }}>{user.email}</Typography>

                  <Stack direction="row" spacing={0.75} sx={{ justifyContent: "center", mt: 1.5, flexWrap: "wrap", gap: 0.5 }}>
                    <Chip
                      label={roleLabel(user.role)}
                      color={user.role === "admin" ? "warning" : user.role === "staff" ? "primary" : "default"}
                      size="small"
                      sx={{ fontWeight: 600 }}
                    />
                    <Chip
                      label={statusLabel(user.status || "active")}
                      color={statusColor(user.status || "active")}
                      size="small"
                    />
                    {user.has_face && (
                      <Chip
                        icon={<FaceRetouchingNaturalOutlinedIcon sx={{ fontSize: "16px !important" }} />}
                        label="Face ID"
                        color="success"
                        size="small"
                        variant="outlined"
                      />
                    )}
                  </Stack>

                  <Divider sx={{ my: 2 }} />

                  <Stack spacing={0}>
                    <MetaRow icon={<PhoneIcon fontSize="small" />} label="Điện thoại" value={user.phone} />
                    <MetaRow icon={<SchoolIcon fontSize="small" />} label="Lớp" value={user.class_name} />
                    <MetaRow icon={<SchoolIcon fontSize="small" />} label="Khóa học" value={user.course} />
                    <MetaRow icon={<CalendarTodayIcon fontSize="small" />} label="Hạn thẻ" value={
                      <span style={{ color: expired ? "#d32f2f" : undefined, fontWeight: 700 }}>
                        {formatDate(user.membership_expiry)}{expired ? " (Hết hạn)" : ""}
                      </span>
                    } />
                  </Stack>
                </Box>
              </DashboardCard>
            </Grid>

            {/* Right column — Tabs */}
            <Grid size={{ xs: 12, md: 8 }} sx={staggerSx(1)}>
              <Stack spacing={3}>
                {/* Stats row */}
                <Stack direction="row" spacing={1.5}>
                  {[
                    { label: "Vai trò", value: roleLabel(user.role), color: user.role === "admin" ? "warning" as const : user.role === "staff" ? "info" as const : "default" as const, icon: <ShieldIcon fontSize="small" /> },
                    { label: "Trạng thái", value: statusLabel(user.status || "active"), color: statusColor(user.status || "active"), icon: <VerifiedIcon fontSize="small" /> },
                    { label: "Thẻ", value: user.card_number || "-", color: "success" as const, icon: <BadgeOutlinedIcon fontSize="small" /> },
                  ].map((item, idx) => (
                    <Paper key={item.label} variant="outlined" sx={{
                      flex: 1,
                      p: 1.5,
                      textAlign: "center",
                      borderColor: `${item.color}.main`,
                      borderRadius: 2,
                      background: item.color === "warning" ? "rgba(245,158,11,0.08)" : item.color === "info" ? "rgba(2,136,209,0.08)" : item.color === "success" ? "rgba(46,125,50,0.08)" : "rgba(100,116,139,0.08)",
                      ...staggerSx(idx),
                    }}>
                      <Box sx={{ color: `${item.color}.main`, mb: 0.5 }}>{item.icon}</Box>
                      <Typography variant="h6" sx={{ fontWeight: 900, color: `${item.color}.main`, fontSize: "1rem" }}>{item.value}</Typography>
                      <Typography variant="caption" color="text.secondary" sx={{ textTransform: "uppercase", letterSpacing: 0.5 }}>{item.label}</Typography>
                    </Paper>
                  ))}
                </Stack>

                {/* Tabs */}
                <DashboardCard noPadding>
                  <Box sx={{ borderBottom: 1, borderColor: "divider", px: 2.5 }}>
                    <Tabs value={tab} onChange={(_, v) => setTab(v)}>
                      <Tab label="Thông tin chi tiết" />
                      <Tab label="Hệ thống" />
                    </Tabs>
                  </Box>

                  {/* Tab 0: Info detail */}
                  {tab === 0 && (
                    <Box sx={{ p: 2.5 }}>
                      <Grid container spacing={0.5}>
                        {[
                          { label: "Họ tên", value: user.full_name, icon: <PersonIcon fontSize="small" /> },
                          { label: "Email", value: user.email, icon: <MailIcon fontSize="small" /> },
                          { label: "Số điện thoại", value: user.phone, icon: <PhoneIcon fontSize="small" /> },
                          { label: "Địa chỉ thường trú", value: user.permanent_address || user.permanentAddress, icon: <LocationOnIcon fontSize="small" /> },
                          { label: "Số CCCD/CMND", value: user.identity_number, icon: <BadgeOutlinedIcon fontSize="small" /> },
                          { label: "Mã sinh viên", value: user.student_code, icon: <BadgeOutlinedIcon fontSize="small" /> },
                          { label: "Lớp", value: user.class_name, icon: <SchoolIcon fontSize="small" /> },
                          { label: "Khóa học", value: user.course, icon: <SchoolIcon fontSize="small" /> },
                          { label: "Số thẻ thư viện", value: user.card_number, icon: <BadgeOutlinedIcon fontSize="small" /> },
                          { label: "Ngày cấp thẻ", value: formatDate(user.issue_date), icon: <CalendarTodayIcon fontSize="small" /> },
                          { label: "Hạn membership", value: formatDate(user.membership_expiry), icon: <CalendarTodayIcon fontSize="small" /> },
                          { label: "Vai trò", value: roleLabel(user.role), icon: <ShieldIcon fontSize="small" /> },
                        ].map((item) => (
                          <Grid key={item.label} size={{ xs: 12, sm: 6 }}>
                            <MetaRow icon={item.icon} label={item.label} value={item.value} />
                          </Grid>
                        ))}
                      </Grid>
                    </Box>
                  )}

                  {/* Tab 1: System */}
                  {tab === 1 && (
                    <Box sx={{ p: 2.5 }}>
                      <Grid container spacing={0.5}>
                        {[
                          { label: "ID người dùng", value: user.id, icon: <FingerprintOutlinedIcon fontSize="small" /> },
                          { label: "Ngày tạo", value: formatDateTime(user.created_at), icon: <CalendarTodayIcon fontSize="small" /> },
                          { label: "Lần vào gần nhất", value: formatDateTime(user.last_entry_at), icon: <HistoryOutlinedIcon fontSize="small" /> },
                          { label: "Cổng ghi nhận", value: user.last_entry_camera || "-", icon: <HistoryOutlinedIcon fontSize="small" /> },
                          { label: "Trạng thái hiện tại", value: user.current_status || "-", icon: <VerifiedIcon fontSize="small" /> },
                        ].map((item) => (
                          <Grid key={item.label} size={{ xs: 12, sm: 6 }}>
                            <MetaRow icon={item.icon} label={item.label} value={
                              item.label === "ID người dùng"
                                ? <span style={{ fontFamily: "monospace", fontSize: "0.8rem" }}>{item.value}</span>
                                : item.value
                            } />
                          </Grid>
                        ))}
                      </Grid>
                    </Box>
                  )}
                </DashboardCard>
              </Stack>
            </Grid>
          </Grid>

          {/* Edit dialog */}
          <Dialog open={showEdit} onClose={() => !saving && setShowEdit(false)} fullWidth maxWidth="sm">
            <DialogTitle>Sửa thông tin người dùng</DialogTitle>
            <DialogContent>
              <Stack spacing={2} sx={{ pt: 1 }}>
                {editError && <Alert severity="error">{editError}</Alert>}

                <TextField label="Họ và tên" value={editForm.full_name} onChange={(e) => setEditForm({ ...editForm, full_name: e.target.value })} fullWidth />
                <Typography variant="caption" color="text.secondary">Email không thể chỉnh sửa từ đây (yêu cầu luồng OTP).</Typography>

                <TextField label="Số điện thoại" value={editForm.phone} onChange={(e) => setEditForm({ ...editForm, phone: e.target.value })} fullWidth />
                <TextField label="Mã sinh viên" value={editForm.student_code} onChange={(e) => setEditForm({ ...editForm, student_code: e.target.value })} fullWidth helperText="Phải là duy nhất nếu điền" />
                <TextField label="Lớp" value={editForm.class_name} onChange={(e) => setEditForm({ ...editForm, class_name: e.target.value })} fullWidth />
                <TextField label="Khóa học" value={editForm.course} onChange={(e) => setEditForm({ ...editForm, course: e.target.value })} fullWidth />
                <TextField label="Số CCCD/CMND" value={editForm.identity_number} onChange={(e) => setEditForm({ ...editForm, identity_number: e.target.value })} fullWidth />
                <TextField label="Địa chỉ thường trú" value={editForm.permanent_address} onChange={(e) => setEditForm({ ...editForm, permanent_address: e.target.value })} fullWidth />
                <TextField label="Số thẻ thư viện" value={editForm.card_number} onChange={(e) => setEditForm({ ...editForm, card_number: e.target.value })} fullWidth helperText="Phải là duy nhất nếu điền" />
                <TextField label="Ngày cấp thẻ" type="date" value={editForm.issue_date} onChange={(e) => setEditForm({ ...editForm, issue_date: e.target.value })} fullWidth slotProps={{ inputLabel: { shrink: true } }} />
                <TextField label="Hạn membership" type="date" value={editForm.membership_expiry} onChange={(e) => setEditForm({ ...editForm, membership_expiry: e.target.value })} fullWidth slotProps={{ inputLabel: { shrink: true } }} helperText={editForm.membership_expiry && new Date(editForm.membership_expiry) < new Date() ? "Đã hết hạn" : ""} />

                <TextField select label="Vai trò" value={editForm.role} onChange={(e) => setEditForm({ ...editForm, role: e.target.value })} fullWidth>
                  {ROLE_OPTIONS.map((o) => (
                    <MenuItem key={o.value} value={o.value}>{o.label}</MenuItem>
                  ))}
                </TextField>

                <TextField select label="Trạng thái" value={editForm.status} onChange={(e) => setEditForm({ ...editForm, status: e.target.value })} fullWidth>
                  {STATUS_OPTIONS.map((o) => (
                    <MenuItem key={o.value} value={o.value}>{o.label}</MenuItem>
                  ))}
                </TextField>
              </Stack>
            </DialogContent>
            <DialogActions>
              <Button onClick={() => setShowEdit(false)} disabled={saving}>Hủy</Button>
              <Button variant="contained" onClick={handleSave} disabled={saving}>
                {saving ? "Đang lưu..." : "Lưu thay đổi"}
              </Button>
            </DialogActions>
          </Dialog>

          {/* Delete dialog */}
          <Dialog open={showDelete} onClose={() => { setShowDelete(false); setDeleteConfirmText(""); }} fullWidth maxWidth="xs">
            <DialogTitle>Xóa người dùng?</DialogTitle>
            <DialogContent>
              <Stack spacing={2}>
                <Typography color="text.secondary">
                  Hồ sơ <strong>{user.full_name || user.email}</strong> sẽ bị xóa khỏi hệ thống.
                </Typography>
                <Typography variant="body2" color="text.secondary">
                  Nhập <strong>XÓA</strong> để xác nhận:
                </Typography>
                <TextField value={deleteConfirmText} onChange={(e) => setDeleteConfirmText(e.target.value)} placeholder="Nhập XÓA" size="small" autoFocus fullWidth />
              </Stack>
            </DialogContent>
            <DialogActions>
              <Button onClick={() => { setShowDelete(false); setDeleteConfirmText(""); }}>Hủy</Button>
              <Button color="error" variant="contained" onClick={handleDelete} disabled={deleteConfirmText !== "XÓA"}>Xóa vĩnh viễn</Button>
            </DialogActions>
          </Dialog>

          {contextHolder}
        </Stack>
      )}
    </LoadingOverlay>
  );
}
</file>

<file path="src/app/(dashboard)/profile/page.tsx">
"use client";

import React, { useState, useEffect, useRef } from "react";
import {
  Alert,
  Avatar,
  Box,
  Button,
  Chip,
  CircularProgress,
  Dialog,
  DialogActions,
  DialogContent,
  DialogTitle,
  Grid,
  IconButton,
  InputAdornment,
  Stack,
  TextField,
  Typography,
} from "@mui/material";
import EmailIcon from "@mui/icons-material/EmailOutlined";
import PhoneIcon from "@mui/icons-material/PhoneOutlined";
import LockIcon from "@mui/icons-material/LockOutlined";
import PersonIcon from "@mui/icons-material/PersonOutlined";
import CameraAltIcon from "@mui/icons-material/CameraAltOutlined";
import ShieldIcon from "@mui/icons-material/ShieldOutlined";
import CheckIcon from "@mui/icons-material/Check";
import CloseIcon from "@mui/icons-material/Close";
import KeyIcon from "@mui/icons-material/KeyOutlined";
import AtSignIcon from "@mui/icons-material/AlternateEmailOutlined";
import LocationOnIcon from "@mui/icons-material/LocationOnOutlined";
import api, { getErrorMessage } from "@/lib/api-client";
import type { UserPublic } from "@/lib/types";
import PageHeader from "@/app/(dashboard)/_components/ui/PageHeader";
import DashboardCard from "@/app/(dashboard)/_components/ui/DashboardCard";
import LoadingOverlay from "@/app/(dashboard)/_components/ui/LoadingOverlay";
import notification from "antd/es/notification";

type Notice = { severity: "success" | "error" | "warning" | "info"; message: string } | null;

export default function ProfilePage() {
  const [apiAnt, contextHolder] = notification.useNotification();
  const [user, setUser] = useState<UserPublic | null>(null);
  const [loading, setLoading] = useState(true);

  const [formData, setFormData] = useState({
    full_name: "",
    phone: "",
    permanent_address: "",
  });

  const [savingProfile, setSavingProfile] = useState(false);
  const [uploadingAvatar, setUploadingAvatar] = useState(false);
  const avatarInputRef = useRef<HTMLInputElement>(null);

  const [showPasswordModal, setShowPasswordModal] = useState(false);
  const [showEmailModal, setShowEmailModal] = useState(false);

  const [passData, setPassData] = useState({ old_password: "", new_password: "", confirm_password: "" });
  const [changingPass, setChangingPass] = useState(false);

  const [emailData, setEmailData] = useState({ new_email: "", code: "" });
  const [emailStep, setEmailStep] = useState<"request" | "verify">("request");
  const [emailLoading, setEmailLoading] = useState(false);

  const [notice, setNotice] = useState<Notice>(null);
  const showNotice = (severity: NonNullable<Notice>["severity"], message: string) => {
    if (severity === "success") apiAnt.success({ title: message, placement: "topRight" });
    else if (severity === "error") apiAnt.error({ title: message, placement: "topRight" });
    else if (severity === "warning") apiAnt.warning({ title: message, placement: "topRight" });
    else apiAnt.info({ title: message, placement: "topRight" });
  };

  useEffect(() => { fetchProfile(); }, []);

  const fetchProfile = async () => {
    try {
      setLoading(true);
      const data = await api.getCurrentUser();
      setUser(data);
      setFormData({
        full_name: data.full_name || "",
        phone: (data as any).phone || "",
        permanent_address: (data as any).permanentAddress || (data as any).permanent_address || "",
      });
    } catch {
      showNotice("error", "Không thể tải thông tin cá nhân");
    } finally {
      setLoading(false);
    }
  };

  const handleAvatarUpload = async (e: React.ChangeEvent<HTMLInputElement>) => {
    const file = e.target.files?.[0];
    if (!file) return;
    if (!file.type.startsWith("image/")) return showNotice("error", "Vui lòng chọn file ảnh");
    if (file.size > 5 * 1024 * 1024) return showNotice("error", "Kích thước ảnh tối đa 5MB");
    try {
      setUploadingAvatar(true);
      const result = await api.uploadAvatar(file);
      setUser((prev) => prev ? { ...prev, avatar_url: result.avatarUrl } : prev);
      showNotice("success", "Cập nhật ảnh đại diện thành công!");
    } catch (error: any) {
      showNotice("error", getErrorMessage(error) || "Upload ảnh thất bại");
    } finally {
      setUploadingAvatar(false);
      if (avatarInputRef.current) avatarInputRef.current.value = "";
    }
  };

  const handleProfileUpdate = async (e: React.FormEvent) => {
    e.preventDefault();
    try {
      setSavingProfile(true);
      await api.updateProfile(formData);
      showNotice("success", "Cập nhật hồ sơ thành công!");
      fetchProfile();
    } catch (error: any) {
      showNotice("error", getErrorMessage(error) || "Cập nhật thất bại");
    } finally {
      setSavingProfile(false);
    }
  };

  const handlePasswordChange = async (e: React.FormEvent) => {
    e.preventDefault();
    if (passData.new_password !== passData.confirm_password) return showNotice("error", "Mật khẩu xác nhận không khớp");
    if (passData.new_password.length < 6) return showNotice("error", "Mật khẩu mới phải ít nhất 6 ký tự");
    try {
      setChangingPass(true);
      await api.changePassword({ old_password: passData.old_password, new_password: passData.new_password });
      showNotice("success", "Đổi mật khẩu thành công!");
      setShowPasswordModal(false);
      setPassData({ old_password: "", new_password: "", confirm_password: "" });
    } catch (error: any) {
      showNotice("error", getErrorMessage(error) || "Đổi mật khẩu thất bại");
    } finally {
      setChangingPass(false);
    }
  };

  const requestEmailOtp = async (e: React.FormEvent) => {
    e.preventDefault();
    if (!emailData.new_email) return showNotice("error", "Vui lòng nhập email mới");
    try {
      setEmailLoading(true);
      await api.requestEmailChangeOtp({ new_email: emailData.new_email });
      showNotice("success", "Đã gửi mã OTP đến email mới");
      setEmailStep("verify");
    } catch (error: any) {
      showNotice("error", getErrorMessage(error) || "Không thể gửi OTP");
    } finally {
      setEmailLoading(false);
    }
  };

  const verifyEmailOtp = async (e: React.FormEvent) => {
    e.preventDefault();
    if (!emailData.code) return showNotice("error", "Vui lòng nhập mã OTP");
    try {
      setEmailLoading(true);
      await api.verifyAndChangeEmail({ new_email: emailData.new_email, otp: emailData.code });
      showNotice("success", "Đổi email thành công!");
      setShowEmailModal(false);
      setEmailData({ new_email: "", code: "" });
      setEmailStep("request");
      fetchProfile();
    } catch (error: any) {
      showNotice("error", getErrorMessage(error) || "Xác thực thất bại");
    } finally {
      setEmailLoading(false);
    }
  };

  const roleLabel = (role?: string) => {
    if (role === "admin") return "Quản trị viên";
    if (role === "staff") return "Nhân viên";
    return "Độc giả";
  };

  const roleColor: "error" | "warning" | "info" = user?.role === "admin" ? "error" : user?.role === "staff" ? "warning" : "info";

  if (loading) {
    return <LoadingOverlay message="Đang tải hồ sơ..." />;
  }

  return (
    <Stack spacing={3}>
      <PageHeader
        title="Hồ Sơ Cá Nhân"
        subtitle="Quản lý thông tin cá nhân và bảo mật tài khoản"
        icon={PersonIcon}
      />

      <Grid container spacing={3}>
        <Grid size={{ xs: 12, md: 4 }}>
          <Stack spacing={3}>
            <DashboardCard>
              <Stack spacing={2} sx={{ alignItems: "center", textAlign: "center", py: 1 }}>
                <Box
                  onClick={() => avatarInputRef.current?.click()}
                  sx={{ position: "relative", cursor: "pointer", "&:hover .avatar-overlay": { opacity: 1 } }}
                >
                  <input ref={avatarInputRef} type="file" accept="image/*" hidden onChange={handleAvatarUpload} />
                  <Avatar
                    src={user?.avatar_url || undefined}
                    sx={{ width: 112, height: 112, fontSize: 48, bgcolor: "primary.main", border: "4px solid", borderColor: "divider" }}
                  >
                    <PersonIcon sx={{ fontSize: 48 }} />
                  </Avatar>
                  <Box
                    className="avatar-overlay"
                    sx={{
                      position: "absolute", inset: 0, borderRadius: "50%",
                      bgcolor: "rgba(0,0,0,0.5)", display: "grid", placeItems: "center",
                      opacity: 0, transition: "opacity 0.2s",
                    }}
                  >
                    {uploadingAvatar ? <CircularProgress size={28} sx={{ color: "#fff" }} /> : <CameraAltIcon sx={{ color: "#fff", fontSize: 28 }} />}
                  </Box>
                </Box>

                <Typography variant="h6" sx={{ fontWeight: 700 }}>
                  {user?.full_name || "Chưa cập nhật"}
                </Typography>
                <Chip label={roleLabel(user?.role)} color={roleColor} size="small" variant="outlined" sx={{ fontWeight: 600 }} />

                <Stack spacing={1} sx={{ width: "100%", pt: 2, borderTop: 1, borderColor: "divider" }}>
                  <Stack direction="row" spacing={1} sx={{ alignItems: "center", overflow: "hidden" }}>
                    <EmailIcon sx={{ fontSize: 16, color: "text.secondary", flexShrink: 0 }} />
                    <Typography variant="body2" color="text.secondary" noWrap>{user?.email}</Typography>
                  </Stack>
                  {(user as any)?.phone ? (
                    <Stack direction="row" spacing={1} sx={{ alignItems: "center" }}>
                      <PhoneIcon sx={{ fontSize: 16, color: "text.secondary", flexShrink: 0 }} />
                      <Typography variant="body2" color="text.secondary">{(user as any).phone}</Typography>
                    </Stack>
                  ) : null}
                  {(user as any)?.studentCode ? (
                    <Stack direction="row" spacing={1} sx={{ alignItems: "center" }}>
                      <Typography variant="caption" color="text.secondary" sx={{ flexShrink: 0 }}>MSSV:</Typography>
                      <Typography variant="body2" sx={{ fontFamily: "monospace" }}>{(user as any).studentCode}</Typography>
                    </Stack>
                  ) : null}
                </Stack>
              </Stack>
            </DashboardCard>

            <DashboardCard title="Bảo mật tài khoản">
              <Stack spacing={1}>
                <Button
                  fullWidth variant="outlined" startIcon={<AtSignIcon />}
                  onClick={() => setShowEmailModal(true)}
                  sx={{ justifyContent: "flex-start", borderRadius: 2, textTransform: "none" }}
                >
                  Đổi Email
                </Button>
                <Button
                  fullWidth variant="outlined" startIcon={<KeyIcon />}
                  onClick={() => setShowPasswordModal(true)}
                  sx={{ justifyContent: "flex-start", borderRadius: 2, textTransform: "none" }}
                >
                  Đổi Mật Khẩu
                </Button>
              </Stack>
            </DashboardCard>
          </Stack>
        </Grid>

        <Grid size={{ xs: 12, md: 8 }}>
          <DashboardCard title="Thông tin cơ bản">
            <form onSubmit={handleProfileUpdate}>
              <Stack spacing={2.5}>
                <Grid container spacing={2.5}>
                  <Grid size={{ xs: 12, sm: 6 }}>
                    <TextField
                      label="Họ và tên" fullWidth value={formData.full_name}
                      onChange={(e) => setFormData({ ...formData, full_name: e.target.value })}
                      placeholder="Nguyễn Văn A"
                    />
                  </Grid>
                  <Grid size={{ xs: 12, sm: 6 }}>
                    <TextField label="Email" fullWidth value={user?.email || ""} disabled helperText='Dùng nút "Đổi Email" để thay đổi' />
                  </Grid>
                  <Grid size={{ xs: 12 }}>
                    <TextField
                      label="Số điện thoại" fullWidth value={formData.phone}
                      onChange={(e) => setFormData({ ...formData, phone: e.target.value })}
                      placeholder="0912 345 678"
                    />
                  </Grid>
                  <Grid size={{ xs: 12 }}>
                    <TextField
                      label="Địa chỉ thường trú" fullWidth value={formData.permanent_address}
                      onChange={(e) => setFormData({ ...formData, permanent_address: e.target.value })}
                      placeholder="12 Nguyễn Văn Bảo, Gò Vấp, TP.HCM"
                    />
                  </Grid>
                </Grid>
                <Stack direction="row" sx={{ justifyContent: "flex-end", pt: 2, borderTop: 1, borderColor: "divider" }}>
                  <Button type="submit" variant="contained" disabled={savingProfile} startIcon={savingProfile ? <CircularProgress size={16} color="inherit" /> : <CheckIcon />} sx={{ borderRadius: 2, fontWeight: 700, textTransform: "none" }}>
                    {savingProfile ? "Đang lưu..." : "Lưu thay đổi"}
                  </Button>
                </Stack>
              </Stack>
            </form>
          </DashboardCard>
        </Grid>
      </Grid>

      <Dialog open={showPasswordModal} onClose={() => setShowPasswordModal(false)} maxWidth="xs" fullWidth>
        <DialogTitle sx={{ fontWeight: 800, display: "flex", alignItems: "center", gap: 1 }}>
          <KeyIcon color="primary" /> Đổi Mật Khẩu
          <Box sx={{ flex: 1 }} />
          <IconButton size="small" onClick={() => setShowPasswordModal(false)}><CloseIcon fontSize="small" /></IconButton>
        </DialogTitle>
        <DialogContent>
          <form onSubmit={handlePasswordChange}>
            <Stack spacing={2.5} sx={{ pt: 1 }}>
              <TextField label="Mật khẩu hiện tại" type="password" fullWidth required value={passData.old_password} onChange={(e) => setPassData({ ...passData, old_password: e.target.value })} />
              <TextField label="Mật khẩu mới" type="password" fullWidth required value={passData.new_password} onChange={(e) => setPassData({ ...passData, new_password: e.target.value })} helperText="Tối thiểu 6 ký tự" />
              <TextField label="Xác nhận mật khẩu mới" type="password" fullWidth required value={passData.confirm_password} onChange={(e) => setPassData({ ...passData, confirm_password: e.target.value })} />
              <Stack direction="row" spacing={1.5} sx={{ justifyContent: "flex-end", pt: 1 }}>
                <Button variant="outlined" onClick={() => setShowPasswordModal(false)} disabled={changingPass}>Hủy</Button>
                <Button type="submit" variant="contained" disabled={changingPass} startIcon={changingPass ? <CircularProgress size={16} color="inherit" /> : undefined}>
                  {changingPass ? "Đang lưu..." : "Cập nhật"}
                </Button>
              </Stack>
            </Stack>
          </form>
        </DialogContent>
      </Dialog>

      <Dialog open={showEmailModal} onClose={() => { setShowEmailModal(false); setEmailStep("request"); setEmailData({ new_email: "", code: "" }); }} maxWidth="xs" fullWidth>
        <DialogTitle sx={{ fontWeight: 800, display: "flex", alignItems: "center", gap: 1 }}>
          <AtSignIcon color="primary" /> Đổi Email
          <Box sx={{ flex: 1 }} />
          <IconButton size="small" onClick={() => { setShowEmailModal(false); setEmailStep("request"); setEmailData({ new_email: "", code: "" }); }}><CloseIcon fontSize="small" /></IconButton>
        </DialogTitle>
        <DialogContent>
          {emailStep === "request" ? (
            <form onSubmit={requestEmailOtp}>
              <Stack spacing={2.5} sx={{ pt: 1 }}>
                <Alert severity="info" sx={{ borderRadius: 2 }}>Để đổi email, nhập địa chỉ email mới. Chúng tôi sẽ gửi mã OTP đến đó để xác minh.</Alert>
                <TextField label="Email hiện tại" fullWidth value={user?.email || ""} disabled />
                <TextField label="Email mới" type="email" fullWidth required autoFocus value={emailData.new_email} onChange={(e) => setEmailData({ ...emailData, new_email: e.target.value })} placeholder="email_moi@example.com" />
                <Stack direction="row" spacing={1.5} sx={{ justifyContent: "flex-end" }}>
                  <Button variant="outlined" onClick={() => setShowEmailModal(false)} disabled={emailLoading}>Hủy</Button>
                  <Button type="submit" variant="contained" disabled={emailLoading} startIcon={emailLoading ? <CircularProgress size={16} color="inherit" /> : undefined}>
                    {emailLoading ? "Đang gửi..." : "Gửi mã OTP"}
                  </Button>
                </Stack>
              </Stack>
            </form>
          ) : (
            <form onSubmit={verifyEmailOtp}>
              <Stack spacing={2.5} sx={{ pt: 1 }}>
                <Alert severity="success" sx={{ borderRadius: 2 }}>
                  Mã OTP đã được gửi đến <strong>{emailData.new_email}</strong>
                </Alert>
                <TextField
                  label="Nhập mã OTP (6 số)" fullWidth required autoFocus
                  value={emailData.code}
                  onChange={(e) => setEmailData({ ...emailData, code: e.target.value.replace(/\D/g, "") })}
                  slotProps={{ htmlInput: { maxLength: 6, style: { textAlign: "center", fontSize: "1.5rem", letterSpacing: "0.5em", fontFamily: "monospace" } } }}
                />
                <Stack direction="row" spacing={1.5} sx={{ justifyContent: "flex-end" }}>
                  <Button variant="outlined" onClick={() => setEmailStep("request")} disabled={emailLoading}>Quay lại</Button>
                  <Button type="submit" variant="contained" disabled={emailLoading || emailData.code.length !== 6} startIcon={emailLoading ? <CircularProgress size={16} color="inherit" /> : <CheckIcon />}>
                    {emailLoading ? "Đang xác thực..." : "Xác thực"}
                  </Button>
                </Stack>
              </Stack>
            </form>
          )}
        </DialogContent>
      </Dialog>

      {contextHolder}
    </Stack>
  );
}
</file>

<file path="src/app/(dashboard)/books/page.tsx">
"use client";

import { useCallback, useEffect, useRef, useState } from "react";
import { useRouter } from "next/navigation";
import {
  Alert,
  Box,
  Button,
  Checkbox,
  Chip,
  CircularProgress,
  Dialog,
  DialogActions,
  DialogContent,
  DialogTitle,
  Divider,
  Fade,
  IconButton,
  Paper,
  Stack,
  Table,
  TableBody,
  TableCell,
  TableContainer,
  TableHead,
  TableRow,
  TextField,
  Tooltip,
  Typography,
} from "@mui/material";
import AntdTable from "antd/es/table";
import type { ColumnsType } from "antd/es/table";
import AlertIcon from "@mui/icons-material/WarningAmberOutlined";
import AssignmentIcon from "@mui/icons-material/AssignmentOutlined";
import BookIcon from "@mui/icons-material/MenuBookOutlined";
import CheckIcon from "@mui/icons-material/CheckCircleOutlined";
import CloseIcon from "@mui/icons-material/Close";
import DeleteIcon from "@mui/icons-material/DeleteOutlineOutlined";
import DescriptionIcon from "@mui/icons-material/DescriptionOutlined";
import TableChartIcon from "@mui/icons-material/TableChartOutlined";
import EyeIcon from "@mui/icons-material/VisibilityOutlined";
import FileIcon from "@mui/icons-material/InsertDriveFileOutlined";
import InventoryIcon from "@mui/icons-material/Inventory2Outlined";
import LibraryIcon from "@mui/icons-material/LocalLibraryOutlined";
import LockIcon from "@mui/icons-material/LockOutlined";
import PrintIcon from "@mui/icons-material/PrintOutlined";
import QrCodeScannerIcon from "@mui/icons-material/QrCodeScannerOutlined";
import UploadIcon from "@mui/icons-material/UploadFileOutlined";
import api, { getErrorMessage } from "@/lib/api-client";
import { shimmer, slideInRight } from "@/lib/animations";
import { useAIWidgetStore } from "@/app/(dashboard)/_components/AIWidget/store/useAIWidgetStore";
import PageHeader from "@/app/(dashboard)/_components/ui/PageHeader";
import DashboardCard from "@/app/(dashboard)/_components/ui/DashboardCard";
import MuiStatCard from "@/app/(dashboard)/_components/ui/MuiStatCard";
import EmptyState from "@/app/(dashboard)/_components/ui/EmptyState";
import LoadingOverlay from "@/app/(dashboard)/_components/ui/LoadingOverlay";
import notification from "antd/es/notification";
import SearchField from "@/app/(dashboard)/_components/ui/SearchField";
import { staggerSx } from "@/lib/useStaggeredAnimation";
import IsbnScannerDialog from "@/app/(dashboard)/_components/IsbnScannerDialog";
import type { BookImportPreviewRow, BookImportResultRow, BookWithStats } from "@/lib/types";

type Notice = { severity: "success" | "error" | "warning" | "info"; message: string } | null;

const STAT_GRADIENT = {
  books: "linear-gradient(135deg, #6366f1 0%, #4338ca 100%)",
  copies: "linear-gradient(135deg, #3b82f6 0%, #1d4ed8 100%)",
  available: "linear-gradient(135deg, #10b981 0%, #059669 100%)",
  borrowed: "linear-gradient(135deg, #f59e0b 0%, #d97706 100%)",
};

function statusColor(status: string): "success" | "info" | "warning" | "error" | "default" {
  if (["new", "imported"].includes(status)) return "success";
  if (["updated"].includes(status)) return "info";
  if (["exists", "skipped"].includes(status)) return "default";
  if (["warning"].includes(status)) return "warning";
  return "error";
}

function statusLabel(status: string) {
  const labels: Record<string, string> = {
    exists: "Đã có",
    new: "Mới",
    warning: "Cảnh báo",
    invalid: "Lỗi",
    imported: "Thành công",
    updated: "Cập nhật",
    skipped: "Bỏ qua",
    error: "Lỗi",
  };
  return labels[status] || status;
}

export default function BooksPage() {
  const [apiAnt, contextHolder] = notification.useNotification();
  const router = useRouter();
  const fileInputRef = useRef<HTMLInputElement>(null);
  const [books, setBooks] = useState<BookWithStats[]>([]);
  const [total, setTotal] = useState(0);
  const [aggregateStats, setAggregateStats] = useState<{ totalCopies: number; availableCopies: number; borrowedCopies: number } | null>(null);
  const [loading, setLoading] = useState(true);
  const [searchQuery, setSearchQuery] = useState("");
  const [searchResults, setSearchResults] = useState<BookWithStats[]>([]);
  const [searching, setSearching] = useState(false);
  const [previewFile, setPreviewFile] = useState<File | null>(null);
  const [previewData, setPreviewData] = useState<BookImportPreviewRow[] | null>(null);
  const [previewLoading, setPreviewLoading] = useState(false);
  const [selectedPreviewIndices, setSelectedPreviewIndices] = useState<Set<number>>(new Set());
  const [deletePreviewOpen, setDeletePreviewOpen] = useState(false);
  const [importing, setImporting] = useState(false);
  const [importResults, setImportResults] = useState<BookImportResultRow[] | null>(null);
  const [showResults, setShowResults] = useState(false);
  const [recentlyPrinted, setRecentlyPrinted] = useState<string[]>([]);
  const [page, setPage] = useState(0);
  const limit = 30;
  const [selectedBook, setSelectedBook] = useState<BookWithStats | null>(null);
  const [editQuantity, setEditQuantity] = useState(0);
  const [savingQuantity, setSavingQuantity] = useState(false);
  const [quantityError, setQuantityError] = useState("");
  const [isbnScannerOpen, setIsbnScannerOpen] = useState(false);
  const [selectedIds, setSelectedIds] = useState<Set<string>>(new Set());
  const [deleteConfirmOpen, setDeleteConfirmOpen] = useState(false);
  const [deleteInput, setDeleteInput] = useState("");
  const [deleting, setDeleting] = useState(false);
  const deleteConfirmed = deleteInput.trim().normalize('NFC').toUpperCase() === 'XÓA';

  const showNotice = (severity: NonNullable<Notice>["severity"], message: string) => {
    if (severity === "success") apiAnt.success({ title: message, placement: "topRight" });
    else if (severity === "error") apiAnt.error({ title: message, placement: "topRight" });
    else if (severity === "warning") apiAnt.warning({ title: message, placement: "topRight" });
    else apiAnt.info({ title: message, placement: "topRight" });
  };

  const loadBooks = useCallback(async () => {
    setLoading(true);
    try {
      const data = await api.listBooks({ skip: page * limit, limit });
      setBooks(data.items ?? []);
      setTotal(data.total ?? 0);
      if (data.aggregateStats) {
        setAggregateStats(data.aggregateStats);
      }
    } catch (err) {
      showNotice("error", getErrorMessage(err) || "Lỗi tải dữ liệu sách");
      setBooks([]);
      setTotal(0);
    } finally {
      setLoading(false);
    }
  }, [page]);

  useEffect(() => {
    loadBooks();
  }, [loadBooks]);

  useEffect(() => {
    if (!searchQuery.trim()) {
      setSearchResults([]);
      return;
    }
    const timer = setTimeout(async () => {
      setSearching(true);
      try {
        setSearchResults(await api.searchBooks(searchQuery));
      } catch {
        setSearchResults([]);
      } finally {
        setSearching(false);
      }
    }, 400);
    return () => clearTimeout(timer);
  }, [searchQuery]);

  useEffect(() => {
    if (!searchQuery.trim() || searching) return;
    const timer = setTimeout(() => {
      if (searchResults.length === 0 && searchQuery.trim()) {
        useAIWidgetStore.getState().recordFailedSearch();
      } else if (searchResults.length > 0) {
        useAIWidgetStore.getState().resetFailedSearch();
      }
    }, 100);
    return () => clearTimeout(timer);
  }, [searchResults, searchQuery, searching]);

  const handleFileChange = async (event: React.ChangeEvent<HTMLInputElement>) => {
    const file = event.target.files?.[0];
    if (!file) return;
    setPreviewFile(file);
    setPreviewData(null);
    setShowResults(false);
    setPreviewLoading(true);
    try {
      const data = await api.getBarcodePreview(file);
      setPreviewData(data.rows);
      showNotice("info", `Đã đọc ${data.total_rows} dòng từ file Excel`);
    } catch (err) {
      showNotice("error", getErrorMessage(err) || "Lỗi đọc file");
    } finally {
      setPreviewLoading(false);
      if (fileInputRef.current) fileInputRef.current.value = "";
    }
  };

  const handleImport = async () => {
    if (!previewFile) return;
    setImporting(true);
    setShowResults(false);
    try {
      let result;
      if (previewData && previewData.length > 0) {
        result = await api.importBooksFiltered(previewData.map((row) => ({
          isbn: row.isbn,
          quantity: row.quantity,
          title: row.title,
          subtitle: row.subtitle ?? null,
          author: row.author ?? null,
          publisher: row.publisher ?? null,
          published_date: row.published_date ?? null,
          page_count: row.page_count ?? null,
          categories: row.categories ?? null,
          cover_url: row.cover_url ?? null,
          description: (row as any).description ?? null,
          average_rating: (row as any).average_rating ?? null,
          language: (row as any).language ?? null,
          isbn10: (row as any).isbn10 ?? null,
          isbn13: (row as any).isbn13 ?? null,
        })));
      } else {
        result = await api.importBooks(previewFile);
      }
      setImportResults(result.results);
      setShowResults(true);
      setPreviewData(null);
      setPreviewFile(null);
      setSearchQuery("");
      setPage(0);
      await loadBooks();
      showNotice(result.errors === 0 ? "success" : "warning", result.errors === 0
        ? `Đã nhập ${result.imported} đầu sách`
        : `${result.imported} nhập thành công, ${result.errors} lỗi`);
    } catch (err) {
      showNotice("error", getErrorMessage(err) || "Lỗi nhập kho");
    } finally {
      setImporting(false);
    }
  };

  const handleQuantitySave = async () => {
    if (!selectedBook) return;
    const borrowed = selectedBook.total_copies - selectedBook.available_copies;
    if (editQuantity < borrowed) {
      setQuantityError(`Tối thiểu ${borrowed} bản vì đang có ${borrowed} bản được mượn`);
      return;
    }
    if (editQuantity < 1) {
      setQuantityError("Số lượng phải lớn hơn 0");
      return;
    }
    setSavingQuantity(true);
    try {
      const updated = await api.updateBookQuantity(selectedBook.id, editQuantity);
      setBooks((prev) => prev.map((book) => book.id === updated.id ? updated : book));
      setSearchResults((prev) => prev.map((book) => book.id === updated.id ? updated : book));
      showNotice("success", `Đã cập nhật số lượng: ${updated.total_copies} bản`);
      setSelectedBook(null);
    } catch (err) {
      showNotice("error", getErrorMessage(err) || "Cập nhật thất bại");
    } finally {
      setSavingQuantity(false);
    }
  };

  const handlePrintBarcodes = async (bookId?: string) => {
    try {
      const barcodes = await api.getBarcodes(bookId);
      if (barcodes.length === 0) {
        showNotice("info", "Không tìm thấy mã vạch để in");
        return;
      }
      setRecentlyPrinted(barcodes.map((item) => item.barcode));
      showNotice("success", `${barcodes.length} mã vạch sẵn sàng in`);
    } catch (err) {
      showNotice("error", getErrorMessage(err) || "Không thể lấy mã vạch");
    }
  };

  const handleIsbnImportComplete = (results: BookImportResultRow[]) => {
    setIsbnScannerOpen(false);
    setSearchQuery("");
    setPage(0);
    loadBooks();
    const importedCount = results.filter((r) => r.status === "imported" || r.status === "updated").length;
    const errorCount = results.filter((r) => r.status === "error").length;
    if (errorCount === 0) {
      showNotice("success", `Đã nhập ${importedCount} đầu sách từ ISBN`);
    } else {
      showNotice("warning", `${importedCount} thành công, ${errorCount} lỗi`);
    }
  };

  const openQuantityDialog = (book: BookWithStats) => {
    setSelectedBook(book);
    setEditQuantity(book.total_copies);
    setQuantityError("");
  };

  const handleToggleSelect = (id: string) => {
    setSelectedIds((prev) => {
      const next = new Set(prev);
      if (next.has(id)) next.delete(id);
      else next.add(id);
      return next;
    });
  };

  const handleToggleSelectAll = () => {
    setSelectedIds((prev) => {
      if (prev.size === displayBooks.length) return new Set();
      return new Set(displayBooks.map((b) => b.id));
    });
  };

  const handleBulkDelete = async () => {
    if (selectedIds.size === 0) return;
    setDeleting(true);
    try {
      const result = await api.bulkDeleteBooks(Array.from(selectedIds));
      setSelectedIds(new Set());
      setDeleteConfirmOpen(false);
      setDeleteInput("");
      setPage(0);
      await loadBooks();
      if (result.errors.length === 0) {
        showNotice("success", `Đã xóa ${result.deleted} cuốn sách`);
      } else {
        showNotice("warning", `Xóa ${result.deleted} thành công, ${result.errors.length} lỗi: ${result.errors.join("; ")}`);
      }
    } catch (err) {
      showNotice("error", getErrorMessage(err) || "Xóa thất bại");
    } finally {
      setDeleting(false);
    }
  };

  const stats = aggregateStats
    ? {
        totalBooks: total,
        totalCopies: aggregateStats.totalCopies,
        availableCopies: aggregateStats.availableCopies,
        borrowedCopies: aggregateStats.borrowedCopies,
      }
    : {
        totalBooks: total,
        totalCopies: books.reduce((sum, book) => sum + book.total_copies, 0),
        availableCopies: books.reduce((sum, book) => sum + book.available_copies, 0),
        borrowedCopies: books.reduce((sum, book) => sum + (book.total_copies - book.available_copies), 0),
      };
  const displayBooks = searchQuery.trim() ? searchResults : books;

  const bookColumns: ColumnsType<BookWithStats> = [
    {
      title: "ISBN",
      dataIndex: "isbn",
      key: "isbn",
      width: 140,
      sorter: (a, b) => (a.isbn || "").localeCompare(b.isbn || ""),
      render: (val: string) => (
        <span style={{ fontFamily: "monospace", color: "#1A73E8", fontWeight: 600 }}>{val}</span>
      ),
    },
    {
      title: "Tiêu đề",
      dataIndex: "title",
      key: "title",
      width: 280,
      sorter: (a, b) => a.title.localeCompare(b.title),
      render: (_: string, record: BookWithStats) => (
        <Stack direction="row" spacing={1.25} sx={{ alignItems: "center" }}>
          {record.cover_url ? (
            <Box component="img" src={record.cover_url} alt={record.title} sx={{ width: 34, height: 44, objectFit: "cover", borderRadius: 1, border: 1, borderColor: "divider" }} />
          ) : (
            <Paper variant="outlined" sx={{ width: 34, height: 44, display: "grid", placeItems: "center", bgcolor: "background.default", borderRadius: 1 }}>
              <BookIcon fontSize="small" />
            </Paper>
          )}
          <Typography variant="body2" sx={{ fontWeight: 800 }}>{record.title}</Typography>
        </Stack>
      ),
    },
    {
      title: "Tác giả",
      dataIndex: "author",
      key: "author",
      width: 160,
      sorter: (a, b) => (a.author || "").localeCompare(b.author || ""),
      render: (val: string) => val || "-",
    },
    {
      title: "NXB",
      dataIndex: "publisher",
      key: "publisher",
      width: 140,
      render: (val: string) => val || "-",
    },
    {
      title: "Tổng",
      dataIndex: "total_copies",
      key: "total_copies",
      width: 80,
      align: "center" as const,
      sorter: (a, b) => a.total_copies - b.total_copies,
    },
    {
      title: "Sẵn sàng",
      dataIndex: "available_copies",
      key: "available_copies",
      width: 100,
      align: "center" as const,
      sorter: (a, b) => a.available_copies - b.available_copies,
      render: (val: number) => (
        <Chip size="small" color={val > 0 ? "success" : "error"} label={val} />
      ),
    },
    {
      title: "Mượn",
      key: "borrowed",
      width: 80,
      align: "center" as const,
      render: (_: unknown, record: BookWithStats) => record.total_copies - record.available_copies,
    },
  ];

  const statItems = [
    { label: "TỔNG ĐẦU SÁCH", value: stats.totalBooks, gradient: STAT_GRADIENT.books, icon: BookIcon, pct: total > 0 ? 100 : 0 },
    { label: "TỔNG BẢN SAO", value: stats.totalCopies, gradient: STAT_GRADIENT.copies, icon: InventoryIcon, pct: stats.totalCopies > 0 ? Math.round((stats.totalCopies / (stats.totalCopies || 1)) * 100) : 0 },
    { label: "SẴN SÀNG", value: stats.availableCopies, gradient: STAT_GRADIENT.available, icon: CheckIcon, pct: stats.totalCopies > 0 ? Math.round((stats.availableCopies / stats.totalCopies) * 100) : 0 },
    { label: "ĐANG MƯỢN", value: stats.borrowedCopies, gradient: STAT_GRADIENT.borrowed, icon: AssignmentIcon, pct: stats.totalCopies > 0 ? Math.round((stats.borrowedCopies / stats.totalCopies) * 100) : 0 },
  ];

  return (
    <Stack spacing={3}>
      <PageHeader
        title="Quản lý sách"
        icon={LibraryIcon}
        gradient="linear-gradient(135deg, #1e1b4b 0%, #312e81 50%, #1e1b4b 100%)"
        statBadges={`${total} đầu sách trong hệ thống`}
        onRefresh={() => { setPage(0); setSearchQuery(""); loadBooks(); }}
        actions={
          <>
            <Tooltip title="Tải mẫu">
              <IconButton
                onClick={() => api.downloadBookTemplate()}
                size="small"
                sx={{ color: "#a5b4fc", border: "1px solid rgba(165,180,252,0.3)", "&:hover": { bgcolor: "rgba(165,180,252,0.1)" } }}
              >
                <DescriptionIcon fontSize="small" />
              </IconButton>
            </Tooltip>
            <Tooltip title="Xuất Excel">
              <IconButton
                onClick={() => api.exportBooks()}
                size="small"
                sx={{ color: "#a5b4fc", border: "1px solid rgba(165,180,252,0.3)", "&:hover": { bgcolor: "rgba(165,180,252,0.1)" } }}
              >
                <TableChartIcon fontSize="small" />
              </IconButton>
            </Tooltip>
          </>
        }
      />

      <Box sx={{ display: "grid", gridTemplateColumns: { xs: "1fr", sm: "repeat(2, 1fr)", lg: "repeat(4, 1fr)" }, gap: 2 }}>
        {statItems.map((item, idx) => (
          <MuiStatCard
            key={item.label}
            label={item.label}
            value={item.value}
            icon={item.icon}
            gradient={item.gradient}
            pct={item.pct}
            index={idx}
          />
        ))}
      </Box>

      <DashboardCard>
        <Stack direction={{ xs: "column", lg: "row" }} spacing={1.5} sx={{ alignItems: { lg: "center" } }}>
          <SearchField
            value={searchQuery}
            onChange={setSearchQuery}
            placeholder="Tìm kiếm sách theo ISBN, tên, tác giả..."
            sx={{ flexGrow: 1, minWidth: 240, "& .MuiOutlinedInput-root": { borderRadius: 2, bgcolor: "background.paper", "&:hover": { "& fieldset": { borderColor: "primary.main" } } } }}
          />
          <Stack direction="row" spacing={1} sx={{ flexWrap: "wrap", gap: 1 }}>
            <input ref={fileInputRef} type="file" accept=".xlsx,.xls" hidden onChange={handleFileChange} />
            <Button
              variant="contained"
              startIcon={<UploadIcon />}
              onClick={() => fileInputRef.current?.click()}
              sx={{ background: "linear-gradient(135deg, #6366f1 0%, #4338ca 100%)", borderRadius: 2, fontWeight: 700, textTransform: "none", "&:hover": { background: "linear-gradient(135deg, #4f46e5 0%, #3730a3 100%)" } }}
            >
              Nhập Excel
            </Button>
            <Button
              variant="contained"
              startIcon={<QrCodeScannerIcon />}
