<file path="src/components/gate/PulseAnimation.tsx">
'use client';

import { Box } from '@mui/material';
import { keyframes } from '@mui/system';

const pulseAnimation = keyframes`
  0% { transform: scale(1); opacity: 0; }
  50% { opacity: 0.4; }
  100% { transform: scale(1.8); opacity: 0; }
`;

interface PulseAnimationProps {
  color?: 'blue' | 'emerald' | 'red';
  size?: number;
}

const colorMap = {
  blue: { border: 'primary.main', ring: 'primary.dark' },
  emerald: { border: 'success.main', ring: 'success.dark' },
  red: { border: 'error.main', ring: 'error.dark' },
};

export default function PulseAnimation({ color = 'blue', size = 120 }: PulseAnimationProps) {
  const colors = colorMap[color];

  return (
    <Box sx={{ position: 'relative', width: size, height: size, display: 'flex', alignItems: 'center', justifyContent: 'center' }}>
      {/* Outer pulse ring */}
      <Box
        sx={{
          position: 'absolute',
          inset: 0,
          borderRadius: '50%',
          border: 2,
          borderColor: colors.border,
          animation: `${pulseAnimation} 2s ease-out infinite`,
        }}
      />
      {/* Middle ring */}
      <Box
        sx={{
          position: 'absolute',
          inset: '8px',
          borderRadius: '50%',
          border: 1,
          borderColor: colors.border,
          opacity: 0.4,
        }}
      />
      {/* Inner ring */}
      <Box
        sx={{
          position: 'absolute',
          inset: '16px',
          borderRadius: '50%',
          border: 1,
          borderColor: colors.border,
          opacity: 0.6,
        }}
      />
    </Box>
  );
}
</file>

<file path="src/components/gate/ResultCard.tsx">
'use client';

import { Box, CircularProgress, Typography } from '@mui/material';
import CheckCircleIcon from '@mui/icons-material/CheckCircle';
import ErrorIcon from '@mui/icons-material/Error';
import CancelIcon from '@mui/icons-material/Cancel';
import PulseAnimation from './PulseAnimation';

interface ResultCardProps {
  status: 'success' | 'error' | 'unregistered' | 'processing';
  patronInfo?: {
    fullName: string;
    mssv: string;
    faculty: string;
  };
  message?: string;
}

type PulseColor = 'emerald' | 'red' | 'blue' | 'none';

const statusConfig: Record<string, {
  borderColor: string;
  bgColor: string;
  pulseColor: PulseColor;
  iconColor: string;
  icon: React.ReactNode;
}> = {
  success: {
    borderColor: 'success.main',
    bgColor: 'rgba(16,185,129,0.1)',
    pulseColor: 'emerald',
    iconColor: 'success.main',
    icon: <CheckCircleIcon sx={{ fontSize: 64 }} />,
  },
  error: {
    borderColor: 'error.main',
    bgColor: 'rgba(239,68,68,0.1)',
    pulseColor: 'red',
    iconColor: 'error.main',
    icon: <ErrorIcon sx={{ fontSize: 64 }} />,
  },
  unregistered: {
    borderColor: 'primary.main',
    bgColor: 'rgba(59,130,246,0.1)',
    pulseColor: 'blue',
    iconColor: 'primary.main',
    icon: <CancelIcon sx={{ fontSize: 64 }} />,
  },
  processing: {
    borderColor: 'grey.500',
    bgColor: 'rgba(107,114,128,0.1)',
    pulseColor: 'none',
    iconColor: 'grey.500',
    icon: <CircularProgress size={64} sx={{ color: 'grey.500' }} />,
  },
};

const messageColors: Record<string, string> = {
  success: 'success.light',
  error: 'error.light',
  unregistered: 'primary.light',
  processing: 'text.secondary',
};

export default function ResultCard({ status, patronInfo, message }: ResultCardProps) {
  const config = statusConfig[status];

  return (
    <Box
      sx={{
        position: 'relative',
        border: 2,
        borderColor: config.borderColor,
        bgcolor: config.bgColor,
        borderRadius: 4,
        p: 4,
        textAlign: 'center',
      }}
    >
      {config.pulseColor !== 'none' && (
        <Box sx={{ position: 'absolute', inset: 0, display: 'flex', alignItems: 'center', justifyContent: 'center', pointerEvents: 'none' }}>
          <PulseAnimation color={config.pulseColor} />
        </Box>
      )}

      <Box sx={{ position: 'relative', zIndex: 1 }}>
        <Box sx={{ display: 'flex', justifyContent: 'center', mb: 2, color: config.iconColor }}>
          {config.icon}
        </Box>

        {patronInfo && (
          <Box sx={{ mb: 2 }}>
            <Typography variant="h4" color="common.white" sx={{ fontWeight: 700 }}>
              {patronInfo.fullName}
            </Typography>
            <Typography variant="h6" color="primary.light" sx={{ fontFamily: "monospace" }}>
              {patronInfo.mssv}
            </Typography>
            <Typography variant="body1" color="grey.400">
              {patronInfo.faculty}
            </Typography>
          </Box>
        )}

        {message && (
          <Typography variant="h6" color={messageColors[status]}>
            {message}
          </Typography>
        )}
      </Box>
    </Box>
  );
}
</file>

