  const [editOpen, setEditOpen] = useState(false);
  const [editSaving, setEditSaving] = useState(false);
  const [editForm, setEditForm] = useState<Record<string, any>>({});
  const [editErrors, setEditErrors] = useState<Record<string, string>>({});
  const [editSnackbar, setEditSnackbar] = useState<{ open: boolean; message: string; severity: "success" | "error" }>({ open: false, message: "", severity: "success" });

  const [showDelete, setShowDelete] = useState(false);
  const [deleteConfirmText, setDeleteConfirmText] = useState("");

  useEffect(() => {
    if (!bookId) return;
    setLoading(true);
    setError(null);
    api.getBookById(bookId).then(setBook).catch((err) => setError(getErrorMessage(err))).finally(() => setLoading(false));
  }, [bookId]);

  const openEdit = () => {
    if (!book) return;
    setEditErrors({});
    setEditForm({
      title: book.title || "",
      subtitle: book.subtitle || "",
      author: book.author || "",
      publisher: book.publisher || "",
      published_date: book.published_date || "",
      description: book.description || "",
      page_count: book.page_count ?? "",
      categories: book.categories || "",
      average_rating: book.average_rating ?? "",
      language: book.language || "",
      shelf_location: book.shelf_location || "",
      cover_url: book.cover_url || "",
      quantity: book.total_copies ?? 0,
    });
    setEditOpen(true);
  };

  const validateEditForm = () => {
    const errors: Record<string, string> = {};

    if (!editForm.title?.trim()) {
      errors.title = "Tiêu đề không được để trống";
    }

    if (editForm.quantity === "" || editForm.quantity === null || Number(editForm.quantity) < 0) {
      errors.quantity = "Số lượng phải là số từ 0 trở lên";
    }

    if (editForm.page_count !== "" && editForm.page_count !== null && Number(editForm.page_count) < 0) {
      errors.page_count = "Số trang không được âm";
    }

    if (editForm.average_rating !== "" && editForm.average_rating !== null) {
      const rating = Number(editForm.average_rating);
      if (rating < 0 || rating > 5) {
        errors.average_rating = "Đánh giá phải nằm trong khoảng 0 đến 5";
      }
    }

    if (editForm.cover_url?.trim()) {
      try {
        new URL(editForm.cover_url);
      } catch {
        errors.cover_url = "URL hình ảnh không hợp lệ (cần bắt đầu bằng http:// hoặc https://)";
      }
    }

    setEditErrors(errors);
    return Object.keys(errors).length === 0;
  };

  const handleEditChange = (field: string, value: any) => {
    setEditForm((prev) => ({ ...prev, [field]: value }));
    if (editErrors[field]) {
      setEditErrors((prev) => ({ ...prev, [field]: "" }));
    }
  };

  const handleEditSave = async () => {
    if (!validateEditForm()) return;
    if (!book) return;

    setEditSaving(true);
    try {
      const quantity = editForm.quantity === "" || editForm.quantity === null ? null : Number(editForm.quantity);
      const metadataPayload: Record<string, any> = {};

      for (const [k, v] of Object.entries(editForm)) {
        if (k === "quantity") continue;
        if (k === "page_count" || k === "average_rating") {
          metadataPayload[k] = v === "" || v === null ? null : Number(v);
        } else {
          metadataPayload[k] = v || null;
        }
      }

      let updated = await api.updateBook(book.id, metadataPayload);

      if (quantity !== null && quantity !== book.total_copies) {
        updated = await api.updateBookQuantity(book.id, quantity);
      }

      setBook(updated);
      setEditOpen(false);
      setEditSnackbar({ open: true, message: "Cập nhật sách thành công", severity: "success" });
    } catch (err: any) {
      setEditSnackbar({ open: true, message: err?.response?.data?.error || "Cập nhật sách thất bại", severity: "error" });
    } finally {
      setEditSaving(false);
    }
  };

  const handleDelete = async () => {
    if (!book || deleteConfirmText !== "XÓA") return;
    try {
      await api.bulkDeleteBooks([book.id]);
      router.push("/books");
    } catch (err: any) {
      if (err?.response?.status === 404) {
        setEditSnackbar({ open: true, message: "Sách không tồn tại hoặc đã bị xóa.", severity: "error" });
        router.push("/books");
      } else {
        setEditSnackbar({ open: true, message: `Xóa thất bại: ${getErrorMessage(err) || "Lỗi không xác định"}`, severity: "error" });
      }
    }
  };

  const headerActions = book ? (
    <Stack direction="row" spacing={1} sx={{ flexWrap: "wrap" }}>
      <Tooltip title="Chỉnh sửa thông tin sách">
        <Button variant="outlined" startIcon={<EditIcon />} onClick={openEdit}>
          Sửa
        </Button>
      </Tooltip>
      <Button color="error" variant="outlined" startIcon={<DeleteIcon />} onClick={() => setShowDelete(true)}>
        Xóa
      </Button>
    </Stack>
  ) : null;

  const borrowed = book ? book.total_copies - book.available_copies : 0;
  const isLongDescription = book?.description ? book.description.length > 300 : false;

  return (
    <LoadingOverlay loading={loading} message="Đang tải thông tin sách...">
      {error || !book ? (
        <EmptyState
          icon={<MenuBookIcon sx={{ fontSize: 56 }} />}
          title={error || "Không tìm thấy sách"}
          description="Sách có thể đã bị xóa hoặc ID không hợp lệ."
          action={
            <Button variant="contained" startIcon={<MenuBookIcon />} onClick={() => router.push("/books")}>
              Quay lại danh sách
            </Button>
          }
        />
      ) : (
        <Stack spacing={3}>
          <PageHeader
            backHref="/books"
            title={book.title}
            subtitle={book.subtitle || book.author || undefined}
            icon={MenuBookIcon}
            actions={headerActions}
          />

          <Grid container spacing={3}>
            <Grid size={{ xs: 12, md: 4 }} sx={staggerSx(0)}>
              <DashboardCard noPadding>
                <Box
                  sx={{
                    position: "relative",
                    height: 340,
                    background: `linear-gradient(135deg, ${theme.palette.grey[900]} 0%, ${theme.palette.grey[800]} 100%)`,
                    display: "flex",
                    alignItems: "center",
                    justifyContent: "center",
                    overflow: "hidden",
                  }}
                >
                  {book.cover_url ? (
                    <Box
                      component="img"
                      src={book.cover_url}
                      alt={book.title}
                      sx={{
                        maxWidth: "100%",
                        maxHeight: "100%",
                        objectFit: "contain",
                        transition: "transform 0.3s ease",
                        "&:hover": { transform: "scale(1.02)" },
                      }}
                    />
                  ) : (
                    <Avatar sx={{ width: 140, height: 140, bgcolor: "grey.700" }}>
                      <MenuBookIcon sx={{ fontSize: 72 }} />
                    </Avatar>
                  )}
                  <Box
                    sx={{
                      position: "absolute",
                      top: 12,
                      left: 12,
                      bgcolor: book.is_available ? "success.main" : "error.main",
                      color: "white",
                      px: 1.5,
                      py: 0.5,
                      borderRadius: 5,
                      fontSize: 12,
                      fontWeight: 700,
                    }}
                  >
                    {book.is_available ? "Còn hàng" : "Hết hàng"}
                  </Box>
                  <Button
                    variant="contained"
                    color="primary"
                    startIcon={<ViewInArIcon />}
                    onClick={() => setShow3D(true)}
                    sx={{
                      position: "absolute",
                      bottom: 16,
                      left: 16,
                      right: 16,
                      width: "auto",
                      borderRadius: 2,
                      boxShadow: 3,
                      bgcolor: "rgba(25, 118, 210, 0.9)",
                      backdropFilter: "blur(4px)",
                    }}
                  >
                    Góc nhìn 3D
                  </Button>
                </Box>

                <Box sx={{ p: 2.5 }}>
                  <Stack direction="row" spacing={1} sx={{ mb: 2.5 }}>
                    <StatCard label="Tổng" value={book.total_copies} color="info" icon={<GridViewIcon fontSize="small" />} />
                    <StatCard label="Sẵn sàng" value={book.available_copies} color="success" icon={<VerifiedIcon fontSize="small" />} />
                    <StatCard label="Đang mượn" value={borrowed} color="warning" icon={<MenuBookIcon fontSize="small" />} />
                  </Stack>

                  <Divider sx={{ mb: 1.5 }} />

                  <Box>
                    <MetaItem
                      icon={<GridViewIcon fontSize="small" />}
                      label="ISBN-13"
                      value={book.isbn13 || book.isbn}
                    />
                    {book.isbn10 ? (
                      <MetaItem icon={<GridViewIcon fontSize="small" />} label="ISBN-10" value={book.isbn10} />
                    ) : null}
                    {book.shelf_location ? (
                      <MetaItem icon={<LocationOnIcon fontSize="small" />} label="Vị trí" value={book.shelf_location} />
                    ) : null}
                    {book.language ? (
                      <MetaItem icon={<LanguageIcon fontSize="small" />} label="Ngôn ngữ" value={book.language} />
                    ) : null}
                  </Box>
                </Box>
              </DashboardCard>
            </Grid>

            <Grid size={{ xs: 12, md: 8 }} sx={staggerSx(1)}>
              <Stack spacing={3}>
                <DashboardCard title="Chi tiết sách">
                  <Stack spacing={2}>
                    {book.author ? (
                      <Stack direction="row" spacing={1} sx={{ alignItems: "center" }}>
                        <Typography variant="body1" color="text.secondary">
                          Tác giả:
                        </Typography>
                        <Typography variant="body1" sx={{ fontWeight: 600 }}>
                          {book.author}
                        </Typography>
                      </Stack>
                    ) : null}

                    <Stack direction="row" spacing={1} sx={{ flexWrap: "wrap", gap: 1 }}>
                      {book.publisher ? (
                        <Chip icon={<MenuBookIcon sx={{ fontSize: 16 }} />} label={book.publisher} size="small" variant="outlined" />
                      ) : null}
                      {book.published_date ? (
                        <Chip
                          icon={<CalendarTodayIcon sx={{ fontSize: 16 }} />}
                          label={book.published_date}
                          size="small"
                          variant="outlined"
                        />
                      ) : null}
                      {book.page_count ? (
                        <Chip
                          icon={<DescriptionIcon sx={{ fontSize: 16 }} />}
                          label={`${book.page_count} trang`}
                          size="small"
                          variant="outlined"
                        />
                      ) : null}
                      {book.average_rating ? (
                        <Chip
                          icon={<StarIcon sx={{ fontSize: 16 }} />}
                          label={`${book.average_rating}/5`}
                          size="small"
                          variant="outlined"
                          color="warning"
                        />
                      ) : null}
                      {book.categories ? (
                        <Chip
                          icon={<CategoryIcon sx={{ fontSize: 16 }} />}
                          label={book.categories}
                          size="small"
                          variant="outlined"
                          sx={{ bgcolor: "primary.main", color: "primary.contrastText", borderColor: "primary.main" }}
                        />
                      ) : null}
                    </Stack>
                  </Stack>
                </DashboardCard>

                {book.description ? (
                  <Box sx={staggerSx(2)}>
                    <DashboardCard title="Mô tả">
                    <Box
                      sx={{
                        bgcolor: "grey.900",
                        borderRadius: 2,
                        position: "relative",
                        maxHeight: descExpanded ? "none" : 200,
                        overflow: "hidden",
                      }}
                    >
                      <Typography variant="body2" sx={{ whiteSpace: "pre-wrap", lineHeight: 1.8, color: "common.white" }}>
                        {book.description}
                      </Typography>
                      {isLongDescription ? (
                        <Box
                          sx={{
                            position: "absolute",
                            bottom: 0,
                            left: 0,
                            right: 0,
                            height: 60,
                            background: descExpanded ? "transparent" : `linear-gradient(transparent, ${theme.palette.grey[900]})`,
                            display: "flex",
                            alignItems: "flex-end",
                            justifyContent: "center",
                            pb: 1,
                          }}
                        >
                          <Button
                            size="small"
                            onClick={() => setDescExpanded(!descExpanded)}
                            endIcon={descExpanded ? <CloseIcon /> : <ExpandIcon />}
                            sx={{ color: "text.secondary" }}
                          >
                            {descExpanded ? "Thu gọn" : "Xem thêm"}
                          </Button>
                        </Box>
                      ) : null}
                    </Box>
                  </DashboardCard>
                  </Box>
                ) : null}

                <Box
                  sx={{
                    display: "grid",
                    gridTemplateColumns: { xs: "1fr", sm: "1fr 1fr" },
                    gap: 2,
                    ...staggerSx(3),
                  }}
                >
                  <DashboardCard>
                    <Typography variant="caption" color="text.secondary" sx={{ textTransform: "uppercase", letterSpacing: 0.5 }}>
                      Ngày tạo
                    </Typography>
                    <Typography variant="body1" sx={{ fontWeight: 600, mt: 0.5 }}>
                      {book.created_at ? new Date(book.created_at).toLocaleDateString("vi-VN", { day: "2-digit", month: "long", year: "numeric" }) : "-"}
                    </Typography>
                  </DashboardCard>
                  <DashboardCard>
                    <Typography variant="caption" color="text.secondary" sx={{ textTransform: "uppercase", letterSpacing: 0.5 }}>
                      Ngày cập nhật
                    </Typography>
                    <Typography variant="body1" sx={{ fontWeight: 600, mt: 0.5 }}>
                      {book.updated_at ? new Date(book.updated_at).toLocaleDateString("vi-VN", { day: "2-digit", month: "long", year: "numeric" }) : "-"}
                    </Typography>
                  </DashboardCard>
                </Box>

                <Stack direction="row" spacing={2} sx={{ mt: 1, ...staggerSx(4) }}>
                  <Button
                    variant="contained"
                    size="large"
                    startIcon={<MenuBookIcon />}
                    onClick={() => router.push(`/borrow?barcode=${book.isbn}`)}
                    sx={{ flex: 1, py: 1.5, fontWeight: 700 }}
                  >
                    Mượn sách
                  </Button>
                  <Tooltip title="Chỉnh sửa thông tin sách">
                    <Button
                      variant="outlined"
                      size="large"
                      startIcon={<EditIcon />}
                      onClick={openEdit}
                      sx={{ py: 1.5 }}
                    >
                      Sửa
                    </Button>
                  </Tooltip>
                </Stack>
              </Stack>
            </Grid>
          </Grid>

          <Dialog open={show3D} onClose={() => setShow3D(false)} maxWidth="sm" fullWidth>
            <DialogTitle sx={{ m: 0, p: 2, display: "flex", justifyContent: "space-between", alignItems: "center" }}>
              <Typography variant="h6">Góc nhìn 3D</Typography>
              <IconButton onClick={() => setShow3D(false)}>
                <CloseIcon />
              </IconButton>
            </DialogTitle>
            <DialogContent dividers sx={{ p: 0, overflow: "hidden" }}>
              {show3D ? <Book3DViewer coverUrl={book.cover_url || "https://upload.wikimedia.org/wikipedia/commons/thumb/6/69/1-2-3-go-book-cover.jpg/2560px-1-2-3-go-book-cover.jpg"} /> : null}
            </DialogContent>
          </Dialog>

          <Dialog open={editOpen} onClose={() => setEditOpen(false)} maxWidth="md" fullWidth>
            <DialogTitle sx={{ display: "flex", justifyContent: "space-between", alignItems: "center", fontWeight: 700 }}>
              Chỉnh sửa thông tin sách
              <IconButton onClick={() => setEditOpen(false)} size="small"><CloseIcon /></IconButton>
            </DialogTitle>
            <DialogContent dividers sx={{ pt: 2 }}>
              <Stack spacing={2.5}>
                <Stack direction={{ xs: "column", sm: "row" }} spacing={2}>
                  <TextField
                    label="Tiêu đề"
                    required
                    fullWidth
                    value={editForm.title || ""}
                    onChange={(e) => handleEditChange("title", e.target.value)}
                    error={!!editErrors.title}
                    helperText={editErrors.title}
                  />
                  <TextField
                    label="Số lượng tồn kho"
                    type="number"
                    fullWidth
                    value={editForm.quantity ?? 0}
                    onChange={(e) => handleEditChange("quantity", e.target.value)}
                    error={!!editErrors.quantity}
                    helperText={editErrors.quantity}
                  />
                </Stack>
                <TextField
                  label="Phụ đề"
                  fullWidth
                  value={editForm.subtitle || ""}
                  onChange={(e) => handleEditChange("subtitle", e.target.value)}
                />
                <TextField
                  label="Tác giả"
                  fullWidth
                  value={editForm.author || ""}
                  onChange={(e) => handleEditChange("author", e.target.value)}
                />
                <TextField
                  label="Nhà xuất bản"
                  fullWidth
                  value={editForm.publisher || ""}
                  onChange={(e) => handleEditChange("publisher", e.target.value)}
                />
                <TextField
                  label="Ngày xuất bản"
                  fullWidth
                  value={editForm.published_date || ""}
                  onChange={(e) => handleEditChange("published_date", e.target.value)}
                  placeholder="VD: 2024-01-01"
                />
                <TextField
                  label="Mô tả"
                  fullWidth
                  multiline
                  minRows={4}
                  value={editForm.description || ""}
                  onChange={(e) => handleEditChange("description", e.target.value)}
                />
                <Stack direction={{ xs: "column", sm: "row" }} spacing={2}>
                  <TextField
                    label="Số trang"
                    type="number"
                    fullWidth
                    value={editForm.page_count ?? ""}
                    onChange={(e) => handleEditChange("page_count", e.target.value)}
                    error={!!editErrors.page_count}
                    helperText={editErrors.page_count}
                  />
                  <TextField
                    label="Danh mục"
                    fullWidth
                    value={editForm.categories || ""}
                    onChange={(e) => handleEditChange("categories", e.target.value)}
                  />
                  <TextField
                    label="Đánh giá (0-5)"
                    type="number"
                    fullWidth
                    value={editForm.average_rating ?? ""}
                    onChange={(e) => handleEditChange("average_rating", e.target.value)}
                    error={!!editErrors.average_rating}
                    helperText={editErrors.average_rating}
                  />
                </Stack>
                <Stack direction={{ xs: "column", sm: "row" }} spacing={2}>
                  <TextField
                    label="Ngôn ngữ"
                    fullWidth
                    value={editForm.language || ""}
                    onChange={(e) => handleEditChange("language", e.target.value)}
                  />
                  <TextField
                    label="Vị trí kệ"
                    fullWidth
                    value={editForm.shelf_location || ""}
                    onChange={(e) => handleEditChange("shelf_location", e.target.value)}
                  />
                </Stack>
                <TextField
                  label="URL ảnh bìa"
                  fullWidth
                  value={editForm.cover_url || ""}
                  onChange={(e) => handleEditChange("cover_url", e.target.value)}
                  placeholder="https://..."
                  error={!!editErrors.cover_url}
                  helperText={editErrors.cover_url}
                />
              </Stack>
            </DialogContent>
            <Box sx={{ px: 3, py: 2, display: "flex", justifyContent: "flex-end", gap: 1.5 }}>
              <Button onClick={() => setEditOpen(false)} disabled={editSaving}>Hủy</Button>
              <Button
                variant="contained"
                onClick={handleEditSave}
                disabled={editSaving || !editForm.title?.trim()}
                startIcon={editSaving ? <CircularProgress size={16} /> : null}
              >
                {editSaving ? "Đang lưu..." : "Lưu"}
              </Button>
            </Box>
          </Dialog>

          <Dialog open={showDelete} onClose={() => { setShowDelete(false); setDeleteConfirmText(""); }} fullWidth maxWidth="xs">
            <DialogTitle>Xóa sách?</DialogTitle>
            <DialogContent>
              <Stack spacing={2}>
                <Typography color="text.secondary">
                  Sách <strong>{book.title}</strong> sẽ bị xóa khỏi hệ thống. Hành động này không thể hoàn tác.
                </Typography>
                <Typography variant="body2" color="text.secondary">
                  Nhập <strong>XÓA</strong> để xác nhận:
                </Typography>
                <TextField
                  value={deleteConfirmText}
                  onChange={(e) => setDeleteConfirmText(e.target.value)}
                  placeholder="Nhập XÓA"
                  size="small"
                  autoFocus
                  fullWidth
                />
              </Stack>
            </DialogContent>
            <Box sx={{ px: 3, py: 2, display: "flex", justifyContent: "flex-end", gap: 1.5 }}>
              <Button onClick={() => { setShowDelete(false); setDeleteConfirmText(""); }}>Hủy</Button>
              <Button color="error" variant="contained" onClick={handleDelete} disabled={deleteConfirmText !== "XÓA"}>
                Xóa vĩnh viễn
              </Button>
            </Box>
          </Dialog>

          <NoticeSnackbar
            open={editSnackbar.open}
            message={editSnackbar.message}
            severity={editSnackbar.severity}
            onClose={() => setEditSnackbar((s) => ({ ...s, open: false }))}
            anchorOrigin={{ vertical: "top", horizontal: "right" }}
          />
        </Stack>
      )}
    </LoadingOverlay>
  );
}
</file>

<file path="src/app/(dashboard)/borrow/page.tsx">
"use client";

import { useCallback, useEffect, useRef, useState } from "react";
import {
  Alert,
  AlertTitle,
  Avatar,
  Box,
  Button,
  Chip,
  CircularProgress,
  Divider,
  Grid,
  LinearProgress,
  Slide,
  Stack,
  TextField,
  Typography,
} from "@mui/material";
import BadgeIcon from "@mui/icons-material/BadgeOutlined";
import BorrowIcon from "@mui/icons-material/AssignmentIndOutlined";
import CameraAltIcon from "@mui/icons-material/CameraAltOutlined";
import CheckCircleIcon from "@mui/icons-material/CheckCircleOutlineOutlined";
import FaceIcon from "@mui/icons-material/FaceOutlined";
import QrCodeScannerIcon from "@mui/icons-material/QrCodeScannerOutlined";
import VideocamIcon from "@mui/icons-material/VideocamOutlined";
import WarningIcon from "@mui/icons-material/WarningAmberOutlined";
import BorrowIPCameraDialog from "@/components/BorrowIPCameraDialog";
import BookRecommendations from "@/components/BookRecommendations";
import api, { getErrorMessage } from "@/lib/api-client";
import { fadeInUp, slideInRight } from "@/lib/animations";
import { staggerSx } from "@/lib/useStaggeredAnimation";
import PageHeader from "@/components/ui/PageHeader";
import DashboardCard from "@/components/ui/DashboardCard";
import NoticeSnackbar from "@/components/ui/NoticeSnackbar";

const MAX_BORROW_BOOKS = 3;
const _RAW_CAM_URL = process.env.NEXT_PUBLIC_BORROW_CAM_URL;
if (!_RAW_CAM_URL) throw new Error("NEXT_PUBLIC_BORROW_CAM_URL is not set");
const RAW_CAM_URL: string = _RAW_CAM_URL;
const BORROW_CAM_URL = `/api/camera/proxy?url=${encodeURIComponent(RAW_CAM_URL)}`;

export default function BorrowPage() {
  const [patronCode, setPatronCode] = useState("");
  const [patronId, setPatronId] = useState<string | null>(null);
  const [patronName, setPatronName] = useState("");
  const [activeCount, setActiveCount] = useState(0);
  const [overdueCount, setOverdueCount] = useState(0);
  const [error, setError] = useState("");
  const [scannerOpen, setScannerOpen] = useState(false);
  const [snackbar, setSnackbar] = useState<{ severity: "success" | "error" | "warning"; message: string } | null>(null);

  const videoRef = useRef<HTMLVideoElement>(null);
  const streamRef = useRef<MediaStream | null>(null);
  const [cameraReady, setCameraReady] = useState(false);
  const [cameraError, setCameraError] = useState("");
  const [faceScanning, setFaceScanning] = useState(false);

  const remaining = MAX_BORROW_BOOKS - activeCount;
  const canBorrow = remaining > 0 && overdueCount === 0;

  const setPatron = useCallback((code: string, id: string, name: string) => {
    setPatronCode(code);
    setPatronId(id);
    setPatronName(name);
  }, []);

  const stopCamera = useCallback(() => {
    if (streamRef.current) {
      streamRef.current.getTracks().forEach((t) => t.stop());
      streamRef.current = null;
    }
    setCameraReady(false);
  }, []);

  const startWebcam = useCallback(async () => {
    setCameraError("");
    try {
      const stream = await navigator.mediaDevices.getUserMedia({
        video: { facingMode: "user", width: { ideal: 640 }, height: { ideal: 480 } },
        audio: false,
      });
      streamRef.current = stream;
      if (videoRef.current) {
        videoRef.current.srcObject = stream;
        videoRef.current.onloadedmetadata = () => setCameraReady(true);
      }
    } catch (err: any) {
      if (err.name === "NotAllowedError") setCameraError("Không có quyền truy cập camera.");
      else if (err.name === "NotFoundError") setCameraError("Không tìm thấy camera.");
      else setCameraError("Không thể khởi động camera.");
    }
  }, []);

  useEffect(() => {
    if (!patronId && patronCode.trim()) {
      startWebcam();
    } else if (patronId) {
      stopCamera();
    }
    return () => stopCamera();
  }, [patronId, patronCode, startWebcam, stopCamera]);

  const handleFaceVerify = useCallback(async () => {
    if (!videoRef.current || !patronCode.trim()) return;
    setFaceScanning(true);
    setError("");

    try {
      const video = videoRef.current;
      const canvas = document.createElement("canvas");
      canvas.width = video.videoWidth;
      canvas.height = video.videoHeight;
      const ctx = canvas.getContext("2d");
      if (!ctx) { setError("Canvas context error"); setFaceScanning(false); return; }
      ctx.translate(canvas.width, 0);
      ctx.scale(-1, 1);
      ctx.drawImage(video, 0, 0, canvas.width, canvas.height);

      const blob = await new Promise<Blob>((resolve, reject) => {
        canvas.toBlob((b) => { if (b) resolve(b); else reject(new Error("toBlob failed")); }, "image/jpeg", 0.85);
      });
      const file = new File([blob], "capture.jpg", { type: "image/jpeg" });

      const lookupResult = await api.lookupPatron(patronCode.trim());
      if (!lookupResult.exists || !lookupResult.patron) {
        setError("Không tìm thấy độc giả"); setFaceScanning(false); return;
      }
      if (lookupResult.is_expired) {
        setError("Thẻ độc giả đã hết hạn"); setFaceScanning(false); return;
      }
      const verifyResult = await api.verifyFace(file, lookupResult.patron.id, true);

      let attempts = 0;
      const maxAttempts = 30;
      while (attempts < maxAttempts) {
        await new Promise((r) => setTimeout(r, 1000));
        const taskStatus = await api.getTaskStatus(verifyResult.job_id);
        if (taskStatus.status === "SUCCESS" && taskStatus.result) {
          if (taskStatus.result.verified) {
            try {
              const data = await api.getActiveBorrowsByStudentCode(patronCode.trim());
              stopCamera();
              setPatron(patronCode.trim(), data.patron.id, data.patron.full_name || data.patron.student_code);
              setActiveCount(data.total);
              setOverdueCount(data.overdue_count);
              setSnackbar({ severity: "success", message: `Đã xác minh khuôn mặt: ${data.patron.full_name || data.patron.student_code}` });
              setFaceScanning(false);
              return;
            } catch (err: any) {
              const status = err?.response?.status || err?.status;
              if (status === 403) {
                setError("Độc giả chưa ở trong thư viện hoặc thẻ đã bị khóa.");
              } else {
                setError(getErrorMessage(err) || "Không thể kiểm tra thông tin độc giả");
              }
              setFaceScanning(false);
              return;
            }
          }
          setError("Khuôn mặt không khớp với độc giả này");
          setFaceScanning(false);
          return;
        }
        if (taskStatus.status === "FAILURE" || taskStatus.status === "ERROR") {
          setError(taskStatus.result?.error || taskStatus.result?.detail || "Xác minh thất bại");
          setFaceScanning(false);
          return;
        }
        attempts++;
      }
      setError("Hết thời gian chờ xác minh");
      setFaceScanning(false);
    } catch (err) {
      setError(getErrorMessage(err) || "Lỗi xác minh khuôn mặt");
      setFaceScanning(false);
    }
  }, [patronCode, stopCamera, setPatron]);

  const handleScanSuccess = useCallback((message: string) => {
    setSnackbar({ severity: "success", message });
    setTimeout(() => window.location.reload(), 1500);
  }, []);

  const handleClearPatron = () => {
    setPatronId(null);
    setPatronName("");
    setActiveCount(0);
    setOverdueCount(0);
    setPatronCode("");
  };

  const faceVerifyDisabled = faceScanning || !patronCode.trim() || !!patronId;

  const subtitle = patronId
    ? `Đang mượn: ${patronName} — ${activeCount}/${MAX_BORROW_BOOKS} sách`
    : "Quét khuôn mặt hoặc nhập MSSV để bắt đầu";

  return (
    <Stack spacing={3} sx={{ height: "calc(100vh - 120px)" }}>
      <Box sx={staggerSx(0)}>
        <PageHeader
          title="Mượn sách"
          subtitle={subtitle}
          icon={BorrowIcon}
          gradient="linear-gradient(135deg, #1e1b4b 0%, #312e81 50%, #1e1b4b 100%)"
          actions={
            patronId ? (
              <Button
                variant="outlined"
                size="small"
                onClick={handleClearPatron}
                sx={{ color: "#a5b4fc", borderColor: "rgba(165,180,252,0.4)", "&:hover": { borderColor: "#a5b4fc", bgcolor: "rgba(165,180,252,0.08)" } }}
              >
                Hủy phiên
              </Button>
            ) : null
          }
        />
      </Box>

      {error ? (
        <Slide direction="down" in={!!error} timeout={250}>
          <Alert severity="error" onClose={() => setError("")} sx={{ animation: `${slideInRight} 0.25s ease-out` }}>
            <AlertTitle>Lỗi</AlertTitle>
            {error}
          </Alert>
        </Slide>
      ) : null}

      <Grid container spacing={2} sx={{ flex: 1, minHeight: 0 }}>
        <Grid size={{ xs: 12, md: 5, lg: 4 }} sx={{ display: "flex", flexDirection: "column", gap: 2, overflowY: "auto", minHeight: 0 }}>
          <Box sx={staggerSx(1)}>
            <DashboardCard title="Xác minh độc giả" actions={<Avatar sx={{ bgcolor: "linear-gradient(135deg, #6366f1 0%, #4338ca 100%)", width: 32, height: 32 }}><BadgeIcon sx={{ fontSize: 18 }} /></Avatar>}>
              <Stack spacing={2}>
                <TextField
                  value={patronCode}
                  onChange={(e) => setPatronCode(e.target.value)}
                  placeholder="Nhập mã số sinh viên..."
                  size="small"
                  fullWidth
                  disabled={!!patronId}
                  sx={{ "& .MuiOutlinedInput-root": { borderRadius: 2, bgcolor: "background.paper", "&:hover": { "& fieldset": { borderColor: "primary.main" } } } }}
                />
                <Button
                  variant="contained"
                  fullWidth
                  onClick={() => { if (!patronId) startWebcam(); }}
                  disabled={faceVerifyDisabled}
                  startIcon={<FaceIcon />}
                  sx={{ borderRadius: 2, fontWeight: 700, textTransform: "none", background: "linear-gradient(135deg, #8b5cf6 0%, #6d28d9 100%)", "&:hover": { background: "linear-gradient(135deg, #7c3aed 0%, #5b21b6 100%)", transform: "translateY(-1px)" }, transition: "all 0.2s" }}
                >
                  Xác minh khuôn mặt
                </Button>
              </Stack>
            </DashboardCard>
          </Box>

          {patronId ? (
            <Box sx={{ ...staggerSx(2), animation: `${fadeInUp} 0.4s ease-out` }}>
              <DashboardCard noPadding>
                <Box sx={{ px: 2.5, pt: 2, pb: 2.5, borderLeft: 4, borderLeftColor: overdueCount > 0 ? "error.main" : "success.main", transition: "box-shadow 0.2s", "&:hover": { boxShadow: 2 } }}>
                  <Stack spacing={2}>
                    <Box sx={{ display: "flex", alignItems: "center", gap: 2 }}>
                      <Avatar sx={{ width: 48, height: 48, background: "linear-gradient(135deg, #6366f1 0%, #4338ca 100%)", boxShadow: "0 4px 12px rgba(99,102,241,0.3)" }}>
                        {patronName?.[0]?.toUpperCase() || "?"}
                      </Avatar>
                      <Box sx={{ flex: 1, minWidth: 0 }}>
                        <Typography variant="subtitle1" sx={{ fontWeight: 800 }} noWrap>{patronName || patronId}</Typography>
                        <Typography variant="caption" color="text.secondary" sx={{ fontFamily: "monospace" }}>{patronCode}</Typography>
                      </Box>
                      <Chip size="small" color="success" label="Đã xác minh" icon={<CheckCircleIcon />} sx={{ fontWeight: 600 }} />
                    </Box>
                    <Divider />
                    <Stack spacing={1}>
                      <Box sx={{ display: "flex", justifyContent: "space-between", alignItems: "center" }}>
                        <Typography variant="body2" color="text.secondary" sx={{ fontWeight: 600 }}>Số sách đã mượn</Typography>
                        <Chip size="small" color={activeCount >= MAX_BORROW_BOOKS ? "error" : "primary"} label={`${activeCount}/${MAX_BORROW_BOOKS}`} sx={{ fontWeight: 700 }} />
                      </Box>
                      <LinearProgress variant="determinate" value={(activeCount / MAX_BORROW_BOOKS) * 100} color={activeCount >= MAX_BORROW_BOOKS ? "error" : "primary"} sx={{ borderRadius: 2, height: 6, bgcolor: "action.hover", "& .MuiLinearProgress-bar": { borderRadius: 2 } }} />
                      {overdueCount > 0 ? (
                        <Alert severity="error" sx={{ py: 0.5, borderRadius: 2 }}>
                          <WarningIcon fontSize="small" sx={{ mr: 0.5 }} />
                          Có {overdueCount} cuốn sách quá hạn
                        </Alert>
                      ) : null}
                      <Typography variant="body2" color={remaining > 0 ? "text.secondary" : "error"} sx={{ fontWeight: 600 }}>
                        {remaining > 0 ? `Có thể mượn thêm ${remaining} cuốn` : "Đã đạt giới hạn mượn"}
                      </Typography>
                    </Stack>
                    <Divider />
                    <Button
                      variant="contained"
                      fullWidth
                      startIcon={<QrCodeScannerIcon />}
                      disabled={!canBorrow}
                      onClick={() => setScannerOpen(true)}
                      sx={{ borderRadius: 2, fontWeight: 700, textTransform: "none", py: 1.5, background: canBorrow ? "linear-gradient(135deg, #10b981 0%, #059669 100%)" : undefined, "&:hover": canBorrow ? { background: "linear-gradient(135deg, #059669 0%, #047857 100%)" } : {} }}
                    >
                      {canBorrow ? "Quét mã vạch sách" : overdueCount > 0 ? "Cần trả sách quá hạn" : "Đã đạt giới hạn"}
                    </Button>
                  </Stack>
                </Box>
              </DashboardCard>
            </Box>
          ) : (
            <Box sx={staggerSx(2)}>
              <DashboardCard>
                <Stack spacing={1.5} sx={{ alignItems: "center", color: "text.secondary", minHeight: 200, justifyContent: "center" }}>
                  <BadgeIcon sx={{ fontSize: 56, opacity: 0.2 }} />
                  <Typography variant="body1" sx={{ fontWeight: 700, textAlign: "center" }}>
                    Nhập MSSV hoặc quét khuôn mặt<br />để xác minh độc giả
                  </Typography>
                </Stack>
              </DashboardCard>
            </Box>
          )}
        </Grid>

        <Grid size={{ xs: 12, md: 7, lg: 8 }} sx={{ display: "flex", flexDirection: "column", gap: 2, overflowY: "auto", minHeight: 0 }}>
          <Box sx={staggerSx(1)}>
            <DashboardCard
              title={patronId ? "Quét mã vạch sách" : "Xác minh khuôn mặt"}
              actions={patronId ? <CameraAltIcon color="primary" /> : <VideocamIcon color="primary" />}
              noPadding
            >
              {patronId ? (
                <Box sx={{ bgcolor: "black", borderRadius: 3, overflow: "hidden", position: "relative", minHeight: 300 }}>
                  <Stack spacing={2} sx={{ alignItems: "center", justifyContent: "center", height: "100%", color: "grey.400", p: 4 }}>
                    <QrCodeScannerIcon sx={{ fontSize: 72, opacity: 0.3 }} />
                    <Typography variant="body1" color="text.secondary" sx={{ textAlign: "center" }}>
                      {"Bấm nút \"Quét mã vạch sách\" để mở IP Camera"}
                    </Typography>
                    <Button variant="outlined" color="inherit" startIcon={<QrCodeScannerIcon />} onClick={() => setScannerOpen(true)} disabled={!canBorrow}>
                      Mở IP Camera
                    </Button>
                  </Stack>
                </Box>
              ) : (
                <Box sx={{ bgcolor: "black", borderRadius: 3, overflow: "hidden", position: "relative", minHeight: 400 }}>
                  {cameraError ? (
                    <Stack spacing={1.5} sx={{ alignItems: "center", justifyContent: "center", height: "100%", color: "grey.300", p: 3 }}>
                      <VideocamIcon sx={{ fontSize: 48 }} />
                      <Typography sx={{ textAlign: "center" }}>{cameraError}</Typography>
                      <Button size="small" variant="outlined" color="inherit" onClick={startWebcam}>Thử lại</Button>
                    </Stack>
                  ) : (
                    <>
                      <video
                        ref={videoRef}
                        autoPlay
                        playsInline
                        muted
                        style={{ width: "100%", height: "100%", objectFit: "contain", display: "block", transform: "scaleX(-1)" }}
                      />
                      {!cameraReady ? (
                        <Stack sx={{ position: "absolute", inset: 0, bgcolor: "rgba(0,0,0,.55)", color: "common.white", alignItems: "center", justifyContent: "center" }} spacing={1}>
                          <CircularProgress size={28} color="inherit" />
                          <Typography variant="body2">Đang khởi động camera...</Typography>
                        </Stack>
                      ) : null}
                      {faceScanning && cameraReady ? (
                        <Stack sx={{ position: "absolute", inset: 0, bgcolor: "rgba(0,0,0,.5)", alignItems: "center", justifyContent: "center" }} spacing={1}>
                          <CircularProgress size={28} color="inherit" />
                          <Typography variant="body2" sx={{ color: "common.white" }}>Đang xác minh...</Typography>
                        </Stack>
                      ) : null}
                      <Stack direction="row" spacing={1} sx={{ position: "absolute", bottom: 12, left: 12, right: 12, justifyContent: "center" }}>
                        <Button
                          variant="contained"
                          size="large"
                          onClick={startWebcam}
                          disabled={cameraReady}
                          sx={{ display: cameraReady ? "none" : undefined }}
                        >
                          Mở camera
                        </Button>
                        <Button
                          variant="contained"
                          size="large"
                          startIcon={<FaceIcon />}
                          onClick={handleFaceVerify}
                          disabled={!cameraReady || faceScanning || !patronCode.trim()}
                          sx={{ display: cameraReady ? undefined : "none", minWidth: 200 }}
                        >
                          {faceScanning ? "Đang xác minh..." : "Xác minh khuôn mặt"}
                        </Button>
                      </Stack>
                    </>
                  )}
                </Box>
              )}
            </DashboardCard>
          </Box>

          {patronId && patronCode.trim() ? (
            <Box sx={{ ...staggerSx(2), animation: `${fadeInUp} 0.4s ease-out` }}>
              <BookRecommendations studentCode={patronCode.trim()} />
            </Box>
          ) : null}
        </Grid>
      </Grid>

      <BorrowIPCameraDialog
        open={scannerOpen}
        patronId={patronId || ""}
        patronName={patronName}
        maxItems={remaining > 0 ? remaining : undefined}
        cameraUrl={BORROW_CAM_URL}
        onClose={() => setScannerOpen(false)}
        onSuccess={handleScanSuccess}
      />

      <NoticeSnackbar
        open={!!snackbar}
        message={snackbar?.message || ""}
        severity={snackbar?.severity || "success"}
        onClose={() => setSnackbar(null)}
        anchorOrigin={{ vertical: "top", horizontal: "right" }}
      />
    </Stack>
  );
}
