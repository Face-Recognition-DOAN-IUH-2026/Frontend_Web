<file path="src/app/_components/Lazy3DScene.tsx">
"use client";

import { useRef, useState, useEffect, type ReactNode } from "react";
import { Box, type SxProps, type Theme } from "@mui/material";

interface Lazy3DSceneProps {
  children: ReactNode;
  height?: number | string;
  placeholder?: ReactNode;
  sx?: SxProps<Theme>;
  /** Margin before the element enters viewport (default: "200px") */
  rootMargin?: string;
}

function BlurPlaceholder({ height }: { height: number | string }) {
  return (
    <Box
      sx={{
        width: "100%",
        height,
        display: "flex",
        alignItems: "center",
        justifyContent: "center",
        bgcolor: "action.hover",
        backdropFilter: "blur(8px)",
        WebkitBackdropFilter: "blur(8px)",
        backgroundImage:
          "linear-gradient(135deg, rgba(99,102,241,0.05) 0%, rgba(99,102,241,0.1) 100%)",
        borderRadius: 1,
        overflow: "hidden",
      }}
    >
      <Box
        sx={{
          width: "100%",
          height: "100%",
          display: "flex",
          alignItems: "center",
          justifyContent: "center",
          opacity: 0.5,
          "&::after": {
            content: '""',
            display: "block",
            width: 48,
            height: 48,
            borderRadius: "50%",
            border: "3px solid",
            borderColor: "divider",
            borderTopColor: "primary.main",
            animation: "spin 0.8s linear infinite",
          },
          "@keyframes spin": { "100%": { transform: "rotate(360deg)" } },
        }}
      />
    </Box>
  );
}

export default function Lazy3DScene({
  children,
  height = 400,
  placeholder,
  sx,
  rootMargin = "200px",
}: Lazy3DSceneProps) {
  const ref = useRef<HTMLDivElement>(null);
  const [inView, setInView] = useState(false);

  useEffect(() => {
    const el = ref.current;
    if (!el) return;
    if (typeof IntersectionObserver === "undefined") {
      setInView(true);
      return;
    }
    const observer = new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting) {
          setInView(true);
          observer.disconnect();
        }
      },
      { rootMargin }
    );
    observer.observe(el);
    return () => observer.disconnect();
  }, [rootMargin]);

  return (
    <Box ref={ref} sx={{ width: "100%", height, position: "relative", ...sx }}>
      {inView ? children : placeholder || <BlurPlaceholder height={height} />}
    </Box>
  );
}
</file>

<file path="src/app/_components/MotionPrimitives.tsx">
"use client";

import React from "react";
import { motion, AnimatePresence, HTMLMotionProps } from "framer-motion";
import { EASINGS, SPRINGS, DURATIONS, MOTION_VARIANTS, useMotionPreference } from "@/lib/motion";

/* ─── 1. MotionButton (Spring Micro-interaction) ─── */
export interface MotionButtonProps extends HTMLMotionProps<"button"> {
  children: React.ReactNode;
  variant?: "primary" | "secondary" | "outline" | "ghost" | "danger";
  size?: "sm" | "md" | "lg";
}

const variantStyles: Record<string, string> = {
  primary: "bg-primary text-white hover:bg-primary-dark shadow-md hover:shadow-lg",
  secondary: "bg-secondary text-white hover:bg-secondary-dark",
  outline: "border border-border text-text hover:bg-surface-2",
  ghost: "bg-transparent text-text hover:bg-surface-2",
  danger: "bg-error text-white hover:opacity-90",
};

const sizeStyles: Record<string, string> = {
  sm: "px-3 py-1.5 text-xs rounded-lg gap-1.5",
  md: "px-4 py-2 text-sm rounded-xl gap-2",
  lg: "px-6 py-3 text-base rounded-2xl gap-2.5",
};

export const MotionButton = React.forwardRef<HTMLButtonElement, MotionButtonProps>(
  ({ children, variant = "primary", size = "md", className = "", disabled, ...props }, ref) => {
    const { shouldReduceMotion } = useMotionPreference();

    return (
      <motion.button
        ref={ref}
        disabled={disabled}
        whileHover={shouldReduceMotion || disabled ? undefined : { scale: 1.02, y: -1 }}
        whileTap={shouldReduceMotion || disabled ? undefined : { scale: 0.96 }}
        transition={SPRINGS.snappy}
        className={`inline-flex items-center justify-center font-medium transition-colors cursor-pointer select-none disabled:opacity-50 disabled:cursor-not-allowed will-change-transform ${variantStyles[variant]} ${sizeStyles[size]} ${className}`}
        {...props}
      >
        {children}
      </motion.button>
    );
  }
);
MotionButton.displayName = "MotionButton";

/* ─── 2. MotionCard (Smooth Composite Elevation) ─── */
export interface MotionCardProps extends HTMLMotionProps<"div"> {
  children: React.ReactNode;
  interactive?: boolean;
}

export const MotionCard = React.forwardRef<HTMLDivElement, MotionCardProps>(
  ({ children, interactive = false, className = "", ...props }, ref) => {
    const { shouldReduceMotion } = useMotionPreference();

    return (
      <motion.div
        ref={ref}
        whileHover={interactive && !shouldReduceMotion ? { y: -4, scale: 1.01 } : undefined}
        whileTap={interactive && !shouldReduceMotion ? { scale: 0.99 } : undefined}
        transition={SPRINGS.gentle}
        className={`rounded-2xl border border-border bg-surface p-5 shadow-sm transition-shadow ${
          interactive ? "cursor-pointer hover:shadow-md hover:border-primary/40 will-change-transform" : ""
        } ${className}`}
        {...props}
      >
        {children}
      </motion.div>
    );
  }
);
MotionCard.displayName = "MotionCard";

/* ─── 3. MotionModal (Backdrop + Spring Pop-up) ─── */
export interface MotionModalProps {
  isOpen: boolean;
  onClose: () => void;
  title?: string;
  children: React.ReactNode;
  maxWidth?: "sm" | "md" | "lg" | "xl";
}

const maxWidthStyles = {
  sm: "max-w-sm",
  md: "max-w-md",
  lg: "max-w-lg",
  xl: "max-w-xl",
};

export function MotionModal({
  isOpen,
  onClose,
  title,
  children,
  maxWidth = "md",
}: MotionModalProps) {
  const { shouldReduceMotion } = useMotionPreference();

  return (
    <AnimatePresence>
      {isOpen && (
        <div className="fixed inset-0 z-50 flex items-center justify-center p-4">
          {/* Backdrop */}
          <motion.div
            initial={{ opacity: 0 }}
            animate={{ opacity: 1 }}
            exit={{ opacity: 0 }}
            transition={{ duration: shouldReduceMotion ? 0 : DURATIONS.fast }}
            onClick={onClose}
            className="fixed inset-0 bg-black/50 backdrop-blur-sm"
          />

          {/* Modal Box */}
          <motion.div
            variants={MOTION_VARIANTS.modalDialog}
            initial={shouldReduceMotion ? { opacity: 0 } : "initial"}
            animate={shouldReduceMotion ? { opacity: 1 } : "animate"}
            exit={shouldReduceMotion ? { opacity: 0 } : "exit"}
            className={`relative z-10 w-full ${maxWidthStyles[maxWidth]} overflow-hidden rounded-2xl border border-border bg-surface p-6 shadow-2xl will-change-transform`}
          >
            {title && (
              <div className="mb-4 flex items-center justify-between">
                <h3 className="text-lg font-semibold text-text">{title}</h3>
                <button
                  onClick={onClose}
                  aria-label="Close modal"
                  className="rounded-lg p-1.5 text-text-2 hover:bg-surface-2 hover:text-text transition-colors"
                >
                  ✕
                </button>
              </div>
            )}
            {children}
          </motion.div>
        </div>
      )}
    </AnimatePresence>
  );
}

/* ─── 4. StaggerList & StaggerItem (60fps Cascading) ─── */
export function StaggerList({
  children,
  className = "",
}: {
  children: React.ReactNode;
  className?: string;
}) {
  return (
    <motion.div
      variants={MOTION_VARIANTS.staggerContainer}
      initial="initial"
      animate="animate"
      className={className}
    >
      {children}
    </motion.div>
  );
}

export function StaggerItem({
  children,
  className = "",
}: {
  children: React.ReactNode;
  className?: string;
}) {
  return (
    <motion.div
      variants={MOTION_VARIANTS.staggerItem}
      className={`will-change-transform ${className}`}
    >
      {children}
    </motion.div>
  );
}
</file>

<file path="src/app/_components/N8nChatWidget.tsx">
"use client";

import { useEffect, useRef, useState, useMemo } from "react";
import { usePathname } from "next/navigation";
import { useAuth } from "@/lib/auth-context";
import "@n8n/chat/dist/style.css";

export interface N8nChatWidgetProps {
  /**
   * Tùy chọn ghi đè Webhook URL nếu không dùng process.env.NEXT_PUBLIC_CHAT_WEBHOOK_URL
   */
  webhookUrl?: string;
  /**
   * Danh sách tiền tố đường dẫn không hiển thị chatbot (mặc định loại trừ kiosk gate)
   */
  disabledPaths?: string[];
  /**
   * Nếu đặt là true, chatbot sẽ hiển thị trên tất cả các trang
   */
  showOnAllPages?: boolean;
}

const DEFAULT_DISABLED_PATHS = ["/gate"];

export default function N8nChatWidget({
  webhookUrl: propWebhookUrl,
  disabledPaths = DEFAULT_DISABLED_PATHS,
  showOnAllPages = false,
}: N8nChatWidgetProps) {
  const pathname = usePathname();
  const { user, isLoading: authLoading } = useAuth();
  const [initError, setInitError] = useState<string | null>(null);
  const appRef = useRef<{ unmount: () => void } | null>(null);

  // Chatbot n8n la kenh cua doc gia (patron) va khach (guest).
  // Staff/admin dung trang /ai-assistant noi bo nen an widget de tranh nham lan.
  const isStaffUser = user?.role === "staff" || user?.role === "admin";

  const activeWebhookUrl = useMemo(() => {
    return (
      propWebhookUrl ||
      process.env.NEXT_PUBLIC_CHAT_WEBHOOK_URL ||
      ""
    );
  }, [propWebhookUrl]);

  // Kiểm tra trang hiện tại có thuộc danh sách tắt không
  const isPageDisabled = useMemo(() => {
    if (showOnAllPages) return false;
    if (!pathname) return false;
    return disabledPaths.some((p) => pathname.startsWith(p));
  }, [pathname, showOnAllPages, disabledPaths]);

  useEffect(() => {
    const cleanup = () => {
      if (appRef.current) {
        try {
          appRef.current.unmount();
        } catch (e) {
          console.error("[N8nChatWidget] Lỗi khi unmount:", e);
        }
        appRef.current = null;
      }
      document.querySelector("#n8n-chat-widget-root")?.remove();
    };

    // Cho auth resolve xong; an widget voi staff/admin
    if (authLoading) return;
    if (isStaffUser) {
      cleanup();
      return;
    }

    // Nếu trang hiện tại bị vô hiệu hóa hoặc không có Webhook URL, không khởi tạo
    if (isPageDisabled) {
      cleanup();
      return;
    }

    if (!activeWebhookUrl) {
      if (process.env.NODE_ENV === "development") {
        console.warn(
          "[N8nChatWidget] Cảnh báo: Biến môi trường NEXT_PUBLIC_CHAT_WEBHOOK_URL chưa được cấu hình. Widget chatbot tạm thời ẩn."
        );
      }
      return;
    }

    let isSubscribed = true;
    const targetId = "n8n-chat-widget-root";

    // Đảm bảo phần tử mục tiêu tồn tại trên DOM
    let targetEl = document.getElementById(targetId);
    if (!targetEl) {
      targetEl = document.createElement("div");
      targetEl.id = targetId;
      document.body.appendChild(targetEl);
    }

    const loadChat = async () => {
      try {
        const { createChat } = await import("@n8n/chat");
        if (!isSubscribed) return;

        // Khởi tạo widget n8n chat với các tùy chọn chuẩn
        const chatApp = createChat({
          target: `#${targetId}`,
          webhookUrl: activeWebhookUrl,
          mode: "window",
          showWelcomeScreen: true,
          defaultLanguage: "en",
          initialMessages: [
            "Xin chào! 👋 Tôi là trợ lý AI của Thư viện IUH.",
            "Tôi có thể giúp bạn tra cứu tài liệu, trả lời câu hỏi về sách và giải đáp thắc mắc liên quan đến thư viện.",
            "Hãy đặt câu hỏi để bắt đầu! 📚",
          ],
          i18n: {
            en: {
              title: "Trợ lý AI Thư viện IUH",
              subtitle: "Hỏi đáp thông minh dựa trên tài liệu",
              inputPlaceholder: "Nhập câu hỏi về sách, tài liệu...",
              getStarted: "Bắt đầu trò chuyện",
              closeButtonTooltip: "Đóng cửa sổ chat",
              footer: "",
            },
          },
          enableStreaming: true,
          loadPreviousSession: true,
          allowFileUploads: false,
          metadata: {},
        });

        appRef.current = chatApp;
        setInitError(null);
      } catch (err: unknown) {
        console.error("[N8nChatWidget] Lỗi khởi tạo widget @n8n/chat:", err);
        // Lưu lỗi thân thiện, không throw để tránh làm sập layout
        if (isSubscribed) {
          setInitError("Không thể kết nối với dịch vụ trợ lý chatbot n8n.");
        }
      }
    };

    loadChat();

    // Dọn dẹp an toàn khi unmount hoặc đổi trạng thái (tránh duplicate trong React StrictMode)
    return () => {
      isSubscribed = false;
      if (appRef.current) {
        try {
          appRef.current.unmount();
        } catch (e) {
          console.error("[N8nChatWidget] Lỗi dọn dẹp widget:", e);
        }
        appRef.current = null;
      }
      const el = document.getElementById(targetId);
      if (el) {
        el.remove();
      }
    };
  }, [activeWebhookUrl, isPageDisabled, isStaffUser, authLoading]);

  // Thông báo lỗi nhỏ khi khởi tạo thất bại (chỉ hiển thị kín đáo nếu cần gỡ lỗi)
  if (initError && process.env.NODE_ENV === "development") {
    return (
      <div
        style={{ display: "none" }}
        data-testid="n8n-chat-error"
        aria-hidden="true"
      >
        {initError}
      </div>
    );
  }

  return null;
}
</file>

<file path="src/app/_components/ReauthOverlay.tsx">
"use client";

import { useCallback, useEffect, useRef, useState } from "react";
import {
  Box,
  Button,
  CircularProgress,
  IconButton,
  TextField,
  Typography,
} from "@mui/material";
import CameraAltOutlinedIcon from "@mui/icons-material/CameraAltOutlined";
import CloseOutlinedIcon from "@mui/icons-material/CloseOutlined";
import LogoutOutlinedIcon from "@mui/icons-material/LogoutOutlined";
import { bus } from "@/lib/event-bus";
import api, { retryPendingRequests, cancelPendingRequests } from "@/lib/api-client";
import { useAuth } from "@/lib/auth-context";

export default function ReauthOverlay() {
  const { user, logout } = useAuth();
  const [open, setOpen] = useState(false);
  const [mode, setMode] = useState<"password" | "face">("password");
  const [password, setPassword] = useState("");
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState("");
  const videoRef = useRef<HTMLVideoElement>(null);
  const streamRef = useRef<MediaStream | null>(null);

  useEffect(() => {
    const unsubRequired = bus.on("auth:required", () => setOpen(true));
    const unsubCancelled = bus.on("auth:cancelled", () => {
      setOpen(false);
      cancelPendingRequests();
    });
    return () => {
      unsubRequired();
      unsubCancelled();
    };
  }, []);

  useEffect(() => {
    if (!open) {
      stopCamera();
      setMode("password");
      setPassword("");
      setError("");
    }
  }, [open]);

  const stopCamera = useCallback(() => {
    if (streamRef.current) {
      streamRef.current.getTracks().forEach((t) => t.stop());
      streamRef.current = null;
    }
  }, []);

  const startCamera = useCallback(async () => {
    try {
      stopCamera();
      const stream = await navigator.mediaDevices.getUserMedia({
        video: { facingMode: "user", width: { ideal: 320 }, height: { ideal: 240 } },
        audio: false,
      });
      streamRef.current = stream;
      if (videoRef.current) videoRef.current.srcObject = stream;
    } catch {
      setError("Không thể mở camera");
      setMode("password");
    }
  }, [stopCamera]);

  useEffect(() => {
    if (mode === "face") startCamera();
    return () => { if (mode === "face") stopCamera(); };
  }, [mode, startCamera, stopCamera]);

  const captureAndLogin = useCallback(async () => {
    const video = videoRef.current;
    if (!video || !video.videoWidth) return;
    const canvas = document.createElement("canvas");
    canvas.width = video.videoWidth;
    canvas.height = video.videoHeight;
    const ctx = canvas.getContext("2d");
    if (!ctx) return;
    ctx.drawImage(video, 0, 0);
    const blob = await new Promise<Blob | null>((res) => canvas.toBlob(res, "image/jpeg", 0.85));
    if (!blob) return;
    const file = new File([blob], "face.jpg", { type: "image/jpeg" });
    setLoading(true);
    setError("");
    try {
      const res = await api.faceLogin(file);
      if (res.access_token) {
        retryPendingRequests(res.access_token);
        setOpen(false);
      }
    } catch (err: any) {
      setError(err?.response?.data?.detail || err?.message || "Xác thực khuôn mặt thất bại");
    } finally {
      setLoading(false);
    }
  }, []);

  const handlePasswordSubmit = async (e: React.FormEvent) => {
    e.preventDefault();
    setError("");
    setLoading(true);
    try {
      const res = await api.login({ email: user?.email || "", password });
      if (!res.access_token) throw new Error("Không nhận được token");
      retryPendingRequests(res.access_token);
      setOpen(false);
    } catch (err: any) {
      setError(err?.response?.data?.detail || err?.message || "Đăng nhập thất bại");
    } finally {
      setLoading(false);
    }
  };

  const handleLogout = async () => {
    await logout();
    cancelPendingRequests();
    setOpen(false);
  };

  if (!open) return null;

  return (
    <Box
      sx={{
        position: "fixed",
        inset: 0,
        zIndex: 9999,
        display: "flex",
        alignItems: "center",
        justifyContent: "center",
        bgcolor: "rgba(0,0,0,0.55)",
        backdropFilter: "blur(8px)",
      }}
    >
      <Box
