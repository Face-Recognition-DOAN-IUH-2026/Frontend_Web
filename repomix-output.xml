"use client";

import { useMemo, useState } from "react";
import api from "@/lib/api-client";
import type { ScheduleStaff, StaffShift, LibraryZone, StaffScheduleAssignment } from "@/lib/types";

interface AssignStaffDialogProps {
  open: boolean;
  date: string;
  shiftId: string;
  shiftName: string;
  shifts: StaffShift[];
  zones: LibraryZone[];
  staff: ScheduleStaff[];
  existingAssignments: StaffScheduleAssignment[];
  onClose: () => void;
  onAssigned: () => void;
}

export default function AssignStaffDialog({
  open, date, shiftId, shiftName, shifts, zones, staff, existingAssignments, onClose, onAssigned,
}: AssignStaffDialogProps) {
  const [zoneId, setZoneId] = useState("");
  const [staffId, setStaffId] = useState("");
  const [saving, setSaving] = useState(false);
  const [error, setError] = useState<string | null>(null);

  const shift = useMemo(() => shifts.find((s) => s.id === shiftId), [shifts, shiftId]);

  const existingStaffIds = useMemo(
    () => new Set(existingAssignments.map((a) => a.staffId)),
    [existingAssignments],
  );

  const availableStaff = useMemo(
    () => staff.filter((s) => !existingStaffIds.has(s.id)),
    [staff, existingStaffIds],
  );

  const reset = () => {
    setZoneId("");
    setStaffId("");
    setError(null);
  };

  const handleAssign = async () => {
    if (!zoneId || !staffId) {
      setError("Vui lòng chọn khu vực và nhân viên");
      return;
    }
    setSaving(true);
    setError(null);
    try {
      await api.createScheduleAssignment({ staffId, shiftId, zoneId, workDate: date });
      reset();
      onAssigned();
    } catch (err: any) {
      const data = err?.response?.data;
      setError(data?.error || data?.message || data?.detail?.[0]?.message || err?.message || "Có lỗi xảy ra");
    } finally {
      setSaving(false);
    }
  };

  if (!open) return null;

  return (
    <div className="fixed inset-0 z-50 flex items-center justify-center">
      <div className="absolute inset-0 bg-black/50" onClick={onClose} />
      <div className="relative bg-surface rounded-xl shadow-xl border border-border w-80 p-5 space-y-4 animate-fade-in">
        <div className="flex items-center justify-between">
          <h3 className="text-sm font-semibold text-text">Phân ca trực</h3>
          <button onClick={onClose} className="text-text-3 hover:text-text transition text-sm">&times;</button>
        </div>

        <div className="text-xs text-text-3 space-y-0.5">
          <div><span className="font-medium text-text-2">Ngày:</span> {date}</div>
          <div><span className="font-medium text-text-2">Ca:</span> <span className="text-primary">{shiftName}</span></div>
          {shift && (
            <div className="text-text-3">{shift.startTime?.slice(0, 5)} &ndash; {shift.endTime?.slice(0, 5)}</div>
          )}
        </div>

        <div className="space-y-3">
          <div>
            <label className="text-[11px] font-medium text-text-3 block mb-1">Khu vực</label>
            <select
              value={zoneId}
              onChange={(e) => { setZoneId(e.target.value); setError(null); }}
              className="w-full px-2.5 py-1.5 rounded-md bg-surface-2 border border-border text-xs text-text focus:outline-none focus:border-primary"
            >
              <option value="">Chọn khu vực</option>
              {zones.map((z) => (
                <option key={z.id} value={z.id}>{z.zoneName}</option>
              ))}
            </select>
          </div>

          <div>
            <label className="text-[11px] font-medium text-text-3 block mb-1">
              Nhân viên
              {availableStaff.length < staff.length && (
                <span className="text-text-3 font-normal ml-1">({staff.length - availableStaff.length} đã xếp)</span>
              )}
            </label>
            <select
              value={staffId}
              onChange={(e) => { setStaffId(e.target.value); setError(null); }}
              className="w-full px-2.5 py-1.5 rounded-md bg-surface-2 border border-border text-xs text-text focus:outline-none focus:border-primary"
            >
              <option value="">Chọn nhân viên</option>
              {availableStaff.map((s) => (
                <option key={s.id} value={s.id}>{s.fullName || s.email}</option>
              ))}
              {availableStaff.length === 0 && (
                <option disabled>Tất cả nhân viên đã được xếp</option>
              )}
            </select>
          </div>
        </div>

        {error && (
          <div className="text-xs text-error bg-error/10 border border-error/20 rounded-md px-2.5 py-1.5">
            {error}
          </div>
        )}

        <div className="flex items-center gap-2 justify-end pt-1">
          <button
            onClick={onClose}
            className="px-3 py-1.5 rounded-md text-xs font-medium text-text-2 hover:bg-surface-2 transition border border-border"
          >
            Hủy
          </button>
          <button
            onClick={handleAssign}
            disabled={saving || availableStaff.length === 0}
            className="px-3 py-1.5 rounded-md text-xs font-medium text-bg bg-primary hover:bg-primary-dark transition disabled:opacity-50"
          >
            {saving ? "Đang xử lý..." : "Xếp ca"}
          </button>
        </div>
      </div>
    </div>
  );
}
</file>

<file path="src/components/staff-schedule/ScheduleManagementPanel.tsx">
"use client";

import { useState } from "react";
import api from "@/lib/api-client";
import type { LibraryZone, StaffShift } from "@/lib/types";

interface ScheduleManagementPanelProps {
  open: boolean;
  onClose: () => void;
  zones: LibraryZone[];
  shifts: StaffShift[];
  onUpdate: () => void;
}

function getApiError(err: any): string {
  const data = err?.response?.data;
  return data?.error || data?.message || err?.message || "Có lỗi xảy ra";
}

export default function ScheduleManagementPanel({
  open, onClose, zones, shifts, onUpdate,
}: ScheduleManagementPanelProps) {
  const [tab, setTab] = useState<"zones" | "shifts">("zones");
  const [saving, setSaving] = useState(false);
  const [error, setError] = useState<string | null>(null);

  const [zoneFloor, setZoneFloor] = useState("1");
  const [zoneName, setZoneName] = useState("");

  const [shiftName, setShiftName] = useState("");
  const [startTime, setStartTime] = useState("07:30");
  const [endTime, setEndTime] = useState("11:30");
  const [minStaff, setMinStaff] = useState("1");

  const handleCreateZone = async () => {
    setSaving(true);
    setError(null);
    try {
      await api.createScheduleZone({ floor: Number(zoneFloor) || 1, zoneName: zoneName.trim() || `Tầng ${zoneFloor}` });
      setZoneName("");
      onUpdate();
    } catch (err: any) {
      setError(getApiError(err));
    } finally {
      setSaving(false);
    }
  };

  const handleDeleteZone = async (id: string) => {
    if (!confirm("Xóa khu vực này?")) return;
    setSaving(true);
    try {
      await api.deleteScheduleZone(id);
      onUpdate();
    } catch (err: any) {
      setError(getApiError(err));
    } finally {
      setSaving(false);
    }
  };

  const handleCreateShift = async () => {
    if (!shiftName.trim()) { setError("Vui lòng nhập tên ca"); return; }
    setSaving(true);
    setError(null);
    try {
      await api.createScheduleShift({
        name: shiftName.trim(),
        startTime, endTime,
        minStaff: Math.max(1, Number(minStaff) || 1),
      });
      setShiftName("");
      onUpdate();
    } catch (err: any) {
      setError(getApiError(err));
    } finally {
      setSaving(false);
    }
  };

  const handleDeleteShift = async (id: string) => {
    if (!confirm("Xóa ca trực này?")) return;
    setSaving(true);
    try {
      await api.deleteScheduleShift(id);
      onUpdate();
    } catch (err: any) {
      setError(getApiError(err));
    } finally {
      setSaving(false);
    }
  };

  const createDefaults = async () => {
    setSaving(true);
    setError(null);
    try {
      if (!zones.length) {
        await Promise.all([
          api.createScheduleZone({ floor: 1, zoneName: "Tầng 1" }),
          api.createScheduleZone({ floor: 2, zoneName: "Tầng 2" }),
        ]);
      }
      if (!shifts.length) {
        await Promise.all([
          api.createScheduleShift({ name: "Ca sáng", startTime: "07:30", endTime: "11:30", minStaff: 1 }),
          api.createScheduleShift({ name: "Ca chiều", startTime: "13:00", endTime: "17:00", minStaff: 1 }),
          api.createScheduleShift({ name: "Ca tối", startTime: "17:30", endTime: "20:30", minStaff: 1 }),
        ]);
      }
      onUpdate();
    } catch (err: any) {
      setError(getApiError(err));
    } finally {
      setSaving(false);
    }
  };

  if (!open) return null;

  return (
    <div className="fixed inset-0 z-50 flex justify-end">
      <div className="absolute inset-0 bg-black/50" onClick={onClose} />
      <div className="relative bg-surface w-80 h-full shadow-xl border-l border-border flex flex-col animate-slide-in">
        <div className="flex items-center justify-between px-4 py-3 border-b border-border">
          <h2 className="font-serif text-sm font-semibold text-primary">Quản lý lịch trực</h2>
          <button onClick={onClose} className="text-text-3 hover:text-text transition text-sm">&times;</button>
        </div>

        <div className="flex border-b border-border">
          <button
            onClick={() => setTab("zones")}
            className={`flex-1 py-2 text-xs font-medium transition border-b-2 ${
              tab === "zones"
                ? "border-primary text-primary"
                : "border-transparent text-text-3 hover:text-text-2"
            }`}
          >
            Khu vực
          </button>
          <button
            onClick={() => setTab("shifts")}
            className={`flex-1 py-2 text-xs font-medium transition border-b-2 ${
              tab === "shifts"
                ? "border-primary text-primary"
                : "border-transparent text-text-3 hover:text-text-2"
            }`}
          >
            Ca trực
          </button>
        </div>

        <div className="flex-1 overflow-y-auto p-4 space-y-4">
          {error && (
