        />
      ) : (
        <Box sx={{ display: "grid", gridTemplateColumns: { xs: "1fr", sm: "repeat(2, 1fr)" }, gap: 1.5 }}>
          {cameras.map((cam) => {
            const isOnline = cam.connected && cam.running;
            return (
              <Stack
                key={cam.camera_id}
                direction="row"
