<file path="src/app/(dashboard)/_components/IsbnScannerDialog.tsx">
"use client";

import { useCallback, useEffect, useRef, useState } from "react";
import {
  Alert,
  Avatar,
  Box,
  Button,
  Chip,
  CircularProgress,
  Dialog,
  DialogActions,
  DialogContent,
  DialogTitle,
  IconButton,
  Paper,
  Snackbar,
  Stack,
  TextField,
  Typography,
} from "@mui/material";
import BookIcon from "@mui/icons-material/MenuBookOutlined";
import CameraAltIcon from "@mui/icons-material/CameraAltOutlined";
import CheckCircleIcon from "@mui/icons-material/CheckCircleOutlineOutlined";
import CloseIcon from "@mui/icons-material/Close";
import DeleteIcon from "@mui/icons-material/DeleteOutlined";
import QrCodeScannerIcon from "@mui/icons-material/QrCodeScannerOutlined";
import api, { getErrorMessage } from "@/lib/api-client";
import type { BookImportResultRow, BookWithStats } from "@/lib/types";

interface ScannedItem {
  isbn: string;
  quantity: number;
  lookup: BookWithStats | null;
  loading: boolean;
}

export default function IsbnScannerDialog({
  open,
  onClose,
  onImportComplete,
}: {
  open: boolean;
  onClose: () => void;
  onImportComplete: (results: BookImportResultRow[]) => void;
}) {
  const videoRef = useRef<HTMLVideoElement>(null);
  const streamRef = useRef<MediaStream | null>(null);
  const readerRef = useRef<any>(null);
  const lastScannedRef = useRef<string | null>(null);
  const [cameraReady, setCameraReady] = useState(false);
  const [cameraError, setCameraError] = useState("");
  const [scanned, setScanned] = useState<ScannedItem[]>([]);
  const [importing, setImporting] = useState(false);
  const [importError, setImportError] = useState("");
  const [scanToast, setScanToast] = useState("");

  const stopCamera = useCallback(() => {
    if (readerRef.current) {
      try { readerRef.current.reset(); } catch {}
      readerRef.current = null;
    }
    if (streamRef.current) {
      streamRef.current.getTracks().forEach((track) => track.stop());
      streamRef.current = null;
    }
    if (videoRef.current) videoRef.current.srcObject = null;
    setCameraReady(false);
  }, []);

  const lookupIsbn = useCallback(async (isbn: string) => {
    setScanned((prev) => prev.map((item) =>
      item.isbn === isbn ? { ...item, loading: true } : item
    ));
    try {
      const book = await api.lookupBookByIsbn(isbn);
      setScanned((prev) => prev.map((item) =>
        item.isbn === isbn ? { ...item, lookup: book, loading: false } : item
      ));
    } catch (err) {
      setScanned((prev) => prev.filter((item) => item.isbn !== isbn));
      setScanToast(`Không tìm thấy: ${isbn}`);
    }
  }, []);

  const addScanned = useCallback((isbn: string) => {
    if (!/^\d{10,13}$/.test(isbn.replace(/-/g, ""))) return;
    const normalized = isbn.replace(/-/g, "");
    lastScannedRef.current = normalized;
    setScanToast(normalized);
    setScanned((prev) => {
      if (prev.some((item) => item.isbn === normalized)) {
        return prev.map((item) =>
          item.isbn === normalized ? { ...item, quantity: item.quantity + 1 } : item
        );
      }
      return [...prev, { isbn: normalized, quantity: 1, lookup: null, loading: true }];
    });
    lookupIsbn(normalized);
  }, [lookupIsbn]);

  useEffect(() => {
    if (!open) {
      stopCamera();
      setScanned([]);
      setCameraError("");
      setImportError("");
      setScanToast("");
      lastScannedRef.current = null;
      return;
    }
    let active = true;
    (async () => {
      try {
        setCameraError("");
        const { BrowserMultiFormatReader } = await import("@zxing/browser");
        if (!active) return;
        const stream = await navigator.mediaDevices.getUserMedia({
          video: { facingMode: "environment", width: { ideal: 640 }, height: { ideal: 480 } },
          audio: false,
        });
        if (!active) { stream.getTracks().forEach((t) => t.stop()); return; }
        streamRef.current = stream;
        if (videoRef.current) {
          videoRef.current.srcObject = stream;
          videoRef.current.onloadedmetadata = () => { setCameraReady(true); };
        }
      } catch (err: any) {
        if (!active) return;
        if (err.name === "NotAllowedError") setCameraError("Không có quyền truy cập camera. Hãy cấp quyền camera cho trình duyệt.");
        else if (err.name === "NotFoundError") setCameraError("Không tìm thấy camera trên thiết bị.");
        else setCameraError("Không thể khởi động camera.");
      }
    })();
    return () => { active = false; };
  }, [open, stopCamera]);

  useEffect(() => {
    if (!cameraReady || !videoRef.current || !open) return;
    let active = true;
    (async () => {
      try {
        const { BrowserMultiFormatReader } = await import("@zxing/browser");
        if (!active) return;
        const reader = new BrowserMultiFormatReader();
        readerRef.current = reader;
        reader.decodeFromVideoElement(videoRef.current!, (result, err) => {
          if (!active) return;
          if (result) {
            const code = result.getText();
            if (/^\d{10,13}$/.test(code.replace(/-/g, ""))) {
              addScanned(code);
            }
          }
        });
      } catch {}
    })();
    return () => { active = false; };
  }, [cameraReady, open, addScanned]);

  useEffect(() => () => stopCamera(), [stopCamera]);

  const removeItem = (isbn: string) => {
    setScanned((prev) => prev.filter((item) => item.isbn !== isbn));
  };

  const updateQuantity = (isbn: string, value: number) => {
    setScanned((prev) => prev.map((item) =>
      item.isbn === isbn ? { ...item, quantity: Math.max(1, value || 1) } : item
    ));
  };

  const handleImport = async () => {
    const valid = scanned.filter((item) => item.lookup);
    if (!valid.length) return;
    setImporting(true);
    setImportError("");
    try {
      const result = await api.batchImportByIsbn(valid.map((item) => ({ isbn: item.isbn, quantity: item.quantity })));
      onImportComplete(result.results);
      stopCamera();
      setScanned([]);
    } catch (err) {
      setImportError(getErrorMessage(err));
    } finally {
      setImporting(false);
    }
  };

  const validCount = scanned.filter((item) => item.lookup).length;
  const isNew = (item: ScannedItem) => item.lookup && item.lookup.total_copies === 0;

  return (
    <>
      <Dialog open={open} onClose={importing ? undefined : onClose} fullWidth maxWidth="xl">
        <DialogTitle>
          <Stack direction="row" spacing={1} sx={{ alignItems: "center", justifyContent: "space-between" }}>
            <Stack direction="row" spacing={1} sx={{ alignItems: "center" }}>
              <QrCodeScannerIcon color="primary" />
              <Typography variant="h6" sx={{ fontWeight: 900 }}>Quét mã ISBN</Typography>
            </Stack>
            {!importing && (
              <IconButton size="small" onClick={onClose}><CloseIcon /></IconButton>
            )}
          </Stack>
        </DialogTitle>
        <DialogContent dividers sx={{ p: 2, display: "flex", flexDirection: "column", overflow: "hidden" }}>
          <Box sx={{ display: "flex", gap: 2, flexDirection: { xs: "column", md: "row" }, flex: 1, overflow: "hidden" }}>
            <Paper
              variant="outlined"
              sx={{
                position: "relative",
                overflow: "hidden",
                bgcolor: "black",
                width: { md: "50%" },
                aspectRatio: { xs: "16/9", md: "4/3" },
                display: "flex",
                alignItems: "center",
                justifyContent: "center",
                flexShrink: 0,
              }}
            >
              {cameraError ? (
                <Stack spacing={1} sx={{ alignItems: "center", color: "grey.300", p: 3 }}>
                  <CameraAltIcon sx={{ fontSize: 42 }} />
                  <Typography>{cameraError}</Typography>
                </Stack>
              ) : (
                <>
                  <Box
                    component="video"
                    ref={videoRef}
                    autoPlay
                    playsInline
                    muted
                    sx={{ width: "100%", height: "100%", objectFit: "contain" }}
                  />
                  {!cameraReady && (
                    <Stack sx={{ position: "absolute", inset: 0, bgcolor: "rgba(0,0,0,.55)", color: "common.white", alignItems: "center", justifyContent: "center" }} spacing={1}>
                      <CircularProgress size={26} color="inherit" />
                      <Typography variant="body2">Đang kết nối camera...</Typography>
                    </Stack>
                  )}
                </>
              )}
            </Paper>

            <Stack spacing={1.5} sx={{ flex: 1, overflow: "auto" }}>
              <Stack direction="row" spacing={1} sx={{ alignItems: "center" }}>
                <QrCodeScannerIcon color="primary" sx={{ fontSize: 20 }} />
                <Typography variant="subtitle2" sx={{ fontWeight: 900 }}>
                  {scanned.length > 0 ? `Đã quét (${scanned.length} cuốn)` : "Sách đã quét"}
                </Typography>
              </Stack>

              {importError ? <Alert severity="error" onClose={() => setImportError("")}>{importError}</Alert> : null}

              {scanned.length === 0 ? (
                <Alert severity="info" sx={{ flex: 1, display: "flex", alignItems: "center" }}>
                  Đưa mã vạch ISBN vào camera. Sách sẽ xuất hiện tại đây.
                </Alert>
              ) : (
                scanned.map((item) => {
                  const isLastScanned = item.isbn === lastScannedRef.current;
                  return (
                    <Paper
                      key={item.isbn}
                      variant="outlined"
                      sx={{
                        p: 1.5,
                        borderColor: isLastScanned ? "primary.main" : undefined,
                        bgcolor: isLastScanned ? "action.hover" : undefined,
                      }}
                    >
                      <Stack direction="row" spacing={1.5} sx={{ alignItems: "flex-start" }}>
                        {item.lookup?.cover_url ? (
                          <Box
                            component="img"
                            src={item.lookup.cover_url}
                            alt={item.lookup.title}
                            sx={{ width: 40, height: 56, objectFit: "cover", borderRadius: 0.5, flexShrink: 0 }}
                          />
                        ) : (
                          <Avatar variant="rounded" sx={{ width: 40, height: 56, bgcolor: "background.default", flexShrink: 0 }}>
                            <BookIcon />
                          </Avatar>
                        )}
                        <Stack spacing={0.3} sx={{ flex: 1, minWidth: 0 }}>
                          <Stack direction="row" spacing={0.5} sx={{ alignItems: "center" }}>
                            {item.loading ? (
                              <Typography variant="body2" color="text.secondary">Đang tra cứu...</Typography>
                            ) : item.lookup ? (
                              <>
                                <Typography variant="body2" sx={{ fontWeight: 900, flex: 1 }} noWrap>
                                  {item.lookup.title}
                                </Typography>
                                {isNew(item) && <Chip size="small" color="success" label="Mới" sx={{ height: 20 }} />}
                              </>
                            ) : null}
                          </Stack>
                          {item.lookup && (
                            <Typography variant="caption" color="text.secondary" noWrap>
                              {item.lookup.author || "-"}
                            </Typography>
                          )}
                          <Typography variant="caption" sx={{ fontFamily: "monospace", color: "primary.main" }}>
                            {item.isbn}
                          </Typography>
                          {item.lookup && !item.loading && (
                            <Stack direction="row" spacing={1} sx={{ alignItems: "center", flexWrap: "wrap" }}>
                              {isNew(item) ? (
                                <Chip size="small" variant="outlined" label="Sách mới - chưa có trong kho" sx={{ height: 20, fontSize: 11 }} />
                              ) : (
                                <Stack direction="row" spacing={0.5} sx={{ alignItems: "center", flexWrap: "wrap" }}>
                                  <Chip size="small" variant="outlined" label={`Kho: ${item.lookup.total_copies}`} sx={{ height: 20, fontSize: 11 }} />
                                  <Chip size="small" variant="outlined" color="success" label={`Sẵn: ${item.lookup.available_copies}`} sx={{ height: 20, fontSize: 11 }} />
                                </Stack>
                              )}
                            </Stack>
                          )}
                          {item.lookup && !item.loading && (
                            <Stack direction="row" spacing={1} sx={{ alignItems: "center", mt: 0.5 }}>
                              <TextField
                                type="number"
                                size="small"
                                label="SL thêm"
                                value={item.quantity}
                                onChange={(e) => updateQuantity(item.isbn, parseInt(e.target.value) || 1)}
                                slotProps={{ htmlInput: { min: 1, style: { textAlign: "center", width: 40 } } }}
                                sx={{ width: 100 }}
                              />
                              {!isNew(item) && (
                                <Typography variant="caption" color="text.secondary">
                                  → Tổng: {item.lookup.total_copies + item.quantity}
                                </Typography>
                              )}
                            </Stack>
                          )}
                        </Stack>
                        <IconButton size="small" color="error" onClick={() => removeItem(item.isbn)} sx={{ mt: 0.5 }}>
                          <DeleteIcon fontSize="small" />
                        </IconButton>
                      </Stack>
                    </Paper>
                  );
                })
              )}

            </Stack>
          </Box>
        </DialogContent>
        <DialogActions>
          <Button onClick={onClose} disabled={importing}>Đóng</Button>
          <Button
            variant="contained"
            disabled={importing || validCount === 0}
            onClick={handleImport}
          >
            {importing ? "Đang nhập vào kho..." : `Nhập vào kho (${validCount} cuốn)`}
          </Button>
        </DialogActions>
      </Dialog>

      <Snackbar
        open={!!scanToast}
        autoHideDuration={2000}
        onClose={() => setScanToast("")}
        anchorOrigin={{ vertical: "top", horizontal: "right" }}
        message={
          <Stack direction="row" spacing={1} sx={{ alignItems: "center" }}>
            <CheckCircleIcon sx={{ fontSize: 18 }} />
            <span>Đã quét ISBN: {scanToast}</span>
          </Stack>
        }
      />
    </>
  );
}
</file>

<file path="src/app/(dashboard)/_components/MultiAngleCapture.tsx">
"use client";

import { useCallback, useEffect, useMemo, useRef, useState } from "react";
import {
  Alert,
  Box,
  Button,
  Checkbox,
  Chip,
  CircularProgress,
  FormControlLabel,
  Grid,
  Paper,
  Stack,
  Typography,
  useTheme,
} from "@mui/material";
import AddAPhotoOutlinedIcon from "@mui/icons-material/AddAPhotoOutlined";
import CheckOutlinedIcon from "@mui/icons-material/CheckOutlined";
import PhotoCameraOutlinedIcon from "@mui/icons-material/PhotoCameraOutlined";
import RestartAltOutlinedIcon from "@mui/icons-material/RestartAltOutlined";

export type CaptureAngle = "frontal" | "right" | "left" | "down";
export type MultiAngleCaptureStatus = "pending" | "capturing" | "done";

export interface AngleConfig {
  angle: CaptureAngle;
  instruction: string;
  tip: string;
}

export interface CapturedAngle {
  angle: CaptureAngle;
  status: MultiAngleCaptureStatus;
  file: File | null;
  dataUrl: string | null;
}

export interface MultiAngleCaptureProps {
  angles?: AngleConfig[];
  consent: boolean;
  setConsent?: (v: boolean) => void;
  onFilesReady: (files: Record<CaptureAngle, File>) => Promise<void> | void;
  className?: string;
}

function captureFromVideo(video: HTMLVideoElement, cameraReady: boolean) {
  return new Promise<{ file: File; dataUrl: string }>((resolve, reject) => {
    if (!cameraReady) return reject(new Error("Camera chưa sẵn sàng"));
    if (video.videoWidth === 0 || video.videoHeight === 0) {
      return reject(new Error("Camera chưa khởi tạo"));
    }

    const canvas = document.createElement("canvas");
    canvas.width = video.videoWidth;
    canvas.height = video.videoHeight;

    const ctx = canvas.getContext("2d");
    if (!ctx) return reject(new Error("Không thể tạo canvas"));

    ctx.drawImage(video, 0, 0);
    const dataUrl = canvas.toDataURL("image/jpeg");
    canvas.toBlob(
      (blob) => {
        if (!blob) return reject(new Error("Không thể tạo ảnh"));
        resolve({ file: new File([blob], "face_capture.jpg", { type: "image/jpeg" }), dataUrl });
      },
      "image/jpeg",
      0.9
    );
  });
}

function getCameraErrorMessage(err: unknown) {
  const name = err instanceof DOMException ? err.name : "";
  if (name === "NotAllowedError" || name === "SecurityError") {
    return "Không có quyền truy cập camera. Hãy cấp quyền camera cho trình duyệt rồi thử lại.";
  }
  if (name === "NotFoundError" || name === "OverconstrainedError") {
    return "Không tìm thấy camera phù hợp. Hãy kiểm tra thiết bị camera rồi thử lại.";
  }
  if (name === "NotReadableError" || name === "AbortError") {
    return "Camera đang được ứng dụng khác sử dụng hoặc không mở được. Hãy đóng ứng dụng khác rồi thử lại.";
  }
  return "Không thể mở camera. Hãy kiểm tra quyền truy cập, thiết bị camera và thử lại.";
}

const ANGLE_LABELS: Record<CaptureAngle, string> = {
  frontal: "Nhìn thẳng",
  right: "Quay phải",
  left: "Quay trái",
  down: "Cúi xuống",
};

export default function MultiAngleCapture({
  angles,
  consent,
  setConsent,
  onFilesReady,
  className,
}: MultiAngleCaptureProps) {
  const theme = useTheme();
  const defaultAngles = useMemo<AngleConfig[]>(
    () =>
      angles ?? [
        { angle: "frontal", instruction: "Nhìn thẳng", tip: "Giữ mặt thẳng, mắt mở tự nhiên" },
        { angle: "right", instruction: "Quay phải", tip: "Xoay đầu sang phải khoảng 30 độ" },
        { angle: "left", instruction: "Quay trái", tip: "Xoay đầu sang trái khoảng 30 độ" },
        { angle: "down", instruction: "Cúi xuống", tip: "Cúi nhẹ cằm xuống ngực" },
      ],
    [angles]
  );

  const videoRef = useRef<HTMLVideoElement | null>(null);
  const streamRef = useRef<MediaStream | null>(null);

  const [cameraReady, setCameraReady] = useState(false);
  const [isCameraOn, setIsCameraOn] = useState(false);
  const [cameraError, setCameraError] = useState("");
  const [isSequenceRunning, setIsSequenceRunning] = useState(false);
  const [currentAngleIdx, setCurrentAngleIdx] = useState(-1);
  const [countdown, setCountdown] = useState<number | null>(null);
  const [captures, setCaptures] = useState<CapturedAngle[]>(
    defaultAngles.map((item) => ({ angle: item.angle, status: "pending", file: null, dataUrl: null }))
  );

  useEffect(() => {
    setCaptures(defaultAngles.map((item) => ({ angle: item.angle, status: "pending", file: null, dataUrl: null })));
  }, [defaultAngles]);

  const stopCamera = useCallback(() => {
    if (streamRef.current) {
      streamRef.current.getTracks().forEach((track) => track.stop());
      streamRef.current = null;
    }
    setIsCameraOn(false);
    setCameraReady(false);
  }, []);

  const startCamera = useCallback(async () => {
    try {
      setCameraError("");
      setCameraReady(false);
      setIsCameraOn(false);
      stopCamera();

      const stream = await navigator.mediaDevices.getUserMedia({
        video: {
          facingMode: "user",
          width: { ideal: 640, min: 320 },
          height: { ideal: 480, min: 240 },
        },
        audio: false,
      });

      streamRef.current = stream;
      setIsCameraOn(true);
      return true;
    } catch (err) {
      setIsCameraOn(false);
      setCameraReady(false);
      setCameraError(getCameraErrorMessage(err));
      return false;
    }
  }, [stopCamera]);

  useEffect(() => {
    if (!isCameraOn || !videoRef.current || !streamRef.current) return;

    const video = videoRef.current;
    const onReady = () => setCameraReady(true);
    const handleError = () => setCameraReady(false);

    video.onloadedmetadata = onReady;
    video.onplaying = onReady;
    video.onerror = handleError;
    video.srcObject = streamRef.current;

    if (video.readyState >= 2) onReady();
    const timer = setTimeout(() => setCameraReady(true), 3000);

    return () => {
      clearTimeout(timer);
      video.onloadedmetadata = null;
      video.onplaying = null;
      video.onerror = null;
      video.srcObject = null;
    };
  }, [isCameraOn]);

  useEffect(() => () => stopCamera(), [stopCamera]);

  const retakeAngle = useCallback(
    async (idx: number) => {
      setCaptures((prev) =>
        prev.map((item, index) => (index === idx ? { ...item, status: "pending", file: null, dataUrl: null } : item))
      );
      const opened = await startCamera();
      if (!opened) return;
      setIsSequenceRunning(true);
      setTimeout(() => setCurrentAngleIdx(idx), 500);
    },
    [startCamera]
  );

  const startSequence = useCallback(async () => {
    setCaptures(defaultAngles.map((item) => ({ angle: item.angle, status: "pending", file: null, dataUrl: null })));
    setCountdown(null);
    const opened = await startCamera();
    if (!opened) {
      setCurrentAngleIdx(-1);
      setIsSequenceRunning(false);
      return;
    }
    setCurrentAngleIdx(0);
    setIsSequenceRunning(true);
  }, [defaultAngles, startCamera]);

  useEffect(() => {
    if (currentAngleIdx < 0 || currentAngleIdx >= defaultAngles.length) return;
    if (!cameraReady || !isSequenceRunning) return;

    let cancelled = false;
    let currentCountdown = 5;

    setCountdown(currentCountdown);
    setCaptures((prev) => prev.map((item, index) => (index === currentAngleIdx ? { ...item, status: "capturing" } : item)));

    const timer = window.setInterval(async () => {
      currentCountdown--;
      if (cancelled) {
        clearInterval(timer);
        return;
      }

      if (currentCountdown <= 0) {
        clearInterval(timer);
        setCountdown(null);

        try {
          const video = videoRef.current;
          if (!video) throw new Error("Không tìm thấy video");

          const { file, dataUrl } = await captureFromVideo(video, cameraReady);
          if (cancelled) return;

          setCaptures((prev) =>
            prev.map((item, index) => (index === currentAngleIdx ? { ...item, status: "done", file, dataUrl } : item))
          );

          const nextIdx = currentAngleIdx + 1;
          if (nextIdx >= defaultAngles.length) {
            setIsSequenceRunning(false);
            setCurrentAngleIdx(-1);
            stopCamera();
          } else {
            setTimeout(() => {
              if (!cancelled) setCurrentAngleIdx(nextIdx);
            }, 800);
          }
        } catch (err) {
          if (cancelled) return;
          setCameraError(getCameraErrorMessage(err));
          setCaptures((prev) => prev.map((item, index) => (index === currentAngleIdx ? { ...item, status: "pending" } : item)));
          setIsSequenceRunning(false);
          setCurrentAngleIdx(-1);
          stopCamera();
        }
      } else {
        setCountdown(currentCountdown);
      }
    }, 1000);

    return () => {
      cancelled = true;
      clearInterval(timer);
    };
  }, [currentAngleIdx, cameraReady, isSequenceRunning, defaultAngles.length, stopCamera]);

  const allCaptured = captures.every((item) => item.status === "done" && Boolean(item.file));
  const doneCount = captures.filter((item) => item.status === "done").length;

  const capturedFiles = useMemo(() => {
    const result = {} as Record<CaptureAngle, File>;
    for (const item of captures) {
      if (item.status === "done" && item.file) {
        result[item.angle] = item.file;
      }
    }
    return result;
  }, [captures]);

  const submit = useCallback(async () => {
    if (!consent || !allCaptured) return;
    await onFilesReady(capturedFiles);
  }, [allCaptured, capturedFiles, consent, onFilesReady]);

  const currentConfig = currentAngleIdx >= 0 ? defaultAngles[currentAngleIdx] : null;

  return (
    <Box className={className}>
      {!allCaptured && !isSequenceRunning && currentAngleIdx < 0 && (
        <Paper variant="outlined" sx={{ p: 3, textAlign: "center" }}>
          <Stack spacing={2} sx={{ alignItems: "center" }}>
            <Box
              sx={{
                width: 64,
                height: 64,
                borderRadius: "50%",
                display: "grid",
                placeItems: "center",
                bgcolor: "primary.main",
                color: "primary.contrastText",
              }}
            >
              <PhotoCameraOutlinedIcon fontSize="large" />
            </Box>
            <Box>
              <Typography variant="h6" sx={{ fontWeight: 850 }}>
                Chụp khuôn mặt từ 4 góc
              </Typography>
              <Typography color="text.secondary">
                Nhận diện nhanh hơn, chính xác hơn tại cổng.
              </Typography>
            </Box>

            <Paper variant="outlined" sx={{ p: 2, width: "100%", bgcolor: "action.hover", textAlign: "left" }}>
              <Typography variant="subtitle2" color="primary" sx={{ fontWeight: 850, mb: 1 }}>
                Lưu ý khi chụp
              </Typography>
              <Stack spacing={0.5}>
                <Typography variant="body2" color="text.secondary">- Đủ ánh sáng, không ngược sáng.</Typography>
                <Typography variant="body2" color="text.secondary">- Giữ yên khi đếm ngược về 0.</Typography>
                <Typography variant="body2" color="text.secondary">- Mặt vừa đủ trong khung tròn.</Typography>
              </Stack>
            </Paper>

            {cameraError && <Alert severity="warning" sx={{ width: "100%" }}>{cameraError}</Alert>}

            <Button variant="contained" size="large" startIcon={<PhotoCameraOutlinedIcon />} onClick={startSequence}>
              Bắt đầu chụp
            </Button>
          </Stack>
        </Paper>
      )}

      {(isSequenceRunning || currentAngleIdx >= 0) && (
        <Paper
          variant="outlined"
          sx={{
            position: "relative",
            aspectRatio: "16 / 9",
            overflow: "hidden",
            bgcolor: "black",
          }}
        >
          <Box component="video" ref={videoRef} autoPlay playsInline muted sx={{ width: "100%", height: "100%", objectFit: "contain" }} />
          <Box
            sx={{
              position: "absolute",
              inset: 0,
              display: "flex",
              alignItems: "center",
              justifyContent: "center",
              pointerEvents: "none",
            }}
          >
            <Box sx={{ width: 150, height: 150, border: 2, borderColor: "primary.main", borderRadius: "50%", opacity: 0.75 }} />
          </Box>

          {!cameraReady && (
            <Stack
              spacing={1}
              sx={{
                position: "absolute",
                inset: 0,
                alignItems: "center",
                justifyContent: "center",
                bgcolor: "rgba(0,0,0,.65)",
                color: "common.white",
              }}
            >
              <CircularProgress color="inherit" size={30} />
              <Typography variant="body2">{cameraError || "Đang mở camera..."}</Typography>
            </Stack>
          )}

          {countdown !== null && currentConfig && (
            <Stack
              spacing={2}
              sx={{
                position: "absolute",
                inset: 0,
                alignItems: "center",
                justifyContent: "center",
                bgcolor: "rgba(0,0,0,.78)",
                color: "common.white",
                textAlign: "center",
                p: 2,
              }}
            >
              <Box>
                <Typography variant="h5" sx={{ fontWeight: 850 }}>{currentConfig.instruction}</Typography>
                <Typography variant="body2" sx={{ color: "grey.300", mt: 0.5 }}>{currentConfig.tip}</Typography>
              </Box>
              <Stack direction="row" spacing={1}>
                {defaultAngles.map((item, index) => (
                  <Box
                    key={item.angle}
                    sx={{
                      width: 12,
                      height: 12,
                      borderRadius: "50%",
                      bgcolor: index < doneCount ? "success.main" : index === currentAngleIdx ? "primary.main" : "grey.600",
                    }}
                  />
                ))}
              </Stack>
              {countdown === 1 && <Chip color="error" label="GIỮ YÊN!" />}
              <Typography sx={{ fontSize: 64, fontWeight: 900, lineHeight: 1 }}>{countdown}</Typography>
            </Stack>
          )}
        </Paper>
      )}

      {allCaptured && (
        <Stack spacing={2}>
          <Grid container spacing={1.5}>
            {captures.map((item, index) => (
              <Grid key={item.angle} size={{ xs: 6, sm: 3 }}>
                <Paper
                  variant="outlined"
                  sx={{
                    position: "relative",
                    aspectRatio: "1 / 1",
                    overflow: "hidden",
                    borderColor: item.status === "done" ? "success.main" : "divider",
                  }}
                >
                  {item.dataUrl ? (
                    <Box component="img" src={item.dataUrl} alt={item.angle} sx={{ width: "100%", height: "100%", objectFit: "cover" }} />
                  ) : (
                    <Stack sx={{ height: "100%", alignItems: "center", justifyContent: "center", bgcolor: "action.hover", color: "text.secondary" }}>
                      <PhotoCameraOutlinedIcon />
                    </Stack>
                  )}
                  <Chip
                    size="small"
                    label={ANGLE_LABELS[item.angle]}
                    sx={{ position: "absolute", left: 6, bottom: 6, bgcolor: "rgba(0,0,0,.72)", color: "common.white" }}
                  />
                  {item.status === "done" && (
                    <Box sx={{ position: "absolute", top: 6, right: 6, width: 24, height: 24, borderRadius: "50%", bgcolor: "success.main", color: "success.contrastText", display: "grid", placeItems: "center" }}>
                      <CheckOutlinedIcon sx={{ fontSize: 16 }} />
                    </Box>
                  )}
                </Paper>
              </Grid>
            ))}
          </Grid>

          <Stack direction={{ xs: "column", sm: "row" }} spacing={1}>
            {captures.map((item, index) => (
              <Button
                key={item.angle}
                variant="outlined"
                size="small"
                startIcon={<RestartAltOutlinedIcon />}
                onClick={() => retakeAngle(index)}
                sx={{ flex: 1 }}
              >
                {ANGLE_LABELS[item.angle]}
              </Button>
            ))}
          </Stack>

  <Paper
    variant="outlined"
    sx={{
      p: 1.5,
      bgcolor: "action.hover",
      display: "flex",
      flexDirection: { xs: "column", sm: "row" },
      alignItems: { xs: "flex-start", sm: "center" },
      gap: 1,
    }}
  >
    <Checkbox
      checked={consent}
      onChange={(event) => setConsent?.(event.target.checked)}
      disabled={!setConsent}
      sx={{ flexShrink: 0, mt: { xs: 0.25, sm: 0 } }}
    />
    <Typography variant="body2" sx={{ color: "text.secondary", lineHeight: 1.5, whiteSpace: "normal", mt: { xs: -0.5, sm: 0 } }}>
      Tôi đồng ý cho hệ thống xử lý dữ liệu khuôn mặt để nhận diện tại cổng.
    </Typography>
  </Paper>

          <Button
            variant="contained"
            color="success"
            size="large"
            startIcon={<AddAPhotoOutlinedIcon />}
            onClick={submit}
            disabled={!consent}
            fullWidth
          >
            Xác nhận {doneCount} góc ảnh
          </Button>
        </Stack>
      )}
    </Box>
  );
}
</file>

<file path="src/app/(dashboard)/_components/OverdueGuideModal.tsx">
'use client';

import React from 'react';
import {
  Dialog,
  DialogContent,
  Box,
  Typography,
  IconButton,
  Stack,
  Divider,
} from '@mui/material';
import CloseIcon from '@mui/icons-material/Close';
import QRCodeIcon from '@mui/icons-material/QrCode2';
import PaymentIcon from '@mui/icons-material/Payments';
import LocationOnIcon from '@mui/icons-material/LocationOn';
import CheckCircleOutlineIcon from '@mui/icons-material/CheckCircleOutlineOutlined';

interface OverdueGuideModalProps {
  open: boolean;
