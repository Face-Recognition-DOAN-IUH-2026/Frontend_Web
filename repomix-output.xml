<file path="src/components/ReauthOverlay.tsx">
"use client";

import { useEffect, useState } from "react";
import {
  Box,
  Button,
  CircularProgress,
  Dialog,
  DialogContent,
  TextField,
  Typography,
} from "@mui/material";
import { bus } from "@/lib/event-bus";
import api, { retryPendingRequests, cancelPendingRequests } from "@/lib/api-client";
import { useAuth } from "@/lib/auth-context";

export default function ReauthOverlay() {
  const { user } = useAuth();
  const [open, setOpen] = useState(false);
  const [password, setPassword] = useState("");
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState("");

  useEffect(() => {
    const unsubRequired = bus.on("auth:required", () => setOpen(true));
    const unsubCancelled = bus.on("auth:cancelled", () => {
      setOpen(false);
      cancelPendingRequests();
    });
    return () => {
      unsubRequired();
      unsubCancelled();
    };
  }, []);

  useEffect(() => {
    if (!open) return;
    const timer = setTimeout(() => {
      bus.emit("auth:cancelled");
      window.location.href = "/login";
    }, 30000);
    return () => clearTimeout(timer);
  }, [open]);

  const handleSubmit = async (e: React.FormEvent) => {
    e.preventDefault();
    setError("");
    setLoading(true);
    try {
      const res = await api.login({ email: user?.email || "", password });
      if (!res.access_token) throw new Error("Không nhận được token");
      retryPendingRequests(res.access_token);
      setOpen(false);
    } catch (err: any) {
      setError(err?.response?.data?.detail || err?.message || "Đăng nhập thất bại");
    } finally {
      setLoading(false);
    }
  };

  const handleClose = () => {
    bus.emit("auth:cancelled");
  };

  return (
    <Dialog
      open={open}
      onClose={handleClose}
      maxWidth="xs"
      fullWidth
      disableEnforceFocus
    >
      <DialogContent>
        <Box component="form" onSubmit={handleSubmit} sx={{ display: "flex", flexDirection: "column", gap: 2, pt: 1 }}>
          <Typography variant="h6" sx={{ textAlign: "center" }}>
            Phiên đăng nhập hết hạn
          </Typography>
          <Typography variant="body2" color="text.secondary" sx={{ textAlign: "center" }}>
            Vui lòng đăng nhập lại để tiếp tục
          </Typography>

          {error && (
            <Typography color="error" variant="body2" sx={{ textAlign: "center" }}>
              {error}
            </Typography>
          )}

          <TextField
            label="Email"
            value={user?.email || ""}
            disabled
            size="small"
          />
          <TextField
            label="Mật khẩu"
            type="password"
            value={password}
            onChange={(e) => setPassword(e.target.value)}
            size="small"
            autoFocus
            slotProps={{ htmlInput: { "aria-label": "mật khẩu" } }}
          />
          <Button type="submit" variant="contained" disabled={loading || !password}>
            {loading ? <CircularProgress size={20} /> : "Đăng nhập"}
          </Button>
        </Box>
      </DialogContent>
    </Dialog>
  );
}
