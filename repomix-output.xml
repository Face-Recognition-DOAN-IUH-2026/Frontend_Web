                )}
                {book.categories && (
                  <Chip
                    icon={<CategoryIcon sx={{ fontSize: 16 }} />}
                    label={book.categories}
                    size="small"
                    variant="outlined"
                    sx={{ bgcolor: "primary.main", color: "primary.contrastText", borderColor: "primary.main" }}
                  />
                )}
              </Stack>

              <Divider />

              {/* Description */}
              {book.description && (
                <Box>
                  <Stack direction="row" spacing={1} sx={{ alignItems: "center", mb: 1.5 }}>
                    <DescriptionIcon color="action" />
                    <Typography variant="subtitle1" sx={{ fontWeight: 700 }}>
                      Mô tả
                    </Typography>
                  </Stack>
                  <Paper
                    variant="outlined"
                    sx={{
                      p: 2.5,
                      bgcolor: "grey.900",
                      borderRadius: 2,
                      position: "relative",
                      maxHeight: descExpanded ? "none" : 200,
                      overflow: "hidden",
                    }}
                  >
                    <Typography variant="body2" sx={{ whiteSpace: "pre-wrap", lineHeight: 1.8 }}>
                      {book.description}
                    </Typography>
                    {isLongDescription && (
                      <Box
                        sx={{
                          position: "absolute",
                          bottom: 0,
                          left: 0,
                          right: 0,
                          height: 60,
                          background: descExpanded ? "transparent" : "linear-gradient(transparent, #1a1a1a)",
                          display: "flex",
                          alignItems: "flex-end",
                          justifyContent: "center",
                          pb: 1,
                        }}
                      >
                        <Button
                          size="small"
                          onClick={() => setDescExpanded(!descExpanded)}
                          endIcon={descExpanded ? <CloseIcon /> : <ExpandIcon />}
                          sx={{ color: "text.secondary" }}
                        >
                          {descExpanded ? "Thu gọn" : "Xem thêm"}
                        </Button>
                      </Box>
                    )}
                  </Paper>
                </Box>
              )}

              {/* Dates */}
              <Box
                sx={{
                  display: "grid",
                  gridTemplateColumns: { xs: "1fr", sm: "1fr 1fr" },
                  gap: 2,
                }}
              >
                <Paper variant="outlined" sx={{ p: 2, borderRadius: 2 }}>
                  <Typography variant="caption" color="text.secondary" sx={{ textTransform: "uppercase", letterSpacing: 0.5 }}>
                    Ngày tạo
                  </Typography>
                  <Typography variant="body1" sx={{ fontWeight: 600, mt: 0.5 }}>
                    {book.created_at ? new Date(book.created_at).toLocaleDateString("vi-VN", { day: "2-digit", month: "long", year: "numeric" }) : "-"}
                  </Typography>
                </Paper>
                <Paper variant="outlined" sx={{ p: 2, borderRadius: 2 }}>
                  <Typography variant="caption" color="text.secondary" sx={{ textTransform: "uppercase", letterSpacing: 0.5 }}>
                    Ngày cập nhật
                  </Typography>
                  <Typography variant="body1" sx={{ fontWeight: 600, mt: 0.5 }}>
                    {book.updated_at ? new Date(book.updated_at).toLocaleDateString("vi-VN", { day: "2-digit", month: "long", year: "numeric" }) : "-"}
                  </Typography>
                </Paper>
              </Box>

              {/* Action Buttons */}
              <Stack direction="row" spacing={2} sx={{ mt: 1 }}>
                <Button
                  variant="contained"
                  size="large"
                  startIcon={<BookIcon />}
                  onClick={() => router.push(`/borrow?barcode=${book.isbn}`)}
                  sx={{ flex: 1, py: 1.5, fontWeight: 700 }}
                >
                  Mượn sách
                </Button>
                <Tooltip title="Chỉnh sửa số lượng">
                  <Button
                    variant="outlined"
                    size="large"
                    startIcon={<EditIcon />}
                    onClick={() => router.push("/books")}
                    sx={{ py: 1.5 }}
                  >
                    Sửa
                  </Button>
                </Tooltip>
              </Stack>
            </Stack>
          </Grid>
        </Grid>
      </Box>
    </Box>
  );
}

function getErrorMessage(err: any): string {
  if (err?.response?.data?.message) return err.response.data.message;
  if (err?.message) return err.message;
  return "Đã xảy ra lỗi";
}
