  rules?: Record<string, any>;
  fullWidth?: boolean;
  disabled?: boolean;
  type?: string;
  multiline?: boolean;
  rows?: number;
  size?: "small" | "medium";
  sx?: SxProps;
}

export default function FormTextField<T extends FieldValues>({
  name,
  control,
  label,
  rules,
  fullWidth = true,
  disabled = false,
  type,
  multiline,
  rows,
  size = "small",
  sx,
}: FormTextFieldProps<T>) {
  return (
    <Controller
      name={name}
      control={control}
      rules={rules}
