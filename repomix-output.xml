  onSuccess,
}: Props) {
  const [scanned, setScanned] = useState<ScannedBorrowItem[]>([]);
  const [lookingUp, setLookingUp] = useState(false);
  const [createError, setCreateError] = useState("");
  const [scanToast, setScanToast] = useState("");
  const [lookupError, setLookupError] = useState<string | null>(null);
  const lastScannedRef = useRef<string | null>(null);

  const lookupItem = useCallback(async (barcode: string, isbn: string) => {
    setScanned((prev) => prev.map((item) =>
      item.barcode === barcode ? { ...item, loading: true } : item
    ));
    try {
      const result = await api.lookupBorrowSlip({
        patron_id: patronId,
        items: [{ barcode, isbn }],
      });
      const item = result.items.find((i) => i.barcode === barcode);
      if (!item) {
        setScanned((prev) => prev.filter((i) => i.barcode !== barcode));
        setLookupError(`Sách ISBN ${barcode} không tồn tại trong thư viện`);
        return;
      }
      if (!item.can_borrow) {
        setScanned((prev) => prev.filter((i) => i.barcode !== barcode));
        const msg = item.reason || "Sách không thể mượn";
        const title = item.book?.title || "";
        setLookupError(title ? `"${title}": ${msg}` : `${msg} (ISBN: ${barcode})`);
        return;
      }
      setScanned((prev) => prev.map((i) =>
        i.barcode === barcode ? {
          ...i,
          loading: false,
          can_borrow: item.can_borrow,
          reason: item.reason,
          book: item.book,
          copy_id: item.copy?.id || null,
          book_id: item.book?.id || null,
          copy_barcode: item.copy?.barcode || null,
        } : i
      ));
    } catch {
      setScanned((prev) => prev.filter((item) => item.barcode !== barcode));
      setLookupError(`Lỗi tra cứu: ${barcode}`);
    }
  }, [patronId]);

  const addScanned = useCallback((isbn: string) => {
    if (!/^\d{10,13}$/.test(isbn.replace(/-/g, ""))) return;
    const normalized = isbn.replace(/-/g, "");
    lastScannedRef.current = normalized;
    setScanToast(normalized);
    setScanned((prev) => {
      if (prev.some((item) => item.barcode === normalized)) {
        setScanToast(`Sách ${normalized} đã có trong danh sách`);
        return prev;
      }
      if (maxItems !== undefined && prev.length >= maxItems) {
        setScanToast(`Chỉ được mượn tối đa ${maxItems} cuốn`);
        return prev;
      }
      return [...prev, {
        barcode: normalized,
        isbn: normalized,
        loading: true,
        can_borrow: false,
        reason: null,
        book: null,
        copy_id: null,
        book_id: null,
        copy_barcode: null,
      }];
    });
    lookupItem(normalized, normalized);
  }, [lookupItem, maxItems]);

  useEffect(() => {
    if (!open) {
      setScanned([]);
      setCreateError("");
      setScanToast("");
      lastScannedRef.current = null;
    }
  }, [open]);

  const removeItem = (barcode: string) => {
    setScanned((prev) => prev.filter((item) => item.barcode !== barcode));
  };

  const handleCreateSlip = async () => {
    const validItems = scanned.filter((item) => item.can_borrow && item.book_id && item.copy_id);
    if (!validItems.length || !patronId) return;
    setCreateError("");
    try {
      const confirmResult = await api.confirmBorrowSlip({
        patron_id: patronId,
        items: validItems.map((item) => ({
          barcode: item.copy_barcode || item.barcode,
          isbn: item.isbn,
          book_id: item.book_id!,
          copy_id: item.copy_id!,
        })),
      });
      if (confirmResult.status === "success") {
        setScanned([]);
        onSuccess(confirmResult.message);
        onClose();
      }
    } catch (err) {
      const detail = getErrorMessage(err);
      const removedBarcodes: string[] = [];
      const toastMsg = detail;

      const matchTitle = detail.match(/^Sach "(.+)" da duoc doc gia nay muon$/);
      if (matchTitle) {
        const title = matchTitle[1];
        setScanned((prev) => {
          const filtered = prev.filter((item) => {
            if (item.book?.title === title) {
              removedBarcodes.push(item.barcode);
              return false;
            }
            return true;
          });
          return filtered;
        });
      } else {
        const matchBarcode = detail.match(/^(?:Ban sao|Ma vach) ([^\s]+) (?:dang duoc muon|khong ton tai)/);
        if (matchBarcode) {
          const barcode = matchBarcode[1];
          setScanned((prev) => {
            const filtered = prev.filter((item) => {
              if (item.barcode === barcode || item.barcode.includes(barcode)) {
                removedBarcodes.push(item.barcode);
                return false;
              }
              return true;
            });
            return filtered;
          });
        } else {
          setCreateError(detail);
        }
      }
      if (removedBarcodes.length > 0) {
        setScanToast(toastMsg);
      }
    }
  };

  const validCount = scanned.filter((item) => item.can_borrow).length;
  const totalScanned = scanned.length;

  return (
    <>
      <Dialog open={open} onClose={lookingUp ? undefined : onClose} fullWidth maxWidth="xl">
        <DialogTitle>
          <Stack direction="row" spacing={1} sx={{ alignItems: "center", justifyContent: "space-between" }}>
            <Stack direction="row" spacing={1} sx={{ alignItems: "center" }}>
              <QrCodeScannerIcon color="primary" />
              <Typography variant="h6" sx={{ fontWeight: 900 }}>
                Quét mã vạch sách (IP Camera)
              </Typography>
            </Stack>
            {!lookingUp && (
              <IconButton size="small" onClick={onClose}><CloseIcon /></IconButton>
            )}
          </Stack>
        </DialogTitle>
        <DialogContent dividers sx={{ p: 2, display: "flex", flexDirection: "column", overflow: "hidden" }}>
          <Box sx={{ display: "flex", gap: 2, flexDirection: { xs: "column", md: "row" }, flex: 1, overflow: "hidden" }}>
            <Box sx={{ width: { md: "50%" }, flexShrink: 0 }}>
              <IPCameraStream
                cameraUrl={cameraUrl}
                onBarcodeDetected={addScanned}
              />
            </Box>

            <Stack spacing={1.5} sx={{ flex: 1, overflow: "auto" }}>
              <Stack direction="row" spacing={1} sx={{ alignItems: "center" }}>
                <QrCodeScannerIcon color="primary" sx={{ fontSize: 20 }} />
                <Typography variant="subtitle2" sx={{ fontWeight: 900 }}>
                  {totalScanned > 0 ? `Đã quét (${totalScanned} cuốn)` : "Sách đã quét"}
                </Typography>
              </Stack>

              {createError ? <Alert severity="error" onClose={() => setCreateError("")}>{createError}</Alert> : null}

              {scanned.length === 0 ? (
                <Alert severity="info" sx={{ flex: 1, display: "flex", alignItems: "center" }}>
                  Đưa mã vạch vào camera. Sách sẽ xuất hiện tại đây.
                </Alert>
              ) : (
                scanned.map((item) => {
                  const isLastScanned = item.barcode === lastScannedRef.current;
                  const hasError = !item.loading && !item.can_borrow;
                  const isSuccess = !item.loading && item.can_borrow;
                  return (
                    <Paper
                      key={item.barcode}
                      variant="outlined"
                      sx={{
                        p: 1.5,
                        borderColor: isLastScanned ? "primary.main" : hasError ? "error.main" : undefined,
                        bgcolor: isLastScanned ? "action.hover" : hasError ? "error.50" : undefined,
                        animation: isSuccess
                          ? `${successPop} 0.4s ease-out`
                          : isLastScanned
                          ? `${slideInRight} 0.3s ease-out`
                          : undefined,
                      }}
                    >
                      <Stack direction="row" spacing={1.5} sx={{ alignItems: "flex-start" }}>
                        {item.loading ? (
                          <Avatar variant="rounded" sx={{ width: 40, height: 56, bgcolor: "background.default", flexShrink: 0 }}>
                            <CircularProgress size={20} />
                          </Avatar>
                        ) : item.book?.cover_url ? (
                          <Box
                            component="img"
                            src={item.book.cover_url}
                            alt={item.book.title}
                            sx={{ width: 40, height: 56, objectFit: "cover", borderRadius: 0.5, flexShrink: 0 }}
                          />
                        ) : (
                          <Avatar variant="rounded" sx={{ width: 40, height: 56, bgcolor: hasError ? "error.main" : "background.default", flexShrink: 0 }}>
                            {hasError ? <ErrorIcon fontSize="small" /> : <BookIcon />}
                          </Avatar>
                        )}
                        <Stack spacing={0.3} sx={{ flex: 1, minWidth: 0 }}>
                          {item.loading ? (
                            <Typography variant="body2" color="text.secondary">Đang tra cứu...</Typography>
                          ) : item.can_borrow && item.book ? (
                            <>
                              <Typography variant="body2" sx={{ fontWeight: 900 }} noWrap>
                                {item.book.title}
                              </Typography>
                              <Typography variant="caption" color="text.secondary" noWrap>
                                {item.book.author || "-"}
                              </Typography>
                              <Typography variant="caption" sx={{ fontFamily: "monospace", color: "primary.main" }}>
                                {item.barcode}
                              </Typography>
                              <Stack direction="row" spacing={0.5} sx={{ alignItems: "center", flexWrap: "wrap", mt: 0.5 }}>
                                <Chip size="small" variant="outlined" label={`Kho: ${item.book.total_copies}`} sx={{ height: 20, fontSize: 11 }} />
                                <Chip size="small" variant="outlined" color="success" label={`Sẵn: ${item.book.available_copies}`} sx={{ height: 20, fontSize: 11 }} />
                              </Stack>
                            </>
                          ) : (
                            <>
                              <Typography variant="body2" sx={{ fontWeight: 900 }} noWrap color="error">
                                {item.book?.title || item.barcode}
                              </Typography>
                              {item.reason && (
                                <Typography variant="caption" color="error">
                                  {item.reason}
                                </Typography>
                              )}
                            </>
                          )}
                        </Stack>
                        <IconButton size="small" color="error" onClick={() => removeItem(item.barcode)} sx={{ mt: 0.5 }}>
                          <DeleteIcon fontSize="small" />
                        </IconButton>
                      </Stack>
                    </Paper>
                  );
                })
              )}
            </Stack>
          </Box>
        </DialogContent>
        <DialogActions>
          <Button onClick={onClose} disabled={lookingUp}>Hủy</Button>
          <Button
            variant="contained"
            disabled={lookingUp || validCount === 0}
            onClick={handleCreateSlip}
          >
            {lookingUp ? "Đang xử lý..." : `Tạo phiếu mượn (${validCount} cuốn)`}
          </Button>
        </DialogActions>
      </Dialog>

      <Snackbar
        open={!!scanToast}
        autoHideDuration={2000}
        onClose={() => setScanToast("")}
        anchorOrigin={{ vertical: "top", horizontal: "right" }}
      >
        {scanToast ? (
          <Alert
            severity="success"
            onClose={() => setScanToast("")}
            sx={{
              animation: `${slideInRight} 0.3s ease-out`,
              boxShadow: 4,
            }}
          >
            {scanToast}
          </Alert>
        ) : undefined}
      </Snackbar>

      <Dialog open={!!lookupError} onClose={() => setLookupError(null)} maxWidth="sm" fullWidth>
        <DialogTitle sx={{ fontWeight: 900 }}>Thông báo</DialogTitle>
        <DialogContent>
          <Typography>{lookupError}</Typography>
        </DialogContent>
        <DialogActions>
          <Button onClick={() => setLookupError(null)} variant="contained">Đóng</Button>
        </DialogActions>
      </Dialog>
    </>
  );
}
</file>

<file path="src/components/IPCameraStream.tsx">
"use client";

import { useCallback, useEffect, useRef, useState } from "react";
import { Box, Button, CircularProgress, IconButton, Stack, Typography } from "@mui/material";
import CameraAltIcon from "@mui/icons-material/CameraAltOutlined";
import RefreshIcon from "@mui/icons-material/RefreshOutlined";

interface Props {
  cameraUrl: string;
  onBarcodeDetected: (barcode: string) => void;
  onError?: (error: string) => void;
}

export default function IPCameraStream({ cameraUrl, onBarcodeDetected, onError }: Props) {
  const imgRef = useRef<HTMLImageElement>(null);
  const canvasRef = useRef<HTMLCanvasElement>(null);
  const readerRef = useRef<any>(null);
  const intervalRef = useRef<ReturnType<typeof setInterval> | null>(null);
  const [streamKey, setStreamKey] = useState(0);
  const [imgReady, setImgReady] = useState(false);
  const [cameraError, setCameraError] = useState("");
  const lastScannedRef = useRef<string | null>(null);
  const debounceRef = useRef<ReturnType<typeof setTimeout> | null>(null);

  const stopScanning = useCallback(() => {
    if (intervalRef.current) {
      clearInterval(intervalRef.current);
      intervalRef.current = null;
    }
  }, []);

  const stopReader = useCallback(() => {
    if (readerRef.current) {
      try { readerRef.current.reset(); } catch {}
      readerRef.current = null;
    }
  }, []);

  const handleReconnect = useCallback(() => {
    stopScanning();
    setCameraError("");
    setImgReady(false);
    setStreamKey((k) => k + 1);
  }, [stopScanning]);

  const handleScan = useCallback((code: string) => {
    const normalized = code.replace(/-/g, "");
    if (!/^\d{10,13}$/.test(normalized)) return;
    if (normalized === lastScannedRef.current) return;
    lastScannedRef.current = normalized;
    onBarcodeDetected(normalized);
    if (debounceRef.current) clearTimeout(debounceRef.current);
    debounceRef.current = setTimeout(() => {
      lastScannedRef.current = null;
    }, 2000);
  }, [onBarcodeDetected]);

  useEffect(() => {
    let active = true;
    (async () => {
      try {
        const { BrowserMultiFormatReader } = await import("@zxing/browser");
        if (!active) return;
        readerRef.current = new BrowserMultiFormatReader();
      } catch (err) {
        console.error("Failed to load ZXing:", err);
      }
    })();
    return () => { active = false; stopReader(); };
  }, []);

  useEffect(() => {
    if (!imgReady || !imgRef.current || !canvasRef.current) return;
    stopScanning();

    intervalRef.current = setInterval(async () => {
      if (!imgRef.current || !canvasRef.current) return;
      if (!readerRef.current) return;
      const img = imgRef.current;
      const canvas = canvasRef.current;
      if (!img.complete) return;

      try {
        const w = img.naturalWidth || img.width;
        const h = img.naturalHeight || img.height;
        if (!w || !h) return;

        canvas.width = w;
        canvas.height = h;
        const ctx = canvas.getContext("2d");
        if (!ctx) return;

        ctx.drawImage(img, 0, 0);

        const result = await readerRef.current.decodeFromCanvas(canvas);
        if (result) {
          handleScan(result.getText());
        }
      } catch {}
    }, 500);

    return () => stopScanning();
  }, [imgReady, handleScan, stopScanning]);

  const handleImgLoad = () => {
    setCameraError("");
    setImgReady(true);
  };

  const handleImgError = () => {
    const errorMsg = "Không thể kết nối IP Camera. Vui lòng kiểm tra URL.";
    setCameraError(errorMsg);
    onError?.(errorMsg);
  };

  return (
    <Box sx={{ position: "relative", width: "100%", aspectRatio: "4/3", bgcolor: "black", borderRadius: 1, overflow: "hidden" }}>
      {cameraError ? (
        <Stack spacing={1.5} sx={{ alignItems: "center", justifyContent: "center", height: "100%", color: "grey.300", p: 3 }}>
          <CameraAltIcon sx={{ fontSize: 48 }} />
          <Typography sx={{ textAlign: "center" }}>{cameraError}</Typography>
          <Typography variant="caption" sx={{ color: "grey.500" }}>URL: {cameraUrl}</Typography>
          <Button variant="outlined" color="inherit" startIcon={<RefreshIcon />} onClick={handleReconnect}>
            Kết nối lại
          </Button>
        </Stack>
      ) : (
        <>
          <Box
            component="img"
            ref={imgRef}
            src={`${cameraUrl}${cameraUrl.includes("?") ? "&" : "?"}_t=${streamKey}`}
            onLoad={handleImgLoad}
            onError={handleImgError}
            alt="IP Camera Stream"
            sx={{ width: "100%", height: "100%", objectFit: "contain", display: "block" }}
          />
          <canvas ref={canvasRef} style={{ display: "none" }} />
          {!imgReady && (
            <Stack sx={{ position: "absolute", inset: 0, bgcolor: "rgba(0,0,0,.55)", color: "common.white", alignItems: "center", justifyContent: "center" }} spacing={1}>
              <CircularProgress size={28} color="inherit" />
              <Typography variant="body2">Đang kết nối camera...</Typography>
            </Stack>
          )}
          {imgReady && (
            <IconButton
              onClick={handleReconnect}
              size="small"
              sx={{ position: "absolute", top: 8, right: 8, bgcolor: "rgba(0,0,0,.55)", color: "common.white", "&:hover": { bgcolor: "rgba(0,0,0,.75)" } }}
            >
              <RefreshIcon fontSize="small" />
            </IconButton>
          )}
          <Box sx={{ position: "absolute", top: 8, left: 8, px: 1, py: 0.5, bgcolor: "rgba(0,0,0,.6)", borderRadius: 0.5 }}>
            <Typography variant="caption" sx={{ color: "common.white", fontSize: 11 }}>IP Camera</Typography>
          </Box>
        </>
      )}
    </Box>
  );
}
</file>

<file path="src/components/IsbnScannerDialog.tsx">
"use client";

import { useCallback, useEffect, useRef, useState } from "react";
import {
  Alert,
  Avatar,
  Box,
  Button,
  Chip,
  CircularProgress,
  Dialog,
  DialogActions,
  DialogContent,
  DialogTitle,
  IconButton,
  Paper,
  Snackbar,
  Stack,
  TextField,
  Typography,
} from "@mui/material";
import BookIcon from "@mui/icons-material/MenuBookOutlined";
import CameraAltIcon from "@mui/icons-material/CameraAltOutlined";
import CheckCircleIcon from "@mui/icons-material/CheckCircleOutlineOutlined";
import CloseIcon from "@mui/icons-material/Close";
import DeleteIcon from "@mui/icons-material/DeleteOutlined";
import QrCodeScannerIcon from "@mui/icons-material/QrCodeScannerOutlined";
import api, { getErrorMessage } from "@/lib/api-client";
import type { BookImportResultRow, BookWithStats } from "@/lib/types";

interface ScannedItem {
  isbn: string;
  quantity: number;
  lookup: BookWithStats | null;
  loading: boolean;
}

export default function IsbnScannerDialog({
  open,
  onClose,
  onImportComplete,
}: {
  open: boolean;
  onClose: () => void;
  onImportComplete: (results: BookImportResultRow[]) => void;
}) {
  const videoRef = useRef<HTMLVideoElement>(null);
  const streamRef = useRef<MediaStream | null>(null);
  const readerRef = useRef<any>(null);
  const lastScannedRef = useRef<string | null>(null);
  const [cameraReady, setCameraReady] = useState(false);
  const [cameraError, setCameraError] = useState("");
  const [scanned, setScanned] = useState<ScannedItem[]>([]);
  const [importing, setImporting] = useState(false);
  const [importError, setImportError] = useState("");
  const [scanToast, setScanToast] = useState("");

  const stopCamera = useCallback(() => {
    if (readerRef.current) {
      try { readerRef.current.reset(); } catch {}
      readerRef.current = null;
    }
    if (streamRef.current) {
      streamRef.current.getTracks().forEach((track) => track.stop());
      streamRef.current = null;
    }
    if (videoRef.current) videoRef.current.srcObject = null;
    setCameraReady(false);
  }, []);

  const lookupIsbn = useCallback(async (isbn: string) => {
    setScanned((prev) => prev.map((item) =>
      item.isbn === isbn ? { ...item, loading: true } : item
    ));
    try {
      const book = await api.lookupBookByIsbn(isbn);
      setScanned((prev) => prev.map((item) =>
        item.isbn === isbn ? { ...item, lookup: book, loading: false } : item
      ));
    } catch (err) {
      setScanned((prev) => prev.filter((item) => item.isbn !== isbn));
      setScanToast(`Không tìm thấy: ${isbn}`);
    }
  }, []);

  const addScanned = useCallback((isbn: string) => {
    if (!/^\d{10,13}$/.test(isbn.replace(/-/g, ""))) return;
    const normalized = isbn.replace(/-/g, "");
    lastScannedRef.current = normalized;
    setScanToast(normalized);
    setScanned((prev) => {
      if (prev.some((item) => item.isbn === normalized)) {
        return prev.map((item) =>
          item.isbn === normalized ? { ...item, quantity: item.quantity + 1 } : item
        );
      }
      return [...prev, { isbn: normalized, quantity: 1, lookup: null, loading: true }];
    });
    lookupIsbn(normalized);
  }, [lookupIsbn]);

  useEffect(() => {
    if (!open) {
      stopCamera();
      setScanned([]);
      setCameraError("");
      setImportError("");
      setScanToast("");
      lastScannedRef.current = null;
      return;
    }
    let active = true;
    (async () => {
      try {
        setCameraError("");
        const { BrowserMultiFormatReader } = await import("@zxing/browser");
        if (!active) return;
        const stream = await navigator.mediaDevices.getUserMedia({
          video: { facingMode: "environment", width: { ideal: 640 }, height: { ideal: 480 } },
          audio: false,
        });
        if (!active) { stream.getTracks().forEach((t) => t.stop()); return; }
        streamRef.current = stream;
        if (videoRef.current) {
          videoRef.current.srcObject = stream;
          videoRef.current.onloadedmetadata = () => { setCameraReady(true); };
        }
      } catch (err: any) {
        if (!active) return;
        if (err.name === "NotAllowedError") setCameraError("Không có quyền truy cập camera. Hãy cấp quyền camera cho trình duyệt.");
        else if (err.name === "NotFoundError") setCameraError("Không tìm thấy camera trên thiết bị.");
        else setCameraError("Không thể khởi động camera.");
      }
    })();
    return () => { active = false; };
  }, [open, stopCamera]);

  useEffect(() => {
    if (!cameraReady || !videoRef.current || !open) return;
    let active = true;
    (async () => {
      try {
        const { BrowserMultiFormatReader } = await import("@zxing/browser");
        if (!active) return;
        const reader = new BrowserMultiFormatReader();
        readerRef.current = reader;
        reader.decodeFromVideoElement(videoRef.current!, (result, err) => {
          if (!active) return;
          if (result) {
            const code = result.getText();
            if (/^\d{10,13}$/.test(code.replace(/-/g, ""))) {
              addScanned(code);
            }
          }
        });
      } catch {}
    })();
    return () => { active = false; };
  }, [cameraReady, open, addScanned]);

  useEffect(() => () => stopCamera(), [stopCamera]);

  const removeItem = (isbn: string) => {
    setScanned((prev) => prev.filter((item) => item.isbn !== isbn));
  };

  const updateQuantity = (isbn: string, value: number) => {
    setScanned((prev) => prev.map((item) =>
      item.isbn === isbn ? { ...item, quantity: Math.max(1, value || 1) } : item
    ));
  };

  const handleImport = async () => {
    const valid = scanned.filter((item) => item.lookup);
    if (!valid.length) return;
    setImporting(true);
    setImportError("");
    try {
      const result = await api.batchImportByIsbn(valid.map((item) => ({ isbn: item.isbn, quantity: item.quantity })));
      onImportComplete(result.results);
      stopCamera();
      setScanned([]);
    } catch (err) {
      setImportError(getErrorMessage(err));
    } finally {
      setImporting(false);
    }
  };

  const validCount = scanned.filter((item) => item.lookup).length;
  const isNew = (item: ScannedItem) => item.lookup && item.lookup.total_copies === 0;

  return (
    <>
      <Dialog open={open} onClose={importing ? undefined : onClose} fullWidth maxWidth="xl">
        <DialogTitle>
          <Stack direction="row" spacing={1} sx={{ alignItems: "center", justifyContent: "space-between" }}>
            <Stack direction="row" spacing={1} sx={{ alignItems: "center" }}>
              <QrCodeScannerIcon color="primary" />
