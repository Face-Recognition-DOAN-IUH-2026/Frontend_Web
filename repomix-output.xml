    --color-primary: 139 0 0;           /* #8B0000 - IUH Red */
    --color-primary-dark: 112 0 0;      /* #700000 */
    --color-primary-dim: 0 100% 27%;    /* IUH Red dim */
    --color-secondary: 212 175 55;      /* #D4AF37 - IUH Gold */
    --color-secondary-dark: 179 142 34; /* #B38E22 */
    --color-tertiary: 10 37 64;         /* #0A2540 - IUH Navy */
    --color-success: 25 135 84;         /* #198754 */
    --color-success-bg: 232 246 238;
    --color-error: 139 0 0;             /* #8B0000 - same as primary */
    --color-error-bg: 255 245 245;
    --color-warning: 217 119 6;         /* #D97706 */
    --color-warning-bg: 255 248 235;
    --color-info: 10 37 64;             /* #0A2540 - IUH Navy */
    --color-info-bg: 232 238 245;
    --color-text: 10 37 64;             /* #0A2540 - IUH Navy */
    --color-text-2: 75 85 99;           /* #4B5563 */
    --color-text-3: 148 163 184;        /* #94A3B8 */
    --color-border: 222 226 230;        /* #DEE2E6 */
    --color-border-2: 203 213 225;      /* #CBD5E1 */
    /* Shadcn/Radix compat tokens — synced with IUH */
    --background: 0 0% 100%;
    --foreground: 210 73% 14%;          /* #0A2540 as HSL */
    --card: 0 0% 100%;
    --card-foreground: 210 73% 14%;
    --primary: 0 100% 27%;              /* #8B0000 as HSL */
    --primary-foreground: 0 0% 100%;
    --secondary: 43 71% 52%;            /* #D4AF37 as HSL */
    --secondary-foreground: 210 73% 14%;
    --muted: 210 20% 94%;
    --muted-foreground: 215 16% 47%;
    --accent: 210 20% 94%;
    --accent-foreground: 210 73% 14%;
    --destructive: 0 100% 27%;          /* IUH Red */
