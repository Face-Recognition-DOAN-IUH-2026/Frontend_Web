                    left: 0,
                    top: "15%",
                    bottom: "15%",
                    width: 3,
                    borderRadius: "0 2px 2px 0",
                    bgcolor: "#D4AF37", // IUH Gold
                  },
                },
                "&:hover": { bgcolor: "rgba(255, 255, 255, 0.08)", color: "#FFFFFF", "& .MuiListItemIcon-root": { color: "#FFFFFF" } },
                position: "relative",
              }}
            >
              <ListItemIcon
                sx={{ minWidth: 34, color: selected ? "#D4AF37" : "#94A3B8" }}
              >
                <Icon sx={{ fontSize: 18 }} />
              </ListItemIcon>
              <ListItemText
                primary={
                  <Typography
                    variant="body2"
                    sx={{ fontWeight: selected ? 700 : 500, fontSize: "0.875rem" }}
                  >
                    {item.label}
                  </Typography>
                }
              />
              {selected && (
                <ChevronRightIcon sx={{ fontSize: 14, color: "#D4AF37", opacity: 0.8 }} />
              )}
            </ListItemButton>
          );
        })}
      </List>
    </Box>
  );
}

export default function Sidebar() {
  const { user, logout } = useAuth();
  const theme = useTheme();
  const router = useRouter();
  const role = user?.role || "staff";
  const isAdminOrStaff = role === "admin" || role === "staff";
  const isAdmin = role === "admin";

  const isMobile = useMediaQuery(theme.breakpoints.down("md"));
  const [mobileOpen, setMobileOpen] = useState(false);

  const handleClose = () => setMobileOpen(false);

  const isDark = theme.palette.mode === "dark";

  const { canAccessPage } = usePermission();

  const visibleLibraryItems = libraryItems.filter((item) => canAccessPage(item.href));
  const visibleCirculationItems = circulationItems.filter((item) => canAccessPage(item.href));
  const visibleStaffItems = staffItems.filter((item) => canAccessPage(item.href));
  const visibleStaffAiItems = staffAiItems.filter((item) => canAccessPage(item.href));
  const visibleAiItems = aiItems.filter((item) => canAccessPage(item.href));
  const visibleAdminItems = adminItems.filter((item) => {
    if (item.href.startsWith("/dashboard/admin")) {
      return isAdmin;
    }
    return canAccessPage(item.href);
  });

  const drawerContent = (
    <Stack sx={{ height: "100%" }}>
      {/* ── Logo / Brand ─────────────────────────────────── */}
      <Box sx={{ px: 2, py: 2 }}>
        <ButtonBase
          component={Link}
          href="/dashboard"
          onClick={handleClose}
          sx={{ width: "100%", justifyContent: "flex-start", borderRadius: 2 }}
        >
          <Stack direction="row" spacing={1.5} sx={{ alignItems: "center", py: 0.5 }}>
            <Box
              component="img"
              src={isDark ? "/logo-white.png" : "/logo.png"}
              alt="IUH Logo"
              sx={{
                height: 38,
                width: "auto",
                maxWidth: 190,
                objectFit: "contain",
              }}
            />
          </Stack>
        </ButtonBase>
      </Box>

      <Divider sx={{ mx: 1.5 }} />

      {/* ── Navigation ───────────────────────────────────── */}
      <Stack
        spacing={2}
        sx={{ flex: 1, px: 1, py: 1.5, overflowY: "auto" }}
      >
        {visibleLibraryItems.length > 0 && (
          <NavSection title="Thư viện & Bạn đọc" items={visibleLibraryItems} onClose={handleClose} />
        )}
        {visibleCirculationItems.length > 0 && (
          <NavSection title="Lưu hành & Mượn trả" items={visibleCirculationItems} onClose={handleClose} />
        )}
        {visibleStaffItems.length > 0 && (
          <NavSection title="Lịch trực & Nhân sự" items={visibleStaffItems} onClose={handleClose} />
        )}
        {visibleStaffAiItems.length > 0 && (
          <NavSection title="Trợ lý ảo AI" items={visibleStaffAiItems} onClose={handleClose} />
        )}
        {visibleAiItems.length > 0 && (
          <NavSection title="Sinh trắc học & Camera AI" items={visibleAiItems} onClose={handleClose} />
        )}
        {visibleAdminItems.length > 0 && (
          <NavSection title="Quản trị hệ thống" items={visibleAdminItems} onClose={handleClose} />
        )}
      </Stack>

      <Divider sx={{ mx: 1.5 }} />

      {/* ── User footer ──────────────────────────────────── */}
      <Box sx={{ p: 1.25 }}>
        <Stack
          direction="row"
          spacing={1}
          sx={{
            alignItems: "center",
            px: 1,
            py: 0.75,
            borderRadius: 2,
            cursor: "pointer",
            transition: "background-color 0.15s ease",
            "&:hover": { bgcolor: "action.hover" },
          }}
          onClick={() => router.push("/profile")}
        >
          <AvatarUser user={user} size={34} />
          <Box sx={{ flex: 1, minWidth: 0 }}>
            <Typography
              variant="body2"
              sx={{
                fontWeight: 700,
                fontSize: "0.82rem",
                color: "#FFFFFF",
                overflow: "hidden",
                textOverflow: "ellipsis",
                whiteSpace: "nowrap",
              }}
            >
              {user?.full_name || user?.email?.split("@")[0] || "Thủ thư"}
            </Typography>
            <Chip
              label={role === "admin" ? "QUẢN TRỊ VIÊN" : "THỦ THƯ TRỰC"}
              size="small"
              sx={{
                height: 18,
                fontSize: "0.62rem",
                fontWeight: 700,
                bgcolor: role === "admin" ? "#8B0000" : "rgba(212, 175, 55, 0.2)",
                color: role === "admin" ? "#FFFFFF" : "#D4AF37",
                border: "1px solid rgba(212, 175, 55, 0.4)",
                borderRadius: "2px",
                "& .MuiChip-label": { px: 0.75 },
              }}
            />
          </Box>
          <Tooltip title="Đăng xuất">
            <IconButton
              onClick={(e) => { e.stopPropagation(); logout(); }}
              size="small"
              color="error"
              sx={{ opacity: 0.7, "&:hover": { opacity: 1 } }}
            >
              <LogoutIcon sx={{ fontSize: 16 }} />
            </IconButton>
          </Tooltip>
        </Stack>
      </Box>
    </Stack>
  );

  if (isMobile) {
    return (
      <>
        <IconButton
          onClick={() => setMobileOpen(true)}
          sx={{
            position: "fixed",
            top: 12,
            left: 12,
            zIndex: 1400,
            bgcolor: "background.paper",
            boxShadow: "0 2px 8px rgba(30,96,145,0.12)",
            border: "1px solid",
            borderColor: "divider",
          }}
        >
          <MenuIcon />
        </IconButton>
        <Drawer
          variant="temporary"
          open={mobileOpen}
          onClose={handleClose}
          ModalProps={{ keepMounted: true }}
          sx={{
            "& .MuiDrawer-paper": {
              boxSizing: "border-box",
              width: drawerWidth,
              bgcolor: "#0A2540",
              color: "#FFFFFF",
              borderRight: "1px solid rgba(255, 255, 255, 0.12)",
            },
          }}
        >
          {drawerContent}
        </Drawer>
      </>
    );
  }

  return (
    <Drawer
      variant="permanent"
      sx={{
        width: drawerWidth,
        flexShrink: 0,
        "& .MuiDrawer-paper": {
          width: drawerWidth,
          boxSizing: "border-box",
          bgcolor: "#0A2540",
          color: "#FFFFFF",
          borderRight: "1px solid rgba(255, 255, 255, 0.12)",
        },
      }}
    >
      {drawerContent}
    </Drawer>
  );
}
