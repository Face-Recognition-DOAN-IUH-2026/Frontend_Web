<file path="src/components/job-poll.tsx">
"use client";

import { useEffect, useState } from "react";
import {
  Alert,
  Box,
  CircularProgress,
  LinearProgress,
  Paper,
  Stack,
  Typography,
} from "@mui/material";
import CheckCircleOutlineOutlinedIcon from "@mui/icons-material/CheckCircleOutlineOutlined";
import ErrorOutlineOutlinedIcon from "@mui/icons-material/ErrorOutlineOutlined";
import api, { getErrorMessage } from "@/lib/api-client";

interface JobPollProps {
  jobId: string;
  onComplete?: (result: any) => void;
  onError?: (error: string) => void;
}

function resultSummary(result: any) {
  if (!result) return "";
  if (result.verified !== undefined) {
    return `Xác minh: ${result.verified ? "đạt" : "không đạt"}${result.score != null ? `, điểm ${(Number(result.score) * 100).toFixed(1)}%` : ""}`;
  }
  if (result.matches) return `Tìm thấy ${result.matches.length} kết quả`;
  if (result.is_live !== undefined) {
    return `Khuôn mặt thật: ${result.is_live ? "có" : "không"}${result.liveness_score != null ? `, điểm ${(Number(result.liveness_score) * 100).toFixed(1)}%` : ""}`;
  }
  return "Tác vụ đã hoàn tất.";
}

export default function JobPoll({ jobId, onComplete, onError }: JobPollProps) {
  const [status, setStatus] = useState<string>("PENDING");
  const [result, setResult] = useState<any>(null);
  const [error, setError] = useState<string | null>(null);

  useEffect(() => {
    let intervalId: ReturnType<typeof setInterval> | null = null;
    const poll = async () => {
      try {
        const response = await api.getTaskStatus(jobId);
        setStatus(response.status);
        if (response.status === "SUCCESS") {
          if (response.result?.status === "error") {
            const errorMsg = response.result.error || "Tác vụ thất bại.";
            setError(errorMsg);
            onError?.(errorMsg);
          } else {
            setResult(response.result);
            onComplete?.(response.result);
          }
          if (intervalId) clearInterval(intervalId);
        } else if (response.status === "FAILURE") {
          const errorMsg = response.result?.error || response.result?.detail || "Tác vụ thất bại.";
          setError(errorMsg);
          onError?.(errorMsg);
          if (intervalId) clearInterval(intervalId);
        }
      } catch (err: any) {
        const msg = getErrorMessage(err) || "Không thể lấy trạng thái tác vụ.";
        setError(msg);
        onError?.(msg);
        if (intervalId) clearInterval(intervalId);
      }
    };
    poll();
    intervalId = setInterval(poll, 2000);
    return () => { if (intervalId) clearInterval(intervalId); };
  }, [jobId, onComplete, onError]);

  if (error) {
    return (
      <Alert icon={<ErrorOutlineOutlinedIcon />} severity="error">
        <Typography sx={{ fontWeight: 750 }}>Lỗi xử lý</Typography>
        <Typography variant="body2">{error}</Typography>
      </Alert>
    );
  }

  if (status === "SUCCESS") {
    return (
      <Alert icon={<CheckCircleOutlineOutlinedIcon />} severity="success">
        <Typography sx={{ fontWeight: 750 }}>Thành công</Typography>
        {result && <Typography variant="body2">{resultSummary(result)}</Typography>}
      </Alert>
    );
  }

  return (
    <Paper variant="outlined" sx={{ p: 2.5 }}>
      <Stack direction="row" spacing={2} sx={{ alignItems: "center" }}>
        <CircularProgress size={28} />
        <Box sx={{ flex: 1, minWidth: 0 }}>
          <Typography sx={{ fontWeight: 800 }}>Đang xử lý...</Typography>
          <Typography variant="body2" color="text.secondary" sx={{ fontFamily: "monospace", wordBreak: "break-all" }}>
            Job ID: {jobId}
          </Typography>
          <LinearProgress sx={{ mt: 1.5, borderRadius: 99 }} />
        </Box>
      </Stack>
    </Paper>
  );
}
</file>

<file path="src/components/staff-schedule/AssignmentCard.tsx">
"use client";

import { useState } from "react";
import type { StaffScheduleAssignment } from "@/lib/types";

interface AssignmentCardProps {
  assignment: StaffScheduleAssignment;
  onDelete?: (id: string) => void;
}

const STATUS_STYLES: Record<string, { bg: string; border: string; text: string; label: string }> = {
  past: { bg: "bg-surface-2", border: "border-border-2", text: "text-text-3", label: "Đã qua" },
  active: { bg: "bg-success/10", border: "border-success/30", text: "text-success", label: "Đang trực" },
  future: { bg: "bg-primary/10", border: "border-primary/20", text: "text-primary-dark", label: "Sắp tới" },
  today: { bg: "bg-warning/10", border: "border-warning/30", text: "text-warning", label: "Hôm nay" },
};

function getStatus(assignment: StaffScheduleAssignment): keyof typeof STATUS_STYLES {
  const now = new Date();
  const today = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, "0")}-${String(now.getDate()).padStart(2, "0")}`;
  if (assignment.workDate < today) return "past";
  if (assignment.workDate > today) return "future";
  const current = `${String(now.getHours()).padStart(2, "0")}:${String(now.getMinutes()).padStart(2, "0")}`;
  const start = (assignment.shift?.startTime || "").slice(0, 5);
  const end = (assignment.shift?.endTime || "").slice(0, 5);
  if (start && end && current >= start && current <= end) return "active";
  return "today";
}

export default function AssignmentCard({ assignment, onDelete }: AssignmentCardProps) {
  const [hover, setHover] = useState(false);
  const status = getStatus(assignment);
  const style = STATUS_STYLES[status];
  const displayName = assignment.staff?.fullName || assignment.staff?.email || "Nhân viên";
  const zoneName = assignment.zone?.zoneName || "";

  return (
    <div
      className={`relative px-2 py-1.5 rounded-md border ${style.bg} ${style.border} text-xs group`}
      onMouseEnter={() => setHover(true)}
      onMouseLeave={() => setHover(false)}
    >
      {zoneName && (
        <div className="text-[10px] font-medium text-text-3/70 leading-tight mb-0.5">{zoneName}</div>
      )}
      <div className={`font-medium ${style.text} truncate`}>{displayName}</div>
      {onDelete && hover && (
        <button
          onClick={(e) => { e.stopPropagation(); onDelete(assignment.id); }}
          className="absolute -top-1.5 -right-1.5 w-4 h-4 rounded-full bg-surface border border-error/30 text-error text-[10px] flex items-center justify-center shadow-sm hover:bg-error/10 transition opacity-0 group-hover:opacity-100"
        >
          &times;
        </button>
      )}
    </div>
  );
}
</file>

<file path="src/components/staff-schedule/AvailabilityDialog.tsx">
"use client";

import { useEffect, useState } from "react";
import {
  Dialog,
  DialogTitle,
  DialogContent,
  DialogActions,
  Button,
  TextField,
  Stack,
  Typography,
} from "@mui/material";
import api, { getErrorMessage } from "@/lib/api-client";
import type { StaffAvailabilityRequest } from "@/lib/types";

interface AvailabilityDialogProps {
  open: boolean;
  onClose: () => void;
  onSubmitted: () => void;
}

export default function AvailabilityDialog({ open, onClose, onSubmitted }: AvailabilityDialogProps) {
  const [dateFrom, setDateFrom] = useState("");
  const [dateTo, setDateTo] = useState("");
  const [reason, setReason] = useState("");
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState<string | null>(null);
  const [myRequests, setMyRequests] = useState<StaffAvailabilityRequest[]>([]);

  useEffect(() => {
    if (open) {
      api.getScheduleAvailability()
        .then((all) => setMyRequests(all.filter((r) => r.status === "pending" || r.status === "approved")))
        .catch(() => {});
    }
  }, [open]);

  const hasOverlap = (from: string, to: string) =>
    myRequests.some((r) => r.dateFrom <= to && r.dateTo >= from);

  const handleSubmit = async () => {
    if (!dateFrom || !dateTo) {
      setError("Vui lòng chọn ngày bắt đầu và kết thúc");
      return;
    }
    if (dateTo < dateFrom) {
      setError("Ngày kết thúc phải sau ngày bắt đầu");
      return;
    }
    if (hasOverlap(dateFrom, dateTo)) {
      setError("Khoảng ngày trùng với đơn nghỉ phép đã gửi trước đó");
      return;
    }
    setLoading(true);
    setError(null);
    try {
      await api.createMyAvailability({ dateFrom, dateTo, reason: reason || undefined });
      onSubmitted();
      onClose();
      setDateFrom("");
      setDateTo("");
      setReason("");
    } catch (err) {
      setError(getErrorMessage(err));
    } finally {
      setLoading(false);
    }
  };

  return (
    <Dialog open={open} onClose={onClose} maxWidth="sm" fullWidth>
      <DialogTitle sx={{ fontWeight: 700 }}>Xin nghỉ / Không khả dụng</DialogTitle>
      <DialogContent>
        <Stack spacing={2} sx={{ mt: 1 }}>
          {error && (
            <Typography variant="body2" color="error">{error}</Typography>
          )}
          <TextField
            label="Từ ngày"
            type="date"
            value={dateFrom}
            onChange={(e) => setDateFrom(e.target.value)}
            slotProps={{ inputLabel: { shrink: true } }}
            fullWidth
          />
          <TextField
            label="Đến ngày"
            type="date"
            value={dateTo}
            onChange={(e) => setDateTo(e.target.value)}
            slotProps={{ inputLabel: { shrink: true } }}
            fullWidth
          />
          <TextField
            label="Lý do (không bắt buộc)"
            value={reason}
            onChange={(e) => setReason(e.target.value)}
            multiline
            rows={3}
            fullWidth
          />
        </Stack>
      </DialogContent>
      <DialogActions>
        <Button onClick={onClose} disabled={loading}>Hủy</Button>
        <Button onClick={handleSubmit} variant="contained" disabled={loading}>
          {loading ? "Đang gửi..." : "Gửi yêu cầu"}
        </Button>
      </DialogActions>
    </Dialog>
  );
}
</file>

<file path="src/components/staff-schedule/BidsReviewPanel.tsx">
"use client";

import { useEffect, useState } from "react";
import api from "@/lib/api-client";
import type { ShiftBid, ScheduleStaff } from "@/lib/types";

interface Props {
  open: boolean;
  onClose: () => void;
  onUpdated: () => void;
}

function getApiError(err: any): string {
  const data = err?.response?.data;
  return data?.error || data?.message || err?.message || "Có lỗi xảy ra";
}

const STATUS_LABELS: Record<string, { label: string; color: string }> = {
  pending: { label: "Chờ duyệt", color: "#f59e0b" },
  approved: { label: "Đã duyệt", color: "#10b981" },
  rejected: { label: "Từ chối", color: "#ef4444" },
  cancelled: { label: "Đã hủy", color: "#6b7280" },
  expired: { label: "Hết hạn", color: "#6b7280" },
};

export default function BidsReviewPanel({ open, onClose, onUpdated }: Props) {
  const [bids, setBids] = useState<ShiftBid[]>([]);
  const [staff, setStaff] = useState<ScheduleStaff[]>([]);
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState<string | null>(null);
  const [filter, setFilter] = useState<string>("pending");

  const today = new Date().toISOString().slice(0, 10);

  const loadData = async () => {
    setLoading(true);
    setError(null);
    try {
      const [bidList, staffList] = await Promise.all([
        api.listAllBids({ status: filter === "all" ? undefined : filter }),
        api.getScheduleStaffOptions(),
      ]);
      setBids(bidList);
      setStaff(staffList);
    } catch (err) {
      setError(getApiError(err));
    } finally {
      setLoading(false);
    }
  };

  useEffect(() => {
    if (open) loadData();
  }, [open, filter]);

  const handleApprove = async (id: string) => {
    try {
      await api.approveBid(id);
      await loadData();
      onUpdated();
    } catch (err) {
      setError(getApiError(err));
    }
  };

  const handleReject = async (id: string) => {
    try {
      await api.rejectBid(id);
      await loadData();
      onUpdated();
    } catch (err) {
      setError(getApiError(err));
    }
  };

  const getStaffName = (id: string) => {
    const s = staff.find((x) => x.id === id);
    return s?.fullName || s?.email || "Nhân viên";
  };

  const isStale = (bid: ShiftBid) => {
    const workDate = bid.assignment?.workDate;
    return workDate && workDate < today;
  };

  const visibleBids = filter === "pending"
    ? bids.filter((b) => !isStale(b))
    : bids;

  if (!open) return null;

  return (
    <div className="fixed inset-0 flex justify-end" style={{ zIndex: 1300 }}>
      <div className="absolute inset-0 bg-black/50" onClick={onClose} />
      <div className="relative bg-surface w-96 h-full shadow-xl border-l border-border flex flex-col animate-slide-in">
        <div className="flex items-center justify-between px-4 py-3 border-b border-border">
          <h2 className="font-serif text-sm font-semibold text-primary">Duyệt đăng ký ca trực</h2>
          <button onClick={onClose} className="text-text-3 hover:text-text transition text-sm">&times;</button>
        </div>

        <div className="flex border-b border-border">
          {["pending", "approved", "rejected", "all"].map((f) => (
            <button
              key={f}
              onClick={() => setFilter(f)}
              className={`flex-1 py-2 text-xs font-medium transition border-b-2 ${
                filter === f
                  ? "border-primary text-primary"
                  : "border-transparent text-text-3 hover:text-text-2"
              }`}
            >
              {f === "pending" ? "Chờ duyệt" : f === "approved" ? "Đã duyệt" : f === "rejected" ? "Từ chối" : "Tất cả"}
            </button>
          ))}
        </div>

        <div className="flex-1 overflow-y-auto p-4 space-y-3">
          {error && (
            <div className="text-xs text-error bg-error/10 border border-error/20 rounded-md px-2.5 py-1.5">
              {error}
            </div>
          )}

          {loading && (
            <p className="text-xs text-text-3 italic text-center py-4">Đang tải...</p>
          )}

          {!loading && visibleBids.length === 0 && (
            <p className="text-xs text-text-3 italic text-center py-4">Không có đăng ký nào</p>
          )}

          {visibleBids.map((bid) => {
            const status = STATUS_LABELS[bid.status] || { label: bid.status, color: "#6b7280" };
            const asg = bid.assignment;
            const stale = isStale(bid);
            return (
              <div key={bid.id} className="rounded-lg border border-border bg-surface-2 p-3 space-y-2">
                <div className="flex items-center justify-between">
                  <span className="text-xs font-medium text-text">{getStaffName(bid.staffId)}</span>
                  <span
                    className="text-[10px] font-semibold px-2 py-0.5 rounded-full"
                    style={{ backgroundColor: `${status.color}20`, color: status.color }}
                  >
                    {status.label}
                  </span>
                  {stale && (
                    <span className="text-[10px] font-semibold px-2 py-0.5 rounded-full bg-gray-200 text-gray-500">
                      Quá hạn
                    </span>
                  )}
                </div>
                {asg && (
                  <div className="text-[11px] text-text-2">
                    <span className="font-medium">Ca:</span> {asg.shift?.name || "Ca"} &mdash;{" "}
                    <span className="font-medium">Ngày:</span> {asg.workDate}
                  </div>
                )}
                {bid.note && (
                  <div className="text-[11px] text-text-3 italic">Ghi chú: {bid.note}</div>
                )}
                {bid.status === "pending" && !stale && (
                  <div className="flex gap-2 pt-1">
                    <button
                      onClick={() => handleApprove(bid.id)}
                      className="flex-1 py-1.5 rounded-md text-xs font-medium text-white bg-emerald-600 hover:bg-emerald-700 transition"
                    >
                      Duyệt
                    </button>
                    <button
                      onClick={() => handleReject(bid.id)}
                      className="flex-1 py-1.5 rounded-md text-xs font-medium text-white bg-red-500 hover:bg-red-600 transition"
                    >
                      Từ chối
                    </button>
                  </div>
                )}
              </div>
            );
          })}
        </div>
      </div>
    </div>
  );
}
</file>

<file path="src/components/staff-schedule/GeofenceConfigPanel.tsx">
"use client";

import { useEffect, useState } from "react";
import api from "@/lib/api-client";
import type { LibraryZone } from "@/lib/types";

interface Props {
  open: boolean;
  onClose: () => void;
  zones: LibraryZone[];
  onUpdated: () => void;
}

function getApiError(err: any): string {
  const data = err?.response?.data;
  return data?.error || data?.message || err?.message || "Có lỗi xảy ra";
}

export default function GeofenceConfigPanel({ open, onClose, zones, onUpdated }: Props) {
  const [configs, setConfigs] = useState<any[]>([]);
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState<string | null>(null);
  const [zoneId, setZoneId] = useState("");
  const [lat, setLat] = useState("");
  const [lng, setLng] = useState("");
  const [radius, setRadius] = useState("100");
  const [saving, setSaving] = useState(false);

  const loadData = async () => {
    setLoading(true);
    try {
      const result = await api.getGeofenceConfigs();
      setConfigs(result);
    } catch (err) {
      setError(getApiError(err));
    } finally {
      setLoading(false);
    }
  };

  useEffect(() => {
    if (open) loadData();
  }, [open]);

  const handleSet = async () => {
    if (!zoneId || !lat || !lng) { setError("Vui lòng nhập đầy đủ thông tin"); return; }
    const latVal = parseFloat(lat);
    const lngVal = parseFloat(lng);
    const radiusVal = parseInt(radius) || 100;
    if (isNaN(latVal) || latVal < -90 || latVal > 90) { setError("Vĩ độ phải từ -90 đến 90"); return; }
    if (isNaN(lngVal) || lngVal < -180 || lngVal > 180) { setError("Kinh độ phải từ -180 đến 180"); return; }
    if (radiusVal < 10 || radiusVal > 10000) { setError("Bán kính phải từ 10m đến 10,000m"); return; }
    setSaving(true);
    setError(null);
    try {
      await api.setGeofenceConfig({
        zoneId,
        latitude: latVal,
        longitude: lngVal,
        radiusMeters: radiusVal,
      });
      setZoneId(""); setLat(""); setLng(""); setRadius("100");
      await loadData();
      onUpdated();
    } catch (err) {
      setError(getApiError(err));
    } finally {
      setSaving(false);
    }
  };

  const handleDelete = async (zId: string) => {
    if (!confirm("Xóa cấu hình geofence?")) return;
    try {
      await api.deleteGeofenceConfig(zId);
      await loadData();
      onUpdated();
    } catch (err) {
      setError(getApiError(err));
    }
  };

  const getZoneName = (id: string) => zones.find((z) => z.id === id)?.zoneName || "Khu vực";

  if (!open) return null;

  return (
    <div className="fixed inset-0 flex justify-end" style={{ zIndex: 1300 }}>
      <div className="absolute inset-0 bg-black/50" onClick={onClose} />
      <div className="relative bg-surface w-96 h-full shadow-xl border-l border-border flex flex-col animate-slide-in">
        <div className="flex items-center justify-between px-4 py-3 border-b border-border">
          <h2 className="font-serif text-sm font-semibold text-primary">Cấu hình Geofence</h2>
          <button onClick={onClose} className="text-text-3 hover:text-text transition text-sm">&times;</button>
        </div>

        <div className="flex-1 overflow-y-auto p-4 space-y-4">
          {error && (
            <div className="text-xs text-error bg-error/10 border border-error/20 rounded-md px-2.5 py-1.5">
              {error}
            </div>
          )}

          <div className="space-y-2">
            <select
              value={zoneId}
              onChange={(e) => setZoneId(e.target.value)}
              className="w-full px-2 py-1.5 rounded-md bg-surface-2 border border-border text-xs text-text focus:outline-none focus:border-primary"
            >
              <option value="">Chọn khu vực</option>
              {zones.filter((z) => z.isActive).map((z) => (
                <option key={z.id} value={z.id}>{z.zoneName} (Tầng {z.floor})</option>
              ))}
            </select>
            <div className="flex gap-2">
              <input
                type="number"
                step="any"
                value={lat}
                onChange={(e) => setLat(e.target.value)}
                className="flex-1 px-2 py-1.5 rounded-md bg-surface-2 border border-border text-xs text-text focus:outline-none focus:border-primary"
                placeholder="Vĩ độ (lat)"
              />
              <input
                type="number"
                step="any"
                value={lng}
                onChange={(e) => setLng(e.target.value)}
                className="flex-1 px-2 py-1.5 rounded-md bg-surface-2 border border-border text-xs text-text focus:outline-none focus:border-primary"
                placeholder="Kinh độ (lng)"
              />
            </div>
            <div className="flex gap-2">
              <input
                type="number"
                min={10}
                max={10000}
                value={radius}
                onChange={(e) => setRadius(e.target.value)}
                className="flex-1 px-2 py-1.5 rounded-md bg-surface-2 border border-border text-xs text-text focus:outline-none focus:border-primary"
                placeholder="Bán kính (m)"
              />
              <button
                onClick={handleSet}
                disabled={saving}
                className="px-3 py-1.5 rounded-md text-xs font-medium text-bg bg-primary hover:bg-primary-dark transition disabled:opacity-50"
              >
                {saving ? "..." : "Lưu"}
              </button>
            </div>
          </div>

          <div className="space-y-2 pt-2 border-t border-border">
            <p className="text-[11px] text-text-3 font-medium uppercase tracking-wide">Đã cấu hình</p>
            {loading && <p className="text-xs text-text-3 italic">Đang tải...</p>}
            {!loading && configs.length === 0 && (
              <p className="text-xs text-text-3 italic">Chưa có geofence nào</p>
            )}
            {configs.map((cfg) => (
              <div key={cfg.id} className="flex items-center justify-between px-2.5 py-1.5 rounded-md bg-surface-2 border border-border">
                <div>
                  <div className="text-xs font-medium text-text">{cfg.zone?.zoneName || "Khu vực"}</div>
                  <div className="text-[10px] text-text-3">
                    {cfg.latitude}, {cfg.longitude} &middot; {cfg.radiusMeters}m
                  </div>
                </div>
                <button
                  onClick={() => handleDelete(cfg.zoneId)}
                  className="text-error/60 hover:text-error transition text-xs"
                >
                  &times;
                </button>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  );
}
</file>

<file path="src/components/staff-schedule/SwapRequestDialog.tsx">
"use client";

import { useEffect, useState } from "react";
import {
  Dialog,
  DialogTitle,
  DialogContent,
  DialogActions,
  Button,
  TextField,
  Stack,
  Typography,
  FormControl,
  InputLabel,
  Select,
  MenuItem,
} from "@mui/material";
import api, { getErrorMessage } from "@/lib/api-client";
import { useAuth } from "@/lib/auth-context";
import type { StaffScheduleAssignment, ScheduleStaff } from "@/lib/types";

interface SwapRequestDialogProps {
  open: boolean;
  onClose: () => void;
  onSubmitted: () => void;
  myAssignments: StaffScheduleAssignment[];
  allStaff: ScheduleStaff[];
}

export default function SwapRequestDialog({
  open,
  onClose,
  onSubmitted,
  myAssignments,
  allStaff,
}: SwapRequestDialogProps) {
  const { user } = useAuth();
  const [selectedAssignment, setSelectedAssignment] = useState("");
  const [targetStaffId, setTargetStaffId] = useState("");
  const [targetAssignments, setTargetAssignments] = useState<StaffScheduleAssignment[]>([]);
  const [targetAssignmentId, setTargetAssignmentId] = useState("");
  const [loadingAssignments, setLoadingAssignments] = useState(false);
  const [reason, setReason] = useState("");
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState<string | null>(null);

  useEffect(() => {
    if (open) {
      setSelectedAssignment("");
      setTargetStaffId("");
      setTargetAssignmentId("");
      setTargetAssignments([]);
      setReason("");
      setError(null);
    }
  }, [open]);

  useEffect(() => {
    if (!targetStaffId) {
      setTargetAssignments([]);
      setTargetAssignmentId("");
      return;
    }
    const fetchTargetAssignments = async () => {
      setLoadingAssignments(true);
      try {
        const result = await api.getScheduleAssignments({ staffId: targetStaffId });
        const selected = myAssignments.find((a) => a.id === selectedAssignment);
        const filtered = result.items.filter(
          (a) => (a.status === "scheduled" || a.status === "confirmed") && a.workDate === selected?.workDate
        );
        setTargetAssignments(filtered);
      } catch (err) {
        console.error("Failed to load target assignments", err);
      } finally {
        setLoadingAssignments(false);
      }
    };
    fetchTargetAssignments();
  }, [targetStaffId, selectedAssignment]);

  const handleSubmit = async () => {
    if (!selectedAssignment || !targetStaffId) {
      setError("Vui lòng chọn ca muốn đổi và nhân viên mục tiêu");
      return;
    }
    if (targetAssignmentId) {
      const targetAsg = targetAssignments.find((a) => a.id === targetAssignmentId);
      const myAsg = myAssignments.find((a) => a.id === selectedAssignment);
      if (targetAsg && myAsg && targetAsg.shiftId === myAsg.shiftId) {
        setError("Hai ca đổi phải khác nhau (cùng khung giờ)");
        return;
      }
    }
    setLoading(true);
    setError(null);
    try {
      await api.createSwap({
        requesterAssignmentId: selectedAssignment,
        targetStaffId,
        targetAssignmentId: targetAssignmentId || undefined,
        reason: reason || undefined,
      });
      onSubmitted();
      onClose();
    } catch (err) {
      setError(getErrorMessage(err));
    } finally {
      setLoading(false);
    }
  };

  const myActiveAssignments = myAssignments.filter(
    (a) => a.status === "scheduled" || a.status === "confirmed"
  );

  return (
    <Dialog open={open} onClose={onClose} maxWidth="sm" fullWidth>
      <DialogTitle sx={{ fontWeight: 700 }}>Đổi ca với nhân viên khác</DialogTitle>
      <DialogContent>
        <Stack spacing={2} sx={{ mt: 1 }}>
          {error && (
            <Typography variant="body2" color="error">{error}</Typography>
          )}
          <FormControl fullWidth>
            <InputLabel>Ca của bạn muốn đổi</InputLabel>
            <Select
              value={selectedAssignment}
              label="Ca của bạn muốn đổi"
              onChange={(e) => setSelectedAssignment(e.target.value)}
            >
              {myActiveAssignments.map((a) => (
                <MenuItem key={a.id} value={a.id}>
                  {a.shift?.name} — {a.zone?.zoneName} — {a.workDate}
                </MenuItem>
              ))}
            </Select>
          </FormControl>
          <FormControl fullWidth>
            <InputLabel>Đổi với nhân viên</InputLabel>
            <Select
              value={targetStaffId}
              label="Đổi với nhân viên"
              onChange={(e) => setTargetStaffId(e.target.value)}
            >
              {allStaff
                .filter((s) => (s.role === "staff" || s.role === "admin") && s.id !== user?.id)
                .map((s) => (
                  <MenuItem key={s.id} value={s.id}>
                    {s.fullName || s.email}
                  </MenuItem>
                ))}
            </Select>
          </FormControl>
          {targetStaffId && (
            <FormControl fullWidth>
              <InputLabel>Ca đối ứng muốn đổi lấy (không bắt buộc)</InputLabel>
              <Select
                value={targetAssignmentId}
                label="Ca đối ứng muốn đổi lấy (không bắt buộc)"
                onChange={(e) => setTargetAssignmentId(e.target.value)}
                disabled={loadingAssignments}
              >
                <MenuItem value="">
                  <em>Không chọn (Đổi 1 chiều / Chờ đối phương chọn)</em>
                </MenuItem>
                {targetAssignments.map((a) => (
                  <MenuItem key={a.id} value={a.id}>
                    {a.shift?.name} — {a.zone?.zoneName} — {a.workDate}
                  </MenuItem>
                ))}
                {targetAssignments.length === 0 && !loadingAssignments && (
                  <MenuItem disabled>Nhân viên này không có ca trực nào khả dụng</MenuItem>
                )}
              </Select>
            </FormControl>
          )}
          <TextField
            label="Lý do (không bắt buộc)"
            value={reason}
            onChange={(e) => setReason(e.target.value)}
            multiline
            rows={2}
            fullWidth
          />
        </Stack>
      </DialogContent>
      <DialogActions>
        <Button onClick={onClose} disabled={loading}>Hủy</Button>
        <Button onClick={handleSubmit} variant="contained" disabled={loading}>
          {loading ? "Đang gửi..." : "Gửi yêu cầu"}
        </Button>
      </DialogActions>
    </Dialog>
  );
}
</file>

<file path="src/components/staff-schedule/TimetableHeader.tsx">
"use client";

import { useMemo } from "react";

interface TimetableHeaderProps {
  weekStart: Date;
  onPrevWeek: () => void;
  onNextWeek: () => void;
  onToday: () => void;
  isAdmin?: boolean;
  onOpenManagement?: () => void;
  onAutoSchedule?: () => void;
}

function getWeekDays(anchor: Date) {
  return Array.from({ length: 7 }, (_, i) => {
    const d = new Date(anchor);
    d.setDate(anchor.getDate() + i);
    return d;
  });
}

function toDateInput(date: Date) {
  const y = date.getFullYear();
  const m = String(date.getMonth() + 1).padStart(2, "0");
  const d = String(date.getDate()).padStart(2, "0");
  return `${y}-${m}-${d}`;
}

export default function TimetableHeader({
  weekStart, onPrevWeek, onNextWeek, onToday, isAdmin, onOpenManagement, onAutoSchedule,
}: TimetableHeaderProps) {
  const days = useMemo(() => getWeekDays(weekStart), [weekStart]);
  const dateRange = `${toDateInput(days[0])} ~ ${toDateInput(days[6])}`;

  const isCurrentWeek = useMemo(() => {
    const monday = getWeekDays(weekStart);
    return toDateInput(monday[0]) === toDateInput(getWeekDays(new Date())[0]);
  }, [weekStart]);

  return (
    <div className="flex flex-col gap-3 pb-4 border-b border-border">
      <div className="flex items-center justify-between">
        <h1 className="font-serif text-xl font-semibold text-text tracking-tight">
          Lịch trực theo tuần
          <span className="hidden print:inline ml-4 text-sm font-mono font-normal text-text-3">{dateRange}</span>
        </h1>
        <div className="flex items-center gap-2 text-xs text-text-3 print:hidden">
          <span className="font-mono">{dateRange}</span>
        </div>
      </div>

      <div className="flex items-center justify-between">
        <div className="flex items-center gap-1.5">
          <button
            onClick={onPrevWeek}
            className="px-2.5 py-1.5 rounded-md text-xs font-medium text-text-2 hover:bg-surface-2 transition border border-border"
          >
            &larr; Tuần trước
          </button>
          <button
            onClick={onToday}
            className={`px-3 py-1.5 rounded-md text-xs font-medium transition border ${
              isCurrentWeek
                ? "bg-primary text-bg border-primary"
                : "text-primary border-primary/30 hover:bg-primary/10"
            }`}
          >
            Hôm nay
          </button>
          <button
            onClick={onNextWeek}
            className="px-2.5 py-1.5 rounded-md text-xs font-medium text-text-2 hover:bg-surface-2 transition border border-border"
          >
            Tuần sau &rarr;
          </button>
        </div>

        <div className="flex items-center gap-2">
          {isAdmin && (
            <>
              {onAutoSchedule && (
                <button
                  onClick={onAutoSchedule}
                  className="flex items-center gap-1.5 px-3 py-1.5 rounded-md text-xs font-medium text-primary bg-primary/10 hover:bg-primary/20 transition border border-primary/20"
                >
                  <svg className="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth={2}>
                    <path strokeLinecap="round" strokeLinejoin="round" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" />
                  </svg>
                  Gợi ý lịch
                </button>
              )}
              {onOpenManagement && (
                <button
                  onClick={onOpenManagement}
                  className="flex items-center gap-1.5 px-3 py-1.5 rounded-md text-xs font-medium text-text-2 hover:bg-surface-2 transition border border-border"
                >
                  <svg className="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth={2}>
                    <path strokeLinecap="round" strokeLinejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.066 2.573c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.573 1.066c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.066-2.573c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
                    <path strokeLinecap="round" strokeLinejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                  </svg>
                  Quản lý
                </button>
              )}
            </>
          )}
          <button
            onClick={() => window.print()}
            className="flex items-center gap-1.5 px-3 py-1.5 rounded-md text-xs font-medium text-text-2 hover:bg-surface-2 transition border border-border"
          >
            <svg className="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth={2}>
              <path strokeLinecap="round" strokeLinejoin="round" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10V5z" />
            </svg>
            In lịch
          </button>
        </div>
      </div>
    </div>
  );
}
